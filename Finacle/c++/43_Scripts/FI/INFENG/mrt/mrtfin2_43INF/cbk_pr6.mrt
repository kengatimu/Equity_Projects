#***************************************************************************************
PAGEFORMAT
#***************************************************************************************
linesperPage  	500
columnsperline 260
topMargin        0
leftMargin       0
pageheaderlines 13 
pagefooterlines 4
#---------------------------------------------------------------------------------------
PROCEDURE pipe

begin
        print "|"               column 1
	print "|"               column 44
	print "|"               column 65 
	print "|"               column 100
end
#***************************************************************************************
PROCEDURE header
#***************************************************************************************
begin
nextline
nextline
print " MATURITY ANALYSIS OF ASSESTS  AND LIABILITIES " column 5
print " FORM CBK/PR6 " column 166 
nextline
print " NAME OF INSTITUTION: EQUITY BANK LTD, BRANCH : "column 5
set lv_setid = setId
set callscript = runscript "header.scr" "lv_setid" "lv_setdesc"
print lv_setdesc   column 50 
nextline
nextline
print " PERIOD ENDING:   " column 5 
print asondate column 40 size 10 
nextline
print  " SHS "
nextline
separatorline
end
#---------------------------------------------------------------------------------------
PROCEDURE pageheader
#***************************************************************************************
begin
nextline
separatorline
execute pipe
print " ASSETS " column 3 size 26 center
print " MATURED " column 60 size 10  center 
print " Maturing in" column 80 size 10  center 
print " 1 Month" column 100 size 10  center 
print " 3 Month" column 120 size 10  center 
print " 6 Month" column 140 size 10  center 
print " 1 Year" column 160 size 10  center 
print " 3 Year"column 180 size 10  center 
print " Over" column 200 size 10  center 
print "TOTAL" column 220 size 10  center 
nextline
print " Less than " column 80 size 10
print " Less than " column 100 size 10
print " Less than " column 120 size 10
print " Less than " column 140 size 10
print " Less than " column 160 size 10
print " Less than " column 180 size 10
nextline
print " 1 months " column 80 size 10 
print " 3 months " column 100 size 10 
print " 6 months " column 120 size 10 
print " 1 Year " column 140 size 10 
print " 3 Years" column 160 size 10 
print " 5 Years" column 180 size 10 
print "Years" column 200 size 10 
nextline
end
#####################################################################################
ONENDOFREPORT
#####################################################################################
print "1. Cash reserves" column 3
set tot_8 = tot_10001_hom + tot_10002_hom + tot_10001_fgn + tot_10002_fgn
print tot_8 column 60 size 20 autocomma precision 2
set tot_ass = tot_8
set tot_60 = tot_60 +  tot_8 
print tot_8 column 220 size 20 autocomma precision 2
nextline
print "2.  Balances with Central Bank of Kenya" column 3
print tot_11001_hom column 60 size 20 autocomma precision 2
set tot_ass = tot_ass + tot_11001_hom
set tot_60 = tot_60 +  tot_11001_hom
print tot_11001_hom column 220 size 20 autocomma precision 2  
nextline
print "3.  Balances due from local institutions and Bldg Societies" column 3 
set tot_8 = tot_11003_hom + tot_12001_hom + tot_12005_hom
print tot_8  column 60 size 20 autocomma precision 2 
set tot_ass = tot_ass + tot_8
set tot_60 = tot_60 + tot_8 
print tot_8  column 220 size 20 autocomma precision 2  
nextline
print "4.  Balance due from banks abroad"	column 3
print tot_11004_fgn column 60 size 20 autocomma precision 2
set tot_ass = tot_ass + tot_11004_fgn
set tot_60 = tot_60 + tot_11004_fgn
print tot_11004_fgn column 220 size 20 autocomma precision 2
nextline
print "5.  Kenya Goverment Treasury Bills" 	column 3
print tot_tbil_hom column 60 size 20 autocomma precision 2
set tot_ass = tot_ass + tot_tbil_hom
set tot_60  = tot_60 + tot_tbil_hom
print tot_tbil_hom column 220 size 20 autocomma precision 2
nextline
print "6.  Kenya Goverment Treasury Bonds" 	column 3
print tot_trb_hom column 60 size 20 autocomma precision 2
set tot_ass = tot_ass + tot_trb_hom
set tot_60 = tot_60 + tot_trb_hom 
print tot_trb_hom column 220 size 20 autocomma precision 2  
nextline
print "7.  Foreign goverment Treasury Bills and bonds"	column 3
nextline
print "8.  Other Investments"			column 3
nextline
print "9.  Other Foreign Assets"		column 3
set tot_11003_fgn_tho = tot_11003_fgn + tot_13004_fgn + tot_12001_fgn + tot_12005_fgn
print tot_11003_fgn_tho column 60 size 20 autocomma precision 2
set tot_ass = tot_ass + tot_11003_fgn_tho
set tot_60 = tot_60 + tot_11003_fgn_tho 
print tot_11003_fgn_tho column 220 size 20 autocomma precision 2
nextline
print "10. Local currency loans and advances (net)" 	column 3
set tot_mat_oda = tot_mat_oda + tot_32001_hom + tot_33001_hom + tot_32002_hom_tho
set tot_lib = tot_mat_oda + tot_laa_1 + tot_laa_2 + tot_laa_3 + tot_laa_4 + tot_laa_5 + tot_laa_6 + tot_laa_7 
print tot_mat_oda  column 60 size 20 autocomma precision 2
print tot_laa_1		column 80  size 20 autocomma precision 2
print tot_laa_2		column 100 size 20 autocomma precision 2  
print tot_laa_3		column 120 size 20 autocomma precision 2
print tot_laa_4		column 140 size 20 autocomma precision 2
print tot_laa_5		column 160 size 20 autocomma precision 2 
print tot_laa_6		column 180 size 20 autocomma precision 2
print tot_laa_7		column 200 size 20 autocomma precision 2
print tot_lib		column 220 size 20 autocomma precision 2
set tot_ass = tot_ass + tot_mat_oda + tot_laa_1 + tot_laa_2 + tot_laa_3 + tot_laa_4 + tot_laa_5 + tot_laa_6 + tot_laa_7 
nextline
set tot_60 = tot_60 + tot_mat_oda
set tot_80 = tot_80 + tot_laa_1
set tot_100 = tot_100 + tot_laa_2
set tot_120 = tot_120 + tot_laa_3
set tot_140 = tot_140 + tot_laa_4
set tot_160 = tot_160 + tot_laa_5
set tot_180 = tot_180 + tot_laa_6
set tot_200 = tot_200 + tot_laa_7

set tot_lib = tot_mat_oda_fgn + tot_laa_1_fgn + tot_laa_2_fgn + tot_laa_3_fgn + tot_laa_4_fgn + tot_laa_5_fgn + tot_laa_6_fgn + tot_laa_7_fgn
print "11. Foreign currency loans and advances (net)"     column 3
print tot_mat_oda_fgn  column 60 size 20 autocomma precision 2
print tot_laa_1_fgn         column 80  size 20 autocomma precision 2
print tot_laa_2_fgn         column 100 size 20 autocomma precision 2
print tot_laa_3_fgn         column 120 size 20 autocomma precision 2
print tot_laa_4_fgn         column 140 size 20 autocomma precision 2
print tot_laa_5_fgn         column 160 size 20 autocomma precision 2
print tot_laa_6_fgn         column 180 size 20 autocomma precision 2
print tot_laa_7_fgn         column 200 size 20 autocomma precision 2
print tot_lib           column 220 size 20 autocomma precision 2
set tot_60 = tot_60 + tot_mat_oda_fgn
set tot_80 = tot_80 + tot_laa_1_fgn
set tot_100 = tot_100 + tot_laa_2_fgn
set tot_120 = tot_120 + tot_laa_3_fgn
set tot_140 = tot_140 + tot_laa_4_fgn
set tot_160 = tot_160 + tot_laa_5_fgn
set tot_180 = tot_180 + tot_laa_6_fgn
set tot_200 = tot_200 + tot_laa_7_fgn

set tot_ass = tot_ass + tot_lib
nextline
print "12. Fixed Assets (net)"			column 3   
set tot_14 = tot_18008_hom + tot_18009_hom + tot_18002_hom + tot_18006_hom + tot_18010_hom + tot_18003_hom + tot_18004_hom + tot_18001_hom + tot_18005_hom + tot_18007_hom  + tot_17001_hom  + tot_32003_hom + tot_101_hom
print tot_14 column 200  size 20 autocomma precision 2 
set tot_ass = tot_ass + tot_14
set tot_200 = tot_200 + tot_14
print tot_14 column 220 size 20 autocomma precision 2
nextline
print "13. Balance due from group companies"	column 3
nextline
print "14. Other Assets"			column 3
set total = tot_13001_lib + tot_13001_ass
if (total < 0)
begin
	set tot_15 = total 
end
set tot_15 = tot_15 + tot_19003_hom + tot_13004_hom + tot_11002_hom + tot_dvr_hom + tot_trc_hom_tho
set tot_19001_hom_tho = tot_19001_hom + tot_19002_hom + tot_19001_fgn + tot_19002_fgn 
if (tot_19001_hom_tho < 0)
begin
 set tot_15 = tot_15 + tot_19001_hom_tho 
end
set tot_15 = tot_15 + tot_dft_hom + tot_16_hom + tot_100_hom 
print tot_15 column 60 size 20 autocomma precision 2 
set tot_ass = tot_ass + tot_15
set tot_60 = tot_60 + tot_15 
print tot_15 column 220  size 20 autocomma precision 2 
nextline
separatorline
print "15. TOTAL ASSETS" column 3
print tot_60 column 60 size 20 autocomma precision 2  
print tot_80 column 80 size 20 autocomma precision 2   
print tot_100 column 100 size 20 autocomma precision 2 
print tot_120 column 120 size 20 autocomma precision 2   
print tot_140 column 140 size 20 autocomma precision 2   
print tot_160 column 160 size 20 autocomma precision 2   
print tot_180 column 180 size 20 autocomma precision 2   
print tot_200 column 200 size 20 autocomma precision 2   
print tot_ass column 220 size 20 autocomma precision 2 

set tot_60_ass = tot_60 
set tot_80_ass = tot_80
set tot_100_ass = tot_100
set tot_120_ass = tot_120
set tot_140_ass = tot_140
set tot_160_ass = tot_160
set tot_180_ass = tot_180
set tot_200_ass = tot_200
separatorline
nextline
set tot_220 = tot_ass
print "16. Off - Balance sheet assets"		column 3
separatorline
nextline
print "B. LIABILITIES" column 3
print "1.  Balances due to Central Bank of Kenya" 	column 3
nextline
print "2.  Balances due to local institutions and Bldg Societies" column 3
print  tot_30002_hom column 60 size 20 autocomma precision 2
set tot_ass  = tot_30002_hom
set tot_60 = tot_30002_hom
print  tot_30002_hom column 220 size 20 autocomma precision 2 
nextline
print "3.  Balance due from banks abroad" 		column 3
nextline
print "4.  Local currency deposits" 			column 3
set tot_lib = tot_mat_caa + tot_tda_1 + tot_tda_2 + tot_tda_3 + tot_tda_4 + tot_tda_5 + tot_tda_6 + tot_tda_7
print tot_mat_caa  column 60 size 20 autocomma precision 2
print tot_tda_1         column 80  size 20 autocomma precision 2
print tot_tda_2         column 100 size 20 autocomma precision 2
print tot_tda_3         column 120 size 20 autocomma precision 2
