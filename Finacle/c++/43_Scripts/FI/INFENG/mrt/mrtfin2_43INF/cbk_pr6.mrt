set tot_120 = tot_tda_3
set tot_140 = tot_tda_4
set tot_160 = tot_tda_5
set tot_180 = tot_tda_6
set tot_200 = tot_tda_7

set tot_ass = tot_ass + tot_lib 
nextline
print "5.  Local currency borrowings" 			column 3
nextline
print "6.  Foreign currency deposits" 			column 3
set tot_lib = tot_mat_caa_fgn + tot_tda_1_fgn + tot_tda_2_fgn + tot_tda_3_fgn + tot_tda_4_fgn + tot_tda_5_fgn + tot_tda_6_fgn + tot_tda_7_fgn                       
print tot_mat_caa_fgn  column 60 size 20 autocomma precision 2
print tot_tda_1_fgn         column 80  size 20 autocomma precision 2
print tot_tda_2_fgn         column 100 size 20 autocomma precision 2
print tot_tda_3_fgn         column 120 size 20 autocomma precision 2
