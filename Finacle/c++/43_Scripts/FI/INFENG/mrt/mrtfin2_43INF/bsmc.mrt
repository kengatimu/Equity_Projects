###############################################################################
ONSTARTOFREPORT
###############################################################################
print "DATE:__________"
column 70
print asondate  size 10
column 75
nextline
nextline
nextline
print "(SHS)"
column 65
nextline
nextline
nextline
print   "TABLE C:ANALYSIS OF BILLS ,NOTES,LOANS AND ADVANCES" column 15
nextline
nextline
separatorline
print  "PART 1:ANALYSIS OF ECNOMIC SECTORS " column 02
print  "|"   column 54
print  "BILLS &" column 55
print "|"  column 64
print  "LOANS &" column 65 
print "|" column 89
print  "TOTAL"  column 90
nextline
print "NOTES"     column 55
print "ADVANCES" column 65
separatorline
print  "A)    ENTERPRISES"  column 01
execute pipe
nextline
print  "1AGRICULTURE,HUNTING,FISHING&FORESTRY"  column 02
execute pipe
nextline
##############################################################################
ONENDOFREPORT
###############################################################################
print  "C) ANY OTHER ACTIVITIES n.e.s"  column 01
execute pipe
print tot_grp column 65 size 20 autocomma precision 2 
print tot_grp column 90 size 20 autocomma precision 2 
separatorline
print "TOTAL"  column 02
print total column 65 size 20 autocomma precision 2 
print total column 90 size 20 autocomma precision 2 
execute pipe
separatorline
nextline
nextline
nextline
##############################################################################
PAGEHEADER
###############################################################################
execute pageheader

#############################################################################
PROCEDURE pipe
#############################################################################
begin
print  "|"  column 54
print  "|"   column 64
print  "|"   column 89
end
#############################################################################
PROCEDURE pageheader
separatorline
print  "PART 1:ANALYSIS OF ECNOMIC SECTORS "  column 02
print  "|"  column 64
print  "BILLS &" column 65
print "|" column 74
print  "LOANS &"  column 75 rightjustify
print "|" column 89
print  "TOTAL" column 90 rightjustify
nextline
print "NOTES"  column 65
print "ADVANCES" column 75
separatorline
#############################################################################
PROCEDURE afterBreakof
#############################################################################
begin
set tot_grp =  groupSum v2
set total = total + tot_grp
set flag = 0
end
