###############################################################################
RECORDLAYOUT
###############################################################################

loc_ben_name   		  	stringtype
loc_ben_add1            stringtype
loc_ben_city            stringtype
loc_ben_area            stringtype
loc_Client_Name         stringtype
loc_Market_Ref          stringtype
loc_BOD                 stringtype
loc_Purpose_of_BG       stringtype
loc_crncy_code          stringtype
loc_BG_amount           numberType
loc_Eff_date            stringtype
loc_Exp_date            stringtype
loc_SOL_City            stringtype
loc_Issue_date          stringtype
loc_Responsible1        stringtype
loc_Resp1_designation   stringtype
loc_Responsible2        stringtype
loc_Resp2_designation   stringtype
loc_end                 stringtype

###############################################################################
LOCALVARIABLES
###############################################################################
callscript                      stringType
amt_in_words					stringType
amt_in_french					stringType
len1							numberType
s1 								stringType
s2 								stringType
s3 								stringType		
deplen0 						numberType
deplen1 						numberType
deplen2							numberType
deplen3							numberType
decimal_desc						stringType
amt_in_words1 		 stringType
amt_in_french1	stringType
Crncy_Code	stringType


##############################################################################
GROUPANDSORT
###############################################################################
###############################################################################
PAGEFORMAT
###############################################################################
ColumnsPerLine              600
LinesPerPage                100000 
LeftMargin                   10
RightMargin                  10
Topmargin                    00
BottomMargin                 00
pageHeaderLines              00
pageFooterLines              00

##############################################################################
ONEVERYRECORD
##############################################################################
nextline
nextline
nextline
nextline
nextline
nextline
print "GARANTIE DE BONNE EXECUTION" column 37
nextline
nextline
print "Au "
print loc_ben_name
nextline
print "sise "
print loc_ben_add1
print " à "
print loc_ben_city
print "-"
print loc_ben_area
nextline
nextline
print "Nous avons été informés que "
print loc_Client_Name
print " (ci-après dénommé << le Fournisseur >>) a conclu avec "
nextline
print "vous le Marché "
print loc_Market_Ref
print " au mois d'"
print loc_BOD
print " pour "
nextline
print loc_Purpose_of_BG
nextline
print "(ci-après dénommée << le Marché >>). "
nextline
nextline
print "De plus, nous comprenons qu'une garantie de bonne exécution est exigée en vertu des conditions du "
nextline
print "Marché."
nextline
print "A la demande du Fournisseur, nous, EQUITY BCDC nous engageons par la présente,"
nextline
print "sans réserve et irrévocablement, à vous payer à première demande, toutes sommes d'argent que vous "
nextline
print "pourriez réclamer dans la limite de "
print loc_crncy_code
print " "
print loc_BG_amount
print " ("
if(loc_crncy_code = "USD")
begin
  print "Dollars Américains"
  print " "
  set decimal_desc = "cent"
end
if(loc_crncy_code = "GBP")
begin
  print "Livres britanniques"
  print " "
  set decimal_desc = "penny"
end
if(loc_crncy_code = "CDF")
begin
  print "Franc congolais"
  print " "
  set decimal_desc = "centime"
end
set amt_in_words = crncyNumToWords loc_BG_amount decimal_desc 
set Crncy_Code = loc_crncy_code
set callscript = runscript "amttoWordsinFrench.scr" "amt_in_words|Crncy_Code" "amt_in_french1"
set amt_in_french = amt_in_french1

#set callscript = runscript "amttoWordsinFrench.scr" "amt_in_words" "amt_in_french"

set s1 = splitstring amt_in_french 1 35
set deplen1 = strlen s1
if(deplen1 > 0)
begin
   print s1
end
set deplen0 = deplen1 + 1
set s2 = splitstring amt_in_french deplen0 100
set deplen2 = strlen s2
if(deplen2 > 0)
begin
   nextline
   print s2
end
set deplen0 = deplen1 + deplen2 + 1
set s3 = splitstring amt_in_french deplen0 100
set deplen3 = strlen s3
if(deplen3 > 0)
begin
   nextline
   print s3
end
print ")."
nextline
print "Votre demande en paiement doit être accompagnée d'une déclaration attestant que le Soumissionnaire"
nextline
print "ne se conforme pas aux conditions du Marché, sans que vous ayez à prouver ou à donner les raisons"
nextline
print "ou le motif de votre demande ou du montant indiqué dans votre demande."
nextline
nextline
print "La présente garantie prend effet le "
print loc_Eff_date
print " et expire au plus tard "
print loc_Exp_date
print ". "
nextline
print "Toute demande "
nextline
print "de paiement y relative doit être reçue par nous, à nos bureaux,  à cette au plus tard"
nextline
nextline
print "La présente garantie est régie par les Règles uniformes de la CCI relatives aux garanties sur demande"
nextline
print "en vigueur."
nextline
nextline
print "Fait à "
print loc_SOL_City 
print ", le "
print loc_Issue_date
print "."
nextline
nextline
nextline
print loc_Responsible1
print loc_Responsible2 column 60
nextline
print loc_Resp1_designation
print loc_Resp2_designation column 60
nextline
nextline
print "Dûment habilités à signer cette garantie pour et au nom de Equity BCDC."
nextline
nextline
nextline

