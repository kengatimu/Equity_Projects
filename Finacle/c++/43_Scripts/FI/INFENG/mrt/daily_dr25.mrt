#  DESC   : LOANS WRITTEN OFF REPORT
######################################################################
RECORDLAYOUT
#_____________________________________________________________________
####################################################################

SOL_ID              stringtype
SCHEME_CODE         stringtype
FORACID             stringtype
CUST_NAME           stringtype
ACCT_OWNERSHIP      stringtype
DIS_AMT             numbertype
REP_PERD_DAYS       numbertype
DIS_SHDL_DATE       stringtype
CHRGE_OFF_DATE      stringtype
CHRGE_OFF_PRINCIPAL numbertype
PRINCIPAL_RECOVERY  numbertype
INTEREST_RECOVERY   numbertype
#_______________________________________________________________________
#########################################################################
LOCALVARIABLES
####################################################################
####################################################################

total           numberType
total1          numbertype
total2          numbertype
total3          numbertype
total4          numbertype
totalpages      numbertype
total_pages     stringtype
lv_setid        stringType
callscript      stringType
lv_setdesc      stringType
lv_userId       stringType
page_number     numbertype
#__________________________________________________________________________
GROUPANDSORT
#########################################################################
#
SCHEME_CODE ascending
FORACID ascending
#__________________________________________________________________________
REPOSITORY bankRepos.rip 
###########################################################################
bankName        stringType
branchName      stringtype

REPOSITORY  argv4
ipSetId				stringType
ipFrmDate			stringType
iptoDate			stringType
#
###########################################################################
#___________________________________________________________________________
#MASSAGERECORD
###########################################################################
#
###########################################################################
#IGNORERECORD
###########################################################################
#
###########################################################################
#__________________________________________________________________________
PAGEFORMAT
#__________________________________________________________________________

widowOrphanLines 3
LinesPerPage 64
Topmargin       2
BottomMargin 2
columnsPerLine 150
pageHeaderLines 8
pageFooterLines 2
#
#__________________________________________________________________________
ONSTARTOFREPORT
###########################################################################
#___________________________________________________________________________
execute brBankHdg
execute pageHdg
#
#__________________________________________________________________________
PAGEHEADER
###########################################################################
#__________________________________________________________________________
#__________________________________________________________________________
execute pageHdg
#
PAGEFOOTER
###########################################################################
separatorline

#__________________________________________________________________________
ONEVERYRECORD

   Print SCHEME_CODE column 2  size 9
   Print FORACID column 15 size 30
   print CUST_NAME  column 30 size 20
   print ACCT_OWNERSHIP column 53
   print DIS_AMT column 65 format "###,###.#"
   print REP_PERD_DAYS column 80
   print DIS_SHDL_DATE column 95
   print CHRGE_OFF_DATE column 110
   print CHRGE_OFF_PRINCIPAL column 125
begin
   set total4 = ( PRINCIPAL_RECOVERY + INTEREST_RECOVERY  )
   end
   print total4 column 135 format "###,###.#"
#__________________________________________________________________________

BEFOREBREAKOF SCHEME_CODE
#__________________________________________________________________________
print SCHEME_CODE column 15
############################################################################
#
AFTERBREAKOF SCHEME_CODE
#___________________________________________________________________________
#
ONENDOFREPORT
############################################################################
#
############################################################################
separatorline
separatorline
print "Grand Total"
nextline
nextline
print "Printed by:....." column  65
print " "
print lv_userId
nextline
nextline
print "System......................"   column  65
nextline
nextline
print "Time:..............." column 65
#
############################################################################
#
############################################################################
#
procedure pageHdg
############################################################################
############################################################################

begin
     separatorline
     print "Scode" column  2
     print "Acc No." column 15
     print "Name" column 30
     print "Officer" column 53
     print "Amt Granted" column 65
     print "loanterm" column 80
     print "DisbDate" column 95
     print "WriteOffDt" column 110
     print "Amt(P)w/o" column 125
     print "Amt Recd" column 135
     separatorline
end

procedure brBankHdg
begin
 print "Page No. "   column 75
 print page_number precision 0
 nextline
 print today column 75
 nextline
 nextline
 print "            EQUITY BANK LIMITED" column 25
 nextline
 set lv_setid = ipsetId
 set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
 print lv_setdesc column 40
 nextline
 print "        LOANS WRITTEN OFF REPORT " COLUMN 25
 nextline
 print "       From  " column 20
 print ipFrmDate 
 print "  &  "
 print ipToDate
 nextline
 set page_number= page_number+1
end
###########################################################################
#End of File
