pageFooter
######################################################################
#   This section tells about the footer Layout
######################################################################
	set total_pages = total_pages + 1
	execute	pageTotProc
	print "This is an authenticated statement.Customers are" column 36
	nextLine
	print "requested to immediately notify the Bank of any" column 36
	nextLine
	print "discrepancy in the statement." column 36
	nextLine
	set localdate = stringToDate  Close_date
	set localdate = periodAdd localdate localyears Y
	print localdate DateFormat "" column 5	
	nextLine
	set string1 = substr user_rmks_1 1,75
	print	string1	column 4
	nextLine
	set string2 = substr user_rmks_1 76,75
	print	string2	column 4
