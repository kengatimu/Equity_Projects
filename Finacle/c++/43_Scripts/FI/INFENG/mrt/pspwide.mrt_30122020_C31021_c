procedure	pageTotProc
	if page_tot_printed = "n"
	begin
		if pageCount dr_tran_amt != 0 
		begin 
			separatorLine
			print	"Page Total:  "  column 7
			if(locale_code !="IN")
			begin
			print pageSum dr_tran_amt autocomma size 15 column 84
			print pageSum cr_tran_amt autocomma size 15 column 99
			print 	abs bal_amt autocomma size 15 column 114
			end
			else
			begin
			print pageSum dr_tran_amt autocomma size 15 column 92
            print pageSum cr_tran_amt autocomma size 15 column 107
            print   abs bal_amt autocomma size 15 column 122
			end
			print bal_amt format "$$"
			separatorLine
			set page_tot_printed = "y"
		end
	end

