	pageHeaderLines 35
#endif

pageFooterLines	17
topMargin		2

onEveryRecord
	set localdate = stringToDate  gl_date
	set localdate = periodAdd localdate localyears Y
	print localdate DateFormat "" column 1	
	print tran_particular size 28 column 13
	if(locale_code !="IN")
	begin
	print	tran_rmks	size 25	  column 42
	print   ref_num    size 15    column 68 
	if ( dr_tran_amt != 0)
		print dr_tran_amt autocomma size 15 column 84 
	if ( cr_tran_amt != 0)
		print cr_tran_amt autocomma size 15 column 99
	print abs bal_amt autocomma size 15 column 114
	end
	else
	begin
	print   tran_rmks   size 33   column 42
    print   ref_num    size 15    column 76
    if ( dr_tran_amt != 0)
        print dr_tran_amt autocomma size 15 column 92
    if ( cr_tran_amt != 0)
        print cr_tran_amt autocomma size 15 column 107
    print abs bal_amt autocomma size 15 column 122
	end
	print bal_amt format "$$"
	set page_tot_printed = "n"

afterBreakOf srl_num
	if totalCount srl_num != 0
	begin
		if groupCount srl_num = 1
		begin
			nextLine
			nextLine
			nextLine
			print "No transactions for this period" column 20
			nextLine
			nextLine
			nextLine
		end
		if linesleftinpage <=3
		begin
			if ( lineNumber != 1)
				nextPage
        end
		else
		begin
			execute		pageTotProc
			if ( lineNumber != 1)
	        	nextPage
        end
	end
beforeBreakOf srl_num
