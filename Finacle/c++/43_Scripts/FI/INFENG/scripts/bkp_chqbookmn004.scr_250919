				IF((BANCS.STDIN.contextBankId == "54"))THEN
				#{
					IF ((CUST.CHQB.schmCode=="CA288") OR (CUST.CHQB.schmCode=="SB188") OR (CUST.CHQB.schmCode=="CA200") OR (CUST.CHQB.schmCode=="CA206") OR (CUST.CHQB.schmCode=="CA205")) THEN
