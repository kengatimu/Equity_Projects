		#sv_s = sv_s + " , "
		#sv_s = sv_s + " bank_id "
		#sv_s = sv_s + " ) "
		sv_s = sv_s + " VALUES "
		sv_s = sv_s + " ( "
		sv_s = sv_s + " ?SVAR, "
		sv_s = sv_s + " ?SVAR, "
		sv_s = sv_s + " ?SVAR, "
		#	sv_s = sv_s + " ?SVAR, "
		sv_s = sv_s + " ?SVAR, "
		sv_s = sv_s + " ?SVAR, "
		sv_s = sv_s + " ?SVAR, "
		sv_s = sv_s + " '', "
		sv_s = sv_s + " 'E', "
		sv_s = sv_s + " to_date(?SVAR,'DD-MM-YYYY'), "
		sv_s = sv_s + " '', "
		sv_s = sv_s + " '', "
		sv_s = sv_s + " ?SVAR, "
		sv_s = sv_s + " TO_DATE(?SVAR,'DD-MM-YYYY HH24:MI:SS'), "
		sv_s = sv_s + " ?SVAR, "
		sv_s = sv_s + " TO_DATE(?SVAR,'DD-MM-YYYY HH24:MI:SS'), "
		sv_s = sv_s + " 'N', "
		sv_s = sv_s + " ?SVAR, "
		#	sv_s = sv_s + " '' "
		sv_s = sv_s + " '' ,"
		sv_s = sv_s + " ?SVAR, "
		sv_s = sv_s + " ?SVAR, "
		sv_s = sv_s + " ?SVAR, "
		sv_s = sv_s + " ?SVAR, "
		sv_s = sv_s + " ?SVAR, "
		sv_s = sv_s + " ?SVAR"
		sv_s = sv_s + " ) "
		PRINT(sv_s)
		
		#BANCS.INPARAM.BINDVARS = CUST.CHQB.reqestId + "|" + CUST.CHQB.acctNum + "|" + BANCS.STDIN.mySolId + "|" + " " + "|" + CUST.CHQB.noOfChq + "|" + CUST.CHQB.leaves + "|" + mid$(BANCS.STDIN.BODDate,0,10) +"|"+ BANCS.STDIN.userId  + "|" + mid$(BANCS.STDIN.BODDate,0,10) + "|" + BANCS.STDIN.userId + "|" + mid$(BANCS.STDIN.BODDate,0,10) + "|" +  BANCS.STDIN.contextBankId + "|" + CUST.CHQB.destbranch + "|" + " " + "|" + CUST.CHQB.chrgCrncy + "|" + CUST.CHQB.chrgAmt + "|" + CUST.CHQB.vatCrncy + "|" + CUST.CHQB.vatAmt 
		BANCS.INPARAM.BINDVARS = CUST.CHQB.reqestId + "|" + CUST.CHQB.acctNum + "|" + BANCS.STDIN.mySolId + "|" + CUST.CHQB.srlNum + "|" + CUST.CHQB.noOfChq + "|" + CUST.CHQB.leaves + "|" + mid$(BANCS.STDIN.BODDate,0,10) +"|"+ BANCS.STDIN.userId  + "|" + mid$(BANCS.STDIN.BODDate,0,10) + "|" + BANCS.STDIN.userId + "|" + mid$(BANCS.STDIN.BODDate,0,10) + "|" +  BANCS.STDIN.contextBankId + "|" + CUST.CHQB.destbranch + "|" + CUST.CHQB.lastSrlNum + "|" + CUST.CHQB.chrgCrncy + "|" + CUST.CHQB.chrgAmt + "|" + CUST.CHQB.vatCrncy + "|" + CUST.CHQB.vatAmt 
		#BANCS.INPARAM.BINDVARS = CUST.CHQB.reqestId + "|" + CUST.CHQB.acctNum + "|" + BANCS.STDIN.mySolId + "|" + CUST.CHQB.instType + "|" + CUST.CHQB.srlNum + "|" + CUST.CHQB.noOfChq + "|" + CUST.CHQB.leaves + "|" + mid$(BANCS.STDIN.BODDate,0,10) +"|"+ BANCS.STDIN.userId  + "|" + mid$(BANCS.STDIN.BODDate,0,10) + "|" + BANCS.STDIN.userId + "|" + mid$(BANCS.STDIN.BODDate,0,10) + "|" +  BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSQLWithBind(sv_s)
		PRINT(sv_d)
		
		IF(sv_d != 0 ) THEN
		#{
			sv_e = "A Database error has occured. Please contact your DBA."
			sv_m = "count"
