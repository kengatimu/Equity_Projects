                        CUST.CHQB.lastSrlNum = CINT(CUST.CHQB.lastSrlNum)
                        PRINT(CUST.CHQB.lastSrlNum)
			sv_s = "srlval|SELECT CUSTOM.Getchqrange_43.funGetchqrange("+CUST.CHQB.srlNum+","+CUST.CHQB.lastSrlNum+",'"+CUST.CHQB.acid+"',"+CUST.CHQB.leaves+","+CUST.CHQB.noOfChq+") FROM DUAL"

                        sv_d = urhk_dbSelectWithBind(sv_s)
                        PRINT(sv_d)

                        IF(sv_d != 0 ) THEN
                        #{
	                        sv_e = "A Database error has occured. Please contact your DBA."
                                sv_m = "count"
                                sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
                                sv_u = urhk_SetOrbOut(sv_e)
