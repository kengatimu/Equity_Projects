		## Steps for CCHQM Numbering req End

		#-------------------------------------------------------------------------------
		# Get the Max srl number from CUSTOM_CBR and insert the record into CUSTOM_CBR
		#-------------------------------------------------------------------------------
		#sv_s = "lastSrlNum|SELECT TO_NUMBER(NVL(MAX(begin_chq_num+(num_of_chb*num_of_chq_lvs)),1)) "
		sv_s = "lastSrlNum|SELECT NVL(MAX(TO_NUMBER(begin_chq_num+(num_of_chb*num_of_chq_lvs))),1) "
		sv_s = sv_s + " FROM CUSTOM.CUSTOM_CBR "
		sv_s = sv_s + " WHERE foracid = ?SVAR "
		sv_s = sv_s + " AND req_status != 'D' "
		#sv_s = sv_s + " AND inst_type = ?SVAR "
		sv_s = sv_S + " AND bank_id = ?SVAR "
		PRINT(sv_s)
		
		BANCS.INPARAM.BINDVARS = CUST.CHQB.acctNum + "|" + BANCS.STDIN.contextBankId
		#BANCS.INPARAM.BINDVARS = CUST.CHQB.acctNum + "|" + CUST.CHQB.instType + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
