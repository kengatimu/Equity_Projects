	#---------------------------------------------------------------------------------
	#  Validation For No. Of Cheque Books Required Field
	#             1) Only No. of cheque books between 1-99 is permitted.
	#---------------------------------------------------------------------------------
	IF (FIELDEXISTS(CUST.CHQB.noOfChq)) THEN
	#{
		IF (TRIM(CUST.CHQB.noOfChq) == "") THEN
		#{
			sv_e = "Please Enter No. Of Cheque Books Required between 1 - 99"
			sv_m = "noOfChqs"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
