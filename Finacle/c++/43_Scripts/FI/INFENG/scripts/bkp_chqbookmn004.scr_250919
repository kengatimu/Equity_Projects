	# For Delivered TO Vendor for printing,Recieved From Vendor,Send To Destination Branch and Acknowledged at Destination Branch operation.
	#-------------------------------------------------------------------------------------------------------------------------------------------
	IF ((CUST.CHQB.FUNCTION == "R") OR (CUST.CHQB.FUNCTION == "B") OR (CUST.CHQB.FUNCTION == "K")) THEN
	#{
		
		sv_s = "UPDATE CUSTOM.CUSTOM_CBR "
		sv_s = sv_s + " SET lchg_user_id = ?SVAR, "
		sv_s = sv_s + " lchg_time = TO_DATE(?SVAR,'DD-MM-YYYY'), "
		
		IF(CUST.CHQB.FUNCTION == "R")THEN
		#{
			sv_s = sv_s + " req_status = 'R' "
		#}
		ENDIF
		IF(CUST.CHQB.FUNCTION == "B")THEN
		#{
			sv_s = sv_s + " req_status = 'B' "
		#}
		ENDIF
		IF(CUST.CHQB.FUNCTION == "K")THEN
		#{
			sv_s = sv_s + " req_status = 'K' "
		#}
		ENDIF
		sv_s = sv_s + " WHERE req_id = ?SVAR "
		sv_s = sv_s + " AND bank_id = ?SVAR "
		PRINT(sv_s)
		
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId + "|" + MID$(BANCS.STDIN.BODDate,0,10) + "|" + CUST.CHQB.requestId + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSQLWithBind(sv_s)
		PRINT(sv_d)
		
		IF(sv_d == 0 ) THEN
		#{
			sv_d = urhk_dbSQLWithBind("COMMIT")
			PRINT(sv_d)
			#}
		ELSE
			#{
			sv_e = "A Database error has occured. Please contact your DBA."
			sv_m = "count"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF(CUST.CHQB.FUNCTION == "R")THEN
		#{
			sv_u = urhk_SetOrbOut("RESULT_MSG|Request status has Updated to Recieved From Vendor ")
		#}
		ENDIF
		IF(CUST.CHQB.FUNCTION == "B")THEN
		#{
			sv_u = urhk_SetOrbOut("RESULT_MSG|Request status has Updated to Sent TO Destination Branch")
		#}
		ENDIF
		IF(CUST.CHQB.FUNCTION == "K")THEN
		#{
			sv_u = urhk_SetOrbOut("RESULT_MSG|Request Aknowledged at Destination Branch")
		#}
		ENDIF
		sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
		GOTO ENDOFSCRIPT
		
	#}
	ENDIF
