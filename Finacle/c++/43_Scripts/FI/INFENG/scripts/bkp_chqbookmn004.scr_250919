	#**************************************************************************************
	# Entered Option is 'V' i.e Authorizing a request that has been lodged
	#**************************************************************************************
	IF ( CUST.CHQB.FUNCTION == "V" ) THEN
	#{
		sv_s = "chqBook,chqLeaves,reqStatus,foracid,beginNum,rcreId "
		#   sv_s = "chqBook,chqLeaves,reqStatus,foracid,beginNum,rcreId,instType "
		sv_s = sv_s + " | "
		sv_s = sv_s + " SELECT num_of_chb,num_of_chq_lvs,req_status,foracid,begin_chq_num,rcre_user_id "
		#   sv_s = sv_s + " SELECT num_of_chb,num_of_chq_lvs,req_status,foracid,begin_chq_num,rcre_user_id,inst_type "
		sv_s = sv_s + " FROM CUSTOM.CUSTOM_CBR "
		sv_s = sv_s + " WHERE req_id = ?SVAR "
		sv_s = sv_s + " AND bank_id = ?SVAR "
		PRINT(sv_s)
		
		BANCS.INPARAM.BINDVARS = CUST.CHQB.requestId +"|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)
		IF(sv_d != 0 ) THEN
		#{
			sv_e = "A Database error has occured. Please contact your DBA."
			sv_m = "count"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			CUST.CHQB.chqBook = BANCS.OUTPARAM.chqBook
			PRINT(CUST.CHQB.chqBook)
			CUST.CHQB.chqLeaves = BANCS.OUTPARAM.chqLeaves
			PRINT(CUST.CHQB.chqLeaves)
			CUST.CHQB.reqStatus = BANCS.OUTPARAM.reqStatus
			PRINT(CUST.CHQB.reqStatus)
			CUST.CHQB.foracid = BANCS.OUTPARAM.foracid
			PRINT(CUST.CHQB.foracid)
			CUST.CHQB.beginNum = BANCS.OUTPARAM.beginNum
			PRINT(CUST.CHQB.beginNum)
			CUST.CHQB.rcreId = BANCS.OUTPARAM.rcreId
			PRINT(CUST.CHQB.rcreId)
			#CUST.CHQB.instTypw = BANCS.OUTPARAM.instType
			#print(CUST.CHQB.instTypw)
		#}
		ENDIF
		
		IF(TRIM(CUST.CHQB.beginNum) != "" ) THEN
		#{
			CUST.CHQB.chqEndNo = CINT(CUST.CHQB.beginNum) + CINT(CUST.CHQB.chqBook) + CINT(CUST.CHQB.chqLeaves) - 1
		#}
		ENDIF
		
		#******************************************************************************************************
		#  Check IF the authorizers work class is the same or greater than or equal to the customers class.
		#******************************************************************************************************
		
		sv_s = " rcreclass "
		sv_s = sv_s + " | "
		sv_s = sv_s + " SELECT user_work_class "
		sv_s = sv_s + " FROM TBAADM.UPR "
		sv_s = sv_s + " WHERE user_id = ?SVAR "
		PRINT(sv_s)
		
		BANCS.INPARAM.BINDVARS = CUST.CHQB.rcreId
		PRINT(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbselectWIthBind(sv_s)
		IF (sv_d != 0 ) THEN
		#{
			sv_e = "A Database error has occured. Please contact your DBA."
			sv_m = "count"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			CUST.CHQB.rcreclass = BANCS.OUTPARAM.rcreclass
			PRINT(CUST.CHQB.rcreclass)
		#}
		ENDIF
		
		CUST.CHQB.authClass = BANCS.STDIN.userWorkClass
		
		IF(CUST.CHQB.authClass >= CUST.CHQB.rcreclass) THEN
		#{
			IF((CUST.CHQB.reqStatus == "E")) THEN
			#{
				#*****************************************************************************
				# Check for the user cannot authorize his own account
				#******************************************************************************
				
				IF (TRIM(BANCS.STDIN.userId) == TRIM(CUST.CHQB.rcreId)) THEN
				#{
					sv_e = "Cannot authorize your own request."
					sv_m = "count"
					sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
					sv_u = urhk_SetOrbOut(sv_e)
					sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
					GOTO ENDOFSCRIPT
					#}
				ELSE
					#{
					#******************************************************************************
					# Update the request status value to "A" in C_CBM table to mark it as authorized.
					#******************************************************************************
					IF(CUST.CHQB.chqLeaves == 1) THEN
					#{
						CUST.CHQB.status = "S"
						#}
					ELSE
						#{
						CUST.CHQB.status = "A"
					#}
					ENDIF
					
					sv_u = urhk_getAcctDetailsInRepository(CUST.CHQB.acctNum)
					PRINT(sv_u)
					
					CUST.CHQB.schmType = TRIM(BANCS.OUTPARAM.schmType)
					PRINT(CUST.CHQB.schmType)
					
					CUST.CHQB.schmCode = TRIM(BANCS.OUTPARAM.schmCode)
					PRINT(CUST.CHQB.schmCode)
					
					CUST.CHQB.acctCrncyCode = TRIM(BANCS.OUTPARAM.acctCrncyCode)
					PRINT(CUST.CHQB.acctCrncyCode)
					
					sv_m = LEFT$(CUST.CHQB.schmCode,2)
					PRINT(sv_m)
					
					PRINT(CUST.CHQB.schmCode2)
					PRINT(CUST.CHQB.schmCode3)
					PRINT(CUST.CHQB.schmCode4)
					PRINT(CUST.CHQB.schmCode5)
					PRINT(CUST.CHQB.schmCode6)
					PRINT(CUST.CHQB.schmCode7)
					PRINT(CUST.CHQB.schmCode8)
					PRINT(CUST.CHQB.schmCode13)
					PRINT(CUST.CHQB.schmCode14)
					PRINT(CUST.CHQB.schmCode15)
					PRINT(CUST.CHQB.schmCode16)
					PRINT(CUST.CHQB.schmCode17)
					
					IF((BANCS.STDIN.contextBankId == "54"))THEN
					#{
						IF( (CUST.CHQB.schmCode == CUST.CHQB.schmCode2) OR (CUST.CHQB.schmCode == CUST.CHQB.schmCode3) OR (sv_m == CUST.CHQB.schmCode4) OR (CUST.CHQB.schmCode == CUST.CHQB.schmCode5) OR (CUST.CHQB.schmCode == CUST.CHQB.schmCode6) OR (CUST.CHQB.schmCode == CUST.CHQB.schmCode7)  OR (CUST.CHQB.schmCode == CUST.CHQB.schmCode8) OR (CUST.CHQB.schmCode == CUST.CHQB.schmCode13) OR (CUST.CHQB.schmCode == CUST.CHQB.schmCode14) OR (CUST.CHQB.schmCode == CUST.CHQB.schmCode15) OR (CUST.CHQB.schmCode == CUST.CHQB.schmCode16) OR (CUST.CHQB.schmCode == CUST.CHQB.schmCode17) OR (CUST.CHQB.schmCode == "CA288")OR (CUST.CHQB.schmCode == "CA210")OR (CUST.CHQB.schmCode == "SB110")) THEN
						#{
							PRINT(CUST.CHQB.amount)
							PRINT(BANCS.STDIN.homeCrncyCode)
							PRINT(CUST.CHQB.AmountTableCode)
							CUST.CHQB.totChqleaves = CINT(CUST.CHQB.noOfChq) * CINT(CUST.CHQB.leaves)
							PRINT(CUST.CHQB.totChqleaves)
							
							#---------------------------------------------------------
							# Selecting charge amt for one chq leave
							# based on ASTM code CHQI  & calculating tot income amount
							#---------------------------------------------------------
							BANCS.INPARAM.InputAmount = CUST.CHQB.amount
							BANCS.INPARAM.CurrencyCode = BANCS.STDIN.homeCrncyCode
							BANCS.INPARAM.AmountTableCode = CUST.CHQB.AmountTableCode
							
							sv_u = urhk_B2k_GetASTMAmount("")
							PRINT(sv_u)
							
							IF (sv_u == 1) THEN
							#{
								sv_c = urhk_SetOrbOut("Error_01|ERROR:^Unable to find the charge table code chequw book commision")
								sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
								GOTO ENDOFSCRIPT
							#}
							ENDIF
							
							CUST.CHQB.outAmount = BANCS.OUTPARAM.OutputAmount
							PRINT(BANCS.OUTPARAM.OutputAmount)
							PRINT(CUST.CHQB.outAmount)
							
							CUST.CHQB.income_amt = CDOUBLE(CUST.CHQB.totChqleaves) * CDOUBLE(CUST.CHQB.outAmount)
							PRINT(CUST.CHQB.income_amt)
							#
							#			CUST.GCHRG.drAcctId			= CUST.CHQB.acctNum
							#			CUST.GCHRG.acctCrncyCode	= BANCS.STDIN.homeCrncyCode
							#			CUST.GCHRG.eventId			= "CHQCHRG"
							#			CUST.GCHRG.chrgAmt			= CUST.CHQB.income_amt + "|" + BANCS.STDIN.homeCrncyCode
							#			CUST.GCHRG.tranType			= "T"
							#			CUST.GCHRG.tranSubType		= "BI"
							#
							#			CALL("gchrgcommon.scr")
							#			IF(CUST.GCHRG.successOrFailure == "S") THEN
							#			#{
							#				print(CUST.GCHRG.tranId)
							#			#}
							#			ELSE
							#			#{
							#				sv_e = CUST.GCHRG.gchrgErrMsg
							#				sv_m = "count"
							#				sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
							#				sv_u = urhk_SetOrbOut(sv_e)
							#				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
							#				GOTO ENDOFSCRIPT
							#			#}
							#			ENDIF
							
							#---------------------------------------------------------
							# Selecting stamp duty charge amt for one chq leave based
							# on ASTM code CHQS & calculating tot stamp duty amount
							#---------------------------------------------------------
							IF((CUST.CHQB.schmCode == CUST.CHQB.schmCode5) OR (CUST.CHQB.schmCode == CUST.CHQB.schmCode6) OR (CUST.CHQB.schmCode == CUST.CHQB.schmCode7) OR (CUST.CHQB.schmCode == CUST.CHQB.schmCode8) OR (CUST.CHQB.schmCode == "CA288")OR (CUST.CHQB.schmCode == "CA210")OR (CUST.CHQB.schmCode == "SB110")) THEN
							#{
								BANCS.INPARAM.InputAmount = CUST.CHQB.amount
								BANCS.INPARAM.CurrencyCode = BANCS.STDIN.homeCrncyCode
								BANCS.INPARAM.AmountTableCode = CUST.CHQB.AmountTableCode1
								
								sv_u = urhk_B2k_GetASTMAmount("")
								PRINT(sv_u)
								
								IF (sv_u == 1) THEN
								#{
									sv_c = urhk_SetOrbOut("Error_01|ERROR:^Unable to find the charge table code for cheque book stamp duty")
									sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
									GOTO ENDOFSCRIPT
								#}
								ENDIF
								
								CUST.CHQB.outAmount = BANCS.OUTPARAM.OutputAmount
								
								CUST.CHQB.stamp_amt = CDOUBLE(CUST.CHQB.totChqleaves) * CDOUBLE(CUST.CHQB.outAmount)
								PRINT(CUST.CHQB.stamp_amt)
							#}
							ENDIF
							
							
							#---------------------------------------------------------
							# Selecting stamp duty charge amt for one chq leave based
							# on ASTM code CHQS & calculating tot stamp duty amount
							#---------------------------------------------------------
							
							#CUST.CHQB.tot_amt = cdouble(CUST.CHQB.stamp_amt) + cdouble(CUST.CHQB.income_amt)
							CUST.CHQB.tot_amt = CDOUBLE(CUST.CHQB.income_amt)
							PRINT(CUST.CHQB.tot_amt)
							
							
							CUST.GCHRG.drAcctId			= CUST.CHQB.acctNum
							CUST.GCHRG.acctCrncyCode	= BANCS.STDIN.homeCrncyCode
							CUST.GCHRG.eventId			= "CHQCHRG"
							CUST.GCHRG.chrgAmt			= CUST.CHQB.tot_amt + "|" + BANCS.STDIN.homeCrncyCode
							CUST.GCHRG.tranType			= "T"
							CUST.GCHRG.tranSubType		= "BI"
							
							CALL("gchrgcommon.scr")
							
							
							IF((CUST.CHQB.schmCode == CUST.CHQB.schmCode5) OR (CUST.CHQB.schmCode == CUST.CHQB.schmCode6) OR (CUST.CHQB.schmCode == CUST.CHQB.schmCode7) OR (CUST.CHQB.schmCode == CUST.CHQB.schmCode8) OR (CUST.CHQB.schmCode == "CA288")) THEN
							#{
								CUST.CHQB.tot_amt1 = CDOUBLE(CUST.CHQB.stamp_amt)
								PRINT(CUST.CHQB.tot_amt1)
								CUST.GCHRG.drAcctId			= CUST.CHQB.acctNum
								CUST.GCHRG.acctCrncyCode	= BANCS.STDIN.homeCrncyCode
								CUST.GCHRG.eventId			= "CHQCHRGST"
								CUST.GCHRG.chrgAmt			= CUST.CHQB.tot_amt1 + "|" + BANCS.STDIN.homeCrncyCode
								CUST.GCHRG.tranType			= "T"
								CUST.GCHRG.tranSubType		= "BI"
								
								CALL("gchrgcommon.scr")
							#}
							ENDIF
							
							IF(CUST.GCHRG.successOrFailure == "S") THEN
							#{
								PRINT(CUST.GCHRG.tranId)
								#}
							ELSE
								#{
								sv_e = CUST.GCHRG.gchrgErrMsg
								sv_m = "count"
								sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
								sv_u = urhk_SetOrbOut(sv_e)
								sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
								GOTO ENDOFSCRIPT
							#}
							ENDIF
						#}
						ENDIF
						#}
					ELSE
						#{
						IF ((BANCS.STDIN.contextBankId == "11") OR (BANCS.STDIN.contextBankId == "50") OR (BANCS.STDIN.contextBankId == "55") OR (BANCS.STDIN.contextBankId == "56")) THEN
						#{
							
							IF( (CUST.CHQB.schmCode == CUST.CHQB.schmCode2) OR (CUST.CHQB.schmCode == CUST.CHQB.schmCode3) OR (sv_m == CUST.CHQB.schmCode4) OR (CUST.CHQB.schmCode == CUST.CHQB.schmCode5) 	OR (CUST.CHQB.schmCode == CUST.CHQB.schmCode6) ) THEN
							#{
								PRINT(CUST.CHQB.amount)
								PRINT(BANCS.STDIN.homeCrncyCode)
								PRINT(CUST.CHQB.AmountTableCode)
								CUST.CHQB.totChqleaves = CINT(CUST.CHQB.noOfChq) * CINT(CUST.CHQB.leaves)
								PRINT(CUST.CHQB.totChqleaves)
								
								#---------------------------------------------------------
								# Selecting charge amt for one chq leave
								# based on ASTM code CHQI  & calculating tot income amount
								#---------------------------------------------------------
								
								IF((BANCS.STDIN.contextBankId == "11") AND (CUST.CHQB.acctCrncyCode == "USD"))THEN
								#{
									sv_s = " usdRate|"
									sv_s = sv_s + "select VAR_CRNCY_UNITS "
									sv_s = sv_s + "FROM TBAADM.RTL WHERE FXD_CRNCY_CODE = ?SVAR  "
									sv_s = sv_s + "AND VAR_CRNCY_CODE = ?SVAR AND RATECODE = 'MEAN' AND bank_id = ?SVAR "
									PRINT (sv_s)
									BANCS.INPARAM.BINDVARS = CUST.CHQB.acctCrncyCode + "|" + BANCS.STDIN.homeCrncyCode + "|" + BANCS.STDIN.contextBankId
									PRINT(BANCS.INPARAM.BINDVARS)
									sv_d = urhk_dbSelectWithBind(sv_s)
									
									IF (sv_d == 0) THEN
									#{
										CUST.CHQB.usdRate = BANCS.OUTPARAM.usdRate
										PRINT(CUST.CHQB.usdRate)
									#}
									ENDIF
									
									BANCS.INPARAM.InputAmount = CUST.CHQB.amount
									BANCS.INPARAM.CurrencyCode = CUST.CHQB.acctCrncyCode
									BANCS.INPARAM.AmountTableCode = CUST.CHQB.AmountTableCode
									
									sv_u = urhk_B2k_GetASTMAmount("")
									PRINT(sv_u)
									IF (sv_u == 1) THEN
									#{
										sv_c = urhk_SetOrbOut("Error_01|ERROR:^Unable to find the charge table code chequw book commision")
										sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
										GOTO ENDOFSCRIPT
									#}
									ENDIF
									
									CUST.CHQB.outAmount = BANCS.OUTPARAM.OutputAmount
									PRINT(CUST.CHQB.outAmount)
									CUST.CHQB.usdAmount = CDOUBLE(CUST.CHQB.outAmount) * CDOUBLE(CUST.CHQB.totChqleaves)
									PRINT(CUST.CHQB.usdAmount)
									CUST.CHQB.outAmount = CDOUBLE(CUST.CHQB.outAmount) * CDOUBLE(CUST.CHQB.usdRate)
									PRINT(CUST.CHQB.outAmount)
									
									sv_a = urhk_getAcctDetailsInRepository(CUST.CHQB.acctNum)
									IF(sv_a==0)THEN
									#{
										CUST.CHQB.EffAvailableAmt =CDOUBLE(BANCS.OUTPARAM.EffAvailableAmt)
									#}
									ENDIF
									
									IF(CDOUBLE(CUST.CHQB.EffAvailableAmt) < CDOUBLE(CUST.CHQB.usdAmount)) THEN
									#{
										
										sv_e = "No Sufficient Funds Available for Cheque Application Charges."
										sv_m = "count"
										sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
										sv_u = urhk_SetOrbOut(sv_e)
										sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
										GOTO ENDOFSCRIPT
									#}
									ENDIF
									#}
								ELSE
									#{
									BANCS.INPARAM.InputAmount = CUST.CHQB.amount
									BANCS.INPARAM.CurrencyCode = BANCS.STDIN.homeCrncyCode
									BANCS.INPARAM.AmountTableCode = CUST.CHQB.AmountTableCode
									sv_u = urhk_B2k_GetASTMAmount("")
									PRINT(sv_u)
									
									IF (sv_u == 1) THEN
									#{
										sv_c = urhk_SetOrbOut("Error_01|ERROR:^Unable to find the charge table code chequw book commision")
										sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
										GOTO ENDOFSCRIPT
									#}
									ENDIF
									
									CUST.CHQB.outAmount = BANCS.OUTPARAM.OutputAmount
									PRINT(BANCS.OUTPARAM.OutputAmount)
									PRINT(CUST.CHQB.outAmount)
									IF((BANCS.STDIN.contextBankId == "11") AND (CUST.CHQB.acctCrncyCode == "SSP"))THEN
									#{
										CUST.CHQB.sspAmount = CDOUBLE(CUST.CHQB.totChqleaves) * CDOUBLE(CUST.CHQB.outAmount)
										PRINT(CUST.CHQB.sspAmount)
										
										sv_a = urhk_getAcctDetailsInRepository(CUST.CHQB.acctNum)
										IF(sv_a==0)THEN
										#{
											CUST.CHQB.EffAvailableAmt =CDOUBLE(BANCS.OUTPARAM.EffAvailableAmt)
										#}
										ENDIF
										IF(CDOUBLE(CUST.CHQB.EffAvailableAmt) < CDOUBLE(CUST.CHQB.sspAmount)) THEN
										#{
											sv_e = "No Sufficient Funds Available for Cheque Application Charges."
											sv_m = "count"
											sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
											sv_u = urhk_SetOrbOut(sv_e)
											sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
											GOTO ENDOFSCRIPT
										#}
										ENDIF
									#}
									ENDIF
								#}
								ENDIF
								CUST.CHQB.income_amt = CDOUBLE(CUST.CHQB.totChqleaves) * CDOUBLE(CUST.CHQB.outAmount)
								PRINT(CUST.CHQB.income_amt)
								CUST.GCHRG.drAcctId			= CUST.CHQB.acctNum
								CUST.GCHRG.acctCrncyCode	= BANCS.STDIN.homeCrncyCode
								CUST.GCHRG.eventId			= "CHQCHRG"
								CUST.GCHRG.chrgAmt			= CUST.CHQB.income_amt + "|" + BANCS.STDIN.homeCrncyCode
								CUST.GCHRG.tranType			= "T"
								CUST.GCHRG.tranSubType		= "BI"
								
								CALL("gchrgcommon.scr")
								IF(CUST.GCHRG.successOrFailure == "S") THEN
								#{
									PRINT(CUST.GCHRG.tranId)
									#}
								ELSE
									#{
									sv_e = CUST.GCHRG.gchrgErrMsg
									sv_m = "count"
									sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
									sv_u = urhk_SetOrbOut(sv_e)
									sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
									GOTO ENDOFSCRIPT
								#}
								ENDIF
								#}
							ELSE
								#{
								IF (BANCS.STDIN.contextBankId == "50")  THEN
								#{
									IF((CUST.CHQB.schmCode == "CA215") OR (CUST.CHQB.schmCode == "CA210") OR (CUST.CHQB.schmCode == "CA202")) THEN
									#{
										PRINT(CUST.CHQB.amount)
										PRINT(BANCS.STDIN.homeCrncyCode)
										PRINT(CUST.CHQB.AmountTableCode)
										CUST.CHQB.totChqleaves = CINT(CUST.CHQB.noOfChq) * CINT(CUST.CHQB.leaves)
										PRINT(CUST.CHQB.totChqleaves)
										
										#---------------------------------------------------------
										# Selecting charge amt for one chq leave
										# based on ASTM code CHQI  & calculating tot income amount
										#---------------------------------------------------------
										BANCS.INPARAM.InputAmount = CUST.CHQB.amount
										BANCS.INPARAM.CurrencyCode = BANCS.STDIN.homeCrncyCode
										BANCS.INPARAM.AmountTableCode = CUST.CHQB.AmountTableCode
										
										sv_u = urhk_B2k_GetASTMAmount("")
										PRINT(sv_u)
										
										IF (sv_u == 1) THEN
										#{
											sv_c = urhk_SetOrbOut("Error_01|ERROR:^Unable to find the charge table code chequw book commision")
											sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
											GOTO ENDOFSCRIPT
										#}
										ENDIF
										
										CUST.CHQB.outAmount = BANCS.OUTPARAM.OutputAmount
										PRINT(BANCS.OUTPARAM.OutputAmount)
										PRINT(CUST.CHQB.outAmount)
										
										CUST.CHQB.income_amt = CDOUBLE(CUST.CHQB.totChqleaves) * CDOUBLE(CUST.CHQB.outAmount)
										PRINT(CUST.CHQB.income_amt)
										
										CUST.GCHRG.drAcctId			= CUST.CHQB.acctNum
										CUST.GCHRG.acctCrncyCode	= BANCS.STDIN.homeCrncyCode
										CUST.GCHRG.eventId			= "CHQCHRG"
										CUST.GCHRG.chrgAmt			= CUST.CHQB.income_amt + "|" + BANCS.STDIN.homeCrncyCode
										CUST.GCHRG.tranType			= "T"
										CUST.GCHRG.tranSubType		= "BI"
										
										CALL("gchrgcommon.scr")
										IF(CUST.GCHRG.successOrFailure == "S") THEN
										#{
											PRINT(CUST.GCHRG.tranId)
											#}
										ELSE
											#{
											sv_e = CUST.GCHRG.gchrgErrMsg
											sv_m = "count"
											sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
											sv_u = urhk_SetOrbOut(sv_e)
											sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
											GOTO ENDOFSCRIPT
										#}
										ENDIF
										
									#}
									ENDIF
									
