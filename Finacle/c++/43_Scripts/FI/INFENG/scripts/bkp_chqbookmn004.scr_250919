									#{
										sv_u = urhk_SetOrbOut("RESULT_MSG|Request has been authorized")
										sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
									#}
									ENDIF		
									GOTO ENDOFSCRIPT
								#}
								ENDIF
							#}
							ENDIF
						#}
						ENDIF
					#}
					ENDIF
					sv_s = "UPDATE CUSTOM.CUSTOM_CBR "
					sv_s = sv_s + " SET auth_user_id = ?SVAR, "
					sv_s = sv_s + " lchg_user_id = ?SVAR, "
					sv_s = sv_s + " lchg_time = TO_DATE(?SVAR,'DD-MM-YYYY'), "
					sv_s = sv_s + " req_status = ?SVAR "
					sv_s = sv_s + " WHERE req_id = ?SVAR "
					sv_s = sv_s + " AND bank_id = ?SVAR "
					PRINT(sv_s)
					
					BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId + "|" + BANCS.STDIN.userId + "|" + MID$(BANCS.STDIN.BODDate,0,10) + "|" + CUST.CHQB.status + "|" +  CUST.CHQB.requestId +"|" + BANCS.STDIN.contextBankId
					PRINT(BANCS.INPARAM.BINDVARS)
					
					sv_d = urhk_dbSQLWithBind(sv_s)
					PRINT(sv_d)
					
					IF(sv_d != 0 ) THEN
					#{
