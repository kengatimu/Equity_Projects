                                CUST.CHQB.lastSrlNum =MID$(BANCS.OUTPARAM.srlval,sv_a,sv_b)
                                PRINT(CUST.CHQB.lastSrlNum)
				GOTO INSRT
                        #}
                        ENDIF

                #}
		ELSE
		#{

		        sv_s = "SrlNum|SELECT NVL(MAX(TO_NUMBER(end_chq_num)),0) + 1 "
                        #sv_s = "SrlNum|SELECT TO_NUMBER(NVL(MAX(end_chq_num),0)) + 1 "
                        sv_s = sv_s + " FROM CUSTOM.CUSTOM_CBR "
                        sv_s = sv_s + " WHERE foracid = ?SVAR "
                        sv_s = sv_s + " AND req_status != 'D' "
                        sv_s = sv_S + " AND bank_id = ?SVAR "
