				PRINT(sv_a)
			
				sv_b = STRLEN(BANCS.OUTPARAM.srlval)
				PRINT(sv_b)
	
                                CUST.CHQB.srlNum = MID$(BANCS.OUTPARAM.srlval,0,(sv_a - 1))
