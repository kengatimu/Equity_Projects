	sv_x = " ValidateAccout |Select count(*) from CUSTOM.CUSTOM_CBR where REQ_ID =?SVAR and  bank_id = ?SVAR and  REQ_STATUS ='E' "
	PRINT(sv_x)
	BANCS.INPARAM.BINDVARS =  BANCS.INPUT.requestId   + "|" + BANCS.STDIN.contextBankId
	sv_x = urhk_dbSelectWithBind(sv_x)	
	IF (sv_x != 0 ) THEN
		sv_u = urhk_SetOrbOut("RESULT_MSG|Request ID should be E-Entered prior to verification")
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
	ELSE		
		CUST.CHQB.valAcct = BANCS.OUTPARAM.ValidateAccout
		PRINT(BANCS.OUTPARAM.ValidateAccout)
		IF (CUST.CHQB.valAcct <= 0) THEN		
			sv_u = urhk_SetOrbOut("RESULT_MSG|Request ID should be E-Entered prior to verification")
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		ENDIF	
	ENDIF

#	BANCS.INPUT.requestId = "3225"
#	BANCS.INPUT.funcCode = "V"
	BANCS.INPUT.acctNo = ""	

	call("chqbookmn003FI.scr")

	Print (CUST.CHQB.chrgAmt)
	Print (CUST.CHQB.vatAmt)
	Print (CUST.CHQB.chrgCrncy)
	Print (CUST.CHQB.vatCrncy)
	Print (CUST.CHQB.chqEndNo)
	Print(CUST.CHQB.chqBook)
	Print (CUST.CHQB.chqLeaves)
	Print (CUST.CHQB.reqStatus)
	Print (CUST.CHQB.foracid)
	Print (CUST.CHQB.beginNum)
	Print (CUST.CHQB.destbrnch)
	BANCS.INPUT.acctNo  = CUST.CHQB.foracid
	BANCS.INPUT.noOfChqs = CUST.CHQB.chqBook
	BANCS.INPUT.leaves = CUST.CHQB.chqLeaves 
	BANCS.INPUT.startChqNo = CUST.CHQB.beginNum
	BANCS.INPUT.endChqNo = CUST.CHQB.chqEndNo
	BANCS.INPUT.reqStat =  CUST.CHQB.reqStatus
	BANCS.INPUT.destbranch = CUST.CHQB.destbrnch
	BANCS.INPUT.chrgCrncy = CUST.CHQB.chrgCrncy
	BANCS.INPUT.chrgAmt =CUST.CHQB.chrgAmt
	BANCS.INPUT.vatCrncy = CUST.CHQB.vatCrncy
	BANCS.INPUT.vatAmt = CUST.CHQB.vatAmt
	call("chqbookmn004FI.scr")
ENDIF

ENDOFSCRIPT:


