<--START
CHECKSUM="55f73772838d5ce4654157be5c2c24822cec8467113e5ce007055fbb16bced2e"
	TRACE ON

        IF (REPEXISTS("CUST") == 0) THEN
        #{
                CREATEREP("CUST")
        #}
        ENDIF

        IF(CLASSEXISTS("CUST","GCHRG")==0) THEN
        #{
                CREATECLASS("CUST","GCHRG",5)
        #}
        ENDIF

	IF (FIELDEXISTS(BANCS.STDIN.menuId) == 0) THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF

	sv_u = urhk_SRV_GetVal("genChrgCrit.eventId.eventId")
	PRINT(sv_u)
	IF (sv_u == 0) THEN
	#{
        	CUST.GCHRG.eventId = BANCS.OUTPARAM.srvValue
        	PRINT(CUST.GCHRG.eventId)
	#}
	ENDIF

	IF(TRIM(TOUPPER(CUST.GCHRG.eventId)) != "CWCHRG")THEN
	#{
		GOTO DENOM
	#}
	ELSE
	#{
		CUST.GCHRG.chrgacnt = " "
		CUST.GCHRG.vatacnt = " "
	#}
	ENDIF

	sv_u = urhk_SRV_NumOfRecs("genChrgLL")
	PRINT(sv_u)
	IF(sv_u == 0) THEN
	#{
       		CUST.GCHRG.noOfRecords = CINT(BANCS.OUTPARAM.srvValue)	
		PRINT(CUST.GCHRG.noOfRecords)
	#}
	ENDIF

	IF(CUST.GCHRG.noOfRecords != "0")THEN
	#{
		#CUST.GCHRG.count = CINT("0")

		sv_l = 0
		WHILE(sv_l < CUST.GCHRG.noOfRecords)
		#{
        		CUST.GCHRG.count1 = Format$(sv_l,"%d")
			PRINT(CUST.GCHRG.count1)
        		CUST.GCHRG.count2 = "<rec_"+CUST.GCHRG.count1+">"
			PRINT(CUST.GCHRG.count2)

			sv_u = urhk_SRV_GetVal("genChrgLL." +CUST.GCHRG.count2+ ".drAcct.foracid")
			PRINT(sv_u)
        		IF (sv_u == 0) THEN
        		#{
                		CUST.GCHRG.drAcct = BANCS.OUTPARAM.srvValue
                		PRINT(CUST.GCHRG.drAcct)
        		#}
			ELSE
			#{
				CUST.GCHRG.drAcct = ""
			#}
			ENDIF

			sv_u = urhk_SRV_GetVal("genChrgLL." +CUST.GCHRG.count2+ ".crAcct.foracid")
			PRINT(sv_u)
        		IF (sv_u == 0) THEN
        		#{
                		CUST.GCHRG.crAcct = BANCS.OUTPARAM.srvValue
                		PRINT(CUST.GCHRG.crAcct)
        		#}
			ELSE
			#{
				CUST.GCHRG.crAcct = ""
			#}
			ENDIF
		
			sv_s = "bacid|SELECT BACID FROM TBAADM.GAM WHERE BANK_ID=?SVAR AND FORACID=?SVAR"
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+ CUST.GCHRG.crAcct
		
			PRINT(sv_s)
			PRINT(BANCS.INPARAM.BINDVARS)
		
			sv_d = urhk_dbSelectWithBind(sv_s)
			IF(sv_d == "0")THEN
			#{
				CUST.GCHRG.bacid = BANCS.OUTPARAM.bacid
			#}
			ELSE
			#{
				CUST.GCHRG.bacid = " "
			#}
			ENDIF
		
			IF(TRIM(CUST.GCHRG.bacid) == "VAT")THEN
			#{
				CUST.GCHRG.vatacnt = CUST.GCHRG.crAcct
				PRINT(CUST.GCHRG.vatacnt)
			#}
			ELSE
			#{
				CUST.GCHRG.chrgacnt = CUST.GCHRG.crAcct
				PRINT(CUST.GCHRG.chrgacnt)
			#}
			ENDIF
		
			#CUST.GCHRG.count2 = CUST.GCHRG.count2 + 1
			sv_l = sv_l + 1
			PRINT(sv_l)
		
		#}
		DO
	#}
	ENDIF	

	DENOM:
	call("S_denomdp002.scr")
	ENDOFSCRIPT:
		EXITSCRIPT
END-->
