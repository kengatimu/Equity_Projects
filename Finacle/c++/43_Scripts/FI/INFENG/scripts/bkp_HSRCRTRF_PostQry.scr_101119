<--start
#trace on
#*****************************************************************************************
# Script Name    : HSRCRTRF_PostQry.scr
# Description    : This script is called by Reference number listing.
#
# Sl No   Date        Modified By                  Description
# -----   ----------  --------------------------   -----------------------------
#    1.   22-11-2006  Balamurugan_T                 Base Version
#*****************************************************************************************
#
trace on
sv_c = BANCS.INPUT.orig_acid
print(sv_c)
sv_d = BANCS.INPUT.orig_tran_id
print(sv_d)
sv_e = BANCS.INPUT.orig_tran_date
print(sv_e)
sv_f = BANCS.STDIN.mySolId 
print(sv_f)
sv_c = "foracid, solId|select foracid,sol_id from tbaadm.gam where acid = ?SVAR AND"
sv_c = sv_c + " gam.BANK_ID = ?SVAR "
BANCS.INPARAM.BINDVARS = BANCS.INPUT.orig_acid + "|" + BANCS.STDIN.contextBankId
print(sv_c)
sv_q = urhk_dbSelectWithBind(sv_c)
print(sv_q)
sv_c = BANCS.OUTPARAM.foracid
print(sv_c)
sv_g = BANCS.OUTPARAM.solId

print(sv_g)

# Check if menu is Captive. If yes, skip displaying records of other sol.
sv_a = "mod_tenor | select MOD_TENOR from tbaadm.MOD where MOP_ID = 'HCRT' and BANK_ID = ?SVAR "
BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId 
sv_h = urhk_dbSelectWithBind(sv_a)
if(BANCS.OUTPARAM.mod_tenor == "C") then
	if(sv_f != sv_g) then
		BANCS.OUTPUT.adhocPostQueryStatus = "K"
		exitscript
	endif
endif
sv_b = sv_c + "/" + sv_d + "/" + sv_e
BANCS.OUTPUT.ref_desc = sv_b
trace off
end-->
