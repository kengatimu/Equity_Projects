<--START

TRACE ON

	IF (REPEXISTS("CUST") == 0) THEN
		CREATEREP("CUST")
	ENDIF
	IF (REPEXISTS("CHRG") == 0) THEN
		CREATEREP("CHRG")
	ENDIF
	IF (CLASSEXISTS("CHRG","TXN") == 0) THEN
		CREATECLASS("CHRG","TXN",5)
	ENDIF
	IF(CLASSEXISTS("CUST","TRAN")==0) THEN
		CREATECLASS("CUST","TRAN",5)
	ENDIF

	CHRG.TXN.Sol=""

	IF(FIELDEXISTS(CHRG.TXN.AcctSol))THEN
		CHRG.TXN.Sol = CHRG.TXN.AcctSol
		Print (CHRG.TXN.Sol)
	ENDIF
	IF(FIELDEXISTS(CUST.TRAN.AcctSol))THEN
		CHRG.TXN.Sol = CUST.TRAN.AcctSol
		Print (CHRG.TXN.Sol)
	ENDIF

	IF (CHRG.TXN.Sol=="")  THEN
		CHRG.TXN.Sol= BANCS.STDIN.mySolId
	ENDIF

	sv_s =""
	sv_s = sv_s + " SET_ID | select SET_ID from tbaadm.sst where Sol_id='"+CHRG.TXN.Sol+"' and bank_id='"+BANCS.STDIN.contextBankId+"' and set_id ='BCDC'  and rownum=1"
	print(sv_s)
	sv_u = urhk_dbselectwithBind(sv_s)
	print(sv_u)
	IF (sv_u == 0) THEN
		BANCS.INPUT.SET_ID=BANCS.OUTPARAM.SET_ID
		print(BANCS.INPUT.SET_ID)
	else
		BANCS.INPUT.SET_ID="0"

	ENDIF

TRACE OFF
END-->
