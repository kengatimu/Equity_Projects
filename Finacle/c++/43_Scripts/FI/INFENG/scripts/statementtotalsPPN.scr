<--start
trace on

####################################################################
#section      :creating new repository if required
#Description  :Checks for the existence of the repository STDWFS and
#               creates a new one by that name if it does not exist
#####################################################################

IF (REPEXISTS("CUST") == 0 ) THEN
#{
    CREATEREP("CUST")
    #}
ENDIF

############################################################################
#section      :creating new class if required
#Desscription :checks for the existence of the class GLBDATA in the
#repository
#               create a new one if it does not exist
##############################################################################


IF (CLASSEXISTS("CUST","DATA") == 0) THEN
#{
    CREATECLASS("CUST","DATA",5)
#}
ENDIF

############################################
#Assigns the values to the variables
############################################

sv_a = urhk_b2k_PrintRepos("BANCS")
print(sv_a)
sv_y=0

IF( (FIELDEXISTS(("BANCS").("INPUT").("Bankid"))== 0) ) THEN
	CUST.DATA.errMsg="Kindly Supply Bank id"
	sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
	GOTO End
ELSE
	CUST.DATA.Bankid=BANCS.INPUT.Bankid
	print(CUST.DATA.Bankid)
ENDIF

IF( (FIELDEXISTS(("BANCS").("INPUT").("Customercifid"))== 0) ) THEN
	CUST.DATA.errMsg="Kindly Supply Customer Cifid"
	sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
	sv_e=urhk_SetOrbOut("StattusCode|Error")
	GOTO End
ELSE
	CUST.DATA.Customercifid=BANCS.INPUT.Customercifid
	print(CUST.DATA.Customercifid)
ENDIF


IF( (FIELDEXISTS(("BANCS").("INPUT").("Fromdate"))== 0) ) THEN
	CUST.DATA.errMsg="Kindly Supply  From Date ...Note date format DD-MON-YYYY"
	sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
	GOTO End
ELSE
	CUST.DATA.Fromdate=BANCS.INPUT.Fromdate
	print(CUST.DATA.Fromdate)
ENDIF

IF( (FIELDEXISTS(("BANCS").("INPUT").("todate"))== 0) ) THEN
	CUST.DATA.errMsg="Kindly Supply todate Date ...Note date format DD-MON-YYYY"
	sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
	GOTO End
ELSE
	CUST.DATA.todate=BANCS.INPUT.todate
	print(CUST.DATA.todate)
ENDIF

############################################
# Fetching the value from table
############################################

sv_q = "ndebit,tdebit| "
sv_q = sv_q + " select nvl(sum(ndebit),0) ndebit,nvl(sum(usdsumamt),0) debitusdsumamt from (  "
sv_q = sv_q + " SELECT count (*) as ndebit , SUM(TRAN_AMT)  as tdebit,gam.acct_crncy_code,   "
sv_q = sv_q + "  (case when gam.acct_crncy_code='USD' then SUM(TRAN_AMT)  when gam.acct_crncy_code='CDF' "       
sv_q = sv_q + " then (SUM(TRAN_AMT)/(select VAR_CRNCY_UNITS from tbaadm.rtl where bank_id='43' and del_flg='N' and RATECODE='MEAN' and FXD_CRNCY_CODE='USD' and VAR_CRNCY_CODE='CDF' and rownum<2))  "
sv_q = sv_q + "    when gam.acct_crncy_code='GBP'    then (SUM(TRAN_AMT)*(select VAR_CRNCY_UNITS from tbaadm.rtl where bank_id='43' and del_flg='N' and RATECODE='MEAN' and FXD_CRNCY_CODE='GBP'  "
sv_q = sv_q + " and VAR_CRNCY_CODE='USD'  and rownum<2))   when gam.acct_crncy_code='EUR'       then (SUM(TRAN_AMT)*(select VAR_CRNCY_UNITS from tbaadm.rtl where bank_id='43' and del_flg='N' and RATECODE='MEAN' "
sv_q = sv_q + " and FXD_CRNCY_CODE='EUR' and VAR_CRNCY_CODE='USD' and rownum<2))    when gam.acct_crncy_code='ZAR'       then (SUM(TRAN_AMT)/(select VAR_CRNCY_UNITS from  "
sv_q = sv_q + " tbaadm.rtl where bank_id='43' and del_flg='N' and RATECODE='MEAN' and FXD_CRNCY_CODE='USD' and VAR_CRNCY_CODE='ZAR' and rownum<2))    when gam.acct_crncy_code='CHF' "
sv_q = sv_q + "   then (SUM(TRAN_AMT)/(select VAR_CRNCY_UNITS from tbaadm.rtl where bank_id='43' and del_flg='N' and RATECODE='MEAN' and FXD_CRNCY_CODE='USD' and VAR_CRNCY_CODE='CHF' "
sv_q = sv_q + " and rownum<2))     when gam.acct_crncy_code='CNY'       then (SUM(TRAN_AMT)/(select VAR_CRNCY_UNITS from tbaadm.rtl where bank_id='43' and del_flg='N' "
sv_q = sv_q + " and RATECODE='MEAN' and FXD_CRNCY_CODE='USD' and VAR_CRNCY_CODE='CNY' and rownum<2))     when gam.acct_crncy_code='XAF'       then (SUM(TRAN_AMT)/(select VAR_CRNCY_UNITS from tbaadm.rtl "
sv_q = sv_q + " where bank_id='43' and del_flg='N' and RATECODE='MEAN' and FXD_CRNCY_CODE='USD' and VAR_CRNCY_CODE='XAF' and rownum<2))   end) usdsumamt   FROM  "
sv_q = sv_q + " TBAADM.dtd dtd,tbaadm.gam, TBAADM.dth dth WHERE gam.bank_id= ?SVAR  and gam.bank_id=dtd.bank_id   and gam.acid=dtd.acid   "
sv_q = sv_q + " and  dtd.bank_id = ?SVAR and dtd.del_flg='N'     and gam.cif_id = ?SVAR    and PART_TRAN_TYPE ='D' AND dtd.tran_date>= ?SVAR AND  dtd.tran_date<= ?SVAR   and  dth.bank_id = ?SVAR "
sv_q = sv_q + "  and  dtd.tran_id=dth.tran_id and  dtd.tran_date=dth.tran_date and dtd.bank_id=dth.bank_id  and DELIVERY_CHANNEL_ID='PPN'  group by gam.acct_crncy_code "
sv_q = sv_q + "  union all  "
sv_q = sv_q + "     SELECT count (*) as ndebit , SUM(TRAN_AMT)  as tdebit,gam.acct_crncy_code,   "
sv_q = sv_q + "  (case when gam.acct_crncy_code='USD' then SUM(TRAN_AMT)  when gam.acct_crncy_code='CDF'  "      
sv_q = sv_q + " then (SUM(TRAN_AMT)/(select VAR_CRNCY_UNITS from tbaadm.rtl where bank_id='43' and del_flg='N' and RATECODE='MEAN' and FXD_CRNCY_CODE='USD' and VAR_CRNCY_CODE='CDF' and rownum<2))  "
sv_q = sv_q + "    when gam.acct_crncy_code='GBP'    then (SUM(TRAN_AMT)*(select VAR_CRNCY_UNITS from tbaadm.rtl where bank_id='43' and del_flg='N' and RATECODE='MEAN' and FXD_CRNCY_CODE='GBP'  "
sv_q = sv_q + " and VAR_CRNCY_CODE='USD'  and rownum<2))   when gam.acct_crncy_code='EUR'       then (SUM(TRAN_AMT)*(select VAR_CRNCY_UNITS from tbaadm.rtl where bank_id='43' and del_flg='N' and RATECODE='MEAN' "
sv_q = sv_q + " and FXD_CRNCY_CODE='EUR' and VAR_CRNCY_CODE='USD' and rownum<2))    when gam.acct_crncy_code='ZAR'       then (SUM(TRAN_AMT)/(select VAR_CRNCY_UNITS from  "
sv_q = sv_q + " tbaadm.rtl where bank_id='43' and del_flg='N' and RATECODE='MEAN' and FXD_CRNCY_CODE='USD' and VAR_CRNCY_CODE='ZAR' and rownum<2))    when gam.acct_crncy_code='CHF' "
sv_q = sv_q + "   then (SUM(TRAN_AMT)/(select VAR_CRNCY_UNITS from tbaadm.rtl where bank_id='43' and del_flg='N' and RATECODE='MEAN' and FXD_CRNCY_CODE='USD' and VAR_CRNCY_CODE='CHF' "
sv_q = sv_q + " and rownum<2))     when gam.acct_crncy_code='CNY'       then (SUM(TRAN_AMT)/(select VAR_CRNCY_UNITS from tbaadm.rtl where bank_id='43' and del_flg='N' "
sv_q = sv_q + " and RATECODE='MEAN' and FXD_CRNCY_CODE='USD' and VAR_CRNCY_CODE='CNY' and rownum<2))     when gam.acct_crncy_code='XAF'       then (SUM(TRAN_AMT)/(select VAR_CRNCY_UNITS from tbaadm.rtl "
sv_q = sv_q + " where bank_id='43' and del_flg='N' and RATECODE='MEAN' and FXD_CRNCY_CODE='USD' and VAR_CRNCY_CODE='XAF' and rownum<2))   end) usdsumamt   FROM  "
sv_q = sv_q + " TBAADM.htd htd,tbaadm.gam, TBAADM.hth hth WHERE gam.bank_id= ?SVAR  and gam.bank_id=htd.bank_id   and gam.acid=htd.acid   "
sv_q = sv_q + " and  htd.bank_id = ?SVAR and htd.del_flg='N'     and gam.cif_id = ?SVAR  and PART_TRAN_TYPE ='D' AND htd.tran_date>= ?SVAR AND  htd.tran_date<= ?SVAR   and  hth.bank_id = ?SVAR "
sv_q = sv_q + "  and  htd.tran_id=hth.tran_id and  htd.tran_date=hth.tran_date and htd.bank_id=hth.bank_id and DELIVERY_CHANNEL_ID='PPN'  group by gam.acct_crncy_code    ) "
print(sv_q)
BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + CUST.DATA.Customercifid + "|" + CUST.DATA.Fromdate + "|" + CUST.DATA.todate + "|" +  BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + CUST.DATA.Customercifid + "|" + CUST.DATA.Fromdate + "|" + CUST.DATA.todate + "|" +  BANCS.STDIN.contextBankId 
print(BANCS.INPARAM.BINDVARS)
sv_p= urhk_dbSelectWithBind(sv_q)
print(sv_p)

if (sv_p==0) then


	CUST.DATA.ndebit = BANCS.OUTPARAM.ndebit
	print (CUST.DATA.ndebit)
	CUST.DATA.tdebit = BANCS.OUTPARAM.tdebit
	print (CUST.DATA.tdebit)

        IF (CUST.DATA.ndebit != "") THEN
		sv_z = urhk_SetOrbOut("COUNT_ALL_DEBIT|"+CUST.DATA.ndebit)
		print(sv_z)
	endif
	IF (CUST.DATA.tdebit != "") THEN
		sv_z = urhk_SetOrbOut("USD_TOTAL_DEBIT|"+CUST.DATA.tdebit)
		print(sv_z)
        Endif
	##sv_e=urhk_SetOrbOut("StattusCode|Success")
else
	CUST.DATA.errMsg="Data Error ...Note date format DD-MON-YYYY"
	sv_e=urhk_SetOrbOut("StattusCode|Error")
	sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
endif

sv_q = "ncredit,tcredit| "
sv_q = sv_q + " select nvl(sum(ncredit),0) ncredit,nvl(sum(usdsumamt),0) creditusdsumamt from (  "
sv_q = sv_q + " SELECT count (*) as ncredit , SUM(TRAN_AMT)  as tcredit,gam.acct_crncy_code,   "
sv_q = sv_q + "  (case when gam.acct_crncy_code='USD' then SUM(TRAN_AMT)  when gam.acct_crncy_code='CDF' "       
sv_q = sv_q + " then (SUM(TRAN_AMT)/(select VAR_CRNCY_UNITS from tbaadm.rtl where bank_id='43' and del_flg='N' and RATECODE='MEAN' and FXD_CRNCY_CODE='USD' and VAR_CRNCY_CODE='CDF' and rownum<2))  "
sv_q = sv_q + "    when gam.acct_crncy_code='GBP'    then (SUM(TRAN_AMT)*(select VAR_CRNCY_UNITS from tbaadm.rtl where bank_id='43' and del_flg='N' and RATECODE='MEAN' and FXD_CRNCY_CODE='GBP'  "
sv_q = sv_q + " and VAR_CRNCY_CODE='USD'  and rownum<2))   when gam.acct_crncy_code='EUR'       then (SUM(TRAN_AMT)*(select VAR_CRNCY_UNITS from tbaadm.rtl where bank_id='43' and del_flg='N' and RATECODE='MEAN' "
sv_q = sv_q + " and FXD_CRNCY_CODE='EUR' and VAR_CRNCY_CODE='USD' and rownum<2))    when gam.acct_crncy_code='ZAR'       then (SUM(TRAN_AMT)/(select VAR_CRNCY_UNITS from  "
sv_q = sv_q + " tbaadm.rtl where bank_id='43' and del_flg='N' and RATECODE='MEAN' and FXD_CRNCY_CODE='USD' and VAR_CRNCY_CODE='ZAR' and rownum<2))    when gam.acct_crncy_code='CHF' "
sv_q = sv_q + "   then (SUM(TRAN_AMT)/(select VAR_CRNCY_UNITS from tbaadm.rtl where bank_id='43' and del_flg='N' and RATECODE='MEAN' and FXD_CRNCY_CODE='USD' and VAR_CRNCY_CODE='CHF' "
sv_q = sv_q + " and rownum<2))     when gam.acct_crncy_code='CNY'       then (SUM(TRAN_AMT)/(select VAR_CRNCY_UNITS from tbaadm.rtl where bank_id='43' and del_flg='N' "
sv_q = sv_q + " and RATECODE='MEAN' and FXD_CRNCY_CODE='USD' and VAR_CRNCY_CODE='CNY' and rownum<2))     when gam.acct_crncy_code='XAF'       then (SUM(TRAN_AMT)/(select VAR_CRNCY_UNITS from tbaadm.rtl "
sv_q = sv_q + " where bank_id='43' and del_flg='N' and RATECODE='MEAN' and FXD_CRNCY_CODE='USD' and VAR_CRNCY_CODE='XAF' and rownum<2))   end) usdsumamt   FROM  "
sv_q = sv_q + " TBAADM.dtd dtd,tbaadm.gam, TBAADM.dth dth WHERE gam.bank_id= ?SVAR  and gam.bank_id=dtd.bank_id   and gam.acid=dtd.acid   "
sv_q = sv_q + " and  dtd.bank_id = ?SVAR and dtd.del_flg='N'     and gam.cif_id = ?SVAR    and PART_TRAN_TYPE ='C' AND dtd.tran_date>= ?SVAR AND  dtd.tran_date<= ?SVAR   and  dth.bank_id = ?SVAR "
sv_q = sv_q + "  and  dtd.tran_id=dth.tran_id and  dtd.tran_date=dth.tran_date and dtd.bank_id=dth.bank_id  and DELIVERY_CHANNEL_ID='PPN'  group by gam.acct_crncy_code "
sv_q = sv_q + "  union all  "
sv_q = sv_q + "     SELECT count (*) as ncredit , SUM(TRAN_AMT)  as tcredit,gam.acct_crncy_code,   "
sv_q = sv_q + "  (case when gam.acct_crncy_code='USD' then SUM(TRAN_AMT)  when gam.acct_crncy_code='CDF'  "      
sv_q = sv_q + " then (SUM(TRAN_AMT)/(select VAR_CRNCY_UNITS from tbaadm.rtl where bank_id='43' and del_flg='N' and RATECODE='MEAN' and FXD_CRNCY_CODE='USD' and VAR_CRNCY_CODE='CDF' and rownum<2))  "
sv_q = sv_q + "    when gam.acct_crncy_code='GBP'    then (SUM(TRAN_AMT)*(select VAR_CRNCY_UNITS from tbaadm.rtl where bank_id='43' and del_flg='N' and RATECODE='MEAN' and FXD_CRNCY_CODE='GBP'  "
sv_q = sv_q + " and VAR_CRNCY_CODE='USD'  and rownum<2))   when gam.acct_crncy_code='EUR'       then (SUM(TRAN_AMT)*(select VAR_CRNCY_UNITS from tbaadm.rtl where bank_id='43' and del_flg='N' and RATECODE='MEAN' "
sv_q = sv_q + " and FXD_CRNCY_CODE='EUR' and VAR_CRNCY_CODE='USD' and rownum<2))    when gam.acct_crncy_code='ZAR'       then (SUM(TRAN_AMT)/(select VAR_CRNCY_UNITS from  "
sv_q = sv_q + " tbaadm.rtl where bank_id='43' and del_flg='N' and RATECODE='MEAN' and FXD_CRNCY_CODE='USD' and VAR_CRNCY_CODE='ZAR' and rownum<2))    when gam.acct_crncy_code='CHF' "
sv_q = sv_q + "   then (SUM(TRAN_AMT)/(select VAR_CRNCY_UNITS from tbaadm.rtl where bank_id='43' and del_flg='N' and RATECODE='MEAN' and FXD_CRNCY_CODE='USD' and VAR_CRNCY_CODE='CHF' "
sv_q = sv_q + " and rownum<2))     when gam.acct_crncy_code='CNY'       then (SUM(TRAN_AMT)/(select VAR_CRNCY_UNITS from tbaadm.rtl where bank_id='43' and del_flg='N' "
sv_q = sv_q + " and RATECODE='MEAN' and FXD_CRNCY_CODE='USD' and VAR_CRNCY_CODE='CNY' and rownum<2))     when gam.acct_crncy_code='XAF'       then (SUM(TRAN_AMT)/(select VAR_CRNCY_UNITS from tbaadm.rtl "
sv_q = sv_q + " where bank_id='43' and del_flg='N' and RATECODE='MEAN' and FXD_CRNCY_CODE='USD' and VAR_CRNCY_CODE='XAF' and rownum<2))   end) usdsumamt   FROM  "
sv_q = sv_q + " TBAADM.htd htd,tbaadm.gam, TBAADM.hth hth WHERE gam.bank_id= ?SVAR  and gam.bank_id=htd.bank_id   and gam.acid=htd.acid   "
sv_q = sv_q + " and  htd.bank_id = ?SVAR and htd.del_flg='N'     and gam.cif_id = ?SVAR  and PART_TRAN_TYPE ='C' AND htd.tran_date>= ?SVAR AND  htd.tran_date<= ?SVAR   and  hth.bank_id = ?SVAR "
sv_q = sv_q + "  and  htd.tran_id=hth.tran_id and  htd.tran_date=hth.tran_date and htd.bank_id=hth.bank_id and DELIVERY_CHANNEL_ID='PPN'  group by gam.acct_crncy_code    ) "
print(sv_q)
BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + CUST.DATA.Customercifid + "|" + CUST.DATA.Fromdate + "|" + CUST.DATA.todate + "|" +  BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + CUST.DATA.Customercifid + "|" + CUST.DATA.Fromdate + "|" + CUST.DATA.todate + "|" +  BANCS.STDIN.contextBankId 
print(BANCS.INPARAM.BINDVARS)
sv_p= urhk_dbSelectWithBind(sv_q)
print(sv_p)

if (sv_p==0) then


	CUST.DATA.ncredit = BANCS.OUTPARAM.ncredit
	print (CUST.DATA.ncredit)
	CUST.DATA.tcredit = BANCS.OUTPARAM.tcredit
	print (CUST.DATA.tcredit)

        IF (CUST.DATA.ncredit != "") THEN
		sv_z = urhk_SetOrbOut("COUNT_ALL_CREDIT|"+CUST.DATA.ncredit)
		print(sv_z)
	endif
	IF (CUST.DATA.tcredit != "") THEN
		sv_z = urhk_SetOrbOut("USD_TOTAL_CREDIT|"+CUST.DATA.tcredit)
		print(sv_z)
        Endif

	sv_e=urhk_SetOrbOut("StattusCode|Success")
else
