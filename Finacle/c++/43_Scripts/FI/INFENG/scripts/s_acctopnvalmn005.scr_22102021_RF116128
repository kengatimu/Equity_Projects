<--START
TRACE ON
	############################################################
	# Creating Repository
	############################################################
	
	IF(REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	IF(CLASSEXISTS("CUST","ACCOPEN") == 0) THEN
	#{	
		CREATECLASS("CUST","ACCOPEN",5)
	#}
	ENDIF
	
	############################################################
	# Initilization Varaiables
	############################################################
	
	CUST.ACCOPEN.errMsg        			= ""	
	CUST.ACCOPEN.glSHCode				= ""
	CUST.ACCOPEN.sectorCode1			= ""
	CUST.ACCOPEN.schmType			= ""
	CUST.ACCOPEN.subSectorCode1 		= ""
	CUST.ACCOPEN.acctOccpCode1			= ""
	CUST.ACCOPEN.borrowerCategoryCode1	= ""
	CUST.ACCOPEN.purposeOfAdvn1			= ""
	CUST.ACCOPEN.modeOfAdvn1			= ""
	CUST.ACCOPEN.typeOfAdvn1			= ""
	CUST.ACCOPEN.natureOfAdvn1			= ""
	BANCS.INPUT.moduleName				="ACCOUNT_OPENING"


	#########################################################
	# Fetching Value from CPARAM
	#########################################################
	BANCS.INPUT.parameterId="GLSUBCOD_LST1" 
	call("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.ACCOPEN.glsubCodLst = BANCS.OUTPUT.parameterVal
	#}
	ELSE
	#{
		CUST.ACCOPEN.errMsg = "GL SUBHEAD CODE setup is not done in CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	########################################################################
	# Getting value from front end
	#########################################################################
	
	


	sv_u = urhk_SRV_GetVal("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmCode")
	PRINT(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.ACCOPEN.schmCode = TOUPPER(BANCS.OUTPARAM.srvValue)
		PRINT(CUST.ACCOPEN.schmCode)
	#}
	ENDIF
	sv_u = urhk_SRV_GetVal("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmType")
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
			CUST.ACCOPEN.schmType = TOUPPER(BANCS.OUTPARAM.srvValue)
			PRINT(CUST.ACCOPEN.schmType)
		#}
	ENDIF
	
	sv_u = urhk_SRV_GetVal("acctCommonInfo.acctGeneralInfo.acctBasic.glSubHeadCode.glSubHeadCode")
	print(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.ACCOPEN.glSHCode=TOUPPER(BANCS.OUTPARAM.srvValue)
		print(CUST.ACCOPEN.glSHCode)
	#}
	ENDIF
	
	sv_u = urhk_SRV_GetVal("acctCommonInfo.acctClassMISC.sectorCode.refCode")
	print(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.ACCOPEN.sectorCode1 = TOUPPER(BANCS.OUTPARAM.srvValue)
		print(CUST.ACCOPEN.sectorCode1)
	#}
	ENDIF
		
	sv_u=urhk_SRV_GetVal("acctCommonInfo.acctClassMISC.subSectorCode.refCode")
	print(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.ACCOPEN.subSectorCode1 = TOUPPER(BANCS.OUTPARAM.srvValue)
		print(CUST.ACCOPEN.subSectorCode1)
	#}
	ENDIF
	
	sv_u = urhk_SRV_GetVal("acctCommonInfo.acctClassMISC.acctOccpCode.refCode")
	print(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.ACCOPEN.acctOccpCode1 = TOUPPER(BANCS.OUTPARAM.srvValue)
		print(CUST.ACCOPEN.acctOccpCode1)
	#}
	ENDIF
			
	sv_u=urhk_SRV_GetVal("acctCommonInfo.acctClassMISC.borrowerCategoryCode.refCode")
	print(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.ACCOPEN.borrowerCategoryCode1 = TOUPPER(BANCS.OUTPARAM.srvValue)
		print(CUST.ACCOPEN.borrowerCategoryCode1)
	#}
	ENDIF
	
	sv_u = urhk_SRV_GetVal("acctCommonInfo.acctClassMISC.purposeOfAdvn.refCode")
	print(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.ACCOPEN.purposeOfAdvn1 = TOUPPER(BANCS.OUTPARAM.srvValue)
		print(CUST.ACCOPEN.purposeOfAdvn1)
	#}
	ENDIF
			
	sv_u=urhk_SRV_GetVal("acctCommonInfo.acctClassMISC.modeOfAdvn.refCode")
	print(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.ACCOPEN.modeOfAdvn1 = TOUPPER(BANCS.OUTPARAM.srvValue)
		print(CUST.ACCOPEN.modeOfAdvn1)
	#}
	ENDIF
	
	sv_u = urhk_SRV_GetVal("acctCommonInfo.acctClassMISC.typeOfAdvn.refCode")
	print(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.ACCOPEN.typeOfAdvn1 = TOUPPER(BANCS.OUTPARAM.srvValue)
		print(CUST.ACCOPEN.typeOfAdvn1)
	#}
	ENDIF
	
	sv_u=urhk_SRV_GetVal("acctCommonInfo.acctClassMISC.natureOfAdvn.refCode")
	print(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.ACCOPEN.natureOfAdvn1 = TOUPPER(BANCS.OUTPARAM.srvValue)
		print(CUST.ACCOPEN.natureOfAdvn1)
	#}
	ENDIF
	
	sv_u=urhk_SRV_GetVal("acctCommonInfo.acctClassMISC.freeText10")
	print(sv_u)
	IF (sv_u == 0) THEN
	#{
		
		
		CUST.ACCOPEN.freeText10 = TOUPPER(BANCS.OUTPARAM.srvValue)
		print(CUST.ACCOPEN.freeText10)

		IF(BANCS.STDIN.contextBankId == "43") THEN
			IF (CUST.ACCOPEN.schmType=="ODA") THEN
				IF (trim(CUST.ACCOPEN.freeText10) =="") THEN
					sv_u = urhk_SRV_setErr("acctCommonInfo.acctClassMISC.freeText10|Quaterly Fee Percentage  is mandatory - freeText10")
					BANCS.OUTPUT.successOrFailure="F"
					GOTO ENDOFSCRIPT
				ELSE
					sv_s = "SpecChar|SELECT REGEXP_INSTR(?SVAR,'[^0-9 . ]') FROM dual  "
					BANCS.INPARAM.BINDVARS =  CUST.ACCOPEN.freeText10
					sv_u = urhk_dbSelectWithBind(sv_s)
					IF (sv_d == 0) THEN
					CUST.ACCOPEN.SpecChar=BANCS.OUTPARAM.SpecChar
					PRINT(CUST.ACCOPEN.SpecChar)
						IF (CUST.ACCOPEN.SpecChar > 0) THEN
							sv_u = urhk_SRV_setErr("acctCommonInfo.acctClassMISC.freeText10|Only numbers allowed - freeText10")
							BANCS.OUTPUT.successOrFailure="F"
							GOTO ENDOFSCRIPT
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		
	#}
	ENDIF

	sv_w = getPosition(CUST.ACCOPEN.glsubCodLst,"|"+CUST.ACCOPEN.glSHCode+"|")	

	IF (sv_w > 0) THEN	
	#{
		IF(CUST.ACCOPEN.sectorCode1 == "") THEN
		#{
			sv_u = urhk_SRV_setErr("acctCommonInfo.acctClassMISC.sectorCode.refCode|Sector Code field is mandatory")
			BANCS.OUTPUT.successOrFailure="F"
			GOTO ENDOFSCRIPT		
		#}
		ENDIF

		IF(CUST.ACCOPEN.subSectorCode1 == "") THEN
		#{
			sv_u = urhk_SRV_setErr("acctCommonInfo.acctClassMISC.subSectorCode.refCode|Subsector Code field is mandatory")
			BANCS.OUTPUT.successOrFailure="F"
			GOTO ENDOFSCRIPT	
		#}
		ENDIF

		IF(CUST.ACCOPEN.acctOccpCode1 == "") THEN
		#{
			sv_u = urhk_SRV_setErr("acctCommonInfo.acctClassMISC.acctOccpCode.refCode|Occupation Code field is mandatory")
			BANCS.OUTPUT.successOrFailure="F"
			GOTO ENDOFSCRIPT	
		#}
		ENDIF

		IF(CUST.ACCOPEN.borrowerCategoryCode1 == "") THEN
		#{
			sv_u = urhk_SRV_setErr("acctCommonInfo.acctClassMISC.borrowerCategoryCode.refCode|Borrower Categroy Code field is mandatory")
			BANCS.OUTPUT.successOrFailure="F"
			GOTO ENDOFSCRIPT	
		#}
		ENDIF

		IF(CUST.ACCOPEN.purposeOfAdvn1 == "") THEN
		#{
			sv_u = urhk_SRV_setErr("acctCommonInfo.acctClassMISC.purposeOfAdvn.refCode|Purpose Of Advance field is mandatory")
			BANCS.OUTPUT.successOrFailure="F"
			GOTO ENDOFSCRIPT	
		#}
		ENDIF

		IF(CUST.ACCOPEN.modeOfAdvn1 == "") THEN
		#{
			sv_u = urhk_SRV_setErr("acctCommonInfo.acctClassMISC.modeOfAdvn.refCode|Mode Of Advance field is mandatory")
			BANCS.OUTPUT.successOrFailure="F"
			GOTO ENDOFSCRIPT	
		#}
		ENDIF

		IF(CUST.ACCOPEN.typeOfAdvn1 == "") THEN
		#{
			sv_u = urhk_SRV_setErr("acctCommonInfo.acctClassMISC.typeOfAdvn.refCode|Type Of Advance field is mandatory")
			BANCS.OUTPUT.successOrFailure="F"
			GOTO ENDOFSCRIPT	
		#}
		ENDIF

		IF (CUST.ACCOPEN.natureOfAdvn1 == "") THEN
		#{
			sv_u = urhk_SRV_setErr("acctCommonInfo.acctClassMISC.natureOfAdvn.refCode|Nature Of Advance field is mandatory")
			BANCS.OUTPUT.successOrFailure="F"
			GOTO ENDOFSCRIPT	
		#}
		ENDIF
	#}
	ENDIF


IF (BANCS.STDIN.moduleIdentity !="FI") THEN
#{
	IF(BANCS.STDIN.contextBankId == "50") THEN
	#{
		sv_u = urhk_SRV_GetVal("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmType")
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
			CUST.ACCOPEN.schmType = TOUPPER(BANCS.OUTPARAM.srvValue)
			PRINT(CUST.ACCOPEN.schmType)
		#}
		ENDIF
		
		CUST.ACCOPEN.schmType = TRIM(CUST.ACCOPEN.schmType)
		PRINT(CUST.ACCOPEN.schmType)

		IF ((CUST.ACCOPEN.schmType == "CAA") OR (CUST.ACCOPEN.schmType == "TDA")) THEN
		#{
			
			sv_a = urhk_SRV_GetVal("acctCommonInfo.acctClassMISC.freeCode3.refCode")
			sv_a = BANCS.OUTPARAM.srvValue
			PRINT(sv_a)
			CUST.ACCOPEN.amt = sv_a
			IF (sv_a == "") THEN
			#{
				sv_u = urhk_SRV_setErr("acctCommonInfo.acctClassMISC.freeCode3.refCode|Economic Subsector is Mandatory - Free Code 3")
				BANCS.OUTPUT.successOrFailure="F"
				GOTO ENDOFSCRIPT
				#}
			ENDIF
			sv_a = urhk_SRV_GetVal("acctCommonInfo.acctClassMISC.freeCode5.refCode")
			sv_a = BANCS.OUTPARAM.srvValue
			PRINT(sv_a)
			CUST.ACCOPEN.amt = sv_a
			IF (sv_a == "") THEN
			#{
				sv_u = urhk_SRV_setErr("acctCommonInfo.acctClassMISC.freeCode5.refCode|The Economic Sector Code - ISIC is Mandatory - Free Code 5")
				BANCS.OUTPUT.successOrFailure="F"
				GOTO ENDOFSCRIPT
				#}
			ENDIF
			sv_a = urhk_SRV_GetVal("acctCommonInfo.acctClassMISC.freeCode7.refCode")
			sv_a = BANCS.OUTPARAM.srvValue
			PRINT(sv_a)
			CUST.ACCOPEN.amt = sv_a
			IF (sv_a == "") THEN
			#{
				sv_u = urhk_SRV_setErr("acctCommonInfo.acctClassMISC.freeCode7.refCode|The Public Sector Code is Mandatory - Free Code 7")
				BANCS.OUTPUT.successOrFailure="F"
				GOTO ENDOFSCRIPT
				#}
			ENDIF
			sv_a = urhk_SRV_GetVal("acctCommonInfo.acctClassMISC.freeCode8.refCode")
			sv_a = BANCS.OUTPARAM.srvValue
			PRINT(sv_a)
			CUST.ACCOPEN.amt = sv_a
			IF (sv_a == "") THEN
			#{
				sv_u = urhk_SRV_setErr("acctCommonInfo.acctClassMISC.freeCode8.refCode|The Institutional Sector Code is Mandatory - Free Code 8")
				BANCS.OUTPUT.successOrFailure="F"
				GOTO ENDOFSCRIPT
				#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF

	IF(BANCS.STDIN.contextBankId == "56") THEN
	#{	
		CUST.ACCOPEN.glsubCodLst2 = "|35001|35002|"

		sv_x = getPosition(CUST.ACCOPEN.glsubCodLst2,"|"+CUST.ACCOPEN.glSHCode+"|")	

		IF (sv_x > 0) THEN	
		#{
			IF(CUST.ACCOPEN.freeText10 == "") THEN
			#{
				sv_u = urhk_SRV_setErr("acctCommonInfo.acctClassMISC.freeText10|STAFF ID is mandatory - Free Text 10 is mandatory")
				BANCS.OUTPUT.successOrFailure="F"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
ENDIF

ENDOFSCRIPT:
IF(CUST.ACCOPEN.errMsg != "") THEN
#{
        sv_u = urhk_SRV_setErr(CUST.ACCOPEN.errMsg)
#}
ENDIF

TRACE OFF
EXITSCRIPT
