<--START
TRACE ON
	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	sv_r = CLASSEXISTS("CUST","CLA")
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","CLA",5)
	#}
	ENDIF

	CUST.CLA.txndate = MID$(BANCS.STDIN.BODDate,0,10)
	PRINT(CUST.CLA.txndate)
	
	IF(FIELDEXISTS(BANCS.INPUT.acctNum))THEN
	#{
		CUST.CLA.acctNum = BANCS.INPUT.acctNum
		PRINT(CUST.CLA.acctNum)
		sv_s = "txnid|SELECT TRAN_ID FROM CUSTOM.C_CRLINE_CHRG_MAINT_TBL WHERE CRLINE_ACNT=?SVAR AND BANK_ID=?SVAR"
		sv_s = sv_s + " AND TO_DATE(TRAN_DATE,'DD-MM-YY')=TO_DATE(?SVAR,'DD-MM-YY')"
		BANCS.INPARAM.BINDVARS = CUST.CLA.acctNum +"|"+ BANCS.STDIN.contextBankId +"|"+ MID$(BANCS.STDIN.BODDate,0,10)

        	PRINT(sv_s)
		PRINT(BANCS.INPARAM.BINDVARS)
        	sv_d = urhk_dbSelectWithBind(sv_s)
        	PRINT(sv_s)
		IF(sv_d == "0")THEN
		#{
			CUST.CLA.txnid = BANCS.OUTPARAM.txnid
			PRINT(CUST.CLA.txnid)
		#}
		ELSE
		#{	
			CUST.CLA.txnid = " "
			CUST.CLA.txndate = " "
		#}
		ENDIF
	#}
	ELSE
	#{	
		CUST.CLA.txnid = " "
		CUST.CLA.txndate = " "
	#}
	ENDIF

ENDOFSCRIPT:
	sv_u = urhk_SetOrbOut("txnid|"+CUST.CLA.txnid)
	sv_u = urhk_SetOrbOut("txndate|"+CUST.CLA.txndate)
TRACE OFF
END-->
