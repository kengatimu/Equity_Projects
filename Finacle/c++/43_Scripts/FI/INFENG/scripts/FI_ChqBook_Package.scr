<--START
TRACE ON

        sv_u=REPEXISTS("CUST")
        IF(sv_u==0) THEN
        #{
                CREATEREP("CUST")
        #}
        ENDIF

        sv_u=CLASSEXISTS("CUST", "CSEG")
        IF(sv_u==0) THEN
        #{
                CREATECLASS("CUST", "CSEG", 5)
        #}
        ENDIF

        sv_t=urhk_b2k_printrepos("BANCS")
        print(sv_t)

        IF( (FIELDEXISTS(("BANCS").("INPUT").("bankId"))== 0) ) THEN
        #{
                CUST.CSEG.errMsg="please enter Bank Id"
                sv_t = "ERROR | " +CUST.CSEG.errMsg
                sv_u = urhk_SetOrbOut(sv_t)
                GOTO ENDSCRIPT
        #}
        ENDIF

        IF( (FIELDEXISTS(("BANCS").("INPUT").("downloadId"))== 0) ) THEN
        #{
                CUST.CSEG.errMsg="please enter Download Id"
                sv_t = "ERROR | " +CUST.CSEG.errMsg
                sv_u = urhk_SetOrbOut(sv_t)
                GOTO ENDSCRIPT
        #}
        ENDIF

        CUST.CSEG.count = 0
        #---------------------------------------------------------------------------------------------------------------
        # Variable Initialization
        #---------------------------------------------------------------------------------------------------------------

        CUST.CSEG.bankId= BANCS.INPUT.bankId
        print(CUST.CSEG.bankId)

        CUST.CSEG.downloadId= BANCS.INPUT.downloadId
        print(CUST.CSEG.downloadId)

        sv_s="downloadId,branchId,branchName,reqDate,chqBookStatus,noOfChqBook |"
        sv_s=sv_s + "SELECT DOWNLOAD_ID,(select sol_id from tbaadm.sol where sol_id=branch_id and bank_id=bank_id) as branch_id, "
        sv_s=sv_s + "(select sol_desc from tbaadm.sol where sol_id=branch_id and bank_id=bank_id) as branch_name,to_char(req_date,'dd-mm-yyyy'),"
	sv_s=sv_s + "req_status,count(1) as noOfChqBook "
        sv_s=sv_s + "from custom.custom_cbr "
        sv_s=sv_s + "where DOWNLOAD_ID=?SVAR and req_status in ('B','R','S','K') and del_flg='N' and bank_id=?SVAR "
        sv_s=sv_s + "group by DOWNLOAD_ID,branch_id,req_status,req_date order by branch_id asc"
        print(sv_s)

        BANCS.INPARAM.BINDVARS = CUST.CSEG.downloadId+ "|" +CUST.CSEG.bankId
        print(BANCS.INPARAM.BINDVARS)

        sv_c = urhk_dbcursorOpenWithBind(sv_s)
        PRINT(sv_c)

        IF(sv_c == 0) THEN
         #{
                CUST.CSEG.DB_CURSOR_NUMBER = BANCS.OUTPARAM.DB_CURSOR_NUMBER
                print(CUST.CSEG.DB_CURSOR_NUMBER)


                sv_c = urhk_dbCursorFetch(CUST.CSEG.DB_CURSOR_NUMBER)
                print(sv_c)

                IF(sv_c != "0")THEN
                #{
                        sv_e = urhk_SetOrbOut("SuccessorFailure|Failed")
                        sv_u = urhk_SetOrbOut("Failure| No record found")
                        print(sv_u)
                #}
                ENDIF

                WHILE(sv_c == "0")
                #{
                        CUST.CSEG.downloadId= BANCS.OUTPARAM.downloadId
                        print(CUST.CSEG.downloadId)

                        CUST.CSEG.branchId= BANCS.OUTPARAM.branchId
                        print(CUST.CSEG.branchId)

                        CUST.CSEG.branchName= BANCS.OUTPARAM.branchName
                        print(CUST.CSEG.branchName)

                        CUST.CSEG.chqBookStatus= BANCS.OUTPARAM.chqBookStatus
                        print(CUST.CSEG.branchName)

			CUST.CSEG.reqDate= BANCS.OUTPARAM.reqDate
                        print(CUST.CSEG.reqDate)	

                        CUST.CSEG.noOfChqBook= BANCS.OUTPARAM.noOfChqBook
                        print(CUST.CSEG.noOfChqBook)

                        CUST.CSEG.count = CINT(CUST.CSEG.count)+ 1
                        print(CUST.CSEG.count)

                        sv_c = urhk_SetOrbOut("ChequeBookDetails.<rec_"+CUST.CSEG.count+">.Download_Id"+"| "+CUST.CSEG.downloadId)
                        print(sv_c)

                        sv_c = urhk_SetOrbOut("ChequeBookDetails.<rec_"+CUST.CSEG.count+">.Branch_Id"+"| "+CUST.CSEG.branchId)
                        print(sv_c)

                        sv_c = urhk_SetOrbOut("ChequeBookDetails.<rec_"+CUST.CSEG.count+">.Branch_Name"+"| "+CUST.CSEG.branchName)
                        print(sv_c)

                        sv_c = urhk_SetOrbOut("ChequeBookDetails.<rec_"+CUST.CSEG.count+">.ChqBookStatus"+"| "+CUST.CSEG.chqBookStatus)
                        print(sv_c)

			sv_c = urhk_SetOrbOut("ChequeBookDetails.<rec_"+CUST.CSEG.count+">.Req_Date"+"| "+CUST.CSEG.reqDate)
                        print(sv_c)

                        sv_c = urhk_SetOrbOut("ChequeBookDetails.<rec_"+CUST.CSEG.count+">.NoOfChqBook"+"| "+CUST.CSEG.noOfChqBook)
                        print(sv_c)

                        sv_c = urhk_dbCursorFetch(CUST.CSEG.DB_CURSOR_NUMBER)
                        print(sv_c)

                #}
                DO
                sv_c = urhk_dbCursorClose(CUST.CSEG.DB_CURSOR_NUMBER)
                print(sv_c)
        #}
        ENDIF
        EXITSCRIPT


ENDOFSCRIPT:
END-->
