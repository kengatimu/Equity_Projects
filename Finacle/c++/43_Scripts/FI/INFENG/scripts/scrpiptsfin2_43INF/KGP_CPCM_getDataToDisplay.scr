                        PRINT(BANCS.INPARAM.BINDVARS)

                        sv_x="rcreuser,del_flg,entity_cre_flg|select rcre_user_id,del_flg,entity_cre_flg,AGREEMENT_CODE,EVENT_TYPE,EVENT_ID from CUSTOM.C_CPCM_MOD where AGREEMENT_CODE= ?SVAR AND EVENT_TYPE =?SVAR AND EVENT_ID =?SVAR"
                        sv_x = sv_x + " and del_flg='N' and entity_cre_flg='N' AND BANK_ID = ?SVAR and rownum<2 "
                        print(sv_x)
