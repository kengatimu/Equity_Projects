                                        CUST.CPCM.errorFocus = "acctId"
                                        GOTO ERROR
                                #}
                                ENDIF
                        #}
                        ENDIF
		#}
                ENDIF
		
		#---------------------------------------------
        #       Inquire and Modify block
        #---------------------------------------------

                IF((CUST.CPCM.funcCode == "M") OR (CUST.CPCM.funcCode == "I"))THEN
                #{
                        IF(CUST.CPCM.funcCode != "I") THEN
                        #{
                                IF(CDOUBLE(CUST.CPCM.modTableCount) > 0) THEN
                                #{
                                        CUST.CPCM.error      = "Record modified, Verification is pending"
                                        CUST.CPCM.errorFocus = "funcCode"
                                        GOTO ERROR
                                #}
                                ENDIF
                        #}
                        ENDIF
                        lv_q =  " startDate,endDate,percent,value1,value2 |"
                        lv_q = lv_q + " SELECT TO_CHAR(START_DATE,'DD-MM-YYYY'),TO_CHAR(END_DATE,'DD-MM-YYYY'),PERCENT,PERCENT_VALUE,AMT_VALUE "
                        lv_q = lv_q + " FROM CUSTOM.C_CPCM_DATA WHERE CUST_ID = ?SVAR  AND EVENT_TYPE = ?SVAR AND EVENT_ID = ?SVAR AND ENTITY_CRE_FLG = 'Y' AND DEL_FLG != 'Y' AND BANK_ID = ?SVAR"
                        PRINT(lv_q)

                        BANCS.INPARAM.BINDVARS = CUST.CPCM.custId +"|"+ CUST.CPCM.evtType+"|"+CUST.CPCM.evtId+"|"+BANCS.STDIN.contextBankId
                        PRINT(BANCS.INPARAM.BINDVARS)

