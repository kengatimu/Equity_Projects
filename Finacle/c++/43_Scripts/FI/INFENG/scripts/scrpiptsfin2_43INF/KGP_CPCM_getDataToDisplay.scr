                        ENDIF

                        IF(CDOUBLE(CUST.CPCM.modTableCount) > 0) THEN
                        #{
                                CUST.CPCM.error      = "Record already exists and pending verification."
                                CUST.CPCM.errorFocus = "funcCode"
