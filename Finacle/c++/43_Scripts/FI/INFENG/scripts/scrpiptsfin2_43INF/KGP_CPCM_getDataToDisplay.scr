	#---------------------------------------------
        #       Fetching table counts
        #---------------------------------------------
        IF(CUST.CPCM.preferentialLevel == "AG") THEN
        #{

                lv_q = "mainTableCount|SELECT COUNT(1) FROM CUSTOM.C_CPCM_DATA WHERE AGREEMENT_CODE = ?SVAR AND DEL_FLG != 'Y' AND EVENT_TYPE =?SVAR AND EVENT_ID =?SVAR AND BANK_ID = ?SVAR "
                PRINT(lv_q)

                BANCS.INPARAM.BINDVARS = CUST.CPCM.empId +"|"+ CUST.CPCM.evtType+"|"+CUST.CPCM.evtId+"|"+BANCS.STDIN.contextBankId
                PRINT(BANCS.INPARAM.BINDVARS)

                lv_u = urhk_dbSelectWithBind(lv_q)
