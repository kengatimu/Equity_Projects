                ENDIF

                lv_q = "modTableCount|SELECT COUNT(1) FROM CUSTOM.C_CPCM_MOD WHERE CUST_ID = ?SVAR AND DEL_FLG != 'Y' AND EVENT_TYPE = ?SVAR AND EVENT_ID = ?SVAR AND BANK_ID = ?SVAR "
                PRINT(lv_q)

                BANCS.INPARAM.BINDVARS = CUST.CPCM.custId +"|"+ CUST.CPCM.evtType+"|"+CUST.CPCM.evtId+"|"+BANCS.STDIN.contextBankId
                PRINT(BANCS.INPARAM.BINDVARS)

                lv_u = urhk_dbSelectWithBind(lv_q)
                PRINT(lv_u)

                IF(lv_u == "0") THEN
                #{
                        CUST.CPCM.modTableCount = BANCS.OUTPARAM.modTableCount
                        PRINT(CUST.CPCM.modTableCount)
                #}
                ENDIF

	#-------------------------
        #       Add block
        #------------------------

                IF(CUST.CPCM.funcCode == "A")THEN
                #{
                        IF(CDOUBLE(CUST.CPCM.mainTableCount) > 0) THEN
                        #{
                                CUST.CPCM.error      = "Record already exists, Only can Modify"
                                CUST.CPCM.errorFocus = "funcCode"
                                GOTO ERROR
