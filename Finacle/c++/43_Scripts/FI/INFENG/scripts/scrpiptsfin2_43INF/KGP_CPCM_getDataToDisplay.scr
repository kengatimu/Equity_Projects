                        sv_x="rcreuser,del_flg,entity_cre_flg|select rcre_user_id,del_flg,entity_cre_flg,PREFERENTIAL_LEVEL from CUSTOM.C_CPCM_MOD where PREFERENTIAL_LEVEL= ?SVAR "
                        sv_x = sv_x + " and del_flg='N' and entity_cre_flg='N' AND BANK_ID = ?SVAR and rownum<2 "
                        print(sv_x)
                        sv_d=urhk_dbselectWithBind(sv_x)
                        PRINT(sv_d)

                        IF(sv_d==0) THEN
                        #{
                                CUST.CPCM.rcreuser=BANCS.OUTPARAM.rcreuser
                                CUST.CPCM.del_flg=BANCS.OUTPARAM.del_flg
                                CUST.CPCM.entity_cre_flg=BANCS.OUTPARAM.entity_cre_flg

                        #}
                        ELSE
                        #{
                                 CUST.CPCM.error = "No records found"
                                 CUST.CPCM.erroFocus = "funcCode"
                                 GOTO ERROR
                        #}
                        ENDIF

                        IF(CUST.CPCM.rcreuser==CUST.CPCM.userId) THEN
                        #{
                                CUST.CPCM.error = "Same user cannot verify"
                                CUST.CPCM.erroFocus = "funcCode"
                                GOTO ERROR

                        #}
                        ENDIF	
		#}
                ENDIF

	#---------------------------------------------
        #       Verify and Cancel block
        #---------------------------------------------

                IF((CUST.CPCM.funcCode == "V") OR (CUST.CPCM.funcCode == "X"))THEN
                #{
                        lv_q = "evtType,evtId,startDate,endDate,percent,value1,value2 |"
                        lv_q = lv_q + " SELECT EVENT_TYPE,EVENT_ID,TO_CHAR(START_DATE,'DD-MM-YYYY'),TO_CHAR(END_DATE,'DD-MM-YYYY'),PERCENT,PERCENT_VALUE,AMT_VALUE"
                        lv_q = lv_q + " FROM CUSTOM.C_CPCM_MOD WHERE PREFERENTIAL_LEVEL = ?SVAR AND ENTITY_CRE_FLG = 'N' AND DEL_FLG != 'Y' AND BANK_ID = ?SVAR"
                        PRINT(lv_q)

                        BANCS.INPARAM.BINDVARS = CUST.CPCM.preferentialLevel +"|"+ BANCS.STDIN.contextBankId
                        PRINT(BANCS.INPARAM.BINDVARS)

                        lv_r = urhk_dbSelectWithBind(lv_q)
                        PRINT(lv_r)

                        IF(lv_r == "0")THEN
                        #{
                                CUST.CPCM.evtType               = BANCS.OUTPARAM.evtType
                                CUST.CPCM.evtId                 = BANCS.OUTPARAM.evtId
                                CUST.CPCM.startDate             = BANCS.OUTPARAM.startDate
                                CUST.CPCM.endDate               = BANCS.OUTPARAM.endDate
                                CUST.CPCM.percent               = BANCS.OUTPARAM.percent
                                CUST.CPCM.value1                 = BANCS.OUTPARAM.value1
                                CUST.CPCM.value2                = BANCS.OUTPARAM.value2
                                PRINT(CUST.CPCM.evtType)
                                PRINT(CUST.CPCM.evtId)
                                PRINT(CUST.CPCM.startDate)
                                PRINT(CUST.CPCM.endDate)
                                PRINT(CUST.CPCM.percent)
                                PRINT(CUST.CPCM.value1)
                                PRINT(CUST.CPCM.value2)
                        #}
                        ELSE
			#{
                                IF(CDOUBLE(CUST.CPCM.mainTableCount) > 0) THEN
                                #{
                                        CUST.CPCM.error      = "There is nothing to verify or cancel."
                                        CUST.CPCM.errorFocus = "funcCode"
                                        GOTO ERROR
                                #}
                                ELSE
                                #{
                                        CUST.CPCM.error      = "Record is not found for the given criteria."
                                        CUST.CPCM.errorFocus = "acctId"
                                        GOTO ERROR
                                #}
                                ENDIF
                        #}
                        ENDIF
                #}
                ENDIF

	#---------------------------------------------
        #       Inquire and Modify block
        #---------------------------------------------

                IF((CUST.CPCM.funcCode == "M") OR (CUST.CPCM.funcCode == "I"))THEN
                #{
                        IF(CUST.CPCM.funcCode != "I") THEN
                        #{
                                IF(CDOUBLE(CUST.CPCM.modTableCount) > 0) THEN
                                #{
                                        CUST.CPCM.error      = "Record modified, Verification is pending"
                                        CUST.CPCM.errorFocus = "funcCode"
                                        GOTO ERROR
                                #}
                                ENDIF
                        #}
                        ENDIF
                        lv_q =  " evtType,evtId,startDate,endDate,percent,value1,value2 |"
                        lv_q = lv_q + " SELECT EVENT_TYPE,EVENT_ID,TO_CHAR(START_DATE,'DD-MM-YYYY'),TO_CHAR(END_DATE,'DD-MM-YYYY'),PERCENT,PERCENT_VALUE,AMT_VALUE "
                        lv_q = lv_q + " FROM CUSTOM.C_CPCM_DATA WHERE PREFERENTIAL_LEVEL = ?SVAR AND ENTITY_CRE_FLG = 'Y' AND DEL_FLG != 'Y' AND BANK_ID = ?SVAR"
                        PRINT(lv_q)

                        BANCS.INPARAM.BINDVARS = CUST.CPCM.preferentialLevel +"|"+ BANCS.STDIN.contextBankId
                        PRINT(BANCS.INPARAM.BINDVARS)

                        lv_r = urhk_dbSelectWithBind(lv_q)
                        PRINT(lv_r)

                        IF(lv_r == "0")THEN
                        #{
                                CUST.CPCM.evtType               = BANCS.OUTPARAM.evtType
                                CUST.CPCM.evtId                 = BANCS.OUTPARAM.evtId
                                CUST.CPCM.startDate             = BANCS.OUTPARAM.startDate
                                CUST.CPCM.endDate               = BANCS.OUTPARAM.endDate
                                CUST.CPCM.percent               = BANCS.OUTPARAM.percent
                                CUST.CPCM.value1                 = BANCS.OUTPARAM.value1
                                CUST.CPCM.value2                = BANCS.OUTPARAM.value2
                                PRINT(CUST.CPCM.evtType)
                                PRINT(CUST.CPCM.evtId)
                                PRINT(CUST.CPCM.startDate)
                                PRINT(CUST.CPCM.endDate)
                                PRINT(CUST.CPCM.percent)
				PRINT(CUST.CPCM.value1)
                                PRINT(CUST.CPCM.value2)
                        #}
                        ELSE
                        #{
                                CUST.CPCM.error      = "Record does not exists."
                                CUST.CPCM.errorFocus = "acctId"
                                GOTO ERROR
                        #}
                        ENDIF

                #}
                ENDIF
        #}
        ENDIF

        #---------------------------------------------
        #       Amount formating
        #---------------------------------------------

                BANCS.INPARAM.BINDVARS = CUST.CPCM.value1 +"|"+ CUST.CPCM.value2
                print(BANCS.INPARAM.BINDVARS)

                sv_z = "value1,value2|SELECT REPLACE(?SVAR,'.',','),REPLACE(?SVAR,'.',',') FROM DUAL"
                print(sv_z)

                sv_q = urhk_dbSelectWithBind(sv_z)
                print(sv_q)

                IF(sv_q ==0) THEN
                #{
                        CUST.CPCM.value1 = BANCS.OUTPARAM.value1
                        print(CUST.CPCM.value1)
                        CUST.CPCM.value2 = BANCS.OUTPARAM.value2
                        print(CUST.CPCM.value2)
                #}
                ENDIF

	#---------------------------------------------
	#	Assigning values to detail page
	#---------------------------------------------

		lv_r = urhk_SetOrbOut("evtType| " 	+ CUST.CPCM.evtType)
		lv_r = urhk_SetOrbOut("evtId| " 	+ CUST.CPCM.evtId)
		lv_r = urhk_SetOrbOut("startDate| " 		+ CUST.CPCM.startDate)
		lv_r = urhk_SetOrbOut("endDate| " 	+ CUST.CPCM.endDate)
		lv_r = urhk_SetOrbOut("percent| " 	+ CUST.CPCM.percent)
		lv_r = urhk_SetOrbOut("value1| " 		+ CUST.CPCM.value1)
		lv_r = urhk_SetOrbOut("value2| "                + CUST.CPCM.value2)

		GOTO SUCCESS
	
ERROR:
		lv_x=urhk_SetOrbOut("Error_0|Error^" + CUST.CPCM.error  + "^" +CUST.CPCM.errorFocus)
		lv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
		
SUCCESS:
		lv_r = urhk_setOrbOut("SuccessOrFailure|Y")

ENDOFSCRIPT:

END-->
