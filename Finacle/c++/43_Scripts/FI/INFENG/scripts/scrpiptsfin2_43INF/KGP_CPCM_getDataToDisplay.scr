                lv_q = "modTableCount|SELECT COUNT(1) FROM CUSTOM.C_CPCM_MOD WHERE AGREEMENT_CODE = ?SVAR AND DEL_FLG != 'Y' AND EVENT_TYPE =?SVAR AND EVENT_ID =?SVAR AND BANK_ID = ?SVAR "
                PRINT(lv_q)

