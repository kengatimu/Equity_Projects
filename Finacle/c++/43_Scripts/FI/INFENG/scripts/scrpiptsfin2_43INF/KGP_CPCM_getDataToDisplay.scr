<--START
	TRACE ON
	
	#-----------------------------------------
	#  Create the required repository Classes
	#------------------------------------------
	
                IF(REPEXISTS("CUST") == 0) THEN
                #{
                        CREATEREP("CUST")
                #}
                ENDIF

                IF (CLASSEXISTS("CUST", "CPCM") == 0) THEN
                #{
                        CREATECLASS("CUST", "CPCM", 5)
                #}
                ENDIF

	
	#--------------------------------
	# Intialization of Local Fields
	#-------------------------------
	
                CUST.CPCM.startDate              = ""
                CUST.CPCM.endDate                = ""
                CUST.CPCM.percent                = ""
                CUST.CPCM.value1                  = ""
                CUST.CPCM.value2		= ""
		CUST.CPCM.customerType           = ""
                CUST.CPCM.error                  = ""
                CUST.CPCM.errorFocus             = "dummy"
                CUST.CPCM.Resultmsg              = ""
                CUST.CPCM.messageField           = ""
		CUST.CPCM.modTableCount          = "0"
                CUST.CPCM.mainTableCount         = "0"	
	
	#--------------------------------
	# Fetching Input Values
	#-------------------------------
	
		IF(FIELDEXISTS(BANCS.INPUT.funcCode)) THEN
		#{
			CUST.CPCM.funcCode = TRIM(TOUPPER(BANCS.INPUT.funcCode))
		#}
		ENDIF

		IF(FIELDEXISTS(BANCS.INPUT.acctId)) THEN
		#{
			CUST.CPCM.acctId = TRIM(TOUPPER(BANCS.INPUT.acctId))
		#}
		ENDIF

		IF(FIELDEXISTS(BANCS.INPUT.custId)) THEN
                #{
                        CUST.CPCM.custId = TRIM(TOUPPER(BANCS.INPUT.custId))
                #}
                ENDIF

                IF(FIELDEXISTS(BANCS.INPUT.empId)) THEN
                #{
                        CUST.CPCM.empId = TRIM(TOUPPER(BANCS.INPUT.empId))
                #}
                ENDIF

		IF(FIELDEXISTS(BANCS.INPUT.preferentialLevel)) THEN
                #{
                        CUST.CPCM.preferentialLevel = TRIM(TOUPPER(BANCS.INPUT.preferentialLevel))
                #}
                ENDIF
	
		IF(FIELDEXISTS(BANCS.INPUT.customerType)) THEN
                #{
                        CUST.CPCM.customerType = TRIM(TOUPPER(BANCS.INPUT.customerType))
                #}
                ENDIF

		IF(FIELDEXISTS(BANCS.INPUT.segmentationLevel)) THEN
                #{
                        CUST.CPCM.segmentationLevel = TRIM(TOUPPER(BANCS.INPUT.segmentationLevel))
                #}
                ENDIF

		IF(FIELDEXISTS(BANCS.INPUT.evtType)) THEN
                #{
                        CUST.CPCM.evtType = TRIM(TOUPPER(BANCS.INPUT.evtType))
                #}
                ENDIF

		IF(FIELDEXISTS(BANCS.INPUT.evtId)) THEN
                #{
                        CUST.CPCM.evtId = TRIM(TOUPPER(BANCS.INPUT.evtId))
                #}
                ENDIF

		CUST.CPCM.userId = BANCS.STDIN.userId 
		print(CUST.CPCM.userId)
	
		PRINT(CUST.CPCM.funcCode)
		PRINT(CUST.CPCM.acctId)
		PRINT(CUST.CPCM.custId)
		PRINT(CUST.CPCM.empId)
	#	PRINT(CUST.CPCM.preferentialLevel)
		PRINT(CUST.CPCM.customerType)
		PRINT(CUST.CPCM.segmentationLevel)
		PRINT(CUST.CPCM.evtType)
		PRINT(CUST.CPCM.evtId)
	
	#---------------------------------------------
	#	Checking mandatory fields
	#---------------------------------------------

	#---------------------------------------------
	#	Validating Account Number
	#---------------------------------------------


	#---------------------------------------------
	#	Fetching table counts
	#---------------------------------------------
	IF(CUST.CPCM.preferentialLevel == "A") THEN
	#{

		lv_q = "mainTableCount|SELECT COUNT(1) FROM CUSTOM.C_CPCM_DATA WHERE FORACID = ?SVAR AND DEL_FLG != 'Y' AND EVENT_TYPE = ?SVAR AND EVENT_ID = ?SVAR AND BANK_ID = ?SVAR "
		PRINT(lv_q)

		BANCS.INPARAM.BINDVARS = CUST.CPCM.acctId +"|"+ CUST.CPCM.evtType+"|"+CUST.CPCM.evtId+"|"+BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)

		lv_u = urhk_dbSelectWithBind(lv_q)
		PRINT(lv_u)

		IF(lv_u == "0") THEN
		#{
			CUST.CPCM.mainTableCount = BANCS.OUTPARAM.mainTableCount
			PRINT(CUST.CPCM.mainTableCount)
		#}
		ENDIF

		lv_q = "modTableCount|SELECT COUNT(1) FROM CUSTOM.C_CPCM_MOD WHERE FORACID = ?SVAR AND DEL_FLG != 'Y' AND EVENT_TYPE = ?SVAR AND EVENT_ID = ?SVAR AND BANK_ID = ?SVAR "
		PRINT(lv_q)

		BANCS.INPARAM.BINDVARS = CUST.CPCM.acctId +"|"+ CUST.CPCM.evtType+"|"+CUST.CPCM.evtId+"|"+BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)

		lv_u = urhk_dbSelectWithBind(lv_q)
		PRINT(lv_u)

		IF(lv_u == "0") THEN
		#{
			CUST.CPCM.modTableCount = BANCS.OUTPARAM.modTableCount
			PRINT(CUST.CPCM.modTableCount)
		#}
		ENDIF

	#-------------------------
	#	Add block
	#------------------------
	
		IF(CUST.CPCM.funcCode == "A")THEN
		#{
			IF(CDOUBLE(CUST.CPCM.mainTableCount) > 0) THEN	
			#{
				CUST.CPCM.error      = "Record already exists, Only can Modify"
				CUST.CPCM.errorFocus = "funcCode"
				GOTO ERROR
			#}
			ENDIF

			IF(CDOUBLE(CUST.CPCM.modTableCount) > 0) THEN	
			#{
				CUST.CPCM.error      = "Record already exists and pending verification."
				CUST.CPCM.errorFocus = "funcCode"
				GOTO ERROR
			#}
			ENDIF

		#}
		ENDIF

	#---------------------------------------------
        #       Verify Validation
        #---------------------------------------------
		
		IF(CUST.CPCM.funcCode=="V") THEN
		#{
			BANCS.INPARAM.BINDVARS = CUST.CPCM.acctId+"|"+ CUST.CPCM.evtType+"|"+CUST.CPCM.evtId+"|"+BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)

			sv_x="rcreuser,del_flg,entity_cre_flg|select rcre_user_id,del_flg,entity_cre_flg,foracid,EVENT_TYPE,EVENT_ID from CUSTOM.C_CPCM_MOD where FORACID= ?SVAR AND EVENT_TYPE =?SVAR AND EVENT_ID =?SVAR"
			sv_x = sv_x + " and del_flg='N' and entity_cre_flg='N' AND BANK_ID = ?SVAR and rownum<2 "
			print(sv_x)
			sv_d=urhk_dbselectWithBind(sv_x)
			PRINT(sv_d)

			IF(sv_d==0) THEN
			#{
				CUST.CPCM.rcreuser=BANCS.OUTPARAM.rcreuser
				CUST.CPCM.del_flg=BANCS.OUTPARAM.del_flg
				CUST.CPCM.entity_cre_flg=BANCS.OUTPARAM.entity_cre_flg

			#}
			ELSE
			#{
				 CUST.CPCM.error = "No records found"
				 CUST.CPCM.erroFocus = "funcCode"
				 GOTO ERROR
			#}
			ENDIF

			  IF(CUST.CPCM.rcreuser==CUST.CPCM.userId) THEN
			#{
				CUST.CPCM.error = "Same user cannot verify"
				CUST.CPCM.erroFocus = "funcCode"
				GOTO ERROR

			#}
			ENDIF

		#}
		ENDIF
		
	#---------------------------------------------
	#	Verify and Cancel block
	#---------------------------------------------
	
		IF((CUST.CPCM.funcCode == "V") OR (CUST.CPCM.funcCode == "X"))THEN
		#{
			lv_q = "startDate,endDate,percent,value1,value2 |"
			lv_q = lv_q + " SELECT TO_CHAR(START_DATE,'DD-MM-YYYY'),TO_CHAR(END_DATE,'DD-MM-YYYY'),PERCENT,PERCENT_VALUE,AMT_VALUE "
			lv_q = lv_q + " FROM CUSTOM.C_CPCM_MOD WHERE FORACID = ?SVAR AND EVENT_TYPE = ?SVAR AND EVENT_ID = ?SVAR AND ENTITY_CRE_FLG = 'N' AND DEL_FLG != 'Y' AND BANK_ID = ?SVAR"
			PRINT(lv_q)

			BANCS.INPARAM.BINDVARS = CUST.CPCM.acctId +"|"+ CUST.CPCM.evtType+"|"+CUST.CPCM.evtId+"|"+BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			
			lv_r = urhk_dbSelectWithBind(lv_q)
			PRINT(lv_r)
			
			IF(lv_r == "0")THEN
			#{
				CUST.CPCM.startDate	 	= BANCS.OUTPARAM.startDate
				CUST.CPCM.endDate		= BANCS.OUTPARAM.endDate
				CUST.CPCM.percent		= BANCS.OUTPARAM.percent
				CUST.CPCM.value1	 		= BANCS.OUTPARAM.value1
				CUST.CPCM.value2                        = BANCS.OUTPARAM.value2
				
				PRINT(CUST.CPCM.startDate)
				PRINT(CUST.CPCM.endDate)
				PRINT(CUST.CPCM.percent)
				PRINT(CUST.CPCM.value1)
				PRINT(CUST.CPCM.value2)
			#}
			ELSE
			#{
				IF(CDOUBLE(CUST.CPCM.mainTableCount) > 0) THEN	
				#{
					CUST.CPCM.error      = "There is nothing to verify or cancel."
					CUST.CPCM.errorFocus = "funcCode"
					GOTO ERROR
				#}
				ELSE
				#{
					CUST.CPCM.error      = "Record is not found for the given criteria."
					CUST.CPCM.errorFocus = "acctId"
					GOTO ERROR
				#}
				ENDIF
			#}
			ENDIF

		#}
		ENDIF

	#---------------------------------------------
	#	Inquire and Modify block
	#---------------------------------------------

		IF((CUST.CPCM.funcCode == "M") OR (CUST.CPCM.funcCode == "I"))THEN
		#{
			IF(CUST.CPCM.funcCode != "I") THEN
			#{
				IF(CDOUBLE(CUST.CPCM.modTableCount) > 0) THEN	
				#{
					CUST.CPCM.error      = "Record modified, Verification is pending"
					CUST.CPCM.errorFocus = "funcCode"
					GOTO ERROR
				#}
				ENDIF
			#}
			ENDIF
			lv_q =  " startDate,endDate,percent,value1,value2 |"
			lv_q = lv_q + " SELECT TO_CHAR(START_DATE,'DD-MM-YYYY'),TO_CHAR(END_DATE,'DD-MM-YYYY'),PERCENT,PERCENT_VALUE,AMT_VALUE "
			lv_q = lv_q + " FROM CUSTOM.C_CPCM_DATA WHERE FORACID = ?SVAR AND EVENT_TYPE = ?SVAR AND EVENT_ID = ?SVAR AND ENTITY_CRE_FLG = 'Y' AND DEL_FLG != 'Y' AND BANK_ID = ?SVAR"
			PRINT(lv_q)

			BANCS.INPARAM.BINDVARS = CUST.CPCM.acctId +"|"+ CUST.CPCM.evtType+"|"+CUST.CPCM.evtId+"|"+BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			
			lv_r = urhk_dbSelectWithBind(lv_q)
			PRINT(lv_r)
			
			IF(lv_r == "0")THEN
			#{
				CUST.CPCM.startDate	 	= BANCS.OUTPARAM.startDate
				CUST.CPCM.endDate		= BANCS.OUTPARAM.endDate
				CUST.CPCM.percent		= BANCS.OUTPARAM.percent
				CUST.CPCM.value1		 	= BANCS.OUTPARAM.value1
				CUST.CPCM.value2		= BANCS.OUTPARAM.value2
				PRINT(CUST.CPCM.startDate)
				PRINT(CUST.CPCM.endDate)
				PRINT(CUST.CPCM.percent)
				PRINT(CUST.CPCM.value1)
				PRINT(CUST.CPCM.value2)
			#}
			ELSE
			#{
				CUST.CPCM.error      = "Record does not exists."
				CUST.CPCM.errorFocus = "acctId"
				GOTO ERROR
			#}
			ENDIF

		#}
		ENDIF
	#}
	ENDIF

	#---------------------------------------------
        #       Fetching table counts
        #---------------------------------------------
        IF(CUST.CPCM.preferentialLevel == "C") THEN
        #{

                lv_q = "mainTableCount|SELECT COUNT(1) FROM CUSTOM.C_CPCM_DATA WHERE CUST_ID = ?SVAR AND DEL_FLG != 'Y' AND EVENT_TYPE = ?SVAR AND EVENT_ID = ?SVAR AND BANK_ID = ?SVAR "
                PRINT(lv_q)

                BANCS.INPARAM.BINDVARS = CUST.CPCM.custId +"|"+ CUST.CPCM.evtType+"|"+CUST.CPCM.evtId+"|"+BANCS.STDIN.contextBankId
                PRINT(BANCS.INPARAM.BINDVARS)

                lv_u = urhk_dbSelectWithBind(lv_q)
                PRINT(lv_u)

                IF(lv_u == "0") THEN
                #{
