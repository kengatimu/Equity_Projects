<--START
CHECKSUM="5a15a478c15d1945f0e56c2101b95cc905c226d0c7057b0c3b7ea07f73633aa3"
	TRACE ON
	
	####################################################################
	#section      :creating new repository if required
	#Description  :Checks for the existence of the repository STDWFS and
	#               creates a new one by that name if it does not exist
	#####################################################################
	
	IF (REPEXISTS("CUST") == 0 ) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	############################################################################
	#section      :creating new class if required
	#Desscription :checks for the existence of the class GLBDATA in the
	#repository
	#               create a new one if it does not exist
	##############################################################################
	
	
	IF (CLASSEXISTS("CUST","DATA") == 0) THEN
	#{
		CREATECLASS("CUST","DATA",5)
	#}
	ENDIF
	
	############################################
	#Assigns the values to the variables
	############################################
	
	sv_a = urhk_b2k_PrintRepos("BANCS")
	print(sv_a)
	sv_y=0
	
	IF( (FIELDEXISTS(("BANCS").("INPUT").("reqid"))== 0) ) THEN
	#{
		CUST.DATA.errMsg="Kindly Supply Req_id"
		sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
		GOTO End
		#}
	ELSE
		#{
		CUST.DATA.reqid=BANCS.INPUT.reqid
		print(CUST.DATA.reqid)
	#}
	ENDIF
	
	IF( (FIELDEXISTS(("BANCS").("INPUT").("processed"))== 0) ) THEN
	#{
		CUST.DATA.errMsg="Kindly Supply processed"
		sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
		GOTO End
		#}
	ELSE
		#{
		CUST.DATA.processed=BANCS.INPUT.processed
		print(CUST.DATA.processed)
	#}
	ENDIF
	
	IF( (FIELDEXISTS(("BANCS").("INPUT").("statuscode"))== 0) ) THEN
	#{
		CUST.DATA.errMsg="Kindly Supply Status"
		sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
		GOTO End
		#}
	ELSE
		#{
		CUST.DATA.status=BANCS.INPUT.statuscode
		print(CUST.DATA.status)
	#}
	ENDIF
	
	
	############################################
	# Fetching the value from table
	############################################
	
	sv_q = "update custom.MICALOANSS set status=?SVAR ,processed=?SVAR where req_id=?SVAR "
	PRINT(sv_q)
	BANCS.INPARAM.BINDVARS = CUST.DATA.status + "|" + CUST.DATA.processed + "|" + CUST.DATA.reqid
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_p= urhk_dbSQLWithBind(sv_q)
	print(sv_p)
	IF (sv_p==0) THEN
	#{
		sv_d = urhk_dbSqlWithBind("COMMIT")
		sv_e=urhk_SetOrbOut("StattusCode|1")
		#}
	ELSE
		#{
		sv_d = urhk_dbSqlWithBind("ROLLBACK")
		print(sv_d)
		CUST.DATA.errMsg="No Record"
		sv_e=urhk_SetOrbOut("StattusCode|2")
		sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
		
	#}
	ENDIF
	
	End:
		EXITSCRIPT
		TRACE OFF
END-->
