				EQT.COMM.vatAmt = EQT.COMM.vatAmt + "." + MID$(sv_p,sv_q,2)
				PRINT(EQT.COMM.vatAmt)
			#}
			ENDIF
		#}
		endif
	SKIP_ChrgCalculation:
		
		EQT.COMM.totChrg = CDOUBLE(EQT.COMM.chrgAmt) + CDOUBLE(EQT.COMM.vatAmt)
