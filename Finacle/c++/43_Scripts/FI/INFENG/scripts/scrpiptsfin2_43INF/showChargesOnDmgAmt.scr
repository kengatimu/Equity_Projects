			#}
			ENDIF
		#}
		ENDIF
		
		sv_t = sv_c * CDOUBLE(EQT.CSH.vatPrcnt) *(0.01)
		print(sv_t)
		EQT.COMM.vatAmt = sv_t
		BANCS.INPARAM.RoundOffAmt = CDOUBLE("0.01")
		BANCS.INPARAM.InputAmount= sv_t
		BANCS.INPARAM.RoundOffFlag="H"
		sv_r=urhk_B2k_RoundOff("")
