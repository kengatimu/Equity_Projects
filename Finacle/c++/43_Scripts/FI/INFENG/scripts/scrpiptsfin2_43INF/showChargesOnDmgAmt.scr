			PRINT(EQT.COMM.totChrg)
			EQT.COMM.totChrg = EQT.COMM.totChrg + "." + MID$(sv_p,sv_q,2)
			PRINT(EQT.COMM.totChrg)
		#}
		ENDIF
		
		#		EQT.CSH.Msg = "For the damaged amount, a charge of "+ EQT.CSH.dmgCrncy + " " + EQT.COMM.chrgAmt
		#		EQT.CSH.Msg = EQT.CSH.Msg + " and VAT of " + EQT.CSH.dmgCrncy + " " +  EQT.COMM.vatAmt +" making a total charge of "+ EQT.CSH.dmgCrncy + " " + EQT.COMM.totChrg + " will be applicable."
		#		EQT.CSH.Msg = EQT.CSH.Msg + " Do you want to continue? Click Ok to Continue with the charge and Cancel to terminate the transaction."
		EQT.CSH.Msg = EQT.COMM.chrgAmt +"-"+ EQT.COMM.vatAmt
		PRINT(EQT.CSH.Msg)
		
	ENDOFSCRIPT:
		
		IF(EQT.CSH.isDummy == "Y")THEN
		#{
			sv_u = urhk_SetOrbOut("errFlg|" + EQT.CSH.errorFlg)
			sv_u = urhk_SetOrbOut("message|" + EQT.CSH.Msg)
		#}
		ENDIF
		
		IF(EQT.CSH.isDummy == "N")THEN
		#{
			IF(TRIM(CUST.CIETXN.dmgRateCode)=="")THEN
			#{
				GOTO SKIP_DMG_AMT_CONV
			#}
			ENDIF
			
			## Converting the Amount
			sv_x = CUST.CIETXN.refCrncy
			sv_c = CUST.CIETXN.crAcctNumCcy
			sv_b = CUST.CIETXN.dmgRateCode
			sv_n = EQT.COMM.totChrg
			sv_m = EQT.CSH.dmgRate
			
			CALL("dmgAmt002.scr")
			
			EQT.CSH.rate = AMT.CONV.rate
			EQT.CSH.tranAmt = AMT.CONV.tranAmt
			EQT.CSH.tranAmtCcy = AMT.CONV.tranAmtCcy
			
			EQT.CSH.errorFlg = AMT.CONV.errorFlg
			EQT.CSH.Msg = AMT.CONV.Msg
			
			DELETECLASS("AMT","CONV")
			DELETEREP("AMT")
			
			## Converting Charge Amount
			
			sv_x = CUST.CIETXN.refCrncy
			sv_c = CUST.CIETXN.crAcctNumCcy
			sv_b = CUST.CIETXN.dmgRateCode
			sv_n = EQT.COMM.chrgAmt
			sv_m = EQT.CSH.dmgRate
			
			CALL("dmgAmt002.scr")
			
			CUST.CIETXN.chrgAmt = AMT.CONV.tranAmt
			EQT.CSH.errorFlg = AMT.CONV.errorFlg
			EQT.CSH.Msg = AMT.CONV.Msg
			
			DELETECLASS("AMT","CONV")
			DELETEREP("AMT")
			
			CUST.CIETXN.vatAmt = CDOUBLE(EQT.CSH.tranAmt) - CDOUBLE(CUST.CIETXN.chrgAmt)
			print(CUST.CIETXN.vatAmt)
			
		SKIP_DMG_AMT_CONV:
			EXITSCRIPT
		#}
		ENDIF
		
		DELETECLASS("EQT","CSH")
		sv_a = CLASSEXISTS("EQT", "COMM")
		IF (sv_a != 0 ) THEN
		#{
			DELETECLASS("EQT","COMM")
		#}
		ENDIF
		DELETEREP("EQT")
