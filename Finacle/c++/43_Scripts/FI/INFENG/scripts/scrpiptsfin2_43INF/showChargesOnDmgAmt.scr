			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF(TRIM(BANCS.OUTPARAM.parameterVal)=="")THEN
		#{
			EQT.CSH.errorFlg = "Y"
			EQT.CSH.Msg = "VAT Percent is not maintained in CPARAM for Parameter Id: "+BANCS.INPUT.parameterId  + " in Entity: "+ EQT.CSH.targetEntity
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF((EQT.CSH.dmgChrgAmt != "") AND (EQT.CSH.dmgVATAmt != ""))THEN
		#{
			EQT.COMM.chrgAmt = EQT.CSH.dmgChrgAmt
			EQT.COMM.vatAmt = EQT.CSH.dmgVATAmt
			GOTO SKIP_ChrgCalculation
		#}
		endif
		
		sv_c = CDOUBLE(EQT.CSH.dmgAmt)*CDOUBLE(EQT.CSH.chrgPrcnt)*(0.01)
		print(sv_c)
		EQT.COMM.chrgAmt = sv_c
		BANCS.INPARAM.RoundOffAmt = CDOUBLE("0.01")
		BANCS.INPARAM.InputAmount= sv_c
		BANCS.INPARAM.RoundOffFlag="H"
		sv_r=urhk_B2k_RoundOff("")
		print(sv_r)
		
		IF(sv_r==0)THEN
		#{
			sv_p = BANCS.OUTPARAM.OutputAmount
