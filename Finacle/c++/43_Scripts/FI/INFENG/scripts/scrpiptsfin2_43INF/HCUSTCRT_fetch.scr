<--START

TRACE ON

##------------------------------------
## Creation of Repository and Classes
##------------------------------------

IF (REPEXISTS("CUST") == 0) THEN
#{
	CREATEREP("CUST")
#}
ENDIF

IF (CLASSEXISTS("CUST","DATA") == 0) THEN
#{
	CREATECLASS("CUST","DATA",5)
#}
ENDIF

lv_a = urhk_B2k_PrintRepos("BANCS")
##------------------------------------
## Initialisation Of Variables
##------------------------------------

PRINT(CUST.DATA.Level)
PRINT(CUST.DATA.funcCode)
PRINT(CUST.DATA.cifId)
PRINT(CUST.DATA.acctNum)
PRINT(CUST.DATA.EmpId)


BANCS.INPARAM.BINDVARS =  CUST.DATA.Level
sv_s = ""
sv_s = sv_s + "START_DATE,END_DATE,EVENT_TYPE,EVENT_ID,CHRG_ACCT_NO|SELECT to_char(START_DATE),to_char(END_DATE),EVENT_TYPE,EVENT_ID,CHRG_ACCT_NO "
IF ((CUST.DATA.funcCode == "M") or (CUST.DATA.funcCode == "I")) THEN
#{
     sv_s = sv_s + "from C_HCUSTCRG_MAIN "
#}
ENDIF
IF ((CUST.DATA.funcCode == "V") or (CUST.DATA.funcCode == "X")) THEN
#{
     sv_s = sv_s + "from C_HCUSTCRG_MOD "
#}
ENDIF
sv_s = sv_s + " WHERE  CUST_LEVEL ='"+CUST.DATA.Level+"'"
sv_s = sv_s + " AND DEL_FLG !='Y' and EVENT_TYPE = '"+CUST.DATA.evtType+"' and EVENT_ID= '"+CUST.DATA.event_id+"' "

IF (CUST.DATA.Level == "C" ) THEN
#{
        sv_s = sv_s + "AND  CUST_ID= '"+CUST.DATA.cifId+"' "
#}
ENDIF

IF (CUST.DATA.Level == "A" ) THEN
#{
        sv_s = sv_s + "AND FORACID = '"+CUST.DATA.acctNum+"' "
#}
ENDIF

IF (CUST.DATA.Level == "AG" ) THEN
#{
        sv_s = sv_s + "AND AGREEMENT = '"+CUST.DATA.EmpId+"' "
#}
ENDIF

print(sv_s)
sv_d = urhk_dbSelectWithBind(sv_s)
print(sv_d)

IF (sv_d == 0) THEN
#{
	CUST.DATA.START_DATE=BANCS.OUTPARAM.START_DATE
        print(CUST.DATA.START_DATE)
        CUST.DATA.END_DATE  =BANCS.OUTPARAM.END_DATE
        print(CUST.DATA.END_DATE)
        CUST.DATA.EVENT_TYPE =BANCS.OUTPARAM.EVENT_TYPE
        print(CUST.DATA.EVENT_TYPE)
        CUST.DATA.EVENT_ID   =BANCS.OUTPARAM.EVENT_ID
        print(CUST.DATA.EVENT_ID)
        CUST.DATA.CHRG_ACCT_NO =BANCS.OUTPARAM.CHRG_ACCT_NO
	print(CUST.DATA.CHRG_ACCT_NO)
#}
ELSE
#{
        CUST.DATA.START_DATE = ""
        CUST.DATA.END_DATE =""
        CUST.DATA.EVENT_TYPE =""
        CUST.DATA.CHRG_ACCT_NO =""
#}
ENDIF

 sv_a = urhk_setOrbOut("chrgAcctId| "     + CUST.DATA.CHRG_ACCT_NO)
 sv_a = urhk_setOrbOut("startDate| "      + CUST.DATA.START_DATE)
 sv_a = urhk_setOrbOut("endDate| "        + CUST.DATA.END_DATE)
sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
GOTO ENDOFSCRIPT

ENDOFSCRIPT:
EXITSCRIPT
TRACE OFF
END-->
