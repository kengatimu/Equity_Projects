<--START
trace on
sv_r=urhk_B2K_PrintRepos("BANCS")
sv_r = REPEXISTS("CUST")
IF(sv_r == 0) THEN
#{
    CREATEREP("CUST")
#}
ENDIF
sv_r = CLASSEXISTS("CUST", "CHARGE")
IF (sv_r == 0) THEN
#{
    CREATECLASS("CUST", "CHARGE", 5)
#}
ENDIF

sv_s = "acid,B2K_ID,LIEN_AMT,LIEN_START_DATE|select(select foracid from "
sv_s = sv_s + " tbaadm.gam where acid=a.acid),a.B2K_ID,a.LIEN_AMT,a.LIEN_START_DATE "
sv_s = sv_s + " from tbaadm.alt a ,tbaadm.alh h "
sv_s = sv_s + " where a.B2K_ID = h.B2K_ID "
sv_s = sv_s + " and a.acid in (select acid from custom.altgam) "
sv_s = sv_s + " and a.B2K_TYPE='ULIEN' "
sv_s = sv_s + " and a.B2K_ID not in (select LIEN_B2K_ID from tbaadm.pclt)"
sv_s = sv_s + " and a.LIEN_AMT >0 "
sv_s = sv_s + " and a.entity_cre_flg = 'Y' "
sv_s = sv_s + " and a.del_flg = 'N' "
print(sv_s)
sv_a = urhk_dbCursorOpenWithBind(sv_s)
PRINT(sv_a)

IF (sv_a != 0) THEN
    GOTO END
ENDIF
sv_n = BANCS.OUTPARAM.DB_CURSOR_NUMBER
PRINT(sv_n)
sv_c = urhk_dbCursorFetch(sv_n)
PRINT(sv_c)
WHILE (sv_c == 0)
#{

        CUST.CHARGE.acid = BANCS.OUTPARAM.acid
        CUST.CHARGE.B2K_ID = BANCS.OUTPARAM.B2K_ID
        CUST.CHARGE.LIEN_AMT = BANCS.OUTPARAM.LIEN_AMT
        CUST.CHARGE.LIEN_START_DATE = BANCS.OUTPARAM.LIEN_START_DATE

        BANCS.INPARAM.acctNum=CUST.CHARGE.acid
        sv_m =CUST.CHARGE.LIEN_AMT
        BANCS.INPARAM.lienAmt=FORMAT$(-1*CDOUBLE(sv_m),"%.4f")
        BANCS.INPARAM.remarks="Partial Charge Recovery Lien Manual"
        BANCS.INPARAM.expiryDate=""
        BANCS.INPARAM.reasonCode="LIEN"
        BANCS.INPARAM.lienValueDate=CUST.CHARGE.LIEN_START_DATE
        BANCS.INPARAM.b2kId=CUST.CHARGE.B2K_ID
        BANCS.INPARAM.blockMode="B"
        BANCS.INPARAM.bodDate=CUST.CHARGE.LIEN_START_DATE
        sv_e = urhk_updateLien("")
        print(sv_e)
        print(BANCS.OUTPARAM.successOrFailure)

        sv_c = urhk_dbCursorFetch(sv_n)
        PRINT(sv_c)
#}
DO
sv_a = urhk_dbCursorClose(sv_n)
PRINT(sv_a)

END:
exitscript
trace off
end-->
