
<--START
TRACE ON

#--------------------------------------------------------------------------
#  Creation of EQSRV repository and GLBDATA class
#--------------------------------------------------------------------------

	sv_r = REPEXISTS("BANCS")
        IF (sv_r == 0) THEN
                CREATEREP("BANCS")
        endif

	sv_r = REPEXISTS("EQSRV")
        IF (sv_r == 0) THEN
                CREATEREP("EQSRV")
        endif

	sv_r = CLASSEXISTS("EQSRV", "GLBDATA")
	IF (sv_r == 0) THEN
		CREATECLASS("EQSRV", "GLBDATA", 5)
	ENDIF
#--------------------------------------------------------------------------
# Selecting accounts from DTD 
#--------------------------------------------------------------------------


sv_s = "tranId,trandate,tran_amt,foracid,acct_crncy_code,schm_code,acct_ownership |  select distinct(tran_id), TO_CHAR(tran_date, 'DD-MM-YYYY HH24:MI:SS' ), tran_amt,foracid,acct_crncy_code,schm_code,acct_ownership  from tbaadm.dtd,tbaadm.gam where dtd.acid=gam.acid  and dtd.bank_id=gam.bank_id and dtd.bank_id='43' and  tran_id in (select distinct ( tran_id ) from  tbaadm.dtd where   bank_id='43' and tran_amt > 1  and pstd_flg ='N' and del_flg ='N' and acid in (select acid from tbaadm.gam where bank_id='43' and  bacid!='PROXY'))  and PSTD_FLG ='N' and dtd.del_flg ='N' and gam.bank_id='43' and gam.acct_ownership!='O' and schm_type in ('SBA','CAA') "
print(sv_s)

sv_e = urhk_dbCursorOpenWithBind(sv_s)
print(sv_e)

if(sv_e==0) then
       sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
       print(sv_m)
        sv_q = urhk_dbCursorFetch(sv_m)
        print(sv_q)
        if(sv_q == 1) then
               sv_x = urhk_dbCursorClose(sv_m)
                print(sv_x)
                exitscript
        endif
        print(sv_q)
        while(sv_q==0)

			EQSRV.GLBDATA.tranId = BANCS.OUTPARAM.tranId
			print(EQSRV.GLBDATA.tranId)
			EQSRV.GLBDATA.trandate = BANCS.OUTPARAM.trandate
			print(EQSRV.GLBDATA.trandate)
			EQSRV.GLBDATA.tran_amt = BANCS.OUTPARAM.tran_amt
			print(EQSRV.GLBDATA.tran_amt)
			EQSRV.GLBDATA.foracid = BANCS.OUTPARAM.foracid
			print(EQSRV.GLBDATA.foracid)
			EQSRV.GLBDATA.acct_crncy_code = BANCS.OUTPARAM.acct_crncy_code
			print(EQSRV.GLBDATA.acct_crncy_code)
			EQSRV.GLBDATA.schm_code  = BANCS.OUTPARAM.schm_code
			print(EQSRV.GLBDATA.schm_code)
			EQSRV.GLBDATA.acct_ownership  = BANCS.OUTPARAM.acct_ownership
			print(EQSRV.GLBDATA.acct_ownership)
			###
			sv_h = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.foracid)
			print(sv_h)
			IF (sv_h==0) THEN
				EQSRV.GLBDATA.solidsh = BANCS.OUTPARAM.acctSolId
				print(EQSRV.GLBDATA.solidsh)
				EQSRV.GLBDATA.schmcodesh = BANCS.OUTPARAM.schmCode
				print(EQSRV.GLBDATA.schmcodesh)
				EQSRV.GLBDATA.schmType = BANCS.OUTPARAM.schmType
				print(EQSRV.GLBDATA.schmType)
				EQSRV.GLBDATA.EffAvailableAmttr = BANCS.OUTPARAM.EffAvailableAmt
				print(EQSRV.GLBDATA.EffAvailableAmttr)
				EQSRV.GLBDATA.lienAmt = BANCS.OUTPARAM.lienAmt
				print(EQSRV.GLBDATA.lienAmt)

				IF (CINT(EQSRV.GLBDATA.EffAvailableAmttr) < CINT(EQSRV.GLBDATA.tran_amt)) THEN 
					EQSRV.GLBDATA.finalstatus="E"
					print(EQSRV.GLBDATA.finalstatus)
					EQSRV.GLBDATA.EffAvailableAmttrdiff  =  CDOUBLE(EQSRV.GLBDATA.EffAvailableAmttr) - CDOUBLE(EQSRV.GLBDATA.lienAmt)
					print(EQSRV.GLBDATA.EffAvailableAmttrdiff)
				ENDIF
			###
				#################################
					EQSRV.GLBDATA.todGrant = "Y"
					PRINT(EQSRV.GLBDATA.foracid)
					EQSRV.GLBDATA.acctNum = EQSRV.GLBDATA.foracid
					PRINT(EQSRV.GLBDATA.acctNum)
					PRINT(BANCS.STDIN.BODDate)
					
					PRINT(BANCS.STDIN.mySolId)
					PRINT(EQSRV.GLBDATA.solidsh)
					BANCS.INPARAM.FlagType="A"
					BANCS.INPARAM.AcctId=EQSRV.GLBDATA.acctNum
					sv_u = urhk_ContextSOLUpdate("")
					IF(sv_u != 0) THEN
					#{
						sv_u = urhk_SRV_SetErr("Error: Unable to Change Context SOL for Acct:"+BANCS.INPUT.AcctNum)
					#}
					ENDIF
					PRINT(BANCS.STDIN.mySolId)
					sv_u = urhk_SetUrhkInp("sumInfo.acct.foracid|"+EQSRV.GLBDATA.acctNum)
					sv_u = urhk_SetUrhkInp("acctTODLLRec.todBasicDtl.acct.foracid|"+EQSRV.GLBDATA.acctNum)
					sv_u = urhk_SetUrhkInp("acctTODLLRec.todBasicDtl.grantDate|"+BANCS.STDIN.BODDate)
					sv_u = urhk_SetUrhkInp("acctTODLLRec.todBasicDtl.expiryDate|"+BANCS.STDIN.BODDate)
					PRINT(EQSRV.GLBDATA.tran_amt)
					EQSRV.GLBDATA.chrgAmt = EQSRV.GLBDATA.tran_amt
					PRINT(EQSRV.GLBDATA.chrgAmt)
					PRINT(EQSRV.GLBDATA.EffAvailableAmttr)
					EQSRV.GLBDATA.effAvlAmt = EQSRV.GLBDATA.EffAvailableAmttr
					PRINT(EQSRV.GLBDATA.effAvlAmt)
					PRINT(EQSRV.GLBDATA.lienAmt)
					IF (CINT(EQSRV.GLBDATA.effAvlAmt) < 0) THEN
					#{
						EQSRV.GLBDATA.diffAmt = CDOUBLE(EQSRV.GLBDATA.chrgAmt) + CDOUBLE(EQSRV.GLBDATA.lienAmt)
						##EQSRV.GLBDATA.diffAmt = CDOUBLE(EQSRV.GLBDATA.chrgAmt)
						PRINT(EQSRV.GLBDATA.diffAmt)
					#}
					ELSE
					#{
						EQSRV.GLBDATA.diffAmt = (CDOUBLE(EQSRV.GLBDATA.chrgAmt) - CDOUBLE(EQSRV.GLBDATA.effAvlAmt))
						PRINT(EQSRV.GLBDATA.diffAmt)
						sv_z= MID$(EQSRV.GLBDATA.diffAmt,0,4)
						print(sv_z)
						IF (sv_z=="0.00") THEN
							print(EQSRV.GLBDATA.diffAmt)
							GOTO ENDOFSCRIPT
						ENDIF
					#}
					ENDIF
					
					PRINT(BANCS.STDIN.mySolId)
					PRINT(EQSRV.GLBDATA.solidsh)
					BANCS.INPARAM.FlagType="A"
					BANCS.INPARAM.AcctId=EQSRV.GLBDATA.acctNum
					sv_u = urhk_ContextSOLUpdate("")
					IF(sv_u != 0) THEN
					#{
						sv_u = urhk_SRV_SetErr("Error: Unable to Change Context SOL for Acct:"+BANCS.INPUT.AcctNum)
					#}
					ENDIF
					PRINT(BANCS.STDIN.mySolId)
					sv_u = urhk_SetUrhkInp("acctTODLLRec.todBasicDtl.todAmtToBeGrntd|"+ EQSRV.GLBDATA.diffAmt +"|"+BANCS.STDIN.homeCrncyCode)
					sv_u = urhk_SetUrhkInp("acctTODLLRec.todBasicDtl.todLevIntFlg|N")
					sv_u = urhk_ExecSrv("SRV_FetchDfltTODForAdd|retain_all_output = Y")
					PRINT(sv_u)
					IF(sv_u == 0) THEN
					#{
						PRINT(BANCS.STDIN.mySolId)
						PRINT(EQSRV.GLBDATA.solidsh)
						BANCS.INPARAM.FlagType="A"
						BANCS.INPARAM.AcctId=EQSRV.GLBDATA.acctNum
						sv_u = urhk_ContextSOLUpdate("")
						IF(sv_u != 0) THEN
						#{
							sv_u = urhk_SRV_SetErr("Error: Unable to Change Context SOL for Acct:"+BANCS.INPUT.AcctNum)
						#}
						ENDIF
						PRINT(BANCS.STDIN.mySolId)
							BANCS.STDIN.userId ="CT40978"
							print(BANCS.STDIN.userId)
						
						sv_u = urhk_CopyOutToIn("")
						sv_u = urhk_SetUrhkInp("acctTODLLRec.todBasicDtl.permittedBy.userId|"+BANCS.STDIN.userId)
						sv_u = urhk_SetUrhkInp("acctTODLLRec.todBasicDtl.discreteAdvnType.code|SINGLE TRAN LIMIT")
						sv_u = urhk_SetUrhkInp("acctTODLLRec.todBasicDtl.discreteAdvnCatgr.code|CLEAN")
						sv_u = urhk_SetUrhkInp("acctTODLLRec.balance|"+ EQSRV.GLBDATA.diffAmt +"|"+BANCS.STDIN.homeCrncyCode)
						
						sv_u = urhk_ExecSrv("SRV_AddAcctTOD|same_user_verify = Y|retain_all_output = Y")
						PRINT(sv_u)
						IF(sv_u == 0) THEN
						#{
							sv_u = urhk_SetUrhkInp("criteria.acct.foracid|"+EQSRV.GLBDATA.acctNum)
							sv_u = urhk_ExecSrv("SRV_FetchAcctTODForVerify|same_user_verify = Y|retain_all_output = Y")
							PRINT(sv_u)
							IF(sv_u == 0) THEN
							#{
								sv_u = urhk_CopyOutToIn("")
								PRINT(BANCS.STDIN.mySolId)
								PRINT(EQSRV.GLBDATA.solidsh)
								BANCS.INPARAM.FlagType="A"
								BANCS.INPARAM.AcctId=EQSRV.GLBDATA.acctNum
								sv_u = urhk_ContextSOLUpdate("")
								IF(sv_u != 0) THEN
								#{
									sv_u = urhk_SRV_SetErr("Error: Unable to Change Context SOL for Acct:"+BANCS.INPUT.AcctNum)
								#}
								ENDIF
								PRINT(BANCS.STDIN.mySolId)
								
								sv_u = urhk_SetUrhkInp("criteria.acct.foracid|"+EQSRV.GLBDATA.acctNum)
								sv_u = urhk_ExecSrv("SRV_VerifyAcctTOD|same_user_verify = Y")
								PRINT(sv_u)
								IF (sv_u != 0) THEN
								#{
									# calling script to trap SRV execution error
									
									sv_r = REPEXISTS("CUST")
									IF (sv_r == 0) THEN
									#{
										CREATEREP("CUST")
									#}
									ENDIF
									
									sv_r = CLASSEXISTS("CUST", "INTERFACE")
									IF (sv_r == 0) THEN
									#{
										CREATECLASS("CUST", "INTERFACE", 5)
									#}
									ENDIF
									CUST.INTERFACE.srvErrFlg ="Y"
									CALL("Common_Interface_ErrorExitpol.scr")
									PRINT(CUST.INTERFACE.errorDesc)
									EQSRV.GLBDATA.errorMsg = CUST.INTERFACE.errorDesc
									EQSRV.GLBDATA.fieldName = "abc"
									EQSRV.GLBDATA.successFlg = "F"
									
									
									IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
									#{
										PRINT(BANCS.OUTPARAM.Error_num)
										sv_v = BANCS.OUTPARAM.Error_num
										PRINT(sv_v)
										#}
									ELSE
										#{
										sv_v = 0
									#}
									ENDIF
									
									IF (sv_v > 0) THEN
									#{
										sv_i = 1
										WHILE (sv_i <= sv_v)
										#{
											sv_f = FORMAT$(sv_i,"%d")
											sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
											PRINT(sv_e)
											sv_e = ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
											PRINT(sv_e)
											sv_e = ("BANCS").("OUTPARAM").("Tag_"+sv_f)
											PRINT(sv_e)
											sv_i = sv_i + 1
										#}
										DO
									sv_o = sv_o + 1
									print(sv_o)
									#}
									ENDIF
								#}
								ENDIF
							#}
							ENDIF
						#}
						ENDIF
					#}
					ENDIF
					
					IF (sv_u != 0) THEN
					#{
						IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
						#{
							PRINT(BANCS.OUTPARAM.Error_num)
							sv_v = BANCS.OUTPARAM.Error_num
							#}
						ELSE
							#{
							sv_v = 0
						#}
						ENDIF
						
						IF (sv_v > 0) THEN
						#{
							sv_i = 1
							WHILE (sv_i <= sv_v)
							#{
								sv_f = FORMAT$(sv_i,"%d")
								sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
								PRINT(sv_e)
								sv_e = ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
								PRINT(sv_e)
								sv_e = ("BANCS").("OUTPARAM").("Tag_"+sv_f)
								PRINT(sv_e)
								sv_i = sv_i + 1
							#}
							DO
						ENDIF
					#}
					ENDIF
				ENDOFSCRIPT:
				######################
			ENDIF
			####

			EQSRV.GLBDATA.tranId = EQSRV.GLBDATA.tranId
			print(EQSRV.GLBDATA.tranId)
			EQSRV.GLBDATA.trandate = EQSRV.GLBDATA.trandate
			print(EQSRV.GLBDATA.trandate)
			###
			sv_a = urhk_SetUrhkInp("tranHdr.tranIdentifier.tranId|" + EQSRV.GLBDATA.tranId)
			print(sv_a)
			sv_a = urhk_SetUrhkInp("tranHdr.tranIdentifier.tranDate|" + EQSRV.GLBDATA.trandate)
			print(sv_a)
			sv_r = urhk_ExecSrv("SRV_FetchTranDtlsForPost|retain_all_output = Y")
			print(sv_r)
			sv_a = urhk_CopyOutToIn("")
			print(sv_a)
			sv_a = urhk_ExecSrvNoCommit("SRV_PostTran|retain_all_output = Y|same_user_verify = Y")
			print(sv_a)

			IF (sv_a != 0) THEN
			#{
				IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
				#{
					print(BANCS.OUTPARAM.Error_num)
					sv_v = BANCS.OUTPARAM.Error_num
					print(sv_v)
				#}
				ELSE
				#{
					sv_v = 0
				#}
				ENDIF
				IF (sv_v > 0) then
				#{
					sv_u = system("echo 'Error for Tranid:"+ EQSRV.GLBDATA.tranId +" ' >>errortran.log")
					sv_i = 1
					WHILE (sv_i <= sv_v)
					#{
						sv_f = FORMAT$(sv_i,"%d")
						sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
						sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
						sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
						print(sv_e)
						sv_i = sv_i + 1
						print(sv_i)
						sv_u = system("echo '"+sv_e+"' >>errortran.log")
						print(sv_u)
					#}
					DO
				#}
				ENDIF
			ENDIF
			####
		sv_q = urhk_dbCursorFetch(sv_m)
                print(sv_q)
        do
ENDIF
Finish:
###

EXITSCRIPT
END-->
