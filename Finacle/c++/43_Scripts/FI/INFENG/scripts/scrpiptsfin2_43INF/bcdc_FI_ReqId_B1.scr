<--start
trace on
#################################################################
# Repository Creation
#################################################################
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF

	sv_r = CLASSEXISTS("CUST","DATA")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("CUST","DATA",5)
	#}
	ENDIF
	
	sv_a = "messagedatatime,tempSysDate|SELECT TO_CHAR(systimestamp,'yyyy-mm-ddhh:mi:ssxff'), TO_CHAR(sysdate, 'DD-MM-YYYY HH24:MI:SS') FROM dual"
	sv_b = urhk_dbSelectWithBind(sv_a)
	PRINT(sv_b)
	IF (sv_b == 0) THEN
	#{
		CUST.DATA.msgTime = BANCS.OUTPARAM.messagedatatime
		CUST.DATA.tempSysDate = BANCS.OUTPARAM.tempSysDate
		CUST.DATA.msgTime = MID$(CUST.DATA.msgTime,0,10)+"T"+MID$(CUST.DATA.msgTime,10,12)
	#}
	ELSE
	#{

		EXITSCRIPT
	#}
	ENDIF
	
	BANCS.INPARAM.Day = LEFT$(CUST.DATA.tempSysDate,2)
	PRINT(BANCS.INPARAM.Day)
	BANCS.INPARAM.Month = MID$(CUST.DATA.tempSysDate,3,2)
	PRINT(BANCS.INPARAM.Month)
	BANCS.INPARAM.Year = MID$(CUST.DATA.tempSysDate,8,2)
	PRINT(BANCS.INPARAM.Year)
	BANCS.INPARAM.Hour = MID$(CUST.DATA.tempSysDate,11,2)
	PRINT(BANCS.INPARAM.Hour)
	BANCS.INPARAM.Minute = MID$(CUST.DATA.tempSysDate,14,2)
	PRINT(BANCS.INPARAM.Minute)
	BANCS.INPARAM.Second = MID$(CUST.DATA.tempSysDate,17,2)
	PRINT(BANCS.INPARAM.Second)
	BANCS.INPARAM.SYSDATE = BANCS.INPARAM.Day + BANCS.INPARAM.Month + BANCS.INPARAM.Year + BANCS.INPARAM.Hour + BANCS.INPARAM.Minute + BANCS.INPARAM.Second
	PRINT(BANCS.INPARAM.SYSDATE)
	
	#sv_i = "99999"
         sv_i = "15190"
        #Getting the Message Id and storing into BANCS repository
	CUST.DATA.reqId = "Req_" + BANCS.INPARAM.SYSDATE + sv_i
	PRINT(CUST.DATA.reqId)
	
EXITSCRIPT
	TRACE OFF
	END-->
