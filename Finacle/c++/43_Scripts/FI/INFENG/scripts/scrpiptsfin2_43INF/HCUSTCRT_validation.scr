<--START

TRACE ON

##------------------------------------
## Creation of Repository and Classes
##------------------------------------

IF (REPEXISTS("CUST") == 0) THEN
#{
	CREATEREP("CUST")
#}
ENDIF

IF (CLASSEXISTS("CUST","DATA") == 0) THEN
#{
	CREATECLASS("CUST","DATA",5)
#}
ENDIF

lv_a = urhk_B2k_PrintRepos("BANCS")
##------------------------------------
## Initialisation Of Variables
##------------------------------------
CUST.DATA.Level = BANCS.OUTPARAM.Level
CUST.DATA.funcCode = BANCS.OUTPARAM.funcCode
CUST.DATA.cifId    = BANCS.OUTPARAM.cifId
CUST.DATA.acctNum  = BANCS.OUTPARAM.acctNum 
CUST.DATA.EmpId    = BANCS.OUTPARAM.EmpId
PRINT(CUST.DATA.Level)
PRINT(CUST.DATA.funcCode)
PRINT(CUST.DATA.cifId)
PRINT(CUST.DATA.acctNum)
PRINT(CUST.DATA.EmpId)


BANCS.INPARAM.BINDVARS =  CUST.DATA.Level
sv_s = ""
sv_s = sv_s + "count|SELECT count(1) "
IF ((CUST.DATA.funcCode == "M") or (CUST.DATA.funcCode == "I")) THEN
#{
     sv_s = sv_s + "from C_HCUSTCRG_MAIN "
#}
ENDIF
IF ((CUST.DATA.funcCode == "V") or (CUST.DATA.funcCode == "X")) THEN
#{
     sv_s = sv_s + "from C_HCUSTCRG_MOD "
#}
ENDIF
sv_s = sv_s + " WHERE  CUST_LEVEL ='"+CUST.DATA.Level+"'"
sv_s = sv_s + " AND DEL_FLG !='Y'"

IF (CUST.DATA.Level == "C" ) THEN
#{
        sv_s = sv_s + "AND  CUST_ID= '"+CUST.DATA.cifId+"' "
#}
ENDIF

IF (CUST.DATA.Level == "A" ) THEN
#{
        sv_s = sv_s + "AND FORACID = '"+CUST.DATA.foracid+"' "
#}
ENDIF

IF (CUST.DATA.Level == "AG" ) THEN
#{
        sv_s = sv_s + "AND AGREEMENT = "+CUST.DATA.Agreement+" "
#}
ENDIF

print(sv_s)
sv_d = urhk_dbSelectWithBind(sv_s)
print(sv_d)

IF (sv_d == 0) THEN
#{
	 CUST.DATA.count = BANC.OUTPARAM.count
#}
ELSE
#{
	CUST.DATA.count =""
#}
ENDIF
	
IF (CUST.DATA.count == "0")
#{
	IF (CUST.DATA.Level == "C" ) THEN
	#{
		urhk_setOrbOut("F1|Invalid Cif Id")
	#}
	ENDIF
	IF (CUST.DATA.Level == "A" ) THEN
	#{
		urhk_setOrbOut("F2|Invalid Account Number")
	#}
	ENDIF
	IF (CUST.DATA.Level == "AG" ) THEN
	#{
		urhk_setOrbOut("F3|Invalid Agreement")

	#}
	ENDIF

#}
ELSE
#{
	urhk_setOrbOut("S|valid")
#}
ENDIF
GOTO ENDOFSCRIPT

ENDOFSCRIPT:
EXITSCRIPT
TRACE OFF
END-->
