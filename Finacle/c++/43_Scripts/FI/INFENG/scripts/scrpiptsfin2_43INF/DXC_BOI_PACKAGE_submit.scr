<--START
TRACE ON

	#----------------------------------------------------------------------
	# Create the necessary repos and classes
	#----------------------------------------------------------------------

	IF (REPEXISTS("PACKAGE") == 0 ) THEN
	#{
                CREATEREP("PACKAGE")
        #}
       	ENDIF
        IF (CLASSEXISTS("PACKAGE","DATA") == 0) THEN
        #{
                CREATECLASS("PACKAGE","DATA",5)
        #}
        ENDIF
	
	#----------------------------------------------------------------------
	# Printing Bancs Repository
	#----------------------------------------------------------------------

	sv_b = urhk_B2k_PrintRepos("BANCS")
	print(sv_b)
	
	#----------------------------------------------------------------------
	# Variable Initialization
	#----------------------------------------------------------------------
	 
	PACKAGE.DATA.error           = ""
        PACKAGE.DATA.errorFocus      = "dummy"
	PACKAGE.DATA.errorMsg        = ""
	PACKAGE.DATA.Resultmsg       = ""
	PACKAGE.DATA.messageField    = ""
	PACKAGE.DATA.modTableCount   = "0"
	PACKAGE.DATA.mainTableCount  = "0"
	PACKAGE.DATA.recCnt = "1"
	#PACKAGE.DATA.recCnt = ""
	#----------------------------------------------------------------------
	#Fetching fields from front end
	#----------------------------------------------------------------------
	
	PACKAGE.DATA.packageCode = BANCS.INPUT.packageCode
	print(PACKAGE.DATA.packageCode)

	PACKAGE.DATA.funcCode = BANCS.INPUT.funcCode
	print(PACKAGE.DATA.funcCode)

	PACKAGE.DATA.packageDesc = BANCS.INPUT.packageDesc
	print(PACKAGE.DATA.packageDesc)
	
	PACKAGE.DATA.product1 = BANCS.INPUT.product1
	print(PACKAGE.DATA.product1)
	
	PACKAGE.DATA.product2 = BANCS.INPUT.product2
	print(PACKAGE.DATA.product2)

	PACKAGE.DATA.product3 = BANCS.INPUT.product3
	print(PACKAGE.DATA.product3)

	PACKAGE.DATA.product4 = BANCS.INPUT.product4
	print(PACKAGE.DATA.product4)
		
	PACKAGE.DATA.product5 = BANCS.INPUT.product5
	print(PACKAGE.DATA.product5)

	PACKAGE.DATA.product6 = BANCS.INPUT.product6
        print(PACKAGE.DATA.product6)

        PACKAGE.DATA.product7 = BANCS.INPUT.product7
        print(PACKAGE.DATA.product7)

        PACKAGE.DATA.product8 = BANCS.INPUT.product8
        print(PACKAGE.DATA.product8)

        PACKAGE.DATA.product9 = BANCS.INPUT.product9
        print(PACKAGE.DATA.product9)

        PACKAGE.DATA.product10 = BANCS.INPUT.product10
        print(PACKAGE.DATA.product10)

	PACKAGE.DATA.schmCode1 = BANCS.INPUT.schmCode1
        print(PACKAGE.DATA.schmCode1)

	PACKAGE.DATA.schmCode2 = BANCS.INPUT.schmCode2
        print(PACKAGE.DATA.schmCode2)

	PACKAGE.DATA.schmCode3 = BANCS.INPUT.schmCode3
        print(PACKAGE.DATA.schmCode3)

	PACKAGE.DATA.schmCode4 = BANCS.INPUT.schmCode4
        print(PACKAGE.DATA.schmCode4)

	PACKAGE.DATA.schmCode5 = BANCS.INPUT.schmCode5
        print(PACKAGE.DATA.schmCode5)

	PACKAGE.DATA.schmCode6 = BANCS.INPUT.schmCode6
        print(PACKAGE.DATA.schmCode6)

	PACKAGE.DATA.schmCode7 = BANCS.INPUT.schmCode7
        print(PACKAGE.DATA.schmCode7)

	PACKAGE.DATA.schmCode8 = BANCS.INPUT.schmCode8
        print(PACKAGE.DATA.schmCode8)
	
	PACKAGE.DATA.schmCode9 = BANCS.INPUT.schmCode9
        print(PACKAGE.DATA.schmCode9)
	
	PACKAGE.DATA.schmCode10 = BANCS.INPUT.schmCode10
        print(PACKAGE.DATA.schmCode10)

	PACKAGE.DATA.packagePrising = BANCS.INPUT.packagePrising
        print(PACKAGE.DATA.packagePrising)

	PACKAGE.DATA.value1 = BANCS.INPUT.value1
        print(PACKAGE.DATA.value1)

	PACKAGE.DATA.value2 = BANCS.INPUT.value2
        print(PACKAGE.DATA.value2)	
	
	#---------------------------------------------
        #       Amount formating
        #---------------------------------------------	
		
		BANCS.INPARAM.BINDVARS = PACKAGE.DATA.value1 +"|"+ PACKAGE.DATA.value2
		print(BANCS.INPARAM.BINDVARS)

		sv_z = "value1,value2|SELECT REPLACE(REPLACE(?SVAR,'.',''),',','.'),REPLACE(REPLACE(?SVAR,'.',''),',','.') FROM DUAL"
		print(sv_z)

		sv_q = urhk_dbSelectWithBind(sv_z)
		print(sv_q)

		IF(sv_q ==0) THEN
		#{
			PACKAGE.DATA.value1 = BANCS.OUTPARAM.value1
			print(PACKAGE.DATA.value1)
			PACKAGE.DATA.value2 = BANCS.OUTPARAM.value2
			print(PACKAGE.DATA.value2)
		#}
		ENDIF

	#---------------------------------------------
        #       BASIC VALIDATION
        #---------------------------------------------	

                PACKAGE.DATA.recCnt = "1"
                WHILE(CINT(PACKAGE.DATA.recCnt) <= 10)
                #{
                        IF((("PACKAGE").("DATA").("product"+ PACKAGE.DATA.recCnt) == "SBA") or (("PACKAGE").("DATA").("product"+ PACKAGE.DATA.recCnt) == "LAA") or (("PACKAGE").("DATA").("product"+ PACKAGE.DATA.recCnt) == "CAA") or (("PACKAGE").("DATA").("product"+ PACKAGE.DATA.recCnt) == "ODA") or (("PACKAGE").("DATA").("product"+ PACKAGE.DATA.recCnt) == "TDA")) THEN
                        #{
                                BANCS.INPARAM.BINDVARS = ("PACKAGE").("DATA").("schmCode"+ PACKAGE.DATA.recCnt) +"|"+("PACKAGE").("DATA").("product"+ PACKAGE.DATA.recCnt)+"|"+BANCS.STDIN.contextBankId
                                print(BANCS.INPARAM.BINDVARS)

                                sv_z = "regCnt|SELECT COUNT(1) FROM TBAADM.GSP WHERE SCHM_CODE =?SVAR AND SCHM_TYPE = ?SVAR AND BANK_ID = ?SVAR"
                                print(sv_z)

                                sv_q = urhk_dbSelectWithBind(sv_z)
                                print(sv_q)

                                IF(sv_q ==0) THEN
                                #{
                                        PACKAGE.DATA.regCnt = BANCS.OUTPARAM.regCnt
                                        print(PACKAGE.DATA.regCnt)
                                #}
                                ELSE
                                #{
                                        PACKAGE.DATA.regCnt = ""
                                #}
                                ENDIF

                                IF(PACKAGE.DATA.regCnt == "0") THEN
                                #{
                                        PACKAGE.DATA.error = "Invalid Product Subtype for the product "+ PACKAGE.DATA.recCnt
                                        PACKAGE.DATA.errorFocus = "schmCode"+ PACKAGE.DATA.recCnt
                                        GOTO ERROR
                                #}
                                ENDIF
                        #}
                        ENDIF

                        PACKAGE.DATA.recCnt = CINT(PACKAGE.DATA.recCnt) + 1
                        PRINT(PACKAGE.DATA.recCnt)
		#}
                DO

		PACKAGE.DATA.recCnt = "1"	
		WHILE(CINT(PACKAGE.DATA.recCnt) <= 10) 
		#{	
			IF(("PACKAGE").("DATA").("product"+ PACKAGE.DATA.recCnt) == "B") THEN
			#{
				BANCS.INPARAM.BINDVARS = ("PACKAGE").("DATA").("schmCode"+ PACKAGE.DATA.recCnt) +"|"+BANCS.STDIN.contextBankId
				print(BANCS.INPARAM.BINDVARS)

				sv_z = "regCnt|SELECT COUNT(1) FROM TBAADM.FBPT WHERE BILL_PARAM_TYPE = ?SVAR AND BANK_ID = ?SVAR AND ENTITY_CRE_FLG = 'Y' AND DEL_FLG = 'N'"
				print(sv_z)

				sv_q = urhk_dbSelectWithBind(sv_z)
				print(sv_q)
				
				IF(sv_q ==0) THEN
				#{
					PACKAGE.DATA.regCnt = BANCS.OUTPARAM.regCnt
					print(PACKAGE.DATA.regCnt)
				#}
				ELSE
				#{
					PACKAGE.DATA.regCnt = ""
				#}
				ENDIF

				IF(PACKAGE.DATA.regCnt == "0") THEN
				#{
					PACKAGE.DATA.error = "Invalid Product Subtype for the product "+ PACKAGE.DATA.recCnt
					PACKAGE.DATA.errorFocus = "schmCode"+ PACKAGE.DATA.recCnt
					GOTO ERROR
				#}
				ENDIF
			#}
			ENDIF

			PACKAGE.DATA.recCnt = CINT(PACKAGE.DATA.recCnt) + 1
			PRINT(PACKAGE.DATA.recCnt)
		#}
		DO

		PACKAGE.DATA.recCnt = "1"
                WHILE(CINT(PACKAGE.DATA.recCnt) <= 10)
                #{
                        IF(("PACKAGE").("DATA").("product"+ PACKAGE.DATA.recCnt) == "D") THEN
                        #{
                                BANCS.INPARAM.BINDVARS = ("PACKAGE").("DATA").("schmCode"+ PACKAGE.DATA.recCnt) +"|"+BANCS.STDIN.contextBankId
                                print(BANCS.INPARAM.BINDVARS)

                                sv_z = "regCnt|SELECT COUNT(1) FROM TBAADM.DCRM WHERE REG_TYPE = ?SVAR AND BANK_ID = ?SVAR AND ENTITY_CRE_FLG = 'Y' AND DEL_FLG = 'N'"
                                print(sv_z)

                                sv_q = urhk_dbSelectWithBind(sv_z)
                                print(sv_q)

                                IF(sv_q ==0) THEN
                                #{
                                        PACKAGE.DATA.regCnt = BANCS.OUTPARAM.regCnt
                                        print(PACKAGE.DATA.regCnt)
                                #}
                                ELSE
                                #{
                                        PACKAGE.DATA.regCnt = ""
                                #}
                                ENDIF

                                IF(PACKAGE.DATA.regCnt == "0") THEN
                                #{
                                        PACKAGE.DATA.error = "Invalid Product Subtype for the product"+ PACKAGE.DATA.recCnt
                                        PACKAGE.DATA.errorFocus = "schmCode"+ PACKAGE.DATA.recCnt
                                        GOTO ERROR
                                #}
                                ENDIF
                        #}
                        ENDIF

                        PACKAGE.DATA.recCnt = CINT(PACKAGE.DATA.recCnt) + 1
                        PRINT(PACKAGE.DATA.recCnt)
                #}
                DO
		
		PACKAGE.DATA.recCnt = "1"
                WHILE(CINT(PACKAGE.DATA.recCnt) <= 10)
                #{
                        IF(("PACKAGE").("DATA").("product"+ PACKAGE.DATA.recCnt) == "G") THEN
                        #{
                                BANCS.INPARAM.BINDVARS = ("PACKAGE").("DATA").("schmCode"+ PACKAGE.DATA.recCnt) +"|"+BANCS.STDIN.contextBankId
                                print(BANCS.INPARAM.BINDVARS)

                                sv_z = "regCnt|SELECT COUNT(1) FROM TBAADM.BGP WHERE BG_TYPE = ?SVAR AND BANK_ID = ?SVAR AND ENTITY_CRE_FLG = 'Y' AND DEL_FLG = 'N'"
                                print(sv_z)

                                sv_q = urhk_dbSelectWithBind(sv_z)
                                print(sv_q)

                                IF(sv_q ==0) THEN
                                #{
                                        PACKAGE.DATA.regCnt = BANCS.OUTPARAM.regCnt
                                        print(PACKAGE.DATA.regCnt)
                                #}
                                ELSE
                                #{
                                        PACKAGE.DATA.regCnt = ""
                                #}
                                ENDIF

                                IF(PACKAGE.DATA.regCnt == "0") THEN
                                #{
                                        PACKAGE.DATA.error = "Invalid Product Subtype for the product"+ PACKAGE.DATA.recCnt
                                        PACKAGE.DATA.errorFocus = "schmCode"+ PACKAGE.DATA.recCnt
                                        GOTO ERROR
                                #}
                                ENDIF
                        #}
                        ENDIF

                        PACKAGE.DATA.recCnt = CINT(PACKAGE.DATA.recCnt) + 1
                        PRINT(PACKAGE.DATA.recCnt)
                #}
                DO

		PACKAGE.DATA.recCnt = "1"
                WHILE(CINT(PACKAGE.DATA.recCnt) <= 10)
                #{
                        IF(("PACKAGE").("DATA").("product"+ PACKAGE.DATA.recCnt) == "R") THEN
                        #{
                                BANCS.INPARAM.BINDVARS = ("PACKAGE").("DATA").("schmCode"+ PACKAGE.DATA.recCnt) +"|"+BANCS.STDIN.contextBankId
                                print(BANCS.INPARAM.BINDVARS)

                                sv_z = "regCnt|SELECT COUNT(1) FROM TBAADM.CPM WHERE COLL_CODE = ?SVAR AND BANK_ID = ?SVAR AND ENTITY_CRE_FLG = 'Y' AND DEL_FLG = 'N'"
                                print(sv_z)

                                sv_q = urhk_dbSelectWithBind(sv_z)
                                print(sv_q)

                                IF(sv_q ==0) THEN
                                #{
                                        PACKAGE.DATA.regCnt = BANCS.OUTPARAM.regCnt
                                        print(PACKAGE.DATA.regCnt)
                                #}
                                ELSE
                                #{
                                        PACKAGE.DATA.regCnt = ""
                                #}
                                ENDIF

                                IF(PACKAGE.DATA.regCnt == "0") THEN
                                #{
                                        PACKAGE.DATA.error = "Invalid Product Subtype for the product"+ PACKAGE.DATA.recCnt
                                        PACKAGE.DATA.errorFocus = "schmCode"+ PACKAGE.DATA.recCnt
                                        GOTO ERROR
                                #}
                                ENDIF
                        #}
                        ENDIF

                        PACKAGE.DATA.recCnt = CINT(PACKAGE.DATA.recCnt) + 1
                        PRINT(PACKAGE.DATA.recCnt)
                #}
                DO
	#---------------------------------------------
	#	Fetching table counts
	#---------------------------------------------

	sv_q = "mainTableCount|SELECT COUNT(1) FROM CUSTOM.C_PACKAGE_DATA WHERE PACKAGE_CODE = ?SVAR AND DEL_FLG != 'Y' AND BANK_ID = ?SVAR"
	PRINT(sv_q)

	BANCS.INPARAM.BINDVARS = PACKAGE.DATA.packageCode +"|"+ BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)

	sv_u = urhk_dbSelectWithBind(sv_q)
	PRINT(sv_u)

	IF(sv_u == "0") THEN
	#{
		PACKAGE.DATA.mainTableCount = BANCS.OUTPARAM.mainTableCount
		PRINT(PACKAGE.DATA.mainTableCount)
	#}
	ENDIF

	sv_q = "modTableCount|SELECT COUNT(1) FROM CUSTOM.C_PACKAGE_MOD WHERE PACKAGE_CODE = ?SVAR AND DEL_FLG != 'Y' AND BANK_ID = ?SVAR"
	PRINT(sv_q)

	BANCS.INPARAM.BINDVARS = PACKAGE.DATA.packageCode +"|"+ BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)

	sv_u = urhk_dbSelectWithBind(sv_q)
	PRINT(sv_u)

	IF(sv_u == "0") THEN
	#{
		PACKAGE.DATA.modTableCount = BANCS.OUTPARAM.modTableCount
		PRINT(PACKAGE.DATA.modTableCount)
	#}
	ENDIF	
	
	#----------------------------------------------------------------
	# ADD Function
	#----------------------------------------------------------------

	IF (PACKAGE.DATA.funcCode == "A") THEN
	#{	
	        
		IF(CDOUBLE(PACKAGE.DATA.mainTableCount) > 0) THEN	
		#{
			PACKAGE.DATA.error      = "Record already exists."
			PACKAGE.DATA.errorFocus = "dummy"
			GOTO ERROR
		#}
		ENDIF

		IF(CDOUBLE(PACKAGE.DATA.modTableCount) > 0) THEN	
		#{
			PACKAGE.DATA.error      = "Record already exists and pending verification."
			PACKAGE.DATA.errorFocus = "dummy"
			GOTO ERROR
		#}
		ENDIF
	
		BANCS.INPARAM.BINDVARS = PACKAGE.DATA.packageDesc+ "|" +PACKAGE.DATA.product1+ "|" +PACKAGE.DATA.product2
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+ "|" +PACKAGE.DATA.product3+ "|" +PACKAGE.DATA.product4
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+ "|" +PACKAGE.DATA.product5+ "|" +PACKAGE.DATA.product6+ "|" +PACKAGE.DATA.product7
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+ "|" +PACKAGE.DATA.product8+ "|" +PACKAGE.DATA.product9+ "|" +PACKAGE.DATA.product10
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+ "|" +PACKAGE.DATA.schmCode1+ "|" +PACKAGE.DATA.schmCode2+ "|" +PACKAGE.DATA.schmCode3
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+ "|" +PACKAGE.DATA.schmCode4+ "|" +PACKAGE.DATA.schmCode5+ "|" +PACKAGE.DATA.schmCode6
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+ "|" +PACKAGE.DATA.schmCode7+ "|" +PACKAGE.DATA.schmCode8+ "|" +PACKAGE.DATA.schmCode9
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+ "|" +PACKAGE.DATA.schmCode10+ "|" +PACKAGE.DATA.packagePrising	
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+ "|" +PACKAGE.DATA.value1+ "|" +PACKAGE.DATA.value2+ "|" +'N'+ "|" +'N'
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+ "|" +BANCS.STDIN.userId+ "|" +BANCS.STDIN.userId+ "|" +PACKAGE.DATA.packageCode
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+ "|" +BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)

		sv_s = ""
		sv_s = sv_s + "INSERT INTO CUSTOM.C_PACKAGE_MOD (PACKAGE_DESC,PRODUCT_1,PRODUCT_2,PRODUCT_3,PRODUCT_4,PRODUCT_5,PRODUCT_6,PRODUCT_7,PRODUCT_8, "
		sv_s = sv_s + " PRODUCT_9,PRODUCT_10,SCHMCODE_1,SCHMCODE_2,SCHMCODE_3,SCHMCODE_4,SCHMCODE_5,SCHMCODE_6,SCHMCODE_7,SCHMCODE_8, "
		sv_s = sv_s + " SCHMCODE_9,SCHMCODE_10,PACKAGE_PRISING,AMT_VALUE,PERCENT_VALUE,ENTITY_CRE_FLG, DEL_FLG, "
		sv_s = sv_s + " RCRE_USER_ID, RCRE_TIME, LCHG_USER_ID, LCHG_TIME,"
		sv_s = sv_s + " PACKAGE_CODE,BANK_ID) "
		sv_s = sv_s + " VALUES (?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,"
		sv_s = sv_s + " ?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,to_date(sysdate,'dd-mm-yyyy'),?SVAR,to_date(sysdate,'dd-mm-yyyy'),?SVAR,?SVAR) "
		PRINT(sv_s)

		sv_d = urhk_dbSqlWithBind(sv_s)
		PRINT(sv_d)
	
		IF(sv_d == 0) THEN
                #{
                        PACKAGE.DATA.messageField = "Record Added Successfully for Package Code " + PACKAGE.DATA.packageCode + ",Please Verify"
                        PACKAGE.DATA.SuccessOrFailure="Y"
                        GOTO sentMessage
                #}
                ELSE
                #{
                        PACKAGE.DATA.error 	= "Reccord addition failed"
                        PACKAGE.DATA.errorFocus	= "dummy"
                        GOTO ERROR
                #}
                ENDIF		
	#}
	ENDIF			

	#----------------------------------------------------------------
	# Modify Function
	#----------------------------------------------------------------
	
	IF (PACKAGE.DATA.funcCode == "M") THEN
	#{
		IF(CDOUBLE(PACKAGE.DATA.mainTableCount) == 0) THEN	
		#{
			PACKAGE.DATA.error      = "Record does not exists."
			PACKAGE.DATA.errorFocus = "dummy"
			GOTO ERROR
		#}
		ENDIF

		IF(CDOUBLE(PACKAGE.DATA.modTableCount) > 0) THEN	
		#{
			PACKAGE.DATA.error      = "Verification is pending"
			PACKAGE.DATA.errorFocus = "dummy"
			GOTO ERROR
		#}
		ENDIF

		BANCS.INPARAM.BINDVARS = PACKAGE.DATA.packageDesc+ "|" +PACKAGE.DATA.product1+ "|" +PACKAGE.DATA.product2
                BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+ "|" +PACKAGE.DATA.product3+ "|" +PACKAGE.DATA.product4
                BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+ "|" +PACKAGE.DATA.product5+ "|" +PACKAGE.DATA.product6+ "|" +PACKAGE.DATA.product7
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+ "|" +PACKAGE.DATA.product8+ "|" +PACKAGE.DATA.product9+ "|" +PACKAGE.DATA.product10	
                BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+ "|" +PACKAGE.DATA.schmCode1+ "|" +PACKAGE.DATA.schmCode2+ "|" +PACKAGE.DATA.schmCode3
                BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+ "|" +PACKAGE.DATA.schmCode4+ "|" +PACKAGE.DATA.schmCode5+ "|" +PACKAGE.DATA.schmCode6
                BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+ "|" +PACKAGE.DATA.schmCode7+ "|" +PACKAGE.DATA.schmCode8+ "|" +PACKAGE.DATA.schmCode9
                BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+ "|" +PACKAGE.DATA.schmCode10+ "|" +PACKAGE.DATA.packagePrising
                BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+ "|" +PACKAGE.DATA.value1+ "|" +PACKAGE.DATA.value2+ "|" +'N'+ "|" +'N'
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+ "|" +BANCS.STDIN.userId+ "|" +BANCS.STDIN.userId+ "|" +PACKAGE.DATA.packageCode
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS+ "|" +BANCS.STDIN.contextBankId
                PRINT(BANCS.INPARAM.BINDVARS)

                sv_s = ""
                sv_s = sv_s + "INSERT INTO CUSTOM.C_PACKAGE_MOD (PACKAGE_DESC,PRODUCT_1,PRODUCT_2,PRODUCT_3,PRODUCT_4,PRODUCT_5,PRODUCT_6,PRODUCT_7,PRODUCT_8, "
                sv_s = sv_s + " PRODUCT_9,PRODUCT_10,SCHMCODE_1,SCHMCODE_2,SCHMCODE_3,SCHMCODE_4,SCHMCODE_5,SCHMCODE_6,SCHMCODE_7,SCHMCODE_8, "
		sv_s = sv_s + " SCHMCODE_9,SCHMCODE_10,PACKAGE_PRISING,AMT_VALUE,PERCENT_VALUE,ENTITY_CRE_FLG, DEL_FLG, RCRE_USER_ID, "
		sv_s = sv_s + " RCRE_TIME, LCHG_USER_ID, LCHG_TIME, PACKAGE_CODE,BANK_ID) "
                sv_s = sv_s + " VALUES (?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,"
		sv_s = sv_s + " ?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,"
                sv_s = sv_s + " ?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR, "
		sv_s = sv_s + " to_date(sysdate,'dd-mm-yyyy'),?SVAR,to_date(sysdate,'dd-mm-yyyy'),?SVAR,?SVAR) "
                PRINT(sv_s)

		sv_d = urhk_dbSqlWithBind(sv_s)
		PRINT(sv_d)

		IF(sv_d == 0) THEN
	        #{
        	        PACKAGE.DATA.messageField = "Record modified Successfully for Package Code " + PACKAGE.DATA.packageCode 
                	PRINT(PACKAGE.DATA.messageField)
                        GOTO sentMessage
               	#}
                ELSE
                #{
                        PACKAGE.DATA.error      = "Reccord Modify failed"
                        PACKAGE.DATA.errorFocus = "dummy"
                        GOTO ERROR
                #}
                ENDIF

	#}
	ENDIF
		
	#----------------------------------------------------------------
	#  Verify Function
	#----------------------------------------------------------------

	IF (PACKAGE.DATA.funcCode == "V") THEN
        #{
		IF(CDOUBLE(PACKAGE.DATA.modTableCount) == 0) THEN	
		#{
			PACKAGE.DATA.error      = "There is nothing to verify or cancel."
			PACKAGE.DATA.errorFocus = "dummy"
			GOTO ERROR
		#}
		ENDIF

		sv_s = " DELETE FROM CUSTOM.C_PACKAGE_DATA WHERE PACKAGE_CODE = ?SVAR AND BANK_ID = ?SVAR"
		PRINT(sv_s)

		BANCS.INPARAM.BINDVARS = PACKAGE.DATA.packageCode+"|"+ BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)

		sv_r = urhk_dbSQLWithBind(sv_s)
		PRINT(sv_r)

		
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId +"|"+ PACKAGE.DATA.packageCode+"|"+ BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)

		sv_s = ""
		sv_s = sv_s + " INSERT INTO CUSTOM.C_PACKAGE_DATA (PACKAGE_DESC,PRODUCT_1,PRODUCT_2,PRODUCT_3,PRODUCT_4,PRODUCT_5,PRODUCT_6,PRODUCT_7,"
		sv_s = sv_s + " PRODUCT_8,PRODUCT_9,PRODUCT_10,SCHMCODE_1,SCHMCODE_2,SCHMCODE_3,SCHMCODE_4,SCHMCODE_5,SCHMCODE_6,SCHMCODE_7, "
		sv_s = sv_s + " SCHMCODE_8,SCHMCODE_9,SCHMCODE_10,PACKAGE_PRISING,AMT_VALUE,PERCENT_VALUE,"	
		sv_s = sv_s + " ENTITY_CRE_FLG, DEL_FLG, RCRE_USER_ID, RCRE_TIME, LCHG_USER_ID, LCHG_TIME,PACKAGE_CODE,BANK_ID)"
		sv_s = sv_s + " SELECT PACKAGE_DESC,PRODUCT_1,PRODUCT_2,PRODUCT_3,PRODUCT_4,PRODUCT_5,PRODUCT_6, "
		sv_s = sv_s + " PRODUCT_7,PRODUCT_8,PRODUCT_9,PRODUCT_10,SCHMCODE_1,SCHMCODE_2,SCHMCODE_3,SCHMCODE_4,SCHMCODE_5,SCHMCODE_6,SCHMCODE_7, "
		sv_s = sv_s + " SCHMCODE_8,SCHMCODE_9,SCHMCODE_10,PACKAGE_PRISING,AMT_VALUE,PERCENT_VALUE,'Y' ENTITY_CRE_FLG, DEL_FLG, RCRE_USER_ID, "
		sv_s = sv_s + " RCRE_TIME,?SVAR LCHG_USER_ID,LCHG_TIME,PACKAGE_CODE,BANK_ID from CUSTOM.C_PACKAGE_MOD "
		sv_s = sv_s + " where PACKAGE_CODE = ?SVAR AND BANK_ID = ?SVAR"
		PRINT(sv_s)

		sv_d = urhk_dbSqlWithBind(sv_s)
		PRINT(sv_d)

		BANCS.INPARAM.BINDVARS = PACKAGE.DATA.packageCode+"|"+ BANCS.STDIN.contextBankId
                PRINT(BANCS.INPARAM.BINDVARS)

		sv_s = " DELETE FROM CUSTOM.C_PACKAGE_MOD WHERE PACKAGE_CODE = ?SVAR AND BANK_ID = ?SVAR"
		PRINT(sv_s)
	
		sv_r = urhk_dbSQLWithBind(sv_s)
		PRINT(sv_r)

		PACKAGE.DATA.messageField = "Record verified Successfully for Package Code " + PACKAGE.DATA.packageCode 
		PACKAGE.DATA.SuccessOrFailure="Y"
		GOTO sentMessage
	#}
	ENDIF

	#----------------------------------------------------------------
	#  Cancel Function
	#----------------------------------------------------------------

	IF (PACKAGE.DATA.funcCode == "X") THEN
	#{
		IF(CDOUBLE(PACKAGE.DATA.modTableCount) == 0) THEN	
		#{
			PACKAGE.DATA.error      = "There is nothing to verify or cancel."
			PACKAGE.DATA.errorFocus = "dummy"
			GOTO ERROR
		#}
		ENDIF
		
		BANCS.INPARAM.BINDVARS = PACKAGE.DATA.packageCode+"|"+ BANCS.STDIN.contextBankId
                PRINT(BANCS.INPARAM.BINDVARS)			

		sv_s = ""
		sv_s = sv_s + "DELETE FROM CUSTOM.C_PACKAGE_MOD WHERE PACKAGE_CODE = ?SVAR AND BANK_ID = ?SVAR"
		PRINT(sv_s)

		sv_d = urhk_dbSqlWithBind(sv_s)
		PRINT(sv_d)

		IF(sv_d == 0) THEN
		#{
			PACKAGE.DATA.messageField = "Record cancelled Successfully for Package Code " + PACKAGE.DATA.packageCode
			PRINT(PACKAGE.DATA.messageField)
			GOTO sentMessage
		#}
		ELSE
		#{
			PACKAGE.DATA.error 	= "Reccord Cancelation failed"
			PACKAGE.DATA.errorFocus = "dummy"
			GOTO ERROR
		#}
                ENDIF

	#}
	ENDIF



ERROR:
	sv_x=urhk_SetOrbOut("Error_0|Error^" + PACKAGE.DATA.error  + "^" +PACKAGE.DATA.errorFocus)
	sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
	EXITSCRIPT

Success:
	sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
	EXITSCRIPT

sentMessage:

        sv_z   =   urhk_SetOrbOut("SuccessOrFailure|Y")
        sv_z   =   urhk_SetOrbOut("RESULT_MSG| "+ PACKAGE.DATA.messageField)
        GOTO ENDOFSCRIPT



EXITSCRIPT

TRACE OFF
END-->


