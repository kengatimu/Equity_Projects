<--START
TRACE ON
        sv_r = REPEXISTS("CUST")

        IF(sv_r == 0) THEN
        #{
                CREATEREP ("CUST")
        #}
        ENDIF

        sv_r = CLASSEXISTS("CUST","DATA")

        IF(sv_r == 0) THEN
        #{
                CREATECLASS ("CUST","DATA",5)
        #}
        ENDIF

	CUST.DATA.poolId = " "
        CUST.DATA.poolFlg = "N"
        CUST.DATA.poolMsg = " "

        IF(FIELDEXISTS(BANCS.INPUT.acctNum))THEN
        #{
                IF(TRIM(BANCS.INPUT.acctNum) != "")THEN
                #{
                        CUST.DATA.acctNum = TOUPPER(TRIM(BANCS.INPUT.acctNum))
                        PRINT(CUST.DATA.acctNum)
                #}
                ENDIF
                #}
        ELSE
                #{
                CUST.DATA.poolFlg = "N"
                CUST.DATA.poolMsg = " "
                GOTO ENDOFSCRIPT
        #}
        ENDIF

	sv_s = "poolId|SELECT POOL_ID FROM TBAADM.GAM WHERE BANK_ID=?SVAR AND FORACID=?SVAR"
	BANCS.INPARAM.BINDVARS=BANCS.STDIN.contextBankId +"|"+ CUST.DATA.acctNum
	
	PRINT(sv_s)
	PRINT(BANCS.INPARAM.BINDVARS)

        sv_d = urhk_dbSelectWithBind(sv_s)
        PRINT(sv_d)

        IF(sv_d == 0)THEN
        #{

		CUST.DATA.poolId = BANCS.OUTPARAM.poolId
		PRINT(CUST.DATA.poolId)
	#}
	ENDIF

	IF(TRIM(CUST.DATA.poolId) != "")THEN
	#{
		CUST.DATA.poolFlg = "Y"
		CUST.DATA.poolMsg = "Accoutn is pooled with Current account. Pool ID: " +CUST.DATA.poolId
	#}
	ENDIF

	ENDOFSCRIPT:
                sv_u = urhk_SetOrbOut("poolFlg|"+CUST.DATA.poolFlg)
                PRINT(sv_u)
                sv_u = urhk_SetOrbOut("poolMsg|"+CUST.DATA.poolMsg)
                PRINT(sv_u)

	TRACE OFF
END-->
