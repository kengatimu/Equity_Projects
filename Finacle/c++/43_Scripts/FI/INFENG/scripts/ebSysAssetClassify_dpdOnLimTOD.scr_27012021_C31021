<--start
trace on
	
#-- VARRIABLE DECLARATION
	CUST.ASSTCLASS.dpdOnSanctLim = "0"
	CUST.ASSTCLASS.dpdCount ="0"
	CUST.ASSTCLASS.dpdCount1 ="0"
	CUST.ASSTCLASS.dpdCount2 ="0"
	CUST.ASSTCLASS.dpdCount3 ="0"
	CUST.ASSTCLASS.dpdCount4 ="0"
	CUST.ASSTCLASS.balAmt = "0"
	CUST.ASSTCLASS.foracid = BANCS.INPUT.foracid
	print(CUST.ASSTCLASS.foracid)
	CUST.ASSTCLASS.acid = BANCS.INPUT.b2kId
	print(CUST.ASSTCLASS.acid)
	CUST.ASSTCLASS.bodDate = MID$(BANCS.STDIN.BODDate,0,10)
	print(CUST.ASSTCLASS.bodDate)
	CUST.ASSTCLASS.bankId = BANCS.STDIN.contextBankId
	print(CUST.ASSTCLASS.bankId)
	CUST.ASSTCLASS.schmCode = BANCS.INPUT.schmCode
	print(CUST.ASSTCLASS.schmCode)
	CUST.ASSTCLASS.bodDateWTS = BANCS.STDIN.BODDate
	print(CUST.ASSTCLASS.bodDateWTS)
	
	if(CUST.ASSTCLASS.clrBalAmt >=0) then
		CUST.ASSTCLASS.dpdCount ="0"
		GOTO ENDOFSCR
	endif
	
	print(CUST.ASSTCLASS.sanctLimit)
	CUST.ASSTCLASS.balAmt = CDOUBLE(CUST.ASSTCLASS.clrBalAmt) + CDOUBLE(CUST.ASSTCLASS.sanctLimit)
	print(CUST.ASSTCLASS.balAmt)
	if( CUST.ASSTCLASS.balAmt > 0) then
	#{
		CUST.ASSTCLASS.dpdCount ="0"
		GOTO ENDOFSCR
	#}
	endif
	#-- OUTSTANDING BALANCE GREATER THAN THE SANCTIONED LIMIT.
	
	
	#--- Fetching Clear Balance Amount from GAM.
	
	if(CUST.ASSTCLASS.clrBalAmt <0) then
	#{
		
		#--- Fetching Last Credit Balance Date.
		sv_s = "maxCrBalCnt|"
		sv_s = sv_s + "SELECT COUNT(eod_date) "
		sv_s = sv_s + " FROM TBAADM.EAB "
		sv_s = sv_s + " WHERE tran_date_bal >=0 "
		sv_s = sv_s + " AND acid = ?SVAR "
		sv_s = sv_s + " AND bank_id = ?SVAR"
		print(sv_s)
		BANCS.INPARAM.BINDVARS=CUST.ASSTCLASS.acid+"|"+CUST.ASSTCLASS.bankId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		if(sv_d == 0) then
		#{
			CUST.ASSTCLASS.maxCrBalCnt = BANCS.OUTPARAM.maxCrBalCnt
			if(CUST.ASSTCLASS.maxCrBalCnt >0 )then
			#{
				sv_s = "maxCrBalDate|"
				sv_s = sv_s + "SELECT to_char(MAX(eod_date),'dd-mm-yyyy') "
				sv_s = sv_s + " FROM TBAADM.EAB "
				sv_s = sv_s + " WHERE tran_date_bal >=0 "
				sv_s = sv_s + " AND acid = ?SVAR "
				sv_s = sv_s + " AND bank_id = ?SVAR"
				print(sv_s)
				BANCS.INPARAM.BINDVARS=CUST.ASSTCLASS.acid+"|"+CUST.ASSTCLASS.bankId
				print(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSelectWithBind(sv_s)
				print(sv_d)
				if(sv_d == 0) then
				#{
					CUST.ASSTCLASS.maxCrBalDate = BANCS.OUTPARAM.maxCrBalDate
				#}
				endif
				#}
			else
				#{
				CUST.ASSTCLASS.maxCrBalDate = "31-12-2099"
			#}
			endif
			#}
		else
			#{
			CUST.ASSTCLASS.maxCrBalDate = "31-12-2099"
		#}
		endif
		print(CUST.ASSTCLASS.maxCrBalDate)
		
		#--- Checking the maximum sanction date if there is a limit available on the account
		CUST.ASSTCLASS.maxSanctDate = ""
		print (CUST.ASSTCLASS.sanctLimit)
		sv_t = CINT(CUST.ASSTCLASS.sanctLimit)
		print(sv_t)
		
		if(CINT(CUST.ASSTCLASS.sanctLimit) > CINT("0")) then
		#{
			sv_s = "maxSanctDate|"
			sv_s = sv_s + "SELECT to_char(MAX(eod_date),'dd-mm-yyyy') "
			sv_s = sv_s + " FROM TBAADM.EAB WHERE 1=1 "
			sv_s = sv_s + " AND ABS(tran_date_bal)<= '"+CUST.ASSTCLASS.sanctLimit+"'  "
			sv_s = sv_s + " AND tran_date_bal <0 "
			if (CUST.ASSTCLASS.maxCrBalDate !="31-12-2099") then
			#{
				sv_s = sv_s + " AND eod_date > to_date('"+CUST.ASSTCLASS.maxCrBalDate+"','dd-mm-yyyy') "
			#}
			endif
			sv_s = sv_s + " AND acid = ?SVAR "
			sv_s = sv_s + " AND bank_id = ?SVAR"
			print(sv_s)
			BANCS.INPARAM.BINDVARS=CUST.ASSTCLASS.acid+"|"+CUST.ASSTCLASS.bankId
			print(BANCS.INPARAM.BINDVARS)
			
			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			if(sv_d == 0) then
			#{
				CUST.ASSTCLASS.maxSanctDate = BANCS.OUTPARAM.maxSanctDate
				#}
			else
				#{
				CUST.ASSTCLASS.maxSanctDate = ""
			#}
			endif
		#}
		endif
		print(CUST.ASSTCLASS.maxSanctDate)
		
		CUST.ASSTCLASS.minDrBalDate = ""
		sv_s = "minDrBalDate|"
		sv_s = sv_s + "SELECT TO_CHAR(MIN(eod_date),'DD-MM-YYYY') "
		sv_s = sv_s + " FROM TBAADM.EAB "
		sv_s = sv_s + " WHERE ABS(tran_date_bal) > '"+CUST.ASSTCLASS.sanctLimit+"'  "
		sv_s = sv_s + " AND tran_date_bal <0 "
		if (CUST.ASSTCLASS.maxCrBalDate !="31-12-2099") then
		#{
			sv_s = sv_s + " AND eod_date > to_date('"+CUST.ASSTCLASS.maxCrBalDate+"','dd-mm-yyyy') "
		#}
		endif
		
		if(CUST.ASSTCLASS.maxSanctDate!="") then
		#{
			sv_s = sv_s + " AND eod_date > to_date('"+CUST.ASSTCLASS.maxSanctDate+"','dd-mm-yyyy') "
		#}
		endif
		sv_s = sv_s + " AND acid = ?SVAR "
		sv_s = sv_s + " AND bank_id = ?SVAR"
		
		print(sv_s)
		BANCS.INPARAM.BINDVARS=CUST.ASSTCLASS.acid+"|"+CUST.ASSTCLASS.bankId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		if(sv_d == 0) then
		#{
			CUST.ASSTCLASS.minDrBalDate = BANCS.OUTPARAM.minDrBalDate
			#}
		else
			#{
			CUST.ASSTCLASS.minDrBalDate = ""
		#}
		endif
		print(CUST.ASSTCLASS.minDrBalDate)
		#++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
			if(fieldexists(BANCS.INPUT.freeText6)==1)then
				print(BANCS.INPUT.freeText6)
			endif
			if(fieldexists(BANCS.INPUT.freeText7)==1)then
				print(BANCS.INPUT.freeText7)
			endif
			if(fieldexists(BANCS.INPUT.freeText8)==1)then
				print(BANCS.INPUT.freeText8)
			endif
		if(BANCS.INPUT.freeText6!="")then
			sv_b = urhk_B2k_valDate(BANCS.INPUT.freeText6)
			if(sv_b==0)then
					print(BANCS.INPUT.freeText6)
				######CUST.ASSTCLASS.minDrBalDate = BANCS.INPUT.freeText6
			endif
		endif
		#++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
		
		CUST.ASSTCLASS.todExpDate = ""
		sv_s = "todExpDate|"
		sv_s = sv_s + "SELECT TO_CHAR(MIN(discret_advn_due_date),'DD-MM-YYYY') "
		sv_s = sv_s + " FROM TBAADM.DAT "
		sv_s = sv_s + " WHERE discret_advn_reglr_ind = 'E' "
		if((CUST.ASSTCLASS.minDrBalDate!="") AND (CINT(CUST.ASSTCLASS.migdatediff) >=0)) then
		#{
			sv_s = sv_s + " AND discret_advn_due_date >= to_date('"+CUST.ASSTCLASS.minDrBalDate+"','dd-mm-yyyy') "
		#}
		endif
		# sv_s = sv_s + " AND ENTITY_TYPE != 'TODIC' "
		sv_s = sv_s + " AND acid = ?SVAR "
		sv_s = sv_s + " AND bank_id = ?SVAR"
		sv_s = sv_s + " AND entity_cre_flg = 'Y'"
		sv_s = sv_s + " AND del_flg != 'Y'"
		
		print(sv_s)
		BANCS.INPARAM.BINDVARS=CUST.ASSTCLASS.acid+"|"+CUST.ASSTCLASS.bankId
		print(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		if(sv_d == 0) then
		#{
			CUST.ASSTCLASS.todExpDate = BANCS.OUTPARAM.todExpDate
			#}
		else
			#{
			CUST.ASSTCLASS.todExpDate = ""
		#}
		endif
		print(CUST.ASSTCLASS.todExpDate)
		
		# Checking for existence of any unregularised TODs in the system where there are no expired TOD records in DAT
		CUST.ASSTCLASS.unregTODCnt = "0"
		if(CUST.ASSTCLASS.todExpDate == "") then
		#{
			sv_s = "unregTODCnt|"
			sv_s = sv_s + "SELECT COUNT(1) "
			sv_s = sv_s + " FROM TBAADM.DAT "
			sv_s = sv_s + " WHERE discret_advn_reglr_ind = 'U' "
			if((CUST.ASSTCLASS.minDrBalDate!="") AND (CINT(CUST.ASSTCLASS.migdatediff) >=0)) then
			#{
				sv_s = sv_s + " AND discret_advn_due_date >= to_date('"+CUST.ASSTCLASS.minDrBalDate+"','dd-mm-yyyy') "
			#}
			endif
			# sv_s = sv_s + " AND ENTITY_TYPE != 'TODIC' "
			sv_s = sv_s + " AND acid = ?SVAR "
			sv_s = sv_s + " AND bank_id = ?SVAR"
			sv_s = sv_s + " AND entity_cre_flg = 'Y'"
			sv_s = sv_s + " AND del_flg != 'Y'"
			
			print(sv_s)
			BANCS.INPARAM.BINDVARS=CUST.ASSTCLASS.acid+"|"+CUST.ASSTCLASS.bankId
			print(BANCS.INPARAM.BINDVARS)
			
			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			if(sv_d == 0) then
			#{
				CUST.ASSTCLASS.unregTODCnt = BANCS.OUTPARAM.unregTODCnt
				print(CUST.ASSTCLASS.unregTODCnt)
			#}
			endif
		#}
		endif
		
		#Handling the scenario for migrated accounts where expired/unregularised TOD data is not available in DAT/TDAT
		if((CUST.ASSTCLASS.todExpDate == "") AND (CINT(CUST.ASSTCLASS.unregTODCnt) == CINT("0")) AND (CINT(CUST.ASSTCLASS.sanctLimit) == CINT("0"))) then
		#{
			CUST.ASSTCLASS.todExpDate = CUST.ASSTCLASS.minDrBalDate
		#}
		endif
		print(CUST.ASSTCLASS.todExpDate)
		if((CUST.ASSTCLASS.bodDate != "") AND (CUST.ASSTCLASS.todExpDate != "")) then
		#{
			print(CUST.ASSTCLASS.bodDate)
			print(CUST.ASSTCLASS.todExpDate)
			print(BANCS.INPUT.freeText6)
			print(BANCS.INPUT.freeText8)
			BANCS.INPARAM.date1 = CUST.ASSTCLASS.bodDate
			######if(CUST.ASSTCLASS.clrBalAmt <0) then
				#####BANCS.INPARAM.date2 = BANCS.INPUT.freeText6 
			######else
				BANCS.INPARAM.date2 = CUST.ASSTCLASS.todExpDate
			######endif
			sv_u = urhk_B2K_dateDiff("")
			print(sv_u)
			
			if(sv_u == 0 ) then
			#{
				CUST.ASSTCLASS.dpdCount2 = BANCS.OUTPARAM.dateDiff
				if(CINT(CUST.ASSTCLASS.dpdCount2) <= 0) then
				#{
					CUST.ASSTCLASS.dpdCount2= "0"
				#}
				endif
				#}
			else
				#{
				CUST.ASSTCLASS.dpdCount2 = "0"
			#}
			endif
			#}
		else
			#{
			CUST.ASSTCLASS.dpdCount2 = "0"
		#}
		endif
		print(CUST.ASSTCLASS.dpdCount2)
		
		#}
	else
		#{
		CUST.ASSTCLASS.dpdCount2 = "0"
	#}
	endif
	
	if(CINT(CUST.ASSTCLASS.sanctLimit) >CINT("0")) then
	#{
		if(CINT(CUST.ASSTCLASS.dpdCount1) > CINT(CUST.ASSTCLASS.dpdCount2) ) then
		#{
			CUST.ASSTCLASS.dpdCount = CUST.ASSTCLASS.dpdCount1
			#}
		else
			#{
			CUST.ASSTCLASS.dpdCount = CUST.ASSTCLASS.dpdCount2
		#}
		endif
		print(CUST.ASSTCLASS.dpdCount)
		GOTO ENDOFSCR
		#}
	else
		#{
		CUST.ASSTCLASS.dpdCount = CUST.ASSTCLASS.dpdCount2
		print(CUST.ASSTCLASS.dpdCount)
		GOTO ENDOFSCR
	#}
	endif
	
	ENDOFSCR:
		print(CUST.ASSTCLASS.dpdCount)
		CUST.ASSTCLASS.dpdOnSanctLim = CINT(CUST.ASSTCLASS.dpdCount)
		print(CUST.ASSTCLASS.dpdOnSanctLim)
		EXITSCRIPT
END-->
