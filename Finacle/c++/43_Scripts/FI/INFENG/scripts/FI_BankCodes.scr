#------------------------------------------------------------------------------------------------
#  Name            : FI_BankCodes.scr
#  Description     : Fetch Bank Codes based on BankId
#  Date            : 01-10-2025
#  Author          : YESHWANTH
#  Input           : NA
#  Output          : NA
#  Called Script   : NA
#  Menu Option     : (API)
#  Srl. No         Date            Author               Description.
#  -------         ------          ------               ------------
#  1.0           01-10-2025       YESHWANTH		Original Version
#-----------------------------------------------------------------------------------------------
<--START
TRACE ON

	sv_u=REPEXISTS("CUST")
	IF(sv_u==0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF

	sv_u=CLASSEXISTS("CUST", "BNK")
	IF(sv_u==0) THEN
	#{
		CREATECLASS("CUST", "BNK", 5)
	#}
	ENDIF

	sv_t=urhk_b2k_printrepos("BANCS")
	print(sv_t)	


	IF( (FIELDEXISTS(("BANCS").("INPUT").("BANKID"))== 0) ) THEN
	#{
   		CUST.BNK.errMsg="please enter BANKID"
		sv_t = "ERROR | " +CUST.BNK.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDOFSCRIPT
	#}
	ENDIF

	#---------------------------------------------------------------------------------------------------------------
	# Variable Initialization
	#---------------------------------------------------------------------------------------------------------------

	CUST.BNK.BANKID = BANCS.INPUT.BANKID
	print(CUST.BNK.BANKID)

	sv_s="BankCode,BnkFullName,BnkShortName|"
	sv_s = sv_s + "SELECT bank_code, DECODE('INFENG' ,'' , NVL(alt1_bank_name,bank_name),bank_name), DECODE('INFENG' ,'' , NVL(alt1_bank_short_name,bank_short_name),bank_short_name) "
	sv_s = sv_s + "FROM TBAADM.BKC  WHERE BKC.BANK_ID = ?SVAR  AND  1 = 1  AND del_flg =  'N'   ORDER BY  bank_code "
	print(sv_s)

	BANCS.INPARAM.BINDVARS = CUST.BNK.BANKID
	print(BANCS.INPARAM.BINDVARS)

	sv_v = urhk_dbcursorOpenWithBind(sv_s)
       	PRINT(sv_v)	

	IF(sv_v == 0) THEN
       	 #{
        	CUST.BNK.CURSOR_NUMBER = BANCS.OUTPARAM.DB_CURSOR_NUMBER
       		print(CUST.BNK.CURSOR_NUMBER)
       		sv_b = urhk_dbCursorFetch(CUST.BNK.CURSOR_NUMBER)
        	print(sv_b)
		IF(sv_b== "1")THEN
		#{
   			CUST.BNK.errMsg="No records were fetched"
			sv_t = "MSG| " +CUST.BNK.errMsg
			sv_u = urhk_SetOrbOut(sv_t)
			GOTO ENDOFSCRIPT
		#}
		ENDIF

		lv_m = 0
		print(lv_m)
		lv_m = FORMAT$(lv_m,"%d")
		print(lv_m)

		WHILE(sv_b == "0")
        	#{
			CUST.BNK.BankCode  = BANCS.OUTPARAM.BankCode
			print(CUST.BNK.BankCode)
			CUST.BNK.BnkFullName = BANCS.OUTPARAM.BnkFullName
			print(CUST.BNK.BnkFullName)
			CUST.BNK.BnkShortName = BANCS.OUTPARAM.BnkShortName
			print(CUST.BNK.BnkShortName)

			sv_s="BANK.<rec_"+lv_m+">.BANKCODE|" + CUST.BNK.BankCode
			sv_u = urhk_SetOrbOut(sv_s)

			sv_s="BANK.<rec_"+lv_m+">.BANKFULLNAME|" + CUST.BNK.BnkFullName
			sv_u = urhk_SetOrbOut(sv_s)

			IF(CUST.BNK.BnkShortName != "") THEN
				sv_s="BANK.<rec_"+lv_m+">.BANKSHORTNAME|" + CUST.BNK.BnkShortName
				sv_u = urhk_SetOrbOut(sv_s)
			ELSE
				sv_s="BANK.<rec_"+lv_m+">.BANKSHORTNAME| "
				sv_u = urhk_SetOrbOut(sv_s)
			ENDIF

			lv_m  = CINT(lv_m) + 1
			lv_m  = FORMAT$(lv_m, "%d")
       			sv_b = urhk_dbCursorFetch(CUST.BNK.CURSOR_NUMBER)
       			print(sv_b)
		#}
		DO
	#}
	ENDIF

ENDOFSCRIPT:
TRACE OFF
END-->

