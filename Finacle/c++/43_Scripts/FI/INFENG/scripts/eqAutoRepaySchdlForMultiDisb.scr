#======================================================#
#Source Name                    :eqAutoRepaySchdlForMultiDisb.scr
#Menu                           :HLADISB
#Date                           :27-06-2023
#Description                    :Automation of Repayment Schedule for Multi Disb Loan, during HLADISB.
#Author                         :Ranjith Palani
#======================================================#
<--start
trace on
	if(repexists("CUST") == 0)then
		createrep("CUST")
	endif
	if(classexists("CUST","LARA") == 0)then
		createclass("CUST","LARA",5)
	endif

	sv_a = urhk_SRV_GetVal("acctDisburseTranLA.finalDisbFlg")
	CUST.LARA.finalDisbFlg = BANCS.OUTPARAM.srvValue	
	print(CUST.LARA.finalDisbFlg)
	sv_a = urhk_SRV_GetVal("acctDisburseTranLA.laAcct.foracid")
	CUST.LARA.laForacid = BANCS.OUTPARAM.srvValue	
	print(CUST.LARA.laForacid)
	sv_a = urhk_SRV_GetVal("acctDisburseTranLA.disburseAmt")
	CUST.LARA.disburseAmtCrncy = BANCS.OUTPARAM.srvValue	
	print(CUST.LARA.disburseAmtCrncy)

	sv_p = getposition(CUST.LARA.disburseAmtCrncy,"|")
	sv_d = mid$(CUST.LARA.disburseAmtCrncy,0,(sv_p-1))
	CUST.LARA.disburseAmt = sv_d
	print(CUST.LARA.disburseAmt)
	sv_c = mid$(CUST.LARA.disburseAmtCrncy,sv_p,strlen(CUST.LARA.disburseAmtCrncy))
	CUST.LARA.disburseCrncy = sv_c
	print(CUST.LARA.disburseCrncy)

	sv_g = urhk_getAcctDetailsInRepository(CUST.LARA.laForacid)
	if(sv_g == 0)then
		CUST.LARA.sanctionLimit = BANCS.OUTPARAM.sanctionLimit
		print(CUST.LARA.sanctionLimit)
	endif
	if((cdouble(CUST.LARA.sanctionLimit) == cdouble(CUST.LARA.disburseAmt)) and (CUST.LARA.finalDisbFlg == "Y"))then
		exitscript	
	endif
	sv_a = urhk_SRV_GetVal("acctDisburseTranLA.laAcct.crncyCode")
	CUST.LARA.laCrncyCode = BANCS.OUTPARAM.srvValue	
	print(CUST.LARA.laCrncyCode)
	sv_a = urhk_SRV_GetVal("acctDisburseTranLA.schmCode.schmCode")
	CUST.LARA.schmCode = BANCS.OUTPARAM.srvValue	
	print(CUST.LARA.schmCode)
	sv_a = urhk_SRV_GetVal("acctDisburseTranLA.loanAmt")
	CUST.LARA.loanAmt = BANCS.OUTPARAM.srvValue	
	print(CUST.LARA.loanAmt)
	sv_a = urhk_SRV_GetVal("acctDisburseTranLA.loanPerdMths")
	CUST.LARA.loanPerdMths = BANCS.OUTPARAM.srvValue	
	print(CUST.LARA.loanPerdMths)
	sv_a = urhk_SRV_GetVal("acctDisburseTranLA.loanPerdDays")
	CUST.LARA.loanPerdDays = BANCS.OUTPARAM.srvValue	
	print(CUST.LARA.loanPerdDays)
	sv_a = urhk_SRV_GetVal("acctDisburseTranLA.amtAlreadyDisbursed")
	CUST.LARA.amtAlreadyDisbursed = BANCS.OUTPARAM.srvValue	
	print(CUST.LARA.amtAlreadyDisbursed)
	sv_a = urhk_SRV_GetVal("acctDisburseTranLA.amtAvailForDisbursement")
	CUST.LARA.amtAvailForDisbursement = BANCS.OUTPARAM.srvValue	
	print(CUST.LARA.amtAvailForDisbursement)
	sv_a = urhk_SRV_GetVal("tranMesg.tranDetail.partTranDetailLL.<rec_0>.pTranIdentifier.tranDate")
	CUST.LARA.tranDate = BANCS.OUTPARAM.srvValue	
	print(CUST.LARA.tranDate)
	sv_a = urhk_SRV_GetVal("tranMesg.tranDetail.partTranDetailLL.<rec_0>.pTranIdentifier.tranId")
	CUST.LARA.tranId = BANCS.OUTPARAM.srvValue	
	print(CUST.LARA.tranId)
	
	BANCS.INPARAM.acctId = CUST.LARA.laForacid 
	BANCS.INPARAM.asOnDate = BANCS.STDIN.BODDate
	sv_a = urhk_getAcctBalanceAsOnDate("")
	print(BANCS.OUTPARAM.acctBal)
	BANCS.INPARAM.balance = BANCS.OUTPARAM.acctBal
	BANCS.INPARAM.acctNum = CUST.LARA.laForacid 
	BANCS.INPARAM.asOnDate = BANCS.STDIN.BODDate
	sv_a = urhk_getInterestRateForAccount("")
	if(sv_a != 0)then
		#exitscript
		CUST.LARA.interestRate = cdouble("0")
	endif
	CUST.LARA.interestRate = cdouble(BANCS.OUTPARAM.interestRate)
	print(CUST.LARA.interestRate)


	#--Reschedule
	sv_i = urhk_SetUrhkInp("basicRshdlDtl.rshdlMode|R")
	sv_i = urhk_SetUrhkInp("basicRshdlDtl.laSchmParams.eiMethod|P")
	sv_i = urhk_SetUrhkInp("basicRshdlDtl.laAcct.foracid|"+ CUST.LARA.laForacid)
	sv_o = urhk_SetUrhkOut("basicRshdlDtl.laOvduDtls.outStandingAmt|outStandingAmt")
	sv_e = urhk_ExecSrv("SRV_FetchLAAcctDtlForRshdl|retain_all_output = Y")
	print(sv_e)
	if(sv_e != 0)then
		call("ebsrvHandler.scr")
		goto endofscript
	endif
	CUST.LARA.outStandingAmtCrncy = BANCS.OUTPARAM.outStandingAmt
	print(CUST.LARA.outStandingAmtCrncy)
	sv_p = getposition(CUST.LARA.outStandingAmtCrncy,"|")
	sv_o = mid$(CUST.LARA.outStandingAmtCrncy,0,(sv_p-1))
	CUST.LARA.outStandingAmt = sv_o
	print(CUST.LARA.outStandingAmt)
	CUST.LARA.outStandingAmt = -1 * cdouble(CUST.LARA.outStandingAmt)
	print(CUST.LARA.outStandingAmt)
	sv_c = mid$(CUST.LARA.outStandingAmtCrncy,sv_p,strlen(CUST.LARA.outStandingAmtCrncy))
	CUST.LARA.outStandingCrncy = sv_c
	print(CUST.LARA.outStandingCrncy)

		#--Compute
		sv_i = urhk_SetUrhkInp("mandatoryParameters.originationDate|"+ BANCS.STDIN.BODDate)
		sv_i = urhk_SetUrhkInp("mandatoryParameters.schmCode.schmCode|"+ CUST.LARA.schmCode)
		sv_i = urhk_SetUrhkInp("mandatoryParameters.crncyCode.crncyCode|"+ CUST.LARA.laCrncyCode)
		sv_i = urhk_SetUrhkInp("mandatoryParameters.loanPerdMths|"+ CUST.LARA.loanPerdMths)
		sv_i = urhk_SetUrhkInp("variables.loanAmount|"+ CUST.LARA.outStandingAmt +"|"+ CUST.LARA.outStandingCrncy)
		sv_i = urhk_SetUrhkInp("variables.noOfInstalmnts|"+ CUST.LARA.loanPerdMths)
		sv_i = urhk_SetUrhkInp("variables.intRate|"+ CUST.LARA.interestRate)
		sv_o = urhk_SetUrhkOut("variables.instalmntAmt|instalmntAmt")
		sv_e = urhk_ExecSrv("SRV_Compute|retain_all_output = Y|call_mode = E")
		print(sv_e)
		if(sv_e != 0)then
			call("ebsrvHandler.scr")
			goto endofscript
		endif
		CUST.LARA.instalmntAmtCrncy = BANCS.OUTPARAM.instalmntAmt
		print(CUST.LARA.instalmntAmtCrncy)
		sv_p = getposition(CUST.LARA.instalmntAmtCrncy,"|")
		sv_i = mid$(CUST.LARA.instalmntAmtCrncy,0,(sv_p-1))
		CUST.LARA.instalmntAmt = sv_i
		print(CUST.LARA.instalmntAmt)
		CUST.LARA.instalmntAmt = cdouble(CUST.LARA.instalmntAmt)
		print(CUST.LARA.instalmntAmt)
		sv_c = mid$(CUST.LARA.instalmntAmtCrncy,sv_p,strlen(CUST.LARA.instalmntAmtCrncy))
		CUST.LARA.instalmntCrncy = sv_c
		print(CUST.LARA.instalmntCrncy)

	#--Reschedule
	sv_i = urhk_SetUrhkInp("basicRshdlDtl.rshdlMode|R")
	sv_i = urhk_SetUrhkInp("basicRshdlDtl.laSchmParams.eiMethod|P")
	sv_i = urhk_SetUrhkInp("basicRshdlDtl.laAcct.foracid|"+ CUST.LARA.laForacid)

	sv_o = urhk_SetUrhkOut("loanShdlCommonParams.instlmntStartDate|instlmntStartDate")
	sv_o = urhk_SetUrhkOut("loanShdlCommonParams.intStartDate|intStartDate")
	sv_o = urhk_SetUrhkOut("loanShdlCommonParams.instlmntFreq.type|instlType")
	sv_o = urhk_SetUrhkOut("loanShdlCommonParams.instlmntFreq.weekDay|instlWeekDay")
	sv_o = urhk_SetUrhkOut("loanShdlCommonParams.instlmntFreq.startDd|instlStartDd")
	sv_o = urhk_SetUrhkOut("loanShdlCommonParams.instlmntFreq.hldyStat|instlHldyStat")
	sv_o = urhk_SetUrhkOut("loanShdlCommonParams.instlmntFreq.calBase|instlCalBase")
	sv_o = urhk_SetUrhkOut("loanShdlCommonParams.instlmntFreq.months|instlMonths")
	sv_o = urhk_SetUrhkOut("loanShdlCommonParams.instlmntFreq.days|instlDays")
	sv_o = urhk_SetUrhkOut("loanShdlCommonParams.intFreq.type|intType")
	sv_o = urhk_SetUrhkOut("loanShdlCommonParams.intFreq.weekDay|intWeekDay")
	sv_o = urhk_SetUrhkOut("loanShdlCommonParams.intFreq.startDd|intStartDd")
	sv_o = urhk_SetUrhkOut("loanShdlCommonParams.intFreq.hldyStat|intHldyStat")
	sv_o = urhk_SetUrhkOut("loanShdlCommonParams.intFreq.calBase|intCalBase")
	sv_o = urhk_SetUrhkOut("loanShdlCommonParams.intFreq.months|intMonths")
	sv_o = urhk_SetUrhkOut("loanShdlCommonParams.intFreq.days|intDays")
	sv_o = urhk_SetUrhkOut("capitalizeIntFlag|capitalizeIntFlag")

	sv_e = urhk_ExecSrv("SRV_FetchLAAcctDtlForRshdl|retain_all_output = Y")
	print(sv_e)
	if(sv_e != 0)then
		call("ebsrvHandler.scr")
		goto endofscript
	endif
	CUST.LARA.instlmntStartDate = BANCS.OUTPARAM.instlmntStartDate
	print(CUST.LARA.instlmntStartDate)
	CUST.LARA.intStartDate = BANCS.OUTPARAM.intStartDate
	print(CUST.LARA.intStartDate)
	CUST.LARA.instlType = BANCS.OUTPARAM.instlType
	print(CUST.LARA.instlType)
	CUST.LARA.instlWeekDay = BANCS.OUTPARAM.instlWeekDay
	print(CUST.LARA.instlWeekDay)
	CUST.LARA.instlStartDd = BANCS.OUTPARAM.instlStartDd
	print(CUST.LARA.instlStartDd)
	CUST.LARA.instlHldyStat = BANCS.OUTPARAM.instlHldyStat
	print(CUST.LARA.instlHldyStat)
	CUST.LARA.instlCalBase = BANCS.OUTPARAM.instlCalBase
	print(CUST.LARA.instlCalBase)
	CUST.LARA.instlMonths = BANCS.OUTPARAM.instlMonths
	print(CUST.LARA.instlMonths)
	CUST.LARA.instlDays = BANCS.OUTPARAM.instlDays
	print(CUST.LARA.instlDays)

	CUST.LARA.intType = BANCS.OUTPARAM.intType
	print(CUST.LARA.intType)
	CUST.LARA.intWeekDay = BANCS.OUTPARAM.intWeekDay
	print(CUST.LARA.intWeekDay)
	CUST.LARA.intStartDd = BANCS.OUTPARAM.intStartDd
	print(CUST.LARA.intStartDd)
	CUST.LARA.intHldyStat = BANCS.OUTPARAM.intHldyStat
	print(CUST.LARA.intHldyStat)
	CUST.LARA.intCalBase = BANCS.OUTPARAM.intCalBase
	print(CUST.LARA.intCalBase)
	CUST.LARA.intMonths = BANCS.OUTPARAM.intMonths
	print(CUST.LARA.intMonths)
	CUST.LARA.intDays = BANCS.OUTPARAM.intDays
	print(CUST.LARA.intDays)
	CUST.LARA.capitalizeIntFlag = BANCS.OUTPARAM.capitalizeIntFlag
	print(CUST.LARA.capitalizeIntFlag)
	sv_c = urhk_CopyOutToIn("")
	sv_i = urhk_SetUrhkInp("basicRshdlDtl.acctRepaymentShdlLA.repaymentLL.<rec_0>.llKeyElement.serial_num|00001")
	sv_i = urhk_SetUrhkInp("basicRshdlDtl.acctRepaymentShdlLA.repaymentLL.<rec_0>.flowStartDate|"+ CUST.LARA.instlmntStartDate)
	sv_i = urhk_SetUrhkInp("basicRshdlDtl.acctRepaymentShdlLA.repaymentLL.<rec_0>.eiFrequency.type|"+ CUST.LARA.instlType)
	sv_i = urhk_SetUrhkInp("basicRshdlDtl.acctRepaymentShdlLA.repaymentLL.<rec_0>.eiFrequency.weekDay|"+ CUST.LARA.instlWeekDay)
	sv_i = urhk_SetUrhkInp("basicRshdlDtl.acctRepaymentShdlLA.repaymentLL.<rec_0>.eiFrequency.startDd|"+ CUST.LARA.instlStartDd)
	sv_i = urhk_SetUrhkInp("basicRshdlDtl.acctRepaymentShdlLA.repaymentLL.<rec_0>.eiFrequency.hldyStat|"+ CUST.LARA.instlHldyStat)
	sv_i = urhk_SetUrhkInp("basicRshdlDtl.acctRepaymentShdlLA.repaymentLL.<rec_0>.eiFrequency.calBase|"+ CUST.LARA.instlCalBase)
	sv_i = urhk_SetUrhkInp("basicRshdlDtl.acctRepaymentShdlLA.repaymentLL.<rec_0>.eiFrequency.months|"+ CUST.LARA.instlMonths)
	sv_i = urhk_SetUrhkInp("basicRshdlDtl.acctRepaymentShdlLA.repaymentLL.<rec_0>.eiFrequency.days|"+ CUST.LARA.instlDays)
	sv_i = urhk_SetUrhkInp("basicRshdlDtl.acctRepaymentShdlLA.repaymentLL.<rec_0>.interestFrequency.type|"+ CUST.LARA.intType)
	sv_i = urhk_SetUrhkInp("basicRshdlDtl.acctRepaymentShdlLA.repaymentLL.<rec_0>.interestFrequency.weekDay|"+ CUST.LARA.intWeekDay)
	sv_i = urhk_SetUrhkInp("basicRshdlDtl.acctRepaymentShdlLA.repaymentLL.<rec_0>.interestFrequency.startDd|"+ CUST.LARA.intStartDd)
	sv_i = urhk_SetUrhkInp("basicRshdlDtl.acctRepaymentShdlLA.repaymentLL.<rec_0>.interestFrequency.hldyStat|"+ CUST.LARA.intHldyStat)
	sv_i = urhk_SetUrhkInp("basicRshdlDtl.acctRepaymentShdlLA.repaymentLL.<rec_0>.interestFrequency.calBase|"+ CUST.LARA.intCalBase)
	sv_i = urhk_SetUrhkInp("basicRshdlDtl.acctRepaymentShdlLA.repaymentLL.<rec_0>.interestFrequency.months|"+ CUST.LARA.intMonths)
	sv_i = urhk_SetUrhkInp("basicRshdlDtl.acctRepaymentShdlLA.repaymentLL.<rec_0>.interestFrequency.days|"+ CUST.LARA.intDays)
	sv_i = urhk_SetUrhkInp("basicRshdlDtl.acctRepaymentShdlLA.repaymentLL.<rec_0>.noOfDemands|"+ CUST.LARA.loanPerdMths)
	#sv_i = urhk_SetUrhkInp("basicRshdlDtl.acctRepaymentShdlLA.repaymentLL.<rec_0>.flowAmt|"+ CUST.LARA.instalmntAmt +"|"+ CUST.LARA.laCrncyCode)
	sv_i = urhk_SetUrhkInp("basicRshdlDtl.acctRepaymentShdlLA.repaymentLL.<rec_0>.flowAmt|"+ CUST.LARA.instalmntAmt +"|"+ CUST.LARA.instalmntCrncy)
	sv_i = urhk_SetUrhkInp("capitalizeIntFlag|"+ CUST.LARA.capitalizeIntFlag)
	sv_e = urhk_ExecSrv("SRV_RegenerateRSHDL|retain_all_output = Y|call_mode = E")
	print(sv_e)
	if(sv_e != 0)then
		call("ebsrvHandler.scr")
		goto endofscript
	endif

	sv_c = urhk_CopyOutToIn("")
	sv_e = urhk_ExecSrv("SRV_ReshdlLaAcct|retain_all_output = Y|call_mode = E")
	print(sv_e)
	if(sv_e != 0)then
		call("ebsrvHandler.scr")
		goto endofscript
	endif

	#--VerifyReschedule
	sv_i = urhk_SetUrhkInp("basicRshdlDtl.laAcct.foracid|"+CUST.LARA.laForacid)
	sv_e = urhk_ExecSrv("SRV_FetchLAAcctDtlForVfy|retain_all_output = Y|same_user_verify = Y")
	print(sv_e)
	if(sv_e != 0)then
		call("ebsrvHandler.scr")
		goto endofscript
	endif
	sv_c = urhk_CopyOutToIn("")
	sv_e = urhk_ExecSrv("SRV_VfyLaAcctRshdl|retain_all_output = Y|same_user_verify = Y")
	print(sv_e)
	if(sv_e != 0)then
		call("ebsrvHandler.scr")
		goto endofscript
	endif

	
endofscript:
trace off
end-->
