<--START
	TRACE ON
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","DATA") == 0) THEN
	#{
		CREATECLASS("CUST","DATA",5)
	#}
	ENDIF
	 sv_a = urhk_B2k_PrintRepos("BANCS")	
	CUST.DATA.errorFlg ="N"
	CUST.DATA.errorMsg =" "
	CUST.DATA.chrgCrncy = " "
	CUST.DATA.chrgAmt = "0"
	CUST.DATA.vatCrncy = " "
	CUST.DATA.vatAmt = "0"
	CUST.DATA.refAmt = "0"
	CUST.DATA.refCrncy = " "
	CUST.DATA.acctId = " "
	
	IF(FIELDEXISTS(BANCS.INPUT.acctId))THEN
	#{
		
		IF(TRIM(BANCS.INPUT.acctId) != "")THEN
		#{
			CUST.DATA.acctId = TOUPPER(BANCS.INPUT.acctId)
			PRINT(CUST.DATA.acctId)
			#}
		ELSE
			#{
			CUST.DATA.errorFlg ="Y"
			CUST.DATA.errorMsg ="Account Id not passed!"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.DATA.errorFlg ="Y"
		CUST.DATA.errorMsg ="Account Id not passed!"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.refAmt))THEN
	#{
		
		IF(TRIM(BANCS.INPUT.refAmt) != "")THEN
		#{
			CUST.DATA.refAmt = TOUPPER(BANCS.INPUT.refAmt)
			PRINT(CUST.DATA.refAmt)
			#}
		ELSE
			#{
			CUST.DATA.errorFlg ="Y"
			CUST.DATA.errorMsg ="Ref Amt. not passed!"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.DATA.errorFlg ="Y"
		CUST.DATA.errorMsg ="Ref Amt. not passed!"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
        IF(FIELDEXISTS(BANCS.INPUT.refCrncy))THEN
        #{

                IF(TRIM(BANCS.INPUT.refCrncy) != "")THEN
                #{
                        CUST.DATA.refCrncy = TOUPPER(BANCS.INPUT.refCrncy)
                        PRINT(CUST.DATA.refCrncy)
                        #}
                ELSE
                        #{
                        CUST.DATA.errorFlg ="Y"
                        CUST.DATA.errorMsg ="Ref Amt. not passed!"
                        GOTO ENDOFSCRIPT
                #}
                ENDIF
                #}
        ELSE
                #{
                CUST.DATA.errorFlg ="Y"
                CUST.DATA.errorMsg ="Ref Crncy. not passed!"
                GOTO ENDOFSCRIPT
        #}
        ENDIF

        IF(FIELDEXISTS(BANCS.INPUT.chrgAmt))THEN
        #{

                IF(TRIM(BANCS.INPUT.chrgAmt) != "")THEN
                #{
                        CUST.DATA.chrgAmt = TOUPPER(BANCS.INPUT.chrgAmt)
                        PRINT(CUST.DATA.chrgAmt)
                        #}
                ELSE
                        #{
                        CUST.DATA.errorFlg ="Y"
                        CUST.DATA.errorMsg ="chrg Amt. not passed!"
                        GOTO ENDOFSCRIPT
                #}
                ENDIF
                #}
        ELSE
                #{
                CUST.DATA.errorFlg ="Y"
                CUST.DATA.errorMsg ="chrg AMt. not passed!"
                GOTO ENDOFSCRIPT
        #}
        ENDIF

        IF(FIELDEXISTS(BANCS.INPUT.chrgCrncy))THEN
        #{

                IF(TRIM(BANCS.INPUT.chrgCrncy) != "")THEN
                #{
                        CUST.DATA.chrgCrncy = TOUPPER(BANCS.INPUT.chrgCrncy)
                        PRINT(CUST.DATA.chrgCrncy)
                        #}
                ELSE
                        #{
                        CUST.DATA.errorFlg ="Y"
                        CUST.DATA.errorMsg ="chrg Crncy. not passed!"
                        GOTO ENDOFSCRIPT
                #}
                ENDIF
                #}
        ELSE
                #{
                CUST.DATA.errorFlg ="Y"
                CUST.DATA.errorMsg ="chrg Crncy. not passed!"
                GOTO ENDOFSCRIPT
        #}
        ENDIF

        IF(FIELDEXISTS(BANCS.INPUT.vatCrncy))THEN
        #{

                IF(TRIM(BANCS.INPUT.vatCrncy) != "")THEN
                #{
                        CUST.DATA.vatCrncy = TOUPPER(BANCS.INPUT.vatCrncy)
                        PRINT(CUST.DATA.vatCrncy)
                        #}
                ELSE
                        #{
                        CUST.DATA.errorFlg ="Y"
                        CUST.DATA.errorMsg ="vat Crncy. not passed!"
                        GOTO ENDOFSCRIPT
                #}
                ENDIF
                #}
        ELSE
                #{
                CUST.DATA.errorFlg ="Y"
                CUST.DATA.errorMsg ="vat Crncy. not passed!"
                GOTO ENDOFSCRIPT
        #}
        ENDIF

        IF(FIELDEXISTS(BANCS.INPUT.vatAmt))THEN
        #{

                IF(TRIM(BANCS.INPUT.vatAmt) != "")THEN
                #{
                        CUST.DATA.vatAmt = TOUPPER(BANCS.INPUT.vatAmt)
                        PRINT(CUST.DATA.vatAmt)
                        #}
                ELSE
                        #{
                        CUST.DATA.errorFlg ="Y"
                        CUST.DATA.errorMsg ="vat Amt. not passed!"
                        GOTO ENDOFSCRIPT
                #}
                ENDIF
                #}
        ELSE
                #{
                CUST.DATA.errorFlg ="Y"
                CUST.DATA.errorMsg ="vat Amt. not passed!"
                GOTO ENDOFSCRIPT
        #}
        ENDIF
                sv_n = urhk_getAcctDetailsInRepository(CUST.DATA.acctId)
                IF (sv_n != 0)THEN
                #{
	                CUST.DATA.errorFlg ="Y"
       	        	CUST.DATA.errorMsg ="Invalid Account ID"
       		        GOTO ENDOFSCRIPT

                #}
                ELSE
                #{
                        print(BANCS.OUTPARAM.acctCrncyCode)
                        print(BANCS.OUTPARAM.EffAvailableAmt)

                        CUST.DATA.crncy = BANCS.OUTPARAM.acctCrncyCode
                        CUST.DATA.avlblAmt = BANCS.OUTPARAM.EffAvailableAmt
                #}
                ENDIF

	CUST.DATA.totalAmt = CDOUBLE(CUST.DATA.chrgAmt) + CDOUBLE(CUST.DATA.vatAmt) + CDOUBLE(CUST.DATA.refAmt)
	PRINT(CUST.DATA.totalAmt)
	
	IF(CDOUBLE(CUST.DATA.avlblAmt) < CUST.DATA.totalAmt)THEN
	#{
	        CUST.DATA.errorFlg ="Y"
                CUST.DATA.errorMsg ="vat Amt. not passed!"
                GOTO ENDOFSCRIPT
	#}
	ENDIF

	ENDOFSCRIPT:
		sv_u = urhk_SetOrbOut("errorFlg|"+CUST.DATA.errorFlg)
		PRINT(sv_u)
		sv_u = urhk_SetOrbOut("errorMsg|"+CUST.DATA.errorMsg)
		PRINT(sv_u)
TRACE OFF
		
END-->
