<--START
TRACE ON

#--------------------------------------------------------------------------
#  Creation of MISS repository and CHRG class
#--------------------------------------------------------------------------

	sv_r = REPEXISTS("BANCS")
        IF (sv_r == 0) THEN
                CREATEREP("BANCS")
        endif

	sv_r = REPEXISTS("MISS")
        IF (sv_r == 0) THEN
                CREATEREP("MISS")
        endif

	sv_r = CLASSEXISTS("MISS", "CHRG")
	IF (sv_r == 0) THEN
		CREATECLASS("MISS", "CHRG", 5)
	ENDIF

#--------------------------------------------------------------------------
# Selecting total number of accounts which are not charged 
#--------------------------------------------------------------------------

	sv_s = "getboddate|select to_char((db_stat_date-1),'DD-MM-YYYY') from tbaadm.gct where bank_id=?SVAR"
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId 
		PRINT(BANCS.INPARAM.BINDVARS)

		sv_d = urhk_dbselectWithBind(sv_s)
			IF (sv_d =="0") THEN
				MISS.CHRG.getboddate = BANCS.OUTPARAM.getboddate
				print(MISS.CHRG.getboddate)
			ENDIF
        

	print(BANCS.STDIN.mySolId)


#--------------------------------------------------------------------------
# Selecting accounts from DTD 
#--------------------------------------------------------------------------


sv_s = "acid,op_acid,cif_id,foracid,acct_name,schm_code,clr_bal_amt,dis_amt,drwng_power,sanct_lim,flow_id,num_of_flows,flow_amt,shdl_num,dmd_amount,opforacid,op_availbal,op_cyc,op_freeze,op_fz_ren_code,other_op_ac,other_op_ac_avbal,other_op_ac_cyc,other_op_ac_frez_code,other_op_ac_fz_ren_code | "
sv_s = sv_s + "  select ACID,OP_ACID,CIF_ID,FORACID,ACCT_NAME,SCHM_CODE,CLR_BAL_AMT,DIS_AMT,DRWNG_POWER,SANCT_LIM,FLOW_ID,NUM_OF_FLOWS,FLOW_AMT,SHDL_NUM,DMD_AMOUNT,OPFORACID,OP_AVAILBAL,  "
sv_s = sv_s + "  OP_CYC,OP_FREEZE,OP_FZ_REN_CODE,OTHER_OP_AC,OTHER_OP_AC_AVBAL,OTHER_OP_AC_CYC,OTHER_OP_AC_FREZ_CODE,OTHER_OP_AC_FZ_REN_CODE  from ( select XX.*,(select foracid from tbaadm.gam   "
sv_s = sv_s + "  where bank_id='43' and gam.acid=xx.OP_ACID and rownum<2) OPFORACID,(select clr_bal_amt-lien_amt from tbaadm.gam where bank_id='43' and gam.acid=xx.OP_ACID) OP_AVAILBAL,  "
sv_s = sv_s + "  (select acct_crncy_code from tbaadm.gam where bank_id='43' and gam.acid=xx.OP_ACID) OP_CYC,(select FREZ_CODE from tbaadm.gam where bank_id='43' and gam.acid=xx.OP_ACID) OP_FREEZE, "
sv_s = sv_s + "  (select FREZ_REASON_CODE from tbaadm.gam where bank_id='43' and gam.acid=xx.OP_ACID) OP_FZ_REN_CODE,(select foracid from tbaadm.gam where bank_id='43' and gam.acid!=xx.OP_ACID  "
sv_s = sv_s + "  and gam.cif_id=xx.cif_id and clr_bal_amt-lien_amt>0  and schm_type in ('SBA','CAA') and schm_code in ('SB100','SB777','CA212','CA200','CA700','CA203','CA205','CA206','SB700','CA211','CA209','CA217','CA204','SB111','SB704','SB722','SB139','SB105','CA704','CA282','CA702','SB101','CA707','CA210','CA202','SB130','IA702','CA216','SB119','SB112','CA231','SB106','SB129','CA222','CA226','CA229','SB122','CA227') and acct_cls_flg='N' and rownum<2  ) OTHER_OP_AC,(select clr_bal_amt-lien_amt from tbaadm.gam where bank_id='43'  "
sv_s = sv_s + "  and gam.acid!=xx.OP_ACID and gam.cif_id=xx.cif_id and clr_bal_amt-lien_amt>0 and schm_type in ('SBA','CAA') and schm_code in ('SB100','SB777','CA212','CA200','CA700','CA203','CA205','CA206','SB700','CA211','CA209','CA217','CA204','SB111','SB704','SB722','SB139','SB105','CA704','CA282','CA702','SB101','CA707','CA210','CA202','SB130','IA702','CA216','SB119','SB112','CA231','SB106','SB129','CA222','CA226','CA229','SB122','CA227') and acct_cls_flg='N' and rownum<2  ) OTHER_OP_AC_AVBAL, "
sv_s = sv_s + "  (select acct_crncy_code from tbaadm.gam where bank_id='43' and gam.acid!=xx.OP_ACID and gam.cif_id=xx.cif_id and clr_bal_amt-lien_amt>0 and schm_type in ('SBA','CAA') and schm_code in ('SB100','SB777','CA212','CA200','CA700','CA203','CA205','CA206','SB700','CA211','CA209','CA217','CA204','SB111','SB704','SB722','SB139','SB105','CA704','CA282','CA702','SB101','CA707','CA210','CA202','SB130','IA702','CA216','SB119','SB112','CA231','SB106','SB129','CA222','CA226','CA229','SB122','CA227') and acct_cls_flg='N' and rownum<2  )  "
sv_s = sv_s + "  OTHER_OP_AC_CYC, (select FREZ_CODE from tbaadm.gam where bank_id='43' and gam.acid!=xx.OP_ACID and gam.cif_id=xx.cif_id and clr_bal_amt-lien_amt>0  "
sv_s = sv_s + "  and schm_type in ('SBA','CAA') and schm_code in ('SB100','SB777','CA212','CA200','CA700','CA203','CA205','CA206','SB700','CA211','CA209','CA217','CA204','SB111','SB704','SB722','SB139','SB105','CA704','CA282','CA702','SB101','CA707','CA210','CA202','SB130','IA702','CA216','SB119','SB112','CA231','SB106','SB129','CA222','CA226','CA229','SB122','CA227') and acct_cls_flg='N' and rownum<2  ) OTHER_OP_AC_FREZ_CODE, (select FREZ_REASON_CODE from tbaadm.gam where bank_id='43' and gam.acid!=xx.OP_ACID  "
sv_s = sv_s + "  and gam.cif_id=xx.cif_id and clr_bal_amt-lien_amt>0 and schm_type in ('SBA','CAA') and schm_code in ('SB100','SB777','CA212','CA200','CA700','CA203','CA205','CA206','SB700','CA211','CA209','CA217','CA204','SB111','SB704','SB722','SB139','SB105','CA704','CA282','CA702','SB101','CA707','CA210','CA202','SB130','IA702','CA216','SB119','SB112','CA231','SB106','SB129','CA222','CA226','CA229','SB122','CA227') and acct_cls_flg='N' and rownum<2  ) OTHER_OP_AC_FZ_REN_CODE  from (   "
sv_s = sv_s + "   select g.acid,l.op_acid,g.cif_id,g.foracid , acct_name, schm_code, CLR_BAL_aMT,DIS_AMT,DRWNG_POWER,SANCT_LIM, FLOW_ID,NUM_OF_FLOWS,FLOW_AMT,lrs.SHDL_NUM ,sum(DMD_AMT-TOT_ADJ_AMT) "
sv_s = sv_s + "    DMD_AMOUNT  from  tbaadm.gam g ,tbaadm.lam l,tbaadm.lrs,tbaadm.ldt,tbaadm.gac where  l.acid = g.acid and  lrs.acid = g.acid and l.bank_id = g.bank_id  "
sv_s = sv_s + "  and lrs.bank_id = g.bank_id and l.bank_id = ldt.bank_id and lrs.bank_id = ldt.bank_id and  lrs.acid = ldt.acid and  ldt.acid = g.acid and g.acct_cls_flg='N'  and gac.acid = g.acid and  lrs.acid = gac.acid "
sv_s = sv_s + "  and gac.bank_id = g.bank_id and lrs.bank_id = gac.bank_id and gac.bank_id = ldt.bank_id and g.bank_id='43' and g.schm_type='LAA' and lrs.FLOW_ID='EIDEM' and g.schm_code in ('LA710','LA711','LA734')   "
sv_s = sv_s + "  and ldt.DMD_FLOW_ID in ('PRDEM','INDEM') and DMD_AMT<>TOT_ADJ_AMT and l.op_acid in (select acid from tbaadm.gam where bank_id='43' and (clr_bal_amt-lien_amt)<=0 )   and (gac.CHRGE_OFF_FLG='N' OR  gac.CHRGE_OFF_FLG is null) "
sv_s = sv_s + "  group by g.acid,l.op_acid,g.cif_id,g.foracid , acct_name, schm_code, CLR_BAL_aMT,DIS_AMT,DRWNG_POWER,SANCT_LIM, FLOW_ID,NUM_OF_FLOWS,FLOW_AMT,lrs.SHDL_NUM) XX) where  OTHER_OP_AC is not null  "
PRINT(sv_s)

	sv_o = urhk_dbCursorOpenWithBind(sv_s)
	print(sv_o)

	print(BANCS.OUTPARAM.DB_CURSOR_NUMBER)
	MISS.CHRG.MainCursor = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	print(MISS.CHRG.MainCursor)

#--------------------------------------------------------------------------	
# Initialise the Local Variables 
#--------------------------------------------------------------------------

	#------------------------------------------------------------------
	#  Variable Initialisation for counter. It should be Zero
	#------------------------------------------------------------------
		sv_z = 0
        #------------------------------------------------------------------
        #  Variable Initialisation for credit amount to the bank income
	#  account. It should be Zero. 
        #------------------------------------------------------------------
		MISS.CHRG.done = "N"


#--------------------------------------------------------------------------
# Initialise the MTT repository
#--------------------------------------------------------------------------
	
	sv_u = urhk_MTTS_PopulateInputDetails("")
	print(sv_u)

	MTT.TranDetails.TranDate="0"
	MTT.TranDetails.TranType = "T"
	MTT.TranDetails.TranSubType = "BI"
	MTT.TranDetails.Remarks = "Batch 2Loan Repay"
	MTT.TranDetails.IgnoreExcp = "I"
	MTT.TranDetails.PSTUpdateFlg ="N"

	sv_v = "bCashWithCrg"
	print(sv_v)

	sv_u = urhk_MTTS_DefineTransaction("bCashWithCrg")

#--------------------------------------------------------------------------
# MTT code for creating tranxs like individual debit from customer and 
# consolidated credit to the income Account. 
#--------------------------------------------------------------------------

	while (sv_o == 0)
		sv_c = urhk_dbCursorFetch(MISS.CHRG.MainCursor)
		print(sv_c)
		IF (sv_c != 0) THEN
		#{ 
				sv_r = urhk_MTTS_EndDefinition("")
                                print(sv_r)


            		print(sv_c)
	    		sv_o = 1	

		#}
		ELSE 
		#{
			MISS.CHRG.acid = BANCS.OUTPARAM.acid
			print(MISS.CHRG.acid)
			MISS.CHRG.op_acid = BANCS.OUTPARAM.op_acid
			print(MISS.CHRG.op_acid)
			MISS.CHRG.cif_id = BANCS.OUTPARAM.cif_id
			print(MISS.CHRG.cif_id)
			MISS.CHRG.foracid = BANCS.OUTPARAM.foracid
			print(MISS.CHRG.foracid)
			MISS.CHRG.acct_name = BANCS.OUTPARAM.acct_name
			print(MISS.CHRG.acct_name)
			MISS.CHRG.schm_code = BANCS.OUTPARAM.schm_code
			print(MISS.CHRG.schm_code)
			MISS.CHRG.clr_bal_amt = BANCS.OUTPARAM.clr_bal_amt
			print(MISS.CHRG.clr_bal_amt)
			MISS.CHRG.dis_amt = BANCS.OUTPARAM.dis_amt
			print(MISS.CHRG.dis_amt)
			MISS.CHRG.drwng_power = BANCS.OUTPARAM.drwng_power
			print(MISS.CHRG.drwng_power)
			MISS.CHRG.sanct_lim = BANCS.OUTPARAM.sanct_lim
			print(MISS.CHRG.sanct_lim)
			MISS.CHRG.flow_id = BANCS.OUTPARAM.flow_id
			print(MISS.CHRG.flow_id)
			MISS.CHRG.num_of_flows = BANCS.OUTPARAM.num_of_flows
			print(MISS.CHRG.num_of_flows)
			MISS.CHRG.flow_amt = BANCS.OUTPARAM.flow_amt
			print(MISS.CHRG.flow_amt)
			MISS.CHRG.shdl_num = BANCS.OUTPARAM.shdl_num
			print(MISS.CHRG.shdl_num)
			MISS.CHRG.dmd_amount = BANCS.OUTPARAM.dmd_amount
			print(MISS.CHRG.dmd_amount)
			MISS.CHRG.opforacid = BANCS.OUTPARAM.opforacid
			print(MISS.CHRG.opforacid)
			MISS.CHRG.op_availbal = BANCS.OUTPARAM.op_availbal
			print(MISS.CHRG.op_availbal)
			MISS.CHRG.op_cyc = BANCS.OUTPARAM.op_cyc
			print(MISS.CHRG.op_cyc)
			MISS.CHRG.op_freeze = BANCS.OUTPARAM.op_freeze
			print(MISS.CHRG.op_freeze)
			MISS.CHRG.op_fz_ren_code = BANCS.OUTPARAM.op_fz_ren_code
			print(MISS.CHRG.op_fz_ren_code)
			MISS.CHRG.other_op_ac = BANCS.OUTPARAM.other_op_ac
			print(MISS.CHRG.other_op_ac)
			MISS.CHRG.other_op_ac_avbal = BANCS.OUTPARAM.other_op_ac_avbal
			print(MISS.CHRG.other_op_ac_avbal)
			MISS.CHRG.other_op_ac_cyc = BANCS.OUTPARAM.other_op_ac_cyc
			print(MISS.CHRG.other_op_ac_cyc)
			MISS.CHRG.other_op_ac_frez_code = BANCS.OUTPARAM.other_op_ac_frez_code
			print(MISS.CHRG.other_op_ac_frez_code)
			MISS.CHRG.other_op_ac_fz_ren_code = BANCS.OUTPARAM.other_op_ac_fz_ren_code
			print(MISS.CHRG.other_op_ac_fz_ren_code)
			
			MISS.CHRG.stamp = "Y"

		

			#------------------------------------------
                        # counter setting for defining different PartTran
                        #------------------------------------------
                        	sv_z = sv_z + 1
                                MISS.CHRG.Counter = sv_z

			#--------------------------------------------------------------------------
			# Create the narration
			#--------------------------------------------------------------------------

			
			sv_m = "Remboursement de pret:"
			print(sv_m)
			sv_y = MISS.CHRG.foracid
			sv_x = " "
			sv_k = MISS.CHRG.acct_name
			print(sv_k)

			sv_w = sv_m + sv_y + sv_x + sv_k
			print(sv_w)

			MISS.CHRG.narr1 = sv_w
			print(MISS.CHRG.narr1)



			MISS.CHRG.wtax_amt = ""
			print(MISS.CHRG.wtax_amt)
				

			#--------------------------------------------------
        		# Withholding Tax Account
        		#--------------------------------------------------

        		IF (MISS.CHRG.stamp == "Y") THEN

                		MTT.PartTranDetails.Account = MISS.CHRG.opforacid
				print(MTT.PartTranDetails.Account)
				MTT.PartTranDetails.RefCurrency = MISS.CHRG.other_op_ac_cyc
				IF (MISS.CHRG.other_op_ac_cyc!=BANCS.STDIN.homeCrncyCode) THEN
					MTT.PartTranDetails.RateCode = "TTB"
					MTT.PartTranDetails.Rate = ""
				ENDIF
                		MTT.PartTranDetails.ValueDateDiff = "0"
                		MTT.PartTranDetails.Particulars = MISS.CHRG.narr1  
                		MTT.PartTranDetails.RefAmount = cdouble(MISS.CHRG.other_op_ac_avbal)
                		print(MTT.PartTranDetails.RefAmount)
                		MTT.PartTranDetails.Remarks = MISS.CHRG.other_op_ac
                		MTT.PartTranDetails.RefNum = MISS.CHRG.foracid
                		MTT.PartTranDetails.IgnoreExcp = "I"
                		MTT.PartTranDetails.Consolidate = "N"
                		MTT.PartTranDetails.TranIdentifier = sv_v
				print(MISS.CHRG.Counter)
                		sv_e = "Credt" + MISS.CHRG.Counter
				print(sv_e)
                		sv_r = urhk_MTTS_definePartTran(sv_e)
                		print(sv_r)

        		ENDIF


			#------------------------------------------------------------------
        		# Customer Debit Partran
        		#------------------------------------------------------------------

               			MTT.PartTranDetails.Account = MISS.CHRG.other_op_ac
				MTT.PartTranDetails.RefCurrency = MISS.CHRG.other_op_ac_cyc
				IF (MISS.CHRG.other_op_ac_cyc!=BANCS.STDIN.homeCrncyCode) THEN
					MTT.PartTranDetails.RateCode = "TTB"
					MTT.PartTranDetails.Rate = ""
				ENDIF
                		MTT.PartTranDetails.ValueDateDiff = "0"
                		MTT.PartTranDetails.Particulars = MISS.CHRG.narr1
                		sv_a = cdouble(MISS.CHRG.other_op_ac_avbal)
				print(sv_a)
				sv_a = -(sv_a)
				print(sv_a)
                		MTT.PartTranDetails.RefAmount = sv_a
                		print(MTT.PartTranDetails.RefAmount)
                		MTT.PartTranDetails.Remarks = MISS.CHRG.opforacid
                		MTT.PartTranDetails.RefNum = MISS.CHRG.foracid
                		MTT.PartTranDetails.IgnoreExcp = "I"
                		MTT.PartTranDetails.Consolidate = "N"
                		MTT.PartTranDetails.TranIdentifier = sv_v
				print(MISS.CHRG.Counter)
                		sv_h = "Debit" + MISS.CHRG.Counter
				print(sv_h)
                		sv_u = urhk_MTTS_definePartTran(sv_h)
				print(sv_u)

		#}
			#######

			sv_r = urhk_MTTS_EndDefinition("")
			print(sv_r)

			MISS.CHRG.tranid = BANCS.OUTPARAM.MTTTranId
			print(MISS.CHRG.tranid)

			print(BANCS.STDIN.userId)

			print(BANCS.STDIN.sysDate)

			print(BANCS.STDIN.BODDate)

			sv_g = mid$(BANCS.STDIN.sysDate,0,10) 
			print(sv_g)
			sv_h = mid$(BANCS.STDIN.BODDate,0,10)
			print(sv_h)

			########
		ENDIF
	DO

	sv_c = urhk_dbCursorClose(MISS.CHRG.MainCursor) 

