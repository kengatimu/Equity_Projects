<--start
######################################################################
# MTT script to upload Finacle Treasury Transactions in Finacle Core #
# This mtt script can be run with help of babx4071                   #
#                                                                    #
######################################################################
#trace on


#-----------------------------------
# Creating the custom repository 
#-----------------------------------

IF(REPEXISTS("CUST") == 0 ) THEN
#{
    CREATEREP("CUST")
#}
ENDIF

IF (CLASSEXISTS("CUST","FINTR") == 0) THEN
#{
    CREATECLASS("CUST","FINTR",5)
#}
ENDIF

IF(REPEXISTS("B2KTEMP") == 0 ) THEN
#{
    CREATEREP("B2KTEMP")
#}
ENDIF

IF (CLASSEXISTS("B2KTEMP","TEMPSTD") == 0) THEN
#{
    CREATECLASS("B2KTEMP","TEMPSTD",5)
#}
ENDIF

IF(REPEXISTS("MTT") == 0 ) THEN
#{
    CREATEREP("MTT")
#}
ENDIF

IF (CLASSEXISTS("MTT","TranDetails") == 0) THEN
#{
    CREATECLASS("MTT","TranDetails",5)
#}
ENDIF

IF(REPEXISTS("MTT") == 0 ) THEN
#{
    CREATEREP("MTT")
#}
ENDIF

IF (CLASSEXISTS("MTT","PartTranDetails") == 0) THEN
#{
    CREATECLASS("MTT","PartTranDetails",5)
#}
ENDIF

MTT.TranDetails.TranDate="0"
MTT.TranDetails.TranType="T"
MTT.TranDetails.TranSubType="BI"
MTT.TranDetails.IgnoreExcp = "I"
MTT.PartTranDetails.IgnoreExcp = "I"
BANCS.INPUT.whereClause="upload_type in ('SYS','USR','FTSYS','FTUSER','FTUSR') "
B2KTEMP.TEMPSTD.NewTransaction = "Y"
B2KTEMP.TEMPSTD.contraBacid=""
CUST.FINTR.errMsg=""

#----------------------------------------------------------------------
# Fetching he gl sub head code values from CPARAM.
#----------------------------------------------------------------------

BANCS.INPUT.moduleName  = "FINACLETREASURY"
BANCS.INPUT.parameterId = "GLSUBHEADCODE_1"
	
CALL ("getcparamvalue.scr")
	
IF(BANCS.OUTPUT.parameterVal != "")THEN
#{
	CUST.FINTR.glSubHeadCode1 = BANCS.OUTPUT.parameterVal
#}
ELSE
#{
	CUST.FINTR.errMsg = "Gl Sub head code setup not done CPARAM"
	GOTO ENDOFSCRIPT
#}
ENDIF

