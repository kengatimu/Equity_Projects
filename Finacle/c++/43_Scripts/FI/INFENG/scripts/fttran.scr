BANCS.INPUT.moduleName  = "FINACLETREASURY"
BANCS.INPUT.parameterId = "CRNCYCODEFTT"

CALL ("getcparamvalue.scr")

IF(BANCS.OUTPUT.parameterVal != "")THEN
#{
        CUST.FINTR.crncyCode = BANCS.OUTPUT.parameterVal
#}
ELSE
#{
        CUST.FINTR.errMsg = "Value Date setup not done CPARAM"
        GOTO ENDOFSCRIPT
#}
ENDIF

####Added to exempt syndication FX transaction  ---ADDED by MARK NDERITU

BANCS.INPUT.moduleName  = "FINACLETREASURY"
BANCS.INPUT.parameterId = "ACCT_TO_ALLOW"

CALL ("getcparamvalue.scr")

IF(BANCS.OUTPUT.parameterVal != "")THEN
#{
        CUST.FINTR.ACCT_TO_ALLOW = BANCS.OUTPUT.parameterVal
#}
ELSE
#{
        CUST.FINTR.errMsg = "Value Date setup not done CPARAM"
        GOTO ENDOFSCRIPT
#}
ENDIF
####Added to exempt syndication FX transaction  ---ADDED by MARK NDERITU

sv_s = " contraBacid "
sv_s = sv_s + " | "
sv_s = sv_s + " SELECT external_sol_contra_bacid "
sv_s = sv_s + " FROM GCT "
sv_s = sv_s + " WHERE ROWNUM = 1"
sv_s = sv_s + " AND BANK_ID = ?SVAR "
BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
sv_d = urhk_dbSelectWithbind(sv_s)
if (sv_d == 0) then
	B2KTEMP.TEMPSTD.contraBacid = BANCS.OUTPARAM.contraBacid
endif

print (B2KTEMP.TEMPSTD.contraBacid)

if( B2KTEMP.TEMPSTD.contraBacid == "" ) then
	BANCS.OUTPUT.fatalErrorFlg="Y"
	BANCS.OUTPUT.fatalErrorMsg="External Sol ContraPlaceholder not setup in SCFM"
	exitscript
endif

# use sv_u only for storing return value of MTTS_PopulateInputDetails
sv_u = urhk_MTTS_PopulateInputDetails("")
while(sv_u == 0)
	#-----------------------------
	# Populate Transaction details
	#-----------------------------
	if (B2KTEMP.TEMPSTD.NewTransaction == "Y") then
		MTT.TranDetails.TranDate="0"
		MTT.TranDetails.TranType="T"
		MTT.TranDetails.TranSubType="BI"
		MTT.TranDetails.Consolidate = "Y"
		MTT.TranDetails.ReversalFlg = "N"
		MTT.TranDetails.ReversalDate="0"
		MTT.TranDetails.Remarks="FT Journal Ref" + "-" + MTT.InputDetails.UploadRefNo

		sv_u = urhk_MTTS_DefineTransaction("FTTR")
		if(0 != sv_u)then
			BANCS.OUTPUT.fatalErrorFlg="Y"
			BANCS.OUTPUT.fatalErrorMsg="urhk_MTTS_DefineTransaction failed"
			exitscript
		endif

		B2KTEMP.TEMPSTD.NewTransaction = "N"
	endif

	sv_p = ""
	sv_a = MTT.InputDetails.InputAccount
	if (MTT.InputDetails.Account == "") then
		if (MTT.InputDetails.InputAccount == "") then
			sv_p = "Account not mapped in FT "
		else
			sv_p = "Invalid Account mapped in FT " + MTT.InputDetails.InputAccount
		endif
	else
		#sv_a = BANCS.OUTPARAM.AcctId
	print(sv_a)
    	sv_u = urhk_getAcctDetailsInRepository(sv_a)
    	if (sv_u ==1) then
       		exitscript
        endif
		sv_z = BANCS.OUTPARAM.glSubHeadCode 
		print(sv_z)
		if ((sv_z == CUST.FINTR.glSubHeadCode1 ) or (sv_z == CUST.FINTR.glSubHeadCode2) or (sv_z == CUST.FINTR.glSubHeadCode3) or (sv_z == CUST.FINTR.glSubHeadCode4) or (sv_z == CUST.FINTR.glSubHeadCode5) or (sv_z == CUST.FINTR.glSubHeadCode6) or (sv_z ==CUST.FINTR.glSubHeadCode7) or (sv_z ==CUST.FINTR.glSubHeadCode12) or (sv_z == CUST.FINTR.glSubHeadCode14 ) or (sv_z == CUST.FINTR.glSubHeadCode15 ) or (sv_z == CUST.FINTR.glSubHeadCode16 ) or (sv_z == CUST.FINTR.glSubHeadCode17 ) or (sv_z == CUST.FINTR.glSubHeadCode18 ) or (sv_z == CUST.FINTR.glSubHeadCode20 ) or (sv_z == CUST.FINTR.glSubHeadCode19 ) or (sv_z ==CUST.FINTR.glSubHeadCode11) or (sv_z ==CUST.FINTR.glSubHeadCode10) or (sv_z ==CUST.FINTR.glSubHeadCode9) or (sv_z ==CUST.FINTR.glSubHeadCode8) or (sv_z ==CUST.FINTR.glSubHeadCode13)) then
			print (MTT.InputDetails.TranCurrency)
			print (MTT.InputDetails.RefCurrency)
			MTT.InputDetails.TranCurrency = MTT.InputDetails.RefCurrency
			print (MTT.InputDetails.TranCurrency)
			print (MTT.InputDetails.RefCurrency)
		endif
		# Account must be in amount currency
		#if (MTT.InputDetails.TranCurrency != MTT.InputDetails.RefCurrency) then
		if ((MTT.InputDetails.TranCurrency != MTT.InputDetails.RefCurrency) and(sv_a !=CUST.FINTR.ACCT_TO_ALLOW))then
			MTT.InputDetails.Account = ""
			sv_p = "Account mapped in different ccy " + MTT.InputDetails.InputAccount
		endif
        #endif
	 	# Account must be in amount currency
		#if (MTT.InputDetails.TranCurrency != MTT.InputDetails.RefCurrency) then
		#	MTT.InputDetails.Account = ""
		#   sv_p = "Account mapped in different ccy " + MTT.InputDetails.InputAccount
		#endif
        # Account must belong to my sol
		#if (MTT.InputDetails.AccountSol != BANCS.STDIN.mySolId) then
		#	MTT.InputDetails.Account = ""
		#   sv_p = "Account mapped to other sol " + MTT.InputDetails.InputAccount
		#endif
	endif

	if (sv_p != "") then
		MTT.Error.Description = sv_p + " Posting to suspense account"
		sv_r=urhk_MTTS_ReportErrorCondition("")
		# but continue to post to suspense account
	endif

	MTT.PartTranDetails.Account=""

	if (MTT.InputDetails.Account == "") then
		#sv_s = "TRSUSPENSE|"
		sv_a = "TREASURY|"
		sv_a = sv_a + MTT.InputDetails.RefCurrency + "|"
		sv_a = sv_a + BANCS.STDIN.mySolId
		sv_u = urhk_B2k_BacidToAcctId(sv_a)
		if(sv_u != 0 ) then
			MTT.Error.Description = "TREASURY account not available for ccy " + MTT.InputDetails.RefCurrency
			sv_r=urhk_MTTS_ReportErrorCondition("")
			GOTO NextRecord
		endif
		MTT.PartTranDetails.Account=BANCS.OUTPARAM.AcctId
	else
   		MTT.PartTranDetails.Account=MTT.InputDetails.Account
	endif

	sv_a = B2KTEMP.TEMPSTD.contraBacid + "|"
	sv_a = sv_a + MTT.InputDetails.RefCurrency + "|"
	sv_a = sv_a + BANCS.STDIN.mySolId
	print(sv_a)
	sv_u = urhk_B2k_BacidToAcctId(sv_a)
	if(sv_u != 0 ) then
		MTT.Error.Description = "Contra account not available " + MTT.InputDetails.RefCurrency + "-" + B2KTEMP.TEMPSTD.contraBacid
		sv_r=urhk_MTTS_ReportErrorCondition("")
		GOTO NextRecord
	endif


#------------------Code added here
                
	sv_a = BANCS.OUTPARAM.AcctId
	sv_u = urhk_getAcctDetailsInRepository(sv_a)
	if (sv_u ==1) then
	   exitscript
    endif
	sv_m = BANCS.OUTPARAM.glSubHeadCode
	sv_n = BANCS.OUTPARAM.acctCrncyCode

	print (sv_m)
	print (sv_n)
    print ("gl sub head code is")
    print (sv_m)
                
	if ((sv_m == CUST.FINTR.glSubHeadCode1 ) or (sv_m == CUST.FINTR.glSubHeadCode2) or (sv_m == CUST.FINTR.glSubHeadCode3) or (sv_m == CUST.FINTR.glSubHeadCode4) or (sv_m == CUST.FINTR.glSubHeadCode5) or (sv_m == CUST.FINTR.glSubHeadCode6) or (sv_m ==CUST.FINTR.glSubHeadCode7) or (sv_m ==CUST.FINTR.glSubHeadCode12) or (sv_m == CUST.FINTR.glSubHeadCode20) or (sv_m == CUST.FINTR.glSubHeadCode19) or (sv_m == CUST.FINTR.glSubHeadCode18) or (sv_m == CUST.FINTR.glSubHeadCode17) or (sv_m == CUST.FINTR.glSubHeadCode16) or (sv_m == CUST.FINTR.glSubHeadCode15) or (sv_m == CUST.FINTR.glSubHeadCode14) or (sv_m ==CUST.FINTR.glSubHeadCode11) or (sv_m ==CUST.FINTR.glSubHeadCode10) or (sv_m ==CUST.FINTR.glSubHeadCode9)  or (sv_m ==CUST.FINTR.glSubHeadCode8) or (sv_m ==CUST.FINTR.glSubHeadCode13)) then
   		if (sv_n != CUST.FINTR.crncyCode) then
	   		sv_e =  LEFT$(sv_a,8)
			sv_f = RIGHT$(sv_a,2)
	   		sv_g = "00"
	   		sv_h = sv_e + sv_g + sv_f
	   		MTT.InputDetails.ContraAccount = sv_h
	  		MTT.PartTranDetails.RefCurrency=MTT.InputDetails.TranCurrency   
	   		MTT.PartTranDetails.RateCode ="NOR"                                                          

   		endif
	else
	   	MTT.InputDetails.ContraAccount = sv_a
	   	MTT.PartTranDetails.RefCurrency=MTT.InputDetails.RefCurrency                                            
	  	# MTT.PartTranDetails.RateCode = MTT.InputDetails.RateCode   
		MTT.PartTranDetails.RateCode = "NOR"      
	endif
     
	#---------------------------
	#MTT.InputDetails.ContraAccount=BANCS.OUTPARAM.AcctId
	MTT.PartTranDetails.RefAmount=MTT.InputDetails.RefAmount
	#MTT.PartTranDetails.RefCurrency=MTT.InputDetails.RefCurrency
	MTT.PartTranDetails.Particulars=MTT.InputDetails.Particulars
	MTT.PartTranDetails.ValueDate=MTT.InputDetails.ValueDate
	#MTT.PartTranDetails.RateCode = MTT.InputDetails.RateCode
	#MTT.PartTranDetails.Rate = "0"
	MTT.PartTranDetails.Rate =BANCS.OUTPARAM.notionalRate
	print(BANCS.OUTPARAM.notionalRate)                
	MTT.PartTranDetails.Consolidate="N"
	MTT.PartTranDetails.Remarks=MTT.InputDetails.UploadSrlNum
	MTT.PartTranDetails.TranIdentifier="FTTR"
	MTT.PartTranDetails.RefInputKey=MTT.InputDetails.RefInputKey
	MTT.PartTranDetails.PTranBusinessType="FT"
	sv_r = urhk_MTTS_DefinePartTran("Main")

                
                
	MTT.PartTranDetails.Account=MTT.InputDetails.ContraAccount
	print(MTT.PartTranDetails.Account)
	MTT.PartTranDetails.RefAmount=-1*CDOUBLE(MTT.InputDetails.RefAmount)
	MTT.PartTranDetails.RefCurrency=MTT.InputDetails.RefCurrency
	MTT.PartTranDetails.ValueDate=MTT.InputDetails.ValueDate
	MTT.PartTranDetails.RateCode =""
	#MTT.PartTranDetails.RateCode = MTT.InputDetails.RateCode    
	MTT.PartTranDetails.Rate = "0"
	#MTT.PartTranDetails.Rate =BANCS.OUTPARAM.notionalRate
	#print(BANCS.OUTPARAM.notionalRate)         
	MTT.PartTranDetails.Consolidate="Y"
	MTT.PartTranDetails.RefInputKey=""
	MTT.PartTranDetails.PTranBusinessType=""
	MTT.PartTranDetails.Particulars="FT Contra"
	MTT.PartTranDetails.Remarks=""
	MTT.PartTranDetails.TranIdentifier="FTTR"
	sv_p = "Contra-" + MTT.InputDetails.RefCurrency
	sv_r = urhk_MTTS_DefinePartTran(sv_p)
	print(sv_r)
	sv_r = urhk_MTTS_EndDefinition("")

NextRecord:
	B2KTEMP.TEMPSTD.PrevUploadRefNo = MTT.InputDetails.UploadRefNo
	B2KTEMP.TEMPSTD.PrevUploadType  = MTT.InputDetails.UploadType

	# use sv_m only for storing return value of MTTS_PopulateInputDetails
	sv_u = urhk_MTTS_PopulateInputDetails("")
	if (sv_u == 0) then
		if (B2KTEMP.TEMPSTD.PrevUploadType != MTT.InputDetails.UploadType) then
			B2KTEMP.TEMPSTD.NewTransaction = "Y"
		endif

		if (B2KTEMP.TEMPSTD.PrevUploadRefNo != MTT.InputDetails.UploadRefNo) then
			B2KTEMP.TEMPSTD.NewTransaction = "Y"
		endif
	else
		B2KTEMP.TEMPSTD.NewTransaction = "Y"
	endif

do

BANCS.OUTPUT.mrtName="fttran.mrt"
BANCS.OUTPUT.ReportTitle="Treasury Transaction Upload"

ENDOFSCRIPT:
	IF(CUST.FINTR.errMsg != "") THEN
	 #{
		sv_s = "echo '" + CUST.FINTR.errMsg + "' > error.log" 
		sv_a = SYSTEM(sv_s)
		print(sv_a)
	#}
	ENDIF
	
exitscript

end-->
