				### reverse calculating the interest demand amount
				
				BANCS.INPARAM.InputAmount = CUST.VAT.totalIndSatLcy
				BANCS.INPARAM.FromCurrency = BANCS.STDIN.homeCrncyCode
				BANCS.INPARAM.ToCurrency = CUST.VAT.acctCrncyCode
				BANCS.INPARAM.RateCode = CUST.VAT.rateCode
				BANCS.INPARAM.Rate=0
