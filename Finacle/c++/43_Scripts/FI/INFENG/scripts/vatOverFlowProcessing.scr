			# ---------------------------------------------------------------------
			# Commit the transaction
			# ---------------------------------------------------------------------
			sv_r = urhk_MTTS_EndDefinition("")
			IF (sv_r != 0) THEN
			#{
				sv_c = "Unable to end the transaction definition.."
				PRINT(sv_c)
				MTT.Error.Description = sv_c
				sv_r = urhk_MTTS_ReportErrorCondition("")
				#}
			ELSE
				#{
				PRINT("successfully posted")
				
				IF (FIELDEXISTS(BANCS.OUTPARAM.MTTTranId)) THEN
				#{
					
					PRINT(BANCS.OUTPARAM.MTTTranId)
					CUST.VAT.tranId = BANCS.OUTPARAM.MTTTranId
					PRINT(CUST.VAT.tranId)
				#}
				ENDIF
				
			#}
			ENDIF
			
			CALL("vatTableUpdateBatch.scr")
			
			
			OFLOWCHK:
				
				####################### Getting next int demand date ###########################
				
				sv_k = "lrsCount|SELECT COUNT(1) FROM TBAADM.LRS  "
				sv_k = sv_k + " WHERE ACID = ?SVAR "
				sv_k = sv_k + " AND BANK_ID = ?SVAR "
				sv_k = sv_k + " AND DEL_FLG = 'N'"
				sv_k = sv_k + " AND NEXT_INT_DMD_DATE IS NOT NULL"
				
				
				PRINT(sv_k)
				
				BANCS.INPARAM.BINDVARS =  CUST.VAT.acid + "|" + BANCS.STDIN.contextBankId
				
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_k = urhk_dbSelectWithBind(sv_k)
				PRINT(sv_k)
				
				IF(sv_k == 0)THEN
				#{
					CUST.VAT.lrsCount = BANCS.OUTPARAM.lrsCount
					PRINT(CUST.VAT.lrsCount)
					
				#}
				ENDIF
				
				
				IF(CUST.VAT.lrsCount > 0)THEN
				#{
					
					
					sv_k = "nextIntDmdDate|SELECT MIN( to_char(NEXT_INT_DMD_DATE, 'DD-MM-YYYY HH24:MI:SS')) FROM TBAADM.LRS  "
					sv_k = sv_k + " WHERE ACID = ?SVAR "
					sv_k = sv_k + " AND BANK_ID = ?SVAR "
					sv_k = sv_k + " AND DEL_FLG = 'N'"
					sv_k = sv_k + " AND NEXT_INT_DMD_DATE IS NOT NULL"
					
					PRINT(sv_k)
					
					BANCS.INPARAM.BINDVARS =  CUST.VAT.acid + "|" + BANCS.STDIN.contextBankId
					
					PRINT(BANCS.INPARAM.BINDVARS)
					sv_k = urhk_dbSelectWithBind(sv_k)
					PRINT(sv_k)
					PRINT(BANCS.OUTPARAM.nextIntDmdDate)
					IF(sv_k == 0)THEN
					#{
						CUST.VAT.nextIntDmdDate = BANCS.OUTPARAM.nextIntDmdDate
						PRINT(CUST.VAT.nextIntDmdDate)
						
					#}
					ENDIF
					#}
				ELSE
					#{
					CUST.VAT.nextIntDmdDate = MID$(BANCS.STDIN.BODDate,0,10)
					PRINT(CUST.VAT.nextIntDmdDate)
					
				#}
				ENDIF
				####################### end of getting next int demand date ###########################
				
				###################### updating LAST_RUN_DATE in C_OFLOW_VAT_TBL ######################
				
				sv_s = "recCount | select count(*) from custom.C_OFLOW_VAT_TBL where foracid = ?SVAR AND bank_id =?SVAR "
				
				BANCS.INPARAM.BINDVARS = ""
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.VAT.foracid + "|"
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
				sv_d = urhk_dbSelectWithBind(sv_s)
				PRINT(sv_d)
				CUST.VAT.recCount = BANCS.OUTPARAM.recCount
				PRINT(CUST.VAT.recCount)
				
				IF(CUST.VAT.recCount > 0) THEN
				#{
					sv_s = "UPDATE custom.C_OFLOW_VAT_TBL SET "
					sv_s = sv_s + " LAST_RUN_DATE = to_date(?SVAR,'DD-MM-YYYY HH24:MI:SS'), "
					sv_s = sv_s + " NEXT_INT_DMD_DATE = to_date(?SVAR,'DD-MM-YYYY HH24:MI:SS') "
					sv_s = sv_s + " WHERE FORACID = ?SVAR "
					sv_s = sv_s + " AND BANK_ID = ?SVAR "
					
					PRINT(sv_s)
					BANCS.INPARAM.BINDVARS = ""
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.BODDate + "|"
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.VAT.nextIntDmdDate + "|"
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.VAT.foracid + "|"
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
					
					PRINT(BANCS.INPARAM.BINDVARS)
					PRINT(sv_s)
					sv_d = urhk_dbSQLWithBind(sv_s)
					PRINT(sv_d)
				#}
				ENDIF
				
				###################### end of LAST_RUN_DATE in C_OFLOW_VAT_TBL   ######################
				
				#=====Checking the OFLOW amount in LAM table=====#
				
				#Fecthing Overflow Amount for the account############
				
				sv_k = " overFlowAmt|SELECT LAM.OFLOW_AMT FROM TBAADM.LAM  "
				sv_k = sv_k + " WHERE  ACID = ?SVAR "
				sv_k = sv_k + " AND BANK_ID = ?SVAR "
				sv_k = sv_k + " AND LAM.OFLOW_AMT > 0"
				sv_k = sv_k + " AND DEL_FLG = 'N'"
				
				
				
				PRINT(sv_k)
				
				
				BANCS.INPARAM.BINDVARS =  CUST.VAT.acid + "|" + BANCS.STDIN.contextBankId
				
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_k = urhk_dbSelectWithBind(sv_k)
				PRINT(sv_k)
				
				IF(sv_k == 0)THEN
				#{
					CUST.VAT.overFlowAmt = BANCS.OUTPARAM.overFlowAmt
					PRINT(CUST.VAT.overFlowAmt)
					
					
					#}
				ELSE
					#{
					CUST.VAT.overFlowAmt = 0
				#}
				ENDIF
				
				
			OFLOWEND:
				IF(CUST.VAT.overFlowAmt == 0)THEN
				#{
					#===Inserting into Hist table.
					
					sv_k = "INSERT INTO CUSTOM.C_OFLOW_VAT_HIST_TBL "
					sv_k = sv_k + "SELECT * FROM CUSTOM.C_OFLOW_VAT_TBL "
					sv_k = sv_k + " WHERE  ACID = ?SVAR "
					sv_k = sv_k + " AND BANK_ID = ?SVAR "
					
					BANCS.INPARAM.BINDVARS =  CUST.VAT.acid + "|" + BANCS.STDIN.contextBankId
					
					
					PRINT(BANCS.INPARAM.BINDVARS)
					PRINT(sv_k)
					sv_d = urhk_dbSQLWithBind(sv_k)
					
					PRINT(sv_d)
					
					IF(sv_d ==0)THEN
					#{
						###deleting from main table
						sv_k = "Delete FROM CUSTOM.C_OFLOW_VAT_TBL "
						sv_k = sv_k + " WHERE  ACID = ?SVAR "
						sv_k = sv_k + " AND BANK_ID = ?SVAR "
						
						BANCS.INPARAM.BINDVARS =  CUST.VAT.acid + "|" + BANCS.STDIN.contextBankId
						
						
						PRINT(BANCS.INPARAM.BINDVARS)
						PRINT(sv_k)
						sv_d = urhk_dbSQLWithBind(sv_k)
						
						PRINT(sv_d)
					#}
					ENDIF
				#}
				ENDIF
				
				############################################### end of comparison ###############################################
			#}
			ENDIF
			
			sv_c = urhk_dbCursorFetch(sv_m)
			PRINT(sv_c)
		#}
		DO
		
		sv_c = urhk_dbCursorClose(sv_m)
		PRINT(sv_c)
		
		
		
		
	ENDOFSCRIPT:
		EXITSCRIPT
		
		
END-->
