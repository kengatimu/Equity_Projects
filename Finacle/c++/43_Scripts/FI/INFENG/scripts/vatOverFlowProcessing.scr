			MTT.TranDetails.ErrorCheckForLuw =   	"N"
			MTT.TranDetails.ModuleId              =	"HTM"
			MTT.TranDetails.Remarks                 = "Loan Recovery VAT"
			
			#***************************************************************************
			#Define the transaction
			#***************************************************************************
			PRINT("before define")
			sv_r = urhk_MTTS_DefineTransaction("Tax_Tran")
			PRINT(sv_r)
			IF (sv_r != 0) THEN
			#{
				sv_c = "Unable to Define the Transaction.."
				PRINT(sv_c)
				MTT.Error.Description = sv_c
