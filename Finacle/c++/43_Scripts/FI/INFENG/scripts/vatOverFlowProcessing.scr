					PRINT(CUST.VAT.tranDate)
					
					#}
				ELSE
					#{
					
					CUST.VAT.rate = 0
					PRINT(CUST.VAT.rate)
					
					CUST.VAT.tranDate = CUST.VAT.lastAdjDate
					PRINT(CUST.VAT.tranDate)
				#}
				ENDIF
				
				sv_k = " rateCode|SELECT rate_code FROM custom.C_LOAN_VAT_TRAN_TBL "
				sv_k = sv_k + " where TRAN_DATE =  ?SVAR "
				sv_k = sv_k + " AND ACID = ?SVAR "
				sv_k = sv_k + " AND BANK_ID = ?SVAR "
				sv_k = sv_k + " AND rownum<2 "
				PRINT(sv_k)
				
				BANCS.INPARAM.BINDVARS =  CUST.VAT.lastAdjDate + "|" + CUST.VAT.acid + "|" + BANCS.STDIN.contextBankId
				
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_k = urhk_dbSelectWithBind(sv_k)
				PRINT(sv_k)
				
				IF(sv_k == 0)THEN
				#{
					CUST.VAT.rateCode = BANCS.OUTPARAM.rateCode
					PRINT(CUST.VAT.rateCode)
					
					#}
				ELSE
					#{
					
					sv_k = " rateCode|SELECT repay_rate_code FROM tbaadm.gct "
					sv_k = sv_k + " where BANK_ID = ?SVAR "
					PRINT(sv_k)
					
					BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId
					
					PRINT(BANCS.INPARAM.BINDVARS)
					sv_k = urhk_dbSelectWithBind(sv_k)
					PRINT(sv_k)
					
					IF(sv_k == 0)THEN
					#{
						CUST.VAT.rateCode = BANCS.OUTPARAM.rateCode
						PRINT(CUST.VAT.rateCode)
					#}
					ENDIF
				#}
				ENDIF
				
				#==================Calculate the VAT amount based on total Adjustment amount
				
				
				#CUST.VAT.vatAmount1 = (CDOUBLE(CUST.VAT.totalAdjAmt)*CDOUBLE(CUST.VAT.overFlowPcnt)*CDOUBLE(CUST.VAT.rate))/100
				
				CUST.VAT.vatAmount1 = (CDOUBLE(CUST.VAT.totalAdjAmt)*CDOUBLE(CUST.VAT.overFlowPcnt))/100
				
				
				BANCS.INPARAM.InputAmount = CUST.VAT.vatAmount1
				BANCS.INPARAM.FromCurrency = CUST.VAT.acctCrncyCode
				BANCS.INPARAM.ToCurrency = BANCS.STDIN.homeCrncyCode
				BANCS.INPARAM.RateCode = CUST.VAT.rateCode
				BANCS.INPARAM.Rate= CUST.VAT.rate
				sv_r = urhk_B2k_ConvertAmount("")
				CUST.VAT.vatAmount1 =CDOUBLE(BANCS.OUTPARAM.OutputAmount)
				PRINT(CUST.VAT.vatAmount1)
				
				CUST.VAT.vatAmount = CDOUBLE(CUST.VAT.vatAmount) + CDOUBLE(CUST.VAT.vatAmount1)
				PRINT(CUST.VAT.vatAmount)
				
				sv_d = urhk_dbCursorFetch(sv_o)
				PRINT(sv_d)
			#}
			DO
			
			sv_d = urhk_dbCursorClose(sv_o)
			PRINT(sv_d)
			
			CUST.VAT.vatAmountPIDEM = CDOUBLE(CUST.VAT.vatAmount)
			PRINT(CUST.VAT.vatAmountPIDEM)
			###################### FOR PIDEM ##################
			
			
			###################### FOR INDEM from CUSTOM TABLE ##################
			CUST.VAT.vatAmount = 0
			CUST.VAT.vatAmount1 = 0
			CUST.VAT.vatAmountCINDEM = 0
			
			sv_l = " totalAdjAmt1,lastAdjDate|"
			sv_l = sv_l + " select tran_amt,tran_date from tbaadm.dctd_acli where (tran_id,tran_date) in ("
			sv_l = sv_l + " select vat_tran_id,tran_date from custom.C_LOAN_VAT_TRAN_TBL  where acid =?SVAR"
			sv_l = sv_l + " AND tran_date>=(select nvl((select min(tran_date) from tbaadm.ltd where acid =?SVAR"
			sv_l = sv_l + " AND flow_id='COLN'"
			sv_l = sv_l + " AND entity_cre_Flg='Y'"
			sv_l = sv_l + " AND del_flg='N'"
			sv_l = sv_l + " AND reversal_flg='N'"
			sv_l = sv_l + " AND reversed_flg='N'"
			sv_l = sv_l + " AND flow_amt>principal_amt+interest_amt"
			sv_l = sv_l + " AND ORIGIN_OF_TRAN!='POFF'"
			sv_l = sv_l + " AND bank_id=?SVAR),(select acct_opn_date from tbaadm.gam where acid=?SVAR AND bank_id=?SVAR)) from dual))"
			sv_l = sv_l + " AND bank_id=?SVAR"
			sv_l = sv_l + " AND acid=(select acid from tbaadm.gam where foracid=?SVAR AND bank_id=?SVAR)"
			sv_l = sv_l + " AND part_tran_type='D'"
			sv_l = sv_l + " AND pstd_flg='Y'"
			sv_l = sv_l + " AND del_flg='N'"
			sv_l = sv_l + " AND tran_particular=?SVAR"
			
			BANCS.INPARAM.BINDVARS =  CUST.VAT.acid + "|" + CUST.VAT.acid + "|" + BANCS.STDIN.contextBankId
			BANCS.INPARAM.BINDVARS =  BANCS.INPARAM.BINDVARS + "|" + CUST.VAT.acid + "|" + BANCS.STDIN.contextBankId
			BANCS.INPARAM.BINDVARS =  BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.contextBankId
			BANCS.INPARAM.BINDVARS =  BANCS.INPARAM.BINDVARS + "|" + CUST.VAT.PAndLAcct + "|" + BANCS.STDIN.contextBankId
			BANCS.INPARAM.BINDVARS =  BANCS.INPARAM.BINDVARS + "|" + " Loan VAT Dr:" + CUST.VAT.foracid
			
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_n = urhk_dbCursorOpenWithBind(sv_l)
			PRINT(sv_n)
			
			sv_o = BANCS.OUTPARAM.DB_CURSOR_NUMBER
			PRINT(sv_o)
			sv_d = urhk_dbCursorFetch(sv_o)
			PRINT(sv_d)
			
			
			IF(sv_d != 0)THEN
			#{
				
				CUST.VAT.vatAmountCINDEM = 0
				
			#}
			ENDIF
			sv_j = 0
			PRINT(sv_j)
			
			WHILE (sv_d == 0)
			#{
				
				CUST.VAT.totalAdjAmt = BANCS.OUTPARAM.totalAdjAmt1
				PRINT(CUST.VAT.totalAdjAmt)
				
				CUST.VAT.lastAdjDate = BANCS.OUTPARAM.lastAdjDate
				PRINT(CUST.VAT.lastAdjDate)
				
				
				
				#==================Calculate the VAT amount based on total Adjustment amount
				
				
				#CUST.VAT.vatAmount1 = (CDOUBLE(CUST.VAT.totalAdjAmt)*CDOUBLE(CUST.VAT.overFlowPcnt)*CDOUBLE(CUST.VAT.rate))/100
				
				CUST.VAT.vatAmount1 = CDOUBLE(CUST.VAT.totalAdjAmt)
				
				CUST.VAT.vatAmount = CDOUBLE(CUST.VAT.vatAmount) + CDOUBLE(CUST.VAT.vatAmount1)
				PRINT(CUST.VAT.vatAmount)
				
				sv_d = urhk_dbCursorFetch(sv_o)
				PRINT(sv_d)
			#}
			DO
			
			sv_d = urhk_dbCursorClose(sv_o)
			PRINT(sv_d)
			
			CUST.VAT.vatAmountCINDEM = CDOUBLE(CUST.VAT.vatAmount)
			PRINT(CUST.VAT.vatAmountCINDEM)
			###################### FOR INDEM from CUSTOM TABLE ##################
			
			
			###################### FOR PIDEM from CUSTOM TABLE ##################
			CUST.VAT.vatAmount = 0
			CUST.VAT.vatAmount1 = 0
			CUST.VAT.vatAmountCPIDEM = 0
			
			sv_l = " totalAdjAmt1,lastAdjDate|"
			sv_l = sv_l + " select tran_amt,tran_date from tbaadm.dctd_acli where (tran_id,tran_date) in ("
			sv_l = sv_l + " select vat_tran_id,tran_date from custom.C_LOAN_VAT_TRAN_TBL  where acid =?SVAR"
			sv_l = sv_l + " AND tran_date>=(select nvl((select min(tran_date) from tbaadm.ltd where acid =?SVAR"
			sv_l = sv_l + " AND flow_id='COLN'"
			sv_l = sv_l + " AND entity_cre_Flg='Y'"
			sv_l = sv_l + " AND del_flg='N'"
			sv_l = sv_l + " AND reversal_flg='N'"
			sv_l = sv_l + " AND reversed_flg='N'"
			sv_l = sv_l + " AND flow_amt>principal_amt+interest_amt"
			sv_l = sv_l + " AND ORIGIN_OF_TRAN!='POFF'"
			sv_l = sv_l + " AND bank_id=?SVAR),(select acct_opn_date from tbaadm.gam where acid=?SVAR AND bank_id=?SVAR)) from dual))"
			sv_l = sv_l + " AND bank_id=?SVAR"
			sv_l = sv_l + " AND acid=(select acid from tbaadm.gam where foracid=?SVAR AND bank_id=?SVAR)"
			sv_l = sv_l + " AND part_tran_type='D'"
			sv_l = sv_l + " AND pstd_flg='Y'"
			sv_l = sv_l + " AND del_flg='N'"
