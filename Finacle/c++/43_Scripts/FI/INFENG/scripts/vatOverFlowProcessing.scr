			PRINT(CUST.VAT.vatAmountCPIDEM)
			###################### FOR PIDEM from CUSTOM TABLE ##################
			
			###################### Comparison starts here ######################################## Comparison starts here ##################
			
			IF(FIELDEXISTS(CUST.VAT.vatAmountINDEM))THEN
			#{
				PRINT(CUST.VAT.vatAmountINDEM)
			#}
			ENDIF
			IF(FIELDEXISTS(CUST.VAT.vatAmountCINDEM))THEN
			#{
				PRINT(CUST.VAT.vatAmountCINDEM)
			#}
			ENDIF
			IF(FIELDEXISTS(CUST.VAT.vatAmountPIDEM))THEN
			#{
				PRINT(CUST.VAT.vatAmountPIDEM)
			#}
			ENDIF
			IF(FIELDEXISTS(CUST.VAT.vatAmountCPIDEM))THEN
			#{
				PRINT(CUST.VAT.vatAmountCPIDEM)
			#}
			ENDIF
			
			#============Compare Both the VAT amounts for INDEM
			sv_y = CDOUBLE(CUST.VAT.vatAmountINDEM) - CDOUBLE(CUST.VAT.vatAmountCINDEM)
			
			PRINT(sv_y)
			CUST.VAT.tranAmtINDEM = sv_y
			
			sv_q = CDOUBLE(CUST.VAT.vatAmountPIDEM) - CDOUBLE(CUST.VAT.vatAmountCPIDEM)
			
			PRINT(sv_q)
			CUST.VAT.tranAmtPIDEM = sv_q
			
			### for not collecting vat on penal interest
			#CUST.VAT.tranAmt = sv_y + sv_q
			CUST.VAT.tranAmt = sv_y
			### for not collecting vat on penal interest
			CUST.VAT.totalVatSatLcy = CDOUBLE(CUST.VAT.tranAmt)
			
			### reverse calculating the interest demand amount#########
			
			CUST.VAT.totalIndSatLcy = (CDOUBLE(CUST.VAT.tranAmt)*(100/CDOUBLE(CUST.VAT.overFlowPcnt)))
			
			########### end of reverse calc ######################
			
			
			sv_s = "rateCode|"
			sv_s = sv_s +" SELECT repay_rate_code "
			sv_s = sv_s + " FROM TBAADM.GCT"
			sv_s = sv_s + " WHERE HOME_CRNCY_CODE = ?SVAR"
			sv_s = sv_s + " AND DEL_FLG != 'Y'"
			sv_s = sv_s + " AND BANK_ID = ?SVAR"
			PRINT(sv_s)
			
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.homeCrncyCode + "|" + BANCS.STDIN.contextBankId
