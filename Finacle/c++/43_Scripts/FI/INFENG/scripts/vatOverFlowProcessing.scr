				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
				PRINT("success")
			#}
			ENDIF
			
			#1 ---------------------------------------------------------------------
			# #--------------Part Transaction for Debiting P&L Account--------------#
			# ---------------------------------------------------------------------
			MTT.PartTranDetails.Account = CUST.VAT.PAndLAcct
			MTT.PartTranDetails.RefAmount   = - sv_y
			MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
			MTT.PartTranDetails.ValueDate   = 0
			MTT.PartTranDetails.Consolidate = "N"
			MTT.PartTranDetails.ProxyPstgInd= "N"
			MTT.PartTranDetails.Particulars = CUST.VAT.Particulars1
			MTT.PartTranDetails.TranIdentifier  = "Tax_Tran"
