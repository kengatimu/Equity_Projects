<--START
TRACE ON

#------------------------------------------------------------------------------
#Creating repository and class
#------------------------------------------------------------------------------
IF (REPEXISTS("CUST") == 0) THEN
#{
	CREATEREP("CUST")
#}
ENDIF

IF(CLASSEXISTS("CUST","DATA")==0) THEN
#{
	CREATECLASS("CUST","DATA",5)
#}
ENDIF


##Create lien

CUST.DATA.EventID=CUST.WITH.EventID
CUST.DATA.foracid=CUST.WITH.foracid 
CUST.DATA.amt=CUST.WITH.TOTAL
CUST.DATA.RateCode= "TTB"
CUST.DATA.reasonCode=CUST.WITH.reasonCode
CUST.DATA.lienRemarks=CUST.WITH.Narration
CUST.DATA.acid=CUST.WITH.acid
CUST.DATA.acctCrncyCode =CUST.WITH.acctcrncy

	Print (CUST.DATA.foracid)
	Print (CUST.DATA.amt)
	Print (CUST.DATA.EventID)
	Print (CUST.DATA.RateCode)
	Print (CUST.DATA.reasonCode) 
	Print (CUST.DATA.lienRemarks) 	
	print (CUST.DATA.acid)						

	BANCS.INPARAM.BINDVARS = CUST.DATA.acid + "|" + BANCS.STDIN.contextBankId
	sv_a = "count|select count(*) from tbaadm.alt where acid = ?SVAR AND b2k_type='ULIEN' AND BANK_ID= ?SVAR"
	PRINT(sv_a)
	sv_s = urhk_dbSelectWithBind(sv_a)
	PRINT(sv_s)
	IF (sv_s !=0) THEN
	#{
		CUST.DATA.LienSuccessOrFailure = "F"
		CUST.DATA.LienFailureReason = "Query to fetch count of lien record details of normal lien ON ALT table failed"
		sv_s = CUST.DATA.foracid+ "|" + "Query to fetch count of lien record details of normal lien ON ALT table failed"
		PRINT(sv_s)
		GOTO ENDOFSCRIPT_LIEN_MOD
	#}
	ELSE
		CUST.DATA.NewRecNum = BANCS.OUTPARAM.count
		PRINT(CUST.DATA.NewRecNum)
		IF ((CUST.DATA.NewRecNum) == 0 ) THEN

				Print (CUST.DATA.foracid)
				Print (CUST.DATA.amt )
				Print (CUST.DATA.acctCrncyCode)
				Print (CUST.DATA.lienRemarks)
				Print (CUST.DATA.reasonCode)	
				
			sv_l = urhk_SetUrhkInp("acctLienMaintCrit.acctNum.foracid|" + CUST.DATA.foracid)
			sv_l = urhk_SetUrhkInp("acctLienMaintCrit.moduleType.type|ULIEN")
			sv_a = urhk_SetUrhkInp("acctLienMaintCrit.lienExpiryDate|31-12-2099 00:00:00")
			sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_0>.key.serial_num|0")
			sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_0>.newLienAmt|" + CUST.DATA.amt + "|"+CUST.DATA.acctCrncyCode)
			sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_0>.oldLienAmt|0|"+CUST.DATA.acctCrncyCode)
			sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_0>.expiryDate|31-12-2099 00:00:00")
			sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_0>.lienRemarks|" + CUST.DATA.lienRemarks)
			sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_0>.lienReasonCode.refCode|" + CUST.DATA.reasonCode)
			sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_0>.effFromDate|" + BANCS.STDIN.BODDate)
			sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_0>.requestDept|" + CUST.DATA.EventID)
			#Call the service for adding and verifying the new lien.
			sv_a = urhk_ExecSrvNoCommit ("SRV_AddLienOnAcctAndVerify|same_user_verify = Y|retain_all_output = Y")
			PRINT(sv_a)
			IF (sv_a != 0) THEN
					GOTO ERROR_HANDLING
			ENDIF							
		ELSE 								
			BANCS.INPARAM.BINDVARS = CUST.DATA.acid + "|" + BANCS.STDIN.contextBankId + "|" + CUST.DATA.reasonCode
			sv_a = "count|select count(*) from tbaadm.alt where acid = ?SVAR AND b2k_type='ULIEN' AND BANK_ID= ?SVAR AND LIEN_REASON_CODE = ?SVAR "
			PRINT(sv_a)
			sv_s = urhk_dbSelectWithBind(sv_a)
			PRINT(sv_s)
			IF (sv_s !=0) THEN								
				CUST.DATA.LienSuccessOrFailure = "F"
				CUST.DATA.LienFailureReason = "Query to fetch count of lien record details of normal lien ON ALT table failed"
				sv_s = CUST.DATA.foracid+ "|" + "Query to fetch count of lien record details of normal lien ON ALT table failed"
				PRINT(sv_s)
				GOTO ENDOFSCRIPT_LIEN_MOD
			ELSE					
				sv_a = urhk_SetUrhkInp("acctLienMaintCrit.acctNum.foracid|" + CUST.DATA.foracid)
				sv_a = urhk_SetUrhkInp("acctLienMaintCrit.moduleType.type|ULIEN")
				sv_a = urhk_SetUrhkInp("acctLienMaintCrit.lienExpiryDate|31-12-2099 00:00:00")
				sv_a = urhk_ExecSrvNoCommit("SRV_FetchLienDtlsOnAcForMod|retain_all_output = Y")
				PRINT(sv_a)
					IF (sv_a != 0) THEN
							GOTO ERROR_HANDLING
					ENDIF
				sv_a = urhk_CopyOutToIn("")
				PRINT(sv_a)
				PRINT("here")
				sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_" + CUST.DATA.NewRecNum + ">.key.serial_num|0")
				sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_" + CUST.DATA.NewRecNum + ">.newLienAmt|" + CUST.DATA.amt +  "|" +CUST.DATA.acctCrncyCode)
				sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_" + CUST.DATA.NewRecNum + ">.oldLienAmt|0|"+CUST.DATA.acctCrncyCode)
				sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_" + CUST.DATA.NewRecNum + ">.expiryDate|31-12-2099 00:00:00")
				sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_" + CUST.DATA.NewRecNum + ">.lienRemarks|" + CUST.DATA.lienRemarks)
				sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_" + CUST.DATA.NewRecNum + ">.lienReasonCode.refCode|" + CUST.DATA.reasonCode)
				sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_" + CUST.DATA.NewRecNum + ">.effFromDate|" + BANCS.STDIN.BODDate ) 
				sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_" + CUST.DATA.NewRecNum + ">.requestedBy|")
				sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_" + CUST.DATA.NewRecNum + ">.requestDept|" + CUST.DATA.EventID)
				sv_l = urhk_SetUrhkInp("lienMaintLL.<rec_" + CUST.DATA.NewRecNum + ">.contactNum|")
				sv_a = urhk_ExecSrvNoCommit("SRV_ModifyLienOnAcctAndVerify|same_user_verify = Y|retain_all_output = Y")
				PRINT(sv_a)
				IF (sv_a != 0) THEN
						GOTO ERROR_HANDLING
				ENDIF
			ENDIF
		ENDIF					
		
		
					ERROR_HANDLING:
					#-------------Error handling when the SRV returns failure.--------------------#
					IF (sv_a != 0) THEN										
							CUST.DATA.LienSuccessOrFailure = "F"
							PRINT(CUST.DATA.LienSuccessOrFailure)
							sv_c = BANCS.OUTPARAM.Error_num
							IF (sv_c > 0) THEN												
									IF (STRLEN(BANCS.OUTPARAM.ErrorMesg_1) > 0) THEN
											CUST.DATA.LienFailureReason = BANCS.OUTPARAM.ErrorMesg_1
											PRINT(CUST.DATA.LienFailureReason)
											sv_s = CUST.DATA.foracid + "|" + CUST.DATA.LienFailureReason
											PRINT(sv_s)
									ENDIF
									sv_d = 1
									WHILE(sv_d <= sv_c)													
											sv_f = FORMAT$(sv_d, "%d")
											sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_" + sv_f)
											PRINT(sv_e)
											sv_e = ("BANCS").("OUTPARAM").("ErrorCode_" + sv_f)
											PRINT(sv_e)
											sv_e = ("BANCS").("OUTPARAM").("Tag_" + sv_f)
											PRINT(sv_e)
											sv_d = sv_d + 1														
									DO
							ENDIF
					ELSE
							CUST.DATA.LienSuccessOrFailure = "S"
					ENDIF
					
			ENDOFSCRIPT_LIEN_MOD:
			Print (CUST.DATA.LienSuccessOrFailure)
			IF (CUST.DATA.LienSuccessOrFailure == "S") THEN				
				CUST.DATA.amt ="0"		
			ENDIF

	#}
	ENDIF	



EXITSCRIPT
END-->