<--START
CHECKSUM="e4f1ae6af1b8f312d17f3f4c4ac30236c803515a6d637c1696ada5db6ce6d7f9"
	TRACE ON
	
	CUST.DENOM.tranId = ""
	CUST.DENOM.scriptSuccess = "Y"
	CUST.DENOM.Details = "N"
	CUST.DENOM.EVENT = "DX"
	PRINT(CUST.DENOM.ph1)
	PRINT(CUST.DENOM.ph2)
	
	########################################################################################
	
	IF (REPEXISTS("MTT") == 0) THEN
	#{
		CREATEREP("MTT")
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("MTT", "InputDetails")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("MTT", "InputDetails", 5)
	#}
	ENDIF
	
	sv_d = CLASSEXISTS("MTT", "TranDetails")
	IF (sv_d == 0) THEN
	#{
		CREATECLASS("MTT", "TranDetails", 5)
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("MTT", "ChargeDetails")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("MTT", "ChargeDetails", 5)
	#}
	ENDIF
	
	########################################################################################
	
	sv_r = CLASSEXISTS("CUST","HCASHDX")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","HCASHDX",5)
	#}
	ENDIF
	
	###########################################################################################
	# Initialize Variables
	###########################################################################################
	
	CUST.HCASHDX.txnType = "CD"
	CUST.HCASHDX.tranSubType = "CR"
	CUST.HCASHDX.srvcallmode = ""
	CUST.HCASHDX.fromCrncyCode = ""
	CUST.HCASHDX.toCrncyCode = ""
	CUST.HCASHDX.amtFrmCcy = "0.00"
	CUST.HCASHDX.chrgEvntId = ""
	CUST.HCASHDX.chrgAmt = "0.00"
	CUST.HCASHDX.rateCode = ""
	CUST.HCASHDX.rate = ""
	CUST.HCASHDX.treaRate = "0.00"
	CUST.HCASHDX.treaRefRate = "0.00"
	CUST.HCASHDX.treaRefNum = ""
	CUST.HCASHDX.fromCcyCashAcct = CUST.DENOM.ph1
	CUST.HCASHDX.toCcyCashAcct = CUST.DENOM.ph2
	CUST.HCASHDX.amtToCcy = "0.00"
	
	###########################################################################################
	# Get Values from front end
	###########################################################################################
	
	IF(FIELDEXISTS(BANCS.INPUT.acctCrncy))THEN
	#{
		IF(TRIM(BANCS.INPUT.acctCrncy) != "")THEN
		#{
			CUST.HCASHDX.fromCrncyCode = TOUPPER(TRIM(BANCS.INPUT.acctCrncy))
			print(CUST.HCASHDX.fromCrncyCode)
		#}
		ENDIF
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.refCrncy))THEN
	#{
		IF(TRIM(BANCS.INPUT.refCrncy) != "")THEN
		#{
			CUST.HCASHDX.toCrncyCode = TOUPPER(TRIM(BANCS.INPUT.refCrncy))
			print(CUST.HCASHDX.toCrncyCode)
		#}
		ENDIF
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.amtFrmCcy))THEN
	#{
		IF(TRIM(BANCS.INPUT.amtFrmCcy) != "")THEN
		#{
			CUST.HCASHDX.amtFrmCcy = TOUPPER(TRIM(BANCS.INPUT.amtFrmCcy))
			print(CUST.HCASHDX.amtFrmCcy)
        		sv_l = "0"
        		sv_l = GETPOSITION(CUST.HCASHDX.amtFrmCcy,",")
        		PRINT(sv_l)
        		IF(sv_l > 0)THEN
        		#{
				sv_e  = STRLEN(CUST.HCASHDX.amtFrmCcy)
				sv_f = MID$(CUST.HCASHDX.amtFrmCcy,0,(sv_l - 1))	
				sv_g = MID$(CUST.HCASHDX.amtFrmCcy,sv_l,sv_e)	
				CUST.HCASHDX.amtFrmCcy = sv_f + "." + sv_g
				print(CUST.HCASHDX.amtFrmCcy)
			#}
			ENDIF

		#}
		ENDIF
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.acctCrncyAmt))THEN
	#{
		IF(TRIM(BANCS.INPUT.acctCrncyAmt) != "")THEN
		#{
			CUST.HCASHDX.amtToCcy = TOUPPER(TRIM(BANCS.INPUT.acctCrncyAmt))
			print(CUST.HCASHDX.amtToCcy)
        		sv_l = "0"
        		sv_l = GETPOSITION(CUST.HCASHDX.amtToCcy,",")
        		PRINT(sv_l)
        		IF(sv_l > 0)THEN
        		#{
				sv_e  = STRLEN(CUST.HCASHDX.amtToCcy)
				sv_f = MID$(CUST.HCASHDX.amtToCcy,0,(sv_l - 1))	
				sv_g = MID$(CUST.HCASHDX.amtToCcy,sv_l,sv_e)	
				CUST.HCASHDX.amtToCcy = sv_f + "." + sv_g
				print(CUST.HCASHDX.amtToCcy)
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.chrgEvntId))THEN
	#{
		IF(TRIM(BANCS.INPUT.chrgEvntId) != "")THEN
		#{
			CUST.HCASHDX.chrgEvntId = TOUPPER(TRIM(BANCS.INPUT.chrgEvntId))
			print(CUST.HCASHDX.chrgEvntId)
		#}
		ENDIF
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.chrgAmt))THEN
	#{
		IF(TRIM(BANCS.INPUT.chrgAmt) != "")THEN
		#{
			CUST.HCASHDX.chrgAmt = TOUPPER(TRIM(BANCS.INPUT.chrgAmt))
			print(CUST.HCASHDX.chrgAmt)
        		sv_l = "0"
        		sv_l = GETPOSITION(CUST.HCASHDX.chrgAmt,",")
        		PRINT(sv_l)
        		IF(sv_l > 0)THEN
        		#{
				sv_e  = STRLEN(CUST.HCASHDX.chrgAmt)
				sv_f = MID$(CUST.HCASHDX.chrgAmt,0,(sv_l - 1))	
				sv_g = MID$(CUST.HCASHDX.chrgAmt,sv_l,sv_e)	
				CUST.HCASHDX.chrgAmt = sv_f + "." + sv_g
				print(CUST.HCASHDX.chrgAmt)
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.rateCode))THEN
	#{
		IF(TRIM(BANCS.INPUT.rateCode) != "")THEN
		#{
			CUST.HCASHDX.rateCode = TOUPPER(TRIM(BANCS.INPUT.rateCode))
			print(CUST.HCASHDX.rateCode)
		#}
		ENDIF
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.rate))THEN
	#{
		IF(TRIM(BANCS.INPUT.rate) != "")THEN
		#{
			CUST.HCASHDX.rate = TOUPPER(TRIM(BANCS.INPUT.rate))
			print(CUST.HCASHDX.rate)
        		sv_l = "0"
        		sv_l = GETPOSITION(CUST.HCASHDX.rate,",")
        		PRINT(sv_l)
        		IF(sv_l > 0)THEN
        		#{
				sv_e  = STRLEN(CUST.HCASHDX.rate)
				sv_f = MID$(CUST.HCASHDX.rate,0,(sv_l - 1))	
				sv_g = MID$(CUST.HCASHDX.rate,sv_l,sv_e)	
				CUST.HCASHDX.rate = sv_f + "." + sv_g
				print(CUST.HCASHDX.rate)
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.treaRefNum))THEN
	#{
		IF(TRIM(BANCS.INPUT.treaRefNum) != "")THEN
		#{
			CUST.HCASHDX.treaRefNum = TOUPPER(TRIM(BANCS.INPUT.treaRefNum))
			print(CUST.HCASHDX.treaRefNum)
		#}
		ENDIF
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.treaRate))THEN
	#{
		IF(TRIM(BANCS.INPUT.treaRate) != "")THEN
		#{
			CUST.HCASHDX.treaRefRate= TOUPPER(TRIM(BANCS.INPUT.treaRate))
			print(CUST.HCASHDX.treaRefRate)
        		sv_l = "0"
        		sv_l = GETPOSITION(CUST.HCASHDX.treaRefRate,",")
        		PRINT(sv_l)
        		IF(sv_l > 0)THEN
        		#{
				sv_e  = STRLEN(CUST.HCASHDX.treaRefRate)
				sv_f = MID$(CUST.HCASHDX.treaRefRate,0,(sv_l - 1))	
				sv_g = MID$(CUST.HCASHDX.treaRefRate,sv_l,sv_e)	
				CUST.HCASHDX.treaRefRate = sv_f + "." + sv_g
				print(CUST.HCASHDX.treaRefRate)
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	
	IF(FIELDEXISTS(BANCS.INPUT.srvcallmode))THEN
	#{
		IF(TRIM(BANCS.INPUT.srvcallmode) != "")THEN
		#{
			CUST.HCASHDX.srvcallmode = TOUPPER(TRIM(BANCS.INPUT.srvcallmode))
			print(CUST.HCASHDX.srvcallmode)
		#}
		ENDIF
	#}
	ENDIF
	
	###########################################################################################
	# Get Treasury Rate From SRV
	###########################################################################################
	
	sv_u = urhk_SetUrhkInp("fromCrncy.crncyCode|"+CUST.HCASHDX.fromCrncyCode)
	sv_u = urhk_SetUrhkInp("toCrncy.crncyCode|"+CUST.HCASHDX.toCrncyCode)
	sv_u = urhk_SetUrhkInp("rateCode.refCode|"+CUST.HCASHDX.rateCode)
	#sv_u = urhk_SetUrhkInp("fromAmt|"+CUST.HCASHDX.refAmt+"|"+CUST.HCASHDX.refCrncy)
	
	sv_u = urhk_SetUrhkOut("rate|rate")
	sv_u = urhk_SetUrhkOut("treaRate|treaRate")
	
	sv_u = urhk_ExecSrvNoCommit("SRV_TieredConvCrncy")
	print(sv_u)
	
	IF(sv_u == 0)THEN
	#{
		CUST.HCASHDX.treaRate = BANCS.OUTPARAM.treaRate
		PRINT(CUST.HCASHDX.treaRate)
	#}
	ENDIF
	
	
	IF(FIELDEXISTS(CUST.HCASHDX.treaRefNum))THEN
	#{
		IF(TRIM(CUST.HCASHDX.treaRefNum) != "")THEN
		#{
			IF(FIELDEXISTS(CUST.HCASHDX.treaRefRate))THEN
			#{
				IF(CUST.HCASHDX.treaRefRate != "")THEN
				#{
					CUST.HCASHDX.treaRate = CUST.HCASHDX.treaRefRate
					print(CUST.HCASHDX.treaRate)
				#}
				ENDIF
				
			#}
			ENDIF
			
		#}
		ENDIF
	#}
	ENDIF
	
	
	
	###########################################################################################
	# Get Charge PNL Account
	###########################################################################################
	
	CUST.HCASHDX.chargePNLAcct = ""
	BANCS.INPARAM.PostTranFlg = "Y"
	BANCS.INPARAM.CommitFlg = "N"
	BANCS.INPARAM.InsertTranWithValidnFlg = "Y"
	BANCS.INPARAM.RestrictModifyInd = "FOURTH_GROUP"
	BANCS.INPARAM.ErrorCheckForLuw = "N"
	BANCS.INPARAM.CheckExceptions = "Y"
	
	sv_u = urhk_MTTS_Initialize("")
	print(sv_u)
	
	MTT.ChargeDetails.EventType = "TRANF"
	MTT.ChargeDetails.EventId = CUST.HCASHDX.chrgEvntId
	print(MTT.ChargeDetails.EventId)
	MTT.ChargeDetails.ChrgInpCrncy = CUST.HCASHDX.fromCrncyCode
	MTT.ChargeDetails.PartyAccount = CUST.DENOM.ph1
	MTT.ChargeDetails.ChrgInpAmount = CUST.HCASHDX.amtFrmCcy
	#MTT.ChargeDetails.CollectionCrncy = CUST.HCASHDX.fromCrncyCode
	
	sv_a = urhk_MTTS_InitPtt("")
	print(sv_a)
	
	sv_u = urhk_MTTS_GetPttRec("")
	print(sv_u)
	
	IF(sv_u == 0)THEN
	#{
		CUST.HCASHDX.chargePNLAcct = MTT.PartTranDetails.Account
		PRINT(CUST.HCASHDX.chargePNLAcct)
	#}
	ENDIF
	
	sv_u = urhk_MTTS_Close("")
	print(sv_u)
	
	###########################################################################################
	# Tran Header
	###########################################################################################
	
	sv_a = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranType|C")
	sv_a = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranSubType|"+CUST.HCASHDX.tranSubType)
	sv_a = urhk_SetUrhkInp("tranHdr.tranIdentifier.tranDate|"+BANCS.STDIN.BODDate)
	
	###########################################################################################
	# Part Tran Details : Debit Leg
	###########################################################################################
	
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.key.serial_num|00001")
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.pTranIdentifier.tranDate|" + BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.valueDate|" + BANCS.STDIN.BODDate)
	sv_u = urhk_setUrhkInp("tranDtl.partTranDetailLL.<rec_0>.pTranIdentifier.partTranSrlNum|1")
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.partTranType.code|D")
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.refCrncyCode.crncyCode|"+CUST.HCASHDX.fromCrncyCode)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.refAmt|"+CUST.HCASHDX.amtFrmCcy+"|"+ CUST.HCASHDX.fromCrncyCode)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.acctId.foracid|"+ CUST.HCASHDX.fromCcyCashAcct)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.glDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.tranParticulars|" + CUST.DENOM.custName+" / "+ "ID NO. " + CUST.DENOM.idNum)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.tranParticulars2|" + CUST.DENOM.idNum)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.tranRmks|" + CUST.DENOM.phoneNo)
	
	###########################################################################################
	# Part Tran Details : Credit Leg
	############################################################################################
	
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.key.serial_num|00002")
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.pTranIdentifier.tranDate|" + BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.valueDate|" + BANCS.STDIN.BODDate)
	sv_u = urhk_setUrhkInp("tranDtl.partTranDetailLL.<rec_1>.pTranIdentifier.partTranSrlNum|2")
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.partTranType.code|C")
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refCrncyCode.crncyCode|"+CUST.HCASHDX.fromCrncyCode)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refAmt|"+CUST.HCASHDX.amtFrmCcy+"|"+ CUST.HCASHDX.fromCrncyCode)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.acctId.foracid|"+CUST.HCASHDX.toCcyCashAcct)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.glDate|"+BANCS.STDIN.BODDate)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.rateCode.refCode|"+CUST.HCASHDX.rateCode)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.rate|"+CUST.HCASHDX.rate)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.tranParticulars|" + CUST.DENOM.custName+"/" + CUST.DENOM.idNum)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.tranParticulars2|" + CUST.DENOM.idNum)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.tranRmks|" + CUST.DENOM.phoneNo)
	sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.treaRate|"+CUST.HCASHDX.treaRate)
	
	IF(CUST.HCASHDX.treaRefNum != "")THEN
	#{
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.treaRefNum|"+CUST.HCASHDX.treaRefNum)
	#}
	ENDIF
	
	##################################################################################################################
	# Part Tran Details: Charge Part Tran
	##################################################################################################################
	
	IF(CDOUBLE(CUST.HCASHDX.chrgAmt) > 0)THEN
	#{
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_3>.key.serial_num|00003")
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_3>.pTranIdentifier.tranDate|" + BANCS.STDIN.BODDate)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_3>.valueDate|" + BANCS.STDIN.BODDate)
		sv_u = urhk_setUrhkInp("tranDtl.partTranDetailLL.<rec_3>.pTranIdentifier.partTranSrlNum|3")
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_3>.partTranType.code|D")
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_3>.refCrncyCode.crncyCode|"+CUST.HCASHDX.fromCrncyCode)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_3>.refAmt|"+CUST.HCASHDX.chrgAmt+"|"+ CUST.HCASHDX.fromCrncyCode)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_3>.acctId.foracid|"+ CUST.HCASHDX.fromCcyCashAcct)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_3>.glDate|"+BANCS.STDIN.BODDate)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_3>.tranParticulars|charge debit tran particular")
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_3>.tranRmks|charge debit Tran Rmks")
		
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_4>.key.serial_num|00004")
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_4>.pTranIdentifier.tranDate|" + BANCS.STDIN.BODDate)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_4>.valueDate|" + BANCS.STDIN.BODDate)
		sv_u = urhk_setUrhkInp("tranDtl.partTranDetailLL.<rec_4>.pTranIdentifier.partTranSrlNum|4")
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_4>.partTranType.code|C")
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_4>.refCrncyCode.crncyCode|"+CUST.HCASHDX.fromCrncyCode)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_4>.refAmt|"+CUST.HCASHDX.chrgAmt+"|"+ CUST.HCASHDX.fromCrncyCode)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_4>.acctId.foracid|"+CUST.HCASHDX.chargePNLAcct)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_4>.glDate|"+BANCS.STDIN.BODDate)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_4>.rateCode.refCode|"+CUST.HCASHDX.rateCode)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_4>.rate|"+CUST.HCASHDX.rate)
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_4>.tranParticulars|charge credit TranParticular")
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_4>.tranRmks|charge credit Tran Rmks")
		sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_4>.treaRate|"+CUST.HCASHDX.treaRate)
		
		IF(CUST.HCASHDX.treaRefNum != "")THEN
		#{
			sv_u = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_4>.treaRefNum|"+CUST.HCASHDX.treaRefNum)
		#}
		ENDIF
	#}
	ENDIF
	
	##################################################################################################################
	
	sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
	sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")
	
	##################################################################################################################
	
	IF(CUST.HCASHDX.srvcallmode == "E")THEN
	#{
		sv_u = urhk_ExecSrvNoCommit("SRV_AddCashTran|same_user_verify = Y|retain_all_output = Y")
		print(sv_u)
		#}
	ELSE
		#{
		sv_u = urhk_ExecSrvNoCommit("SRV_AddCashTran|same_user_verify = Y|retain_all_output = Y")
		print(sv_u)
		
		IF(sv_u != 0)THEN
		#{
			sv_u = urhk_CopyOutToIn("")
			print(sv_u)
			
			sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranId|tranId")
			sv_u = urhk_SetUrhkOut("tranDtl.tranIdentifier.tranDate|tranDate")
			
			sv_u = urhk_ExecSrvNoCommit("SRV_AddCashTran|same_user_verify = Y|retain_all_output = Y")
			print(sv_u)
		#}
		ENDIF
	#}
	ENDIF
	
