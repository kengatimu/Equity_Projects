<--START

TRACE ON

##------------------------------------
## Creation of Repository and Classes
##------------------------------------
 IF (REPEXISTS("CUST") == 0) THEN
 #{
                 CREATEREP("CUST")
 #}
 ENDIF
 IF (CLASSEXISTS("CUST", "DATA") == 0) THEN
 #{
                 CREATECLASS("CUST", "DATA", 5)
 #}
 ENDIF

CUST.DATA.status = ""
CUST.DATA.staff = ""
CUST.DATA.catType = ""
CUST.DATA.accType = ""
CUST.DATA.accNum = ""

CUST.DATA.funcCode = BANCS.INPUT.funcCode
PRINT(CUST.DATA.funcCode)


		#================================================================================
		# Category Type and Account Type Searcher
		#================================================================================

		CUST.DATA.recCount = "0"

		lv_s = ""
		lv_s = lv_s + "EmpId,EmpName|"
		lv_s = lv_s + "select EMP_ID,EMP_NAME  from tbaadm.get where del_flg !='Y' and  emp_id in (select user_emp_id from tbaadm.upr where home_bank_id = '"+BANCS.STDIN.contextBankId+"')"
		PRINT(lv_s)
		lv_c = urhk_dbCursorOpenWithBind(lv_s)
		PRINT(lv_c)

		IF(lv_c == 0) THEN
		#{
			lv_e = BANCS.OUTPARAM.DB_CURSOR_NUMBER
			PRINT(lv_e)

			lv_f = urhk_dbCursorFetch(lv_e)
			PRINT(lv_f)

			CUST.DATA.recCount = 0

			lv_x = 1
			WHILE(lv_f == 0)
			#{
				CUST.DATA.recCount    =       CINT(CUST.DATA.recCount) + 1
				PRINT(CUST.DATA.recCount)

				CUST.DATA.EmpId = BANCS.OUTPARAM.EmpId
				PRINT(CUST.DATA.EmpId)

				CUST.DATA.EmpName = BANCS.OUTPARAM.EmpName
				PRINT(CUST.DATA.EmpName)
				
				lv_z = urhk_SetOrbOut("count|"+CUST.DATA.recCount)
				PRINT(lv_z)
			

				lv_y = FORMAT$(lv_x,"%d")	
				PRINT(lv_y)

				IF (CUST.DATA.EmpId == "") THEN
				#{
					lv_r = "EmpId_" + CUST.DATA.recCount + "| "
					PRINT(lv_r)
				#}
				ELSE
				#{
					lv_r = "EmpId_" + CUST.DATA.recCount + "|" + CUST.DATA.EmpId
					PRINT(lv_r)
				#}
				ENDIF
			
				lv_m = urhk_SetOrbOut(lv_r)
				PRINT(lv_m)


				IF (CUST.DATA.EmpName == "") THEN
				#{
					lv_r = "EmpName_" + CUST.DATA.recCount + "| "
					PRINT(lv_r)
				#}
				ELSE
				#{
					lv_r = "EmpName_" + CUST.DATA.recCount + "|" + CUST.DATA.EmpName
					PRINT(lv_r)
				#}
				ENDIF
				lv_m = urhk_SetOrbOut(lv_r)
				PRINT(lv_m)
				

				lv_x = lv_x + 1
				lv_f = urhk_dbCursorFetch(lv_e)
				PRINT(lv_f)
			#}
			DO
			lv_a = urhk_dbCursorClose(lv_e)
			PRINT(lv_a)	
		#}
		ENDIF

ENDOFSCRIPT:

	EXITSCRIPT
	TRACE OFF

END-->
