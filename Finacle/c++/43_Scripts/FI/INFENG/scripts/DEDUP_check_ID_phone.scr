	STDWFS.GLBDATA.errMsg="Kindly Supply Phonenumber "
	print(STDWFS.GLBDATA.errMsg)
ENDIF

#two:Phonenumber
IF (STDWFS.GLBDATA.Phonenumber!="") THEN
	sv_s = "Phonenumbercount|"
	sv_s = sv_s + "select count(1) from tbaadm.cphone where bank_id=?SVAR and PHONENO=?SVAR  "
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + STDWFS.GLBDATA.Phonenumber
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbselectWithBind(sv_s)
	print(sv_d)
	sv_q = BANCS.OUTPARAM.Phonenumbercount
	print(sv_q)
	IF (sv_q != "0") THEN
		sv_s = "orgkeyphone,phoneno,preferredflag |"
		sv_s = sv_s + "select PHONE_B2KID,PHONENO, NVL(PREFERREDFLAG,'N')PREFERREDFLAG  from tbaadm.cphone where bank_id=?SVAR and PHONENO=?SVAR and rownum<2 "
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + STDWFS.GLBDATA.Phonenumber
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbselectWithBind(sv_s)
		print(sv_d)
		IF (sv_d == "0") THEN
			STDWFS.GLBDATA.orgkeyphone = BANCS.OUTPARAM.orgkeyphone
			print(STDWFS.GLBDATA.orgkeyphone)
			STDWFS.GLBDATA.phoneno = BANCS.OUTPARAM.phoneno
			print(STDWFS.GLBDATA.phoneno)
			STDWFS.GLBDATA.preferredflag = BANCS.OUTPARAM.preferredflag
			print(STDWFS.GLBDATA.preferredflag)
			STDWFS.GLBDATA.Phonenumberflg="1"
			#########
			sv_z = urhk_SetOrbOut("orgkeyphone|"+STDWFS.GLBDATA.orgkeyphone)
			print(sv_z)
			sv_z = urhk_SetOrbOut("phoneno|"+STDWFS.GLBDATA.phoneno)
			print(sv_z)
			sv_z = urhk_SetOrbOut("preferredflag|"+STDWFS.GLBDATA.preferredflag)
			print(sv_z)
			sv_z = urhk_SetOrbOut("Phonenumberflg|"+STDWFS.GLBDATA.Phonenumberflg)
			print(sv_z)
			#########
			#####
			sv_s = "orgkey,docdescr,referencenumber |"
			sv_s = sv_s + "select orgkey,docdescr,referencenumber  from CRMUSER.ENTITYDOCUMENT where bank_id=?SVAR and orgkey=?SVAR and referencenumber is not null and rownum<2 "
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + STDWFS.GLBDATA.orgkeyphone
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbselectWithBind(sv_s)
			print(sv_d)
			IF (sv_d == "0") THEN
				STDWFS.GLBDATA.orgkey = BANCS.OUTPARAM.orgkey
				print(STDWFS.GLBDATA.orgkey)
				STDWFS.GLBDATA.docdescr = BANCS.OUTPARAM.docdescr
				print(STDWFS.GLBDATA.docdescr)
				STDWFS.GLBDATA.referencenumber = BANCS.OUTPARAM.referencenumber
				print(STDWFS.GLBDATA.referencenumber)
				STDWFS.GLBDATA.Referencenumberflg="1"
				#######
				sv_z = urhk_SetOrbOut("docdescr|"+STDWFS.GLBDATA.docdescr)
				print(sv_z)
				sv_z = urhk_SetOrbOut("referencenumber|"+STDWFS.GLBDATA.referencenumber)
				print(sv_z)
				sv_z = urhk_SetOrbOut("Referencenumberflg|"+STDWFS.GLBDATA.Referencenumberflg)
				print(sv_z)
				#######
			ENDIF
			#####
		ENDIF
	ELSE
		STDWFS.GLBDATA.Phonenumberflg="0"
		sv_z = urhk_SetOrbOut("Phonenumberflg|"+STDWFS.GLBDATA.Phonenumberflg)
		print(sv_z)
	ENDIF
ENDIF

