#-----------------------------------------------------------------------------------------------
<--START
TRACE ON

	IF (REPEXISTS("CUST") == 0) THEN
        #{
                CREATEREP("CUST")
        #}
        ENDIF

        IF (CLASSEXISTS("CUST","LARSH") == 0) THEN
        #{
                CREATECLASS("CUST","LARSH",5)
        #}
        ENDIF

	sv_a=urhk_B2k_PrintRepos("BANCS")
	print(sv_a)
	
	#--------------------------------
	# Fetching input values
	#-------------------------------

		IF(FIELDEXISTS(BANCS.INPUT.acct_number)) THEN
		#{
			CUST.LARSH.acct_number = BANCS.INPUT.acct_number
			PRINT(CUST.LARSH.acct_number)
		#}
		ENDIF
		
		IF(FIELDEXISTS(BANCS.INPUT.sol_id)) THEN
		#{
			CUST.LARSH.sol_id = BANCS.INPUT.sol_id
			PRINT(CUST.LARSH.sol_id)
		#}
		ENDIF

		IF(FIELDEXISTS(BANCS.INPUT.flowDate)) THEN
		#{
			CUST.LARSH.flowDate= BANCS.INPUT.flowDate
			PRINT(CUST.LARSH.flowDate)
		#}
		ENDIF

		IF(FIELDEXISTS(BANCS.INPUT.schm_code)) THEN
		#{
			CUST.LARSH.schm_code = BANCS.INPUT.schm_code
			PRINT(CUST.LARSH.schm_code)
		#}
		ENDIF

		IF(FIELDEXISTS(BANCS.INPUT.acct_crncy_code)) THEN
		#{
			CUST.LARSH.acct_crncy_code = BANCS.INPUT.acct_crncy_code
			PRINT(CUST.LARSH.acct_crncy_code)
		#}
		ENDIF

		IF(FIELDEXISTS(BANCS.INPUT.acctName)) THEN
		#{
			CUST.LARSH.acctName = BANCS.INPUT.acctName
			PRINT(CUST.LARSH.acctName)
		#}
		ENDIF
		
		IF(FIELDEXISTS(BANCS.INPUT.intRate)) THEN
		#{
			CUST.LARSH.intRate = BANCS.INPUT.intRate
			PRINT(CUST.LARSH.intRate)
		#}
		ENDIF

		IF(FIELDEXISTS(BANCS.INPUT.principal)) THEN
		#{
			CUST.LARSH.principal = BANCS.INPUT.principal
			PRINT(CUST.LARSH.principal)
		#}
		ENDIF
		IF(FIELDEXISTS(BANCS.INPUT.interest)) THEN
		#{
			CUST.LARSH.interest = BANCS.INPUT.interest
			PRINT(CUST.LARSH.interest)
		#}
		ENDIF

		
		IF(FIELDEXISTS(BANCS.INPUT.flowAmt)) THEN
		#{
			CUST.LARSH.flowAmt = BANCS.INPUT.flowAmt
			PRINT(CUST.LARSH.flowAmt)
		#}
		ENDIF




		IF(FIELDEXISTS(BANCS.INPUT.acct_open_date)) THEN
		#{
			CUST.LARSH.acct_open_date= BANCS.INPUT.acct_open_date
			PRINT(CUST.LARSH.acct_open_date)
		#}
		ENDIF


	
	PRINT(CUST.LARSH.sol_id)
	PRINT(CUST.LARSH.acct_number)
	PRINT(CUST.LARSH.schm_code)
	PRINT(CUST.LARSH.acct_open_date)
	print(CUST.LARSH.flowDate)
	print(CUST.LARSH.flowAmt) 
	print(CUST.LARSH.intRate)
	print(CUST.LARSH.acct_crncy_code)
	PRINT(CUST.LARSH.principal)
	#-------------------------------------------------------------------
	#     Inserting data in the custom date C_HLARSH_OUTPUT
	#-------------------------------------------------------------------
	BANCS.INPARAM.BINDVARS = CUST.LARSH.sol_id + "|" + CUST.LARSH.acct_number+"|"+CUST.LARSH.acctName
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|" + CUST.LARSH.schm_code + "|" + CUST.LARSH.acct_open_date 
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.LARSH.flowDate + "|" +CUST.LARSH.flowAmt 
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.LARSH.interest + "|" +  CUST.LARSH.acct_crncy_code 
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.LARSH.intRate + "|" + CUST.LARSH.principal
	print(BANCS.INPARAM.BINDVARS)

	sv_s = "INSERT INTO custom.C_HLARSH_OUPUT(SOL_ID,ACCT_NUM,ACCT_NAME,SCHM_CODE,ACCT_OPN_DATE,FLOW_DATE,"
	sv_s = sv_s + "FLOW_AMT,INTEREST_AMT,ACCT_CRNCY_CODE,INTEREST_RATE,PRINCIPAL,RUN_DATE) VALUES("
	sv_s = sv_s + " ?SVAR,"
	sv_s = sv_s + " ?SVAR,"
	sv_s = sv_s + " ?SVAR,"
	sv_s = sv_s + " ?SVAR,"
	sv_s = sv_s + " to_date(?SVAR,'dd-mm-yyyy'),"
	sv_s = sv_s + " to_date(?SVAR,'dd-mm-yyyy'),"
	sv_s = sv_s + " ?SVAR,"
	sv_s = sv_s + " ?SVAR,"
	sv_s = sv_s + " ?SVAR,"
	sv_s = sv_s + " ?SVAR,"
	sv_s = sv_s + " ?SVAR,"
	sv_s = sv_s + "sysdate)"

	print(sv_s)
	


		sv_v = urhk_dbSQLWithBind(sv_s)
		PRINT(sv_v)

		IF(sv_v == 0)THEN
		#{
			sv_x = urhk_dbSQLWithBind("commit")

			BANCS.OUTPUT.msg = "SUCCESS"
		#}
		ELSE
		#{
			sv_x = urhk_dbSQLWithBind("rollback")
			CUST.DATA.errMsg = "Updation failed"
		#}
		ENDIF

	

EXITSCRIPT


END-->