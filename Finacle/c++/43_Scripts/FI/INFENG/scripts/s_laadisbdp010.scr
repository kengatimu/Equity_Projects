#	-------         ------          ------          	------------
#	1.0             12-03-2013      Sateesh				Original Version
#	2.0				31-03-2013		Sateesh				Update the share_invest custom table and commit statement removed.
#-----------------------------------------------------------------------------------------------
<--START
CHECKSUM="40f8c296a05db0ffb187a2d6cc879a826e42426aee9343fa86cf80459b005669"
	TRACE ON
	
	#------------------------------------------------------------------------------
	# Creating repository and class
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","LADISB") == 0) THEN
	#{
		CREATECLASS("CUST","LADISB",5)
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","CPARAM") == 0) THEN
	#{
		CREATECLASS("CUST","CPARAM",5)
	#}
	ENDIF
	
	PRINT(CUST.LADISB.loanAcctId)
	CALL("laadisbdp004.scr")
	IF (CUST.LADISB.errMsg != "" ) THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF (CUST.LADISB.loanType == "I") THEN
	#{
		#------------------------------------------------------------------------------
		# Getting loan account number value from front end
		#------------------------------------------------------------------------------
		sv_u =  urhk_SRV_GetVal("acctDisburseTranLA.laAcct.foracid")
		IF(sv_u == 0)THEN
		#{
			CUST.LADISB.loanAcctId = BANCS.OUTPARAM.srvValue
			print(CUST.LADISB.loanAcctId)
			#}
		ELSE
			#{
			CUST.LADISB.errMsg = "Error in getting loan account number from frontend"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#------------------------------------------
		#Update the status to the SHARE_INVEST table
		#------------------------------------------
		sv_s ="UPDATE CUSTOM.SHARE_INVEST"
		sv_s = sv_s + " SET SHARE_INVEST.entity_cre_flg= 'Y',"
		sv_s = sv_s + " SHARE_INVEST.del_flg='Y'"
		sv_s = sv_s + " WHERE SHARE_INVEST.loan_acct_id =?SVAR"
		sv_s = sv_s + " AND SHARE_INVEST.bank_id=?SVAR"
		print(sv_s)
		BANCS.INPARAM.BINDVARS = CUST.LADISB.loanAcctId + "|"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSQLWithBind(sv_s)
		print(sv_d)
		IF (sv_d != 0) THEN
		#{
			#CUST.LADISB.errMsg =" The table SHARE_INVEST not updated successfully "
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	ENDOFSCRIPT:
		
		IF (CUST.LADISB.errMsg != "" ) THEN
		#{
			sv_u = urhk_SRV_setErr("Error|"+CUST.LADISB.errMsg)
		#}
		ENDIF
		
		EXITSCRIPT
END-->
