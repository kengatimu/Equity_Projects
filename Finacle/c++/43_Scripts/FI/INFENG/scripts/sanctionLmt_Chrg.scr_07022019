<--START
TRACE ON

        sv_r = REPEXISTS("CUST")

        IF(sv_r == 0) THEN
        #{
                CREATEREP ("CUST")
        #}
        ENDIF

        sv_r = CLASSEXISTS("CUST","DATA")

        IF(sv_r == 0) THEN
        #{
                CREATECLASS ("CUST","DATA",5)
        #}
        ENDIF

        CUST.DATA.errFlg = "N"
        CUST.DATA.errMsg = " "
        CUST.DATA.acctNum = " "
        CUST.DATA.newsanctLim = "0"
        CUST.DATA.oldsanctLim = "0"
        CUST.DATA.chrgCrncy = " "
        CUST.DATA.chrgAmt = " "
        CUST.DATA.vatAmt = " "
        CUST.DATA.datediff = "0"
        CUST.DATA.acid = " "
        CUST.DATA.crncyCode = " "
	CUST.DATA.oldLimExpDate = ""
	CUST.DATA.schmCode = " "
	CUST.DATA.tranAmt = "0"

        IF(FIELDEXISTS(BANCS.INPUT.acctNum))THEN
        #{
                IF(BANCS.INPUT.acctNum !="")THEN
                #{
                        CUST.DATA.acctNum = TOUPPER(TRIM(BANCS.INPUT.acctNum))
                        PRINT(CUST.DATA.acctNum)
                #}
                ELSE
                #{
                        CUST.DATA.errFlg = "Y"
                        CUST.DATA.errMsg = "Account Number not entered"
                        GOTO ENDOFSCRIPT
                #}
                ENDIF

        #}
        ELSE
        #{
                CUST.DATA.errFlg = "Y"
                CUST.DATA.errMsg = "Account Number not entered"
                GOTO ENDOFSCRIPT
        #}
        ENDIF

	sv_s = "schmCode|SELECT SCHM_CODE FROM TBAADM.GAM WHERE BANK_ID=?SVAR AND FORACID=?SVAR"
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+ CUST.DATA.acctNum

        PRINT(sv_s)
        PRINT(BANCS.INPARAM.BINDVARS)

        sv_d = urhk_dbSelectWithBind(sv_s)
        PRINT(sv_d)

        IF(sv_d == 0)THEN
        #{
		CUST.DATA.schmCode = BANCS.OUTPARAM.schmCode
		PRINT(CUST.DATA.schmCode)
	#}
	ELSE
	#{
                CUST.DATA.errFlg = "Y"
                CUST.DATA.errMsg = "Invalid Account"
                GOTO ENDOFSCRIPT
	#}
	ENDIF

        BANCS.INPUT.moduleName  = "OT"
        BANCS.INPUT.parameterId = "ODSAN_SCHMS"
        CALL ("getcparamvalue.scr")
        IF(BANCS.OUTPUT.parameterVal != "")THEN
        #{
                CUST.DATA.schmparmVal = BANCS.OUTPUT.parameterVal
                #}
        ELSE
                #{
                CUST.DATA.errorFlg = "Y"
                CUST.DATA.errorMsg = "CPARAM setup has not done for parameter ID:"+BANCS.INPUT.parameterId
                GOTO ENDOFSCRIPT

        #}
        ENDIF

        sv_p = GETPOSITION(CUST.DATA.schmparmVal,CUST.DATA.schmCode)
        PRINT(sv_p)

        IF(sv_p <= "0")THEN
        #{
                GOTO ENDOFSCRIPT
        #}
        ENDIF


        IF(FIELDEXISTS(BANCS.INPUT.newsanctLim))THEN
        #{
                IF(BANCS.INPUT.newsanctLim !="")THEN
                #{
                        CUST.DATA.newsanctLim = TOUPPER(TRIM(BANCS.INPUT.newsanctLim))
                        PRINT(CUST.DATA.newsanctLim)
                #}
                ELSE
                #{
                        CUST.DATA.errFlg = "Y"
                        CUST.DATA.errMsg = "Sanction Limit not entered"
                        GOTO ENDOFSCRIPT
                #}
                ENDIF

        #}
        ELSE
        #{
                CUST.DATA.errFlg = "Y"
                CUST.DATA.errMsg = "Sanction Limit not entered"
                GOTO ENDOFSCRIPT
        #}
        ENDIF

        IF(FIELDEXISTS(BANCS.INPUT.newLimExpDate))THEN
        #{
                IF(BANCS.INPUT.newLimExpDate !="")THEN
                #{
                        CUST.DATA.newLimExpDate = TOUPPER(TRIM(BANCS.INPUT.newLimExpDate))
                        PRINT(CUST.DATA.newLimExpDate)
                #}
                ELSE
                #{
                        CUST.DATA.errFlg = "Y"
                        CUST.DATA.errMsg = "Sanction Limit Expired not entered"
                        GOTO ENDOFSCRIPT
                #}
                ENDIF

        #}
        ELSE
        #{
                CUST.DATA.errFlg = "Y"
                CUST.DATA.errMsg = "Sanction Limit Expired not entered"
                GOTO ENDOFSCRIPT
        #}
        ENDIF


        sv_s = "oldsanctLim,oldLimExpDate,crncyCode,acid|SELECT SANCT_LIM,to_char((to_date(LIM_EXP_DATE,'DD-MM-YY')),'DD-MM-YYYY'),CRNCY_CODE,ACID FROM TBAADM.LHT "
        sv_s = sv_s + "WHERE BANK_ID=?SVAR AND ACID = (SELECT ACID FROM TBAADM.GAM WHERE BANK_ID=?SVAR AND FORACID=?SVAR) AND SERIAL_NUM=(SELECT MAX(SERIAL_NUM) "
	sv_s = sv_s + "FROM TBAADM.LHT WHERE BANK_ID=?SVAR AND ACID = (SELECT ACID FROM TBAADM.GAM WHERE BANK_ID=?SVAR AND FORACID=?SVAR) AND DEL_FLG='N' AND ENTITY_CRE_FLG='Y') AND STATUS='A' AND DEL_FLG='N' AND ENTITY_CRE_FLG='Y'"
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+  BANCS.STDIN.contextBankId +"|"+ CUST.DATA.acctNum +"|"+ BANCS.STDIN.contextBankId 
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+  BANCS.STDIN.contextBankId +"|"+ CUST.DATA.acctNum

        PRINT(sv_s)
        PRINT(BANCS.INPARAM.BINDVARS)

        sv_d = urhk_dbSelectWithBind(sv_s)
        PRINT(sv_d)

        IF(sv_d == 0)THEN
        #{
                CUST.DATA.oldsanctLim = BANCS.OUTPARAM.oldsanctLim
                PRINT(CUST.DATA.oldsanctLim)
                CUST.DATA.oldLimExpDate = BANCS.OUTPARAM.oldLimExpDate
                PRINT(CUST.DATA.oldLimExpDate)
                CUST.DATA.crncyCode = BANCS.OUTPARAM.crncyCode
                PRINT(CUST.DATA.crncyCode)
                CUST.DATA.acid = BANCS.OUTPARAM.acid
                PRINT(CUST.DATA.acid)
        #}
        #ELSE
        #{
        #        CUST.DATA.errFlg = "Y"
        #        CUST.DATA.errMsg = "Invalid Account ID"
        #        GOTO ENDOFSCRIPT
        #}
        ENDIF

        CUST.DATA.LimDiff = CDOUBLE(CUST.DATA.newsanctLim) - CDOUBLE(CUST.DATA.oldsanctLim)
        PRINT(CUST.DATA.LimDiff)

        sv_s = "newLimExpDate|select to_char((to_date(?SVAR,'DD-MM-YY')),'DD-MM-YYYY') from dual"
        BANCS.INPARAM.BINDVARS = CUST.DATA.newLimExpDate
        sv_d = urhk_dbSelectWithBind(sv_s)
        PRINT(sv_d)

        IF(sv_d == 0) THEN
        #{
                CUST.DATA.newLimExpDate = BANCS.OUTPARAM.newLimExpDate
                PRINT(CUST.DATA.newLimExpDate)
        #}
        ENDIF

	IF(TRIM(CUST.DATA.oldLimExpDate) != "")THEN
	#{
        	BANCS.INPARAM.date1 = CUST.DATA.newLimExpDate
        	BANCS.INPARAM.date2 = CUST.DATA.oldLimExpDate
        	sv_a = urhk_B2k_dateDiff("")
        	PRINT(sv_a)
        	IF(sv_a == 0) THEN
        	#{

                	CUST.DATA.datediff=BANCS.OUTPARAM.dateDiff
                	PRINT(CUST.DATA.datediff)
        	#}
        	ENDIF
	#}
	ENDIF

        IF(CUST.DATA.datediff > "0")THEN
        #{
                CUST.DATA.tranAmt = CUST.DATA.newsanctLim
		CUST.DATA.remarks = "Charge for Maturity Date extension"
                GOTO CHRGCALC
        #}
        ENDIF

        IF(CUST.DATA.LimDiff > CDOUBLE("0"))THEN
        #{
                CUST.DATA.tranAmt = CUST.DATA.LimDiff
		CUST.DATA.remarks = "Charge for Limit extension"
                GOTO CHRGCALC
        #}
        ENDIF

        CHRGCALC:
        BANCS.INPUT.entityId = CUST.DATA.acid
        BANCS.INPUT.eventId = "SANLIM"
        BANCS.INPUT.eventType = "GCHRG"
        BANCS.INPUT.inputAmount = CUST.DATA.tranAmt
        BANCS.INPUT.CallMode = "SCRIPT"
        BANCS.INPUT.chrgCollCrncy = CUST.DATA.crncyCode
	BANCS.STDIN.ScriptName = "eventChargeCalc_1.scr"

  CUST.DATA.ODacnt = CUST.DATA.acctNum
	sv_e = ""
        CALL("eventChargeCalc_1.scr")

	IF((sv_e != "") AND (sv_e != " "))THEN
	#{
                CUST.DATA.errFlg = "Y"
                CUST.DATA.errMsg = sv_e
                GOTO ENDOFSCRIPT
        #}
        ENDIF

		
        CUST.DATA.chrgAmt = BANCS.OUTPUT.collAmount
        CUST.DATA.chrgCrncy = CUST.DATA.crncyCode

        sv_s = "lnkedEvent|SELECT LINKED_EVENT_ID FROM TBAADM.PTT WHERE EVENT_ID='SANLIM' AND BANK_ID=?SVAR AND EVENT_TYPE='GCHRG'"
        BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId

        PRINT(sv_s)
        PRINT(BANCS.INPARAM.BINDVARS)

        sv_d = urhk_dbSelectWithBind(sv_s)

        IF(sv_d == "0")THEN
        #{
                CUST.DATA.vatEvent = BANCS.OUTPARAM.lnkedEvent
                PRINT(CUST.DATA.vatEvent)

                BANCS.INPUT.inputCrncy = CUST.DATA.crncyCode
                BANCS.INPUT.inputAmount = CUST.DATA.chrgAmt
                BANCS.INPUT.entityId    = CUST.DATA.acid

                CALL("vatOnEventChargeCalc.scr")

                CUST.DATA.vatAmt = BANCS.OUTPUT.collAmount

        #}
        ENDIF

ENDOFSCRIPT:

        sv_u = urhk_SetOrbOut("errFlg|"+CUST.DATA.errFlg)
        sv_u = urhk_SetOrbOut("errMsg|"+CUST.DATA.errMsg)
        sv_u = urhk_SetOrbOut("chrgCrncy|"+CUST.DATA.chrgCrncy)
        sv_u = urhk_SetOrbOut("chrgAmt|"+CUST.DATA.chrgAmt)
        sv_u = urhk_SetOrbOut("vatAmt|"+CUST.DATA.vatAmt)

TRACE OFF
END-->

