#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
##   Name                   : Mailling.scr 
##   Date                   : 09-Mar-2020 
##   Description            : Script for casa Account batch freeze
##   Input                  :
##   Output                 :
##   Author                 : Irungu.James
##   Called Script          :
##   Calling Script         :
##   Reference              :
##+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
##   Modification History   :
##   09-MAR- 2020  		James k Irungu 		Query Data from custom table
##+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
<--start
trace on
#Repos&Classes
	if (repexists("EQSRV") == 0) then
		createrep("EQSRV")
	endif
	if (classexists("EQSRV","GLBDATA") == 0) then
		createclass("EQSRV","GLBDATA",5)
	endif
#Variables
     
	EQSRV.GLBDATA.ORGKEY  	= ""

		sv_q = "ORGKEY  | select orgkey  from CRMUSER.ACCOUNTS where corp_id is null and bank_id =?SVAR and orgkey not in "
		sv_q = sv_q + " (select b.orgkey  from CRMUSER.ADDRESS a,CRMUSER.ACCOUNTS  b where a.bank_id =?SVAR and a.ADDRESSCATEGORY ='Mailing' "
		sv_q = sv_q + " and a.orgkey =b.orgkey  and a.bank_id =b.bank_id and b.corp_id is null ) "
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId 
		sv_e = urhk_dbCursorOpenWithBind(sv_q)
		IF(sv_e==0) THEN
		#{
			sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
			print (sv_m)
			sv_q = urhk_dbCursorFetch(sv_m)
			print(sv_q)
			IF(sv_q == 1) THEN
				sv_x = urhk_dbCursorClose(sv_m)
				print(sv_x)
				exitscript
			ENDIF
			print(sv_q)
			WHILE (sv_q==0)

				EQSRV.GLBDATA.ORGKEY  = BANCS.OUTPARAM.ORGKEY
				Print (EQSRV.GLBDATA.ORGKEY  )

				sv_s="cifcount|"
				sv_s = sv_s + " SELECT COUNT(1) "
				sv_s = sv_s + " FROM CRMUSER.ACCOUNTS "
				sv_s = sv_s + " WHERE ORGKEY =  ?SVAR "
				print(sv_s)
				BANCS.INPARAM.BINDVARS =  EQSRV.GLBDATA.ORGKEY  
				print(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSelectWithBind(sv_s)
				print(sv_d)
				IF (sv_d == 0) THEN		
					IF (CINT(BANCS.OUTPARAM.cifcount)== 1) THEN 			
						sv_s="ADDcount|"
						sv_s = sv_s + " SELECT COUNT(1) "
						sv_s = sv_s + " FROM crmuser.address "
						sv_s = sv_s + " WHERE ORGKEY =  ?SVAR "
						sv_s = sv_s + " and ADDRESSCATEGORY ='Mailing' "
						print(sv_s)
						BANCS.INPARAM.BINDVARS =  EQSRV.GLBDATA.ORGKEY
						print(BANCS.INPARAM.BINDVARS)
						sv_d = urhk_dbSelectWithBind(sv_s)
						print(sv_d)
						IF (sv_d == 0) THEN		
							
							IF (CINT(BANCS.OUTPARAM.ADDcount)> 0 ) THEN 									
								EQSRV.GLBDATA.resultMsg = "Mailing address already Exist.. Insert Failed"
								GOTO ENDOFSCRIPT									
							ELSE
								
								BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS
								sv_a = " insert into crmuser.address (ADDRESSID, BANK_ID, ACCOUNTID,ADDRESSCATEGORY, ADDRESS_LINE1,ADDRESS_LINE2,ADDRESS_LINE3, CITY, STATE,ZIP, COUNTRY, START_DATE,  END_DATE, NAME, CORE_CUST_ID, PREFERREDADDRESS,HOLDMAILFLAG, PREFERREDFORMAT, ORGKEY, SALUTATION,TMDATE) (select crmuser.ADDRESSID.NEXTVAL,BANK_ID,ACCOUNTID,'Mailing',ADDRESS_LINE1,ADDRESS_LINE2,ADDRESS_LINE3,CITY,STATE,ZIP,COUNTRY,STARTDATE,TO_DATE('12/31/2099 00:00:00', 'MM/DD/YYYY HH24:MI:SS'),NAME, CORE_CUST_ID,'Y','N','FREE_TEXT_FORMAT',ORGKEY,SALUTATION,TMDATE from crmuser.accounts where orgkey= ?SVAR ) "
								sv_b = urhk_dbSQLWithBind(sv_a)
								print(sv_b)
								IF(sv_b != 0) THEN																							
									EQSRV.GLBDATA.resultMsg = "Insert Failed"
									GOTO ENDOFSCRIPT											
								ELSE																					
									EQSRV.GLBDATA.resultMsg = " Insert of Mailing address  for CIF " + EQSRV.GLBDATA.ORGKEY+ " Successful"
									GOTO ENDOFSCRIPT
								ENDIF									
							ENDIF
						ENDIF
				
					ELSE
						EQSRV.GLBDATA.resultMsg = "CIF DOES NOT EXIST"
						GOTO ENDOFSCRIPT					
					ENDIF	
				ELSE 
					
					EQSRV.GLBDATA.resultMsg = "ERROR Insert Failed"
					GOTO ENDOFSCRIPT
				ENDIF
ENDOFSCRIPT:
				print (sv_m)
				sv_q = urhk_dbCursorFetch(sv_m)
				print(sv_q)
			DO
		ENDIF

        
	if(classexists("EQSRV","GLBDATA")==1)then
                deleteclass("EQSRV","GLBDATA")
        endif
        if(repexists("EQSRV")==1)then
                deleterep("EQSRV")
        endif
        exitscript
trace off
end-->