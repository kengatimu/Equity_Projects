#------------------------------------------------------------------------------------------------
#  Name            : FI_ChqBook_StsInq.scr 
#  Description     : To fetch Cheque Details Based on ReqDate and ChequeStatus
#  Date            : 20-08-2025
#  Author          : YESHWANTH
#  Input           : ReqDate and ChequeStatus(E,A,S,R,B,K,D)
#  Output          : Cheque Details
#  Called Script   : NA
#  Menu Option     : (API)
#  Srl. No         Date            Author               Description.
#  -------         ------          ------               ------------
#  1.0            20-08-2025      YESHWANTH     	Original Version
#-----------------------------------------------------------------------------------------------
<--START
TRACE ON

	sv_u=REPEXISTS("CUST")
	IF(sv_u==0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF

	sv_u=CLASSEXISTS("CUST", "STS")
	IF(sv_u==0) THEN
	#{
		CREATECLASS("CUST", "STS", 5)
	#}
	ENDIF

	sv_t=urhk_b2k_printrepos("BANCS")
	print(sv_t)

	#---------------------------------------------------------------------------------------------------------------
        # Variable Initialization
        #---------------------------------------------------------------------------------------------------------------

        CUST.STS.bankId     = ""
        CUST.STS.reqDate = ""
        CUST.STS.chqSatus   = ""
        CUST.STS.branchId   = ""
        CUST.STS.count = 0


	IF( (FIELDEXISTS(("BANCS").("INPUT").("bankId"))== 0) ) THEN
	#{
   		CUST.STS.errMsg="Please enter the BankId"
		sv_t = "ERROR | " +CUST.STS.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	ELSE
		CUST.STS.bankId = BANCS.INPUT.bankId
		PRINT(CUST.STS.bankId)
	#}
	ENDIF

	IF( (FIELDEXISTS(("BANCS").("INPUT").("reqDate"))== 0) ) THEN
        #{
                CUST.STS.errMsg="Please enter the Requested Date"
                sv_t = "ERROR | " +CUST.STS.errMsg
                sv_u = urhk_SetOrbOut(sv_t)
                GOTO ENDSCRIPT
	ELSE
		CUST.STS.reqDate = BANCS.INPUT.reqDate
		PRINT(CUST.STS.reqDate)
	#}
        ENDIF
	IF( (FIELDEXISTS(("BANCS").("INPUT").("chqSatus"))== 0) ) THEN
        #{
                CUST.STS.errMsg="Please enter the Cheque Status"
                sv_t = "ERROR | " +CUST.STS.errMsg
                sv_u = urhk_SetOrbOut(sv_t)
		GOTO ENDSCRIPT
	ELSE
        	CUST.STS.chqSatus = BANCS.INPUT.chqSatus
		PRINT(CUST.STS.chqSatus)
        #}
        ENDIF

	### Fetching the records ###
	sv_s="reqId,reqDate,solId,solDesc,acctNum,key,acctCrncy,acctName,noOfChbk,bgnChqNum,endChqNum|"
	sv_s=sv_s + "select REQ_ID,REQ_DATE,SUBSTR(G.IBAN_NUMBER,6,5) as sol_id,S.SOL_DESC,SUBSTR(G.IBAN_NUMBER,11,11) as ACCT_NUM,SUBSTR(G.IBAN_NUMBER,22,2) as KEY,"
	sv_s=sv_s + "G.ACCT_CRNCY_CODE,G.ACCT_NAME,C.NUM_OF_CHB,C.BEGIN_CHQ_NUM,C.END_CHQ_NUM from CUSTOM.CUSTOM_CBR C inner join TBAADM.GAM G on C.FORACID = G.FORACID "
	sv_s=sv_s + "inner join TBAADM.SOL S on G.SOL_ID = S.SOL_ID where C.BANK_ID=?SVAR and trunc(REQ_DATE) = to_date(?SVAR,'dd-mm-yyyy')  and REQ_STATUS = ?SVAR order by REQ_ID "
	print(sv_s)

	BANCS.INPARAM.BINDVARS = CUST.STS.bankId  +"|"+ CUST.STS.reqDate +"|"+ CUST.STS.chqSatus 
	print(BANCS.INPARAM.BINDVARS)

	sv_c = urhk_dbcursorOpenWithBind(sv_s)
       	PRINT(sv_c)	

	IF(sv_c == 0) THEN
       	 #{
		CUST.STS.DB_CURSOR_NUMBER = BANCS.OUTPARAM.DB_CURSOR_NUMBER
                print(CUST.STS.DB_CURSOR_NUMBER)

                sv_c = urhk_dbCursorFetch(CUST.STS.DB_CURSOR_NUMBER)
                print(sv_c)

                IF(sv_c != "0")THEN
                #{
                        sv_e = urhk_SetOrbOut("SuccessorFailure|success")
                        sv_u = urhk_SetOrbOut("RESULT_MSG| No records found")
                        print(sv_u)
			GOTO ENDSCRIPT
                #}
                ENDIF

		WHILE(sv_c == "0")
        	#{
			CUST.STS.reqId   = BANCS.OUTPARAM.reqId
                        print(CUST.STS.reqId)

			CUST.STS.reqDate = BANCS.OUTPARAM.reqDate
			print(CUST.STS.reqDate)

			CUST.STS.solId   = BANCS.OUTPARAM.solId
			print(CUST.STS.solId)

			CUST.STS.solDesc = BANCS.OUTPARAM.solDesc
                        print(CUST.STS.solDesc)
		
			CUST.STS.acctNum = BANCS.OUTPARAM.acctNum
                        print(CUST.STS.acctNum)

			CUST.STS.key	 = BANCS.OUTPARAM.key
                        print(CUST.STS.key)

			CUST.STS.acctCrncy = BANCS.OUTPARAM.acctCrncy
                        print(CUST.STS.acctCrncy)

			CUST.STS.acctName  = BANCS.OUTPARAM.acctName
                        print(CUST.STS.acctName)

			CUST.STS.noOfChbk  = BANCS.OUTPARAM.noOfChbk
                        print(CUST.STS.noOfChbk)

			CUST.STS.bgnChqNum = BANCS.OUTPARAM.bgnChqNum
                        print(CUST.STS.bgnChqNum)

			CUST.STS.endChqNum = BANCS.OUTPARAM.endChqNum
                        print(CUST.STS.endChqNum)

			CUST.STS.count = CINT(CUST.STS.count)+ 1
			print(CUST.STS.count)

			sv_c = urhk_SetOrbOut("ChequeBookDetails.<rec_"+CUST.STS.count+">.Req_Id"+"| "+CUST.STS.reqId)
                        print(sv_c)

			sv_c = urhk_SetOrbOut("ChequeBookDetails.<rec_"+CUST.STS.count+">.Req_Date"+"| "+CUST.STS.reqDate)
			print(sv_c)

			sv_c = urhk_SetOrbOut("ChequeBookDetails.<rec_"+CUST.STS.count+">.SolID"+"| "+CUST.STS.solId)
			print(sv_c)

			sv_c = urhk_SetOrbOut("ChequeBookDetails.<rec_"+CUST.STS.count+">.SolDesc"+"| "+CUST.STS.solDesc)
			print(sv_c)

			sv_c = urhk_SetOrbOut("ChequeBookDetails.<rec_"+CUST.STS.count+">.Acct_Num"+"| "+CUST.STS.acctNum)
                        print(sv_c)

			sv_c = urhk_SetOrbOut("ChequeBookDetails.<rec_"+CUST.STS.count+">.Key"+"| "+CUST.STS.key)
                        print(sv_c)

			sv_c = urhk_SetOrbOut("ChequeBookDetails.<rec_"+CUST.STS.count+">.Acct_Crncy"+"| "+CUST.STS.acctCrncy)
                        print(sv_c)

			sv_c = urhk_SetOrbOut("ChequeBookDetails.<rec_"+CUST.STS.count+">.Acct_Name"+"| "+CUST.STS.acctName)
                        print(sv_c)

			sv_c = urhk_SetOrbOut("ChequeBookDetails.<rec_"+CUST.STS.count+">.Num_ChqBook"+"| "+CUST.STS.noOfChbk)
                        print(sv_c)

			sv_c = urhk_SetOrbOut("ChequeBookDetails.<rec_"+CUST.STS.count+">.Bgn_ChqNum"+"| "+CUST.STS.bgnChqNum)
                        print(sv_c)

			sv_c = urhk_SetOrbOut("ChequeBookDetails.<rec_"+CUST.STS.count+">.End_ChqNum"+"| "+CUST.STS.endChqNum)
                        print(sv_c)

			sv_c = urhk_dbCursorFetch(CUST.STS.DB_CURSOR_NUMBER)
                        print(sv_c)

		#}
		DO
		sv_c = urhk_dbCursorClose(CUST.STS.DB_CURSOR_NUMBER)
                print(sv_c)
	ELSE
		sv_e = urhk_SetOrbOut("SuccessorFailure|Failed")
		sv_u = urhk_SetOrbOut("ERROR| Database error occured. Please contact DBA")
		print(sv_u)
		GOTO ENDSCRIPT
	#}
	ENDIF

ENDSCRIPT:
EXITSCRIPT

TRACE OFF
END-->
