<--START
TRACE ON


sv_a = urhk_B2k_printRepos("BANCS")
print(sv_a)


IF (REPEXISTS("CUST") == 0) THEN
#{
	CREATEREP("CUST")
#}
ENDIF

IF (CLASSEXISTS("CUST","DATA") == 0) THEN
#{
	CREATECLASS("CUST","DATA",5)
#}
ENDIF

sv_r = urhk_B2k_PrintRepos("ONS")
PRINT(sv_r)

sv_u = urhk_SRV_GetVal("sol_id")
CUST.DATA.sol_id = BANCS.OUTPARAM.srvValue
print(CUST.DATA.sol_id)

sv_u = urhk_SRV_GetVal("agent_code")
CUST.DATA.agent_code = BANCS.OUTPARAM.srvValue
print(CUST.DATA.agent_code)

sv_u = urhk_SRV_GetVal("crncy_code")
CUST.DATA.crncy_code = BANCS.OUTPARAM.srvValue
print(CUST.DATA.crncy_code)

IF(CUST.DATA.crncy_code =="") THEN
#{
        IF(FIELDEXISTS(ONS.CUSTOM.custDataIn))THEN
        #{
                PRINT(ONS.CUSTOM.custDataIn)
                PRINT(STRLEN(ONS.CUSTOM.custDataIn))
                sv_u = urhk_ParseONSCustData(ONS.CUSTOM.custDataIn)

                IF(sv_u == 0)THEN
                #{
                        IF(FIELDEXISTS(BANCS.INPUT.filemntcrit_FIELD_1))THEN
                        #{
                                CUST.DATA.crncy_code = TOUPPER((BANCS.INPUT.filemntcrit_FIELD_1))
				print(CUST.DATA.crncy_code)
                        #}
                        ENDIF
                #}
                ENDIF
        #}
        ENDIF
#}
ENDIF


sv_x = "acctsolid,agentsolid,agentcode,foracid,gamacid,opercreditacid,inopercreditacid,agentacctname,finacleacctname,agtdelflg,cashless|"
sv_x = sv_x + " select gam.sol_id,agt.sol_id,agt.agent_code,gam.foracid,gam.acid,AGT.OPER_CREDIT_ACID,AGT.INOPER_CREDIT_ACID,agt.AGENT_NAME,gam.acct_name,agt.del_flg,decode(agt.FREE_TEXT,null,'NORMAL',agt.FREE_TEXT)"
sv_x = sv_x + "  from tbaadm.agt,tbaadm.gam  where AGT.OPER_CREDIT_ACID=gam.acid  and agt.del_flg='N' and agt.bank_id=gam.bank_id and agt.agent_code=?SVAR and  gam.BANK_ID=?SVAR and  agt.BANK_ID=?SVAR and agt.crncy_code  = ?SVAR and rownum<2" 
print(sv_x)
BANCS.INPARAM.BINDVARS = CUST.DATA.agent_code + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + CUST.DATA.crncy_code
PRINT(BANCS.INPARAM.BINDVARS)

sv_p= urhk_dbSelectWithBind(sv_x)
print(sv_p)

IF (sv_p == 0) THEN
	CUST.DATA.acctsolid = BANCS.OUTPARAM.acctsolid
	print(CUST.DATA.acctsolid)
	CUST.DATA.agentsolid = BANCS.OUTPARAM.agentsolid
	print(CUST.DATA.agentsolid)
	CUST.DATA.agentcode = BANCS.OUTPARAM.agentcode
	print(CUST.DATA.agentcode)
	CUST.DATA.foracid = BANCS.OUTPARAM.foracid
	print(CUST.DATA.foracid)
	CUST.DATA.gamacid = BANCS.OUTPARAM.gamacid
	print(CUST.DATA.gamacid)
	CUST.DATA.opercreditacid = BANCS.OUTPARAM.opercreditacid
	print(CUST.DATA.opercreditacid)
	CUST.DATA.inopercreditacid = BANCS.OUTPARAM.inopercreditacid
	print(CUST.DATA.inopercreditacid)
	CUST.DATA.agentacctname = BANCS.OUTPARAM.agentacctname
	print(CUST.DATA.agentacctname)
	CUST.DATA.finacleacctname = BANCS.OUTPARAM.finacleacctname
	print(CUST.DATA.finacleacctname)
	CUST.DATA.agtdelflg = BANCS.OUTPARAM.agtdelflg
	print(CUST.DATA.agtdelflg)
	CUST.DATA.cashless = BANCS.OUTPARAM.cashless
	print(CUST.DATA.cashless)	

	sv_u = urhk_SRV_SetErr("Agent Code Exists in Sol_id ..." + CUST.DATA.agentsolid)
	sv_u = urhk_SRV_SetErr("Agent Name ..." + CUST.DATA.agentacctname)
	sv_u = urhk_SRV_SetErr("Account Sol_id ..." + CUST.DATA.acctsolid)
	sv_u = urhk_SRV_SetErr("Account Number ..." + CUST.DATA.foracid)
	sv_u = urhk_SRV_SetErr("Account Name ..." + CUST.DATA.finacleacctname)
	sv_u = urhk_SRV_SetErr("Cashless/Normal ..." + CUST.DATA.cashless)
	BANCS.OUTPUT.successOrFailure = "F"
	exitscript
ENDIF

	

EXITSCRIPT
END-->
