
<--START
TRACE ON

#--------------------------------------------------------------------------
#  Creation of EQSRV repository and GLBDATA class
#--------------------------------------------------------------------------

	sv_r = REPEXISTS("BANCS")
        IF (sv_r == 0) THEN
                CREATEREP("BANCS")
        endif

	sv_r = REPEXISTS("EQSRV")
        IF (sv_r == 0) THEN
                CREATEREP("EQSRV")
        endif

	sv_r = CLASSEXISTS("EQSRV", "GLBDATA")
	IF (sv_r == 0) THEN
		CREATECLASS("EQSRV", "GLBDATA", 5)
	ENDIF
#--------------------------------------------------------------------------
# Selecting accounts from DTD 
#--------------------------------------------------------------------------


sv_s = "tranId,trandate | select distinct(tran_id), TO_CHAR(tran_date, 'DD-MM-YYYY HH24:MI:SS' )  from tbaadm.dtd,tbaadm.gam where dtd.acid=gam.acid  and dtd.bank_id=gam.bank_id and dtd.bank_id='43' and  tran_id in (select distinct ( tran_id ) from  tbaadm.dtd where   bank_id='43' and tran_amt > 1   and pstd_flg ='N' and del_flg ='N' and PSTD_FLG ='N' and dtd.del_flg ='N' and gam.bank_id='43' and gam.acct_ownership='O' and bacid='PROXY' ) "
print(sv_s)

sv_e = urhk_dbCursorOpenWithBind(sv_s)
print(sv_e)

if(sv_e==0) then
       sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
       print(sv_m)
        sv_q = urhk_dbCursorFetch(sv_m)
        print(sv_q)
        if(sv_q == 1) then
               sv_x = urhk_dbCursorClose(sv_m)
                print(sv_x)
                exitscript
        endif
        print(sv_q)
        while(sv_q==0)

			EQSRV.GLBDATA.tranId = BANCS.OUTPARAM.tranId
			print(EQSRV.GLBDATA.tranId)
			EQSRV.GLBDATA.trandate = BANCS.OUTPARAM.trandate
			print(EQSRV.GLBDATA.trandate)
			
			EQSRV.GLBDATA.tranId = EQSRV.GLBDATA.tranId
			print(EQSRV.GLBDATA.tranId)
			EQSRV.GLBDATA.trandate = EQSRV.GLBDATA.trandate
			print(EQSRV.GLBDATA.trandate)
			###
			sv_a = urhk_SetUrhkInp("tranHdr.tranIdentifier.tranId|" + EQSRV.GLBDATA.tranId)
			print(sv_a)
			sv_a = urhk_SetUrhkInp("tranHdr.tranIdentifier.tranDate|" + EQSRV.GLBDATA.trandate)
			print(sv_a)
			sv_r = urhk_ExecSrv("SRV_FetchTranDtlsForPost|retain_all_output = Y")
			print(sv_r)
			sv_a = urhk_CopyOutToIn("")
			print(sv_a)
			sv_a = urhk_ExecSrvNoCommit("SRV_PostTran|retain_all_output = Y|same_user_verify = Y")
			print(sv_a)

			IF (sv_a != 0) THEN
			#{
				IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
				#{
					print(BANCS.OUTPARAM.Error_num)
					sv_v = BANCS.OUTPARAM.Error_num
					print(sv_v)
				#}
				ELSE
				#{
					sv_v = 0
				#}
				ENDIF
				IF (sv_v > 0) then
				#{
					sv_u = system("echo 'Error for Tranid:"+ EQSRV.GLBDATA.tranId +" ' >>errortran.log")
					sv_i = 1
					WHILE (sv_i <= sv_v)
					#{
						sv_f = FORMAT$(sv_i,"%d")
						sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
						sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
						sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
						print(sv_e)
						sv_i = sv_i + 1
						print(sv_i)
						sv_u = system("echo '"+sv_e+"' >>errortran_office.log")
						print(sv_u)
					#}
					DO
				#}
				ENDIF
			ENDIF
			####
		sv_q = urhk_dbCursorFetch(sv_m)
                print(sv_q)
        do
ENDIF
Finish:
###

EXITSCRIPT
END-->
