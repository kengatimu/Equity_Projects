		IF( sv_r < 1 AND MTT.InputDetails.LoanAcctCrncyCode != MTT.InputDetails.FeeCalcCrncy)THEN
		#{
			MTT.PartTranDetails.Account = MTT.InputDetails.ConsolAcct
