			MTT.PartTranDetails.Particulars = "Salam Transaction for Seller Dealer : " + MTT.InputDetails.LoanAcct
			
			MTT.PartTranDetails.RefAmount = (sv_l+sv_m)
			print(MTT.PartTranDetails.RefAmount)
			MTT.PartTranDetails.Consolidate = "Y"
			MTT.PartTranDetails.TranIdentifier = "LOAN_REC"
			MTT.PartTranDetails.PartTranIdentifier = "SALAM_AGENT1_CREDIT"
			MTT.PartTranDetails.PTranBusinessType = "ACPRT"
			sv_r = urhk_MTTS_DefineLoanPartTran("SALAM_AGENT1_CREDIT")
			IF (sv_r == 1) THEN
			#{
				GOTO GET_NEXT_REC
			#}
			ENDIF
			
			MTT.PartTranDetails.Account = MTT.InputDetails.salamBuyerAcct
			MTT.PartTranDetails.ACPARTB2kId=MTT.InputDetails.LoanAcct
			MTT.PartTranDetails.ACPARTB2kType="ACCNT"
			MTT.PartTranDetails.RefCurrency = MTT.InputDetails.LoanAcctCrncyCode
			MTT.PartTranDetails.RateCode = MTT.InputDetails.DmdSatRateCode
			MTT.PartTranDetails.Particulars = "Salam Transaction for Buyer Dealer : " + MTT.InputDetails.LoanAcct
			
			MTT.PartTranDetails.RefAmount = -(sv_l+sv_m)
			print(MTT.PartTranDetails.RefAmount)
			MTT.PartTranDetails.Consolidate = "Y"
			MTT.PartTranDetails.TranIdentifier = "LOAN_REC"
			MTT.PartTranDetails.PartTranIdentifier = "SALAM_AGENT2_DEBIT"
			MTT.PartTranDetails.PTranBusinessType = "ACPRT"
			sv_r = urhk_MTTS_DefineLoanPartTran("SALAM_AGENT2_DEBIT")
			IF (sv_r == 1) THEN
			#{
				GOTO GET_NEXT_REC
			#}
			ENDIF
			
			MTT.PartTranDetails.Account = MTT.InputDetails.salamCommodityAcct
			MTT.PartTranDetails.RefCurrency = MTT.InputDetails.LoanAcctCrncyCode
			MTT.PartTranDetails.RateCode = MTT.InputDetails.DmdSatRateCode
			MTT.PartTranDetails.Particulars = "Salam Transaction for Buyer Dealer : " + MTT.InputDetails.LoanAcct
			
			MTT.PartTranDetails.RefAmount = (sv_l+sv_m)
			print(MTT.PartTranDetails.RefAmount)
			MTT.PartTranDetails.Consolidate = "Y"
			MTT.PartTranDetails.TranIdentifier = "LOAN_REC"
			MTT.PartTranDetails.PartTranIdentifier = "SALAM_COMM_CREDIT"
			MTT.PartTranDetails.PTranBusinessType = "ACPRT"
			sv_r = urhk_MTTS_DefineLoanPartTran("SALAM_COMM_CREDIT")
			IF (sv_r == 1) THEN
			#{
				GOTO GET_NEXT_REC
			#}
			ENDIF
		#}
