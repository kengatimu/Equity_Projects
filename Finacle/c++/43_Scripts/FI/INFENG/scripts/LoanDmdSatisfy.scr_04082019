			BANCS.INPARAM.RateCode=MTT.InputDetails.FeeRateCode
			BANCS.INPARAM.Rate=MTT.InputDetails.FeeRate
			
			sv_z=urhk_B2k_ConvertAmount("")
			
			sv_x= CDOUBLE(BANCS.OUTPARAM.OutputAmount)
			print(sv_x)
			
			MTT.PartTranDetails.Account=MTT.InputDetails.ConsolAcct
			MTT.PartTranDetails.RefAmount=-sv_x
			print(MTT.PartTranDetails.RefAmount)
			MTT.PartTranDetails.RefCurrency=MTT.InputDetails.FeeCalcCrncy
			MTT.PartTranDetails.RateCode = ""
			MTT.PartTranDetails.Particulars="Parking Account Debit for Loan Fee Collection"
			MTT.PartTranDetails.Consolidate="N"
			MTT.PartTranDetails.TranIdentifier="LOAN_REC"
			MTT.PartTranDetails.PTranBusinessType="FEECOLL"
			
			sv_z = urhk_MTTS_DefineLoanPartTran("FEEPARKDR")
			IF (sv_z == 1) THEN
			#{
				GOTO GET_NEXT_REC
			#}
			ENDIF
		#}
		ENDIF
		
		print(sv_r)
		WHILE(sv_r < 1)
		#{
			print(sv_r)
			print(MTT.InputDetails.ChargeCollAcct)
			print(MTT.InputDetails.EventId)
			print(MTT.InputDetails.EventType)
			sv_v = CDOUBLE(MTT.InputDetails.FeeCalcAmt)
			print(sv_v)
			print( MTT.InputDetails.FeeCalcCrncy)
			sv_w = CDOUBLE(MTT.InputDetails.FeeCollectionAmt)
			print(sv_w)
			print(MTT.InputDetails.FeeRateCode)
			print(MTT.InputDetails.FeeRate)
			print(MTT.InputDetails.ConsolAcct)
			print(MTT.InputDetails.FeeTranParticular)
			
			MTT.PartTranDetails.Account=MTT.InputDetails.ChargeCollAcct
			MTT.PartTranDetails.RefAmount=sv_w
			print(MTT.PartTranDetails.RefAmount)
			MTT.PartTranDetails.RefCurrency=MTT.InputDetails.FeeCalcCrncy
			MTT.PartTranDetails.RateCode = ""
			#sv_j = MTT.InputDetails.LoanAccount+" "+LTRIM(RTRIM(MID$(MTT.InputDetails.FeeTranParticular, 0,32)))
			sv_j = LTRIM(RTRIM(MID$(MTT.InputDetails.FeeTranParticular,0,32)))
			MTT.PartTranDetails.Particulars=sv_j
			MTT.PartTranDetails.Consolidate="N"
			MTT.PartTranDetails.TranIdentifier="LOAN_REC"
			MTT.PartTranDetails.PTranBusinessType="FEECOLL"
			
			MTT.ChargeDetails.EventType = MTT.InputDetails.EventType
			MTT.ChargeDetails.EventId = MTT.InputDetails.EventId
			MTT.ChargeDetails.CompB2kId = MTT.InputDetails.CompB2kId
			MTT.ChargeDetails.CalculatedAmount = sv_v
			MTT.ChargeDetails.ActualAmount = sv_w
			MTT.ChargeDetails.CollectionCrncy = MTT.InputDetails.FeeCalcCrncy
			MTT.ChargeDetails.ChargeCifId = MTT.InputDetails.LoanAcctCifId
			MTT.ChargeDetails.TargetAcctId = MTT.InputDetails.LoanAcct
			
			sv_r = urhk_MTTS_DefineChargePartTran("FEECR")
			IF (sv_r == 1) THEN
			#{
				GOTO GET_NEXT_REC
				#}
			ELSE
				#{
				sv_r = urhk_updateLadspFeeCollDetails("")
			#}
			ENDIF
			
			sv_r = urhk_getLadspFeeTranDetails(MTT.InputDetails.LoanAcct)
		#}
		DO
		#}
		
		##############################################
		
		################################################################################
		#If Interest Demand is being satisfied then collect BTT DL as 10% of Interest
