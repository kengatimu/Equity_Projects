		#############################################################################
		#Ouput from the script.If anyone modifies the actual demand getting satisfied
		#then the corresonding Output variables have to be populatd.
		#But the Output Loan account should not be changed.
		
		MTT.OutputDetails.LoanAcct = MTT.InputDetails.LoanAcct
		MTT.OutputDetails.LoanAcctCrncyCode = MTT.InputDetails.LoanAcctCrncyCode
		MTT.OutputDetails.PDmdSatisfied =  MTT.InputDetails.PDmdToBeSatisfied
		MTT.OutputDetails.IDmdSatisfied =  sv_m
		MTT.OutputDetails.BChgDmdSatisfied = MTT.InputDetails.BChgDmdToBeSatisfied
		MTT.OutputDetails.OChgDmdSatisfied = MTT.InputDetails.OChgDmdToBeSatisfied
		sv_a = ""
		sv_a = sv_l + sv_m + sv_n + sv_o
		IF(MTT.InputDetails.LoanAcctCrncyCode != MTT.InputDetails.OperAcctCrncyCode) THEN
		#{
			BANCS.INPARAM.InputAmount=sv_a
			BANCS.INPARAM.FromCurrency=MTT.InputDetails.LoanAcctCrncyCode
			BANCS.INPARAM.ToCurrency=MTT.InputDetails.OperAcctCrncyCode
			BANCS.INPARAM.RateCode=MTT.InputDetails.DmdSatRateCode
			BANCS.INPARAM.Rate=0
			sv_r = urhk_B2k_ConvertAmount("")
			sv_a = CDOUBLE(BANCS.OUTPARAM.OutputAmount)
		#}
		ENDIF
		IF( sv_u <= sv_a) THEN
		#{
			MTT.OutputDetails.LienLifted = sv_u
			#}
		ELSE
			#{
			MTT.OutputDetails.LienLifted = sv_a
		#}
		ENDIF
		
		sv_r = urhk_MTTS_EndDefinition("")
                        IF (sv_r != 0) THEN
                        #{
                                sv_r = urhk_MTTS_ReportErrorCondition("")
                                PRINT(MTT.Error.Description)
                        #}
                        ENDIF
			PRINT(BANCS.OUTPARAM.MTTTranId)
			
			####Customization : Collecting the VAT amount based on VAT percentage set at CPARAM ##############################
			
			
			IF (REPEXISTS("CUST") == 0) THEN
			#{
				CREATEREP("CUST")
			#}
			ENDIF
			IF (CLASSEXISTS("CUST", "VAT") == 0) THEN
			#{
				CREATECLASS("CUST", "VAT", 5)
			#}
			ENDIF
			#######Intialising varibles#################
			
			CUST.VAT.schmCheck = "N"
			CUST.VAT.vatPcnt = 0
			CUST.VAT.vatBacid  = ""
			CUST.VAT.foracid = MTT.InputDetails.LoanAcct
			CUST.VAT.tranId = ""
			
			#Fecthing scheme code for the account############
			
			sv_k = "schmCode,acid|select SCHM_CODE ,ACID from TBAADM.GAM  "
			sv_k = sv_k + " where FORACID= ?SVAR "
			sv_k = sv_k + " AND ENTITY_CRE_FLG = 'Y'"
			sv_k = sv_k + " AND BANK_ID = ?SVAR "
			sv_k = sv_k + " AND DEL_FLG = 'N'"
			
			
			PRINT(sv_k)
			
			
			BANCS.INPARAM.BINDVARS =  MTT.InputDetails.LoanAcct + "|" + BANCS.STDIN.contextBankId
			
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_k = urhk_dbSelectWithBind(sv_k)
			PRINT(sv_k)
			
			IF(sv_k == 0)THEN
			#{
				CUST.VAT.schmCode = BANCS.OUTPARAM.schmCode
				PRINT(CUST.VAT.schmCode)
				CUST.VAT.acid = BANCS.OUTPARAM.acid
				PRINT(CUST.VAT.acid)
			#}
			ENDIF
			
			CUST.VAT.loanAcctVatApl = MTT.InputDetails.LoanAcct
			
			CALL("schmCheck.scr")
			
			PRINT(CUST.VAT.schmCheck)
			PRINT(CUST.VAT.vatPcnt)
			PRINT(CUST.VAT.vatBacid)
			sv_s = "PandLBacid|"
			sv_s = sv_s + "SELECT INT_PANDL_BACID_DR FROM TBAADM.GSP WHERE SCHM_CODE = ?SVAR"
			sv_s = sv_s + " AND BANK_ID = ?SVAR "
			
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS =  CUST.VAT.schmCode + "|" + BANCS.STDIN.contextBankId
			
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_k = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_k)
			
			IF(sv_k == 0)THEN
			#{
				CUST.VAT.PandLBacid = BANCS.OUTPARAM.PandLBacid
				PRINT(CUST.VAT.PandLBacid)
			#}
			ENDIF
			
			
			sv_s = "penalPandLBacid|"
			sv_s = sv_s + "SELECT PENAL_PANDL_BACID FROM TBAADM.GSP WHERE SCHM_CODE = ?SVAR"
			sv_s = sv_s + " AND BANK_ID = ?SVAR "
			
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS =  CUST.VAT.schmCode + "|" + BANCS.STDIN.contextBankId
			
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_k = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_k)
			
			IF(sv_k == 0)THEN
			#{
				CUST.VAT.penalPandLBacid = BANCS.OUTPARAM.penalPandLBacid
				PRINT(CUST.VAT.penalPandLBacid)
			#}
			ENDIF
			
			
			CUST.VAT.acctCrncyCode = MTT.InputDetails.LoanAcctCrncyCode
			CUST.VAT.totalIndSatFcy = CDOUBLE(MTT.InputDetails.IDmdToBeSatisfied)
			PRINT(CUST.VAT.totalIndSatFcy)
			sv_a = CUST.VAT.vatBacid +"|"+BANCS.STDIN.homeCrncyCode+"|"+BANCS.STDIN.mySolId
			sv_k =  urhk_B2k_BacidToAcctId(sv_a)
			
			IF(sv_k == 0)THEN
			#{
				MTT.InputDetails.vatAcct = BANCS.OUTPARAM.AcctId
				PRINT(sv_b)
				#}
			ELSE
				#{
				MTT.InputDetails.vatAcct = ""
			#}
			ENDIF
			sv_a = CUST.VAT.PandLBacid +"|"+BANCS.STDIN.homeCrncyCode+"|"+BANCS.STDIN.mySolId
			sv_k =  urhk_B2k_BacidToAcctId(sv_a)
			
			IF(sv_k == 0)THEN
			#{
				MTT.InputDetails.PAndLAcct = BANCS.OUTPARAM.AcctId
				PRINT(sv_b)
				#}
			ELSE
				#{
				MTT.InputDetails.PAndLAcct  = ""
			#}
			ENDIF
			sv_a = CUST.VAT.penalPandLBacid +"|"+BANCS.STDIN.homeCrncyCode+"|"+BANCS.STDIN.mySolId
			sv_k =  urhk_B2k_BacidToAcctId(sv_a)
			
			IF(sv_k == 0)THEN
			#{
				MTT.InputDetails.penalPAndLAcct = BANCS.OUTPARAM.AcctId
				PRINT(sv_b)
				#}
			ELSE
				#{
				MTT.InputDetails.penalPAndLAcct = ""
			#}
			ENDIF
			
			
			sv_b = CDOUBLE(CUST.VAT.vatPcnt)* (CDOUBLE(MTT.InputDetails.IDmdToBeSatisfied))/100
			PRINT(sv_b)
			sv_k = CDOUBLE(CUST.VAT.vatPcnt)* (CDOUBLE(MTT.InputDetails.IDmdToBeSatisfied)-CDOUBLE(MTT.InputDetails.PenalDmdToBeSatisfied))/100
			PRINT(sv_k)
			
			sv_l =  CDOUBLE(CUST.VAT.vatPcnt)* (CDOUBLE(MTT.InputDetails.PenalDmdToBeSatisfied))/100
			PRINT(sv_l)
			
			
			IF(sv_k > 0)THEN
			#{
				IF(sv_k  < 0.1)THEN
				#{
					sv_k  = 0
				#}
				ENDIF
			#}
			ENDIF
			
			IF(sv_k  < 0)THEN
			#{
				IF(sv_k  > -0.1)THEN
				#{
					sv_k  = 0
				#}
				ENDIF
			#}
			ENDIF
			
			IF(sv_l > 0)THEN
			#{
				IF(sv_l  < 0.1)THEN
				#{
					sv_l  = 0
				#}
				ENDIF
			#}
			ENDIF
			
			IF(sv_l  < 0)THEN
			#{
				IF(sv_l  > -0.1)THEN
				#{
					sv_l  = 0
				#}
				ENDIF
			#}
			ENDIF
			
			
			
			IF(CUST.VAT.acctCrncyCode != BANCS.STDIN.homeCrncyCode)THEN
			#{
				### for not collecting vat on penal interest
				#CUST.VAT.totalVatSatFcy = sv_b
				CUST.VAT.totalVatSatFcy = sv_k
				PRINT(CUST.VAT.totalVatSatFcy)
				#CUST.VAT.totalIndSatFcy = CDOUBLE(MTT.InputDetails.IDmdToBeSatisfied)
				CUST.VAT.totalIndSatFcy = CDOUBLE(MTT.InputDetails.IDmdToBeSatisfied) - CDOUBLE(MTT.InputDetails.PenalDmdToBeSatisfied)
				### for not collecting vat on penal interest
				PRINT(CUST.VAT.totalIndSatFcy)
				sv_m = CUST.VAT.totalIndSatFcy
				
				#convert amounts to home currency
				
				BANCS.INPARAM.InputAmount=sv_m
				BANCS.INPARAM.FromCurrency=MTT.InputDetails.LoanAcctCrncyCode
				BANCS.INPARAM.ToCurrency=BANCS.STDIN.homeCrncyCode
				BANCS.INPARAM.RateCode=MTT.InputDetails.DmdSatRateCode
				BANCS.INPARAM.Rate=0
				sv_r = urhk_B2k_ConvertAmount("")
				CUST.VAT.totalIndSatLcy = CDOUBLE(BANCS.OUTPARAM.OutputAmount)
				PRINT(CUST.VAT.totalIndSatLcy)
				sv_r = urhk_B2k_printRepos("BANCS")
				
				BANCS.INPARAM.InputAmount=sv_k
				BANCS.INPARAM.FromCurrency=MTT.InputDetails.LoanAcctCrncyCode
				BANCS.INPARAM.ToCurrency=BANCS.STDIN.homeCrncyCode
				BANCS.INPARAM.RateCode=MTT.InputDetails.DmdSatRateCode
				BANCS.INPARAM.Rate=0
				sv_r = urhk_B2k_ConvertAmount("")
				CUST.VAT.totalVatSatLcy = CDOUBLE(BANCS.OUTPARAM.OutputAmount)
				PRINT(CUST.VAT.totalVatSatLcy)
				
				
				BANCS.INPARAM.InputAmount=sv_k
				BANCS.INPARAM.FromCurrency=MTT.InputDetails.LoanAcctCrncyCode
				BANCS.INPARAM.ToCurrency=BANCS.STDIN.homeCrncyCode
				BANCS.INPARAM.RateCode=MTT.InputDetails.DmdSatRateCode
				BANCS.INPARAM.Rate=0
				sv_r = urhk_B2k_ConvertAmount("")
				sv_k = CDOUBLE(BANCS.OUTPARAM.OutputAmount)
				PRINT(sv_k)
				CUST.VAT.rate = BANCS.OUTPARAM.Rate
				
				BANCS.INPARAM.InputAmount=sv_l
				BANCS.INPARAM.FromCurrency=MTT.InputDetails.LoanAcctCrncyCode
				BANCS.INPARAM.ToCurrency=BANCS.STDIN.homeCrncyCode
				BANCS.INPARAM.RateCode=MTT.InputDetails.DmdSatRateCode
				BANCS.INPARAM.Rate=0
				sv_r = urhk_B2k_ConvertAmount("")
				sv_l = CDOUBLE(BANCS.OUTPARAM.OutputAmount)
				PRINT(sv_l)
				CUST.VAT.rate = BANCS.OUTPARAM.Rate
				PRINT(CUST.VAT.rate)
				#}
			ELSE
				#{
				CUST.VAT.totalVatSatFcy = 0
				CUST.VAT.totalIndSatFcy  = 0
				
				### for not collecting vat on penal interest
				#CUST.VAT.totalVatSatLcy = sv_b
				CUST.VAT.totalVatSatLcy = sv_k
				PRINT(CUST.VAT.totalVatSatLcy)
				#CUST.VAT.totalIndSatLcy = CDOUBLE(MTT.InputDetails.IDmdToBeSatisfied)
				CUST.VAT.totalIndSatLcy = CDOUBLE(MTT.InputDetails.IDmdToBeSatisfied) - CDOUBLE(MTT.InputDetails.PenalDmdToBeSatisfied)
				### for not collecting vat on penal interest
				PRINT(CUST.VAT.totalIndSatLcy)
				CUST.VAT.rate = "1"
			#}
			ENDIF
			CUST.VAT.tranAmt = CUST.VAT.totalVatSatLcy
			CUST.VAT.rateCode = MTT.InputDetails.DmdSatRateCode
			CUST.VAT.crDrInd = "CR"
			CUST.VAT.PenalApplFlg ="N"
			CUST.VAT.NrmlOrRev = "N"
			
			### for not collecting vat on penal interest
			sv_l = 0
			### for not collecting vat on penal interest
			
			
			IF(CUST.VAT.schmCheck == "Y")THEN
			#{
				
				#--------------Part Transaction for Debiting P&L Account--------------#
				
				CUST.VAT.vatAcctDRNrml			     = MTT.InputDetails.PAndLAcct
				CUST.VAT.RemarksDRNrml           = "Loan Recovery VAT DR Normal"
				CUST.VAT.ParticularsDRNrml         = " Loan VAT Dr:" +MTT.InputDetails.LoanAcct
				CUST.VAT.RefAmountDRNrml           = sv_k
				CUST.VAT.RateCodeDRNrml = MTT.InputDetails.DmdSatRateCode
				
				
				#---------Part Transaction for  Crediting Vat Collection Account  ----------#
				
				CUST.VAT.vatAcctCRNrml			     = MTT.InputDetails.vatAcct
				CUST.VAT.RemarksCRNrml           = "Loan Recovery VAT CR Normal"
				CUST.VAT.ParticularsCRNrml         = " Loan VAT Cr:" +MTT.InputDetails.LoanAcct
				CUST.VAT.RefAmountCRNrml           = sv_k
				CUST.VAT.RateCodeCRNrml = MTT.InputDetails.DmdSatRateCode
				
				#--------------Part Transaction for Debiting Penal P&L Account--------------#
				
				IF(sv_l!=0)THEN
				#{
					
					CUST.VAT.PenalApplFlg	="Y"
					
					CUST.VAT.vatAcctDRPenal			     = MTT.InputDetails.penalPAndLAcct
					CUST.VAT.RemarksDRPenal           = "Loan Recovery VAT DR Penal"
					CUST.VAT.ParticularsDRPenal         = " Loan VAT Dr:" +MTT.InputDetails.LoanAcct
					CUST.VAT.RefAmountDRPenal           = sv_l
					CUST.VAT.RateCodeDRPenal = MTT.InputDetails.DmdSatRateCode
					
				#}
				ENDIF
				#---------Part Transaction for  Crediting Vat Collection Account  ----------#
				
				IF(sv_l!=0)THEN
				#{
					
					CUST.VAT.vatAcctCRPenal			     = MTT.InputDetails.vatAcct
					CUST.VAT.RemarksCRPenal           = "Loan Recovery VAT CR Penal"
					CUST.VAT.ParticularsCRPenal         = " Loan VAT Cr:" +MTT.InputDetails.LoanAcct
					CUST.VAT.RefAmountCRPenal           = sv_l
					CUST.VAT.RateCodeCRPenal = MTT.InputDetails.DmdSatRateCode
					
				#}
				ENDIF
				
				IF((sv_l !=0) OR (sv_k !=0))THEN
				#{
					CALL("VATLoanTranCreate.scr")
				#}
				ENDIF
				
				IF (FIELDEXISTS(CUST.VAT.vatTranId)) THEN
				#{
					PRINT(CUST.VAT.vatTranId)
					CUST.VAT.tranId = CUST.VAT.vatTranId
					PRINT(CUST.VAT.tranId)
					#}
				ELSE
					#{
					CUST.VAT.tranId = "NA"
					PRINT(CUST.VAT.tranId)
				#}
				ENDIF
				
				
				
			#}
			ENDIF
			
			CALL("vatTableUpdate.scr")
			
			
			################### End of customization #####################################
			IF (FIELDEXISTS(BANCS.OUTPARAM.MTTTranId)) THEN
			#{
				
				PRINT(BANCS.OUTPARAM.MTTTranId)
				
			#}
			ENDIF
		GET_NEXT_REC :
			sv_r = urhk_MTTS_PopulateInputDetails("")
			IF(sv_r == 1) THEN
			#{
				exitscript
			#}
			ENDIF
		#}
		DO
		TRACE OFF
END-->
