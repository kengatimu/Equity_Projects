#-------------------------------------------------------------------------------------
#    Name				: s_workclassvaldp001.scr 
#    Description     	: The script is used to validate scheme code 
#						: and account no for account scheme transfer.
#    Date            	: 08-01-2013
#    Author          	: Divya
#    Called Script		: SRV_XferAcctBtwnSchms_validate_data.scr
#    Calling Script		: getcparamvalue.scr
#    Menu Option		: HACXFRSC 
#    Srl. No		Date			Author			Description.   
#    -------		----			------			----------------
#    1.0			08-01-2013		Divya	 		Original Version
#-------------------------------------------------------------------------------------
<--START
TRACE ON

#------------------------------------------------------------------------------
#       Creating repository and class
#       Initializing the variables
#       Getting all the values from CPARAM
#------------------------------------------------------------------------------
IF (REPEXISTS("CUST") == 0) THEN
#{
	CREATEREP("CUST")
#}
ENDIF

IF (CLASSEXISTS("CUST","WCVAL") == 0) THEN
#{
	CREATECLASS("CUST","WCVAL",5)
#}
ENDIF

CUST.WCVAL.errMsg     = ""
CUST.WCVAL.schmCode1  = ""
CUST.WCVAL.schmCode2  = ""
CUST.WCVAL.workClass1 = ""
CUST.WCVAL.workClass2 = ""

BANCS.INPUT.moduleName  = "ACCTSCHMXFR"
BANCS.INPUT.parameterId = "WCVAL_SCHM1"
CALL ("getcparamvalue.scr")
IF (BANCS.OUTPUT.parameterVal != "") THEN
#{
	CUST.WCVAL.schmCode1 = BANCS.OUTPUT.parameterVal
#}
ELSE
#{
	CUST.WCVAL.errMsg = "Scheme Code1 setup not done CPARAM"
	GOTO ENDOFSCRIPT
#}
ENDIF

BANCS.INPUT.parameterId = "WCVAL_SCHM2"
CALL ("getcparamvalue.scr")
IF (BANCS.OUTPUT.parameterVal != "") THEN
#{
	CUST.WCVAL.schmCode2 = BANCS.OUTPUT.parameterVal
#}
ELSE
#{
	CUST.WCVAL.errMsg = "Scheme Code2 setup not done CPARAM"
	GOTO ENDOFSCRIPT
#}
ENDIF

BANCS.INPUT.parameterId = "WCVAL_WC1"
CALL ("getcparamvalue.scr")
IF (BANCS.OUTPUT.parameterVal != "") THEN
#{
	CUST.WCVAL.workClass1 = BANCS.OUTPUT.parameterVal
#}
ELSE
#{
	CUST.WCVAL.errMsg = "WorkClass1 setup not done CPARAM"
	GOTO ENDOFSCRIPT
#}
ENDIF

BANCS.INPUT.parameterId = "WCVAL_WC2"
CALL ("getcparamvalue.scr")
IF (BANCS.OUTPUT.parameterVal != "") THEN
#{
	CUST.WCVAL.workClass2 = BANCS.OUTPUT.parameterVal
#}
ELSE
#{
	CUST.WCVAL.errMsg = "WorkClass2 setup not done CPARAM"
	GOTO ENDOFSCRIPT
#}
ENDIF


sv_u = urhk_SRV_GetVal("xferAcct.foracid")
CUST.WCVAL.foracid = BANCS.OUTPARAM.srvValue
PRINT(CUST.WCVAL.foracid)

sv_u = urhk_SRV_GetVal("sourceSchm.schmCode")
CUST.WCVAL.schmCode = BANCS.OUTPARAM.srvValue
PRINT(CUST.WCVAL.schmCode)

PRINT(BANCS.STDIN.userWorkClass)
PRINT(CUST.WCVAL.workClass1)
PRINT(CUST.WCVAL.schmCode)
PRINT(CUST.WCVAL.schmCode1)
PRINT(CUST.WCVAL.schmCode2)

IF (CUST.WCVAL.schmCode != "") THEN
#{
	IF ((CUST.WCVAL.schmCode == CUST.WCVAL.schmCode1) OR (CUST.WCVAL.schmCode == CUST.WCVAL.schmCode2)) THEN
	#{
		IF (CINT(BANCS.STDIN.userWorkClass) < CINT(CUST.WCVAL.workClass1)) THEN
		#{
			PRINT(BANCS.STDIN.userWorkClass)
			PRINT(CUST.WCVAL.workClass1)
			sv_u = urhk_SRV_SetErr(" User does not have enough permission. Contact HO CREDIT ADMIN")
			BANCS.OUTPUT.successOrFailure = "F"
			EXITSCRIPT
		#}
		ENDIF
	#}
	ENDIF

	IF ((CUST.WCVAL.schmCode == "SB199") OR (CUST.WCVAL.schmCode == "CA299")) THEN
	#{
		IF ((BANCS.STDIN.userWorkClass !="080") AND (BANCS.STDIN.userWorkClass !="150") AND (BANCS.STDIN.userWorkClass !="650")) THEN
		#{
			PRINT(BANCS.STDIN.userWorkClass)
			sv_u = urhk_SRV_SetErr(" User does not have enough permission.Transfer to be done by 080 or 150")
			BANCS.OUTPUT.successOrFailure = "F"
			EXITSCRIPT
		#}
		ENDIF
	#}
	ENDIF

	IF (CUST.WCVAL.foracid == "") THEN
	#{		
		IF (CINT(BANCS.STDIN.userWorkClass) < CINT(CUST.WCVAL.workClass2)) THEN
		#{
			PRINT(CUST.WCVAL.workClass2)
			sv_u = urhk_SRV_SetErr("Account Number must be Entered")
			BANCS.OUTPUT.successOrFailure = "F"
			EXITSCRIPT
		#}
		ENDIF
	#}
	ENDIF
#}
ENDIF


ENDOFSCRIPT:
IF (CUST.WCVAL.errMsg != "") THEN
#{
	sv_u = system("echo '"+CUST.WCVAL.errMsg+"' >>ACSCHMFR.log")
#}
ENDIF

#-------------------------------------------------------------------------------------------------------
# Deleting the Class and Repository
#-------------------------------------------------------------------------------------------------------
IF (CLASSEXISTS("CUST","WCVAL") == 1) THEN
#{
    DELETECLASS("CUST","WCVAL")
#}
ENDIF

IF (REPEXISTS("CUST") == 1) THEN
#{
    DELETEREP("CUST")
#}
ENDIF

EXITSCRIPT

TRACE OFF
END-->
