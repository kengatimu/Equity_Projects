					sv_s = sv_s + "  where ENTITY_CRE_FLG='Y' AND ( NEXT_RUN_DATE=?SVAR or NEXT_RUN_DATE is null) AND BANK_ID=?SVAR  and TOTAL_FEES !=AMORTIZED_AMT  and Del_flg ='N' "
