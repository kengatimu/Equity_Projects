							BANCS.INPARAM.BINDVARS = MISS.CHRG.AMRT_AMT + "|" + MISS.CHRG.getboddatenx + "|" + MISS.CHRG.getboddatenow + "|" + MISS.CHRG.getboddatenow + "|" +  MISS.CHRG.Bill_ID + "|" + BANCS.STDIN.contextBankId
							PRINT(BANCS.INPARAM.BINDVARS)
							
							sv_d = urhk_dbSQLWithBind(sv_s)
							print(sv_d)
							sv_d = urhk_dbSQLWithBind("COMMIT")
							print(sv_d)
