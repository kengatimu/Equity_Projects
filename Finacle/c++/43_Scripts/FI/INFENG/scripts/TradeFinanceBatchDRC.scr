							sv_s = " update CUSTOM.trade_finance_CHARGES set AMORTIZED_AMT = ?SVAR,  NEXT_RUN_DATE=?SVAR, LAST_UPDATED=?SVAR, LAST_RUN_DATE=?SVAR "
