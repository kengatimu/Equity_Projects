	sv_a = " Dates |  select to_char(dt,'DD-MON-RRRR') DT from (select to_date((sysdate - 10), 'DD-MM-RRRR') + rownum -1 dt from dual connect by level <= to_date(sysdate, 'DD-MM-RRRR') - to_date((sysdate - 10), 'DD-MM-RRRR') + 1) "
