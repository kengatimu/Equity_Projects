<--START
CHECKSUM="772d77e0cea5ef618e5faaa84b241380f646fe5349d355d76dd854abcbe8fc5e"
TRACE ON
	#------------------------------------------------------------------------------
	#Creating repository and class
	#------------------------------------------------------------------------------
	IF(REPEXISTS("CUSTS") == 0) THEN
	#{
	CREATEREP("CUSTS")
	#}
	ENDIF

	IF(CLASSEXISTS("CUSTS","DATA") == 0) THEN
	#{
	CREATECLASS("CUSTS","DATA",5)
	#}
	ENDIF

	sv_a=urhk_B2k_PrintRepos("BANCS")

	sv_a = urhk_SRV_GetVal("pordCrit.pymtRefNum")
	CUSTS.DATA.pymtRefNum=BANCS.OUTPARAM.srvValue
	print(CUSTS.DATA.pymtRefNum)

	sv_s = " RCRE_USER_ID | select RCRE_USER_ID  from tbaadm.PORD  where PYMT_REF_NUM= ?SVAR AND BANK_ID = ?SVAR "
	BANCS.INPARAM.BINDVARS = CUSTS.DATA.pymtRefNum + "|" + BANCS.STDIN.contextBankId 
	print(sv_s)
	sv_u = urhk_dbselectWithBind(sv_s)
	IF (sv_u ==0) THEN
		CUSTS.DATA.RCRE_USER_ID = BANCS.OUTPARAM.RCRE_USER_ID
		print (CUSTS.DATA.RCRE_USER_ID)
		IF (CUSTS.DATA.RCRE_USER_ID == "FIVUSR43") THEN
			IF ((BANCS.STDIN.userWorkClass!="071") AND (BANCS.STDIN.userWorkClass!="260"))  THEN
				CUSTS.DATA.pymtrefnum = "Channel Payment Order cannot be deleted"
				sv_z = urhk_SetOrbOut("Error|"+ CUSTS.DATA.pymtrefnum)
				print(sv_z)
				sv_f=urhk_SRV_SetErr("Channel Payment Order cannot be deleted")
				BANCS.OUTPUT.successOrFailure="F"
			ENDIF
		ENDIF
	ELSE
		CUSTS.DATA.pymtrefnum = "INVALID PAYMENT ORDER NUMBER"
		sv_z = urhk_SetOrbOut("Error|"+ CUSTS.DATA.pymtrefnum)
		print(sv_z)
		sv_f=urhk_SRV_SetErr("INVALID PAYMENT ORDER NUMBER")
		BANCS.OUTPUT.successOrFailure="F"
		EXITSCRIPT

	ENDIF


TRACE OFF
EXITSCRIPT
END-->
