<--START
CHECKSUM="f46b263b1bf835a248ce231121a887db3e923ffd02902b4abca07b75563273eb"
	TRACE ON
	#------------------------------------------------------------------------------
	#	Creating repository and class
	#	Initializing the variables
	#	Getting all the values from CPARAM
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","LADISB") == 0) THEN
	#{
		CREATECLASS("CUST","LADISB",5)
	#}
	ENDIF
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	sv_u = urhk_b2k_printrepos("BANCS")
	
	CUST.LADISB.errMsg       	= " "
	CUST.LADISB.count    	= 0
	CUST.LADISB.foracid     	= TOUPPER(BANCS.INPUT.acctNum)
	PRINT(CUST.LADISB.foracid)
	CUST.LADISB.crdOpAcctNum 	= BANCS.INPUT.creditAcctNum
	PRINT(CUST.LADISB.crdOpAcctNum)
	CUST.LADISB.funcCode 			= BANCS.INPUT.funcCode
	PRINT(CUST.LADISB.funcCode)
	
	CUST.LADISB.slno 		 =""
	CUST.LADISB.oldForacid1 = ""
	CUST.LADISB.oldLoanCrncyCode1 = ""
	CUST.LADISB.totalAmount1 = ""
	CUST.LADISB.checkFlg1 = ""
	
	CUST.LADISB.totAmt		= 0
	sv_a	= 1
	
	#--------------------------------------------------------------------------
	# Selecting account crncy for the credit account
	#--------------------------------------------------------------------------
	sv_s = ""
	sv_s = "OprAcctCrncyCode|select acct_crncy_code from tbaadm.gam where foracid=?SVAR AND GAM.bank_id = ?SVAR"
	BANCS.INPARAM.BINDVARS = ""
	BANCS.INPARAM.BINDVARS = CUST.LADISB.crdOpAcctNum + "|" +BANCS.STDIN.contextBankId
	sv_q = urhk_dbselectWithBind(sv_s)
	
	PRINT(sv_q)
	IF( sv_q != 0) THEN
	#{
		CUST.LADISB.statFlg = "E"
		CUST.LADISB.errMsg = "Error in fetching the record"
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		CUST.LADISB.OprAcctCrncyCode = BANCS.OUTPARAM.OprAcctCrncyCode
		PRINT(CUST.LADISB.OprAcctCrncyCode)
		#}
		
		#--------------------------------------------------------------------------
		# Selecting accounts, clearBalAmount  from GAM of old loan a/c's
		#--------------------------------------------------------------------------
		sv_s = ""
		sv_s = "oldForacid,acid,clrBalAmt,oldLoanCrncyCode|"
		sv_s = sv_s + " SELECT GAM.foracid,GAM.acid,GAM.clr_bal_amt,GAM.acct_crncy_code"
		sv_s = sv_s + " FROM TBAADM.GAM "
		sv_s = sv_s + " WHERE GAM.schm_type = 'LAA'"
		sv_s = sv_s + " AND GAM.cif_id = ("
		sv_s = sv_s +			   " SELECT GAM.cif_id"
		sv_s = sv_s +	                   	" FROM TBAADM.GAM"
		sv_s = sv_s +			   	" WHERE GAM.foracid = '"+CUST.LADISB.foracid+"'"
		sv_s = sv_s + 			" AND GAM.acct_cls_flg = 'N'"
		sv_s = sv_s + 			" AND GAM.del_flg = 'N'"
		sv_s = sv_s + 			" AND GAM.entity_cre_flg = 'Y'"
		sv_s = sv_s +			   	" AND GAM.bank_id = '"+BANCS.STDIN.contextBankId+"')"
		sv_s = sv_s + " AND GAM.acct_cls_flg = 'N'"
		sv_s = sv_s + " AND GAM.del_flg = 'N'"
		sv_s = sv_s + " AND GAM.entity_cre_flg = 'Y'"
		sv_s = sv_s + " AND GAM.clr_bal_amt < 0"
		sv_s = sv_s + " AND GAM.bank_id = '"+BANCS.STDIN.contextBankId+"'"
		sv_s = sv_s + " AND GAM.foracid != '"+CUST.LADISB.foracid+"'"
		
		sv_p = "recCount|"
		sv_p = sv_p +" SELECT"
		sv_p = sv_p +" COUNT(*)"
		sv_p = sv_p +" FROM"
		sv_p = sv_p +" TBAADM.GAM "
		sv_p = sv_p + " WHERE GAM.schm_type = 'LAA'"
		sv_p = sv_p + " AND GAM.cif_id = ("
		sv_p = sv_p +			   " SELECT GAM.cif_id"
		sv_p = sv_p +	                   	" FROM TBAADM.GAM"
		sv_p = sv_p +			   			" WHERE GAM.foracid = ?SVAR"
		sv_p = sv_p + 						" AND GAM.acct_cls_flg = 'N'"
		sv_p = sv_p + 						" AND GAM.del_flg = 'N'"
		sv_p = sv_p + 						" AND GAM.entity_cre_flg = 'Y'"
		sv_p = sv_p +			   			" AND GAM.bank_id = ?SVAR)"
		sv_p = sv_p + " AND GAM.acct_cls_flg = 'N'"
		sv_p = sv_p + " AND GAM.del_flg = 'N'"
		sv_p = sv_p + " AND GAM.entity_cre_flg = 'Y'"
		sv_p = sv_p + " AND GAM.clr_bal_amt != 0"
		sv_p = sv_p + " AND GAM.bank_id = ?SVAR"
		sv_p = sv_p + " AND GAM.foracid != ?SVAR"
		
		BANCS.INPARAM.BINDVARS = ""
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.foracid  + "|"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId + "|"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId + "|"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.foracid
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_q = urhk_dbselectWithBind(sv_p)
		sv_q = urhk_SetOrbOut("recCount|"+BANCS.OUTPARAM.recCount)
		
		PRINT(sv_s)
		sv_c = urhk_dbCursorOpenWithBind(sv_s)
		PRINT(sv_c)
		
		IF( sv_c != 0) THEN
		#{
			CUST.LADISB.statFlg = "N"
			CUST.LADISB.errMsg = "No records fetched for the entered Account Number"
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			sv_l = BANCS.OUTPARAM.DB_CURSOR_NUMBER
			PRINT(sv_l)
			sv_t = 1
			sv_c = urhk_dbCursorFetch(sv_l)
			PRINT(sv_c)
			
			WHILE( sv_c == 0)
			#{
				CUST.LADISB.oldForacid=BANCS.OUTPARAM.oldForacid
				PRINT(CUST.LADISB.oldForacid)
				CUST.LADISB.acid = BANCS.OUTPARAM.acid
				PRINT(CUST.LADISB.acid)
				CUST.LADISB.clrBalAmt = BANCS.OUTPARAM.clrBalAmt
				PRINT(CUST.LADISB.clrBalAmt)
				CUST.LADISB.oldLoanCrncyCode = BANCS.OUTPARAM.oldLoanCrncyCode
				PRINT(CUST.LADISB.oldLoanCrncyCode)
				CUST.LADISB.count = sv_a
				
				#--------------------------------------------------------------------------------------
				# getting Int route flag from LAM table
				#--------------------------------------------------------------------------------------
				sv_s = ""
				sv_s = sv_s + " intRoute|"
				sv_s = sv_s + " SELECT LAM.int_route_flg"
				sv_s = sv_s + "	FROM TBAADM.LAM"
				sv_s = sv_s + " WHERE LAM.acid ="
				sv_s = sv_s + 			" (SELECT GAM.ACID"
				sv_s = sv_s + 			" FROM TBAADM.GAM"
				sv_s = sv_s + 			" WHERE GAM.FORACID = ?SVAR"
				sv_s = sv_s + 			" AND GAM.acct_cls_flg = 'N'"
				sv_s = sv_s + 			" AND GAM.del_flg = 'N'"
				sv_s = sv_s + 			" AND GAM.entity_cre_flg = 'Y'"
				sv_s = sv_s + 			" AND GAM.bank_id = ?SVAR)"
				sv_s = sv_s + " AND LAM.del_flg='N'"
				sv_s = sv_s + " AND LAM.entity_cre_flg = 'Y'"
				sv_s = sv_s + " AND LAM.bank_id = ?SVAR"
				
				PRINT(sv_s)
				BANCS.INPARAM.BINDVARS = ""
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.oldForacid + "|"
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId + "|"
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
				
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbselectWithBind(sv_s)
				PRINT(sv_d)
				
				IF ( sv_d != 0 ) THEN
				#{
					CUST.LADISB.statFlg = "E"
					CUST.LADISB.errMsg = "Error occured in calculating old Loan O/S amount"
					PRINT(CUST.LADISB.errMsg)
					GOTO ENDOFSCRIPT
					#}
				ELSE
					#{
					CUST.LADISB.intRoute = BANCS.OUTPARAM.intRoute
					PRINT(CUST.LADISB.intRoute)
				#}
				ENDIF
				
				#--------------------------------------------------------------------------------------
				#getting interest amt through loan a/c's
				#--------------------------------------------------------------------------------------
				IF(CUST.LADISB.intRoute == "L") THEN
				#{
					sv_s = "interest|"
					sv_s = sv_s + " SELECT"
					sv_s = sv_s + " (nvl(nrml_interest_amount_dr"
					sv_s = sv_s + " - nrml_booked_amount_dr,0) +"
					sv_s = sv_s + " nvl(penal_interest_amount_dr"
					sv_s = sv_s + " -penal_booked_amount_dr,0))"
					sv_s = sv_s + " FROM TBAADM.EIT"
					sv_s = sv_s + " WHERE EIT.entity_id = ?SVAR"
					sv_s = sv_s + " AND EIT.entity_type = 'ACCNT'"
					sv_s = sv_s + " AND EIT.bank_id = ?SVAR"
					
					BANCS.INPARAM.BINDVARS = ""
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.acid + "|"
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
					
					sv_q = urhk_dbSelectWithBind(sv_s)
					CUST.LADISB.interest = BANCS.OUTPARAM.interest
					PRINT(CUST.LADISB.interest)
					#}
				ELSE
					#{
					sv_s = "interest|"
					sv_s = sv_s + " SELECT"
					sv_s = sv_s + " (nvl(nrml_interest_amount_dr"
					sv_s = sv_s + " - nrml_booked_amount_dr,0) +"
					sv_s = sv_s + " nvl(penal_interest_amount_dr"
					sv_s = sv_s + " -penal_booked_amount_dr,0)"
					sv_s = sv_s + " + nvl(LAM.INT_DMD_OS,0)"
					sv_s = sv_s + " + nvl(LAM.BCHG_DMD_OS,0)"
					sv_s = sv_s + " + nvl(LAM.OCHG_DMD_OS,0))"
					sv_s = sv_s + " FROM TBAADM.EIT,TBAADM.LAM"
					sv_s = sv_s + " WHERE EIT.entity_id = ?SVAR"
					sv_s = sv_s + " AND EIT.entity_type = 'ACCNT'"
					sv_s = sv_s + " AND EIT.bank_id = ?SVAR"
					sv_s = sv_s + " AND LAM.acid = ?SVAR"
					sv_s = sv_s + " AND LAM.del_flg='N'"
					sv_s = sv_s + " AND LAM.entity_cre_flg = 'Y'"
					sv_s = sv_s + " AND LAM.bank_id = ?SVAR"
					
					BANCS.INPARAM.BINDVARS = ""
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.acid + "|"
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId + "|"
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.acid + "|"
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
					
					sv_q = urhk_dbSelectWithBind(sv_s)
					CUST.LADISB.interest = BANCS.OUTPARAM.interest
					PRINT(CUST.LADISB.interest)
				#}
				ENDIF
				#-------------------------------------------------------------
				#calculating total amount of each old loan a/c
				#-------------------------------------------------------------
				
				CUST.LADISB.totAmt = CDOUBLE(CUST.LADISB.clrBalAmt) + CDOUBLE(CUST.LADISB.interest)
				IF(CDOUBLE(CUST.LADISB.totAmt) < 0) THEN
				#{
					CUST.LADISB.totAmt = -1 * CDOUBLE(CUST.LADISB.totAmt)
					PRINT(CUST.LADISB.totAmt)
					sv_s= "totalAmount| "
					sv_s = sv_s + "SELECT TRUNC(?SVAR,2)"
					sv_s = sv_s + "FROM DUAL "
					
					BANCS.INPARAM.BINDVARS = ""
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.totAmt
					PRINT(sv_s)
					sv_q = urhk_dbSelectWithBind(sv_s)
					IF(sv_q != 0) THEN
					#{
						CUST.LADISB.statFlg = "E"
						CUST.LADISB.errMsg = "Error occured in Truncating the Amount"
						PRINT(CUST.LADISB.errMsg)
						GOTO ENDOFSCRIPT
						#}
					ELSE
						#{
						CUST.LADISB.totalAmount = BANCS.OUTPARAM.totalAmount
						PRINT(CUST.LADISB.totalAmount)
					#}
					ENDIF
				#}
				ENDIF
				
				#================================================================
				#Checking if record is already present in custom table
				#================================================================
				sv_s = ""
				sv_s = "checkCount|SELECT COUNT(*) FROM CUSTOM.C_LADISB_PAYOFF_OLDLOAN "
				sv_s = sv_s + "WHERE LOAN_FORACID =?SVAR AND OLD_FORACID = ?SVAR "
				
				BANCS.INPARAM.BINDVARS = CUST.LADISB.foracid + "|" + CUST.LADISB.oldForacid
				PRINT(sv_s)
				PRINT(BANCS.INPARAM.BINDVARS)
				
				sv_q = urhk_dbSelectWithBind(sv_s)
				PRINT(sv_q)
				IF(sv_q != 0) THEN
				#{
					CUST.LADISB.statFlg = "E"
					CUST.LADISB.errMsg = "Error occured in Truncating the Amount"
					PRINT(CUST.LADISB.errMsg)
					GOTO ENDOFSCRIPT
					#}
				ELSE
					#{
					CUST.LADISB.checkCount = BANCS.OUTPARAM.checkCount
					PRINT(CUST.LADISB.checkCount)
					IF(CUST.LADISB.checkCount > 0) THEN
					#{
						CUST.LADISB.checkFlg = "Y"
						#}
					ELSE
						#{
						CUST.LADISB.checkFlg = "N"
					#}
					ENDIF
					PRINT(CUST.LADISB.checkFlg)
				#}
				ENDIF
				
				#================================================================
				#Putting Comma for the amt
				#================================================================
				sv_s= "totalAmount1| "
				sv_s = sv_s + "SELECT TO_CHAR(?SVAR,'999,999,999,999,999,999,999,990.99')"
				sv_s = sv_s + "FROM DUAL "
				BANCS.INPARAM.BINDVARS = ""
				BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.totalAmount
				
				sv_q = urhk_dbSelectWithBind(sv_s)
				CUST.LADISB.totalAmount = BANCS.OUTPARAM.totalAmount1
				
				CUST.LADISB.statFlg = "D"
				CUST.LADISB.errMsg = "Records are present"
				
				CUST.LADISB.OprAcctCrncyCode = CUST.LADISB.oldLoanCrncyCode
				
				PRINT(CUST.LADISB.count)
				PRINT(CUST.LADISB.oldForacid)
				PRINT(CUST.LADISB.oldLoanCrncyCode)
				PRINT(CUST.LADISB.totalAmount)
				
				CUST.LADISB.slno = CUST.LADISB.slno + "!~" +format$(sv_t,"%d")+ "!" + CUST.LADISB.count
				CUST.LADISB.oldForacid1 = CUST.LADISB.oldForacid1 + "!~" +format$(sv_t,"%d")+ "!" + CUST.LADISB.oldForacid
				CUST.LADISB.oldLoanCrncyCode1 = CUST.LADISB.oldLoanCrncyCode1 + "!~" +format$(sv_t,"%d")+ "!" + CUST.LADISB.oldLoanCrncyCode
				CUST.LADISB.totalAmount1 =CUST.LADISB.totalAmount1 + "!~" +format$(sv_t,"%d")+ "!" + TRIM(CUST.LADISB.totalAmount)
				CUST.LADISB.checkFlg1 =CUST.LADISB.checkFlg1 + "!~" +format$(sv_t,"%d")+ "!" + CUST.LADISB.checkFlg
				
				sv_t = sv_t +1
				PRINT(sv_t)
				
				sv_c = urhk_dbCursorFetch(sv_l)
				PRINT(sv_c)
				sv_a = sv_a + 1
			#}
			DO
			sv_c = urhk_dbCursorClose(sv_l)
		#}
		ENDIF
		
		ENDOFSCRIPT:
			
			PRINT(CUST.LADISB.statFlg)
			PRINT(CUST.LADISB.errMsg)
			
			sv_u = urhk_SetOrbOut("statFlg|"+CUST.LADISB.statFlg)
			PRINT(sv_u)
			sv_u = urhk_SetOrbOut("errorMsg|"+CUST.LADISB.errMsg)
			PRINT(sv_u)
			
			IF(CUST.LADISB.statFlg == "D") THEN
			#{
				sv_u = urhk_SetOrbOut("slno|"+CUST.LADISB.slno)
				PRINT(sv_u)
				sv_u = urhk_SetOrbOut("oldForacid|"+CUST.LADISB.oldForacid1)
				PRINT(sv_u)
				sv_u = urhk_SetOrbOut("oldLoanCrncyCode|"+CUST.LADISB.oldLoanCrncyCode1)
				PRINT(sv_u)
				sv_u = urhk_SetOrbOut("totalAmount|"+CUST.LADISB.totalAmount1)
				PRINT(sv_u)
				sv_u = urhk_SetOrbOut("checkFlg|"+CUST.LADISB.checkFlg1)
				PRINT(sv_u)
			#}
			ENDIF
			#-------------------------------------------------------------------------------
			# Deleting custom repositories and classes created
			#-------------------------------------------------------------------------------
			IF(CLASSEXISTS("CUST","LADISB") == 1) THEN
			#{
				DELETECLASS("CUST","LADISB")
			#}
			ENDIF
			
			IF(REPEXISTS("CUST") == 1) THEN
			#{
				DELETEREP("CUST")
			#}
			ENDIF
			
			EXITSCRIPT
			TRACE OFF
	END-->
	
	
