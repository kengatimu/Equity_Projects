	sv_e = urhk_setorbOut("RESULT_MSG|Interest Adjustment Done for Account "+CUST.EQB.lAcctId+". Transaction Id for Reference:  " + CUST.EQB.tranId)
	sv_e = urhk_setorbOut("SuccessOrFailure|Y")
	INSERT:
	sv_s = "Insert into CUSTOM.clia (Loan_Accnt,Operative_Accnt,Crncy_Code,Adj_Amt,Finacle_Int,Legacy_Int,Adj_Till_Date,Tran_Id,Tran_date,rcre_time, rcre_user_id, bank_id)"
