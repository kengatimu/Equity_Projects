					#{
						("CUST").("EQB").("XcpnCodeType" + sv_i) = ("BANCS").("OUTPARAM").("XcpnCodeType_" + sv_i)
						("CUST").("EQB").("XcpnCode" + sv_i) = ("BANCS").("OUTPARAM").("XcpnCode_" + sv_i)
						("CUST").("EQB").("XcpnDesc" + sv_i) = ("BANCS").("OUTPARAM").("XcpnDesc_" + sv_i)
						("CUST").("EQB").("XcpnAcctDesc" + sv_i) = ("BANCS").("OUTPARAM").("XcpnAcctDesc_" + sv_i)
						("CUST").("EQB").("XcpnCondInd" + sv_i) = ("BANCS").("OUTPARAM").("XcpnCondInd_" + sv_i)
						("CUST").("EQB").("XcpnContextInfo" + sv_i) = ("BANCS").("OUTPARAM").("XcpnContextInfo_" + sv_i)
						sv_i = FORMAT$(CINT(sv_i) + 1,"%d")
					#}
					DO
