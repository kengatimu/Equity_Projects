						sv_a = ("CUST").("EQB").("XcpnCode" + sv_i) + "|Y|" + ("CUST").("EQB").("XcpnAcctDesc" + sv_i) + "|"
						sv_a = sv_a + ("CUST").("EQB").("XcpnCondInd" + sv_i) + "|" + ("CUST").("EQB").("XcpnCode" + sv_i) + " -"
						sv_a = sv_a + BANCS.STDIN.BODDate + "-" + " "
