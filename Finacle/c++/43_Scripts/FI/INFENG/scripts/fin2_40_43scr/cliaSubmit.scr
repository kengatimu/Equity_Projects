	sv_a = urhk_SetUrhkInp("tranHdr.tranIdentifier.tranDate|"+CUST.EQB.tranDate)
	
	sv_s = urhk_ExecSrvNoCommit("SRV_FetchTranDtlsForPost|same_user_verify = Y|retain_all_output = Y")
	IF(sv_s != 0) THEN
	#{
		##Checking if Service has returned any Error message.
                IF (BANCS.OUTPARAM.Error_num > 0) THEN
                #{
                        sv_i = "1"
                        sv_n = CINT(BANCS.OUTPARAM.Error_num)
                        WHILE(CINT(sv_i) <= sv_n)
                        #{
                                ("CUST").("EQB").("ErrorMesg_" + sv_i) = ("BANCS").("OUTPARAM").("ErrorMesg_" + sv_i)
                                ("CUST").("EQB").("Tag_" + sv_i) = ("BANCS").("OUTPARAM").("Tag_" + sv_i)
                                sv_i = FORMAT$(CINT(sv_i) + 1,"%d")
                        #}
                        DO
                        ##end of While Loop

                        sv_i = "1"
                        WHILE(CINT(sv_i) <= sv_n)
                        #{
                                sv_e = urhk_setorberr(("CUST").("EQB").("ErrorMesg_" + sv_i) + "-" + ("CUST").("EQB").("Tag_" + sv_i))
                                sv_i = FORMAT$(CINT(sv_i) + 1,"%d")
                        #}
                        DO
                        ##end of While Loop
                        #}
                ELSE
                        #{
                        ##send the generic error message to Finbranch
                        sv_e = urhk_setorberr("Transaction creation Failed.")
                #}
                ENDIF
                GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_s = urhk_CopyOutToIn("")
	IF(sv_s != 0) THEN
	#{
		##send the generic error message to Finbranch
		sv_e = urhk_setorberr("Transaction creation Failed.")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_s = urhk_ExecSRVNoCommit("SRV_PostTran|same_user_verify = Y|retain_all_output = Y")
	
	##Checking if any Error has Occurred
	IF (sv_s != 0) THEN
	#{
		
		##Checking if Service has returned any Error message.
		IF (BANCS.OUTPARAM.Error_num > 0) THEN
		#{
			sv_i = "1"
			sv_n = CINT(BANCS.OUTPARAM.Error_num)
			WHILE(CINT(sv_i) <= sv_n)
			#{
				("CUST").("EQB").("ErrorMesg_" + sv_i) = ("BANCS").("OUTPARAM").("ErrorMesg_" + sv_i)
				("CUST").("EQB").("Tag_" + sv_i) = ("BANCS").("OUTPARAM").("Tag_" + sv_i)
				sv_i = FORMAT$(CINT(sv_i) + 1,"%d")
			#}
