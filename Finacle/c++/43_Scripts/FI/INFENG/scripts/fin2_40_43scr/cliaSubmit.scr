	BANCS.INPARAM.BINDVARS = CUST.EQB.lAcctId + "|" +CUST.EQB.loanOpAcct + "|" + CUST.EQB.crncyCode+ "|" + CUST.EQB.currentAdjAmt+ "|" + CUST.EQB.finInt
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS  + "|" +CUST.EQB.totLegInt  + "|" + CUST.EQB.finIntDate+ "|" +CUST.EQB.tranId+ "|" +MID$(CUST.EQB.tranDate,0,10) + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_d = urhk_dbSqlWithBind(sv_s)
	PRINT(sv_d)
	
	IF(sv_d != 0)THEN
	#{
		CUST.EQB.errorFlg="Y"
		CUST.EQB.errorMsg="Error in DB operation"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	ENDOFSCRIPT:
		IF(CUST.EQB.errorFlg == "Y")THEN
		#{
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			PRINT(sv_u)
			sv_z = urhk_SetOrbErr(CUST.EQB.errorMsg)
