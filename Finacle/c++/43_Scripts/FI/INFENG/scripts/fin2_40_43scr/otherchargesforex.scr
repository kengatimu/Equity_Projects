<--start

#===========================================================================================*
# Name                         	:   .scr
# Date                         	:   13-nov-2008
# Description                   :   The MTT script is used for generating Eazzy24/7 ministatement charges 
# Author                       	:   Revathi Duraisamy
# Called Scripts                :    <none>
# Calling Script                :    <none>
# Reference                    	:
# Modification History  :
#  <Serial No.>  <Date>         <AuthorName>          	<Description>
#--------------------------------------------------------------------------
# 	1		13-11-2008	ERIC KAROBIA 				Original version
# 	1       	12-02-2013    	Chethan.S  				Modified according to 10x standards.
#   	2 		24-07-2019 	James Irungu     			Add new commission bacid (hologram,westerunion,smsfee)
#============================================================================================*


TRACE ON

sv_u=urhk_B2k_PrintRepos("BANCS")
print(sv_u)


#-----------------------------------------------------------------
# Initialise is used to Check whether Class ATM exists.
# If not then creates that class.
# 5 stands for String Type data.
#-----------------------------------------------------------------
Initialise:
#{
	sv_r = REPEXISTS("CUST")
	IF (sv_r == 0) THEN
		CREATEREP("CUST")
	ENDIF

	sv_r = CLASSEXISTS("CUST", "ATM")
	IF (sv_r == 0) THEN
		CREATECLASS("CUST", "ATM", 5)
	ENDIF
#{
#------------------------------------------------------------------
#  Getting account to debit
# 
#------------------------------------------------------------------
print(BANCS.OUTPUT.CrForacid)
print(BANCS.OUTPUT.Foracid)
CUST.ATM.crAccount=BANCS.OUTPUT.CrForacid
CUST.ATM.drAccount=BANCS.OUTPUT.Foracid
CUST.ATM.DccId=BANCS.OUTPUT.DccId
CUST.ATM.narr1="MINISTATEMENT-CHARGE"

#GOTO ENDOFSCRIPT



IF (BANCS.STDIN.contextBankId =="43") THEN
	IF (CUST.ATM.DccId=="BRK") THEN
		#IF (BANCS.OUTPUT.CrForacid == "")  THEN
			BANCS.INPUT.moduleName  = "ATM"
			BANCS.INPUT.parameterId = "BACID_8"
			
			sv_u = urhk_getAcctDetailsInRepository(CUST.ATM.drAccount)
			print(sv_u)
			IF (sv_u != 0) THEN
				BANCS.OUTPUT.RespCode = "99"
				BANCS.OUTPUT.successOrFailure = "F"
				GOTO ENDOFSCRIPT
			ELSE
				CUST.ATM.solid = BANCS.OUTPARAM.acctSolId
				print(CUST.ATM.solid)
				CUST.ATM.schmcodesh = BANCS.OUTPARAM.schmCode
				print(CUST.ATM.schmcodesh)
				CUST.ATM.schmType = BANCS.OUTPARAM.schmType
				print(CUST.ATM.schmType)
				CUST.ATM.acctCrncyCodecr = BANCS.OUTPARAM.acctCrncyCode
				print(CUST.ATM.acctCrncyCodecr)
				CUST.ATM.clearBalance = BANCS.OUTPARAM.clearBalance
				print(CUST.ATM.clearBalance)
				CUST.ATM.EffAvailableAmttr = BANCS.OUTPARAM.EffAvailableAmt
				print(CUST.ATM.EffAvailableAmttr)
				CUST.ATM.lienAmt = BANCS.OUTPARAM.lienAmt
				print(CUST.ATM.lienAmt)
			
				###

			ENDIF
			CUST.ATM.bacid="CARDFEE"
			print(CUST.ATM.bacid)
			####
			IF (FIELDEXISTS(BANCS.INPUT.ReservedField2)) THEN
				IF (BANCS.INPUT.ReservedField2=="CARDFEE") THEN
					CUST.ATM.bacid="ATMDLRY"
					print(CUST.ATM.bacid)
				ENDIF
				IF (BANCS.INPUT.ReservedField2=="EBANKINGMAINTFEE") THEN
					CUST.ATM.bacid="DHLDLRY"
					print(CUST.ATM.bacid)
				ENDIF
				IF (BANCS.INPUT.ReservedField2=="EBANKINGNATTRANSFEE") THEN
					CUST.ATM.bacid="RTGSCOMM"
					print(CUST.ATM.bacid)
				ENDIF
				IF (BANCS.INPUT.ReservedField2=="EBANKINGINTTRANSFEE") THEN
					CUST.ATM.bacid="SWIFTCOMM"
					print(CUST.ATM.bacid)
				ENDIF
				IF (BANCS.INPUT.ReservedField2=="MBANKINGTRANSFEE") THEN
					CUST.ATM.bacid="MOBILE"
					print(CUST.ATM.bacid)
				ENDIF
				IF (BANCS.INPUT.ReservedField2=="CHEQUEFEE") THEN
					CUST.ATM.bacid="CHQREJ"
					print(CUST.ATM.bacid)
				ENDIF
				IF (BANCS.INPUT.ReservedField2=="INTINCOMINGFEE") THEN
					CUST.ATM.bacid="SWIFTCOMM"
					print(CUST.ATM.bacid)
				ENDIF
				IF (BANCS.INPUT.ReservedField2=="NATINCOMINGFEE") THEN
					CUST.ATM.bacid="RTGSCOMM"
					print(CUST.ATM.bacid)
				ENDIF
				IF (BANCS.INPUT.ReservedField2=="FRAISINT") THEN
					CUST.ATM.bacid="FRAISINT"
					print(CUST.ATM.bacid)
				ENDIF
				IF (BANCS.INPUT.ReservedField2=="BSVCOMM") THEN
					CUST.ATM.bacid="BSVCOMM"
					print(CUST.ATM.bacid)
				ENDIF			
				IF (BANCS.INPUT.ReservedField2=="SMSFEE") THEN
					CUST.ATM.bacid="EBNKFEE"
					print(CUST.ATM.bacid)
				ENDIF
				IF (BANCS.INPUT.ReservedField2=="HOLOCLFEE") THEN
					CUST.ATM.bacid="COMEXCH"
					print(CUST.ATM.bacid)
				ENDIF
				IF (BANCS.INPUT.ReservedField2=="HOLOSTFEE") THEN
					CUST.ATM.bacid="COMMHOLO"
					print(CUST.ATM.bacid)
				ENDIF
				IF (BANCS.INPUT.ReservedField2=="HOLOFEE") THEN
					CUST.ATM.bacid="COMCERT"
					print(CUST.ATM.bacid)
				ENDIF
				IF (BANCS.INPUT.ReservedField2=="WUFEE") THEN
					CUST.ATM.bacid="PNLWEST"
					print(CUST.ATM.bacid)
				ENDIF
			ENDIF
			####
			
			print(BANCS.STDIN.contextBankId)
			print(BANCS.STDIN.homeCrncyCode)
			sv_s = "contra "
			sv_s = sv_s + " | "
			sv_s = sv_s + " SELECT foracid "
			sv_s = sv_s + " FROM GAM "
			sv_s = sv_s + " WHERE sol_id = ?SVAR "
			sv_s = sv_s + " AND bacid = ?SVAR "
			sv_s = sv_s + " AND del_flg ='N' "
			sv_s = sv_s + " AND GAM.bank_id = ?SVAR "
			sv_s = sv_s + " AND ACCT_CRNCY_CODE = ?SVAR "
			BANCS.INPARAM.BINDVARS = CUST.ATM.solid + "|" + CUST.ATM.bacid + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.homeCrncyCode
			print(sv_s)
			sv_d =urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			IF (sv_d == "0") THEN
				BANCS.OUTPUT.CrForacid = BANCS.OUTPARAM.contra
				print(BANCS.OUTPUT.CrForacid)
				CUST.ATM.crAccountincome = BANCS.OUTPUT.CrForacid
				print(CUST.ATM.crAccountincome)
			ELSE
				BANCS.OUTPUT.RespCode = "99"
				BANCS.OUTPUT.successOrFailure = "F"
				GOTO ENDOFSCRIPT
			ENDIF
		#ENDIF
	ENDIF
ENDIF


IF (BANCS.OUTPUT.CrForacid == "") THEN
	CUST.ATM.Amount = "0"   		
	GOTO ENDOFSCRIPT
ELSE

print(BANCS.INPUT.Command)

IF (BANCS.INPUT.Command == "") THEN
	CUST.ATM.Amount = "0"   		
	GOTO ENDOFSCRIPT
ELSE

	CUST.ATM.cmd=BANCS.INPUT.Command 
	
ENDIF

BANCS.INPUT.moduleName = "ATM"
BANCS.INPUT.parameterId = "EVENT_ID"
CALL ("atmgetcparamvalue.scr")
print(BANCS.OUTPUT.parameterVal)

IF(BANCS.OUTPUT.parameterVal != "")THEN
#{
        CUST.ATM.eventId= BANCS.OUTPUT.parameterVal
#}
ELSE
#{
        CUST.ATM.errMsg = "eventid setup not done in CPARAM"
        GOTO ENDOFSCRIPT
#}
ENDIF

BANCS.INPUT.parameterId = "EVENT_TYPE_1"
CALL ("atmgetcparamvalue.scr")
print(BANCS.OUTPUT.parameterVal)

IF(BANCS.OUTPUT.parameterVal != "")THEN
#{
        CUST.ATM.eventType = BANCS.OUTPUT.parameterVal
#}
ELSE
#{
        CUST.ATM.errMsg = "eventid setup not done in CPARAM"
        GOTO ENDOFSCRIPT
#}
ENDIF


#--------------------------------------------------------------------------
# getting the amount to split
#--------------------------------------------------------------------------
BANCS.INPUT.TranAmt=cdouble(BANCS.INPUT.TranAmt)/cdouble("100")
print(BANCS.INPUT.TranAmt)
PRINT(BANCS.INPUT.SerialNum)

IF (BANCS.INPUT.TranAmt == "0") THEN
	CUST.ATM.Amount = "0"   		
	GOTO ENDOFSCRIPT
ELSE
	CUST.ATM.Amount=BANCS.INPUT.TranAmt
	#--------------------------------------------------------------------------
	# Create the narration
	#--------------------------------------------------------------------------
	sv_e = MID$(BANCS.STDIN.BODDate,0,10)
	print(sv_e)
	sv_s = "sysdate "
	sv_s = sv_s + " | "
	sv_s = sv_s + " SELECT TO_CHAR((TO_DATE(?SVAR,'DD-MM-YYYY')),'DD-MM-YYYY') "
	sv_s = sv_s + " FROM DUAL"
	BANCS.INPARAM.BINDVARS = sv_e
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF (sv_d =="0") THEN
		CUST.ATM.sysdate = BANCS.OUTPARAM.sysdate
		IF (CUST.ATM.DccId=="BRK") THEN 
			CUST.ATM.narr1 ="EXCHANGE_TRANSACTION " + "/" + BANCS.INPUT.SerialNum + "/" + CUST.ATM.sysdate
		ENDIF
	ELSE
	 GOTO ENDOFSCRIPT
	ENDIF
	#--------------------------------------------------------------------------
	# Initialise the MTT repository
	#--------------------------------------------------------------------------

		sv_r = REPEXISTS("MTT")
		IF (sv_r == 0) THEN
			CREATEREP("MTT")
		ENDIF

		sv_r = CLASSEXISTS("MTT","TranDetails")
		IF (sv_r == 0) THEN
			CREATECLASS("MTT","TranDetails",5)
		ENDIF

		sv_r = CLASSEXISTS("MTT","PartTranDetails")
		IF (sv_r == 0) THEN
			CREATECLASS("MTT","PartTranDetails",5)
		ENDIF

		sv_r = REPEXISTS("BANCS")
		IF (sv_r == 0) THEN
			CREATEREP("BANCS")
		ENDIF

		sv_r = CLASSEXISTS("BANCS","INPARAM")
		IF (sv_r == 0) THEN
			CREATECLASS("BANCS","INPARAM",5)
		ENDIF

		MTT.TranDetails.TranDate="0"
		MTT.TranDetails.TranType="T"
		MTT.TranDetails.TranSubType="CI"

		BANCS.INPARAM.PostTranFlg = "Y"
		BANCS.INPARAM.InsertTranWithValidnFlg = "N"
		BANCS.INPARAM.CommitFlg="N"
		BANCS.INPARAM.RestrictModifyInd="FIRST_GROUP"
		BANCS.INPARAM.ErrorCheckForLuw="Y"
		BANCS.INPARAM.CheckExceptions="N"

		sv_u = urhk_MTTS_Initialize("")
		print(sv_u)


		sv_v = "PurchaseComm"
		print(sv_v)

		sv_u = urhk_MTTS_DefineTransaction("PurchaseComm")

		sv_u = urhk_MTTS_PopulateInputDetails("")
		
		sv_b = BANCS.INPUT.TranAmt

		#--------------------------------------------------
		# Income To EQUITY PURCHASES COMM A/C
		#--------------------------------------------------
	
			CUST.ATM.crAccountpool=CUST.ATM.crAccount
			print(CUST.ATM.crAccountpool)
			MTT.PartTranDetails.Account = CUST.ATM.crAccountpool
			MTT.PartTranDetails.RefCurrency = CUST.ATM.statusbill2
			#MTT.PartTranDetails.RateCode = "CRC"
			MTT.PartTranDetails.Rate = BANCS.INPUT.ReservedField1
			MTT.PartTranDetails.ValueDateDiff = "0"
			MTT.PartTranDetails.Particulars = CUST.ATM.narr1
			MTT.PartTranDetails.Particulars2 = BANCS.INPUT.DeviceId
			MTT.PartTranDetails.RefAmount = sv_b
			print(MTT.PartTranDetails.RefAmount)
			MTT.PartTranDetails.Remarks = BANCS.INPUT.SerialNum
			MTT.PartTranDetails.RefNum = BANCS.INPUT.ReservedField3
			MTT.PartTranDetails.IgnoreExcp = "I"
			MTT.PartTranDetails.Consolidate = "N"
			MTT.PartTranDetails.TranIdentifier = sv_v
			MTT.ChargeDetails.EventType = CUST.ATM.eventType
			MTT.ChargeDetails.EventId = CUST.ATM.eventId
			sv_e = "PurchaseIncome"
			sv_u = urhk_MTTS_DefineChargePartTran(sv_e)
			print(sv_u)

		#------------------------------------------------------------------
		# Debit Partran To MERCHANT PURCHASES COMM A/C
		#------------------------------------------------------------------
			print(CUST.ATM.drAccount)
			MTT.PartTranDetails.Account = CUST.ATM.drAccount
			MTT.PartTranDetails.RefCurrency = CUST.ATM.statusbill2
			#MTT.PartTranDetails.RateCode = "CRC"
			MTT.PartTranDetails.Rate = BANCS.INPUT.ReservedField1
			MTT.PartTranDetails.ValueDateDiff = "0"
			MTT.PartTranDetails.Particulars = CUST.ATM.narr1
			MTT.PartTranDetails.Particulars2 = BANCS.INPUT.DeviceId
			MTT.PartTranDetails.RefAmount = -1 * CDOUBLE(sv_b) 
			MTT.PartTranDetails.Remarks = BANCS.INPUT.SerialNum 
			MTT.PartTranDetails.RefNum = BANCS.INPUT.ReservedField3
			MTT.PartTranDetails.IgnoreExcp = "I"
			MTT.PartTranDetails.Consolidate = "N"
			MTT.PartTranDetails.TranIdentifier = sv_v
			sv_h = "D" + CUST.ATM.drAccount
			sv_u = urhk_MTTS_definePartTran(sv_h)
			sv_u = urhk_MTTS_EndDefinition("")
			print(sv_u)

			########
				CUST.ATM.TranAmtfee="0"
				IF (BANCS.INPUT.StlmntFee!="") THEN
					sv_a=BANCS.INPUT.StlmntFee
					print(sv_a)
					sv_a = MID$(sv_a,12,16)
					print(sv_a)
					CUST.ATM.TranAmtfee =sv_a
					print(CUST.ATM.TranAmtfee)
				ENDIF
			########

			CUST.ATM.splitAmount = CDOUBLE(CUST.ATM.TranAmtfee)
			print(CUST.ATM.splitAmount)
			
			if (CINT(CUST.ATM.splitAmount) > 0) then 
			
				#--------------------------------------------------
				# Income To EQUITY PURCHASES COMM A/C
				#--------------------------------------------------

				MTT.PartTranDetails.Account = CUST.ATM.crAccountincome
				MTT.PartTranDetails.RefCurrency = CUST.ATM.statusbill2
				#MTT.PartTranDetails.RateCode = "CRC"
				MTT.PartTranDetails.Rate = BANCS.INPUT.ReservedField1
				MTT.PartTranDetails.ValueDateDiff = "0"
				MTT.PartTranDetails.Particulars = CUST.ATM.narr1
				MTT.PartTranDetails.Particulars2 = BANCS.INPUT.DeviceId
				MTT.PartTranDetails.RefAmount = CUST.ATM.splitAmount
				print(MTT.PartTranDetails.RefAmount)
				MTT.PartTranDetails.Remarks = BANCS.INPUT.SerialNum
				MTT.PartTranDetails.RefNum = BANCS.INPUT.ReservedField3
				MTT.PartTranDetails.IgnoreExcp = "I"
				MTT.PartTranDetails.Consolidate = "N"
				MTT.PartTranDetails.TranIdentifier = sv_v
				MTT.ChargeDetails.EventType = CUST.ATM.eventType
				MTT.ChargeDetails.EventId = CUST.ATM.eventId
				sv_e = "PurchaseIncome"
				sv_u = urhk_MTTS_DefineChargePartTran(sv_e)
				print(sv_u)

				#------------------------------------------------------------------
				# Debit Partran To MERCHANT PURCHASES COMM A/C 
				#------------------------------------------------------------------

				MTT.PartTranDetails.Account = CUST.ATM.drAccount
				MTT.PartTranDetails.RefCurrency = CUST.ATM.statusbill2
				#MTT.PartTranDetails.RateCode = "CRC"
				MTT.PartTranDetails.Rate = BANCS.INPUT.ReservedField1
				MTT.PartTranDetails.ValueDateDiff = "0"
				MTT.PartTranDetails.Particulars = CUST.ATM.narr1
				MTT.PartTranDetails.Particulars2 = BANCS.INPUT.DeviceId
				MTT.PartTranDetails.RefAmount = -1 * CDOUBLE(CUST.ATM.splitAmount)
				MTT.PartTranDetails.Remarks = BANCS.INPUT.SerialNum 
				MTT.PartTranDetails.RefNum = BANCS.INPUT.ReservedField3
				MTT.PartTranDetails.IgnoreExcp = "I"
				MTT.PartTranDetails.Consolidate = "N"
				MTT.PartTranDetails.TranIdentifier = sv_v
				sv_h = "D" + CUST.ATM.drAccount
				sv_u = urhk_MTTS_definePartTran(sv_h)
				sv_u = urhk_MTTS_EndDefinition("")
				print(sv_u)
			endif
			########
			sv_u = urhk_MTTS_Close("")
		        print(sv_u)

			print(BANCS.OUTPARAM.MTTTranId)
ENDIF
ENDOFSCRIPT:

###exitscript
####TRACE OFF
END-->