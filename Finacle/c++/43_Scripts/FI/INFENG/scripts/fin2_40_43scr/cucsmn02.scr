			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_s = "delete from custom.C_CUCS where ACCT_NUMBER=?SVAR AND CHEQUE_NUM =?SVAR AND BANK_ID = ?SVAR AND ENTITY_CRE_FLG='N'"
			
