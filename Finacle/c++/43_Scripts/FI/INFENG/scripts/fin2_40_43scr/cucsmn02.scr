	#----------------------------------------------------------------------------
	# FUNCTION VERIFY
	#----------------------------------------------------------------------------
	
	IF(CUST.CUCS.funcCode == "V") THEN
	#{
		
		BANCS.INPARAM.BINDVARS = CUST.CUCS.acctNo + "|" + CUST.CUCS.chqNo + "|" + BANCS.STDIN.contextBankId
		
		PRINT(BANCS.INPARAM.BINDVARS)
		
		sv_s = "recCount|SELECT 1 FROM DUAL WHERE EXISTS("
		sv_s = sv_s + " SELECT 1 FROM CUSTOM.C_CUCS_MOD"
		sv_s = sv_s + " WHERE ACCT_NUMBER=?SVAR AND CHEQUE_NUM =?SVAR AND BANK_ID = ?SVAR)"
		
		PRINT(sv_s)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)
		IF(sv_d == 0) THEN
		#{
			BANCS.INPARAM.BINDVARS = CUST.CUCS.acctNo + "|" + CUST.CUCS.chqNo + "|" + BANCS.STDIN.contextBankId
		
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_s = "status|SELECT status FROM CUSTOM.C_CUCS_MOD"
			sv_s = sv_s + " WHERE ACCT_NUMBER=?SVAR AND CHEQUE_NUM =?SVAR AND BANK_ID = ?SVAR"
			
			PRINT(sv_s)
			
			sv_d = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_d)
			IF(sv_d == 0)THEN
			#{
				CUST.CUCS.status_mod = BANCS.OUTPARAM.status
			#}
			ELSE
			#{
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				PRINT(sv_u)
				sv_u = urhk_SetOrbOut("Error_1|Error^Failed to fetch data^status")
				PRINT(sv_u)
