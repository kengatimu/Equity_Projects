			#}
			ENDIF
			
			######################################################
			#Unmark Lien
			######################################################
				
				sv_s= "acid,ACCT_CRNCY_CODE,CLR_BAL_AMT,sol_id|SELECT ACID,ACCT_CRNCY_CODE,CLR_BAL_AMT,sol_id FROM TBAADM.GAM WHERE FORACID=?SVAR AND BANK_ID=?SVAR AND ENTITY_CRE_FLG = 'Y' AND DEL_FLG = 'N'"
				BANCS.INPARAM.BINDVARS = CUST.CUCS.acctNo + "|"+ BANCS.STDIN.contextBankId
				sv_q = urhk_dbSelectWithBind(sv_s)
				PRINT(sv_q)
				IF(sv_q == 0)THEN
				#{
					CUST.CUCS.acid = BANCS.OUTPARAM.acid
					CUST.CUCS.acctCrncy = BANCS.OUTPARAM.ACCT_CRNCY_CODE
					CUST.CUCS.actcrncy = BANCS.OUTPARAM.ACCT_CRNCY_CODE
					CUST.CUCS.CLR_BAL_AMT = BANCS.OUTPARAM.CLR_BAL_AMT
					CUST.CUCS.sol_id = BANCS.OUTPARAM.sol_id
					PRINT(CUST.CUCS.acid)
				#}
				ELSE
				#{
					
					sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
					PRINT(sv_u)
					sv_u = urhk_SetOrbOut("Error_1|Error^Couldn't Fetch Account details^status")
					PRINT(sv_u)
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				
				CUST.CUCS.lienMark = "N"
				CUST.CUCS.lienAmt = CUST.CUCS.chqAmt
				CUST.CUCS.ACCT_NUMBER = CUST.CUCS.acctNo
				CUST.CUCS.actcrncy = CUST.CUCS.acctCrncy
				CALL("CUCS_LIEN.scr")
				IF(CUST.CUCS.LienSuccessOrFailure == "S")THEN
				#{
					
					CUST.CUCS.remark = " Lien removed on pending amount " + CUST.CUCS.lienAmt + CUST.CUCS.acctCrncy
					CUST.CUCS.resultMsg = CUST.CUCS.remark
					CUST.CUCS.ENTITY_CRE_FLG = 'Y'
					CUST.CUCS.LIEN_FLG = 'N'
					sv_u = urhk_SetOrbOut("RESULT_MSG|"+CUST.CUCS.resultMsg)
					PRINT(sv_u)					
				#}
				ELSE
				#{
					PRINT("LIEN UPDATION FAILED")
					CUST.CUCS.remark = "LIEN UPDATION FAILED-"+CUST.CUCS.LienFailureReason
					CUST.CUCS.ENTITY_CRE_FLG = 'N'
					CUST.CUCS.LIEN_FLG = 'Y'
					sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
					sv_u = urhk_SetOrbOut("Error_1|Error^"+CUST.CUCS.remark+"^status")
					PRINT(sv_u)
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			IF(CUST.CUCS.status_mod == "P")THEN
			#{
				CUST.CUCS.chk_tran = ""
				CALL("cucsdp02.scr")
				IF(CUST.CUCS.chk_tran =="F")THEN
				#{
					sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
					sv_u = urhk_SetOrbOut("Error_1|Error^"+CUST.CUCS.remark+"^status")
					PRINT(sv_u)
					GOTO ENDOFSCRIPT
				#}
				ENDIF
					sv_s = "UPDATE CUSTOM.C_CUCS_MOD SET STATUS = 'P',PAID_AMT = ?SVAR,TRAN_ID=?SVAR, TRAN_DATE = SYSDATE,LCHG_TIME=SYSDATE,LCHG_USER_ID=?SVAR,REMARKS=?SVAR"
					sv_s = sv_s + " WHERE  ACCT_NUMBER = ?SVAR AND CHEQUE_NUM = ?SVAR AND DEL_FLG = 'N' "
					sv_s = sv_s + " AND ENTITY_CRE_FLG = 'N' AND BANK_ID = ?SVAR"
					BANCS.INPARAM.BINDVARS = CUST.CUCS.paidAmt + "|" + CUST.CUCS.TRAN_ID + "|" + BANCS.STDIN.userId + "|" + CUST.CUCS.remark 
					BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CUCS.acctNo + "|" + CUST.CUCS.chqNo + "|" + BANCS.STDIN.contextBankId
					sv_b = urhk_dbSqlWithBind(sv_s)
					
					IF(sv_b == 0)THEN
					#{
						CUST.CUCS.resultMsg = "Certified cheque Paid Fully/Partially and lien removed successfully.TRAN_ID -"+ CUST.CUCS.TRAN_ID
						sv_u = urhk_SetOrbOut("RESULT_MSG|"+CUST.CUCS.resultMsg)
						PRINT(sv_u)
						sv_z = urhk_SetOrbOut("SuccessOrFailure|Y")
						PRINT(sv_z)	

						#GOTO ENDOFSCRIPT
					#}
					ELSE
					#{
						sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
						sv_u = urhk_SetOrbOut("Error_1|Error^Failed to Release Certified Cheque^acctNo")
						PRINT(sv_u)
						GOTO ENDOFSCRIPT
					#}
					ENDIF
				
			#}
			ENDIF
			
			##########################################################################################################################
			##############################################
			#uPDATE CHEQUE STATUS
			##############################################
			CUST.CUCS.update_stat = "Success"
			#CALL("cucsdp03.scr")
			#IF(CUST.CUCS.update_stat == "Failure")THEN
			##{
			#	sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			#	PRINT(sv_u)
			#	sv_u = urhk_SetOrbOut("Error_1|Error^Failed to update the cheque status^status")
			#	PRINT(sv_u)
			#	GOTO ENDOFSCRIPT
			#	
			##}
			#ENDIF
			
			
			BANCS.INPARAM.BINDVARS = CUST.CUCS.ENTITY_CRE_FLG + "|" +CUST.CUCS.LIEN_FLG+ "|" + BANCS.STDIN.userId + "|" + CUST.CUCS.acctNo + "|" + CUST.CUCS.chqNo + "|" + BANCS.STDIN.contextBankId
			
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_s = "update custom.C_CUCS_MOD set"
			sv_s = sv_s + " ENTITY_CRE_FLG =?SVAR,LIEN_FLG = ?SVAR,"
			sv_s = sv_s + " LCHG_USER_ID=?SVAR,"
			sv_s = sv_s + " LCHG_TIME = sysdate"
			sv_s = sv_s + " where ACCT_NUMBER=?SVAR AND CHEQUE_NUM =?SVAR AND BANK_ID = ?SVAR"
			
			PRINT(sv_s)
			sv_d = urhk_dbSqlWithBind(sv_s)
			PRINT(sv_d)
			IF(sv_d != 0) THEN
			#{
				#ERROR
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				PRINT(sv_u)
				sv_u = urhk_SetOrbOut("Error_1|Error^Database Updation Failed^status")
				PRINT(sv_u)
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			
			BANCS.INPARAM.BINDVARS = CUST.CUCS.acctNo + "|" + CUST.CUCS.chqNo + "|" + BANCS.STDIN.contextBankId
			
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_s = "delete from custom.C_CUCS where ACCT_NUMBER=?SVAR AND CHEQUE_NUM =?SVAR AND BANK_ID = ?SVAR"
			
			PRINT(sv_s)
			
			sv_d = urhk_dbSqlWithBind(sv_s)
			IF(sv_d != 0) THEN
			#{
				#ERROR
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				PRINT(sv_u)
				sv_u = urhk_SetOrbOut("Error_1|Error^Database delete Failed^status")
				PRINT(sv_u)
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			BANCS.INPARAM.BINDVARS = CUST.CUCS.acctNo + "|" + CUST.CUCS.chqNo + "|" + BANCS.STDIN.contextBankId
			
			PRINT(BANCS.INPARAM.BINDVARS)
			
			
			sv_s = "insert into custom.C_CUCS select * from custom.C_CUCS_MOD where  ACCT_NUMBER=?SVAR AND CHEQUE_NUM =?SVAR AND BANK_ID = ?SVAR"
			
			PRINT(sv_s)
			sv_d = urhk_dbSqlWithBind(sv_s)
			IF(sv_d != 0) THEN
			#{
				#ERROR
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				PRINT(sv_u)
				sv_u = urhk_SetOrbOut("Error_1|Error^Database insertion Failed^status")
				PRINT(sv_u)
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			BANCS.INPARAM.BINDVARS = CUST.CUCS.acctNo + "|" + CUST.CUCS.chqNo + "|" + BANCS.STDIN.contextBankId
			
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_s = "delete from custom.C_CUCS_MOD where ACCT_NUMBER=?SVAR AND CHEQUE_NUM =?SVAR AND BANK_ID = ?SVAR"
			
			PRINT(sv_s)
			
			sv_d = urhk_dbSqlWithBind(sv_s)
			IF(sv_d != 0) THEN
			#{
				#ERROR
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				PRINT(sv_u)
				sv_u = urhk_SetOrbOut("Error_1|Error^Database deletion Failed^status")
				PRINT(sv_u)
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			#}
		ELSE
			#{
			
			sv_s= "ACCT_CRNCY_CODE|SELECT ACCT_CRNCY_CODE FROM TBAADM.GAM WHERE FORACID=?SVAR AND BANK_ID=?SVAR AND ENTITY_CRE_FLG = 'Y' AND DEL_FLG = 'N'"
			BANCS.INPARAM.BINDVARS = CUST.CUCS.acctNo + "|"+ BANCS.STDIN.contextBankId
			sv_q = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_q)
			IF(sv_q == 0)THEN
			#{
				CUST.CUCS.acctCrncy = BANCS.OUTPARAM.ACCT_CRNCY_CODE
			#}
			ELSE
			#{
				CUST.CUCS.remark = "Couldn't Fetch Credit Account details"
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				PRINT(sv_u)
				sv_u = urhk_SetOrbOut("Error_1|Error^Couldn't Fetch Account details^status")
				PRINT(sv_u)
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			sv_s = "amt|SELECT CHEQUE_AMT FROM CUSTOM.C_CUCS WHERE ACCT_NUMBER = ?SVAR AND CHEQUE_NUM = ?SVAR AND DEL_FLG = 'N' "
			sv_s = sv_s + " AND ENTITY_CRE_FLG = 'N' AND BANK_ID = ?SVAR"
			BANCS.INPARAM.BINDVARS = CUST.CUCS.acctNo + "|" + CUST.CUCS.chqNo + "|" + BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_b = urhk_dbSelectWithBind(sv_s)
			PRINT(sv_b)
			IF(sv_b == 0)THEN
			#{
				CUST.CUCS.chqAmt = BANCS.OUTPARAM.amt			
			#}
			ENDIF
			
			#########################################################
			#CHARGE_COLLECTED -  calculation and collection
			#########################################################
			CUST.CUCS.collection = "Failure"
			CALL("cucsdp01.scr")
			
			
			IF(CUST.CUCS.collection == "Failure")THEN
			#{
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				PRINT(sv_u)
				sv_u = urhk_SetOrbOut("Error_1|Error^Failed to collect the charge Amount^status")
				PRINT(sv_u)
				GOTO ENDOFSCRIPT
				
			#}
			ELSE
			#{
				CUST.CUCS.CHARGE_COLLECTED = CUST.CUCS.paidAmt
				CUST.CUCS.CHARGE_TRAN_ID = CUST.CUCS.tranid
				CUST.CUCS.CHARGE_TRAN_DATE = CUST.CUCS.trandate
				CUST.CUCS.PAID_AMT = "0"
				CUST.CUCS.remark ="Charge collected successfully"
			#}
			ENDIF
		
			
			# Mark lien
				CUST.CUCS.lienAmt = CUST.CUCS.chqAmt
				CUST.CUCS.lienMark = "Y"
				CUST.CUCS.ACCT_NUMBER = CUST.CUCS.acctNo
				CUST.CUCS.actcrncy = CUST.CUCS.acctCrncy
				CALL("CUCS_LIEN.scr")
				IF(CUST.CUCS.LienSuccessOrFailure == "S")THEN
				#{
					CUST.CUCS.LIEN_FLG = "Y"
					CUST.CUCS.LIEN_APPLIED_AMT = CUST.CUCS.chqAmt
					CUST.CUCS.remark ="Marked lien and collected charge successfully Charge Amount:"+CUST.CUCS.CHARGE_COLLECTED+ CUST.CUCS.acctCrncy+" tranId : " + CUST.CUCS.CHARGE_TRAN_ID
					CUST.CUCS.status = "Y"
					CUST.CUCS.ENTITY_CRE_FLG = "Y"
					#}
				ELSE
					#{
					PRINT("LIEN UPDATION FAILED")
					CUST.CUCS.ENTITY_CRE_FLG = "N"
					CUST.CUCS.LIEN_FLG = "N"
					CUST.CUCS.remark = CUST.CUCS.LienFailureReason
					CUST.CUCS.remark ="Failed to Marked lien on cheque amt and collected charge successfully" 
					sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
					PRINT(sv_u)
					sv_u = urhk_SetOrbOut("Error_1|Error^"+CUST.CUCS.LienFailureReason+"^status")
					PRINT(sv_u)
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			##############################################
			#uPDATE CHEQUE STATUS
			##############################################
			#CUST.CUCS.update_stat = "Success"
			#CALL("cucsdp03.scr")
			#IF(CUST.CUCS.update_stat == "Failure")THEN
			##{
			#	sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			#	PRINT(sv_u)
			#	sv_u = urhk_SetOrbOut("Error_1|Error^Failed to update the cheque status^status")
			#	PRINT(sv_u)
			#	GOTO ENDOFSCRIPT
				
			##}
			#ENDIF
			
			BANCS.INPARAM.BINDVARS = CUST.CUCS.ENTITY_CRE_FLG + "|" +CUST.CUCS.LIEN_FLG + "|" +CUST.CUCS.remark + "|" +CUST.CUCS.CHARGE_COLLECTED + "|" + CUST.CUCS.CHARGE_TRAN_ID 
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.CUCS.acctNo + "|" + CUST.CUCS.chqNo + "|" + BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_s = "update custom.C_CUCS set ENTITY_CRE_FLG=?SVAR,LIEN_FLG = ?SVAR,REMARKS = ?SVAR,CHARGE_COLLECTED = ?SVAR,CHARGE_TRAN_ID =?SVAR,CHARGE_TRAN_DATE=SYSDATE "
			sv_s = sv_s + " where ACCT_NUMBER=?SVAR AND CHEQUE_NUM =?SVAR AND BANK_ID = ?SVAR"
			
			PRINT(sv_s)
			sv_d = urhk_dbSqlWithBind(sv_s)
			IF(sv_d != 0) THEN
			#{
				#ERROR
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				PRINT(sv_u)
				sv_u = urhk_SetOrbOut("Error_1|Error^Database Updation Failed^status")
				PRINT(sv_u)
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
		#}
		ENDIF
		if(CUST.CUCS.remark == "")then
		#{
			CUST.CUCS.resultMsg = "Record has been Verified successfully"
		#}
		else
		#{
			CUST.CUCS.resultMsg = CUST.CUCS.remark
		#}
		endif
		sv_u = urhk_SetOrbOut("RESULT_MSG|"+CUST.CUCS.resultMsg)
		PRINT(sv_u)
		GOTO SUCCESS
	#}
	ENDIF
	#----------------------------------------------------------------------------
	# FUNCTION Delete
	#----------------------------------------------------------------------------
	IF(CUST.CUCS.funcCode == "X") THEN
	#{
		
