		#}
	ELSE
		#{
		IF ((BANCS.INPUT.funCode != "P") AND (BANCS.INPUT.funCode != "U")) THEN
		#{
			sv_e = "Inavlid funCode code. Valid codes are P-Process,U-Upload"
			sv_m = "funCode"
			sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
