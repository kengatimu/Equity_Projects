		PRINT(BANCS.OUTPARAM.envValue)
	#}
	ENDIF
	
	#------------------------------------------------------------------------------------------
	# Validating The values of funCode
	#------------------------------------------------------------------------------------------
	IF (BANCS.INPUT.funCode == "") THEN
	#{
		sv_e = "funCode code should be entered"
		sv_m = "funCode"
		sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
