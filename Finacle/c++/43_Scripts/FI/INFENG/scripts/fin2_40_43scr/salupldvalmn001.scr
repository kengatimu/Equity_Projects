		sv_s = sv_s + "AND bank_id = ?SVAR"
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS = CUST.SLAMNT.empID + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_u = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
			CUST.SLAMNT.count = BANCS.OUTPARAM.Count
			PRINT(CUST.SLAMNT.count)
			
			IF (CINT(CUST.SLAMNT.count) == 0) THEN
			#{
				sv_e = "Invalid Employer ID"
				sv_m = "empID"
				sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
	#}
