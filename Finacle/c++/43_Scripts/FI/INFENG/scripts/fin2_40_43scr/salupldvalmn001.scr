	#---------------------------------------------------------------------------
	#The foll step is to Validate Dr A/c Number
	#---------------------------------------------------------------------------
	CUST.SLAMNT.drAcctID = TRIM(BANCS.INPUT.foracid)
	PRINT(CUST.SLAMNT.drAcctID)
	
	IF ( CUST.SLAMNT.drAcctID == "" ) THEN
	#{
		sv_e = "Debit A/c should be entered"
		sv_m = "foracid"
		sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		sv_s = "acctCnt|SELECT COUNT(*) "
		sv_s = sv_s + "FROM TBAADM.GAM "
		sv_s = sv_s + "WHERE foracid = ?SVAR "
		sv_s = sv_s + "AND entity_cre_flg = 'Y' "
		sv_s = sv_s + "AND del_flg != 'Y' "
		sv_s = sv_s + "AND acct_cls_flg != 'Y'"
		sv_s = sv_s + "AND bank_id = ?SVAR"
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS = CUST.SLAMNT.drAcctID + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF (CINT(BANCS.OUTPARAM.acctCnt) == 0 ) THEN
		#{
			sv_e = "Invalid A/c"
			sv_m = "foracid"
			sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		sv_s = "drAcctCrncy|SELECT GAM.acct_crncy_code "
		sv_s = sv_s + "FROM TBAADM.GAM "
		sv_s = sv_s + "WHERE foracid = ?SVAR "
		sv_s = sv_s + "AND entity_cre_flg = 'Y' "
		sv_s = sv_s + "AND del_flg != 'Y' "
		sv_s = sv_s + "AND acct_cls_flg != 'Y'"
		sv_s = sv_s + "AND bank_id = ?SVAR"
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS = CUST.SLAMNT.drAcctID + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF (sv_d == 0 ) THEN
		#{
			CUST.SLAMNT.drAcctCrncy = BANCS.OUTPARAM.drAcctCrncy
			print(CUST.SLAMNT.drAcctCrncy)
			#}
		ELSE
			#{
			sv_e = "Error in finding Dr account currency code"
			sv_m = "foracid"
			sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	#---------------------------------------------------------------------------
	#The foll step is to Validate Upload Type
	#---------------------------------------------------------------------------
	CUST.SLAMNT.upldType = TRIM(BANCS.INPUT.upldType)
	PRINT(CUST.SLAMNT.upldType)
