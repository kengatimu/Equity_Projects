	#---------------------------------------------------------------------------
	#The foll step is to Validate Charge Code
	#---------------------------------------------------------------------------
	CUST.SLAMNT.chargecode = TRIM(BANCS.INPUT.chargecode)
	PRINT(CUST.SLAMNT.chargecode)
	
	IF ((BANCS.INPUT.funCode == "U") AND (CUST.SLAMNT.chargecode == "")) THEN
	#{
		sv_e = "Charge Code should be entered"
		sv_m = "chargecode"
		sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
		sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
		GOTO ENDOFSCRIPT
		#}
	ELSE
		#{
		IF ((BANCS.INPUT.funCode == "U") AND (CUST.SLAMNT.chargecode != "")) THEN
		#{
			#---------------------------------------
			#Cparam
			#-----------------------------------
			BANCS.INPUT.moduleName = "CSALBPP"
			BANCS.INPUT.parameterId = "CHRG_AMT"
			
			CALL ("getcparamvalue.scr")
			IF (BANCS.OUTPUT.parameterVal != "")THEN
			#{
				print(BANCS.OUTPUT.parameterVal)
				CUST.SLAMNT.chrgAmount = BANCS.OUTPUT.parameterVal
				#}
			ELSE
				#{
				sv_e = "Cparam setup not done for CHRG_AMT"
				sv_m = "chargecode"
				sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			BANCS.INPARAM.InputAmount = CUST.SLAMNT.chrgAmount
			BANCS.INPARAM.CurrencyCode = BANCS.STDIN.homeCrncyCode
			BANCS.INPARAM.AmountTableCode = TRIM(CUST.SLAMNT.chargecode)
			PRINT(CUST.SLAMNT.chargecode)
			
			sv_u = urhk_B2k_GetASTMAmount("")
			PRINT(sv_u)
			
			IF (sv_u == 1) THEN
			#{
				sv_e = "Invalid Charge Code"
				sv_m = "chargecode"
				sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
				sv_u = urhk_SetOrbOut(sv_e)
				sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
				CUST.SLAMNT.chrg_Amt = BANCS.OUTPARAM.OutputAmount
				PRINT(CUST.SLAMNT.chrg_Amt)
				IF (CINT(CUST.SLAMNT.chrg_Amt) != 0) THEN
				#{
					CUST.SLAMNT.chrgFlg = "Y"
					CUST.SLAMNT.chrgUplFlg = "Y"
					#}
				ELSE
					#{
					CUST.SLAMNT.chrgFlg = "N"
					CUST.SLAMNT.chrgUplFlg = "N"
				#}
				ENDIF
				
				PRINT(CUST.SLAMNT.chrgFlg)
				PRINT(CUST.SLAMNT.chrgUplFlg)
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	IF (BANCS.INPUT.funCode == "P")  THEN
	#{
		CUST.SLAMNT.chrgFlg = "N"
		CUST.SLAMNT.chrgUplFlg = "N"
		
		#---------------------------------------------------------------------------
		#Deleting partially upload records from C_SUP
		#---------------------------------------------------------------------------
		sv_s = "DELETE FROM CUSTOM.C_SUP "
		sv_s = sv_s + "WHERE employer = ?SVAR "
		sv_s = sv_s + "AND rcre_user_id = ?SVAR "
		sv_s = sv_s + "AND bank_id = ?SVAR"
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS = CUST.SLAMNT.empID + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSQLWithBind(sv_s)
		PRINT(sv_d)
		IF (sv_d == 0) THEN
