		# Calling common script to append userId to upload file path
		#---------------------------------------------------------------
		CALL("appendUserId.scr")
		CUST.SLAMNT.upldPath = BANCS.INPUT.upldPath
		print(CUST.SLAMNT.upldPath)
	#}
	ENDIF
	
	#------------------------------------------------------------
	# Taking the upload file path
	#------------------------------------------------------------
	sv_u = urhk_getEnv("FILE_PATH")
	PRINT(sv_u)
	sv_u = 0
	IF (sv_u != 0) THEN
	#{
		sv_z = urhk_SetOrbOut("Error_01|ERROR^Upload file path is not set in common ENV^testMode")
