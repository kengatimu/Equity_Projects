		#	sv_s = sv_s + "FROM DUAL"
		#	sv_d = urhk_dbSelectWithBind(sv_s)
		#	print(sv_d)
		#	IF (sv_d == 0) THEN
		#	#{
		#		CUST.SLAMNT.sysdate = BANCS.OUTPARAM.sysdate
		#	#}
		#	ENDIF
		CUST.SLAMNT.comUpldFilePath = CUST.SLAMNT.upldPath + CUST.SLAMNT.fileName
		print(CUST.SLAMNT.comUpldFilePath)
		sv_a = "test -f " + CUST.SLAMNT.upldPath + CUST.SLAMNT.fileName
		sv_r = SYSTEM(sv_a)
		print(sv_r)
		#	sv_a = "sed 's/$/|'" + BANCS.STDIN.contextBankId + "'/g' " + CUST.SLAMNT.upldPath + CUST.SLAMNT.fileName  + " > saltmp_" + CUST.SLAMNT.sysdate + ".txt "
		#    print(sv_a)
		#    sv_r = SYSTEM(sv_a)
		PRINT(sv_r)
		IF (sv_r != 0) THEN
		#{
			sv_e = "The Upload File name does not exist OR the wrong uploadfile name"
			sv_m = "fileName"
			sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
			sv_u = urhk_SetOrbOut(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#	CUST.SLAMNT.fileNameNew = "saltmp_" + CUST.SLAMNT.sysdate + ".txt"
		#	print(CUST.SLAMNT.fileNameNew)
	#}
	ENDIF
	
	#---------------------------------------------------------------------------
	#The foll step is to Validate Mismatch Flag
	#---------------------------------------------------------------------------
	CUST.SLAMNT.nameMismatch = TRIM(BANCS.INPUT.nameMismatch)
	PRINT(CUST.SLAMNT.nameMismatch)
	
	IF (CUST.SLAMNT.nameMismatch == "") THEN
	#{
		sv_e = "A/c Name Mismatch? Flag should be entered"
