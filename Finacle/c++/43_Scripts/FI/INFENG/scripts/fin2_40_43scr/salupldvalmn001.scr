		ENDIF
	#}
	ENDIF
	
	#---------------------------------------------------------------------------
	#The foll step is to Validate Test Mode Flag
	#---------------------------------------------------------------------------
	CUST.SLAMNT.testMode = (BANCS.INPUT.testMode)
	PRINT(CUST.SLAMNT.testMode)
	
	IF ((BANCS.INPUT.funCode == "U") AND (CUST.SLAMNT.testMode == "")) THEN
	#{
		sv_e = "Test Mode Flag should be entered"
		sv_m = "testMode"
		sv_e = "Error_0|ERROR:^"+ sv_e +".^"+ sv_m +""
		sv_u = urhk_SetOrbOut(sv_e)
