<--START
	TRACE ON
	
	sv_r = urhk_B2k_PrintRepos("BANCS")
	PRINT(sv_r)
	
	###########################################################################################
	# Check whether CUST Repository exists else create it
	###########################################################################################
	
	sv_r = REPEXISTS("CUST")
	PRINT(sv_r)
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	###########################################################################################
	# Check whether EQB Class exists else create it
	###########################################################################################
	
	sv_r = CLASSEXISTS("CUST","EQB")
	PRINT(sv_r)
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","EQB",5)
	#}
	ENDIF
	
	CUST.EQB.errorFlg="N"
	CUST.EQB.errorMsg="NA"
	
	##################################
	#  Validate Script#
	##################################
	
	CALL("cliaValidate.scr")
	
	IF(CUST.EQB.errorFlg == "Y")THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	##################################
	# Calculate Finacle Interest Till Date#
	##################################
	
	CUST.EQB.intDate=CUST.EQB.finIntDate
	PRINT(CUST.EQB.intDate)
	
	CALL("calcFinacleInt.scr")
	
	IF(CUST.EQB.errorFlg == "Y")THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	PRINT(CUST.EQB.finInt)
	
	CUST.EQB.totFinInt=CUST.EQB.finInt
	PRINT(CUST.EQB.totFinInt)
	
	##################################
	# Calculate Finacle System Interest #
	##################################
	
	sv_s = "intCnt|"
	sv_s = sv_s + "select count(1) from tbaadm.int_adm where acid=?SVAR AND start_date < to_date(?SVAR,'dd-mm-yyyy') AND bank_id=?SVAR"
	PRINT(sv_s)
	
	BANCS.INPARAM.BINDVARS = CUST.EQB.lAcid+"|"+CUST.EQB.migDate+"|"+BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_r = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_r)
	
	IF (sv_r == "0") THEN
	#{
		CUST.EQB.intCnt=BANCS.OUTPARAM.intCnt
		PRINT(CUST.EQB.intCnt)
	#}
	ELSE
	#{
		CUST.EQB.errorFlg="Y"
		CUST.EQB.errorMsg="Unable to retrieve Finacle SYSTEM Interest"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF(CUST.EQB.intCnt != 0)THEN
	#{			
		CUST.EQB.intDate=CUST.EQB.migDate
		PRINT(CUST.EQB.intDate)
		
		CALL("calcFinacleInt.scr")
		
		IF(CUST.EQB.errorFlg == "Y")THEN
		#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		PRINT(CUST.EQB.finInt)
		
		CUST.EQB.totFinInt=CDOUBLE(CUST.EQB.totFinInt)-CDOUBLE(CUST.EQB.finInt)
		PRINT(CUST.EQB.totFinInt)
	#}
	ENDIF
	
	CUST.EQB.finInt=CUST.EQB.totFinInt
	PRINT(CUST.EQB.finInt)
	
	##################################
	# Calculate Legacy System Interest till Finacle Interest booking date#
	##################################
	
	CUST.EQB.intDate=CUST.EQB.finIntDate
	PRINT(CUST.EQB.intDate)
	
	CALL("calcLegacyInt.scr")
	
	IF(CUST.EQB.errorFlg == "N")THEN
	#{
		CUST.EQB.totLegInt=CUST.EQB.legInt
		PRINT(CUST.EQB.totLegInt)
		#}
	ELSE
		#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	PRINT(CUST.EQB.migDate)
	
	##################################
	# Legacy System interest should be calculated from Migration date -1#
	##################################
	
	sv_s = "intDate|"
	sv_s = sv_s + "select to_char(to_date(?SVAR,'dd-mm-yyyy')-1,'dd-mm-yyyy') from dual"
	PRINT(sv_s)
	
	BANCS.INPARAM.BINDVARS = CUST.EQB.migDate
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_r = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_r)
	
	IF (sv_r == "0") THEN
	#{
		CUST.EQB.intDate=BANCS.OUTPARAM.intDate
		PRINT(CUST.EQB.intDate)
		#}
	ELSE
		#{
		CUST.EQB.errorFlg="Y"
		CUST.EQB.errorMsg="Unable to fetch Migration Date"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	CALL("calcLegacyInt.scr")
	
	##################################
	# Legacy System interest  from Migration date -1 to interest booking date#
	##################################
	
	IF(CUST.EQB.errorFlg == "N")THEN
	#{
		PRINT(CUST.EQB.legInt)
		
		CUST.EQB.totLegInt=CDOUBLE(CUST.EQB.totLegInt)-CDOUBLE(CUST.EQB.legInt)
		PRINT(CUST.EQB.totLegInt)
		#}
	ELSE
		#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	
	##################################
	# Calculate already adjusted amount#
	##################################
	
	sv_s = "alreadyAdjAmt|"
	sv_s = sv_s + "select sum(nvl(adj_amt,'0.00')) from custom.clia where Loan_Accnt=?SVAR  AND bank_id=?SVAR"
	PRINT(sv_s)
	
	BANCS.INPARAM.BINDVARS = CUST.EQB.lAcctId+"|"+BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_r = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_r)
	
	IF (sv_r == "0") THEN
	#{
		CUST.EQB.alreadyAdjAmt=BANCS.OUTPARAM.alreadyAdjAmt
		PRINT(CUST.EQB.alreadyAdjAmt)
		#}
	ELSE
		#{
		CUST.EQB.alreadyAdjAmt=CDOUBLE("0.00")
		PRINT(CUST.EQB.alreadyAdjAmt)
	#}
	ENDIF
	
	#################################
	# Fetch Loan Operative Account#
	##################################
	
	sv_s = "loanOpAcct,rate_code|"
	sv_s = sv_s + "select b.foracid,nvl(a.ds_rate_code,'NA') from tbaadm.lam a,tbaadm.gam b where a.acid=?SVAR AND a.bank_id=?SVAR AND a.OP_ACID=b.acid"
	PRINT(sv_s)
	
	BANCS.INPARAM.BINDVARS = CUST.EQB.lAcid+"|"+BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_r = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_r)
	
	IF (sv_r == "0") THEN
	#{
		
		CUST.EQB.loanOpAcct=BANCS.OUTPARAM.loanOpAcct
		PRINT(CUST.EQB.loanOpAcct)
		CUST.EQB.rate_code=BANCS.OUTPARAM.rate_code
		PRINT(CUST.EQB.rate_code)
		
		#}
	ELSE
		#{
		CUST.EQB.errorFlg="Y"
		CUST.EQB.errorMsg="Unable to fetch Operative Account"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF(CUST.EQB.rate_code == "NA")THEN
	#{
		##################################
		# Fetch Repay Rate Code#
		##################################
		
		sv_s = "rate_code|"
		sv_s = sv_s + "select nvl(REPAY_RATE_CODE,'NA') from tbaadm.gct where bank_id=?SVAR"
		PRINT(sv_s)
		
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		
		sv_r = urhk_dbSelectWithBind(sv_s)
		PRINT(sv_r)
		
		IF (sv_r == "0") THEN
		#{
			CUST.EQB.rate_code=BANCS.OUTPARAM.rate_code
			PRINT(CUST.EQB.rate_code)
			
			IF(CUST.EQB.rate_code == "NA")THEN
			#{
				CUST.EQB.errorFlg="Y"
				CUST.EQB.errorMsg="Repayment Rate Code not maintained"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			#}
		ELSE
			#{
			CUST.EQB.errorFlg="Y"
			CUST.EQB.errorMsg="Unable to fetch Repayment Rate Code"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	##################################
	# Calculate current adjusted amount#
	##################################
	
	IF(CUST.EQB.acctCrncyCode != CUST.EQB.finIntCcy)THEN
	#{
		##################################
		#Rate Conversion
		##################################
		
		BANCS.INPARAM.InputAmount = CDOUBLE(CUST.EQB.finInt)
		BANCS.INPARAM.FromCurrency = CUST.EQB.finIntCcy
		BANCS.INPARAM.ToCurrency = CUST.EQB.acctCrncyCode
		BANCS.INPARAM.RateCode = CUST.EQB.rate_code
		BANCS.INPARAM.Rate = ""
		
		sv_s = urhk_B2k_ConvertAmount("")
		PRINT(sv_s)
		
		IF (sv_s != 0) THEN
		#{
			CUST.EQB.errorFlg="Y"
			CUST.EQB.errorMsg="Invalid Rate Passed / Rate not maintained"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		CUST.EQB.finInt = CDOUBLE(BANCS.OUTPARAM.OutputAmount)
		PRINT(CUST.EQB.finInt)
	#}
	ENDIF
	
	
	
	CUST.EQB.currentAdjAmt=CDOUBLE(CUST.EQB.finInt)-CDOUBLE(CUST.EQB.alreadyAdjAmt)-CDOUBLE(CUST.EQB.totLegInt)
	PRINT(CUST.EQB.currentAdjAmt)
	
	##################################
	# Display Variable values#
	##################################
	CUST.EQB.finInt=format$(CDOUBLE(CUST.EQB.finInt),"%12.02f")
	PRINT(CUST.EQB.finInt)
	
	CUST.EQB.totLegInt=format$(CDOUBLE(CUST.EQB.totLegInt),"%12.02f")
	PRINT(CUST.EQB.totLegInt)
	
	CUST.EQB.alreadyAdjAmt=format$(CDOUBLE(CUST.EQB.alreadyAdjAmt),"%12.02f")
	PRINT(CUST.EQB.alreadyAdjAmt)
	
	CUST.EQB.currentAdjAmt=format$(CDOUBLE(CUST.EQB.currentAdjAmt),"%12.02f")
	PRINT(CUST.EQB.currentAdjAmt)
	
	
	PRINT(CUST.EQB.loanOpAcct)
	PRINT(CUST.EQB.rate_code)
	PRINT(CUST.EQB.finIntDate)
	PRINT(CUST.EQB.lAcctId)
	PRINT(CUST.EQB.acctCrncyCode)
	ENDOFSCRIPT:
		IF(CUST.EQB.errorFlg == "Y")THEN
		#{
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			PRINT(sv_u)
			sv_z = urhk_SetOrbErr(CUST.EQB.errorMsg)
			PRINT(sv_z)
			#}
		ELSE
			#{
			sv_u = urhk_SetOrbOut("SuccessOrFailure|Y")
			PRINT(sv_u)
			sv_u = urhk_SetOrbOut("finInt|"+CUST.EQB.finInt)
			PRINT(sv_u)
			#sv_u = urhk_SetOrbOut("chrgPerTxn|"+CUST.EQB.lAcctId)
			#PRINT(sv_u)
			sv_u = urhk_SetOrbOut("finIntDate|"+CUST.EQB.finIntDate)
			PRINT(sv_u)
			sv_u = urhk_SetOrbOut("rateCode|"+CUST.EQB.rate_code)
			PRINT(sv_u)
			sv_u = urhk_SetOrbOut("crncyCode|"+CUST.EQB.acctCrncyCode)
			PRINT(sv_u)
			sv_u = urhk_SetOrbOut("loanOpAcct|"+CUST.EQB.loanOpAcct)
			PRINT(sv_u)
			sv_u = urhk_SetOrbOut("currentAdjAmt|"+CUST.EQB.currentAdjAmt)
			PRINT(sv_u)
			sv_u = urhk_SetOrbOut("alreadyAdjAmt|"+CUST.EQB.alreadyAdjAmt)
			PRINT(sv_u)
			sv_u = urhk_SetOrbOut("totLegInt|"+CUST.EQB.totLegInt)
			PRINT(sv_u)
		#}
		ENDIF
		
		
		
		EXITSCRIPT
END-->
