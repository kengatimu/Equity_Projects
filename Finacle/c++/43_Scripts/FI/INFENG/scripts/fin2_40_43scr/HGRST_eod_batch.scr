##############################################################################  
#    Name                   	: HGRST_eod_batch.scr  
#    Date                   	: 20-11-2019  
#    Description            	:  
#    Input                    	:   solID
#    Output                  	:  
#    Author                  	:  
#    Called Script          	:  
#    Calling Script         	:  
#    Reference   	        :  
############################################################################
<--start
trace on 
LIBNAME CUSTOMSO
#	-----------------------------------------------------------
#	Setting up the Literals and their values in funcblk. 
#	-----------------------------------------------------------
	
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	sv_r = CLASSEXISTS("CUST","HGRST")
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","HGRST",5)
	#}
	ENDIF
	
	IF(FIELDEXISTS(BANCS.INPUT.solId))THEN
	#{
		IF (BANCS.INPUT.solId != "")THEN
		#{
				CUST.HGRST.solId = BANCS.INPUT.solId
				PRINT(CUST.HGRST.solId)
		#}
		ENDIF
	#}
	ELSE
	#{
		CUST.HGRST.solId = BANCS.STDIN.mySolId
		PRINT(CUST.HGRST.solId)
	#}
	ENDIF
	
	sv_s = "timeStamp|select to_char(sysdate,'ddmmyyyyhhmiss') from dual"
	PRINT(sv_s)
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	
	IF(sv_d == 0)THEN
	#{
		CUST.HGRST.timeStamp = BANCS.OUTPARAM.timeStamp
		PRINT(CUST.HGRST.timeStamp)
	#}
	ENDIF
	
	CUST.HGRST.BODDate=MID$(BANCS.STDIN.BODDate,0,10)
	CUST.HGRST.errMsg = ""
	CUST.HGRST.errFlg = "N"
	CUST.HGRST.failureFile = "failfile_HGRST_" + BANCS.STDIN.contextBankId + ".lst"
	CUST.HGRST.failFileIndex1 = ""
	CUST.HGRST.failFileIndex1 = urtn_fileOpen(CUST.HGRST.failureFile + "|w")
	CUST.HGRST.list_file_name = CUST.HGRST.failureFile
	CUST.HGRST.title = "HGRST EOD Batch Failure Report"
	CUST.HGRST.mrt_file_name = "HGRSTFail.mrt"
	CUST.HGRST.rpt_file_name = "HGRST_Batch_" + CUST.HGRST.timeStamp + ".rpt"
	CUST.HGRST.rpt =  "HGRST_Batch_" + CUST.HGRST.timeStamp
	
	
	
	####SOLiD VALIDATION
	
	
	
	sv_r = "count|SELECT COUNT(1) FROM TBAADM.SOL WHERE SOL_ID = ?SVAR AND DEL_FLG = 'N' AND BANK_ID = ?SVAR"
	BANCS.INPARAM.BINDVARS = CUST.HGRST.solId + "|" + BANCS.STDIN.contextBankId
	PRINT(sv_r)
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_g = urhk_dbSelectWithBind(sv_r)
				
	IF(sv_g == 0)THEN
	#{
		sv_e = BANCS.OUTPARAM.count
		PRINT(sv_e)
		
		IF(sv_e ==0) THEN
		#{
			CUST.HGRST.errFlg = "Y"
			CUST.HGRST.errMsg = "Error|Invalid SOL_ID"
			PRINT(CUST.HGRST.errMsg)
			sv_b = urtn_fileWrite(CUST.HGRST.failFileIndex1 + "|" + CUST.HGRST.errMsg)
			PRINT(sv_b)
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ELSE
	#{
		CUST.HGRST.errFlg = "Y"
		CUST.HGRST.errMsg = "Error|Invalid SOL_ID"
		PRINT(CUST.HGRST.errMsg)
		sv_b = urtn_fileWrite(CUST.HGRST.failFileIndex1 + "|" + CUST.HGRST.errMsg)
		PRINT(sv_b)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	sv_u = urhk_getFileLocation("COM|HGRST_eod_batch.com")
	if(sv_u == "0") then
	#{
		sv_p = BANCS.OUTPARAM.fileLocation
		CUST.HGRST.fileLocation = sv_p
		sv_s    =   CUST.HGRST.fileLocation + "HGRST_eod_batch.com"+ " "+CUST.HGRST.solId
    	print(sv_s)
    	sv_a = SYSTEM(sv_s)
    	print (sv_a)
		if(sv_a!=0)then
		#{
			CUST.HGRST.errFlg = "Y"
			CUST.HGRST.errMsg = "Error|HGRST EOD Batch failed.COM file does not exist"
			PRINT(CUST.HGRST.errMsg)
			sv_b = urtn_fileWrite(CUST.HGRST.failFileIndex1 + "|" + CUST.HGRST.errMsg)
			PRINT(sv_b)
			GOTO ENDOFSCRIPT
		#}
		endif
	
	#}
	else
	#{
		CUST.HGRST.errFlg = "Y"
		CUST.HGRST.errMsg = "Error|HGRST EOD Batch failed.COM file does not exist"
		PRINT(CUST.HGRST.errMsg)
		sv_b = urtn_fileWrite(CUST.HGRST.failFileIndex1 + "|" + CUST.HGRST.errMsg)
		PRINT(sv_b)
		GOTO ENDOFSCRIPT
	#}
	endif
	ENDOFSCRIPT:
	sv_c = urtn_fileClose(CUST.HGRST.failFileIndex1)
	PRINT(sv_c)
	IF(CUST.HGRST.errFlg == "Y")THEN
	#{
		sv_r = "exebatch mrbx4004 $B2K_SESSION_ID " + CUST.HGRST.mrt_file_name + " " + CUST.HGRST.list_file_name + " " + CUST.HGRST.rpt
		PRINT(sv_r)
		sv_r = SYSTEM(sv_r)
		sv_q = "exebatch babx4040 $B2K_SESSION_ID " + " "+ CUST.HGRST.rpt_file_name+" '" + CUST.HGRST.title+"' MANAGER 1 N"
		PRINT(sv_q)
		sv_r = SYSTEM(sv_q)
		print(sv_r)
	#}
	ENDIF

	
exitscript
end-->

