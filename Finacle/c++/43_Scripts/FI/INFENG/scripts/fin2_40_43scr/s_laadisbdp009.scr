#------------------------------------------------------------------------------------------------    
#   Name		: s_laadisbdp009.scr
#   Description		: Share Investment account id is inserted into custom table
#   Date		: 31-03-2013
#   Author		: Saurabh
#   Input		: NA
#   Output		: NA
#   Called Script	: SRV_InsertDisbData_post_process_data.scr
#   Calling Script	: laadisbmn007.scr
#   Menu Option		:
#	Srl. No         Date            Author          	Description.
#	-------         ------          ------          	------------
#	1.0             12-03-2013      Sateesh				Original Version
#	2.0				31-03-2013		Sateesh				Getting srl no from share_invest custom table and insert values into share_invest custom table
#														and commit statement removed.
#-----------------------------------------------------------------------------------------------
<--START
CHECKSUM="91b486f7f9c74be87a64c3d4bf01a9c2d6de4a993b77d84342b1e29f83015077"
	TRACE ON
	
	#------------------------------------------------------------------------------
	# Creating repository and class
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","LADISB") == 0) THEN
	#{
		CREATECLASS("CUST","LADISB",5)
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","CPARAM") == 0) THEN
	#{
		CREATECLASS("CUST","CPARAM",5)
	#}
	ENDIF
	
	#-------------------------------------------------------------------------------
	#Initializing Required variables
	#-------------------------------------------------------------------------------
	CUST.LADISB.errMsg      = ""
	
	#------------------------------------------------------------------------------
	# Getting loan account number value from front end
	#------------------------------------------------------------------------------
	sv_u =  urhk_SRV_GetVal("acctDisburseTranLA.laAcct.foracid")
	IF(sv_u == 0)THEN
	#{
		CUST.LADISB.loanAcctId = BANCS.OUTPARAM.srvValue
		print(CUST.LADISB.loanAcctId)
		#}
	ELSE
		#{
		CUST.LADISB.errMsg = "Error in getting loan account number from frontend"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#------------------------------------------------------------------------------
	# Getting disbursement amt from front end
	#------------------------------------------------------------------------------
	sv_u =  urhk_SRV_GetVal("acctDisburseTranLA.disburseAmt")
	IF(sv_u == 0)THEN
	#{
		CUST.LADISB.disbAmt = BANCS.OUTPARAM.srvValue
		print(CUST.LADISB.disbAmt)
		#}
	ELSE
		#{
		CUST.LADISB.errMsg = "Error in getting disbursement amt from frontend"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#------------------------------------------------------------------------------
	# Calling common script for common values
	#------------------------------------------------------------------------------
	print(CUST.LADISB.loanAcctId)
	CALL("laadisbdp004.scr")
	IF (CUST.LADISB.errMsg != "") THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF (CUST.LADISB.loanType == "I") THEN
	#{
		ONS.CUSTOM.custDataIn = TRIM(ONS.CUSTOM.custDataIn)
		print(ONS.CUSTOM.custDataIn)
		print(STRLEN(ONS.CUSTOM.custDataIn))
		IF(STRLEN(ONS.CUSTOM.custDataIn)> 0) THEN
		#{
			sv_d = urhk_ParseONSCustData(ONS.CUSTOM.custDataIn)
			print(sv_d)
			sv_u = urhk_B2K_printRepos("BANCS")
			IF(FIELDEXISTS(BANCS.INPUT.ladisbdet_FIELD_3) ==1) THEN
			#{
				CUST.LADISB.shareInvAcct = TOUPPER(BANCS.INPUT.ladisbdet_FIELD_3)
				print(CUST.LADISB.shareInvAcct)
				#}
			ELSE
				#{
				CUST.LADISB.errMsg = "Error in getting data from front end"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			#}
		ELSE
			#{
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#--------------------------------------------------------------------------------
		# Getting serial number from SHARE_INVEST custom table
		#--------------------------------------------------------------------------------
		sv_s = ""
		sv_s = sv_s + "srlNo|"
		sv_s = sv_s + "SELECT"
		sv_s = sv_s + " NVL(MAX(SHARE_INVEST.srl_no),0)"
		sv_s = sv_s + " FROM CUSTOM.SHARE_INVEST"
		sv_s = sv_s + " WHERE"
		sv_s = sv_s + " SHARE_INVEST.loan_acct_id =?SVAR"
		sv_s = sv_s + " AND SHARE_INVEST.bank_id=?SVAR"
		print(sv_s)
		BANCS.INPARAM.BINDVARS =  CUST.LADISB.loanAcctId + "|" + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbselectWithBind(sv_s)
		print(sv_d)
		
		IF (sv_d != 0) THEN
		#{
			CUST.LADISB.errMsg = "Error in getting rows from SHARE_INVEST table"
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			CUST.LADISB.srlNo			= BANCS.OUTPARAM.srlNo
			print(CUST.LADISB.srlNo)
		#}
		ENDIF
		
		CUST.LADISB.srlNo = CINT(CUST.LADISB.srlNo) + 1
		print(CUST.LADISB.srlNo)
		
		#-----------------------------------------------------------------------------
		# Inserting rows into share_invest custom table
		#-----------------------------------------------------------------------------
		sv_s = "INSERT INTO CUSTOM.SHARE_INVEST("
		sv_s = sv_s + " srl_no,loan_acct_id,share_invest_acct_id,del_flg,"
		sv_s = sv_s + " entity_cre_flg,rcre_user_id,rcre_time,lchg_user_id,lchg_time,bank_id)"
		sv_s = sv_s + " VALUES ("
		sv_s = sv_s + "?SVAR"
		sv_s = sv_s + ",?SVAR"
		sv_s = sv_s + ",?SVAR"
		sv_s = sv_s + ",'N'"
		sv_s = sv_s + ",'N'"
		sv_s = sv_s + ",?SVAR"
		sv_s = sv_s + ",sysdate"
		sv_s = sv_s + ",?SVAR"
		sv_s = sv_s + ",sysdate"
		sv_s = sv_s + ",?SVAR"
		sv_s = sv_s + ")"
		print(sv_s)
		BANCS.INPARAM.BINDVARS = CUST.LADISB.srlNo + "|"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.loanAcctId + "|"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + CUST.LADISB.shareInvAcct + "|"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.userId + "|"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.userId + "|"
		BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.STDIN.contextBankId
		print(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSQLWithBind(sv_s)
		print(sv_d)
		IF (sv_d != 0) THEN
		#{
			CUST.LADISB.errMsg =" The table SHARE_INVEST not Inserted successfully "
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	ENDOFSCRIPT:
		IF (CUST.LADISB.errMsg != "" ) THEN
		#{
			sv_u = urhk_Setorbout("Error|"+CUST.LADISB.errMsg)
		#}
		ENDIF
		
		EXITSCRIPT
END-->
