<--START
TRACE ON
        ###########################################################################################
        # Check whether CUST Repository exists else create it
        ###########################################################################################

        sv_r = REPEXISTS("CUST")

        IF(sv_r == 0) THEN
        #{
                CREATEREP ("CUST")
        #}
        ENDIF

        ###########################################################################################
        # Check whether DATA Class exists else create it
        ###########################################################################################

        sv_r = CLASSEXISTS("CUST","DATA")

        IF(sv_r == 0) THEN
        #{
                CREATECLASS ("CUST","DATA",5)
        #}
        ENDIF
        
	#======================================
	#Below INPUTS are passed from MRT
	#======================================
	print(BANCS.INPUT.mrtForacid)
	CUST.DATA.mrtForacid = BANCS.INPUT.mrtForacid	
	CUST.DATA.mrtForacidAcctType = BANCS.INPUT.mrtForacidAcctType
	CUST.DATA.mrtOpenEffDate = BANCS.INPUT.mrtOpenEffDate
	print(BANCS.INPUT.mrtOpenEffDate)
	#============================================================================*
	#Fetching Accout Name using mrtforacid
	#============================================================================*
	sv_r=urhk_B2k_PrintRepos("BANCS")
	print(sv_r)
	sv_n = ""	
	sv_e = ""
	sv_c = ""
	sv_h = ""
	sv_i = ""
	sv_s = "acctName,schmCode|select acct_Name,schm_code from tbaadm.gam where "
	sv_s = sv_s + "foracid =?SVAR and "
	sv_s = sv_s + "BANK_ID =?SVAR" 
	
	BANCS.INPARAM.BINDVARS = CUST.DATA.mrtForacid + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)	
	
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)

	IF(sv_d==0) THEN
	#{
		sv_n=BANCS.OUTPARAM.acctName
		PRINT(sv_n)
		sv_e=BANCS.OUTPARAM.schmCode	
		PRINT(sv_e)	
	#}
	ELSE
                #{
                sv_n = ""
       		    sv_e = "" 
		#}
        ENDIF

	#============================================================================*
    #Fetching Accout Type using foracid 
    #============================================================================*
	sv_a = "acctType|select SCHM_DESC from tbaadm.gsp where "
        sv_a = sv_a + "SCHM_CODE = ?SVAR and "
        sv_a = sv_a + "BANK_ID = ?SVAR "	

	print(sv_a)
 	BANCS.INPARAM.BINDVARS = sv_e + "|" + BANCS.STDIN.contextBankId
	print(sv_e)
	print(BANCS.INPARAM.BINDVARS)
	sv_b=urhk_dbSelectWithBind(sv_a)
	print(sv_b)
	IF(sv_b == 0) THEN
        #{
                sv_c=BANCS.OUTPARAM.acctType
                PRINT(sv_c)
                
                #}
        ELSE
                #{
                sv_c = ""
        #}
        ENDIF
	#============================================================================*
    #Fetching Maturity months and days
    #============================================================================*	
	sv_f = "matMons,matDays| select trunc(months_between(to_date(sysdate),to_char((to_date(?SVAR,'DD-MM-YYYY hh24:mi:ss')),'DD-MON-YYYY'))) , 
	to_date(sysdate)-add_months(to_char((to_date(?SVAR,'DD-MM-YYYY hh24:mi:ss')),'DD-MON-YYYY'),trunc(months_between(to_date(sysdate),to_char((to_date(?SVAR,'DD-MM-YYYY hh24:mi:ss')),'DD-MON-YYYY')))) from dual"
	
	print(sv_f)
	BANCS.INPARAM.BINDVARS = CUST.DATA.mrtOpenEffDate + "|" + CUST.DATA.mrtOpenEffDate + "|" + CUST.DATA.mrtOpenEffDate
	print(BANCS.INPARAM.BINDVARS)
	sv_g = urhk_dbSelectWithBind(sv_f)
	print(sv_g)	
    IF(sv_g == 0) THEN
		#{
				sv_h = BANCS.OUTPARAM.matMons
				print(sv_h)
				sv_i = BANCS.OUTPARAM.matDays
				print(sv_i)
				GOTO ENDOFSCRIPT	
				#}
		ELSE	
				#{
				sv_h = ""
				sv_i = ""
				#}
		ENDIF


ENDOFSCRIPT:

BANCS.OUTPUT.acctName = sv_n
BANCS.OUTPUT.acctType = sv_c
BANCS.OUTPUT.matMons = sv_h
BANCS.OUTPUT.matDays = sv_i
print(BANCS.OUTPUT.acctName)
print(BANCS.OUTPUT.acctType)
print(BANCS.OUTPUT.matMons)
print(BANCS.OUTPUT.matDays)

TRACE OFF
END-->	
