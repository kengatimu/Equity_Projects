#------------------------------------------------------------------------------------------------
#  Name            : FI_ChqBook_PkgFlt.scr 
#  Description     : To filter the Packages by DownloadID, AsOnDate and BranchID
#  Date            : 24-07-2025
#  Author          : YESHWANTH
#  Input           : DownloadID, AsOnDate and BranchID
#  Output          : Package Details
#  Called Script   : NA
#  Menu Option     : (API)
#  Srl. No         Date            Author               Description.
#  -------         ------          ------               ------------
#  1.0            24-07-2025      YESHWANTH     	Original Version
#-----------------------------------------------------------------------------------------------
<--START
TRACE ON

	sv_u=REPEXISTS("CUST")
	IF(sv_u==0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF

	sv_u=CLASSEXISTS("CUST", "PKG")
	IF(sv_u==0) THEN
	#{
		CREATECLASS("CUST", "PKG", 5)
	#}
	ENDIF

	sv_t=urhk_b2k_printrepos("BANCS")
	print(sv_t)

	#---------------------------------------------------------------------------------------------------------------
        # Variable Initialization
        #---------------------------------------------------------------------------------------------------------------

        CUST.PKG.bankId     = ""
        CUST.PKG.downloadId = ""
        CUST.PKG.asOnDate   = ""
        CUST.PKG.branchId   = ""
        CUST.PKG.count = 0


	IF( (FIELDEXISTS(("BANCS").("INPUT").("bankId"))== 0) ) THEN
	#{
   		CUST.PKG.errMsg="Please enter the BankId"
		sv_t = "ERROR | " +CUST.PKG.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDSCRIPT
	ELSE
		CUST.PKG.bankId = BANCS.INPUT.bankId
		PRINT(CUST.PKG.bankId)
	#}
	ENDIF

	IF( (FIELDEXISTS(("BANCS").("INPUT").("downloadId"))== 0) ) THEN
        #{
                CUST.PKG.errMsg="Please enter the downloadId"
                sv_t = "ERROR | " +CUST.PKG.errMsg
                sv_u = urhk_SetOrbOut(sv_t)
                GOTO ENDSCRIPT
	ELSE
		CUST.PKG.downloadId = BANCS.INPUT.downloadId
		PRINT(CUST.PKG.downloadId)
	#}
        ENDIF
	IF( (FIELDEXISTS(("BANCS").("INPUT").("asOnDate"))== 1) ) THEN
        #{
        	CUST.PKG.asOnDate = BANCS.INPUT.asOnDate
		PRINT(CUST.PKG.asOnDate)
        #}
        ENDIF

	IF( (FIELDEXISTS(("BANCS").("INPUT").("branchId"))== 1) ) THEN
        #{
        	CUST.PKG.branchId = BANCS.INPUT.branchId
		PRINT(CUST.PKG.branchId)
        #}
        ENDIF


	sv_s="downloadId,branchId,branchName,chqBookStatus,reqDate,noOfChqBook |"
	sv_s=sv_s + "SELECT DOWNLOAD_ID,(select sol_id from tbaadm.sol where sol_id=branch_id and bank_id=bank_id) as branch_id, "
	sv_s=sv_s + "(select sol_desc from tbaadm.sol where sol_id=branch_id and bank_id=bank_id) as branch_name,req_status,to_char(req_date,'dd-mm-yyyy'),"
	sv_s=sv_s + "count(1) as noOfChqBook "
	sv_s=sv_s + "from custom.custom_cbr where "
	sv_s=sv_s + "DOWNLOAD_ID=?SVAR and "

	if(CUST.PKG.asOnDate != "") then
	sv_s=sv_s + "req_date=to_date('"+ CUST.PKG.asOnDate +"','dd-mm-yyyy') and "
	endif

	if(CUST.PKG.branchId != "") then
	sv_s=sv_s + "BRANCH_ID='"+ CUST.PKG.branchId +"' and "
	endif

	sv_s=sv_s + "req_status in ('B','R','S','K') and del_flg='N' and bank_id=?SVAR "
	sv_s=sv_s + "group by DOWNLOAD_ID,branch_id,req_status,req_date order by branch_id asc" 
	print(sv_s)

	BANCS.INPARAM.BINDVARS = CUST.PKG.downloadId +"|"+ CUST.PKG.bankId 
	print(BANCS.INPARAM.BINDVARS)

	sv_c = urhk_dbcursorOpenWithBind(sv_s)
       	PRINT(sv_c)	

	IF(sv_c == 0) THEN
       	 #{
		CUST.PKG.DB_CURSOR_NUMBER = BANCS.OUTPARAM.DB_CURSOR_NUMBER
                print(CUST.PKG.DB_CURSOR_NUMBER)

                sv_c = urhk_dbCursorFetch(CUST.PKG.DB_CURSOR_NUMBER)
                print(sv_c)

                IF(sv_c != "0")THEN
                #{
                        sv_e = urhk_SetOrbOut("SuccessorFailure|Failed")
                        sv_u = urhk_SetOrbOut("Failure| No records found")
                        print(sv_u)
			GOTO ENDSCRIPT
                #}
                ENDIF

		WHILE(sv_c == "0")
        	#{
			CUST.PKG.downloadId= BANCS.OUTPARAM.downloadId
                        print(CUST.PKG.downloadId)

			CUST.PKG.branchId= BANCS.OUTPARAM.branchId
			print(CUST.PKG.branchId)

			CUST.PKG.branchName= BANCS.OUTPARAM.branchName
			print(CUST.PKG.branchName)

			CUST.PKG.chqBookStatus= BANCS.OUTPARAM.chqBookStatus
                        print(CUST.PKG.branchName)
		
			CUST.PKG.reqDate= BANCS.OUTPARAM.reqDate
                        print(CUST.PKG.reqDate)

			CUST.PKG.noOfChqBook= BANCS.OUTPARAM.noOfChqBook
                        print(CUST.PKG.noOfChqBook)

			CUST.PKG.count = CINT(CUST.PKG.count)+ 1
			print(CUST.PKG.count)

			sv_c = urhk_SetOrbOut("ChequeBookDetails.<rec_"+CUST.PKG.count+">.Download_Id"+"| "+CUST.PKG.downloadId)
                        print(sv_c)

			sv_c = urhk_SetOrbOut("ChequeBookDetails.<rec_"+CUST.PKG.count+">.Branch_Id"+"| "+CUST.PKG.branchId)
			print(sv_c)

			sv_c = urhk_SetOrbOut("ChequeBookDetails.<rec_"+CUST.PKG.count+">.Branch_Name"+"| "+CUST.PKG.branchName)
			print(sv_c)

			sv_c = urhk_SetOrbOut("ChequeBookDetails.<rec_"+CUST.PKG.count+">.ChqBookStatus"+"| "+CUST.PKG.chqBookStatus)
			print(sv_c)

			sv_c = urhk_SetOrbOut("ChequeBookDetails.<rec_"+CUST.PKG.count+">.Req_Date"+"| "+CUST.PKG.reqDate)
                        print(sv_c)

			sv_c = urhk_SetOrbOut("ChequeBookDetails.<rec_"+CUST.PKG.count+">.NoOfChqBook"+"| "+CUST.PKG.noOfChqBook)
                        print(sv_c)

			sv_c = urhk_dbCursorFetch(CUST.PKG.DB_CURSOR_NUMBER)
                        print(sv_c)

		#}
		DO
		sv_c = urhk_dbCursorClose(CUST.PKG.DB_CURSOR_NUMBER)
                print(sv_c)
	#}
	ENDIF

ENDSCRIPT:
EXITSCRIPT

TRACE OFF
END-->
