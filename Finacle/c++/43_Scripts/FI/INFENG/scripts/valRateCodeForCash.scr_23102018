	sv_s = "recCount|SELECT nvl(max(del_flg),0) FROM tbaadm.RCT  WHERE  ref_rec_type ='67' AND ref_code =?SVAR  AND bank_id = ?SVAR "
	BANCS.INPARAM.BINDVARS = EQT.CSH.dmgRateCode + "|" + BANCS.STDIN.contextBankId
