	sv_s = "recCount|SELECT count(1) FROM DUAL WHERE EXISTS ( SELECT 1 FROM tbaadm.RTL WHERE RTL.BANK_ID =?SVAR  "
	sv_s = sv_s + "AND  (((FXD_CRNCY_CODE = ?SVAR  and VAR_CRNCY_CODE = ?SVAR AND RATECODE =  ?SVAR ) "
