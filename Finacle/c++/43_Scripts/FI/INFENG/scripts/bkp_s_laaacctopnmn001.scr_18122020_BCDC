<--START
TRACE ON

#------------------------------------------------------------------------------
# Creating repository and class
#------------------------------------------------------------------------------
IF (REPEXISTS("CUST") == 0) THEN
#{
        CREATEREP("CUST")
#}
ENDIF

IF (CLASSEXISTS("CUST","LAOPN") == 0) THEN
#{
        CREATECLASS("CUST","LAOPN",5)
#}
ENDIF

IF (CLASSEXISTS("CUST","CPARAM") == 0) THEN
#{
        CREATECLASS("CUST","CPARAM",5)
#}
ENDIF

#------------------------------------------------------------------------------
# Initaializing variables
#------------------------------------------------------------------------------
CUST.LAOPN.errMsg = ""

#------------------------------------------------------------------------------
# Getting required values from front end
#------------------------------------------------------------------------------
sv_u =  urhk_SRV_GetVal("acctCriteria.glSubHeadCode.glSubHeadCode")
IF(sv_u == 0)THEN
#{
        CUST.LAOPN.glSubHeadCode = BANCS.OUTPARAM.srvValue
#}
ELSE
#{
        CUST.LAOPN.errMsg = "Error in getting GL Sub Head Code from frontend"
        GOTO ENDOFSCRIPT
#}
ENDIF

sv_u =  urhk_SRV_GetVal("defaultAcctCommonInfo.acctGeneralInfo.acctBasic.acctRptCode")
IF(sv_u == 0)THEN
#{
        CUST.LAOPN.acctRptCode = BANCS.OUTPARAM.srvValue
#}
ELSE
#{
        CUST.LAOPN.errMsg = "Error in getting Acct Report Code from frontend"
        GOTO ENDOFSCRIPT
#}
ENDIF

#-----------------------------------------------------------------------------------------------
#Getting ACCTRPTCODE values from CPARAM 
#-----------------------------------------------------------------------------------------------
BANCS.INPUT.moduleName = "LAOPN"
BANCS.INPUT.parameterId = "ACCTRPTCODE"

CALL ("getcparamvalue.scr")
print(BANCS.OUTPUT.parameterVal)

IF(BANCS.OUTPUT.parameterVal != "")THEN
#{
	CUST.CPARAM.acctRptCode= BANCS.OUTPUT.parameterVal
	print(CUST.CPARAM.acctRptCode)
#}
ELSE
#{
	CUST.LAOPN.errMsg = "ACCTRPTCODE setup not done in CPARAM"
	GOTO ENDOFSCRIPT
#}
ENDIF

#-----------------------------------------------------------------------------------------------
#Getting PSPBGLLIST values from CPARAM 
#-----------------------------------------------------------------------------------------------
BANCS.INPUT.moduleName = "LAOPN"
BANCS.INPUT.parameterId = "PSPBGLLIST"

CALL ("getcparamvalue.scr")
print(BANCS.OUTPUT.parameterVal)

IF(BANCS.OUTPUT.parameterVal != "")THEN
#{
	CUST.CPARAM.pspbList= BANCS.OUTPUT.parameterVal
	print(CUST.CPARAM.pspbList)
#}
ELSE
#{
	CUST.LAOPN.errMsg = "PSPBGLLIST setup not done in CPARAM"
	GOTO ENDOFSCRIPT
#}
ENDIF

IF(CUST.LAOPN.acctRptCode != CUST.CPARAM.acctRptCode) THEN
#{
	sv_u = urhk_SRV_SetVal("defaultAcctCommonInfo.acctGeneralInfo.acctCustInfo.servChrgCollFlg|Y")
	print(sv_u)
#}
ENDIF

sv_a=getPosition(CUST.CPARAM.pspbList,"!"+CUST.LAOPN.glSubHeadCode+"!")
print(sv_a)
IF(sv_a > 0) THEN
#{
	sv_u = urhk_SRV_SetVal("defaultAcctCommonInfo.acctGeneralInfo.acctCustInfo.pbPsCode.code|P")
	print(sv_u)
#}
ENDIF


IF (BANCS.STDIN.contextBankId =="43") THEN


CUST.LAOPN.Migr= MID$(CUST.LAOPN.schmCode,0,2)
	print(CUST.LAOPN.Migr)

                sv_a = STRLEN(CUST.LAOPN.schmCode)
                print(sv_a)
                CUST.LAOPN.Schm= MID$(CUST.LAOPN.schmCode,2,sv_a)
                PRINT(CUST.LAOPN.Schm)

	IF (CUST.LAOPN.Migr=="MG") THEN
		CUST.LAOPN.errMsg = "Kindly Use scheme code LA" + CUST.LAOPN.Schm + " ."
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	IF (CUST.LAOPN.Migr=="MT") THEN
		CUST.LAOPN.errMsg = "Kindly Use scheme code LA" + CUST.LAOPN.Schm + " ."
		GOTO ENDOFSCRIPT
	#}
	ENDIF

ENDIF


IF (BANCS.STDIN.contextBankId == "56") THEN
#{
#------------------------------------------------------------------------------
# Below code is only for Uganda Entity
#------------------------------------------------------------------------------

#------------------------------------------------------------------------------
# Getting scheme code from front end
#------------------------------------------------------------------------------
sv_u =  urhk_SRV_GetVal("acctCriteria.schmCode.schmCode")
IF(sv_u == 0)THEN
#{
	CUST.LAOPN.schmCode = BANCS.OUTPARAM.srvValue
	print(CUST.LAOPN.schmCode)
#}
ELSE
#{
	CUST.LAOPN.errMsg = "Error in getting schmCode from frontend"
	GOTO ENDOFSCRIPT
#}
ENDIF


#-----------------------------------------------------------------------------------------------
#Getting OPNSHMLIST from LAOPN values --!LA511!LA512!LA513!LA530!
#-----------------------------------------------------------------------------------------------
BANCS.INPUT.parameterId = "OPNSHMLIST"

CALL ("getcparamvalue.scr")
print(BANCS.OUTPUT.parameterVal)

IF(BANCS.OUTPUT.parameterVal != "")THEN
#{
	CUST.CPARAM.opnSchmList = BANCS.OUTPUT.parameterVal
	print(CUST.CPARAM.opnSchmList)
#}
ELSE
#{
	CUST.LAOPN.errMsg = "OpenSchemeList setup not done in CPARAM"
	GOTO ENDOFSCRIPT
#}
ENDIF

#--------------------------------------------------------------------------
# TO OPEN A LOAN ACCOUNT IN SCHME_CODE
#--------------------------------------------------------------------------

IF (CUST.LAOPN.schmCode != "") THEN

#{
	sv_a=getPosition(CUST.CPARAM.opnSchmList,"!" + CUST.LAOPN.schmCode + "!")

	print(sv_a)
	IF (sv_a > 0) THEN
	#{	


	IF ((CUST.LAOPN.schmCode=="XXXX") OR (CUST.LAOPN.schmCode=="LA530")) THEN
			CUST.LAOPN.errMsg = " TO OPEN A LOAN ACCOUNT IN SCHME_CODE " + CUST.LAOPN.schmCode + " KINDLY USE EXPERIAN"  
			GOTO ENDOFSCRIPT
		ELSE
			CUST.LAOPN.errMsg = " TO OPEN A LOAN ACCOUNT IN SCHME_CODE " + CUST.LAOPN.schmCode + " KINDLY USE CAS"  
			GOTO ENDOFSCRIPT
		ENDIF
	#}
	ENDIF
#}	
ELSE
#{
	CUST.LAOPN.errMsg = "  Scheme code should not be null "
	GOTO ENDOFSCRIPT
#}
ENDIF
#}
ENDIF

IF (BANCS.STDIN.contextBankId =="54") THEN
#{
	IF ((CUST.LAOPN.schmCode=="LA561")  OR (CUST.LAOPN.schmCode=="LA511")  OR (CUST.LAOPN.schmCode=="LA562")) THEN
	#{	
		IF (BANCS.STDIN.homeSolId!="000") THEN
		#{
			CUST.LAOPN.errMsg = " TO OPEN A LOAN ACCOUNT IN SCHME_CODE " + CUST.LAOPN.schmCode + " CONTACT H/O"  
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
#	IF (CUST.LAOPN.schmCode=="LA529") THEN
#		CUST.LAOPN.errMsg = " TO OPEN A LOAN ACCOUNT IN SCHME_CODE " + CUST.LAOPN.schmCode + " IS NOT ALLOWED"  
#		GOTO ENDOFSCRIPT
#	ENDIF
#}
ENDIF

ENDOFSCRIPT:
IF(CUST.LAOPN.errMsg != "") THEN
#{
        sv_u = urhk_SRV_setErr(CUST.LAOPN.errMsg)
#}
ENDIF

EXITSCRIPT
END-->
