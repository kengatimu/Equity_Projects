#-------------------------------------------------------------------------------------
# 							IFN202EventMapping.scr
#
# Script to map and concatenate the repository values sent by the calling program (ORM)
# and form the IFN202 sfms message.
#
# The calling program will pass a repository BankRemittance which has values
# 'Y' or 'N'. Y --> Direct 202 and N --> Cover 202 message.
#-------------------------------------------------------------------------------------
#
# Author : Vishal Keswani  
# Date   : 24-12-2009
#-------------------------------------------------------------------------------------
<--start
trace on
	sv_r=urhk_B2k_PrintRepos("BANCS")
sv_m = ""
#
IF(FIELDEXISTS(BANCS.INPUT.TransactionReferenceNo))THEN
	
else
		IF(FIELDEXISTS(BANCS.INPUT.pFreeText))THEN
	
			BANCS.INPUT.TransactionReferenceNo=BANCS.INPUT.pFreeText
		ELSE
			BANCS.INPUT.TransactionReferenceNo=BANCS.INPUT.SendersReference

		ENDIF
endif


if (BANCS.INPUT.TransactionReferenceNo != "") then
	sv_m = sv_m + ":201:E:" + BANCS.INPUT.TransactionReferenceNo + "|"
endif
#

BANCS.INPUT.PresentingBanksReference=""

	IF(FIELDEXISTS(BANCS.INPUT.pTranRefNum))THEN
		BANCS.INPUT.PresentingBanksReference =BANCS.INPUT.pTranRefNum
	ELSE
		BANCS.INPUT.PresentingBanksReference =""
	ENDIF


if (BANCS.INPUT.PresentingBanksReference != "") then
    sv_m = sv_m + ":211:E:" + BANCS.INPUT.PresentingBanksReference + "|"
	else
    sv_m = sv_m + ":211:E:" + "NONREF" + "|"
endif
#
#
#If BankRemittance = "IF400" indicates IFN202 is generated with IFN400
#If BankRemittance = "IF756" indicates IFN202 is generated with IFN756
#ImportValueDate = Nostro debit date
#NostroCurrencyCode = Nostro currency code
#NostroAmount = Nostro Amount
#ValueDate = Realisation date
#Amount = Realisation amount for IFN400
#Amount = LC utilise amount for IFN756
#Under current logic for IFN202 under cover, system will populate Nostro debit
#date/Nostro currency code/Nostro Amount in tag32A .User can modify this
#logic according to their requirements.



IF(FIELDEXISTS(BANCS.INPUT.BankRemittance))THEN
	
else
	BANCS.INPUT.BankRemittance=""
endif

if ((BANCS.INPUT.BankRemittance == "IF400") OR (BANCS.INPUT.BankRemittance == "IF756")) then
    if (BANCS.INPUT.ImportValueDate != "") then
        sv_m = sv_m + ":32a1:E:" + BANCS.INPUT.ImportValueDate + "|"
    else
        sv_m = sv_m + ":32a1:E:" + BANCS.INPUT.ValueDate + "|"
    endif
#
IF(FIELDEXISTS(BANCS.INPUT.NostroCurrencyCode))THEN
	
else
	BANCS.INPUT.NostroCurrencyCode =""
endif

    if (BANCS.INPUT.NostroCurrencyCode != "") then
        sv_m = sv_m + ":32a2:E:" + BANCS.INPUT.NostroCurrencyCode + "|"
    endif
#

IF(FIELDEXISTS(BANCS.INPUT.NostroAmount))THEN
	
else
	BANCS.INPUT.NostroAmount=""
endif

    if (BANCS.INPUT.NostroAmount != "") then
        sv_m = sv_m + ":32a3:E:" + BANCS.INPUT.NostroAmount + "|"
    endif
#
else
    if (BANCS.INPUT.ValueDate != "") then
        sv_m = sv_m + ":32a1:E:" + BANCS.INPUT.ValueDate + "|"
    endif
#
    if (BANCS.INPUT.CurrencyCode != "") then
        sv_m = sv_m + ":32a2:E:" + BANCS.INPUT.CurrencyCode + "|"
    endif
#
    if (BANCS.INPUT.Amount != "") then
        sv_m = sv_m + ":32a3:E:" + BANCS.INPUT.Amount + "|"
    endif
#
endif
#Ordering Institution details will be populated : Tag 52a or 52d
if(BANCS.INPUT.OrderingInstitutionBIC != "") then
    sv_m = sv_m + ":52a2:E:" +BANCS.INPUT.OrderingInstitutionBIC + "|"
else
    if(BANCS.INPUT.OrderingInstitutionName != "") then
        sv_o = mid$(BANCS.INPUT.OrderingInstitutionName,0,35)
        sv_m = sv_m + ":52d2:E:" +sv_o + "|"

        sv_p = strlen(BANCS.INPUT.OrderingInstitutionAddress1)
        sv_q = strlen(BANCS.INPUT.OrderingInstitutionAddress2)
        sv_r = strlen(BANCS.INPUT.OrderingInstitutionAddress3)
        if( (sv_p <= 35) AND (sv_q <= 35) AND (sv_r <= 35) ) then
            sv_m = sv_m + ":52d3:E:" +BANCS.INPUT.OrderingInstitutionAddress1 + "|"
            sv_m = sv_m + ":52d4:E:" +BANCS.INPUT.OrderingInstitutionAddress2 + "|"
            sv_m = sv_m + ":52d5:E:" +BANCS.INPUT.OrderingInstitutionAddress3 + "|"
        else
            sv_s = ""
            sv_s = sv_s + ltrim(rtrim(BANCS.INPUT.OrderingInstitutionAddress1)) + " "
            sv_s = sv_s + ltrim(rtrim(BANCS.INPUT.OrderingInstitutionAddress2)) + " "
            sv_s = sv_s + ltrim(rtrim(BANCS.INPUT.OrderingInstitutionAddress3)) + " "
            sv_t = mid$(sv_s,0,35)
            sv_m = sv_m + ":52d3:E:" +sv_t + "|"
            sv_u = mid$(sv_s,35,35)
            sv_m = sv_m + ":52d4:E:" +sv_u + "|"
            sv_v = mid$(sv_s,70,35)
            sv_m = sv_m + ":52d5:E:" +sv_v + "|"
        endif
    endif
endif
#End of Ordering Institution details
#
if(BANCS.INPUT.BankRemittance == "Y") then
#{
	if(BANCS.INPUT.SendersCorrespondentBIC != "") then
		if(BANCS.INPUT.SendersCorrespondentPartyId != "") then
			sv_m = sv_m + ":53a1:E:" + BANCS.INPUT.SendersCorrespondentPartyId + "|"
		endif
		sv_m = sv_m + ":53a2:E:" + BANCS.INPUT.SendersCorrespondentBIC + "|"
	else 
		if(BANCS.INPUT.SendersCorrespondentLocation != "") then
			if(BANCS.INPUT.SendersCorrespondentPartyId != "") then
				sv_m = sv_m + ":53b1:E:" + BANCS.INPUT.SendersCorrespondentPartyId + "|"
			endif
			sv_m = sv_m + ":53b2:E:" + BANCS.INPUT.SendersCorrespondentLocation + "|"
		else
			if(BANCS.INPUT.SendersCorrespondentPartyId != "") then 
				sv_m = sv_m + ":53d1:E:" + BANCS.INPUT.SendersCorrespondentPartyId + "|"
			endif
			if(BANCS.INPUT.SendersCorrespondentName != "") then
				sv_o = mid$(BANCS.INPUT.SendersCorrespondentName,0,35)
				sv_m = sv_m + ":53d2:E:" + sv_o + "|"
			endif
			sv_p = strlen(BANCS.INPUT.SendersCorrespondentAddress1)	
			sv_q = strlen(BANCS.INPUT.SendersCorrespondentAddress2)
			sv_r = strlen(BANCS.INPUT.SendersCorrespondentAddress3)

			if( (sv_p <= 35) AND (sv_q <= 35) AND (sv_r <= 35) ) then
				if(BANCS.INPUT.SendersCorrespondentAddress1 != "") then
					sv_m = sv_m + ":53d3:E:" + BANCS.INPUT.SendersCorrespondentAddress1 + "|"
				endif
				if(BANCS.INPUT.SendersCorrespondentAddress2 != "") then
					sv_m = sv_m + ":53d4:E:" + BANCS.INPUT.SendersCorrespondentAddress2 + "|"
				endif
				if(BANCS.INPUT.SendersCorrespondentAddress3 != "") then
					sv_m = sv_m + ":53d5:E:" + BANCS.INPUT.SendersCorrespondentAddress3 + "|"
				endif
			else
				sv_s = ""
				if(BANCS.INPUT.SendersCorrespondentAddress1 != "") then
					sv_s = sv_s + ltrim(rtrim(BANCS.INPUT.SendersCorrespondentAddress1)) + " "
				endif
				if(BANCS.INPUT.SendersCorrespondentAddress2 != "") then
					sv_s = sv_s + ltrim(rtrim(BANCS.INPUT.SendersCorrespondentAddress2)) + " " 
				endif
				if(BANCS.INPUT.SendersCorrespondentAddress3 != "") then
					sv_s = sv_s + ltrim(rtrim(BANCS.INPUT.SendersCorrespondentAddress3)) + " " 
				endif
				if(sv_s != "") then
					sv_t = mid$(sv_s,0,35)
					if(sv_t != "") then
						sv_m = sv_m + ":53d3:E:" + sv_t + "|"	
					endif

					sv_u = mid$(sv_s,35,35)
					if(sv_u != "") then
						sv_m = sv_m + ":53d4:E:" + sv_u + "|"	
					endif

					sv_v = mid$(sv_s,70,35)
					if(sv_v != "") then
						sv_m = sv_m + ":53d5:E:" + sv_v + "|"	
					endif
				endif
			endif				
		endif
	endif
	#
	if(BANCS.INPUT.ReceiversCorrespondentBIC != "") then
		if(BANCS.INPUT.ReceiversCorrespondentPartyId != "") then
			sv_m = sv_m + ":54a1:E:" + BANCS.INPUT.ReceiversCorrespondentPartyId + "|"
		endif
		sv_m = sv_m + ":54a2:E:" + BANCS.INPUT.ReceiversCorrespondentBIC + "|"
	else 
		if(BANCS.INPUT.ReceiversCorrespondentLocation != "") then
			if(BANCS.INPUT.ReceiversCorrespondentPartyId != "") then
				sv_m = sv_m + ":54b1:E:" + BANCS.INPUT.ReceiversCorrespondentPartyId + "|"
			endif
			sv_m = sv_m + ":54b2:E:" + BANCS.INPUT.ReceiversCorrespondentLocation + "|"
		else
			if(BANCS.INPUT.ReceiversCorrespondentPartyId != "") then
				sv_m = sv_m + ":54d1:E:" + BANCS.INPUT.ReceiversCorrespondentPartyId + "|"
			endif
			if(BANCS.INPUT.ReceiversCorrespondentName != "") then
				sv_o = mid$(BANCS.INPUT.ReceiversCorrespondentName,0,35)
				sv_m = sv_m + ":54d2:E:" + sv_o + "|"
			endif
			sv_p = strlen(BANCS.INPUT.ReceiversCorrespondentAddress1)	
