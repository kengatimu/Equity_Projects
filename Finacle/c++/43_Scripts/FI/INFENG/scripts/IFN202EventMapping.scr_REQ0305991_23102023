				print(BANCS.INPARAM.BINDVARS)
				sv_x = "tcc2022,sendrecv2022|SELECT purpose_code,remit_info FROM TBAADM.PORD WHERE PYMT_REF_NUM  = ?SVAR AND BANK_ID = ?SVAR  and purpose_code in ('2103','1202','3205','1300','1500','1222') "
				sv_w = urhk_dbSelectWithBind(sv_x)
				PRINT(sv_w)
				IF(sv_w == 0) THEN
				#{
					BANCS.OUTPUT.tcc2022 = BANCS.OUTPARAM.tcc2022
					PRINT(BANCS.OUTPUT.tcc2022)
					BANCS.OUTPUT.sendrecv2022 = BANCS.OUTPARAM.sendrecv2022
					PRINT(BANCS.OUTPUT.sendrecv2022)
					IF (BANCS.OUTPUT.tcc2022=="1222") THEN
						print(BANCS.OUTPUT.tcc2022)
					ELSE
						sv_h="BCCGCDKS"
						print(sv_h)
						sv_m = sv_m + ":57a2:E:" + sv_h + "|"
						print(sv_m)
					ENDIF
				ELSE
					sv_h="BCCGCDKS"
					print(sv_h)
					sv_m = sv_m + ":57a2:E:" + sv_h + "|"
					print(sv_m)
				ENDIF
			ELSE
				sv_h="BCCGCDKS"
				print(sv_h)
				sv_m = sv_m + ":57a2:E:" + sv_h + "|"
				print(sv_m)
			ENDIF
			#####
		ELSE
			sv_m = sv_m + ":57a2:E:" + BANCS.INPUT.AccountWithInstitutionBIC + "|"
			print(sv_m)
		ENDIF
