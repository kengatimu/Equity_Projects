			sv_x = "tcc2022,sendrecv2022|SELECT purpose_code,remit_info FROM TBAADM.PORD WHERE PYMT_REF_NUM  = ?SVAR AND BANK_ID = ?SVAR  and purpose_code in ('2103','1202','3205','1300','1500','1222') "
