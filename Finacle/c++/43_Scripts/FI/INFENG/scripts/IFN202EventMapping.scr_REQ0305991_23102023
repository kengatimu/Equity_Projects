				sv_m = sv_m + ":58a2:E:" + BANCS.INPUT.benefPartyName + "|"
				print(sv_m)
			ENDIF
		ELSE
			sv_m = sv_m + ":58a1:E:/" + mid$(BANCS.INPUT.BeneficiaryCustomerPartyId,0,11) + "|"
			print(sv_m)
			sv_m = sv_m + ":58a2:E:" + BANCS.INPUT.benefPartyName + "|"
			print(sv_m)
		ENDIF
		####
	ENDIF
	if(BANCS.INPUT.BeneficiaryInstitutionPartyId != "") then
		sv_m = sv_m + ":58d1:E:" + BANCS.INPUT.BeneficiaryInstitutionPartyId + "|"
	endif
	if(BANCS.INPUT.BeneficiaryInstitutionName != "") then
		sv_o = mid$(BANCS.INPUT.BeneficiaryInstitutionName,0,35)
		sv_m = sv_m + ":58d2:E:" + sv_o + "|"
