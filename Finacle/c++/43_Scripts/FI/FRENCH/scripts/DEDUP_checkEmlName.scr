	ELSE
		STDWFS.GLBDATA.middlename=BANCS.INPUT.middlename
		print(STDWFS.GLBDATA.middlename)
	ENDIF

		sv_s = "emailorgkey,email | select orgkey , Cname from "
		#sv_s = sv_s + " (select instr ((CUST_FIRST_NAME ||' '|| CUST_MIDDLE_NAME ||' '||  CUST_LAST_NAME),?SVAR) FA, "
		#sv_s = sv_s + " instr ((CUST_FIRST_NAME ||' '|| CUST_MIDDLE_NAME ||' '||  CUST_LAST_NAME),?SVAR ) FB, "
		#sv_s = sv_s + " instr ((CUST_FIRST_NAME ||' '|| CUST_MIDDLE_NAME ||' '||  CUST_LAST_NAME),?SVAR )FC, orgkey, "
		#sv_s = sv_s + " (CUST_FIRST_NAME ||' '|| CUST_MIDDLE_NAME ||' '||  CUST_LAST_NAME) CNAME "
	
		sv_s = sv_s + " (select instr (CONCAT(CONCAT(CONCAT(CONCAT(CUST_FIRST_NAME,' '),CUST_MIDDLE_NAME),' '),CUST_LAST_NAME),?SVAR) FA, "
		sv_s = sv_s + " instr (CONCAT(CONCAT(CONCAT(CONCAT(CUST_FIRST_NAME,' '),CUST_MIDDLE_NAME),' '),CUST_LAST_NAME),?SVAR ) FB, "
		sv_s = sv_s + " instr (CONCAT(CONCAT(CONCAT(CONCAT(CUST_FIRST_NAME,' '),CUST_MIDDLE_NAME),' '),CUST_LAST_NAME),?SVAR )FC, orgkey, "
		sv_s = sv_s + " (CONCAT(CONCAT(CONCAT(CONCAT(CUST_FIRST_NAME,' '),CUST_MIDDLE_NAME),' '),CUST_LAST_NAME)) CNAME "		
		sv_s = sv_s + " from crmuser.accounts  where bank_id =?SVAR) where FA !='0' and  FB !='0' and FC !='0' AND ROWNUM < 20 "
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS = STDWFS.GLBDATA.firstname + "|" +  STDWFS.GLBDATA.lastname + "|" + STDWFS.GLBDATA.middlename + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbCursorOpenWithBind(sv_s)
		if(sv_d == 0)then
			sv_c = BANCS.OUTPARAM.DB_CURSOR_NUMBER
			print(sv_c)
			sv_z = urhk_dbCursorFetch(sv_c)
			while(sv_z == 0)
					STDWFS.GLBDATA.emailorgkey = BANCS.OUTPARAM.emailorgkey
					STDWFS.GLBDATA.email = BANCS.OUTPARAM.email
					STDWFS.GLBDATA.Cnt  = cint (STDWFS.GLBDATA.Cnt) + 1
					print(STDWFS.GLBDATA.emailorgkey)					
					print(STDWFS.GLBDATA.email)
					print(STDWFS.GLBDATA.Cnt)
								
					sv_t = urhk_SetOrbOut("CustomerDetails.<rec_"+STDWFS.GLBDATA.Cnt+">.CifId"+"| "+STDWFS.GLBDATA.emailorgkey)
					print(sv_t)
					sv_t = urhk_SetOrbOut("CustomerDetails.<rec_"+STDWFS.GLBDATA.Cnt+">.ReqDetail"+"| "+STDWFS.GLBDATA.email)
					print(sv_t)

				sv_z = urhk_dbCursorFetch(sv_c)
				print (sv_z)
			DO			
			sv_z = urhk_dbCursorClose(sv_c)
		ENDIF
