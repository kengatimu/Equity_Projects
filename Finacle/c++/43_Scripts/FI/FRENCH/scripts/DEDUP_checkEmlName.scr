	#BANCS.INPARAM.BINDVARS = STDWFS.GLBDATA.Emailaddrsess
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbselectWithBind(sv_s)
	print(sv_d)
	print(BANCS.OUTPARAM.Emailaddrsesscount)
	IF (BANCS.OUTPARAM.Emailaddrsesscount != "0") THEN
		sv_s = "emailorgkey,email  |"
		sv_s = sv_s + "select EMAIL_B2KID,EMAIL from tbaadm.cemail where bank_id=?SVAR and UPPER (EMAIL)=?SVAR  and rownum < 20"
		#sv_s = sv_s + "select EMAIL_B2KID,EMAIL from tbaadm.cemail where UPPER (EMAIL) =?SVAR  and rownum < 20"
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + STDWFS.GLBDATA.Emailaddrsess
		#BANCS.INPARAM.BINDVARS =  STDWFS.GLBDATA.Emailaddrsess
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbCursorOpenWithBind(sv_s)
		if(sv_d == 0)then
			sv_c = BANCS.OUTPARAM.DB_CURSOR_NUMBER
			print(sv_c)
			sv_z = urhk_dbCursorFetch(sv_c)
			while(sv_z == 0)
					STDWFS.GLBDATA.emailorgkey = BANCS.OUTPARAM.emailorgkey
					STDWFS.GLBDATA.email = BANCS.OUTPARAM.email
					STDWFS.GLBDATA.Cnt  = cint (STDWFS.GLBDATA.Cnt) + 1
					print(STDWFS.GLBDATA.emailorgkey)					
					print(STDWFS.GLBDATA.email)
					print(STDWFS.GLBDATA.Cnt)
								
					sv_t = urhk_SetOrbOut("CustomerDetails.<rec_"+STDWFS.GLBDATA.Cnt+">.CifId"+"| "+STDWFS.GLBDATA.emailorgkey)
					print(sv_t)
					sv_t = urhk_SetOrbOut("CustomerDetails.<rec_"+STDWFS.GLBDATA.Cnt+">.ReqDetail"+"| "+STDWFS.GLBDATA.email)
					print(sv_t)

				sv_z = urhk_dbCursorFetch(sv_c)
				print (sv_z)
			DO			
			sv_z = urhk_dbCursorClose(sv_c)
		ENDIF
	ENDIF
ELSE

	
	

	IF( (FIELDEXISTS(("BANCS").("INPUT").("firstname"))== 0) ) THEN
