ELSE
	STDWFS.GLBDATA.Emailaddrsess=toupper (BANCS.INPUT.Emailaddrsess)
ENDIF

IF (STDWFS.GLBDATA.Emailaddrsess != "") THEN	
	print(STDWFS.GLBDATA.Emailaddrsess)	
	sv_s = "Emailaddrsesscount|"
	sv_s = sv_s + "select count(1) from tbaadm.cemail where bank_id=?SVAR and  UPPER (EMAIL)=?SVAR  "
	#sv_s = sv_s + "select count(1) from tbaadm.cemail where   UPPER (EMAIL)=?SVAR  "
	PRINT(sv_s)
