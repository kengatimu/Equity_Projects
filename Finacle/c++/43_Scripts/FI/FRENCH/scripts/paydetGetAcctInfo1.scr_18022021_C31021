	###############################
	#Getting Inputs
	###############################
	
	PRINT(BANCS.INPUT.acctId)
	CUST.DATA.acctId          =     BANCS.INPUT.acctId
	PRINT(BANCS.STDIN.contextBankId)
	CUST.DATA.contextBankId  =     BANCS.STDIN.contextBankId
	PRINT(BANCS.STDIN.userId)
	CUST.DATA.userId         =     BANCS.STDIN.userId
	
	
	PRINT(CUST.DATA.acctId)
	PRINT(CUST.DATA.contextBankId)
	PRINT(CUST.DATA.userId)
	
	###############################
	#Getting Customer solIdDesc
	###############################
	
	sv_s = "solId,acctDesc,crncyCode| "
	sv_s = sv_s + " select SOL_ID,ACCT_NAME,ACCT_CRNCY_CODE"
	sv_s = sv_s + " from tbaadm.gam "
	sv_s = sv_s + " where FORACID=?SVAR AND bank_id =?SVAR"
	sv_s = sv_s + " AND DEL_FLG='N' AND ENTITY_CRE_FLG='Y'"
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = CUST.DATA.acctId +"|"+ CUST.DATA.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_q = urhk_dbSelectWithBind(sv_s)
	IF(sv_q==0)THEN
	#{
		CUST.DATA.solId=BANCS.OUTPARAM.solId
		PRINT(CUST.DATA.solId)
		CUST.DATA.acctDesc=BANCS.OUTPARAM.acctDesc
		PRINT(CUST.DATA.acctDesc)
		CUST.DATA.crncyCode=BANCS.OUTPARAM.crncyCode
		PRINT(CUST.DATA.crncyCode)
		IF(CUST.DATA.solId=="")THEN
		#{
			CUST.DATA.solId = "  "
		#}
		ENDIF
		IF(CUST.DATA.acctDesc=="")THEN
		#{
			CUST.DATA.acctDesc = "  "
		#}
		ENDIF
		IF(CUST.DATA.crncyCode=="")THEN
		#{
			CUST.DATA.crncyCode = "  "
		#}
		ENDIF
		
		#}
	ELSE
		#{
		CUST.DATA.successOrFailure = "N"
		CUST.DATA.solId ="Not a Valid acctId"
		CUST.DATA.acctDesc ="Not a Valid acctId"
		CUST.DATA.crncyCode ="Not a Valid acctId"
	#}
	ENDIF
	
	CUST.DATA.AccNum=""

	 sv_w = "BRCLG" + "|" + "CDF" + "|" +  BANCS.STDIN.mySolId
         print(sv_w)

        sv_r = urhk_B2k_BacidToAcctId(sv_w)
        print(sv_r)

        IF (sv_r == "0") THEN
        #{
                CUST.DATA.AccNum = BANCS.OUTPARAM.AcctId
                print(CUST.DATA.AccNum)
                #}

		sv_a=urhk_getAcctDetailsInRepository(CUST.DATA.AccNum)
		if(sv_a == "0") then

			CUST.DATA.SettleacctDesc=BANCS.OUTPARAM.acctName
			CUST.DATA.SchmCode=BANCS.OUTPARAM.schmCode

			print(CUST.DATA.SettleacctDesc)
			print(CUST.DATA.SchmCode)
		endif

        
	ENDIF

	CUST.DATA.AccNum ="15000117020012"

	sv_z=urhk_SetOrbOut(("successOrFailure"+"|"+CUST.DATA.successOrFailure))
