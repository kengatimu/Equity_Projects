						BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.foracid + "|" + EBSRV.GLBDATA.cifId + "|" + BANCS.INPUT.inpTranParti + "|" + EBSRV.GLBDATA.tran_rmks
						##sv_d = "sdnCnt| select count(*) from custom.ofac_sdn_tbl where bank_id='54' and ((upper(sdn_name) like  ?SVAR) or (lower(sdn_name) like ?SVAR ))"
						##BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.tranParticulars + "|" + EBSRV.GLBDATA.tranParticulars	
