						##BANCS.INPARAM.ValMode = BANCS.INPUT.ValMode
						##BANCS.INPARAM.ValMode = "P" 
						##BANCS.INPARAM.DrCrInd = EBSRV.GLBDATA.partTranType 
						##BANCS.INPARAM.ExceptionIgnoreFlg = BANCS.INPUT.ExceptionIgnoreFlg
						##BANCS.INPARAM.ExceptionIgnoreFlg = "C" 
						##sv_c = urhk_FTS_RaiseException("USN")
						##PRINT(sv_c)
					endif
				#+++++++++++++++++++

				lv_d = "pString | select regexp_replace(?SVAR,'[^[:alnum:]'' '']', NULL) from dual "
				BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.tranParticulars 
				lv_u = urhk_dbSelectWithBind(lv_d)
				if(lv_u==0)then
					lv_i = BANCS.OUTPARAM.pString
				endif
				lv_x = 0
				while(1)
				###{
					lv_x = lv_x + 1
					lv_s = getPosition(lv_i,' ')
					print(lv_s)
