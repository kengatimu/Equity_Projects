					lv_d = " sdnCnt | select custom.fn_unscsdn_chk(?SVAR,?SVAR,?SVAR,'HACLINQ',?SVAR,?SVAR) from dual "
					BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.foracid + "|" + EBSRV.GLBDATA.cifId + "|" + EBSRV.GLBDATA.InfName + "|" + EBSRV.GLBDATA.InfName 
					print(BANCS.INPARAM.BINDVARS)
					print(lv_d)
					lv_u = urhk_dbSelectWithBind(lv_d)
					if(sv_u==0)then
						EBSRV.GLBDATA.sdnCnt = BANCS.OUTPARAM.sdnCnt
					else
						EBSRV.GLBDATA.sdnCnt = "N"
					endif
					print(EBSRV.GLBDATA.sdnCnt)
