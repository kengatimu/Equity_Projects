	endif
USNCHK:
	print(EBSRV.GLBDATA.MMatchCnt)
	print(EBSRV.GLBDATA.MatchCnt)
	if((cdouble(EBSRV.GLBDATA.MatchCnt)>=1) or (cdouble(EBSRV.GLBDATA.MMatchCnt)>=2))then
