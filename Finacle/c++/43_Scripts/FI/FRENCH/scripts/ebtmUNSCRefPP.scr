							EBSRV.GLBDATA.sdnCnt = BANCS.OUTPARAM.sdnCnt
						else
							EBSRV.GLBDATA.sdnCnt = "N"
							##EBSRV.GLBDATA.sdnCnt = 0 
						endif
						print(EBSRV.GLBDATA.sdnCnt)
						if(EBSRV.GLBDATA.sdnCnt=="Y")then
							print(EBSRV.GLBDATA.MatchCnt)
							EBSRV.GLBDATA.MatchCnt = cdouble(EBSRV.GLBDATA.MatchCnt) + 1
							print(EBSRV.GLBDATA.MatchCnt)
							goto USNCHK
						else
							goto USNCHK
						endif
					else
						lv_m = mid$(lv_i,0,lv_s-1)
						print(trim(lv_m))
						#BANCS.INPUT.inpTranParti = lv_m
						BANCS.INPUT.inpTranParti = EBSRV.GLBDATA.tranParticulars
						print(BANCS.INPUT.inpTranParti)
						sv_d = " sdnCnt | select custom.fn_unscsdn_chk(?SVAR,?SVAR,?SVAR,'HACLINQ',?SVAR,?SVAR) from dual "
						BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + EBSRV.GLBDATA.foracid + "|" + EBSRV.GLBDATA.cifId + "|" + BANCS.INPUT.inpTranParti + "|" + EBSRV.GLBDATA.tran_rmks
						##sv_d = "sdnCnt| select count(*) from custom.ofac_sdn_tbl where bank_id='54' and ((upper(sdn_name) like  ?SVAR) or (lower(sdn_name) like ?SVAR ))"
						##BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.tranParticulars + "|" + EBSRV.GLBDATA.tranParticulars	
						print(BANCS.INPARAM.BINDVARS)
						print(sv_d)
						sv_u = urhk_dbSelectWithBind(sv_d)
						if(sv_u==0)then
							EBSRV.GLBDATA.sdnCnt = BANCS.OUTPARAM.sdnCnt
						else
							EBSRV.GLBDATA.sdnCnt = "N"
							##EBSRV.GLBDATA.sdnCnt = 0 
						endif
						print(EBSRV.GLBDATA.sdnCnt)
						if(EBSRV.GLBDATA.sdnCnt=="Y")then
							print(EBSRV.GLBDATA.MMatchCnt)
							EBSRV.GLBDATA.MMatchCnt = cdouble(EBSRV.GLBDATA.MMatchCnt) + 1
							print(EBSRV.GLBDATA.MMatchCnt)
							####goto USNCHK
