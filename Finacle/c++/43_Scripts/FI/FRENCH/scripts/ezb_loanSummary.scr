#------------------------------------------------------------------------------------------------
#  Name            : ezb_loanSummary.scr
#  Description     : Fetchs Loan Summary for Accounts
#  Date            : 28-05-2023
#  Author          : Harrison Ruiru
#  Input           : NA
#  Output          : NA
#  Called Script   : NA
#  Menu Option     :  (API)
#  Srl. No         Date            Author               Description.
#  -------         ------          ------               ------------
#  1.0             28-08-2023     Harrison Ruiru		Original Version
#-----------------------------------------------------------------------------------------------
#####
#-----------------------------------------------------------------------------------------------
<--START
TRACE ON

	sv_u=REPEXISTS("CUST")
	IF(sv_u==0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF

	sv_u=CLASSEXISTS("CUST", "EZB")
	IF(sv_u==0) THEN
	#{
		CREATECLASS("CUST", "EZB", 5)
	#}
	ENDIF

	#BANCS.INPUT.CIFId = "54312489116"

	sv_t=urhk_b2k_printrepos("BANCS")
	print(sv_t)

	IF( (FIELDEXISTS(("BANCS").("INPUT").("AccountList"))== 0) ) THEN
	#{
   		CUST.EZB.errMsg="Please Enter Accounts in Comma Separated Format"
		lv_a = "E9999"
        lv_e = lv_a + "^"+ CUST.EZB.errMsg + "^BE"
        sv_u = urhk_SetOrbErr(lv_e)
        exitscript
   	ELSE
   		CUST.EZB.inputRecord = BANCS.INPUT.AccountList
   		print(CUST.EZB.inputRecord)
	#}
	ENDIF


	IF( (FIELDEXISTS(("BANCS").("INPUT").("TotRec"))== 0) ) THEN
	#{
   		CUST.EZB.errMsg="Please Enter Total Record to be Fetched"
        lv_a = "E9999"
        lv_e = lv_a + "^"+ CUST.EZB.errMsg + "^BE"
		sv_u = urhk_SetOrbErr(lv_e)
		exitscript
	ELSE
		CUST.EZB.totRec = BANCS.INPUT.TotRec
		print(CUST.EZB.totRec)
	#}
	ENDIF

	#---------------------------------------------------------------------------------------------------------------
	# Variable Initialization
	#---------------------------------------------------------------------------------------------------------------
	CUST.EZB.schm_type = "LAA"
	lv_q = 0

	#----------------------------------------------------------------------------------------------
	# Validate AccountList Provided Equals Total Record Tag
	#----------------------------------------------------------------------------------------------


	lv_m = urhk_B2k_isStringNumeric(CUST.EZB.totRec)
	print(lv_m)

	IF(lv_m !=0)THEN
	#{
		CUST.EZB.errMsg = "Invalid Input ["+CUST.EZB.totRec+"] for TotRec Tag"
		lv_a = "E9999"
        lv_e = lv_a + "^"+ CUST.EZB.errMsg + "^BE"
		sv_u = urhk_SetOrbErr(lv_e)
		exitscript
	#}
	ENDIF

	lv_z = CUST.EZB.inputRecord
    print(lv_z)
    lv_y = getposition(lv_z,",")
    print(lv_y)

    lv_x = 0

    WHILE(lv_y > 0)
    #{
        lv_x = lv_x + 1
        print(lv_x)


		CUST.EZB.inputRecord1 = CUST.EZB.inputRecord
        print(CUST.EZB.inputRecord1)

        sv_l = STRLEN (CUST.EZB.inputRecord1)
        print(sv_l)
        sv_l = sv_l - lv_y
        print(sv_l)

        lv_z = mid$(lv_z,lv_y,sv_l)
        print(lv_z)
        CUST.EZB.inputRecord1 = lv_z
        print(CUST.EZB.inputRecord1)

        lv_y = getposition(lv_z,",")
        print(lv_y)
    #}
    DO

    lv_x = lv_x + 1
    print(lv_x)

    IF(lv_x != CUST.EZB.totRec)THEN
    #{
        CUST.EZB.errMsg="Account List Passed does not Match TotRec tag!!"
        lv_a = "E9999"
        lv_e = lv_a + "^"+ CUST.EZB.errMsg + "^BE"
        sv_u = urhk_SetOrbErr(lv_e)
        exitscript
    #}
    ENDIF


	WHILE( lv_q < CUST.EZB.totRec )
	#{
		lv_q = lv_q + 1
		print(lv_q)
		CUST.EZB.created_flg = ""
		CUST.EZB.del_flg = ""
		CUST.EZB.schm_type = ""
		CUST.EZB.acctCloseflg = ""

		sv_v = "rec_" + FORMAT$(lv_q, "%d")

		IF(lv_q == 1)THEN
		#{
	 		sv_c = CUST.EZB.inputRecord
			print(sv_c)
			sv_q = getposition(sv_c,",")
			print(sv_q)

			IF(sv_q > 0)THEN
			#{
				("CUST").("EZB").(sv_v) = Left$(sv_c,sv_q - 1)
				print(("CUST").("EZB").(sv_v))
			ELSE 
				("CUST").("EZB").(sv_v) = CUST.EZB.inputRecord
				print(("CUST").("EZB").(sv_v))
			#}
			ENDIF 
		ELSE
			sv_q = getposition(sv_c,",")
			print(sv_q)

			IF(sv_q > 0)THEN
			#{
				sv_l = STRLEN (CUST.EZB.inputRecord)
				print(sv_l)
				print(CUST.EZB.inputRecord)
				sv_l = sv_l - sv_q
				print(sv_l)
				sv_c = mid$(sv_c,sv_q,sv_l)
				print(sv_c)
				CUST.EZB.inputRecord = sv_c
				print(CUST.EZB.inputRecord)

				sv_q = getposition(sv_c,",")
				print(sv_q)

				("CUST").("EZB").(sv_v) = Left$(sv_c,sv_q - 1)
				print(("CUST").("EZB").(sv_v))

				IF(lv_q == CUST.EZB.totRec)THEN
				#{
					("CUST").("EZB").(sv_v) = CUST.EZB.inputRecord
					print(("CUST").("EZB").(sv_v))
				#}
				ENDIF
			ELSE 
				("CUST").("EZB").(sv_v) = CUST.EZB.inputRecord
				print(("CUST").("EZB").(sv_v))
			#}
			ENDIF 
		#}
		ENDIF


		IF( ("CUST").("EZB").(sv_v) != "")THEN
		#{
			sv_m = "created_flg, del_flg,acid,schm_type,acctOpenDate,acctCloseflg|"
			sv_m = sv_m + "SELECT ENTITY_CRE_FLG, DEL_FLG,ACID,SCHM_TYPE,ACCT_OPN_DATE, ACCT_CLS_FLG FROM TBAADM.GAM WHERE BANK_ID=?SVAR AND FORACID=?SVAR "
			print(sv_m)

			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+ ("CUST").("EZB").(sv_v)
			print(BANCS.INPARAM.BINDVARS)

			lv_s = urhk_dbSelectWithBind(sv_m)
			print(lv_s)

			IF(lv_s == 0)THEN
			#{
				CUST.EZB.created_flg = BANCS.OUTPARAM.created_flg
				print(CUST.EZB.created_flg)
				CUST.EZB.del_flg = BANCS.OUTPARAM.del_flg
				print(CUST.EZB.del_flg)
				CUST.EZB.acid = BANCS.OUTPARAM.acid
				print(CUST.EZB.acid)
				CUST.EZB.schm_type = BANCS.OUTPARAM.schm_type
				print(CUST.EZB.schm_type)
				CUST.EZB.acctOpenDate = BANCS.OUTPARAM.acctOpenDate
				print(CUST.EZB.acctOpenDate)
				CUST.EZB.acctCloseflg = BANCS.OUTPARAM.acctCloseflg
				print(CUST.EZB.acctCloseflg)
			ELSE 
				CUST.EZB.created_flg = ""
				CUST.EZB.del_flg = ""
				CUST.EZB.acid = ""
				CUST.EZB.schm_type = ""
				CUST.EZB.acctOpenDate = ""
				CUST.EZB.acctCloseflg = ""

				CUST.EZB.errMsg="Error occured fetching account details!!"
				lv_a = "E9999"
				lv_e = lv_a + "^"+ CUST.EZB.errMsg + "^BE"
				sv_u = urhk_SetOrbErr(lv_e)
				exitscript
			#}
			ENDIF
				
			IF( (CUST.EZB.created_flg =="Y") AND (CUST.EZB.acctCloseflg=="N") AND (CUST.EZB.del_flg=="N") AND (CUST.EZB.schm_type=="LAA") )THEN
			#{
				#paidEMI
				sv_y = "count | select count (distinct dmd_date) from tbaadm.ldt, tbaadm.lfm, tbaadm.lam where LDT.BANK_ID =?SVAR AND  "
				sv_y = sv_y + " LDT.DEL_FLG !='Y' AND LDT.DMD_FLOW_ID = LFM.FLOW_ID AND LFM.BANK_ID = LDT.BANK_ID and LDT.TOT_ADJ_AMT = LDT.DMD_AMT  AND LDT.ACID =?SVAR AND "
				sv_y = sv_y + " LFM.DEL_FLG !='Y' AND LDT.SHDL_NUM = lam.rep_shdl_num and lam.acid=ldt.acid and lam.bank_id=ldt.bank_id and lam.del_flg !='Y' ORDER BY DMD_EFF_DATE, DECODE(LFM.DMD_TYPE,'P',1,3) "
				print(sv_y)
				BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+  CUST.EZB.acid 
				print(BANCS.INPARAM.BINDVARS)
				
				sv_m = urhk_dbSelectWithBind(sv_y)
				PRINT(sv_m)

				IF(sv_m == 0)THEN
				#{
					CUST.EZB.paidEMI = BANCS.OUTPARAM.count 
					print(CUST.EZB.paidEMI)
				ELSE
					sv_y = "count | select count (distinct dmd_date) from tbaadm.LDTH, tbaadm.lfm, tbaadm.lam where LDTH.BANK_ID =?SVAR AND  "
					sv_y = sv_y + " LDTH.DEL_FLG !='Y' AND LDTH.DMD_FLOW_ID = LFM.FLOW_ID AND LFM.BANK_ID = LDTH.BANK_ID and LDTH.TOT_ADJ_AMT = LDTH.DMD_AMT  AND LDTH.ACID =?SVAR AND "
					sv_y = sv_y + " LFM.DEL_FLG !='Y' AND LDTH.SHDL_NUM = lam.rep_shdl_num and lam.acid=LDTH.acid and lam.bank_id=LDTH.bank_id and lam.del_flg !='Y' ORDER BY DMD_EFF_DATE, DECODE(LFM.DMD_TYPE,'P',1,3) "
					print(sv_y)
					BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+  CUST.EZB.acid 
					print(BANCS.INPARAM.BINDVARS)
					
					sv_m = urhk_dbSelectWithBind(sv_y)
					PRINT(sv_m)
					IF(sv_m == 0)THEN
					#{
						CUST.EZB.paidEMI = BANCS.OUTPARAM.count 
						print(CUST.EZB.paidEMI)
					ELSE
						CUST.EZB.paidEMI = ""
					#}
					ENDIF
				#}
				ENDIF

				lv_s = " count| select Count(*) from tbaadm.ldth where acid=?SVAR and del_flg='N' and bank_id=?SVAR "
				BANCS.INPARAM.BINDVARS = CUST.EZB.acid +"|"+BANCS.STDIN.contextBankId
				lv_c = urhk_dbSelectWithBind(lv_s)
				PRINT(lv_c)

				if(lv_c == 0)then
				#{
					CUST.EZB.count = BANCS.OUTPARAM.count
					print(CUST.EZB.count)

					if(CUST.EZB.count > 0)then
					#{
						CUST.EZB.isDth = "Y"
					ELSE 
						CUST.EZB.isDth = "N"
					#}
					ENDIF 
				#}
				endif

				sv_m = "acct_crncy_code,loan_acct, schm_code,loan_amt,acct_cls_date,loanBalance,schm_desc,accrued_amt_dr,accrued_amt_cr,country_code,total_EMI |"
				sv_m = sv_m + "select * from (select  acct_crncy_code,foracid,schm_code,SANCT_LIM, to_char(acct_cls_date,'DD-MM-YYYY'),clr_bal_amt,"
				sv_m = sv_m + " (SELECT SCHM_DESC FROM TBAADM.GSP gsp WHERE gsp.SCHM_CODE=g.schm_code AND BANK_ID=g.bank_id) schm_desc,"
				sv_m = sv_m + " (select NRML_ACCRUED_AMOUNT_DR from tbaadm.eit e where bank_id=g.bank_id and e.entity_id = g.acid ) accrued_amt_dr, "
				sv_m = sv_m + " (select NRML_ACCRUED_AMOUNT_CR from tbaadm.eit e where bank_id=g.bank_id and e.entity_id = g.acid ) accrued_amt_cr, "
				sv_m = sv_m + " (select a.COUNTRY  from crmuser.accounts a where a.orgkey=g.cif_id and a.bank_id=g.bank_id) country_code,"
				IF(CUST.EZB.isDth == "Y")THEN
				#{
					sv_m = sv_m + " (SELECT SUM(TOT_ADJ_AMT) FROM TBAADM.LDTH l WHERE l.acid=g.acid and l.bank_id=g.bank_id AND l.DMD_FLOW_ID in ('PRDEM', 'INDEM') and g.bank_id=?SVAR ) total_EMI"
				ELSE
					sv_m = sv_m + " (SELECT SUM(TOT_ADJ_AMT)  FROM TBAADM.ldt l WHERE l.acid=g.acid and l.bank_id=g.bank_id AND l.DMD_FLOW_ID in ('PRDEM', 'INDEM') and g.bank_id=?SVAR ) total_EMI"
				#}
				ENDIF

				sv_m = sv_m + " from tbaadm.gam g where "
				sv_m = sv_m + " g.foracid=?SVAR and g.schm_type=?SVAR and g.bank_id=?SVAR and g.entity_cre_flg='Y' and g.del_flg='N' and g.acct_cls_flg='N' )"
				print(sv_m)
				BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+ ("CUST").("EZB").(sv_v) +"|"+ CUST.EZB.schm_type +"|"+ BANCS.STDIN.contextBankId
				print(BANCS.INPARAM.BINDVARS)

				lv_c = urhk_dbSelectWithBind(sv_m)
				PRINT(lv_c)

				IF(lv_c == 0)THEN
				#{
					CUST.EZB.acct_crncy_code = BANCS.OUTPARAM.acct_crncy_code
					print(CUST.EZB.acct_crncy_code)
					CUST.EZB.loan_acct = BANCS.OUTPARAM.loan_acct
					print(CUST.EZB.loan_acct)
					CUST.EZB.schm_code = BANCS.OUTPARAM.schm_code
					print(CUST.EZB.schm_code)
					CUST.EZB.loan_amt = BANCS.OUTPARAM.loan_amt
					print(CUST.EZB.loan_amt)
					CUST.EZB.acct_cls_date = BANCS.OUTPARAM.acct_cls_date
					IF(CUST.EZB.acct_cls_date != "")THEN
					#{
						CUST.EZB.acct_cls_date = CUST.EZB.acct_cls_date + " 00:00:00"
					#}
					ENDIF 
					print(CUST.EZB.acct_cls_date)
					CUST.EZB.schm_desc = BANCS.OUTPARAM.schm_desc
					print(CUST.EZB.schm_desc)
					CUST.EZB.accrued_amt_dr = BANCS.OUTPARAM.accrued_amt_dr
					print(CUST.EZB.accrued_amt_dr)
					CUST.EZB.accrued_amt_cr = BANCS.OUTPARAM.accrued_amt_cr
					print(CUST.EZB.accrued_amt_cr)
					CUST.EZB.loanBalance = BANCS.OUTPARAM.loanBalance
					print(CUST.EZB.loanBalance)
					CUST.EZB.country_code = BANCS.OUTPARAM.country_code
					print(CUST.EZB.country_code)
					#CUST.EZB.paid_EMI = BANCS.OUTPARAM.paid_EMI
					#print(CUST.EZB.paid_EMI)
					CUST.EZB.total_EMI = BANCS.OUTPARAM.total_EMI
					print(CUST.EZB.total_EMI)

					sv_t = "LoanSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.AcctCrnyCode| " + CUST.EZB.acct_crncy_code
					sv_u = urhk_SetOrbOut(sv_t)
					sv_t = "LoanSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.LoanAcct| " + CUST.EZB.loan_acct
					sv_u = urhk_SetOrbOut(sv_t)
					sv_t = "LoanSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.SchmCode| " + CUST.EZB.schm_code
					sv_u = urhk_SetOrbOut(sv_t)
					sv_t = "LoanSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.AcctOpenDate| " + CUST.EZB.acctOpenDate
					sv_u = urhk_SetOrbOut(sv_t)
					sv_t = "LoanSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.LoanAmt| " + CUST.EZB.loan_amt
					sv_u = urhk_SetOrbOut(sv_t)
					sv_t = "LoanSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.AcctClsDate| " + CUST.EZB.acct_cls_date
					sv_u = urhk_SetOrbOut(sv_t)
					sv_t = "LoanSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.SchmDesc| " + CUST.EZB.schm_desc
					sv_u = urhk_SetOrbOut(sv_t)
					sv_t = "LoanSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.AccruedAmtDr| " + CUST.EZB.accrued_amt_dr
					sv_u = urhk_SetOrbOut(sv_t)
					sv_t = "LoanSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.AccruedAmtCr| " + CUST.EZB.accrued_amt_cr
					sv_u = urhk_SetOrbOut(sv_t)
					sv_t = "LoanSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.LoanBalance| " + CUST.EZB.loanBalance
					sv_u = urhk_SetOrbOut(sv_t)
					sv_t = "LoanSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.CountryCode| " + CUST.EZB.country_code
					sv_u = urhk_SetOrbOut(sv_t)
					sv_t = "LoanSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.PaidEMI| " + CUST.EZB.paidEMI
					sv_u = urhk_SetOrbOut(sv_t)
					sv_t = "LoanSummary_RES.<rec_" + FORMAT$(lv_q,"%d") + ">.TotalEMI| " + CUST.EZB.total_EMI
					sv_u = urhk_SetOrbOut(sv_t)
				ELSE
					lv_t = "Error Fetching the Record, Account ["+("CUST").("EZB").(sv_v)+"]" 
					sv_t = "Message.<rec_" + FORMAT$(lv_q,"%d") + ">.Error| " + lv_t
					sv_u = urhk_SetOrbOut(sv_t)
				#}
				ENDIF
				
			ELSE
				IF(CUST.EZB.created_flg =="N")THEN
					CUST.EZB.errMsg = "Account creation not yet authorised : "+ ("CUST").("EZB").(sv_v)
				ENDIF
				IF(CUST.EZB.del_flg =="Y")THEN
					CUST.EZB.errMsg = "The record is deleted : "+("CUST").("EZB").(sv_v)
				ENDIF
				IF(CUST.EZB.acctCloseflg =="Y")THEN
					CUST.EZB.errMsg = "Account has been closed : "+ ("CUST").("EZB").(sv_v)
				ENDIF
				IF(CUST.EZB.schm_type !="LAA")THEN
					CUST.EZB.errMsg = "The account is not of 'LAA' type : "+ ("CUST").("EZB").(sv_v)
				ENDIF

				lv_t = "The account is not of 'LAA' type."
				sv_t = "Message.<rec_" + FORMAT$(lv_q,"%d") + ">.Error| " + CUST.EZB.errMsg
				sv_u = urhk_SetOrbOut(sv_t)
			#}
			ENDIF
		#}
		ENDIF
	#}
	DO

ENDSCRIPT:
trace off
END-->