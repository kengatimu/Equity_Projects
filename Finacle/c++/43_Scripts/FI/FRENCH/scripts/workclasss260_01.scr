<--START
CHECKSUM="da99cdc057faee76ebf0975c5b9a6c743b54c1a908e614af21f664756f893cc7"
	TRACE ON

sv_u = urhk_B2k_PrintRepos("BANCS")
print(sv_u)

	IF (CLASSEXISTS("CUST","TELLER") == 0) THEN
	#{
		CREATECLASS("CUST","TELLER",5)
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","CPARAM") == 0) THEN
	#{
		CREATECLASS("CUST","CPARAM",5)
	#}
	ENDIF
	
	#-----------------------------------------------------------------------------------------------
	# Initializing Out Variables
	#-----------------------------------------------------------------------------------------------
	CUST.TELLER.errMsg = ""
	
	#-----------------------------------------------------------------------------------------------
	# Finding no of part trans in transaction
	#-----------------------------------------------------------------------------------------------
	sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranType")
	PRINT(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.TELLER.tranType = BANCS.OUTPARAM.srvValue
		PRINT(CUST.TELLER.tranType)
	#}
	ENDIF
	
	sv_u = urhk_SRV_GetVal("tranHdr.tranTypeSubType.tranSubType")
	PRINT(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.TELLER.tranSubType = BANCS.OUTPARAM.srvValue
		PRINT(CUST.TELLER.tranSubType)
	#}
	ENDIF

	PRINT(BANCS.STDIN.userWorkClass)
	IF (BANCS.STDIN.userWorkClass=="260") THEN
		IF ( (CUST.TELLER.tranType == "T" ) AND ( (CUST.TELLER.tranSubType == "CI") OR (CUST.TELLER.tranSubType == "BI") OR (CUST.TELLER.tranSubType == "CT") ) ) THEN
		#{
			#---------------------------------------------------------------------
			#---Finding whether user is teller or not
			#---------------------------------------------------------------------
			sv_s=""
			sv_s = sv_s + " cnt|"
			sv_s = sv_s + " SELECT count(1)"
			sv_s = sv_s + " FROM TBAADM.UPR "
			sv_s = sv_s + " WHERE UPR.user_id = ?SVAR"
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.userId
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_d = urhk_dbselectWithBind(sv_s)
			PRINT(sv_d)
			IF ( CINT(BANCS.OUTPARAM.cnt) > 0 ) THEN
			#{
				PRINT(BANCS.OUTPARAM.cnt)
				IF ( BANCS.INPUT.srvcallmode == "E" ) THEN
				#{
					sv_u = urhk_B2k_PutUserException("VA6")
					PRINT(sv_u)
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	ENDIF
	
	EXITSCRIPT
END-->
