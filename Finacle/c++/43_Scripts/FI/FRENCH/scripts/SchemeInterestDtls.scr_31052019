sv_a = "Record.<rec_" + CUST.DATA.number + ">.INT_SLAB_SRL_NUM"+ CUST.DATA.number +"|" + CUST.DATA.INT_SLAB_SRL_NUM
sv_b = "Record.<rec_" + CUST.DATA.number + ">.CRNCY_CODE|" + CUST.DATA.CRNCY_CODE
sv_c = "Record.<rec_" + CUST.DATA.number + ">.NRML_INT_PCNT|" + CUST.DATA.NRML_INT_PCNT
sv_d = "Record.<rec_" + CUST.DATA.number + ">.SCHM_CODE|" + CUST.DATA.SCHM_CODE
sv_e = "Record.<rec_" + CUST.DATA.number + ">.MAX_SLAB_AMOUNT|" + CUST.DATA.MAX_SLAB_AMOUNT
sv_o = "Record.<rec_" + CUST.DATA.number + ">.MAX_CONTRACTED_MTHS|" + CUST.DATA.MAX_CONTRACTED_MTHS
sv_f = "Record.<rec_" + CUST.DATA.number + ">.MIN_INT_PCNT_CR|" + CUST.DATA.MIN_INT_PCNT_CR
sv_g = "Record.<rec_" + CUST.DATA.number + ">.MAX_INT_PCNT_CR|" + CUST.DATA.MAX_INT_PCNT_CR



