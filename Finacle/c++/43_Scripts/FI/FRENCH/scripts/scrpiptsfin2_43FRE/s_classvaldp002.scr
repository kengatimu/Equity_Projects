#-------------------------------------------------------------------------------------
#    Name				: s_classvaldp002.scr
#    Description     	: The script is for checking the workclass of a user and prevents
#						: same or lower workclass from authorizing
#    Date            	: 05-02-2013
#    Author          	: Divya
#    Input           	: NA
#    Output				: NA
#    Called Script		: NA
#    Calling Script		: getcparamvalue.scr
#    Menu Option		: HACM
#    Srl. No		Date			Author			Description.
#    -------		----			------			----------------
#    1.0		05-02-2013			Divya	 		Original Version
#-------------------------------------------------------------------------------------
<--START
CHECKSUM="40ab67e6b4fba638d77ca7839c38d0810a029a1af142b1073e317e593dd173a8"
	TRACE ON
	
	
	#------------------------------------------------------------------------------
	#       Creating repository and class
	#       Initializing the variables
	#       Getting all the values from CPARAM
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","ACCTDTL") == 0) THEN
	#{
		CREATECLASS("CUST","ACCTDTL",5)
	#}
	ENDIF
	
	
	#---------------------------------------------------------------------------------------------
	# Initialize repository variables
	#---------------------------------------------------------------------------------------------
	CUST.ACCTDTL.errMsg    = ""
	CUST.ACCTDTL.res       = ""
	CUST.ACCTDTL.acctNo    = ""
	CUST.ACCTDTL.WC1       = ""
	CUST.ACCTDTL.WC2       = ""
	CUST.ACCTDTL.WC3       = ""
	
	BANCS.INPUT.moduleName  = "ACCTMAINTENCE"
	BANCS.INPUT.parameterId = "CLASSVAL_WC1"
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.ACCTDTL.WC1 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.ACCTDTL.errMsg = "Work Class setup not done CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	BANCS.INPUT.parameterId = "CLASSVAL_WC2"
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.ACCTDTL.WC2 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.ACCTDTL.errMsg = "Work Class setup not done CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "CLASSVAL_WC4"
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.ACCTDTL.WC4 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.ACCTDTL.errMsg = "Work Class setup not done CPARAM"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	sv_u = urhk_SRV_GetVal("acctCommonInfo.acctGeneralInfo.acctBasic.foracid")
	CUST.ACCTDTL.acctNo = BANCS.OUTPARAM.srvValue
	PRINT(CUST.ACCTDTL.acctNo)
	
	IF (BANCS.STDIN.contextBankId == "43") THEN
	#{
		sv_u = urhk_getAcctDetailsInRepository(CUST.ACCTDTL.acctNo)
		PRINT(BANCS.OUTPARAM.acctSolId)
		PRINT(BANCS.STDIN.mySolId)
		PRINT(BANCS.STDIN.userWorkClass)
		PRINT(CUST.ACCTDTL.WC1)
		PRINT(CUST.ACCTDTL.WC2)
		PRINT(CUST.ACCTDTL.WC4)
		IF (sv_u == 0) THEN
		#{
			PRINT(BANCS.OUTPARAM.acctSolId)
			PRINT(BANCS.STDIN.mySolId)
			IF (BANCS.OUTPARAM.acctSolId != BANCS.STDIN.mySolId) THEN
			#{
				IF ((BANCS.STDIN.userWorkClass != CUST.ACCTDTL.WC1) AND (BANCS.STDIN.userWorkClass != CUST.ACCTDTL.WC2) AND (BANCS.STDIN.userWorkClass != CUST.ACCTDTL.WC4)) THEN
				#{
					CUST.ACCTDTL.errMsg = "No Intersol Activation"
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	
	ENDOFSCRIPT:
		IF (CUST.ACCTDTL.errMsg != "") THEN
		#{
			sv_u = urhk_SRV_SetErr(CUST.ACCTDTL.errMsg)
			BANCS.OUTPUT.successOrFailure = "F"
		#}
		ENDIF
		
		PRINT("HI")
		#TRACE OFF
		EXITSCRIPT
END-->
