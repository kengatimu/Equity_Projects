
<--START
	TRACE ON
	###############################
	#creating class and repository
	###############################
	IF(REPEXISTS("CUST")==0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF(CLASSEXISTS("CUST","DATA")==0) THEN
	#{
		CREATECLASS("CUST","DATA",5)
	#}
	ENDIF
	
	sv_a = urhk_B2k_PrintRepos("BANCS")
	
	###############################
	#Initializing variables
	###############################
	
			CUST.DATA.var_units=0
			CUST.DATA.cust_var=0

	CUST.DATA.acctId = ""
	
	CUST.DATA.solId=""
	CUST.DATA.acctDesc=""
	CUST.DATA.crncyCode=""

	CUST.DATA.SettleacctDesc=""
        CUST.DATA.SchmCode=""
	CUST.DATA.successOrFailure = "Y"
	CUST.DATA.errFlg= "N"
	CUST.DATA.errMsg= " "
	CUST.DATA.rateamt= "1001.00"
	CUST.DATA.ratecode=""
	CUST.DATA.crncyCode=""

	IF(FIELDEXISTS(BANCS.INPUT.tranccy)) THEN
	#{
		IF(TRIM(BANCS.INPUT.tranccy) != "")THEN
		#{
			CUST.DATA.crncyCode= TOUPPER(TRIM(BANCS.INPUT.tranccy))
			PRINT(CUST.DATA.crncyCode)
		#}
		ENDIF
		#}
	ENDIF

		sv_a= ""

	sv_a="ratecode_tran|select ratecode_tran from custom.c_ratecode where  "
	sv_a = sv_a + " from_currency = ?SVAR"
	sv_a = sv_a + " AND to_currency='CDF' "
	sv_a = sv_a + " AND bank_id ='43'"

	PRINT(sv_a)
	BANCS.INPARAM.BINDVARS = CUST.DATA.crncyCode
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_q = urhk_dbSelectWithBind(sv_a)
	IF(sv_q==0)THEN
	print(BANCS.OUTPARAM.ratecode_tran)

	CUST.DATA.ratecode=BANCS.OUTPARAM.ratecode_tran

		sv_a= ""
		sv_a= "var_units,cust_var|select var_crncy_units,CUST_VAR_CRNCY_UNITS "
	 	sv_a = sv_a + "from tbaadm.rtl t "
	 	sv_a = sv_a + "where ratecode=?SVAR AND fxd_crncy_code=?SVAR AND var_crncy_code='CDF' AND bank_id ='43' "
	 	sv_a = sv_a + "and rtlist_num in "
	 	sv_a = sv_a + "(select max(rtlist_num) from tbaadm.rtl l where bank_id='43' and l.fxd_crncy_code=t.fxd_crncy_code "
	 	sv_a = sv_a + "and l.var_crncy_code =t.var_crncy_code and l.ratecode=t.ratecode) and rownum=1 "

		PRINT(sv_a)
		BANCS.INPARAM.BINDVARS = CUST.DATA.ratecode+"|"+ CUST.DATA.crncyCode
		PRINT(BANCS.INPARAM.BINDVARS)
	
		sv_q = urhk_dbSelectWithBind(sv_a)

		IF(sv_q==0)THEN

			CUST.DATA.var_units=BANCS.OUTPARAM.var_units
			CUST.DATA.cust_var=BANCS.OUTPARAM.cust_var
			print(CUST.DATA.var_units)
			print(CUST.DATA.cust_var)
		ENDIF



	ENDIF

#errFlg|errMsg|rateamt
	sv_z=urhk_SetOrbOut(("errFlg"+"|"+CUST.DATA.errFlg))
	PRINT(sv_z)
	sv_z=urhk_SetOrbOut(("errMsg"+"|"+CUST.DATA.errMsg))
	PRINT(sv_z)
	sv_z=urhk_SetOrbOut(("rateamt"+"|"+CUST.DATA.cust_var))
	PRINT(sv_z)
	sv_z=urhk_SetOrbOut(("ratecode"+"|"+CUST.DATA.ratecode))
	PRINT(sv_z)


	IF(CLASSEXISTS("CUST","DATA")!=0) THEN
	#{
		DELETECLASS("CUST","DATA")
	#}
	ENDIF
	IF(REPEXISTS("CUST")!=0) THEN
	#{
		DELETEREP("CUST")
	#}
	ENDIF
	TRACE OFF
	EXITSCRIPT
	
END-->









