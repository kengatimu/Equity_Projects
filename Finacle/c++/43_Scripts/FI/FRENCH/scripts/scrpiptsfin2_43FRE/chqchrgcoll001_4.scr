	IF(CUST.DATA.chrgType == "P")THEN
	#{
		sv_s="chrgpcnt,minAmt,maxAmt|SELECT PRCNT,MIN_AMT,MAX_AMT FROM CUSTOM.CUSTOM_CCPRM WHERE EVENT_TYPE=?SVAR AND EVENT_ID=?SVAR AND DEL_FLG = 'N' AND ENTITY_CRE_FLG='Y'"
		sv_s = sv_s + " AND SCHM_CODE=?SVAR AND CRNCY_CODE=?SVAR AND BANK_ID=?SVAR AND SRL_NUM=?SVAR"
		BANCS.INPARAM.BINDVARS = CUST.DATA.eventType + "|" + CUST.DATA.eventId + "|" + CUST.DATA.schmCode + "|" + CUST.DATA.crncy + "|" + BANCS.STDIN.contextBankId + "|" + CUST.DATA.srlNum
		PRINT(sv_s)
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d=urhk_dbSelectWithBind(sv_s)
		IF(sv_d != "0")THEN
		#{
			sv_e="Charge percentage not maintained in CCPRM for scheme code "+CUST.DATA.schmCode+" AND Currency Code "+CUST.DATA.crncy
			sv_u = urhk_SetOrbErr(sv_e)
			sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
