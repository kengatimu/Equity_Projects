<--START
TRACE ON
	
	#-----------------------------------------
	#  Create the required repository Classes
	#------------------------------------------
	
                IF(REPEXISTS("CUST") == 0) THEN
                #{
                        CREATEREP("CUST")
                #}
                ENDIF

                IF (CLASSEXISTS("CUST", "DATA") == 0) THEN
                #{
                        CREATECLASS("CUST", "DATA", 5)
                #}
                ENDIF

	#--------------------------------
	# Fetching input values
	#-------------------------------

		IF(FIELDEXISTS(BANCS.INPUT.foracid)) THEN
		#{
			CUST.DATA.foracid = BANCS.INPUT.foracid
			PRINT(CUST.DATA.foracid)
		#}
		ENDIF
		
		IF(FIELDEXISTS(BANCS.INPUT.acctNum)) THEN
		#{
			CUST.DATA.foracid = BANCS.INPUT.acctNum
			PRINT(CUST.DATA.foracid)
		#}
		ENDIF
	
	#--------------------------------
	# Intialization of Local Fields
	#-------------------------------
	
		CUST.DATA.iban	= "0"
		CUST.DATA.bcdcFlg	= "N"
	
	#---------------------------------------------
	#	Fetching Event details from PTT table
	#---------------------------------------------

		lv_q = "iban|SELECT IBAN_NUMBER  FROM TBAADM.GAM WHERE FORACID = ?SVAR AND BANK_ID = ?SVAR "
		PRINT(lv_q)

		BANCS.INPARAM.BINDVARS = CUST.DATA.foracid +"|"+ BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)

		lv_u = urhk_dbSelectWithBind(lv_q)
		PRINT(lv_u)

		IF(lv_u == "0") THEN
		#{
			CUST.DATA.iban	 = BANCS.OUTPARAM.iban
			PRINT(CUST.DATA.iban)

		#}
                ELSE
                #{
                        CUST.DATA.iban = " "
                #} 
		ENDIF
                IF(CUST.DATA.foracid == "") THEN
                #{
                      CUST.DATA.iban = "" 
                #}
                ENDIF
	#---------------------------------------------
	#	Sending values back to mrt
	#---------------------------------------------
	
		BANCS.OUTPUT.ibanNum      = CUST.DATA.iban
END-->
