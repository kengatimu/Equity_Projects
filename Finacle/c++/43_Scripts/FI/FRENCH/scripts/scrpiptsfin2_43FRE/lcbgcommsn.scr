		MTT.PartTranDetails.RefAmount=CDOUBLE(CUST.COMMS.commsamt)
		PRINT(MTT.PartTranDetails.RefAmount)
		MTT.PartTranDetails.Particulars="COMM COLL." + CUST.COMMS.lcbgnum
		MTT.PartTranDetails.RefCurrency= BANCS.STDIN.homeCrncyCode
		MTT.PartTranDetails.ValueDate="0"
		MTT.PartTranDetails.ReportCode = ""
		MTT.PartTranDetails.Consolidate="Y"
		MTT.PartTranDetails.TranIdentifier="COMMS_Tran"
		MTT.PartTranDetails.PTranBusinessType=""
		sv_o = urhk_MTTS_DefinePartTran("COMMS_Credit_Tran")
		PRINT(sv_o)
		
		###################################################
		
		MTT.PartTranDetails.Account=CUST.COMMS.commsvatacnt
		PRINT(CUST.COMMS.vatamt)
		MTT.PartTranDetails.RefAmount=CDOUBLE(CUST.COMMS.vatamt)
		PRINT(MTT.PartTranDetails.RefAmount)
		MTT.PartTranDetails.Particulars="COMM COLL." + CUST.COMMS.lcbgnum
		MTT.PartTranDetails.RefCurrency= BANCS.STDIN.homeCrncyCode
		MTT.PartTranDetails.ValueDate="0"
		MTT.PartTranDetails.ReportCode = ""
		MTT.PartTranDetails.Consolidate="Y"
		MTT.PartTranDetails.TranIdentifier="COMMS_Tran"
		MTT.PartTranDetails.PTranBusinessType=""
		sv_o = urhk_MTTS_DefinePartTran("COMMS_Credit_Tran1")
		PRINT(sv_o)
		
		sv_r = urhk_MTTS_EndDefinition("")
		PRINT(sv_r)
		PRINT(BANCS.OUTPARAM.MTTTranId)
		CUST.COMMS.tranid = BANCS.OUTPARAM.MTTTranId
		IF(CUST.COMMS.tranid == "" )THEN
		#{
			CUST.COMMS.COMMSflg = "N"
			CUST.COMMS.BODDate = ""
			#}
		ELSE
			#{
			CUST.COMMS.COMMSflg = "Y"
		#}
		ENDIF
		sv_z = urhk_MTTS_Close("")
		PRINT(sv_z)
		
		
		IF(CUST.COMMS.COMMSflg == "Y") THEN
		#{
			sv_s = "INSERT INTO CUSTOM.C_COMM_MAINT_TRAN(LC_OR_BG_NUM,LC_OR_BG_TYPE,TRAN_ID,TRAN_AMT,RATE_CODE,TRAN_DATE,BANK_ID,RCRE_USER_ID,RCRE_TIME)"
			sv_s = " VALUES(?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,sysdate)"
			BANCS.INPARAM.BINDVARS=CUST.COMMS.lcbgnum +"|"+CUST.COMMS.lcbgtype + "|" + CUST.COMMS.tranid + "|" + CUST.COMMS.totalamt + "|" + CUST.COMMS.rateCode1
			BANCS.INPARAM.BINDVARS= BANCS.INPARAM.BINDVARS + "|" + CUST.COMMS.BODDate+ "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.userId
			PRINT(sv_s)
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_q = urhk_dbSQLWithBind(sv_s)
			PRINT(sv_q)
			IF(sv_q != 0)THEN
			#{
				CUST.COMMS.errorMsg ="Database Insertion Failed"
				PRINT(CUST.COMMS.errorMsg)
				GOTO NEXTACID
				
			#}
			ENDIF
			
			IF(CUST.COMMS.comm_freq == "D")THEN
			#{
				sv_s = "next_date|SELECT (?SVAR + 1) FROM DUAL"
			#}
			ENDIF
			
			IF(CUST.COMMS.comm_freq == "M")THEN
			#{
				sv_s = "next_date|SELECT ADD_MONTHS(?SVAR,1) FROM DUAL"
			#}
			ENDIF
			
			IF(CUST.COMMS.comm_freq == "Q")THEN
			#{
				sv_s = "next_date|SELECT ADD_MONTHS(?SVAR,3) FROM DUAL"
			#}
			ENDIF
			
			IF(CUST.COMMS.comm_freq == "H")THEN
			#{
				sv_s = "next_date|SELECT ADD_MONTHS(?SVAR,6) FROM DUAL"
			#}
			ENDIF
			
			IF(CUST.COMMS.comm_freq == "Y")THEN
			#{
				sv_s = "next_date|SELECT ADD_MONTHS(?SVAR,12) FROM DUAL"
			#}
			ENDIF
			
			BANCS.INPARAM.BINDVARS = CUST.COMMS.nxt_comm_date
			PRINT(sv_s)
			PRINT(BANCS.INPARAM.BINDVARS)
			
			sv_b=urhk_dbSelectWithBind(sv_s)
			PRINT(sv_b)
			IF (sv_b == 0) THEN
			#{
				CUST.COMMS.next_date=BANCS.OUTPARAM.next_date
				PRINT(CUST.COMMS.next_date)
			#}
			ENDIF
			sv_s = "UPDATE CUSTOM.C_COMM_MAINT SET NEXT_COMM_DATE=?SVAR WHERE LC_OR_BG_NUM=?SVAR AND BANK_ID=?SVAR"
			BANCS.INPARAM.BINDVARS=CUST.COMMS.next_date + "|" + CUST.COMMS.lcbgnum +"|"+ BANCS.STDIN.contextBankId
			PRINT(sv_s)
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_q = urhk_dbSQLWithBind(sv_s)
			PRINT(sv_q)
			IF(sv_q != 0)THEN
			#{
				CUST.COMMS.errorMsg ="Database Updation Failed"
				PRINT(CUST.COMMS.errorMsg)
				GOTO NEXTACID
				
			#}
			ENDIF
			
		#}
		ENDIF
		
		NEXTACID:
			sv_f = urhk_dbCursorFetch(sv_n)
			PRINT(sv_f)
			
		#}
		DO
		sv_c = urhk_dbCursorClose(sv_n)
		PRINT(sv_c)
		
	ENDOFSCRIPT:
		IF(CUST.COMMS.errMsg == "") THEN
		#{
			CUST.COMMS.errMsg = " |Batch Job executed with out any Errors"
			sv_b = urtn_fileWrite(CUST.COMMS.failFileIndex1 + "|" + CUST.COMMS.errMsg)
			PRINT(sv_b)
		#}
		ENDIF
		
		sv_c = urtn_fileClose(CUST.COMMS.failFileIndex1)
		PRINT(sv_c)
		
		
		CUST.COMMS.ERR000002 = "Failed "
		PRINT(CUST.COMMS.list_file_name)
		sv_r = "exebatch mrbx4004 $B2K_SESSION_ID " + CUST.COMMS.mrt_file_name + " " + CUST.COMMS.list_file_name + " " + CUST.COMMS.rpt
		PRINT(sv_r)
		sv_r = SYSTEM(sv_r)
		IF (sv_r != 0) THEN
		#{
			Sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			Sv_u = urhk_SetOrbOut("Error_1|ERR^" + CUST.COMMS.ERR000002 + "")
			GOTO FINISH
		#}
		ENDIF
		sv_q = "exebatch babx4040 $B2K_SESSION_ID " + " "+ CUST.COMMS.rpt_file_name+" '" + CUST.COMMS.title+"' MANAGER 1 N"
		PRINT(sv_q)
		sv_r = SYSTEM(sv_q)
		IF (sv_r != 0) THEN
		#{
			Sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
			Sv_u = urhk_SetOrbOut("Error_1|ERR^" + CUST.COMMS.ERR000002 + "^DATE")
			GOTO FINISH
		#}
		ENDIF
		
	FINISH:
		TRACE OFF
END-->
