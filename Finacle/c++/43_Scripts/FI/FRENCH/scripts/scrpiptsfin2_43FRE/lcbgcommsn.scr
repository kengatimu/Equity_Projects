		sv_s = "min_comm,comm_pcnt,comm_vat_pcnt,comm_crncy|SELECT MIN_COMM,COMM_PCNT,VAT_RATE,CRNCY_CODE FROM CUSTOM.C_COMM WHERE BANK_ID=?SVAR AND COMM_CODE=?SVAR"
		BANCS.INPARAM.BINDVARS=BANCS.STDIN.contextBankId + "|" + CUST.COMMS.comm_code
		sv_r = urhk_dbselectWithBind(sv_s)
