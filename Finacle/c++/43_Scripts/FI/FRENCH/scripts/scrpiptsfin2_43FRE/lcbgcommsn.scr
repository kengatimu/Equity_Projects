			BANCS.INPARAM.RateCode     = CUST.COMMS.rateCode
			BANCS.INPARAM.Rate         = CDOUBLE("0.0")
			#----------------------------------------------------------------------
			#Convert The Uncollected Amount Into AED for Storing Into Custom Table
			#----------------------------------------------------------------------
			lv_f = urhk_B2k_ConvertAmount("")
			IF(lv_f == 0)THEN
			#{
				CUST.COMMS.commsamt = BANCS.OUTPARAM.OutputAmount
				PRINT(CUST.COMMS.commsamt)
				#}
				
			#}
			ENDIF
			
			
		#}
		ENDIF
		
		IF(CUST.COMMS.commsamt < CUST.COMMS.min_comm) THEN
		#{
			CUST.COMMS.commsamt = CUST.COMMS.min_comm
		#}
		ENDIF
		
		CUST.COMMS.vatamt = CDOUBLE(CUST.COMMS.commsamt) * CDOUBLE(CUST.COMMS.comm_vat_pcnt)
		
		PRINT(CUST.COMMS.vatamt)
		PRINT(CUST.COMMS.commsamt)
		#PRINT(CUST.COMMS.totalamt)
		
		##############################################################
		# Converting the amount into commission account home currency
		##############################################################
		
		IF(CUST.COMMS.comm_crncy != BANCS.STDIN.homeCrncyCode)THEN
		#{
			sv_s = "rateCode|SELECT RATECODE_TRAN FROM CUSTOM.C_RATECODE WHERE FROM_CURRENCY=?SVAR AND TO_CURRENCY=?SVAR AND ENTITY_CRE_FLG='Y' "
			sv_s = sv_s + "AND DEL_FLG='N' AND BANK_ID=?SVAR"
			BANCS.INPARAM.BINDVARS = CUST.COMMS.comm_crncy + "|" + BANCS.STDIN.homeCrncyCode + "|" + BANCS.STDIN.contextBankId
			PRINT(sv_s)
			PRINT(BANCS.INPARAM.BINDVARS)
