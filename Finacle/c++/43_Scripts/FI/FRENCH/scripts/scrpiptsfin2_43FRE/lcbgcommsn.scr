		sv_s = sv_s + "AND DEL_FLG='N' AND BANK_ID=?SVAR"
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.homeCrncyCode +"|"+ CUST.COMMS.actcrncy + "|" + BANCS.STDIN.contextBankId
		PRINT(sv_s)
		PRINT(BANCS.INPARAM.BINDVARS)
