				CUST.COMMS.errMsg =CUST.COMMS.lcbgnum + "Rate code currency conversion combination not maintained"
				sv_b = urtn_fileWrite(CUST.COMMS.failFileIndex1 + "|" + CUST.COMMS.errMsg)
				PRINT(sv_b)
				GOTO NEXTACID
			#}
			ENDIF
			
		#}
		ENDIF
		CUST.COMMS.totalamt = CDOUBLE(CUST.COMMS.commsamt) + CDOUBLE(CUST.COMMS.vatamt)
		PRINT(CUST.COMMS.vatamt)
