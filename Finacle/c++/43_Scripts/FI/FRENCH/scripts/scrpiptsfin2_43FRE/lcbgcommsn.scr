			#{
			PRINT("Account Not Found")
			GOTO NEXTACID
		#}
		ENDIF
		#################################################################
		# Commission and VAT amount calculation
		#################################################################
		
		CUST.COMMS.commsamt = CDOUBLE(CUST.COMMS.lcbg_amt) * CDOUBLE(CUST.COMMS.comm_pcnt)
		
		###If commission amount is less than minimum amount, Minimum amoun to be considered as commission amount
		IF(CUST.COMMS.actcrncy != CUST.COMMS.comm_crncy)THEN
		#{
			sv_s = "rateCode|SELECT RATECODE_TRAN FROM CUSTOM.C_RATECODE WHERE FROM_CURRENCY=?SVAR AND TO_CURRENCY=?SVAR AND ENTITY_CRE_FLG='Y' "
			sv_s = sv_s + "AND DEL_FLG='N' AND BANK_ID=?SVAR"
			BANCS.INPARAM.BINDVARS = CUST.COMMS.actcrncy + "|" + CUST.COMMS.comm_crncy + "|" + BANCS.STDIN.contextBankId
