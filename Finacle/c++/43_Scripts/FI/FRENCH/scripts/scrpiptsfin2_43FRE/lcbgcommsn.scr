		PRINT(MTT.PartTranDetails.RefAmount)
		MTT.PartTranDetails.Consolidate = "Y"
		MTT.PartTranDetails.TranIdentifier = "COMMS_Tran"
		#MTT.PartTranDetails.PartTranIdentifier = "OPER_DEBIT1"
		#MTT.PartTranDetails.PTranBusinessType = "OPDEB"
		MTT.PartTranDetails.CarveAmtFlg="Y"
		sv_r = urhk_MTTS_DefinePartTran("COMMS_DEBIT1")
