########################################################################################################################

<--START
CHECKSUM="c27bdc955f9de31a9a0886cedd3fe6c0e59e63eb815b456546fa1173b665fbb7"
	TRACE ON
	
	sv_r = REPEXISTS("CUST")
	IF (sv_r == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	sv_r = CLASSEXISTS("CUST", "OUTCITA")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("CUST", "OUTCITA", 5)
	#}
	ENDIF
	
	CUST.OUTCITA.errMsg 	= ""
	CUST.OUTCITA.zone1 		= ""
	CUST.OUTCITA.zone2 		= ""
	CUST.OUTCITA.headOffSol = ""
	
	######################################################
	# Inputs from jsp
	######################################################
	print(BANCS.INPUT.zoneCode)
	sv_z = BANCS.INPUT.zoneCode
	
	BANCS.INPUT.moduleName = "CLEARING"
	BANCS.INPUT.parameterId = "ZONE_CTSBOWZ"
	call("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.OUTCITA.zone1 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.OUTCITA.zone1 = ""
		CUST.OUTCITA.errMsg = "CPARAM set up not done for zone code CTSBOWZ"
		GOTO FINISH
	#}
	ENDIF
	
	BANCS.INPUT.parameterId="ZONE_CTSINHSE"
	call("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.OUTCITA.zone2 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.OUTCITA.zone2 = ""
		CUST.OUTCITA.errMsg = "CPARAM set up not done for zone code CTSINHSE"
		GOTO FINISH
	#}
	ENDIF
	
	BANCS.INPUT.parameterId="SOL_000"
	call("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.OUTCITA.headOffSol = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.OUTCITA.headOffSol = ""
		CUST.OUTCITA.errMsg = "CPARAM set up not done for zone code HOME SOLID(000)"
		GOTO FINISH
	#}
	ENDIF
	IF ((BANCS.STDIN.homeSolId != CUST.OUTCITA.headOffSol) AND ((sv_z == CUST.OUTCITA.zone1) OR (sv_z == CUST.OUTCITA.zone2)) ) THEN
	#{
		print("true")
		sv_u = urhk_SetOrbOut("paramV|Y")
		#}
	ELSE
		#{
		sv_u = urhk_SetOrbOut("paramV|N")
		print(sv_u)
	#}
	ENDIF
	
	FINISH:
		IF (CUST.OUTCITA.errMsg != "") THEN
		#{
			sv_u = urhk_SetOrbOut("Error|"+CUST.OUTCITA.errMsg)
			print(sv_u)
		#}
		ENDIF
		
		TRACE OFF
		EXITSCRIPT
END-->
