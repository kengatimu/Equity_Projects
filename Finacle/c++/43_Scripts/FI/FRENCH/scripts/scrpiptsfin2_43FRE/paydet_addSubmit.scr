<--START
	# Script body goes here
	TRACE ON

CUST.DATA.Ecstranrefnum=""


		sv_a = "xmlmessage,tempSysDate,dateyy,dateTT|"
sv_a = sv_a + "SELECT TO_CHAR(systimestamp,'yymmddhhmissxff'),TO_CHAR(sysdate,'YYMMDDHH24MISS'),trim(TO_CHAR(sysdate,'YYYY-MM-DDHH24:MI:SS')),TO_CHAR(sysdate,'YYYY-MM-DD') FROM dual"

		sv_r = urhk_dbSelectWithBind(sv_a)
            IF (sv_r == 0) THEN
            #{
                CUST.DATA.msgTime = BANCS.OUTPARAM.xmlmessage
                CUST.DATA.Ecstranrefnum= "ECS" + BANCS.OUTPARAM.tempSysDate
                CUST.DATA.dateyy= BANCS.OUTPARAM.dateyy
                CUST.DATA.dateTT= BANCS.OUTPARAM.dateTT

		#}
			ENDIF
	print(CUST.DATA.Ecstranrefnum)


	BANCS.INPARAM.BINDVARS =    CUST.DATA.remitamt+"|"+   CUST.DATA.trantype  
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.DATA.funcCode+"|"+ CUST.DATA.Ecstranrefnum+"|"+ CUST.DATA.paysysid+"|"+ CUST.DATA.solid+"|"+ CUST.DATA.custacc+"|"+ CUST.DATA.ecsmebid+"|"+ CUST.DATA.ecstrancode+"|"+ CUST.DATA.settldate
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.DATA.pymntType+"|"+ CUST.DATA.ecsref+"|"+ CUST.DATA.treaRate+"|"+ CUST.DATA.treaRefNum+"|"+ CUST.DATA.tranccy+"|"+ CUST.DATA.chrgeventid
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS	+"|"+ CUST.DATA.chrgacc+"|"+ CUST.DATA.suspacc+"|"+ CUST.DATA.tranrmks+"|"+ CUST.DATA.citycode+"|"+ CUST.DATA.branchcode 
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.DATA.bankcode+"|"+ CUST.DATA.receiveracc+"|"+ CUST.DATA.receiveraccname+"|"+ CUST.DATA.chrgibanacc+"|"+ CUST.DATA.custaccIban+"|"+ CUST.DATA.custdestaccIban
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.DATA.custname+"|"+ CUST.DATA.addline1+"|"+ CUST.DATA.addline2+"|"+ CUST.DATA.addline3+"|"+ CUST.DATA.addline4  
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.DATA.freetxt1 +"|"+ CUST.DATA.freetxt2 +"|"+ CUST.DATA.freetxt3 +"|"+ CUST.DATA.freetxt4 +"|"+ CUST.DATA.freetxt5 +"|"+ CUST.DATA.freecode1 +"|"+ CUST.DATA.freecode2 +"|"+ CUST.DATA.freecode3 +"|"+ CUST.DATA.freecode4 +"|"+ CUST.DATA.freecode5
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ BANCS.STDIN.userId +"|"+ BANCS.STDIN.userId  +"|"+ CUST.DATA.tsCount +"|"+ BANCS.STDIN.contextBankId +"|"+ CUST.DATA.trearefcode


	PRINT(BANCS.INPARAM.BINDVARS)

	sv_a = "INSERT INTO  custom.ECS_TRAN  "

	sv_a = sv_a + "(remitamt,trantype, "
	sv_a = sv_a +"funcCode,Ecstranrefnum,paysysid , solid ,custacc,ecsmebid,ecstrancode ,settldate,"
	sv_a = sv_a + "pymntType,ecsref,treaRate,treaRefNum,tranccy,chrgeventid, "
	sv_a = sv_a + "chrgacc,suspacc,tranrmks,citycode,branchcode,"
	sv_a = sv_a + "bankcode,receiveracc,receiveraccname,chrgibanacc,custaccIban,custdestaccIban,"
	sv_a = sv_a + "custname,addline1,addline2 ,addline3,addline4,"
	sv_a = sv_a + "freetxt1,freetxt2,freetxt3,freetxt4,freetxt5,freecode1,freecode2,freecode3,freecode4,freecode5, "	
	sv_a = sv_a + "LCHG_USER_ID,LCHG_TIME,RCRE_USER_ID,RCRE_TIME,ENTITY_CRE_FLG,DEL_FLG,TS_CNT,BANK_ID,trearefcode)"

	sv_a = sv_a + " VALUES ( "
	sv_a = sv_a + "?SVAR,?SVAR, "
#	sv_a = sv_a + "?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR, "
	sv_a = sv_a + "?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,to_date(?SVAR,'DD-MM-YYYY'), "

	sv_a = sv_a + "?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR, "
	sv_a = sv_a + "?SVAR,?SVAR,?SVAR,?SVAR,?SVAR, "
	sv_a = sv_a + "?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR, "
	sv_a = sv_a + "?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,"
	sv_a = sv_a + "?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,"
	sv_a = sv_a + "?SVAR,sysdate,?SVAR,sysdate,'N','N',?SVAR,?SVAR,?SVAR) "
	PRINT(sv_a)

	
	sv_b = urhk_dbSQLWithBind(sv_a)
	PRINT(sv_b)
	IF (sv_b == 0) THEN
	#{
		sv_b = urhk_dbSQLWithBind("COMMIT")
		#}
	ELSE
		#{
		CUST.DATA.errMsg = "Backend Error."
		sv_e = urhk_SetOrbErr(CUST.DATA.errMsg)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	ENDOFSCRIPT:
		
		IF (CUST.DATA.errMsg == "") THEN
		#{
			CUST.DATA.sucessMsg = "Records Added successfully" + " " + CUST.DATA.Ecstranrefnum
		#}
		ENDIF
		EXITSCRIPT
		
END-->
