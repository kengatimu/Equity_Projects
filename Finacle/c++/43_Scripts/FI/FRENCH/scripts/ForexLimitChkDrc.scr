#-------------------------------------------------------------------------------------------------------------    
#    Name		: ForexLimitChkDrc.scr 
#    Description	: This script is used for the validation Forex Limits
#    Date		: 16-03-2013
#    Author		: Irungu James 
#    Input		: NA
#    Output		: NA
#    Called Script	: SRV_AddAndPostCashTran_pre_process_data.scr
#    Calling Script	: NA
#    Menu Option	: HTM/HPORDM/HDDMI
#    Srl. No		Date		Author			Description.   
#    ------		----------	-------			---------------			
#    1.0		16-03-2013	Irungu James		Original Version
#---------------------------------------------------------------------------------------------------------------
<--START
TRACE ON

IF (REPEXISTS("CUST") == 0) THEN
	CREATEREP("CUST")
ENDIF
IF (CLASSEXISTS("CUST","RATE") == 0) THEN
    CREATECLASS("CUST","RATE",5)
ENDIF


BANCS.INPUT.moduleName  = "RATETMFX"
BANCS.INPUT.parameterId = "FOREXLMT"
CALL("getcparamvalue.scr")
PRINT(BANCS.OUTPUT.parameterVal)
IF(BANCS.OUTPUT.parameterVal != "")THEN
	CUST.RATE.DailyForexLimit = BANCS.OUTPUT.parameterVal
ELSE
	CUST.RATE.errMsg = " Rate codesetup not done in CPARAM"
	GOTO ENDOFSCRIPT
ENDIF

CUST.RATE.treaRefNum = ""
CUST.RATE.partTrantype="D"
CUST.RATE.SBFLG ="S"

sv_a=urhk_B2k_PrintRepos("BANCS")
print(sv_a)

	IF  (CUST.RATE.OPTION=="FITRAN") THEN		
		
		sv_u = urhk_SRV_NumOfRecs("tranDtl.partTranDetailLL")		
		CUST.RATE.noOfRecords = CINT(BANCS.OUTPARAM.srvValue)
		PRINT(CUST.RATE.noOfRecords)		
		
		sv_l = 0
		sv_m = ""
		sv_n = 0
		sv_a = "\n"

		WHILE(sv_l < CUST.RATE.noOfRecords)
			sv_v = Format$(sv_l,"%d")
			sv_r = "<rec_"+sv_v+">"

			sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".key.serial_num")		
			CUST.RATE.serialnum = BANCS.OUTPARAM.srvValue
			PRINT(CUST.RATE.serialnum)	

			sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".rateCode.refCode")
			CUST.RATE.ratecode = BANCS.OUTPARAM.srvValue
			PRINT(CUST.RATE.ratecode)			
			
			sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".refCrncyCode.crncyCode")	
			CUST.RATE.fxblkfxcrncy = BANCS.OUTPARAM.srvValue
			PRINT(CUST.RATE.fxblkfxcrncy)	
		
			sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".acctId.foracid")		
			CUST.RATE.foracid = BANCS.OUTPARAM.srvValue
			PRINT(CUST.RATE.foracid)
			IF(CUST.RATE.foracid == "") THEN		
				sv_u = urhk_SRV_SetErr("Error: Account Number should not be NULL")
				BANCS.OUTPUT.successOrFailure="F"
				GOTO ENDOFSCRIPT		
			ENDIF			
			
			sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".refAmt")			
			CUST.RATE.refAmt = BANCS.OUTPARAM.srvValue
			PRINT(CUST.RATE.refAmt)	
			
			sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".partTranType.code")
			CUST.RATE.partTrantype = BANCS.OUTPARAM.srvValue
			PRINT(CUST.RATE.partTrantype)

			sv_u = urhk_SRV_GetVal("tranDtl.partTranDetailLL." +sv_r+ ".treaRefNum")
			CUST.RATE.treaRefNum = BANCS.OUTPARAM.srvValue
			PRINT(CUST.RATE.treaRefNum)

			IF  (CUST.RATE.treaRefNum !="") THEN
				EXITSCRIPT
			ENDIF
			

			sv_u = urhk_getAcctDetailsInRepository(CUST.RATE.foracid)
			PRINT(sv_u)
			IF (sv_u ==0) THEN
				CUST.RATE.acctownership = BANCS.OUTPARAM.acctOwnerShip
				print(CUST.RATE.acctownership)
				CUST.RATE.acctCrncyCode     = BANCS.OUTPARAM.acctCrncyCode
				PRINT(CUST.RATE.acctCrncyCode)			
			ENDIF
			

			IF  (  (BANCS.STDIN.contextBankId =="43" ) AND   ((CUST.RATE.acctCrncyCode =="CDF") or (CUST.RATE.acctCrncyCode =="USD")) and  (CUST.RATE.acctownership !="O") ) THEN
								
				IF (CUST.RATE.acctCrncyCode =="CDF")  THEN
					IF ((CUST.RATE.fxblkfxcrncy=="USD") OR  (CUST.RATE.fxblkfxcrncy=="CAD") OR  (CUST.RATE.fxblkfxcrncy=="GBP")OR  (CUST.RATE.fxblkfxcrncy=="CHF") OR  (CUST.RATE.fxblkfxcrncy=="JPY") OR  (CUST.RATE.fxblkfxcrncy=="EUR")) THEN
										
						CUST.RATE.DccId=""
						sv_a = urhk_GetChannelInfo("")
						print(sv_a)
						if (sv_a==0) then
							CUST.RATE.DccId = BANCS.OUTPARAM.DccId							
						endif	
						
						IF ((CUST.RATE.DccId == "RTD") OR (CUST.RATE.DccId == "ERP")) THEN
							goto ENDOFSCRIPT
						ENDIF

						IF  (CUST.RATE.acctCrncyCode != CUST.RATE.fxblkfxcrncy)  THEN
									
							
							sv_s = "SBFLG | select substr (RATECODE_TRAN,3,1)  from custom.c_ratecode where from_currency = ?SVAR AND to_currency=?SVAR AND bank_id =?SVAR"
							PRINT(sv_s)
							IF (CUST.RATE.partTrantype=="D") THEN
								BANCS.INPARAM.BINDVARS = CUST.RATE.acctCrncyCode + "|" + CUST.RATE.fxblkfxcrncy + "|" + BANCS.STDIN.contextBankId
							ELSE
								BANCS.INPARAM.BINDVARS =  CUST.RATE.fxblkfxcrncy + "|" + CUST.RATE.acctCrncyCode + "|" + BANCS.STDIN.contextBankId
							ENDIF
							PRINT(BANCS.INPARAM.BINDVARS)
							sv_d = urhk_dbSelectWithBind(sv_s)
							PRINT(sv_d)
							IF(sv_d ==0) THEN
								CUST.RATE.SBFLG = BANCS.OUTPARAM.SBFLG
								PRINT(CUST.RATE.SBFLG)	
							ENDIF				
							
							
							IF (CUST.RATE.SBFLG=="S") THEN			
													
								CUST.RATE.TranAmtX = LEFT$(CUST.RATE.refAmt,GETPOSITION(CUST.RATE.refAmt,"|") - 1)
								print( CUST.RATE.TranAmtX)

								sv_s = "CUST_VAR_CRNCY_UNITS | select nvl  (CUST_VAR_CRNCY_UNITS,0)  from tbaadm.rtl where RATECODE ='REVAL' "    
								sv_s = sv_s + "	and FXD_CRNCY_CODE ='USD' and  VAR_CRNCY_CODE ='CDF' and bank_id =?SVAR "
								PRINT(sv_s)
								BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId
								PRINT(BANCS.INPARAM.BINDVARS)
								sv_d = urhk_dbSelectWithBind(sv_s)
								PRINT(sv_d)
								IF (sv_d == 0) THEN
									CUST.RATE.CUST_VAR_CRNCY_UNITS = BANCS.OUTPARAM.CUST_VAR_CRNCY_UNITS
									PRINT(CUST.RATE.CUST_VAR_CRNCY_UNITS)		
								ENDIF

								IF (CUST.RATE.fxblkfxcrncy !="USD") THEN 
									sv_s = " VAR_UNITS, FXD_CRNCY, VAR_CRNCY |  select CUST_VAR_CRNCY_UNITS , FXD_CRNCY_CODE,VAR_CRNCY_CODE  "  
									sv_s = sv_s + " from tbaadm.rtl where RATECODE =?SVAR   and   (FXD_CRNCY_CODE =?SVAR  or VAR_CRNCY_CODE =?SVAR ) "
									sv_s = sv_s + " and  (FXD_CRNCY_CODE =?SVAR  or VAR_CRNCY_CODE =?SVAR) and bank_id =?SVAR "
									PRINT(sv_s)
									BANCS.INPARAM.BINDVARS = CUST.RATE.ratecode  + "|" + CUST.RATE.fxblkfxcrncy    + "|" +  CUST.RATE.fxblkfxcrncy   + "|" +  CUST.RATE.acctCrncyCode + "|" +  CUST.RATE.acctCrncyCode  + "|" + BANCS.STDIN.contextBankId 
									PRINT(BANCS.INPARAM.BINDVARS)
									sv_d = urhk_dbSelectWithBind(sv_s)
									PRINT(sv_d)
									IF (sv_d == 0) THEN
										CUST.RATE.VAR_UNITS = BANCS.OUTPARAM.VAR_UNITS
										PRINT(CUST.RATE.VAR_UNITS)
										CUST.RATE.FXD_CRNCY = BANCS.OUTPARAM.FXD_CRNCY
										PRINT(CUST.RATE.FXD_CRNCY)	
										CUST.RATE.VAR_CRNCY = BANCS.OUTPARAM.VAR_CRNCY
										PRINT(CUST.RATE.VAR_CRNCY)
										
										IF ( CUST.RATE.fxblkfxcrncy == CUST.RATE.FXD_CRNCY ) THEN
											#CDF is weak  Multiply
											CUST.RATE.TranAmtX = CDOUBLE(CUST.RATE.TranAmtX) * CDOUBLE(CUST.RATE.VAR_UNITS)
											print(CUST.RATE.TranAmtX)

											CUST.RATE.TranAmtX = CDOUBLE(CUST.RATE.TranAmtX)/  cdouble(CUST.RATE.CUST_VAR_CRNCY_UNITS)
											PRINT(CUST.RATE.TranAmtX)

										ELSE
											CUST.RATE.TranAmtX = CDOUBLE(CUST.RATE.TranAmtX) / CDOUBLE(CUST.RATE.VAR_UNITS)
											print(CUST.RATE.TranAmtX)
											#CDF is strong  Divide					
											CUST.RATE.TranAmtX = CDOUBLE(CUST.RATE.TranAmtX)/ cdouble(CUST.RATE.CUST_VAR_CRNCY_UNITS)
											PRINT(CUST.RATE.TranAmtX)
										ENDIF
									ENDIF
								ENDIF
											
								sv_s = "SumForex | select nvl(sum (TRAN_AMT),0)   from tbaadm.gam , tbaadm.dtd where gam.acid = dtd.acid  and  gam.bank_id =dtd.bank_id " 
								sv_s = sv_s + " and gam.foracid =?SVAR  and gam.bank_id =?SVAR  and TRAN_CRNCY_CODE !=REF_CRNCY_CODE and dtd.del_flg ='N' "
								PRINT(sv_s)
								BANCS.INPARAM.BINDVARS = CUST.RATE.foracid + "|" + BANCS.STDIN.contextBankId
								PRINT(BANCS.INPARAM.BINDVARS)
								sv_d = urhk_dbSelectWithBind(sv_s)
								PRINT(sv_d)
								IF (sv_d == 0) THEN
									CUST.RATE.SumForex = BANCS.OUTPARAM.SumForex
									PRINT(CUST.RATE.SumForex)				
									IF (CDOUBLE (CUST.RATE.SumForex) > "0") THEN
										CUST.RATE.SumForex = CDOUBLE(CUST.RATE.SumForex)/  cdouble(CUST.RATE.CUST_VAR_CRNCY_UNITS)
										PRINT(CUST.RATE.SumForex)
									ENDIF
								ENDIF

										
								CUST.RATE.SumForex = cdouble(CUST.RATE.SumForex) + cdouble(CUST.RATE.TranAmtX)
								PRINT(CUST.RATE.SumForex)

								IF (CDOUBLE (CUST.RATE.SumForex) >= CDOUBLE (CUST.RATE.DailyForexLimit)) THEN
									#sv_m = sv_m  + CUST.RATE.serialnum + ","+ "Forex Limit exceeded, contact Treasury" + sv_a
									sv_u = urhk_SRV_SetErr("Daily Forex Limit has been exceeded, please contact Treasury" )	
									GOTO NEXTREC
								ENDIF
								
							ENDIF
						ENDIF
					ENDIF					
				ELSE

					IF (CUST.RATE.fxblkfxcrncy=="CDF") THEN
										
						CUST.RATE.DccId=""
						sv_a = urhk_GetChannelInfo("")
						print(sv_a)
						if (sv_a==0) then
							CUST.RATE.DccId = BANCS.OUTPARAM.DccId							
						endif	
						
						IF ((CUST.RATE.DccId == "RTD") OR (CUST.RATE.DccId == "ERP")) THEN
							goto ENDOFSCRIPT
						ENDIF

						IF  (CUST.RATE.acctCrncyCode != CUST.RATE.fxblkfxcrncy)  THEN
									
							
							sv_s = "SBFLG | select substr (RATECODE_TRAN,3,1)  from custom.c_ratecode where from_currency = ?SVAR AND to_currency=?SVAR AND bank_id =?SVAR"
							PRINT(sv_s)
							IF (CUST.RATE.partTrantype=="D") THEN
								BANCS.INPARAM.BINDVARS = CUST.RATE.acctCrncyCode + "|" + CUST.RATE.fxblkfxcrncy + "|" + BANCS.STDIN.contextBankId
							ELSE
								BANCS.INPARAM.BINDVARS =  CUST.RATE.fxblkfxcrncy + "|" + CUST.RATE.acctCrncyCode + "|" + BANCS.STDIN.contextBankId
							ENDIF


							PRINT(BANCS.INPARAM.BINDVARS)
							sv_d = urhk_dbSelectWithBind(sv_s)
							PRINT(sv_d)
							IF(sv_d ==0) THEN
								CUST.RATE.SBFLG = BANCS.OUTPARAM.SBFLG
								PRINT(CUST.RATE.SBFLG)	
							ENDIF				
							
							
							IF (CUST.RATE.SBFLG=="S") THEN			
													
								CUST.RATE.TranAmtX = LEFT$(CUST.RATE.refAmt,GETPOSITION(CUST.RATE.refAmt,"|") - 1)
								print( CUST.RATE.TranAmtX)

								sv_s = "CUST_VAR_CRNCY_UNITS | select nvl  (CUST_VAR_CRNCY_UNITS,0)  from tbaadm.rtl where RATECODE ='REVAL' "    
								sv_s = sv_s + "	and FXD_CRNCY_CODE ='USD' and  VAR_CRNCY_CODE ='CDF' and bank_id =?SVAR "
								PRINT(sv_s)
								BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId
								PRINT(BANCS.INPARAM.BINDVARS)
								sv_d = urhk_dbSelectWithBind(sv_s)
								PRINT(sv_d)
								IF (sv_d == 0) THEN
									CUST.RATE.CUST_VAR_CRNCY_UNITS = BANCS.OUTPARAM.CUST_VAR_CRNCY_UNITS
									PRINT(CUST.RATE.CUST_VAR_CRNCY_UNITS)		
								ENDIF

								CUST.RATE.TranAmtX = CDOUBLE(CUST.RATE.TranAmtX)/ cdouble(CUST.RATE.CUST_VAR_CRNCY_UNITS)
								PRINT(CUST.RATE.TranAmtX)
									
											
								sv_s = "SumForex | select nvl(sum (TRAN_AMT),0)   from tbaadm.gam , tbaadm.dtd where gam.acid = dtd.acid  and  gam.bank_id =dtd.bank_id " 
								sv_s = sv_s + " and gam.foracid =?SVAR  and gam.bank_id =?SVAR  and REF_CRNCY_CODE = ?SVAR and dtd.del_flg ='N' "
								PRINT(sv_s)
								BANCS.INPARAM.BINDVARS = CUST.RATE.foracid + "|" + BANCS.STDIN.contextBankId + "|" + CUST.RATE.fxblkfxcrncy
								PRINT(BANCS.INPARAM.BINDVARS)
								sv_d = urhk_dbSelectWithBind(sv_s)
								PRINT(sv_d)
								IF (sv_d == 0) THEN
									CUST.RATE.SumForex = BANCS.OUTPARAM.SumForex
									PRINT(CUST.RATE.SumForex)				
									IF (CDOUBLE (CUST.RATE.SumForex) > "0") THEN
										CUST.RATE.SumForex = CDOUBLE(CUST.RATE.SumForex)
										PRINT(CUST.RATE.SumForex)
									ENDIF
								ENDIF

										
								CUST.RATE.SumForex = cdouble(CUST.RATE.SumForex) + cdouble(CUST.RATE.TranAmtX)
								PRINT(CUST.RATE.SumForex)

								IF (CDOUBLE (CUST.RATE.SumForex) >= CDOUBLE (CUST.RATE.DailyForexLimit)) THEN
									#sv_m = sv_m  + CUST.RATE.serialnum + ","+ "Forex Limit exceeded, contact Treasury" + sv_a
									sv_u = urhk_SRV_SetErr("Daily Forex Limit has been exceeded, please contact Treasury" )	
									GOTO NEXTREC
								ENDIF								
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ENDIF


			NEXTREC:
			PRINT(sv_m)	
			sv_l = sv_l + 1
			PRINT (sv_l)

		DO
		PRINT(sv_m)
		IF (sv_m != "") THEN 

			BANCS.OUTPUT.successOrFailure = "F"
		ENDIF

		IF (CUST.RATE.errMsg != "") THEN
			 sv_u = urhk_SRV_SetErr(CUST.RATE.errMsg)
			 GOTO NEXTREC
		  
		ENDIF
	ENDIF


	IF  ((CUST.RATE.OPTION=="PORDTRAN") OR (CUST.RATE.OPTION=="HDDMITRAN"))  THEN
			
		IF (CUST.RATE.OPTION=="PORDTRAN") THEN
			#PYMT_ORDER_MAINT.doc

			sv_u = urhk_SRV_GetVal("pordHeaderDtls.drAcct.foracid")
			CUST.RATE.foracid = BANCS.OUTPARAM.srvValue
			PRINT(CUST.RATE.foracid)
			IF(CUST.RATE.foracid == "") THEN		
				sv_u = urhk_SRV_SetErr("Error: Account Number should not be NULL")
				BANCS.OUTPUT.successOrFailure="F"
				GOTO ENDOFSCRIPT		
			ENDIF
			
			sv_u = urhk_SRV_GetVal("pordPaymentDtls.remitAmt")			
			CUST.RATE.refAmt = BANCS.OUTPARAM.srvValue
			PRINT(CUST.RATE.refAmt)		

			sv_u = urhk_SRV_GetVal("pordPaymentDtls.remitCrncy")
			CUST.RATE.fxblkfxcrncy = BANCS.OUTPARAM.srvValue
			PRINT(CUST.RATE.fxblkfxcrncy)	

			sv_u = urhk_SRV_GetVal("pordHeaderDtls.exchRateCode.refCode")
			CUST.RATE.ratecode = BANCS.OUTPARAM.srvValue
			PRINT(CUST.RATE.ratecode)
			
			sv_u = urhk_SRV_GetVal("pordHeaderDtls.tresExchRefNo")
			CUST.RATE.treaRefNum = BANCS.OUTPARAM.srvValue
			PRINT(CUST.RATE.treaRefNum)		

		ENDIF

		IF  (CUST.RATE.OPTION=="HDDMITRAN") THEN
			sv_u = urhk_SRV_NumOfRecs("ddMassIssLL")
			CUST.RATE.noOfRecords = CINT(BANCS.OUTPARAM.srvValue)
			PRINT(CUST.RATE.noOfRecords)			
			##DD_MASS_PMT.doc

			sv_u = urhk_SRV_GetVal("ddMassIssHdr.purAcct.foracid")
			CUST.RATE.foracid = BANCS.OUTPARAM.srvValue
			PRINT(CUST.RATE.foracid)
			IF(CUST.RATE.foracid == "") THEN		
				sv_u = urhk_SRV_SetErr("Error: Account Number should not be NULL")
				BANCS.OUTPUT.successOrFailure="F"
				GOTO ENDOFSCRIPT		
			ENDIF		

			sv_u = urhk_SRV_GetVal("ddMassIssMiscDtl.totDDAmt")			
			CUST.RATE.refAmt = BANCS.OUTPARAM.srvValue
			PRINT(CUST.RATE.refAmt)

			sv_u = urhk_SRV_GetVal("ddMassIssHdr.purRateCode.refCode")
			CUST.RATE.ratecode = BANCS.OUTPARAM.srvValue
			Print (CUST.RATE.ratecode)

			sv_u = urhk_SRV_GetVal("ddMassIssHdr.ddAcct.crncyCode")
			CUST.RATE.fxblkfxcrncy = BANCS.OUTPARAM.srvValue
			PRINT(CUST.RATE.fxblkfxcrncy)							
			
			sv_u = urhk_SRV_GetVal("ddMassIssHdr.purTreaRefNum")
			CUST.RATE.treaRefNum = BANCS.OUTPARAM.srvValue
			PRINT(CUST.RATE.treaRefNum)	
		ENDIF

		IF  (CUST.RATE.treaRefNum !="") THEN
			EXITSCRIPT
		ENDIF
					
		sv_u = urhk_getAcctDetailsInRepository(CUST.RATE.foracid)
		PRINT(sv_u)
		IF (sv_u ==0) THEN
			CUST.RATE.acctownership = BANCS.OUTPARAM.acctOwnerShip
			print(CUST.RATE.acctownership)
			CUST.RATE.acctCrncyCode     = BANCS.OUTPARAM.acctCrncyCode
			PRINT(CUST.RATE.acctCrncyCode)						
		ENDIF



		IF  ((BANCS.STDIN.contextBankId =="43" ) AND   ((CUST.RATE.acctCrncyCode =="CDF") or (CUST.RATE.acctCrncyCode =="USD")) and  (CUST.RATE.acctownership !="O") ) THEN
							
			IF (CUST.RATE.acctCrncyCode =="CDF")  THEN
				IF ((CUST.RATE.fxblkfxcrncy=="USD") OR  (CUST.RATE.fxblkfxcrncy=="CAD") OR  (CUST.RATE.fxblkfxcrncy=="GBP")OR  (CUST.RATE.fxblkfxcrncy=="CHF") OR  (CUST.RATE.fxblkfxcrncy=="JPY") OR  (CUST.RATE.fxblkfxcrncy=="EUR")) THEN
									
					CUST.RATE.DccId=""
					sv_a = urhk_GetChannelInfo("")
					print(sv_a)
					if (sv_a==0) then
						CUST.RATE.DccId = BANCS.OUTPARAM.DccId							
					endif	
					
					IF ((CUST.RATE.DccId == "RTD") OR (CUST.RATE.DccId == "ERP")) THEN
						goto ENDOFSCRIPT
					ENDIF

					IF  (CUST.RATE.acctCrncyCode != CUST.RATE.fxblkfxcrncy)  THEN
								
						
						sv_s = "SBFLG | select substr (RATECODE_TRAN,3,1)  from custom.c_ratecode where from_currency = ?SVAR AND to_currency=?SVAR AND bank_id =?SVAR"
						PRINT(sv_s)
						IF (CUST.RATE.partTrantype=="D") THEN
							BANCS.INPARAM.BINDVARS = CUST.RATE.acctCrncyCode + "|" + CUST.RATE.fxblkfxcrncy + "|" + BANCS.STDIN.contextBankId
						ELSE
							BANCS.INPARAM.BINDVARS =  CUST.RATE.fxblkfxcrncy + "|" + CUST.RATE.acctCrncyCode + "|" + BANCS.STDIN.contextBankId
						ENDIF
						PRINT(BANCS.INPARAM.BINDVARS)
						sv_d = urhk_dbSelectWithBind(sv_s)
						PRINT(sv_d)
						IF(sv_d ==0) THEN
							CUST.RATE.SBFLG = BANCS.OUTPARAM.SBFLG
							PRINT(CUST.RATE.SBFLG)	
						ENDIF				
						
						
						IF (CUST.RATE.SBFLG=="S") THEN			
												
							CUST.RATE.TranAmtX = LEFT$(CUST.RATE.refAmt,GETPOSITION(CUST.RATE.refAmt,"|") - 1)
							print( CUST.RATE.TranAmtX)

							sv_s = "CUST_VAR_CRNCY_UNITS | select nvl  (CUST_VAR_CRNCY_UNITS,0)  from tbaadm.rtl where RATECODE ='REVAL' "    
							sv_s = sv_s + "	and FXD_CRNCY_CODE ='USD' and  VAR_CRNCY_CODE ='CDF' and bank_id =?SVAR "
							PRINT(sv_s)
							BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId
							PRINT(BANCS.INPARAM.BINDVARS)
							sv_d = urhk_dbSelectWithBind(sv_s)
							PRINT(sv_d)
							IF (sv_d == 0) THEN
								CUST.RATE.CUST_VAR_CRNCY_UNITS = BANCS.OUTPARAM.CUST_VAR_CRNCY_UNITS
								PRINT(CUST.RATE.CUST_VAR_CRNCY_UNITS)		
							ENDIF

							IF (CUST.RATE.fxblkfxcrncy !="USD") THEN 
								sv_s = " VAR_UNITS, FXD_CRNCY, VAR_CRNCY |  select CUST_VAR_CRNCY_UNITS , FXD_CRNCY_CODE,VAR_CRNCY_CODE  "  
								sv_s = sv_s + " from tbaadm.rtl where RATECODE =?SVAR   and   (FXD_CRNCY_CODE =?SVAR  or VAR_CRNCY_CODE =?SVAR ) "
								sv_s = sv_s + " and  (FXD_CRNCY_CODE =?SVAR  or VAR_CRNCY_CODE =?SVAR) and bank_id =?SVAR "
								PRINT(sv_s)
								BANCS.INPARAM.BINDVARS = CUST.RATE.ratecode  + "|" + CUST.RATE.fxblkfxcrncy    + "|" +  CUST.RATE.fxblkfxcrncy   + "|" +  CUST.RATE.acctCrncyCode + "|" +  CUST.RATE.acctCrncyCode  + "|" + BANCS.STDIN.contextBankId 
								PRINT(BANCS.INPARAM.BINDVARS)
								sv_d = urhk_dbSelectWithBind(sv_s)
								PRINT(sv_d)
								IF (sv_d == 0) THEN
									CUST.RATE.VAR_UNITS = BANCS.OUTPARAM.VAR_UNITS
									PRINT(CUST.RATE.VAR_UNITS)
									CUST.RATE.FXD_CRNCY = BANCS.OUTPARAM.FXD_CRNCY
									PRINT(CUST.RATE.FXD_CRNCY)	
									CUST.RATE.VAR_CRNCY = BANCS.OUTPARAM.VAR_CRNCY
									PRINT(CUST.RATE.VAR_CRNCY)
									
									IF ( CUST.RATE.fxblkfxcrncy == CUST.RATE.FXD_CRNCY ) THEN
										#CDF is weak  Multiply
										CUST.RATE.TranAmtX = CDOUBLE(CUST.RATE.TranAmtX) * CDOUBLE(CUST.RATE.VAR_UNITS)
										print(CUST.RATE.TranAmtX)

										CUST.RATE.TranAmtX = CDOUBLE(CUST.RATE.TranAmtX)/  cdouble(CUST.RATE.CUST_VAR_CRNCY_UNITS)
										PRINT(CUST.RATE.TranAmtX)

									ELSE
										CUST.RATE.TranAmtX = CDOUBLE(CUST.RATE.TranAmtX) / CDOUBLE(CUST.RATE.VAR_UNITS)
										print(CUST.RATE.TranAmtX)
										#CDF is strong  Divide					
										CUST.RATE.TranAmtX = CDOUBLE(CUST.RATE.TranAmtX)/ cdouble(CUST.RATE.CUST_VAR_CRNCY_UNITS)
										PRINT(CUST.RATE.TranAmtX)
									ENDIF
								ENDIF
							ENDIF
										
							sv_s = "SumForex | select nvl(sum (TRAN_AMT),0)   from tbaadm.gam , tbaadm.dtd where gam.acid = dtd.acid  and  gam.bank_id =dtd.bank_id " 
							sv_s = sv_s + " and gam.foracid =?SVAR  and gam.bank_id =?SVAR  and TRAN_CRNCY_CODE !=REF_CRNCY_CODE and dtd.del_flg ='N' "
							PRINT(sv_s)
							BANCS.INPARAM.BINDVARS = CUST.RATE.foracid + "|" + BANCS.STDIN.contextBankId
							PRINT(BANCS.INPARAM.BINDVARS)
							sv_d = urhk_dbSelectWithBind(sv_s)
							PRINT(sv_d)
							IF (sv_d == 0) THEN
								CUST.RATE.SumForex = BANCS.OUTPARAM.SumForex
								PRINT(CUST.RATE.SumForex)				
								IF (CDOUBLE (CUST.RATE.SumForex) > "0") THEN
									CUST.RATE.SumForex = CDOUBLE(CUST.RATE.SumForex)/  cdouble(CUST.RATE.CUST_VAR_CRNCY_UNITS)
									PRINT(CUST.RATE.SumForex)
								ENDIF
							ENDIF

									
							CUST.RATE.SumForex = cdouble(CUST.RATE.SumForex) + cdouble(CUST.RATE.TranAmtX)
							PRINT(CUST.RATE.SumForex)

							IF (CDOUBLE (CUST.RATE.SumForex) >= CDOUBLE (CUST.RATE.DailyForexLimit)) THEN
								#sv_m = sv_m  + CUST.RATE.serialnum + ","+ "Forex Limit exceeded, contact Treasury" + sv_a
								sv_u = urhk_SRV_SetErr("Daily Forex Limit has been exceeded, please contact Treasury" )	
								GOTO NEXTREC
							ENDIF
							
						ENDIF
					ENDIF
				ENDIF					
			ELSE

				IF (CUST.RATE.fxblkfxcrncy=="CDF") THEN
									
					CUST.RATE.DccId=""
					sv_a = urhk_GetChannelInfo("")
					print(sv_a)
					if (sv_a==0) then
						CUST.RATE.DccId = BANCS.OUTPARAM.DccId							
					endif	
					
					IF ((CUST.RATE.DccId == "RTD") OR (CUST.RATE.DccId == "ERP")) THEN
						goto ENDOFSCRIPT
					ENDIF

					IF  (CUST.RATE.acctCrncyCode != CUST.RATE.fxblkfxcrncy)  THEN
								
						
						sv_s = "SBFLG | select substr (RATECODE_TRAN,3,1)  from custom.c_ratecode where from_currency = ?SVAR AND to_currency=?SVAR AND bank_id =?SVAR"
						PRINT(sv_s)
						IF (CUST.RATE.partTrantype=="D") THEN
							BANCS.INPARAM.BINDVARS = CUST.RATE.acctCrncyCode + "|" + CUST.RATE.fxblkfxcrncy + "|" + BANCS.STDIN.contextBankId
						ELSE
							BANCS.INPARAM.BINDVARS =  CUST.RATE.fxblkfxcrncy + "|" + CUST.RATE.acctCrncyCode + "|" + BANCS.STDIN.contextBankId
						ENDIF


						PRINT(BANCS.INPARAM.BINDVARS)
						sv_d = urhk_dbSelectWithBind(sv_s)
						PRINT(sv_d)
						IF(sv_d ==0) THEN
							CUST.RATE.SBFLG = BANCS.OUTPARAM.SBFLG
							PRINT(CUST.RATE.SBFLG)	
						ENDIF				
						
						
						IF (CUST.RATE.SBFLG=="S") THEN			
												
							CUST.RATE.TranAmtX = LEFT$(CUST.RATE.refAmt,GETPOSITION(CUST.RATE.refAmt,"|") - 1)
							print( CUST.RATE.TranAmtX)

							sv_s = "CUST_VAR_CRNCY_UNITS | select nvl  (CUST_VAR_CRNCY_UNITS,0)  from tbaadm.rtl where RATECODE ='REVAL' "    
							sv_s = sv_s + "	and FXD_CRNCY_CODE ='USD' and  VAR_CRNCY_CODE ='CDF' and bank_id =?SVAR "
							PRINT(sv_s)
							BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId
							PRINT(BANCS.INPARAM.BINDVARS)
							sv_d = urhk_dbSelectWithBind(sv_s)
							PRINT(sv_d)
							IF (sv_d == 0) THEN
								CUST.RATE.CUST_VAR_CRNCY_UNITS = BANCS.OUTPARAM.CUST_VAR_CRNCY_UNITS
								PRINT(CUST.RATE.CUST_VAR_CRNCY_UNITS)		
							ENDIF

							CUST.RATE.TranAmtX = CDOUBLE(CUST.RATE.TranAmtX)/ cdouble(CUST.RATE.CUST_VAR_CRNCY_UNITS)
							PRINT(CUST.RATE.TranAmtX)
								
										
							sv_s = "SumForex | select nvl(sum (TRAN_AMT),0)   from tbaadm.gam , tbaadm.dtd where gam.acid = dtd.acid  and  gam.bank_id =dtd.bank_id " 
							sv_s = sv_s + " and gam.foracid =?SVAR  and gam.bank_id =?SVAR  and REF_CRNCY_CODE = ?SVAR and dtd.del_flg ='N' "
							PRINT(sv_s)
							BANCS.INPARAM.BINDVARS = CUST.RATE.foracid + "|" + BANCS.STDIN.contextBankId + "|" + CUST.RATE.fxblkfxcrncy
							PRINT(BANCS.INPARAM.BINDVARS)
							sv_d = urhk_dbSelectWithBind(sv_s)
							PRINT(sv_d)
							IF (sv_d == 0) THEN
								CUST.RATE.SumForex = BANCS.OUTPARAM.SumForex
								PRINT(CUST.RATE.SumForex)				
								IF (CDOUBLE (CUST.RATE.SumForex) > "0") THEN
									CUST.RATE.SumForex = CDOUBLE(CUST.RATE.SumForex)
									PRINT(CUST.RATE.SumForex)
								ENDIF
							ENDIF

									
							CUST.RATE.SumForex = cdouble(CUST.RATE.SumForex) + cdouble(CUST.RATE.TranAmtX)
							PRINT(CUST.RATE.SumForex)

							IF (CDOUBLE (CUST.RATE.SumForex) >= CDOUBLE (CUST.RATE.DailyForexLimit)) THEN
								#sv_m = sv_m  + CUST.RATE.serialnum + ","+ "Forex Limit exceeded, contact Treasury" + sv_a
								sv_u = urhk_SRV_SetErr("Daily Forex Limit has been exceeded, please contact Treasury" )	
								GOTO NEXTREC
							ENDIF								
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	#}
	ENDIF




ENDOFSCRIPT:

#TRACE OFF
EXITSCRIPT
END-->



