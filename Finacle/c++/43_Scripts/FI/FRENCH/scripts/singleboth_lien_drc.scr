				BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId  + "|"+ CUST.SBACT.foracid
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d =  urhk_dbSelectWithBind(sv_s)
				PRINT(sv_d)
				IF (sv_d == 0) THEN
				#{
					CUST.SBACT.lienid=BANCS.OUTPARAM.lienid
					PRINT(CUST.SBACT.lienid)
					BANCS.OUTPUT.RespCode = "00"
					BANCS.OUTPUT.successOrFailure = "S"
					BANCS.OUTPUT.ReservedField3="TVA Card fee and lien placed Lein_id" +":"+ CUST.SBACT.lienid
				#}
				ENDIF
			#}
			ENDIF
			
			
			#----------------------------------------------------------------------------------------------------
			# SRV Error check
			#----------------------------------------------------------------------------------------------------
			IF (sv_u != 0) THEN
			#{
				CUST.SBACT.errMsg="Error Creating Lien"
				#{
				IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
				#{
					PRINT(BANCS.OUTPARAM.Error_num)
					sv_v = BANCS.OUTPARAM.Error_num
					#}
				ELSE
					#{
					sv_v = 0
				#}
				ENDIF
				IF (sv_v > 0) THEN
				#{
					sv_u = SYSTEM("echo 'Error for Acct:"+CUST.SBACT.foracid+" ' >>lienedacct.log")
					sv_i = 1
					WHILE (sv_i <= sv_v)
					#{
						sv_f = FORMAT$(sv_i,"%d")
						sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
						sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
						sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
						PRINT(sv_e)
						sv_i = sv_i + 1
						sv_u = SYSTEM("echo '"+sv_e+"' >>lienedacct.log")
						PRINT(sv_u)
						BANCS.OUTPUT.RespCode = "99"
						BANCS.OUTPUT.successOrFailure = "F"
						BANCS.OUTPUT.ReservedField3="Card fee not corrected and lien placing failed "
						CUST.SBACT.errMsg = "Lien Not created"
						GOTO ENDOFSCRIPT
					#}
					DO
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	ENDIF
	################
ENDOFSCRIPT:
	IF(FIELDEXISTS(BANCS.OUTPUT.ReservedField3) == 1) THEN
		print(BANCS.OUTPUT.ReservedField3)
		IF (BANCS.OUTPUT.ReservedField3!="") THEN
			CUST.SBACT.ReservedField3=BANCS.OUTPUT.ReservedField3
			print(CUST.SBACT.ReservedField3)
		ENDIF
	ENDIF

EXITSCRIPT
END-->
