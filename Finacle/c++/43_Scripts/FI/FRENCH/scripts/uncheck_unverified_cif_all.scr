########################################################################################################
#Name               :Userid.scr
#Date               :01-12-2010
#Author             :Suhasini Murthi
#Description        :This script is used to fetch values from UPR table
#Called script      :None
#Calling Script     :None
#Input              :User ID
#Output             : userWorkClass,solId,userSolTenor,remoteAccessFlg,userApplName
########################################################################################################
<--START
CHECKSUM="790bb79cb967328f7e20e8e5dd41c77cabedca98993709878d59cccd9037c449"
	TRACE ON
	
	####################################################################
	#section      :creating new repository if required
	#Description  :Checks for the existence of the repository STDWFS and
	#               creates a new one by that name if it does not exist
	#####################################################################
	
	IF (REPEXISTS("CUST") == 0 ) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	############################################################################
	#section      :creating new class if required
	#Desscription :checks for the existence of the class GLBDATA in the
	#repository
	#               create a new one if it does not exist
	##############################################################################
	
	
	IF (CLASSEXISTS("CUST","DATA") == 0) THEN
	#{
		CREATECLASS("CUST","DATA",5)
	#}
	ENDIF
	
	############################################
	#Assigns the values to the variables
	############################################
	
	sv_a = urhk_b2k_PrintRepos("BANCS")
	print(sv_a)
	sv_y=0
	
	IF( (FIELDEXISTS(("BANCS").("INPUT").("Bankid"))== 0) ) THEN
	#{
		CUST.DATA.errMsg="Kindly Supply Bank id"
		sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
		GOTO End
		#}
	ELSE
		#{
		CUST.DATA.Bankid=BANCS.INPUT.Bankid
		print(CUST.DATA.Bankid)
	#}
	ENDIF
	
	IF( (FIELDEXISTS(("BANCS").("INPUT").("Cifid"))== 0) ) THEN
	#{
		CUST.DATA.errMsg="Kindly Supply Valid Cifid "
		sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
		GOTO End
		#}
	ELSE
		#{
		CUST.DATA.Cifid=BANCS.INPUT.Cifid
		print(CUST.DATA.Cifid)
	#}
	ENDIF
	
	############################################
	# Fetching the value from table
	############################################
	
	sv_q = "cifidcount| "
	sv_q = sv_q + " select count(1) from CRMUSER.ACCOUNTS where ENTITY_CRE_FLAG ='Y' and RECORDSTATUS ='A'  and bank_id=?SVAR and  ORGKEY=?SVAR "
	print(sv_q)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.DATA.Cifid
	
	sv_p= urhk_dbSelectWithBind(sv_q)
	print(sv_p)
	IF (sv_p==0) THEN
	#{
		CUST.DATA.cifidcount = BANCS.OUTPARAM.cifidcount
		print(CUST.DATA.cifidcount)
		IF (CUST.DATA.cifidcount=="1") THEN
			CUST.DATA.varValue1="Cif Id Is Verified"
			sv_z = urhk_SetOrbOut("CIFID_STATUS|"+CUST.DATA.varValue1)
			print(sv_z)
			sv_e=urhk_SetOrbOut("StattusCode|1")
			GOTO End
		ELSE
			CUST.DATA.varValue1="Cif Id Not Is Verified  (Accts Table) "
			sv_z = urhk_SetOrbOut("CIFID_STATUS|"+CUST.DATA.varValue1)
			print(sv_z)
			sv_e=urhk_SetOrbOut("StattusCode|2")
			GOTO End
		ENDIF
		#}
	ELSE
		#{
		CUST.DATA.errMsg="Data Error ...Note date format DD-MON-YYYY"
		sv_e=urhk_SetOrbOut("StattusCode|2")
		sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
		GOTO End
	#}
	ENDIF

	sv_q = "cifidcountmod| "
	sv_q = sv_q + " select count(1) from CRMUSER.ACCOUNTS_MOD where bank_id=?SVAR and ORGKEY=?SVAR "
	print(sv_q)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.DATA.Cifid
	
	sv_p= urhk_dbSelectWithBind(sv_q)
	print(sv_p)
	
	IF (sv_p==0) THEN
	#{
		CUST.DATA.cifidcountmod = BANCS.OUTPARAM.cifidcountmod
		print(CUST.DATA.cifidcountmod)
		IF (CUST.DATA.cifidcountmod=="0") THEN
			CUST.DATA.varValue1="Cif Id Is Verified"
			sv_z = urhk_SetOrbOut("CIFID_STATUS|"+CUST.DATA.varValue1)
			print(sv_z)
			sv_e=urhk_SetOrbOut("StattusCode|1")
			GOTO End
		ELSE
			CUST.DATA.varValue1="Cif Id Not Is Verified (Mod Table) "
			sv_z = urhk_SetOrbOut("CIFID_STATUS|"+CUST.DATA.varValue1)
			print(sv_z)
			sv_e=urhk_SetOrbOut("StattusCode|2")
			GOTO End
		ENDIF
		#}
	ELSE
		#{
		CUST.DATA.errMsg="Data Error ...Note date format DD-MON-YYYY"
		sv_e=urhk_SetOrbOut("StattusCode|2")
		sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
	#}
	ENDIF
	
	End:
		EXITSCRIPT
		TRACE OFF
END-->
