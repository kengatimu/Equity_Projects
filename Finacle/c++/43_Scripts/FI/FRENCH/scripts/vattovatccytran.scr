        ENDIF


        CUST.VATMV.BODDate=MID$(BANCS.STDIN.BODDate,0,10)

        CUST.VATMV.failureFile = "failfile_FccyVATtoHccyVAT_" + BANCS.STDIN.mySolId + ".lst"
        CUST.VATMV.failFileIndex1 = ""
        CUST.VATMV.failFileIndex1 = urtn_fileOpen(CUST.VATMV.failureFile + "|w")

        CUST.VATMV.successFile = "successFile_FccyVATtoHccyVAT_" + BANCS.STDIN.mySolId + ".lst"
        CUST.VATMV.successFileIndex1 = ""
        CUST.VATMV.successFileIndex1 = urtn_fileOpen(CUST.VATMV.successFile + "|w")

        PRINT(CUST.VATMV.failFileIndex1)
        PRINT(CUST.VATMV.successFileIndex1)

        CUST.VATMV.list_file_name = CUST.VATMV.failureFile
        CUST.VATMV.title = "FccyPL to HccyPL Failure Report"
        CUST.VATMV.mrt_file_name = "FccyVATtoHccyVAT.mrt"
