	CUST.VATMV.vatfailRmks = ""
	CUST.VATMV.FvatCrncy = ""
	CUST.VATMV.vatTranrmks = ""

        sv_s = "timeStamp|select to_char(sysdate,'ddmmyyyyhhmiss') from dual"
