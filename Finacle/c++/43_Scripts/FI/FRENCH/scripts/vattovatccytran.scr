                sv_b = urtn_fileWrite(CUST.VATMV.failFileIndex1 + "|" + CUST.VATMV.ErrMsg)
                GOTO ENDOFSCRIPT
        #}
        ENDIF

	sv_s = "Fccyvatacnt,FvatCrncy|select foracid,acct_crncy_code from tbaadm.gam where bank_id=?SVAR and del_flg='N' and acct_cls_flg='N'"
	sv_s = sv_s +" 	and entity_cre_flg='Y' and bacid='VAT' and acct_crncy_code in ('USD','EUR') and sol_id=?SVAR"

	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+ BANCS.STDIN.mySolId
	
	PRINT(sv_s)
	PRINT(BANCS.INPARAM.BINDVARS)
	
	sv_c = urhk_dbCursorOpenWithBind(sv_s)
	PRINT(sv_c)
	
	IF(sv_c != 0)THEN
	#{
		CUST.VATMV.vatErrMsg = "There are no Foriegn Currency VAT accounts exists for Sol " + BANCS.STDIN.mySolId
		PRINT(CUST.VATMV.vatErrMsg)
		sv_b = urtn_fileWrite(CUST.VATMV.failFileIndex1 + "|" + CUST.VATMV.vatErrMsg)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_n = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	PRINT(sv_n)
	
	sv_f = urhk_dbCursorFetch(sv_n)
	PRINT(sv_f)
	
	IF(sv_f != 0)THEN
	#{
		CUST.VATMV.vatErrMsg = "There are no Foriegn Currency VAT accounts exists for Sol " + BANCS.STDIN.mySolId
		PRINT(CUST.VATMV.vatErrMsg)
		sv_b = urtn_fileWrite(CUST.VATMV.failFileIndex1 + "|" + CUST.VATMV.vatErrMsg)
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	WHILE(sv_f == 0)
	#{
		CUST.VATMV.Fccyvatacnt = BANCS.OUTPARAM.Fccyvatacnt
		CUST.VATMV.FvatCrncy = BANCS.OUTPARAM.FvatCrncy
		PRINT(CUST.VATMV.Fccyvatacnt)
		PRINT(CUST.VATMV.FvatCrncy)
		CUST.VATMV.vattranAmt = ""	
		CUST.VATMV.vattranId = ""
		CUST.VATMV.pstdFlg = "N"
		CUST.VATMV.Hccyvatacnt = ""
		CUST.VATMV.Msg = ""
		
		sv_u = urhk_getAcctDetailsInRepository(CUST.VATMV.Fccyvatacnt)
		IF(sv_u == 0) THEN
		#{
			CUST.VATMV.vattranAmt = BANCS.OUTPARAM.EffAvailableAmt
		#}
		ENDIF

		#-------------------------------------------------------------------------------------------*
		# fetching the Home Currency account
		#--------------------------------------------------------------------------------------------*
		
		sv_s = "Hccyacnt|select foracid from tbaadm.gam where del_flg='N' and acct_cls_flg='N' and entity_cre_flg='Y' and"
		sv_s = sv_s +" bacid ='VAT' and bank_id=?SVAR and acct_crncy_code =?SVAR and sol_id=?SVAR"

		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.homeCrncyCode	+"|"+ BANCS.STDIN.mySolId
		
		PRINT(sv_s)
		PRINT(BANCS.INPARAM.BINDVARS)
		
		sv_d = urhk_dbSelectWithBind(sv_s)
		IF(sv_d == 0) THEN
		#{
			CUST.VATMV.Hccyvatacnt = BANCS.OUTPARAM.Hccyacnt
			PRINT(CUST.VATMV.Hccyvatacnt)
		#}
		ELSE
		#{
			CUST.VATMV.vatErrMsg = "There are no Home Currency VAT accounts exists for Sol " + BANCS.STDIN.mySolId
			PRINT(CUST.VATMV.vatErrMsg)
			sv_b = urtn_fileWrite(CUST.VATMV.failFileIndex1 + "|" + CUST.VATMV.vatErrMsg)
			GOTO NXTBACID			
		#}
		ENDIF	
		
		IF(CUST.VATMV.FvatCrncy == BANCS.STDIN.homeCrncyCode) THEN
		#{
			CUST.VATMV.vattranAmt = CDOUBLE(CUST.VATMV.vattranAmt)
			PRINT(CUST.VATMV.vattranAmt)
			#}
		ELSE
			#{
			BANCS.INPARAM.FromCurrency = CUST.VATMV.FvatCrncy
			PRINT(BANCS.INPARAM.FromCurrency)
			BANCS.INPARAM.ToCurrency = BANCS.STDIN.homeCrncyCode
			PRINT(BANCS.INPARAM.ToCurrency)
			BANCS.INPARAM.RateCode = CUST.VATMV.rateCode
			PRINT(BANCS.INPARAM.RateCode)
			BANCS.INPARAM.Rate = CDOUBLE("0.0")
			BANCS.INPARAM.CustId = ""
			BANCS.INPARAM.InputAmount = CUST.VATMV.vattranAmt
			sv_u = urhk_B2k_ConvertAmount("")
			PRINT(sv_u)
			
			IF(sv_u == 0)THEN
			#{
				CUST.VATMV.vattranAmt = CDOUBLE(BANCS.OUTPARAM.OutputAmount)
				PRINT(CUST.VATMV.vattranAmt)
				
				#}
			ELSE
				#{
				CUST.VATMV.vatErrMsg = "VAT Amount Conversion is failed From Currency "+CUST.VATMV.FvatCrncy
				PRINT(CUST.VATMV.vatErrMsg)
				sv_b = urtn_fileWrite(CUST.VATMV.failFileIndex1 + "|" + CUST.VATMV.vatErrMsg)
				GOTO NXTBACID			
			#}
			ENDIF
		#}
		ENDIF
		
		
		
		#==========================================================*
		# Transaction part starts here
		#==========================================================*
		BANCS.INPARAM.PostTranFlg = "Y"
		BANCS.INPARAM.CommitFlg = "Y"
		BANCS.INPARAM.InsertTranWithValidnFlg = "Y"
		BANCS.INPARAM.RestrictModifyInd = "FIRST_GROUP"
		BANCS.INPARAM.ErrorCheckForLuw = "Y"
		BANCS.INPARAM.CheckExceptions = "Y"
		#sv_r = urhk_MTTS_Initialize("")
		#PRINT(sv_r)
		#---------------------------------------------------------------------------------*
		# Populate Transaction details
		#---------------------------------------------------------------------------------*
		MTT.TranDetails.TranID = ""
		MTT.TranDetails.TranDate = "0"
		MTT.TranDetails.TranType = "T"
		MTT.TranDetails.TranSubType = "BI"
		MTT.TranDetails.IgnoreExcp = "I"
		MTT.TranDetails.Consolidate = "N"
		MTT.TranDetails.ReversalFlag ="N"
		MTT.TranDetails.ValidationFlag = "Y"
		MTT.TranDetails.PostFlag = "Y"
		MTT.TranDetails.CommitFlg = "Y"
