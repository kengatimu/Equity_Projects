        CUST.VATMV.list_file_nameSuccess = CUST.VATMV.successFile
        CUST.VATMV.titleSuccess = "FccyPL to HccyPL Success Report"
        CUST.VATMV.mrt_file_name1 = "FccyVATtoHccyVAT.mrt"
        CUST.VATMV.rpt_file_nameSuccess = "FccyVATtoHccyVATSuccess_" + CUST.VATMV.timeStamp + ".rpt"
        CUST.VATMV.rptSuccess =  "FccyVATtoHccyVATSuccess_" +  CUST.VATMV.timeStamp

        #----------------------------------------------------------------*
        # fetching the rate code from CPARAM table
        #----------------------------------------------------------------*
        CUST.VATMV.parameterId = "FPL_RATECODE"
        CUST.VATMV.module = "OT"

        sv_s = "ratecode|SELECT PARAMETER_VALUE FROM CUSTOM.C_CPVALUE CV,CUSTOM.C_CPMASTER CM WHERE CV.PARAMETER_ID = ?SVAR AND "
        sv_s = sv_s + " CM.MODULE_NAME = ?SVAR AND CM.PARAMETER_ID = CV.PARAMETER_ID AND CV.BANK_ID = ?SVAR AND CM.BANK_ID = CV.BANK_ID"

        PRINT(sv_s)
        BANCS.INPARAM.BINDVARS = CUST.VATMV.parameterId + "|" + CUST.VATMV.module + "|" + BANCS.STDIN.contextBankId
        PRINT(BANCS.INPARAM.BINDVARS)

        sv_d = urhk_dbSelectWithBind(sv_s)
        IF(sv_d == 0) THEN
        #{
                CUST.VATMV.rateCode = BANCS.OUTPARAM.ratecode
                PRINT(CUST.VATMV.rateCode)
        #}
        ELSE
