		CUST.VATMV.vatTranrmks = MTT.TranDetails.Remarks
		
		#------------------------------------------------------------------*
		# Defining the Transaction
		#------------------------------------------------------------------*
		
		sv_u = urhk_MTTS_DefineTransaction("TRAN")
		PRINT(sv_u)
		IF(sv_u != 0) THEN
		#{
			CUST.VATMV.vatErrMsg = "Error Encountered in Defining the Transaction"
			PRINT(CUST.VATMV.vatErrMsg)
			GOTO NXTBACID
		#}
		ENDIF
		
		MTT.PartTranDetails.TODRefType = ""
		
		MTT.PartTranDetails.RefAmount = -CDOUBLE(CUST.VATMV.vattranAmt)
		PRINT(MTT.PartTranDetails.RefAmount)
		MTT.PartTranDetails.Account = CUST.VATMV.Fccyvatacnt
		MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
		
		IF(CUST.VATMV.FvatCrncy == BANCS.STDIN.homeCrncyCode) THEN
		#{
			MTT.PartTranDetails.RateCode = ""
			MTT.PartTranDetails.Rate = ""
			#}
		ELSE
			#{
			MTT.PartTranDetails.RateCode = CUST.VATMV.rateCode
			MTT.PartTranDetails.Rate = "0.00"
		#}
		ENDIF
		#MTT.PartTranDetails.CarveAmtFlg = "Y"
		MTT.PartTranDetails.TranIdentifier = "TRAN"
		MTT.PartTranDetails.Particulars = "Debiting the Foreign Currency VAT Account" + ":" + CUST.VATMV.Fccyvatacnt
		
		sv_u = urhk_MTTS_DefinePartTran("PARTTRAN1")
		PRINT(sv_u)
		IF(sv_u != 0) THEN
		#{
			CUST.VATMV.vatErrMsg = "Error Encountered in Defining the Debit part Transaction"
			PRINT(CUST.VATMV.vatErrMsg)
			GOTO NXTBACID
		#}
		ENDIF
		
		#------------------------------------------------------------*
		# Crediting the central Account
		#------------------------------------------------------------*
		
		MTT.PartTranDetails.TODRefType = ""
		
		MTT.PartTranDetails.RefAmount = CDOUBLE(CUST.VATMV.vattranAmt)
		PRINT(MTT.PartTranDetails.RefAmount)
		MTT.PartTranDetails.Account = CUST.VATMV.Hccyvatacnt
		MTT.PartTranDetails.RefCurrency = BANCS.STDIN.homeCrncyCode
		MTT.PartTranDetails.RateCode = ""
		MTT.PartTranDetails.Rate = ""
		#MTT.PartTranDetails.CarveAmtFlg = "Y"
		MTT.PartTranDetails.TranIdentifier = "TRAN"
		MTT.PartTranDetails.Particulars = "Crediting the Home Currency VAT Account" + ":" + CUST.VATMV.Hccyvatacnt
		
		sv_u = urhk_MTTS_DefinePartTran("PARTTRAN1")
		PRINT(sv_u)
		IF(sv_u != 0) THEN
		#{
			CUST.VATMV.vatErrMsg = "Error Encountered in Defining the Credit part Transaction"
			PRINT(CUST.VATMV.vatErrMsg)
			GOTO NXTBACID
		#}
		ENDIF
		sv_r = urhk_putExceptionsIntoRepository("")
		PRINT(sv_r)
		
		sv_s = urhk_b2k_printRepos("EXCP")
		#---------------------------------------------------------*
		# Committing the Transaction
		#---------------------------------------------------------*
		sv_u = urhk_MTTS_EndDefinition("")
		PRINT(sv_u)
		IF(sv_u !=0) THEN
		#{
			sv_a = "Transaction Commit Failed"
			PRINT(sv_a)
			sv_r = urhk_MTTS_ReportErrorCondition("")
			PRINT(sv_r)
			PRINT(MTT.Error.Description)
			CUST.VATMV.vatErrMsg = MTT.Error.Description
			sv_r = urhk_MTTS_HandleExceptions("POST")
			PRINT(sv_r)
			sv_r=urhk_B2k_PrintRepos("MTT")
			PRINT(sv_r)
			#sv_r = urhk_dbSQL("rollback")
			#PRINT(sv_r)
			#BANCS.INPARAM.BINDVARS=""
			#sv_d = urhk_dbSelectWithBind("rollback")
			#PRINT(sv_d)
			
			CUST.VATMV.pstdFlg = "N"
			#}
		ELSE
			#{
			PRINT(BANCS.OUTPARAM.MTTTranId)
			CUST.VATMV.vattranId = BANCS.OUTPARAM.MTTTranId
			PRINT(CUST.VATMV.vattranId)
			#			CUST.VATMV.errmsg = MTT.Error.Description
			#			PRINT(CUST.VATMV.errmsg)
			IF(CUST.VATMV.vattranId != "") THEN
			#{
				sv_a = "Transaction is successful"
				PRINT(sv_a)
				#BANCS.INPARAM.BINDVARS=""
				#sv_d = urhk_dbSelectWithBind("commit")
				#PRINT(sv_d)
				CUST.VATMV.pstdFlg = "Y"
				#}
			ELSE
				#{
				#sv_d = urhk_dbSQL("rollback")
				#PRINT(sv_d)
				#BANCS.INPARAM.BINDVARS=""
				#sv_d = urhk_dbSelectWithBind("rollback")
				#PRINT(sv_d)
				sv_r=urhk_B2k_PrintRepos("MTT")
				PRINT(sv_r)
				CUST.VATMV.vatErrMsg = "Transcation failed for bacid " + CUST.VATMV.Fccybacid
				CUST.VATMV.pstdFlg = "N"
				
			#}
			ENDIF
			
			
		#}
		ENDIF
			
                #sv_z = urhk_MTTS_Close("")
                #PRINT(sv_z)

		IF(TRIM(CUST.VATMV.vattranId) != "")THEN
		#{	
		
			CUST.VATMV.Msg = "Amount is settled From Currency "+CUST.VATMV.FvatCrncy+" tran Id:"+CUST.VATMV.vattranId
			PRINT(CUST.VATMV.Msg)
			sv_b = urtn_fileWrite(CUST.VATMV.successFileIndex1 + "|" + CUST.VATMV.Msg)
				
			sv_s = "insert into custom.FPLTRAN (TRAN_ID,TRAN_DATE,CR_ACCT_ID,DR_ACCT_ID,FCCY,HCCY,TRAN_AMT,DR_ACCT_SOLID,TRAN_PARTICULAR,POSTED_FLG,"
			sv_s = sv_s + "POSTED_USER_ID,BANK_ID)"
			sv_s = sv_s + " values(?SVAR,sysdate,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR)"
			BANCS.INPARAM.BINDVARS = CUST.VATMV.vattranId + "|" + CUST.VATMV.Hccyvatacnt + "|" + CUST.VATMV.Fccyvatacnt + "|" + CUST.VATMV.FvatCrncy 
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.homeCrncyCode + "|" + CUST.VATMV.vattranAmt + "|" + BANCS.STDIN.mySolId
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + CUST.VATMV.vatTranrmks + "|" + CUST.VATMV.pstdFlg
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.userId + "|" + BANCS.STDIN.contextBankId
		#}
		ENDIF
		
		PRINT(sv_s)
		
		PRINT(BANCS.INPARAM.BINDVARS)
		
		sv_u = urhk_dbSQLWithBind(sv_s)
		PRINT(sv_u)
		sv_u = urhk_dbSQLWithBind("COMMIT")
		BANCS.STDIN.InsrtFlag = "Y"
		#sv_r = urhk_MTTS_Close("")
		CUST.VATMV.vatErrMsg = ""
		
		NXTBACID:
		sv_f = urhk_dbCursorFetch(sv_n)
		PRINT(sv_f)
	#}
	DO
	
        sv_c = urhk_dbCursorClose(sv_n)
        PRINT(sv_c)

	sv_r = urhk_MTTS_Close("")
	ENDOFSCRIPT:

        sv_c = urtn_fileClose(CUST.VATMV.failFileIndex1)
        PRINT(sv_c)
        sv_c = urtn_fileClose(CUST.VATMV.successFileIndex1)
        PRINT(sv_c)

        CUST.VATMV.ERR000002 = "Failed "
        PRINT(CUST.VATMV.list_file_name)
        sv_r = "exebatch mrbx4004 ${B2K_SESSION_ID} " + CUST.VATMV.mrt_file_name + " " + CUST.VATMV.list_file_name + " " + CUST.VATMV.rpt
        PRINT(sv_r)
        sv_r = SYSTEM(sv_r)
        IF (sv_r != 0) THEN
        #{
                sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
                sv_u = urhk_SetOrbOut("Error_1|ERR^" + CUST.VATMV.ERR000002 + "")
                GOTO FINISH
        #}
        ENDIF
        sv_q = "exebatch babx4040 ${B2K_SESSION_ID} " + " "+ CUST.VATMV.rpt_file_name+" '" + CUST.VATMV.title+"' MANAGER 1 N"
        PRINT(sv_q)
        sv_r = SYSTEM(sv_q)

     ##############

        PRINT(CUST.VATMV.list_file_nameSuccess )
        sv_r = "exebatch mrbx4004 ${B2K_SESSION_ID} " + CUST.VATMV.mrt_file_name1 + " " + CUST.VATMV.list_file_nameSuccess  + " " + CUST.VATMV.rptSuccess
        PRINT(sv_r)
        sv_r = SYSTEM(sv_r)
        IF (sv_r != 0) THEN
        #{
                sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
                sv_u = urhk_SetOrbOut("Error_1|ERR^" + CUST.VATMV.ERR000002 + "")
                GOTO FINISH
        #}
        ENDIF
        sv_q = "exebatch babx4040 ${B2K_SESSION_ID} " + " "+ CUST.VATMV.rpt_file_nameSuccess+" '" + CUST.VATMV.titleSuccess+"' MANAGER 1 N"
        PRINT(sv_q)
        sv_r = SYSTEM(sv_q)
        IF (sv_r != 0) THEN
        #{
                sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
                sv_u = urhk_SetOrbOut("Error_1|ERR^" + CUST.VATMV.ERR000002 + "^DATE")
                GOTO FINISH

        #}
        ENDIF

