<--START
TRACE ON

        sv_u=REPEXISTS("CUST")
        IF(sv_u==0) THEN
        #{
                CREATEREP("CUST")
        #}
        ENDIF

        sv_u=CLASSEXISTS("CUST", "CSEG")
        IF(sv_u==0) THEN
        #{
                CREATECLASS("CUST", "CSEG", 5)
        #}
        ENDIF

        sv_t=urhk_b2k_printrepos("BANCS")
        print(sv_t)

        IF( (FIELDEXISTS(("BANCS").("INPUT").("bankId"))== 0) ) THEN
        #{
                CUST.CSEG.errMsg="please enter Bank Id"
                sv_t = "ERROR | " +CUST.CSEG.errMsg
                sv_u = urhk_SetOrbOut(sv_t)
                GOTO ENDSCRIPT
        #}
        ENDIF

        IF( (FIELDEXISTS(("BANCS").("INPUT").("branchId"))== 0) ) THEN
        #{
                CUST.CSEG.errMsg="please enter Bank Id"
                sv_t = "ERROR | " +CUST.CSEG.errMsg
                sv_u = urhk_SetOrbOut(sv_t)
                GOTO ENDSCRIPT
        #}
        ENDIF

	IF( (FIELDEXISTS(("BANCS").("INPUT").("downloadId"))== 0) ) THEN
        #{
                CUST.CSEG.errMsg="please enter Download Id"
                sv_t = "ERROR | " +CUST.CSEG.errMsg
                sv_u = urhk_SetOrbOut(sv_t)
                GOTO ENDSCRIPT
        #}
        ENDIF

	IF( (FIELDEXISTS(("BANCS").("INPUT").("reqDate"))== 0) ) THEN
        #{
                CUST.CSEG.errMsg="please enter Request Date"
                sv_t = "ERROR | " +CUST.CSEG.errMsg
                sv_u = urhk_SetOrbOut(sv_t)
                GOTO ENDSCRIPT
        #}
        ENDIF

        CUST.CSEG.count = 0
        #---------------------------------------------------------------------------------------------------------------
        # Variable Initialization
        #---------------------------------------------------------------------------------------------------------------

        CUST.CSEG.bankId = BANCS.INPUT.bankId
        print(CUST.CSEG.bankId)

        CUST.CSEG.branchId = BANCS.INPUT.branchId
        print(CUST.CSEG.branchId)

	CUST.CSEG.downloadId = BANCS.INPUT.downloadId
        print(CUST.CSEG.downloadId)

	CUST.CSEG.reqDate = BANCS.INPUT.reqDate
        print(CUST.CSEG.reqDate)

        sv_s="requetedId,branchId,branchName,foracid,acctName,acctCrncy,startChqBookNum,endChqBookNum,noOdChqBook,noOfChqLeaf,reqStatus,requestedDate |"
        sv_s=sv_s + "SELECT REQ_ID,(select sol_id from tbaadm.sol where sol_id=branch_Id and bank_id=bank_id) as branch_id, "
        sv_s=sv_s + "(select sol_desc from tbaadm.sol where sol_id=branch_id and bank_id=bank_id) as branch_name,a.FORACID,"
	sv_s=sv_s + "acct_name,CHRG_CRNCY,BEGIN_CHQ_NUM,END_CHQ_NUM,NUM_OF_CHB,NUM_OF_CHQ_LVS,req_status,to_char(REQ_DATE,'dd-mm-yyyy') "
        sv_s=sv_s + "from custom.custom_cbr a,tbaadm.gam b "
        sv_s=sv_s + "where DOWNLOAD_ID=?SVAR and a.del_flg='N' and req_date=to_date(?SVAR,'dd-mm-yyyy') and a.foracid=b.foracid "
	sv_s=sv_s + "and branch_id=?SVAR and a.bank_id=?SVAR and a.bank_id=b.bank_id order by REQ_ID asc"
        print(sv_s)

        BANCS.INPARAM.BINDVARS = CUST.CSEG.downloadId+ "|" +CUST.CSEG.reqDate+ "|" +CUST.CSEG.branchId+ "|" +CUST.CSEG.bankId
        print(BANCS.INPARAM.BINDVARS)

        sv_c = urhk_dbcursorOpenWithBind(sv_s)
        PRINT(sv_c)

        IF(sv_c == 0) THEN
         #{
                CUST.CSEG.DB_CURSOR_NUMBER = BANCS.OUTPARAM.DB_CURSOR_NUMBER
                print(CUST.CSEG.DB_CURSOR_NUMBER)


                sv_c = urhk_dbCursorFetch(CUST.CSEG.DB_CURSOR_NUMBER)
                print(sv_c)

                IF(sv_c != "0")THEN
                #{
                        sv_e = urhk_SetOrbOut("SuccessorFailure|Failed")
                        sv_u = urhk_SetOrbOut("Failure| No record found")
                        print(sv_u)
                #}
                ENDIF

                WHILE(sv_c == "0")
                #{
                        CUST.CSEG.requetedId = BANCS.OUTPARAM.requetedId
                        print(CUST.CSEG.requetedId)

                        CUST.CSEG.branchId= BANCS.OUTPARAM.branchId
                        print(CUST.CSEG.branchId)

                        CUST.CSEG.branchName= BANCS.OUTPARAM.branchName
                        print(CUST.CSEG.branchName)

                        CUST.CSEG.foracid = BANCS.OUTPARAM.foracid
                        print(CUST.CSEG.foracid)

			CUST.CSEG.acctName = BANCS.OUTPARAM.acctName
                        print(CUST.CSEG.acctName)

			CUST.CSEG.acctCrncy= BANCS.OUTPARAM.acctCrncy
                        print(CUST.CSEG.acctCrncy)	

			CUST.CSEG.startChqBookNum= BANCS.OUTPARAM.startChqBookNum
                        print(CUST.CSEG.startChqBookNum)

			CUST.CSEG.endChqBookNum= BANCS.OUTPARAM.endChqBookNum
                        print(CUST.CSEG.endChqBookNum)

			CUST.CSEG.noOdChqBook= BANCS.OUTPARAM.noOdChqBook
                        print(CUST.CSEG.noOdChqBook)

			CUST.CSEG.noOfChqLeaf= BANCS.OUTPARAM.noOfChqLeaf
                        print(CUST.CSEG.noOfChqLeaf)

			CUST.CSEG.reqStatus= BANCS.OUTPARAM.reqStatus
                        print(CUST.CSEG.reqStatus)

                        CUST.CSEG.requestedDate= BANCS.OUTPARAM.requestedDate
                        print(CUST.CSEG.requestedDate)

                        CUST.CSEG.count = CINT(CUST.CSEG.count)+ 1
                        print(CUST.CSEG.count)

                        sv_c = urhk_SetOrbOut("ChequeBookDetails.<rec_"+CUST.CSEG.count+">.Request_Id"+"| "+CUST.CSEG.requetedId)
                        print(sv_c)

                        sv_c = urhk_SetOrbOut("ChequeBookDetails.<rec_"+CUST.CSEG.count+">.Branch_Id"+"| "+CUST.CSEG.branchId)
                        print(sv_c)

                        sv_c = urhk_SetOrbOut("ChequeBookDetails.<rec_"+CUST.CSEG.count+">.Branch_Name"+"| "+CUST.CSEG.branchName)
                        print(sv_c)

                        sv_c = urhk_SetOrbOut("ChequeBookDetails.<rec_"+CUST.CSEG.count+">.Account_Num"+"| "+CUST.CSEG.foracid)
                        print(sv_c)
			
			sv_c = urhk_SetOrbOut("ChequeBookDetails.<rec_"+CUST.CSEG.count+">.Account_Name"+"| "+CUST.CSEG.acctName)
                        print(sv_c)

			sv_c = urhk_SetOrbOut("ChequeBookDetails.<rec_"+CUST.CSEG.count+">.Account_Crncy_Code"+"| "+CUST.CSEG.acctCrncy)
                        print(sv_c)

			sv_c = urhk_SetOrbOut("ChequeBookDetails.<rec_"+CUST.CSEG.count+">.Start_Chq_book"+"| "+CUST.CSEG.startChqBookNum)
                        print(sv_c)

			sv_c = urhk_SetOrbOut("ChequeBookDetails.<rec_"+CUST.CSEG.count+">.End_Chq_Book"+"| "+CUST.CSEG.endChqBookNum)
                        print(sv_c)

			sv_c = urhk_SetOrbOut("ChequeBookDetails.<rec_"+CUST.CSEG.count+">.No_Of_chq_book"+"| "+CUST.CSEG.noOdChqBook)
                        print(sv_c)

			sv_c = urhk_SetOrbOut("ChequeBookDetails.<rec_"+CUST.CSEG.count+">.No_Of_chq_Leaf"+"| "+CUST.CSEG.noOfChqLeaf)
                        print(sv_c)

			sv_c = urhk_SetOrbOut("ChequeBookDetails.<rec_"+CUST.CSEG.count+">.Request_Status"+"| "+CUST.CSEG.reqStatus)
                        print(sv_c)
			
                        sv_c = urhk_SetOrbOut("ChequeBookDetails.<rec_"+CUST.CSEG.count+">.Requested_Date"+"| "+CUST.CSEG.requestedDate)
                        print(sv_c)

                        sv_c = urhk_dbCursorFetch(CUST.CSEG.DB_CURSOR_NUMBER)
                        print(sv_c)

                #}
                DO
                sv_c = urhk_dbCursorClose(CUST.CSEG.DB_CURSOR_NUMBER)
                print(sv_c)
        #}
        ENDIF
        EXITSCRIPT


ENDOFSCRIPT:
END-->
