#======================================================#
#Source Name                    :eqRsrvExcpChrgAmt.scr
#Calling Service		:SRV_DisbLoanAcct_post_process_data.scr
#Menu                           :HLADISB
#Date                           :05-04-2023
#Description                    :Mark Line on Operative A/c. During Disburement as Exceptional Charge for three months from date of Disb.
#Author                         :Ranjith Palani
#======================================================#
<--start
#trace on
	if(repexists("CUST") == 0)then
		createrep("CUST")
	endif
	if(classexists("CUST","EXRSRV") == 0)then
		createclass("CUST","EXRSRV",5)
	endif

	sv_l = urhk_SRV_GetVal("acctDisburseTranLA.laAcct.foracid")
		CUST.EXRSRV.laAcctforacid = BANCS.OUTPARAM.srvValue
		print(CUST.EXRSRV.laAcctforacid)
	sv_l = urhk_SRV_GetVal("acctDisburseTranLA.laAcct.crncyCode")
		CUST.EXRSRV.laAcctcrncyCode = BANCS.OUTPARAM.srvValue
		print(CUST.EXRSRV.laAcctcrncyCode)
	sv_l = urhk_SRV_GetVal("acctDisburseTranLA.transferAcctNum.foracid")
		CUST.EXRSRV.opAcctNum = BANCS.OUTPARAM.srvValue
		print(CUST.EXRSRV.opAcctNum)
	sv_l = urhk_SRV_GetVal("acctDisburseTranLA.tranRateCode.refCode")
		CUST.EXRSRV.rateCode = BANCS.OUTPARAM.srvValue
		print(CUST.EXRSRV.rateCode)
	sv_g = urhk_getAcctDetailsInRepository(CUST.EXRSRV.opAcctNum)
	if(sv_g == 0)then
		CUST.EXRSRV.opAcctcrncyCode = BANCS.OUTPARAM.acctCrncyCode
		print(CUST.EXRSRV.opAcctcrncyCode)
	else
		CUST.EXRSRV.opAcctcrncyCode = ""
	endif

	CUST.EXRSRV.excpChrgRsrvAmt = cdouble(BANCS.INPUT.ladisb_main_FIELD_6)
	print(CUST.EXRSRV.excpChrgRsrvAmt)

	BANCS.INPARAM.InputAmount  = CUST.EXRSRV.excpChrgRsrvAmt 
	BANCS.INPARAM.FromCurrency = CUST.EXRSRV.laAcctcrncyCode 
	BANCS.INPARAM.ToCurrency   = CUST.EXRSRV.opAcctcrncyCode 
	BANCS.INPARAM.RateCode     = CUST.EXRSRV.rateCode 
	BANCS.INPARAM.Rate         = cdouble("0")
	sv_a = urhk_B2k_ConvertAmount("")
	if(sv_a == 0)then
		print(BANCS.OUTPARAM.OutputAmount)
		CUST.EXRSRV.excpChrgRsrvAmt = BANCS.OUTPARAM.OutputAmount
		print(CUST.EXRSRV.excpChrgRsrvAmt)
	else
		CUST.EXRSRV.excpChrgRsrvAmt = "0"
	endif

	sv_e =  mid$(BANCS.STDIN.BODDate,0,10) +"|"+ "3" +"|"+ "0"
	sv_d = urhk_B2k_Add_MonthsDays_To_date(sv_e)
	if(sv_d == 0)then
		CUST.EXRSRV.lienExpDate = mid$(BANCS.OUTPARAM.MODIFIED_DATE,0,10)
		print(CUST.EXRSRV.lienExpDate)
	else
		CUST.EXRSRV.lienExpDate = ""
	endif

	BANCS.INPARAM.acctNum = CUST.EXRSRV.opAcctNum 
	BANCS.INPARAM.blockMode = "A"
	BANCS.INPARAM.lienAmt = cdouble(CUST.EXRSRV.excpChrgRsrvAmt) * 1
	BANCS.INPARAM.expiryDate = CUST.EXRSRV.lienExpDate
	BANCS.INPARAM.remarks = "ExceptionalChrgAmtResrveonOprtive:"+CUST.EXRSRV.opAcctNum
	BANCS.INPARAM.reasonCode = "EXCR"
	BANCS.INPARAM.bodDate = mid$(BANCS.STDIN.BODDate,0,10)
	BANCS.INPARAM.lienValueDate = mid$(BANCS.STDIN.BODDate,0,10)
	sv_u = urhk_updateLien("")
	if(sv_u == 0)then
		sv_s = BANCS.OUTPARAM.successOrFailure
		if(sv_s == "S")then
			sv_c = urhk_dbSqlWithBind("commit")
			print(sv_c)
			print("Lien Mark Success")
			print("Lien Marked on Operative A/c.: "+CUST.EXRSRV.opAcctNum +"And corresponding Loan A/c. is:"+ CUST.EXRSRV.laAcctforacid)
		else
			CUST.EXRSRV.srvErrMsg =  "Lien Mark Failed on operative account for Exceptional Charge."
			CUST.EXRSRV.srvErrCode = "Lien"
			CUST.EXRSRV.srvSucFail = "S"
			exitscript
		endif
	else
		CUST.EXRSRV.srvErrMsg =  "Lien Mark Failed on operative account for Exceptional Charge."
		CUST.EXRSRV.srvErrCode = "Lien"
		CUST.EXRSRV.srvSucFail = "S"
		exitscript
	endif	

trace off
end-->
