	IF (sv_d == 0) THEN
	#{
		CUST.SALPAY.acctownership=BANCS.OUTPARAM.acctownership
		PRINT(CUST.SALPAY.acctownership)
		
		IF (CUST.SALPAY.acctownership != "O") THEN
		#{
			#CUST.SALPAY.errMsg = "Only office Accounts allowed for Debit"
			#GOTO ENDOFSCRIPT
			
		#}
		ENDIF
	#}
	ENDIF
	
	#-------------------------------------------------------------------------------------------------------
	# Getting no.of records count
	#-------------------------------------------------------------------------------------------------------
	sv_u = urhk_SRV_NumOfRecs("salPayCreditDet.salPayCreditLL")
	PRINT(sv_u)
	IF (sv_u == 0) THEN
	#{
		CUST.SALPAY.noOfRecords = CINT(BANCS.OUTPARAM.srvValue)
		PRINT(CUST.SALPAY.noOfRecords)
		#}
	ELSE
		#{
		CUST.SALPAY.errMsg = "Error in getting record count"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_l = 0
	sv_a = "\n"
	WHILE (sv_l < CINT(CUST.SALPAY.noOfRecords))
	#{
		sv_r = "<rec_" + Format$(sv_l,"%d") + ">"
		PRINT(sv_r)
		
		#------------------------------------------------------------------------------
		# Setting frontend values
		#------------------------------------------------------------------------------
		sv_s = "salPayCreditDet.salPayCreditLL." + sv_r + ".tranParticulars|" + CUST.SALPAY.tranParticulars
		PRINT(sv_s)
		sv_u = urhk_SRV_SetVal(sv_s)
		PRINT(sv_u)

		#-------------------------------------------------------------------------------------------Edwin.z SS restrict start
		# Fetch A/c - foracid
		#-------------------------------------------------------------------------------------------
		sv_u = urhk_SRV_GetVal("salPayCreditDet.salPayCreditLL." + sv_r + ".operAcctNo.foracid")
		PRINT(sv_u)
		IF (sv_u == 0) THEN
		#{
			CUST.SALPAY.foracid = BANCS.OUTPARAM.srvValue
			PRINT(CUST.SALPAY.foracid)
		#}
		ELSE
		#{
			sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for foracid")
			BANCS.OUTPUT.successOrFailure="F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#-------------------------------------------------------------------------------------------
		# Fetch A/c - serial
		#-------------------------------------------------------------------------------------------
	
			sv_u = urhk_SRV_GetVal("salPayCreditDet.salPayCreditLL." + sv_r + ".key.serial_num")
			PRINT(sv_u)
		IF (sv_u == 0) THEN

		#{
		CUST.SALPAY.serialnum = BANCS.OUTPARAM.srvValue
		PRINT(CUST.SALPAY.serialnum)

		#}
		ELSE
		#{

			sv_u = urhk_SRV_SetErr("Error: urhk_SRV_GetVal failed for serialnum")
			BANCS.OUTPUT.successOrFailure="F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF

		sv_u = urhk_getAcctDetailsInRepository(CUST.SALPAY.foracid)
		PRINT(sv_u)
		IF (sv_u ==0) THEN
		#{				
				CUST.SALPAY.schmCode = BANCS.OUTPARAM.schmCode
				PRINT(CUST.SALPAY.schmCode)

		#}
		ELSE
		#{
			
			CUST.SALPAY.schmCode     = ""

		#}
		ENDIF


			IF (BANCS.STDIN.contextBankId == "11") THEN
			#{
				#-------------------------------------------------------------------------------------------
				#--Start scheme restriction
				#-------------------------------------------------------------------------------------------
					PRINT(CUST.SALPAY.foracid)
					PRINT(CUST.SALPAY.schmCode)
					PRINT(BANCS.STDIN.userWorkClass)
				
				IF ((CUST.SALPAY.schmCode == "SB120") OR (CUST.SALPAY.schmCode == "CA220")) THEN
				#{
					
						IF ((BANCS.STDIN.userWorkClass != "260") AND (BANCS.STDIN.userWorkClass != "350")) THEN
						#{
							#sv_m = sv_m  + CUST.SALPAY.serialnum + ","+ "Insufficent Workclass to credit this Scheme Contact HO" + sv_a
							sv_u = urhk_SRV_SetErr("Insufficent Workclass to credit this Scheme " + CUST.SALPAY.schmCode + "  only WC 260 OR 350 allowed " + " ,for PartTransrlnum " + CUST.SALPAY.serialnum )	
							GOTO NEXTREC
						#}
						ENDIF
					
				#}
				ENDIF
				#-------------------------------------------------------------------------------------------
				#--End scheme restriction
				#-------------------------------------------------------------------------------------------Edwin.z SS restrict end
			#}
			ENDIF

		NEXTREC:
		sv_l = sv_l + 1
		PRINT(sv_l)
	#}
	DO
	
	ENDOFSCRIPT:
		IF(CUST.SALPAY.errMsg != "") THEN
		#{
			PRINT(CUST.SALPAY.errMsg)
			sv_u = urhk_SRV_setErr(CUST.SALPAY.errMsg)
			BANCS.OUTPUT.successOrFailure = "F"
		#}
