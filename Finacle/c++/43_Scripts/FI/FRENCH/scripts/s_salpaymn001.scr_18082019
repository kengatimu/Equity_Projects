		#}
	ELSE
		#{
		CUST.SALPAY.errMsg = "Error in getting Debit Account"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_s = "schmCode|SELECT schm_code FROM tbaadm.gam "
	sv_s = sv_s + "WHERE bank_id = ?SVAR "
	sv_s = sv_s + "AND FORACID = ?SVAR"
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.SALPAY.drAcct
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	IF (sv_d == 0) THEN
	#{
		CUST.SALPAY.schmCode=BANCS.OUTPARAM.schmCode
		PRINT(CUST.SALPAY.schmCode)
		
		IF (CUST.SALPAY.schmCode == "SB113") THEN
		#{
			CUST.SALPAY.errMsg = "Accounts in scheme SB113 not allowed for this transaction"
			GOTO ENDOFSCRIPT			
		#}
		ENDIF

		IF (CUST.SALPAY.schmCode == "INCOM") THEN
		#{
			CUST.SALPAY.errMsg = "Income GL " +  CUST.SALPAY.drAcct + "  not allowed for this transaction"
			GOTO ENDOFSCRIPT			
		#}
		ENDIF
	#}
	ENDIF
	
	sv_s = "bacid|SELECT bacid FROM tbaadm.gam "
	sv_s = sv_s + "WHERE bank_id = ?SVAR "
	sv_s = sv_s + "AND FORACID = ?SVAR"
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.SALPAY.drAcct
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	IF (sv_d == 0) THEN
	#{
		CUST.SALPAY.bacid=BANCS.OUTPARAM.bacid
		PRINT(CUST.SALPAY.bacid)
		
		IF (CUST.SALPAY.bacid == "PAGRPREC") THEN
		#{
			CUST.SALPAY.errMsg = "Debiting IGLS suspense is not allowed in this transaction"
			GOTO ENDOFSCRIPT
			
		#}
		ENDIF
	#}
	ENDIF

	sv_s = "acctownership|SELECT acct_ownership FROM tbaadm.gam "
	sv_s = sv_s + "WHERE bank_id = ?SVAR "
	sv_s = sv_s + "AND FORACID = ?SVAR"
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.SALPAY.drAcct
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
