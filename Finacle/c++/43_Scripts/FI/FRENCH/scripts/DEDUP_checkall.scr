#one:Referencenumber
                sv_s = "orgkey,docdescr,referencenumber, firstname, lastname, refdob, refemail, refphone,suspend|"
                sv_s = sv_s + "select a.orgkey, docdescr, referencenumber, cust_first_name, cust_last_name,CUST_DOB,PREFERREDEMAIL,PREFERREDphone, suspended   "
                sv_s = sv_s + "from crmuser.accounts a, crmuser.entitydocument e "
                sv_s = sv_s + "where a.bank_id=?SVAR and e.bank_id=a.bank_id and a.orgkey=e.orgkey and referencenumber=?SVAR and rownum<2 "
                PRINT(sv_s)
                BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + STDWFS.GLBDATA.Referencenumber
                PRINT(BANCS.INPARAM.BINDVARS)
                sv_d = urhk_dbselectWithBind(sv_s)
                print(sv_d)
                IF (sv_d == "0") THEN
                        STDWFS.GLBDATA.orgkey = BANCS.OUTPARAM.orgkey
                        print(STDWFS.GLBDATA.orgkey)
                        STDWFS.GLBDATA.docdescr = BANCS.OUTPARAM.docdescr
                        print(STDWFS.GLBDATA.docdescr)
                        STDWFS.GLBDATA.referencenumber = BANCS.OUTPARAM.referencenumber
                        print(STDWFS.GLBDATA.referencenumber)
                        STDWFS.GLBDATA.firstrefname= BANCS.OUTPARAM.firstname
                        print(STDWFS.GLBDATA.firstrefname)
                        STDWFS.GLBDATA.lastrefname= BANCS.OUTPARAM.lastname
                        print(STDWFS.GLBDATA.lastrefname)

                        STDWFS.GLBDATA.refdob= BANCS.OUTPARAM.refdob
                        print(STDWFS.GLBDATA.refdob)
                        STDWFS.GLBDATA.refemail= BANCS.OUTPARAM.refemail
                        print(STDWFS.GLBDATA.refemail)
                        IF(STDWFS.GLBDATA.refemail == "")THEN
                        #{
                                STDWFS.GLBDATA.refemail= " "
                        #}
                        ENDIF
                        STDWFS.GLBDATA.refphone= BANCS.OUTPARAM.refphone
                        print(STDWFS.GLBDATA.refphone)
                        IF(STDWFS.GLBDATA.refphone == "")THEN
                        #{
                                STDWFS.GLBDATA.refphone=" "
                        #}
                        ENDIF
                        STDWFS.GLBDATA.suspend= BANCS.OUTPARAM.suspend
                        print(STDWFS.GLBDATA.suspend)

                        STDWFS.GLBDATA.Referencenumberflg="1"
                ENDIF
