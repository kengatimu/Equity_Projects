#FIFTH:PlaceOfBirth

                sv_s = "custdoborgkey,cust_dob,cust_first_name,cust_last_name,cust_middle_name,custphone, custemail,custsuspend,custDoc,custDocDesc |"
                sv_s = sv_s + "select a.orgkey,CUST_DOB,CUST_FIRST_NAME,CUST_LAST_NAME,CUST_MIDDLE_NAME, preferredphone, preferredemail, suspended, referencenumber,  "
                sv_s = sv_s + " docdescr from crmuser.accounts a, crmuser.entitydocument e  where a.bank_id=?SVAR and e.bank_id=a.bank_id and "
                sv_s = sv_s + "a.orgkey=e.orgkey and  CUST_DOB=?SVAR and CUST_FIRST_NAME =?SVAR and  CUST_LAST_NAME =?SVAR  and referencenumber is not null and preferredphone=?SVAR and PLACEOFBIRTH =?SVAR and rownum<2"
                PRINT(sv_s)
                BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + STDWFS.GLBDATA.Dateofbirth  + "|" + STDWFS.GLBDATA.firstname + "|" + STDWFS.GLBDATA.lastname+ "|" +STDWFS.GLBDATA.Phonenumber+ "|" +STDWFS.GLBDATA.placeofbirth
                PRINT(BANCS.INPARAM.BINDVARS)
