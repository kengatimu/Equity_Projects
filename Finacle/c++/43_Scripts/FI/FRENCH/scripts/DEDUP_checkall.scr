	sv_s = "custdoborgkey,cust_dob,cust_first_name,cust_last_name,cust_middle_name,custphone, custemail,custsuspend,custDoc,custDocDesc |"
                sv_s = sv_s + "select a.orgkey,CUST_DOB,CUST_FIRST_NAME,CUST_LAST_NAME,CUST_MIDDLE_NAME, preferredphone, preferredemail, suspended, referencenumber,  "
