<--START
##DRC Customer DEDUP - Check:
#
#XML Inputs:
#
#1. Reference number (id,voters card, DL,Military ID, passport(display date of expirely))
#2. Date of birth
#3. Phone number
#4. Email addrsess
#5. Acct_name (firstname ,middlename and  LastName)
#
#
#Status == 1/0:
#
#if Referencenumber exist > 1  else 0 ---> 1/0
#
#if Dateofbirth exist > 1  else 0 ---> 1/0
#
#if Phonenumber exist > 1  else 0 ---> 1/0
#
#if Emailaddrsess exist > 1  else 0 ---> 1/0
#
#if Acct_name (combination) exist > 1  else 0 ---> 1/0
#
#Validation:
#
#1. if (Referencenumber=="1") then  =  Referencenumber="1"
#
#2. if (Dateofbirth=="1") then =  Dateofbirth="1"
#
#3. if (Phonenumber=="1") then =  Phonenumber="1"
#
#4. if (Emailaddrsess=="1") then =  Emailaddrsess="1"
#
#5. if (Acct_name=="1") then =  Acct_name="1"  (Names Combination)
#
#step one:
#
#1. if (Referencenumber=="1") then --- 100% (system will stop automatically) - (display cif_id details)
#
#step two:
#
#if ((Dateofbirth=="1") AND (Acct_name=="1"))  then Dateofbirth_and_Acct_name = match - (display cif_id details)
#
#step three:
#
#if (Phonenumber=="1") then Phonenumber = match display (1-exist) - (display cif_id details)
#
#step four:
#
#if (Emailaddrsess=="1") then Emailaddrsess = match display (1-exist) - (display cif_id details)
#
#To display:
#cif_id
#firstname
#middlename
#lastname
#Referencenumber
#Dateofbirth
#Phonenumber
#Emailaddrsess
#
#Note:Then status for each 1/0
#1==> exist
#0==> Does Not Exist
#
#Stop/proceed status check: Stopproceedstatus=Y/N
#
#one:
#
#if (Referencenumber=="1") then Stopproceedstatus="Y"  (stop the check and display)
#
#two:
#
#if ((Dateofbirth=="1") AND (Acct_name=="1"))  then Stopproceedstatus="Y"
#
#three:
#
#if (Phonenumber=="1") then Stopproceedstatus="Y"
#
#four:
#
#if (Emailaddrsess=="1") then Stopproceedstatus="Y"
#
#existscript

sv_u = urhk_B2k_PrintRepos("BANCS")
print(sv_u)
TRACE ON
sv_r = REPEXISTS("STDWFS")
IF (sv_r == 0) THEN
        CREATEREP("STDWFS")
ENDIF
        sv_r = CLASSEXISTS("STDWFS", "GLBDATA")
IF (sv_r == 0) THEN
        CREATECLASS("STDWFS", "GLBDATA", 5)
ENDIF


