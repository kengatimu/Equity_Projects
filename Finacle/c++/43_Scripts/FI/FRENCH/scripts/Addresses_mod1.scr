					sv_j = sv_j + " (?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR,?SVAR, ?SVAR, ?SVAR, ?SVAR, ?SVAR,?SVAR, sysdate,?SVAR,?SVAR,?SVAR,?SVAR,?SVAR) "
					print(sv_j)
