# 27) Unverified / Value Account Transfer 
#-----------------------------------------------------------------------------------------------
sv_s = "COUNT|select count(*) FROM TBAADM.ADT, tbaadm.SMT,tbaadm.gam "
sv_s = sv_s + " WHERE ADT.bank_id = SMT.bank_id "
sv_s = sv_s + " AND ADT.bank_id = gam.bank_id "
sv_s = sv_s + " AND gam.acid=SMT.acid "
sv_s = sv_s + " AND gam.acid=ADT.acid "
sv_s = sv_s + " AND  gam.SCHM_CODE not in ('SB199','CA299') "
sv_s = sv_s + " AND ADT.init_sol_id = ?SVAR "
sv_s = sv_s + " AND ADT.bank_id = ?SVAR "
sv_s = sv_s + " AND SMT.ACCT_STATUS in ('D','I') "
sv_s = sv_s + " AND ADT.auth_id = '!' and ADT.FUNC_CODE <>'Z' AND adt.AUDIT_DATE>'01-jan-2019'  " 
PRINT(sv_s)
BANCS.INPARAM.BINDVARS = BANCS.STDIN.mySolId  + "|" + BANCS.STDIN.contextBankId
PRINT(BANCS.INPARAM.BINDVARS)
sv_u =  urhk_dbSelectWithBind(sv_s)
PRINT(sv_u)
IF(sv_u == 0) THEN
#{
              PRINT(BANCS.OUTPARAM.COUNT)
              IF (CINT(BANCS.OUTPARAM.COUNT) > 10000) THEN
              #{
                             PRINT(BANCS.OUTPARAM.COUNT)
