#---------------------------------------------------------------------------------
# 1) Validation for unverified images
#---------------------------------------------------------------------------------

sv_s = " COUNT| select count(1) from (select b.sol_id, activity , acctid, OCCUREDAT, b.user_id from  "
sv_s = sv_s + " (select    a.acctid, B.LASTACTIVITY activity ,    case when LASTACTIVITY ='ADD'  then to_date (cast (b.CREATEDDATE as date),'DD-MM-YY')  "
sv_s = sv_s + " else to_date (cast (b.MODIFIEDDATE as date),'DD-MM-YY')  end OCCUREDAT , case when LASTACTIVITY ='ADD'  then b.CREATEDBY  else  b.MODIFIEDBY  end user_id from SVSUSER.NSIGNOTHERINFO a,  "
sv_s = sv_s + " SVSUSER.NSIGNMAINTENANCE  b  where a.signid = b.signid  and  a.acctid is not null and a.acctid !=' '   and a.entityid = ?SVAR )a, "
sv_s = sv_s + " (select user_id , sol_id,home_bank_id  from tbaadm.upr where del_flg ='N')b where b.user_id =a.user_id and b.home_bank_id = ?SVAR and b.sol_id = ?SVAR and OCCUREDAT >'01-jan-2019' "
sv_s = sv_s + " union "
sv_s = sv_s + " select  b.sol_id,a.activity ,a.acctid ,a.OCCUREDAT, b.user_id from  "
sv_s = sv_s + " (select CUSTID acctid , a.LASTACTIVITY activity,   case when a.LASTACTIVITY ='ADD'  then to_date (cast (a.CREATEDDATE as date),'DD-MM-YY')   "
sv_s = sv_s + " else to_date (cast (a.MODIFIEDDATE as date),'DD-MM-YY')  end OCCUREDAT , case when b.LASTACTIVITY ='ADD'  then b.CREATEDBY  else  b.MODIFIEDBY  end user_id from SVSUSER.NSIGNCUSTINFO a,  "
sv_s = sv_s + " SVSUSER.NSIGNMAINTENANCE  b    where a.signid = b.signid and CUSTID is not null and CUSTID !=' ' )a, "
sv_s = sv_s + " (select user_id , sol_id,home_bank_id  from tbaadm.upr where del_flg ='N')b where b.user_id =a.user_id and b.home_bank_id =?SVAR  and b.sol_id =?SVAR  and OCCUREDAT >'01-jan-2019' ) "
PRINT(sv_s)
BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.mySolId
PRINT(BANCS.INPARAM.BINDVARS)
sv_u =  urhk_dbSelectWithBind(sv_s)
IF (sv_u == 0) THEN
#{
	IF (CINT(BANCS.OUTPARAM.COUNT) > 0) THEN
	#{
		PRINT(BANCS.OUTPARAM.COUNT)
		BANCS.OUTPUT.successOrFailure = "F"
		sv_u = urhk_getFileLocation("COM|images.com")
		sv_l = BANCS.OUTPARAM.fileLocation
		sv_t = sv_l + "images.com" + " " + BANCS.STDIN.mySolId + " " + BANCS.STDIN.contextBankId
		PRINT(sv_t)
		sv_u = SYSTEM(sv_t)
		PRINT(sv_u)
		sv_k = 1
	#}
	ENDIF
#}
ENDIF

#-----------------------------------------------------------------------------------------------
# 2) Unverified liens
#-----------------------------------------------------------------------------------------------
sv_s = "COUNT|SELECT COUNT(1) FROM TBAADM.ADT "
sv_s = sv_s + " WHERE ADT.init_sol_id = ?SVAR"
sv_s = sv_s + " AND ADT.table_name = 'ALT' "
sv_s = sv_s + " AND ADT.auth_id = '!' "
sv_s = sv_s + " AND ADT.bank_id = ?SVAR"
PRINT(sv_s)
BANCS.INPARAM.BINDVARS = BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId
PRINT(BANCS.INPARAM.BINDVARS)
sv_u =  urhk_dbSelectWithBind(sv_s)
IF(sv_u == 0) THEN
#{
	PRINT(BANCS.OUTPARAM.COUNT)
	IF (CINT(BANCS.OUTPARAM.COUNT) > 0) THEN
	#{
		PRINT(BANCS.OUTPARAM.COUNT)
		BANCS.OUTPUT.successOrFailure = "F"
		sv_s = urhk_getFileLocation("COM|liens.com")
		sv_l = BANCS.OUTPARAM.fileLocation
		sv_t = sv_l + "liens.com" + " " + BANCS.STDIN.mySolId + " " + BANCS.STDIN.contextBankId
		PRINT(sv_t)
		sv_u = SYSTEM(sv_t)
		sv_k = 1
	#}
	ENDIF
#}
ENDIF


#-----------------------------------------------------------------------------------------------
# 3) Unverified transfered accounts
#-----------------------------------------------------------------------------------------------
sv_s = "COUNT|SELECT COUNT(1) FROM TBAADM.ADT "
sv_s = sv_s + " WHERE ADT.init_sol_id = ?SVAR"
sv_s = sv_s + " AND ADT.table_name = 'ATT' "
sv_s = sv_s + " AND ADT.auth_id='!' AND ENTERER_ID not in ('SK04908','JN05794','CN01473','JI16825') "
sv_s = sv_s + " AND ADT.bank_id = ?SVAR"
PRINT(sv_s)
BANCS.INPARAM.BINDVARS = BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId
PRINT(BANCS.INPARAM.BINDVARS)
sv_u =  urhk_dbSelectWithBind(sv_s)
IF(sv_u == 0) THEN
#{ 
	PRINT(BANCS.OUTPARAM.COUNT)
	IF (CINT(BANCS.OUTPARAM.COUNT) > 0) THEN
	#{
		BANCS.INPUT.RET = "1"
		BANCS.OUTPUT.successOrFailure = "F"
		sv_s = urhk_getFileLocation("COM|trans.com")
		sv_l = BANCS.OUTPARAM.fileLocation
		sv_t = sv_l + "trans.com" + " " + BANCS.STDIN.mySolId + " " + BANCS.STDIN.contextBankId
		PRINT(sv_t)
		sv_u = SYSTEM(sv_t)
		sv_k = 1
	#}
	ENDIF
#}
ENDIF

