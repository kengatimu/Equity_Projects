ENDIF


IF((BANCS.STDIN.contextBankId == "55") OR (BANCS.STDIN.contextBankId == "XX")OR (BANCS.STDIN.contextBankId == "XX")) THEN
#{
	
	#-----------------------------------------------------------------------------------------------
