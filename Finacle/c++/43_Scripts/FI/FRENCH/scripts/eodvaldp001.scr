	sv_s = sv_s + " and g.ENTITY_CRE_FLG ='Y' and g.ACCT_CLS_FLG ='N'  and acct_opn_date=  trunc (sysdate) and schm_code not in('SB117','SB113','SB114') and g.sol_id= ?SVAR and "
	sv_s = sv_s + " g.foracid not in (SELECT b.ACCTID  FROM  SVSUSER.signcustinfo a,"
	sv_s = sv_s + " SVSUSER.signotherinfo b  where  a.SIGNID =b.SIGNID and ACCTID in (select g.foracid from tbaadm.gam g ,tbaadm.smt s where s.acct_status ='A'"
	sv_s = sv_s + " and g.acid =s.acid and g.bank_id =s.bank_id and g.schm_type in ('SBA','CAA') and g.bank_id = ?SVAR and g.ENTITY_CRE_FLG ='Y' and g.ACCT_CLS_FLG ='N'"
	sv_s = sv_s + " and acct_opn_date= trunc (sysdate) and schm_code not in('SB117','SB113','SB114') and g.sol_id= ?SVAR)) "
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId  + "|" + BANCS.STDIN.mySolId  + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.mySolId
