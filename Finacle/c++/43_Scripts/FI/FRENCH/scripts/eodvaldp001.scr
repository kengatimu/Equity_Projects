sv_s = "COUNT|SELECT COUNT(DISTINCT(ACID)) FROM TBAADM.ADT"
sv_s = sv_s + " WHERE ADT.init_sol_id = ?SVAR"
sv_s = sv_s + "AND ADT.table_name = 'LRS'"
