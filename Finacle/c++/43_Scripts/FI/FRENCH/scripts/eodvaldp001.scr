                             PRINT(sv_u)
                  CUST.DATA.errMsg = "UNVERIFIED DORMANT ACCOUNT MODIFICATION EXIST. Cant submit sol for ABH. To See/Print the report go to BackGround Menu"
        PRINT(CUST.DATA.errMsg)
        sv_u = system("echo '"+ CUST.DATA.errMsg +"' >> eodvalidation.log")
                             sv_k = 1
                             
              #}
              ENDIF
