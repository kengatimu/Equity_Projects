IF((BANCS.STDIN.contextBankId == "43")) THEN

	#-----------------------------------------------------------------------------------------------
	# 29) Unverified High Value Not Moved to CA299 SB199 
	#-----------------------------------------------------------------------------------------------
	sv_s = " COUNT| select count (*) from ( select sol_id, foracid, clr_bal_amt , schm_code, acct_status, acct_crncy_code,ACCT_STATUS_DATE,last_tran_date,  last_t_date, "
	sv_s = sv_s + " case when ACCT_STATUS_DATE>last_t_date then ACCT_STATUS_DATE  else   last_t_date  end Date_Auto_Mvt from (select sol_id , foracid, clr_bal_amt, schm_code , "
	sv_s = sv_s + " acct_crncy_code, acct_status, ACCT_STATUS_DATE,last_tran_date,   case when last_tran_date is null  then ACCT_STATUS_DATE  else   last_tran_date end last_t_date "
	sv_s = sv_s + " from tbaadm.gam, tbaadm.smt where gam.schm_type in ('CAA','SBA') and( "
	sv_s = sv_s + " (gam.schm_code not in ('SB199','CA299') and gam.clr_bal_amt >  ( case when schm_code='CA212' then  400000 when  schm_code!='CA212' then  2000000  end )  and acct_crncy_code =?SVAR) or "
	sv_s = sv_s + " (gam.schm_code  not in ('SB199','CA299') and gam.clr_bal_amt >(select   ( case when schm_code='CA212' then  400000 when  schm_code!='CA212' then  2000000  end ) /VAR_CRNCY_UNITS from tbaadm.rtl where FXD_CRNCY_CODE ='USD' "
	sv_s = sv_s + " and  VAR_CRNCY_CODE=?SVAR and RATECODE ='MEAN' and bank_id = ?SVAR) and acct_crncy_code ='USD') or "
	sv_s = sv_s + " (gam.schm_code  not in ('SB199','CA299') and gam.clr_bal_amt > (select   ( case when schm_code='CA212' then  400000 when  schm_code!='CA212' then  2000000  end ) /VAR_CRNCY_UNITS from tbaadm.rtl where FXD_CRNCY_CODE ='GBP' "
	sv_s = sv_s + " and  VAR_CRNCY_CODE=?SVAR and RATECODE ='MEAN' and bank_id =?SVAR) and acct_crncy_code ='GBP') or " 
	sv_s = sv_s + " (gam.schm_code  not in ('SB199','CA299') and gam.clr_bal_amt > (select   ( case when schm_code='CA212' then  400000 when  schm_code!='CA212' then  2000000  end ) /VAR_CRNCY_UNITS from tbaadm.rtl where FXD_CRNCY_CODE ='ZAR' "
	sv_s = sv_s + " and  VAR_CRNCY_CODE=?SVAR and RATECODE ='MEAN' and bank_id =?SVAR) and acct_crncy_code ='ZAR') or " 
	sv_s = sv_s + " (gam.schm_code  not in ('SB199','CA299') and gam.clr_bal_amt > (select   ( case when schm_code='CA212' then  400000 when  schm_code!='CA212' then  2000000  end ) /VAR_CRNCY_UNITS from tbaadm.rtl where FXD_CRNCY_CODE ='CAD' "
	sv_s = sv_s + " and  VAR_CRNCY_CODE=?SVAR and RATECODE ='MEAN' and bank_id =?SVAR) and acct_crncy_code ='CAD') or " 
	sv_s = sv_s + " (gam.schm_code  not in ('SB199','CA299') and gam.clr_bal_amt > (select   ( case when schm_code='CA212' then  400000 when  schm_code!='CA212' then  2000000  end ) *VAR_CRNCY_UNITS from tbaadm.rtl where FXD_CRNCY_CODE ='CNY' "
	sv_s = sv_s + " and  VAR_CRNCY_CODE=?SVAR and RATECODE ='MEAN' and bank_id =?SVAR) and acct_crncy_code ='CNY') or " 
	sv_s = sv_s + " (gam.schm_code  not in ('SB199','CA299') and gam.clr_bal_amt > (select   ( case when schm_code='CA212' then  400000 when  schm_code!='CA212' then  2000000  end ) /VAR_CRNCY_UNITS from tbaadm.rtl where FXD_CRNCY_CODE ='EUR' "
	sv_s = sv_s + "  and  VAR_CRNCY_CODE=?SVAR and RATECODE ='MEAN' and bank_id =?SVAR) and acct_crncy_code ='EUR')) "
	sv_s = sv_s + " and gam.bank_id =?SVAR  and smt.ACCT_STATUS='D' and smt.acid =gam.acid and smt.bank_id =gam.bank_id and sol_id =?SVAR  )) where DATE_AUTO_MVT < trunc (sysdate) "
	PRINT(sv_s)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.homeCrncyCode + "|" + BANCS.STDIN.homeCrncyCode  + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.homeCrncyCode  
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS   + "|" + BANCS.STDIN.contextBankId  + "|" + BANCS.STDIN.homeCrncyCode  + "|" + BANCS.STDIN.contextBankId
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS   + "|" + BANCS.STDIN.homeCrncyCode  + "|" + BANCS.STDIN.contextBankId  + "|" + BANCS.STDIN.homeCrncyCode 
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS   + "|" + BANCS.STDIN.contextBankId  + "|" + BANCS.STDIN.homeCrncyCode  + "|" + BANCS.STDIN.contextBankId
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS	 + "|" + BANCS.STDIN.contextBankId  + "|" + BANCS.STDIN.mySolId 
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_u =  urhk_dbSelectWithBind(sv_s)
	PRINT(sv_u)
	IF(sv_u == 0) THEN
	#{
		  PRINT(BANCS.OUTPARAM.COUNT)
		  IF (CINT(BANCS.OUTPARAM.COUNT) > 1000) THEN
		  #{
					PRINT(BANCS.OUTPARAM.COUNT)
					BANCS.OUTPUT.successOrFailure = "F"
					sv_s = urhk_getFileLocation("COM|highvaluetfr2.com")
					sv_l = BANCS.OUTPARAM.fileLocation
					PRINT(sv_l)
					sv_t = sv_l + "highvaluetfr2.com" + " " + BANCS.STDIN.mySolId + " " + BANCS.STDIN.contextBankId + " " + BANCS.STDIN.homeCrncyCode
					PRINT(sv_t)
					PRINT(sv_t)
					sv_u = SYSTEM(sv_t)
					PRINT(sv_u)
				CUST.DATA.errMsg = "HIGH VALUE ACCOUNTS NOT MOVED TO SB199 / CA299. Cant submit sol for ABH. To See/Print the report go to BackGround Menu"
			PRINT(CUST.DATA.errMsg)
			sv_u = system("echo '"+ CUST.DATA.errMsg +"' >> eodvalidation.log")
					sv_k = 1
						 
		  #}
		  ENDIF
	#}
	ENDIF


ENDIF





