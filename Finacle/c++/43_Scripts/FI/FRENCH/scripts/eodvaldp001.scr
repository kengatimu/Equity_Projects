#-----------------------------------------------------------------------------------------------
# 8) Unverified  Customer IDs
#-----------------------------------------------------------------------------------------------
sv_c = 0
sv_s = "COUNT | SELECT COUNT(1) FROM crmuser.accounts_mod a,crmuser.bizcenter b "
sv_s = sv_s + " where lastoperperformed = 'E' "
sv_s = sv_s + " and nvl(a.editedlocationid,a.createdlocationid) = b.bcid "
sv_s = sv_s + " and b.bccode = ?SVAR  and a.MAKERID != '426250'  "
sv_s = sv_s + " AND a.bank_id = ?SVAR"
PRINT(sv_s)
BANCS.INPARAM.BINDVARS = BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId
PRINT(BANCS.INPARAM.BINDVARS)
sv_u =  urhk_dbSelectWithBind(sv_s)
IF(sv_u == 0) THEN
#{
	PRINT(BANCS.OUTPARAM.COUNT)
	sv_c = sv_c + CINT(BANCS.OUTPARAM.COUNT)
#}
ENDIF
sv_s = "COUNT | SELECT COUNT(1) FROM crmuser.corporate_mod a,crmuser.bizcenter b "
sv_s = sv_s + " where lastoperperformed  = 'E'  "
sv_s = sv_s + " and nvl(a.editedlocationid,a.createdlocationid) = b.bcid "
sv_s = sv_s + " AND b.bccode = ?SVAR and a.BOCREATEDBY != '426250'  "
sv_s = sv_s + " AND a.bank_id = ?SVAR"
PRINT(sv_s)
BANCS.INPARAM.BINDVARS = BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId
