#-----------------------------------------------------------------------------------------------
# 5) Unverified closed accounts
#-----------------------------------------------------------------------------------------------
sv_s = "COUNT|SELECT COUNT(1) FROM TBAADM.ADT,tbaadm.gam "
sv_s = sv_s + " WHERE ADT.init_sol_id = ?SVAR"
sv_s = sv_s + " AND ADT.acid = GAM.acid "
sv_s = sv_s + " AND ADT.bank_id = GAM.bank_id "
sv_s = sv_s + " AND GAM.acct_cls_flg = 'N' "
sv_s = sv_s + " AND ADT.table_name = 'GAM' "
sv_s = sv_s + " AND ADT.auth_id = '!' "
sv_s = sv_s + " AND ADT.FUNC_CODE = 'Z' AND ADT.ENTERER_ID not in ('JN05794','SM01534','CN01473','SK04908','BJMS54')"
sv_s = sv_s + " AND ADT.bank_id = ?SVAR"
PRINT(sv_s)
BANCS.INPARAM.BINDVARS = BANCS.STDIN.mySolId + "|" + BANCS.STDIN.contextBankId
PRINT(BANCS.INPARAM.BINDVARS)
sv_u =  urhk_dbSelectWithBind(sv_s)
IF(sv_u == 0) THEN
#{ 
	PRINT(BANCS.OUTPARAM.COUNT)
	IF (CINT(BANCS.OUTPARAM.COUNT) > 0) THEN
	#{
		BANCS.INPUT.RET = "1"
		BANCS.OUTPUT.successOrFailure = "F"
		sv_s = urhk_getFileLocation("COM|closed.com")
		sv_l = BANCS.OUTPARAM.fileLocation
		sv_t = sv_l + "closed.com" + " " + BANCS.STDIN.mySolId + " " + BANCS.STDIN.contextBankId
		PRINT(sv_t)
		sv_u = SYSTEM(sv_t)
		sv_k = 1
	#}
	ENDIF
#}
ENDIF


