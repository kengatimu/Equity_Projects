IF (CUST.DATA.tranID!="") THEN
	sv_s ="ENTRY_DATE,TRAN_DATE,TRAN_ID,PART_TRAN_SRL_NUM,PART_TRAN_TYPE,TRAN_AMT,TRAN_PARTICULAR,TRAN_PARTICULAR_2,ref_num,tran_rmks,ENTRY_USER_ID,VALUE_DATE,TRAN_TYPE,PSTD_USER_ID,VFD_USER_ID,INSTRMNT_DATE,SOL_ID,ACCT_NAME,FORACID|"
	sv_s = sv_s + " select to_char(ENTRY_DATE,'hh24:mi:ss '),TRAN_DATE,TRAN_ID,PART_TRAN_SRL_NUM,PART_TRAN_TYPE,TRAN_AMT,TRAN_PARTICULAR,TRAN_PARTICULAR_2,ref_num,tran_rmks,ENTRY_USER_ID,VALUE_DATE,TRAN_TYPE,PSTD_USER_ID,VFD_USER_ID,INSTRMNT_DATE,d.SOL_ID, g.ACCT_NAME,g.FORACID from  TBAADM.dtd d ,tbaadm.gam g where   TRAN_ID =LPAD(?SVAR,9) "
	sv_s=  sv_s + " and TRAN_DATE =TO_CHAR(TO_DATE(?SVAR,'DD-MM-YYYY'), 'DD-MON-YYYY') and d.acid=g.acid and d.bank_id=g.bank_id and d.BANK_ID=?SVAR"
	BANCS.INPARAM.BINDVARS = BANCS.INPUT.tranID + "|" + CUST.DATA.tranDate + "|" + CUST.DATA.BankID
	print(BANCS.INPARAM.BINDVARS)
	print(sv_s)
ENDIF
IF (CUST.DATA.tranRRN!="") THEN
	sv_s ="ENTRY_DATE,TRAN_DATE,TRAN_ID,PART_TRAN_SRL_NUM,PART_TRAN_TYPE,TRAN_AMT,TRAN_PARTICULAR,TRAN_PARTICULAR_2,ref_num,tran_rmks,ENTRY_USER_ID,VALUE_DATE,TRAN_TYPE,PSTD_USER_ID,VFD_USER_ID,INSTRMNT_DATE,SOL_ID,ACCT_NAME,FORACID|"
	sv_s = sv_s + " select to_char(ENTRY_DATE,'hh24:mi:ss '),TRAN_DATE,TRAN_ID,PART_TRAN_SRL_NUM,PART_TRAN_TYPE,TRAN_AMT,TRAN_PARTICULAR,TRAN_PARTICULAR_2,ref_num,tran_rmks,ENTRY_USER_ID,VALUE_DATE,TRAN_TYPE,PSTD_USER_ID,VFD_USER_ID,INSTRMNT_DATE,d.SOL_ID, g.ACCT_NAME,g.FORACID from  TBAADM.dtd d ,tbaadm.gam g where d.REF_NUM=?SVAR "
	sv_s=  sv_s + " and TRAN_DATE =TO_CHAR(TO_DATE(?SVAR,'DD-MM-YYYY'), 'DD-MON-YYYY') and d.acid=g.acid and d.bank_id=g.bank_id and d.BANK_ID=?SVAR"
