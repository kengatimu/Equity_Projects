<--start
TRACE ON

####################################################################
#section      :creating new repository if required
#Description  :Checks for the existence of the repository CUST and
#              creates a new one by that name if it does not exist
#####################################################################

IF (REPEXISTS("CUST") == 0 ) THEN
#{
    CREATEREP("CUST")
    #}
ENDIF

############################################################################
#section      :creating new class if required
#Desscription :checks for the existence of the class DATA in the
#repository and create a new one if it does not exist
##############################################################################


IF (CLASSEXISTS("CUST","DATA") == 0) THEN
#{
    CREATECLASS("CUST","DATA",5)
#}
#ELSE
	#{
	#	DELETECLASS("CUST","DATA")
	#	CREATECLASS("CUST","DATA",5)}
	#ENDIF
#}
ENDIF

sv_a = urhk_b2k_printRepos("BANCS")

IF( (FIELDEXISTS(("BANCS").("INPUT").("tranID"))== 0) ) THEN
	CUST.DATA.tranID=""
	print(CUST.DATA.tranID)
ELSE
	CUST.DATA.tranID=BANCS.INPUT.tranID
	print(CUST.DATA.tranID)
ENDIF

IF( (FIELDEXISTS(("BANCS").("INPUT").("tranRRN"))== 0) ) THEN
	CUST.DATA.tranRRN=""
	print(CUST.DATA.tranRRN)
ELSE
	CUST.DATA.tranRRN=BANCS.INPUT.tranRRN
	print(CUST.DATA.tranRRN)
ENDIF

IF ((CUST.DATA.tranRRN=="") AND (CUST.DATA.tranID=="")) THEN
   CUST.DATA.errMsg="Kindly Supply Transaction ID/RRN"
   sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg) 
   GOTO End
ENDIF

IF( (FIELDEXISTS(("BANCS").("INPUT").("tranDate"))== 0) ) THEN
   CUST.DATA.errMsg="Kindly Supply Transaction Date"
   sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)  
   GOTO End
ENDIF


CUST.DATA.tranDate=BANCS.INPUT.tranDate
CUST.DATA.BankID=BANCS.STDIN.contextBankId



        ######################################################
	#Assigns the values to the variables as null initially
	######################################################

				CUST.DATA.TRAN_DATE = ""
				CUST.DATA.TRAN_ID = ""
