				sv_s = sv_s + " select to_char(ENTRY_DATE,'hh24:mi:ss '),TRAN_DATE,TRAN_ID,PART_TRAN_SRL_NUM,PART_TRAN_TYPE,TRAN_AMT,TRAN_PARTICULAR,TRAN_PARTICULAR_2,ref_num,tran_rmks,ENTRY_USER_ID,VALUE_DATE,TRAN_TYPE,PSTD_USER_ID,VFD_USER_ID,INSTRMNT_DATE,d.SOL_ID, g.ACCT_NAME,g.FORACID from  tbaadm.htd d ,tbaadm.gam g where   TRAN_ID =LPAD(?SVAR,9) "
