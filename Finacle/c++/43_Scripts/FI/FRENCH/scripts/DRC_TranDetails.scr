					         ########################################

                                            sv_c = urhk_dbCursorClose(sv_m)

                                                 BANCS.OUTPUT.ErrorMsg="Record Not Found"
					         sv_e=urhk_SetOrbOut("Error|"+BANCS.OUTPUT.ErrorMsg)
						 GOTO End
                                              #}
					    ELSE
					    #####################
                                            #Record found in htd
					    #####################
					     GOTO output
					    ENDIF
					     

                                         GOTO output
				    #}
                                ENDIF

				  

		   
	       ELSE
	           #####################
                   #Record found in dtd
		   #####################
		   GOTO output
               ENDIF
        #}

 ENDIF      

	


output:
	 WHILE(sv_n == 0)
			       #{
