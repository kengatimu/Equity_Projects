<--START
	# Script body goes here
	TRACE ON
	
	#==================================================================================================
	# Repository and Class Creation
	#==================================================================================================
	IF (REPEXISTS("CUST")== 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	IF (CLASSEXISTS("CUST","DATA") == 0) THEN
	#{
		CREATECLASS("CUST" , "DATA",5)
	#}
	ENDIF
	
	
	
	CUST.DATA.InOutIndctr = ""
CUST.DATA.pymntIndctr = ""
	CUST.DATA.currency = ""
	CUST.DATA.funcCode = ""
	CUST.DATA.errMsg = ""
	
	
	
	
	IF (FIELDEXISTS(BANCS.INPUT.funcCode)) THEN
	#{
		CUST.DATA.funcCode = BANCS.INPUT.funcCode
		PRINT(CUST.DATA.funcCode)
	#}
	ENDIF

	IF (FIELDEXISTS(BANCS.INPUT.trantype)) THEN
	#{
		CUST.DATA.trantype= BANCS.INPUT.trantype
		PRINT(CUST.DATA.trantype)
	#}
	ENDIF
	IF (FIELDEXISTS(BANCS.INPUT.solid)) THEN
	#{
		CUST.DATA.solid= BANCS.INPUT.solid
		PRINT(CUST.DATA.solid)
	#}
	ENDIF

	IF (FIELDEXISTS(BANCS.INPUT.paysysid)) THEN
	#{
		CUST.DATA.paysysid= BANCS.INPUT.paysysid
		PRINT(CUST.DATA.paysysid)
	#}
	ENDIF


	IF (FIELDEXISTS(BANCS.INPUT.Ecstranrefnum)) THEN
	#{
		CUST.DATA.Ecstranrefnum= BANCS.INPUT.Ecstranrefnum
		PRINT(CUST.DATA.Ecstranrefnum)
	#}
	ENDIF

	
	IF (FIELDEXISTS(BANCS.INPUT.InOutIndctr)) THEN
	#{
		CUST.DATA.InOutIndctr = BANCS.INPUT.InOutIndctr
		PRINT(CUST.DATA.InOutIndctr)
	#}
	ENDIF
IF (FIELDEXISTS(BANCS.INPUT.pymntIndctr)) THEN
	#{
		CUST.DATA.pymntIndctr = BANCS.INPUT.pymntIndctr
		PRINT(CUST.DATA.pymntIndctr)
	#}
	ENDIF
	
	
	IF (FIELDEXISTS(BANCS.INPUT.currency)) THEN
	#{
		CUST.DATA.currency = BANCS.INPUT.currency
		PRINT(CUST.DATA.currency)
		
		BANCS.INPARAM.BINDVARS = CUST.DATA.currency +"|"+ BANCS.STDIN.contextBankId
		sv_a = "count|SELECT COUNT(*) FROM TBAADM.CNC WHERE CRNCY_CODE = ?SVAR AND BANK_ID = ?SVAR AND ENTITY_CRE_FLG = 'Y' AND DEL_FLG = 'N'"
		
		sv_b = urhk_dbSelectWithBind(sv_a)
		PRINT(sv_b)
		IF (sv_b == 0) THEN
		#{
			sv_c = BANCS.OUTPARAM.count
			PRINT(sv_c)
			IF (CINT(sv_c) == 0) THEN
			#{
				CUST.DATA.errMsg = "Invalid Currency Code"
				sv_e = urhk_SetOrbErr(CUST.DATA.errMsg)
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	
	
	IF (CUST.DATA.funcCode == "A") THEN
	#{
		
		IF ((CUST.DATA.InOutIndctr != "") AND (CUST.DATA.currency != "") AND (CUST.DATA.pymntIndctr != "")) THEN
		#{
			BANCS.INPARAM.BINDVARS = CUST.DATA.currency +"|"+ CUST.DATA.InOutIndctr +"|"+ CUST.DATA.pymntIndctr +"|"+ BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_a = "count|select count(*) from custom.c_paypm where currency_code = ?SVAR AND inw_out_ind = ?SVAR AND rtgs_ach_ind = ?SVAR"
			sv_a = sv_a + " AND bank_id = ?SVAR AND DEL_FLG = 'N'"
			PRINT(sv_a)
			
			sv_b = urhk_dbSelectWithBind(sv_a)
			PRINT(sv_b)
			IF (sv_b == 0) THEN
			#{
				sv_c = BANCS.OUTPARAM.count
				PRINT(sv_c)
				
				IF (CINT(sv_c) != 0 ) THEN
				#{
					CUST.DATA.errMsg = "Record already added."
					sv_e = urhk_SetOrbErr(CUST.DATA.errMsg)
					GOTO ENDOFSCRIPT
					
				#}
				ENDIF
				
				#}
			ELSE
				#{
				CUST.DATA.errMsg = "Backend Error."
				sv_e = urhk_SetOrbErr(CUST.DATA.errMsg)
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
		
	#}
	ENDIF
	
	
	IF (CUST.DATA.funcCode == "M") THEN
	#{
		
		CALL("paydet_modifyGetData.scr")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF (CUST.DATA.funcCode == "V") THEN
	#{


	IF ((CUST.DATA.Ecstranrefnum!= "") AND (CUST.DATA.paysysid!= "") AND (CUST.DATA.trantype!= "")) THEN
		#{
		BANCS.INPARAM.BINDVARS = CUST.DATA.Ecstranrefnum+"|"+ CUST.DATA.paysysid+"|"+ CUST.DATA.trantype+"|"+ BANCS.STDIN.contextBankId 
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_a = "count|select count(*) from custom.ECS_TRAN where Ecstranrefnum = ?SVAR AND paysysid = ?SVAR AND trantype=?SVAR"
		sv_a = sv_a + " AND bank_id = ?SVAR AND DEL_FLG = 'N' and entity_cre_flg='Y'  "
			PRINT(sv_a)
			
			sv_b = urhk_dbSelectWithBind(sv_a)
			PRINT(sv_b)
			IF (sv_b == 0) THEN
			#{
				sv_c = BANCS.OUTPARAM.count
				PRINT(sv_c)
				
				IF (CINT(sv_c) != 0 ) THEN
				#{
					CUST.DATA.errMsg = "Record already verified."
					sv_e = urhk_SetOrbErr(CUST.DATA.errMsg)
					GOTO ENDOFSCRIPT
					
				#}
				ENDIF
				
			#}
			ENDIF
			
		#}
		ENDIF


		CALL("paydet_verifyGetData.scr")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	IF (CUST.DATA.funcCode == "D") THEN
	#{
		CALL("paydet_deleteGetData.scr")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF (CUST.DATA.funcCode == "I") THEN
	#{
		CALL("paydet_inquireGetData.scr")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	
	
	ENDOFSCRIPT:
		IF( CUST.DATA.errMsg == "") THEN
		#{
			sv_q=urhk_SetOrbOut("SuccessOrFailure|Y")
			PRINT(sv_q)
			
			IF (CUST.DATA.InOutIndctr == "I") THEN
			#{
				sv_e = "InOutIndctrD|Inward"
				PRINT(sv_e)
				sv_q=urhk_SetOrbOut(sv_e)
				PRINT(sv_q)
			#}
			ENDIF
			
			
			IF (CUST.DATA.InOutIndctr == "O") THEN
			#{
				sv_e = "InOutIndctrD|Outward"
				PRINT(sv_e)
				sv_q=urhk_SetOrbOut(sv_e)
				PRINT(sv_q)
			#}
			ENDIF
			IF (CUST.DATA.pymntIndctr == "A") THEN
			#{
				sv_e = "pymntIndctrD|ACH"
				PRINT(sv_e)
				sv_q=urhk_SetOrbOut(sv_e)
				PRINT(sv_q)
			#}
			ENDIF
			
			
			IF (CUST.DATA.pymntIndctr == "R") THEN
			#{
				sv_e = "pymntIndctrD|RTGS"
				PRINT(sv_e)
				sv_q=urhk_SetOrbOut(sv_e)
				PRINT(sv_q)
			#}
			ENDIF
			sv_e = "currencyD|" + CUST.DATA.currency
			PRINT(sv_e)
			sv_q=urhk_SetOrbOut(sv_e)
			PRINT(sv_q)
		#}
		ENDIF
		
		
		IF(CLASSEXISTS("CUST","DATA")!=0) THEN
		#{
			DELETECLASS("CUST","DATA")
		#}
		ENDIF
		IF(REPEXISTS("CUST")!=0) THEN
		#{
			DELETEREP("CUST")
		#}
		ENDIF
		EXITSCRIPT
		TRACE OFF
END-->
