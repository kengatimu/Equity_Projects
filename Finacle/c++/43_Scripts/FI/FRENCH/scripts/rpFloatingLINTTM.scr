#======================================================#
#Source Name                    :rpFloatingLINTTM.scr
#Menu                           :HBJE
#Batch Name			:LINTM
#Date                           :27-03-2023
#Description                    :To change the interest rates on Loans.
#Author                         :Ranjith Palani
#======================================================#
<--start
#trace on
	if(REPEXISTS("CUST") == 0)then
		CREATEREP("CUST")
	endif

	if(CLASSEXISTS("CUST","FINTTM") == 0)then
		CREATECLASS("CUST","FINTTM",5)
	endif

	CUST.FINTTM.funcCode	= "M"
	sv_a = "foracid,custPrefInt,acctPrefInt,chnlPrefInt,minInt,maxInt,negotiatedRate,startDate,endDate|"
	sv_a = sv_a + "	select gam.foracid,cust_dr_pref_pcnt,id_dr_pref_pcnt,chnl_dr_pref_pcnt,min_int_pcnt_dr,max_int_pcnt_dr,negotiated_rate_dr,"
	sv_a = sv_a + " to_char(start_date,'dd-mm-yyyy'),to_char(end_date,'dd-mm-yyyy')"
	sv_a = sv_a + " from custom.loan_interest_float a,tbaadm.gam where a.foracid=gam.foracid"
	sv_a = sv_a + " and a.bank_id=gam.bank_id and gam.schm_type='LAA' and a.entity_cre_flg!='N'"
	sv_a = sv_a + " and a.del_flg!='Y' and gam.entity_cre_flg!='N' and gam.del_flg!='Y' and a.float_interest_applied_status='N'"
	sv_a = sv_a + " and gam.acct_cls_flg!='Y' and gam.acct_cls_date is null and gam.bank_id=?SVAR and a.bank_id=?SVAR"
	sv_a = sv_a + " and exists(select 1 from tbaadm.lam where lam.acid=gam.acid and lam.bank_id=gam.bank_id and lam.payoff_flg!='Y' and lam.chrge_off_flg!='Y')"
	sv_a = sv_a + " and gam.sol_id in (select sol_id from tbaadm.sst where bank_id=?SVAR and set_id=?SVAR)"
	print(sv_a)
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId +"|"+ BANCS.STDIN.contextBankId +"|"+ BANCS.STDIN.contextBankId +"|"+ BANCS.STDIN.mySolId
	sv_a = urhk_dbCursorOpenWithBind(sv_a)
	print(sv_a)
	if(sv_a == 0)then
	#{
		CUST.FINTTM.curNum = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		sv_f = urhk_dbCursorFetch(CUST.FINTTM.curNum)
		print(sv_f)
		if(sv_f != 0)then
		#{
			sv_x = urhk_dbCursorClose(CUST.FINTTM.curNum)
			print(sv_x)
			exitscript
		#}
		endif
		while(sv_f == 0)
		#{

			CUST.FINTTM.foracid	= BANCS.OUTPARAM.foracid 
			CUST.FINTTM.custPrefInt	= BANCS.OUTPARAM.custPrefInt
			CUST.FINTTM.acctPrefInt	= BANCS.OUTPARAM.acctPrefInt 
			CUST.FINTTM.chnlPrefInt	= BANCS.OUTPARAM.chnlPrefInt 
			CUST.FINTTM.minInt	= BANCS.OUTPARAM.minInt 
			CUST.FINTTM.maxInt	= BANCS.OUTPARAM.maxInt 
			CUST.FINTTM.negotiatedRate	= BANCS.OUTPARAM.negotiatedRate 
			CUST.FINTTM.startDate	= BANCS.OUTPARAM.startDate 
			print(CUST.FINTTM.startDate)
			CUST.FINTTM.endDate	= BANCS.OUTPARAM.endDate 
			print(CUST.FINTTM.endDate)

			sv_i = urhk_SetUrhkInp("loanIntTblCrit.funcCode|" + CUST.FINTTM.funcCode)
			sv_i = urhk_SetUrhkInp("loanIntTblCrit.laAcct.foracid|" + CUST.FINTTM.foracid)
			sv_e = urhk_ExecSrv("SRV_FetchLoanIntTblDtl|retain_all_output = Y|same_user_verify = Y")
			print(sv_e)	
			sv_e = BANCS.OUTPARAM.successOrFailure
			print(sv_e)
			if(sv_e != "S")then
			#{
				print("SRV Exec Failed")
				callscriptifexist("ebsrvHandler.scr")
				goto nextrec
			#}
			endif

			sv_c = urhk_CopyOutToIn("")
			print(sv_c)

			sv_i = urhk_SetUrhkInp("loanIntTblDtlLL.<rec_0>.custPrefInt|" + CUST.FINTTM.custPrefInt)
			sv_i = urhk_SetUrhkInp("loanIntTblDtlLL.<rec_0>.acctPrefInt|" + CUST.FINTTM.acctPrefInt)
			sv_i = urhk_SetUrhkInp("loanIntTblDtlLL.<rec_0>.chnlPrefInt|" + CUST.FINTTM.chnlPrefInt)
			sv_i = urhk_SetUrhkInp("loanIntTblDtlLL.<rec_0>.minInt|" + CUST.FINTTM.minInt)
			sv_i = urhk_SetUrhkInp("loanIntTblDtlLL.<rec_0>.maxInt|" + CUST.FINTTM.maxInt)
			sv_i = urhk_SetUrhkInp("loanIntTblDtlLL.<rec_0>.negotiatedRate|" + CUST.FINTTM.negotiatedRate)
			sv_i = urhk_SetUrhkInp("loanIntTblDtlLL.<rec_0>.startDate|" + CUST.FINTTM.startDate)
			sv_i = urhk_SetUrhkInp("loanIntTblDtlLL.<rec_0>.endDate|" + CUST.FINTTM.endDate)

			#sv_e = urhk_ExecSrv("SRV_processLoanIntTblDtl|retain_all_output = Y|same_user_verify = Y")
			sv_e = urhk_ExecSrv("SRV_processLoanIntTblDtlAndVerify|retain_all_output = Y|same_user_verify = Y")
			print(sv_e)
			sv_e = BANCS.OUTPARAM.successOrFailure
			print(sv_e)
			if(sv_e != "S")then
			#{
				print("SRV Exec Failed")
				callscriptifexist("ebsrvHandler.scr")
				goto nextrec
			#}
			else
			#{
				print("SRV Exec Success")
				sv_u = "update custom.loan_interest_float set float_interest_applied_status='Y' where foracid=?SVAR and bank_id=?SVAR" 
				BANCS.INPARAM.BINDVARS = CUST.FINTTM.foracid +"|"+ BANCS.STDIN.contextBankId
				sv_u = urhk_dbSQLWithBind(sv_u)
				if(sv_u == 0)then
					sv_u = urhk_dbSQLWithBind("commit")
				else
					print("Commit Failed")
					goto nextrec
				endif
			#}
			endif

			nextrec:
			sv_f = urhk_dbCursorFetch(CUST.FINTTM.curNum)
		#}
		do
		sv_x = urhk_dbCursorClose(CUST.FINTTM.curNum)
	#}
	else
	#{
		print("Cursor Opened Failed")
		exitscript
	#}
	endif

exitscript
trace off
end-->
