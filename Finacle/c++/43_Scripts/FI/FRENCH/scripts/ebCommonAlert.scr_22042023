#------------------------------------------------------------------------------------------------
#  Name            : ebCommonAlert.scr 
#  Description     : Transaction Alerts 
#  Date            : 26-03-2020
#  Author          : Vino Palani
#  Menu Option     : NA
#  Srl. No         Date            Author               Description.
#  -------         ------          ------               ------------
#  1.0             26-03-2020      Vino Palani          Original Version
#-----------------------------------------------------------------------------------------------
<--start
#trace on
#Rep/Class


#sv_a=urhk_B2k_PrintRepos("MTT")
#PRINT(sv_a)

        if(repexists("EBSRV")==0)then
                createrep("EBSRV")
        endif
        if(repexists("CUST")==0)then
                createrep("CUST")
        endif
        if(classexists("EBSRV","GLBDATA")==0)then
                createclass("EBSRV","GLBDATA",5)
        endif
        if(classexists("CUST","ALERTS")==0)then
                createclass("CUST","ALERTS",5)
        endif

	EBSRV.GLBDATA.isLienYN = ""
        EBSRV.GLBDATA.comfil = ""
        EBSRV.GLBDATA.toAddr = ""
        EBSRV.GLBDATA.PartyName = "NA"
        EBSRV.GLBDATA.PartyLname = "NA"
        EBSRV.GLBDATA.PartyAcct = ""
        EBSRV.GLBDATA.tranparti = "NA"
	EBSRV.GLBDATA.mlYN = ""
	EBSRV.GLBDATA.drMYN = ""
	EBSRV.GLBDATA.crMYN = "" 
	EBSRV.GLBDATA.drMLt = 0 
	EBSRV.GLBDATA.crMLt = 0 
	EBSRV.GLBDATA.alMail = ""
	EBSRV.GLBDATA.sdnName =""
	CUST.ALERTS.Libelle=""

        sv_u = urhk_MTTS_PopulateInputDetails("")
        print(sv_u)
        if(sv_u == 0)then
                print(MTT.InputDetails.Argument1)
                CUST.ALERTS.AlertModule = MTT.InputDetails.Argument1
                CUST.ALERTS.tranParticular = MTT.InputDetails.Argument2
                CUST.ALERTS.tranRemarks = MTT.InputDetails.Argument3
                CUST.ALERTS.AcctNum = MTT.InputDetails.Argument4
                CUST.ALERTS.partTranType = MTT.InputDetails.Argument5
		CUST.ALERTS.partTranType1 = MTT.InputDetails.Argument5
                CUST.ALERTS.TranAmt = MTT.InputDetails.Argument6
		CUST.ALERTS.TranAmt1 = MTT.InputDetails.Argument6
                CUST.ALERTS.tranCrncyCode = MTT.InputDetails.Argument7
                CUST.ALERTS.TranId = MTT.InputDetails.Argument8
		CUST.ALERTS.PartTranSrlNum = MTT.InputDetails.Argument9
		Print (CUST.ALERTS.PartTranSrlNum)
		CUST.ALERTS.moduleId = MTT.InputDetails.Argument10
		Print (CUST.ALERTS.moduleId)
	else
                CUST.ALERTS.AlertModule = ""
                CUST.ALERTS.tranParticular = ""
                CUST.ALERTS.tranRemarks = ""
                CUST.ALERTS.AcctNum = ""
                CUST.ALERTS.partTranType = ""
                CUST.ALERTS.TranAmt = ""
		CUST.ALERTS.TranAmt1 = ""
		CUST.ALERTS.tranCrncyCode = ""
		CUST.ALERTS.TranId = ""
        endif
	

#Check if transaction Exist

	IF (CUST.ALERTS.TranId=="") then
		exitscript
	ENDIF

#Check Account if activated for sms

		CUST.ALERTS.EbcAlertcnt = "0"
		CUST.ALERTS.CAlertcnt = "0"
		
		sv_d = "pstCnt |select count(*) from custom.cust_alerts_tbl  where bank_id= ?SVAR and del_flg<>'Y' and entity_cre_flg='Y' and foracid=?SVAR " 
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.ALERTS.AcctNum   
		print(sv_d)
		print(BANCS.INPARAM.BINDVARS)
		sv_u = urhk_dbSelectWithBind(sv_d)
		if(sv_u==0)then
			CUST.ALERTS.CAlertcnt = BANCS.OUTPARAM.pstCnt
		else
			CUST.ALERTS.CAlertcnt = "0"
		endif		
		
		IF (CUST.ALERTS.CAlertcnt == 0 ) THEN			
			sv_s = "COUNT|SELECT COUNT(1)FROM TBAADM.FCFTT WHERE ACID = (SELECT ACID FROM TBAADM.GAM "
			sv_s = sv_s + " WHERE FORACID = ?SVAR  AND BANK_ID=?SVAR AND ENTITY_CRE_FLG = 'Y' AND DEL_FLG = 'N')"
			sv_s = sv_s + " AND (FREE_CODE_3 ='T' OR FREE_CODE_3 ='M') AND BANK_ID = ?SVAR AND ENTITY_CRE_FLG = 'Y' AND DEL_FLG = 'N'"
			BANCS.INPARAM.BINDVARS = CUST.ALERTS.AcctNum  + "|"+ BANCS.STDIN.contextBankId + "|"+ BANCS.STDIN.contextBankId
			sv_u =  urhk_dbSelectWithBind(sv_s)
			IF(sv_u == 0) THEN				
				CUST.ALERTS.EbcAlertcnt  = BANCS.OUTPARAM.COUNT
			ELSE
				CUST.ALERTS.EbcAlertcnt = "0"				
			ENDIF
		ENDIF
	
	print (CUST.ALERTS.EbcAlertcnt)
	print (CUST.ALERTS.CAlertcnt)

	IF  ((CUST.ALERTS.EbcAlertcnt == 0 )  AND  (CUST.ALERTS.CAlertcnt == 0)) THEN
		exitscript
	ENDIF

#Check Account if activated for sms


	print(BANCS.STDIN.sysDate)
		sv_r = urhk_b2k_sleep("25")
	print(BANCS.STDIN.sysDate)
	
	if(CUST.ALERTS.TranId=="")then
		exitscript
	else
		sv_d = "pstCnt|select count(*) "
		sv_d = sv_d + " from tbaadm.dtd where bank_id= ?SVAR "
		sv_d = sv_d + " and tran_id=lpad(?SVAR,9,' ') "
		sv_d = sv_d + " and tran_date=to_date(?SVAR,'DD-MM-RR') "
		sv_d = sv_d + " and pstd_flg='Y' "
		sv_d = sv_d + " and del_flg='N' "
		sv_d = sv_d + " and part_tran_type=?SVAR "
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.ALERTS.TranId + "|" + mid$(BANCS.STDIN.BODDate,0,10) + "|" + CUST.ALERTS.partTranType
		print(sv_d)
		print(BANCS.INPARAM.BINDVARS)
		sv_u = urhk_dbSelectWithBind(sv_d)
		if(sv_u==0)then
			CUST.ALERTS.pstCnt = BANCS.OUTPARAM.pstCnt
		else
			CUST.ALERTS.pstCnt = 0
		endif
	endif
	print(CUST.ALERTS.pstCnt)
	
	if(cdouble(CUST.ALERTS.pstCnt)<=0)then
		exitscript
	ELSE
		sv_d = "TRAN_PARTICULAR,TRAN_RMKS,TRAN_SUB_TYPE, TRAN_PARTICULAR_2 , REF_NUM, ENTRY_USER_ID |select TRAN_PARTICULAR,TRAN_RMKS,TRAN_SUB_TYPE, TRAN_PARTICULAR_2, REF_NUM ,ENTRY_USER_ID "
		sv_d = sv_d + " from tbaadm.dtd where bank_id= ?SVAR "
		sv_d = sv_d + " and tran_id=lpad(?SVAR,9,' ') "
		sv_d = sv_d + " and tran_date=to_date(?SVAR,'DD-MM-RR') "
		sv_d = sv_d + " and pstd_flg='Y' "
		sv_d = sv_d + " and del_flg='N' "
		sv_d = sv_d + " and part_tran_type=?SVAR and  PART_TRAN_SRL_NUM  =lpad(?SVAR,4,' ') "
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.ALERTS.TranId + "|" + mid$(BANCS.STDIN.BODDate,0,10) + "|" + CUST.ALERTS.partTranType + "|" + CUST.ALERTS.PartTranSrlNum
		print(sv_d)
		print(BANCS.INPARAM.BINDVARS)
		sv_u = urhk_dbSelectWithBind(sv_d)
		if(sv_u==0)then
			CUST.ALERTS.tranParticular = BANCS.OUTPARAM.TRAN_PARTICULAR
			CUST.ALERTS.tranRemarks = BANCS.OUTPARAM.TRAN_RMKS
			CUST.ALERTS.transubtype = BANCS.OUTPARAM.TRAN_SUB_TYPE

			CUST.ALERTS.tranRemks = BANCS.OUTPARAM.TRAN_RMKS
			CUST.ALERTS.ENTRY_USER_ID = BANCS.OUTPARAM.ENTRY_USER_ID
			CUST.ALERTS.TRAN_PART = TOUPPER(BANCS.OUTPARAM.TRAN_PARTICULAR)
		else
			CUST.ALERTS.pstCnt = 0
		endif
	
	endif

	if(fieldexists(CUST.ALERTS.AlertModule)==1)then
		if(CUST.ALERTS.AlertModule=="GEN")then
			if(CUST.ALERTS.tranParticular == "")then
				CUST.ALERTS.tranParticular = "NA"	
			endif
			sv_d = "tranParticular,tranRemarks| "
			sv_d = sv_d + " select replace(?SVAR,' ', '-'),replace(?SVAR,' ', '-') "
			sv_d = sv_d + " from dual "  
			print(sv_d)
			if(CUST.ALERTS.tranRemarks!="")then
				BANCS.INPARAM.BINDVARS = CUST.ALERTS.tranParticular + "|" + CUST.ALERTS.tranRemarks  
			else
				BANCS.INPARAM.BINDVARS = CUST.ALERTS.tranParticular + "|NA"
			endif
			print(BANCS.INPARAM.BINDVARS)
			sv_u = urhk_dbSelectWithBind(sv_d)
			if(sv_u==0)then
				EBSRV.GLBDATA.tranparti = BANCS.OUTPARAM.tranParticular
				EBSRV.GLBDATA.tranRemarks = BANCS.OUTPARAM.tranRemarks
			else
				EBSRV.GLBDATA.tranparti = "NA"
				EBSRV.GLBDATA.tranRemarks = "NA"
			endif			
			
			if(CUST.ALERTS.tranRemks == "")then
				CUST.ALERTS.tranRemks = "NANULL"	
			endif
			
			Print (CUST.ALERTS.tranRemks)
			print  (CUST.ALERTS.ENTRY_USER_ID)
			print  (CUST.ALERTS.TRAN_PART)

		endif
	else
		CUST.ALERTS.AlertModule =""
	endif
	
	
	if(CUST.ALERTS.AlertModule=="GEN")then
			
		sv_d = "pstCnt |select count(*) from custom.cust_alerts_tbl  where bank_id= ?SVAR and del_flg<>'Y' and entity_cre_flg='Y' and foracid=?SVAR " 
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.ALERTS.AcctNum 
		print(sv_d)
		print(BANCS.INPARAM.BINDVARS)
		sv_u = urhk_dbSelectWithBind(sv_d)
		if(sv_u==0)then
			CUST.ALERTS.Alertcnt = BANCS.OUTPARAM.pstCnt
		else
			CUST.ALERTS.Alertcnt = 0
		endif	


			IF (CUST.ALERTS.Alertcnt != "0") then				
				sv_s = "drMYN,drMLt,crMYN,crMLt,alMail,mobNo,SmsAlert|" 
				sv_s = sv_s + " select dr_alert_flg,dr_min_amount,cr_alert_flg,cr_min_amount,email_address, mobile_no,activation_status "
				sv_s = sv_s + " from custom.cust_alerts_tbl where bank_id=?SVAR "
				sv_s = sv_s + " and del_flg<>'Y' and entity_cre_flg='Y' and foracid=?SVAR "
				BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.ALERTS.AcctNum 
				print(BANCS.INPARAM.BINDVARS)
				print(sv_s)
				sv_u = urhk_dbSelectWithBind(sv_s)
				if(sv_u==0)then
					EBSRV.GLBDATA.drMYN = BANCS.OUTPARAM.drMYN
					EBSRV.GLBDATA.crMYN = BANCS.OUTPARAM.crMYN
					EBSRV.GLBDATA.drMLt = BANCS.OUTPARAM.drMLt
					EBSRV.GLBDATA.crMLt = BANCS.OUTPARAM.crMLt
					EBSRV.GLBDATA.alMail = BANCS.OUTPARAM.alMail
					EBSRV.GLBDATA.mobNo = BANCS.OUTPARAM.mobNo
					EBSRV.GLBDATA.SmsAlert = BANCS.OUTPARAM.SmsAlert

				else
					EBSRV.GLBDATA.drMYN = "" 
					EBSRV.GLBDATA.crMYN = "" 
					EBSRV.GLBDATA.drMLt = "" 
					EBSRV.GLBDATA.crMLt = "" 
					EBSRV.GLBDATA.alMail = "" 
					EBSRV.GLBDATA.mobNo = ""
					EBSRV.GLBDATA.SmsAlert = ""
				endif

				if((CUST.ALERTS.partTranType=="C") and (EBSRV.GLBDATA.crMYN!="Y"))then
					goto VAYU 
				endif

				print(CUST.ALERTS.partTranType)
				print(EBSRV.GLBDATA.crMYN)
				print(CUST.ALERTS.TranAmt)
				print(EBSRV.GLBDATA.crMLt)
				if((CUST.ALERTS.partTranType=="C") and (EBSRV.GLBDATA.crMYN=="Y") and (cdouble(EBSRV.GLBDATA.crMLt)<= cdouble(CUST.ALERTS.TranAmt)))then
					EBSRV.GLBDATA.mlYN = "Y" 
					EBSRV.GLBDATA.isLienYN = "N"
				endif
				
				if((CUST.ALERTS.partTranType=="D") and (EBSRV.GLBDATA.drMYN!="Y"))then
					goto VAYU 
				endif
				
				print(CUST.ALERTS.partTranType)
				print(EBSRV.GLBDATA.drMYN)
				print(CUST.ALERTS.TranAmt)
				print(EBSRV.GLBDATA.drMLt)
				if((CUST.ALERTS.partTranType=="D") and (EBSRV.GLBDATA.drMYN=="Y") and (cdouble(EBSRV.GLBDATA.drMLt)<= cdouble(CUST.ALERTS.TranAmt)))then
					EBSRV.GLBDATA.mlYN = "Y" 
					EBSRV.GLBDATA.isLienYN = "N"
				endif			
			ELSE
				sv_s = "COUNT|SELECT COUNT(1)FROM TBAADM.FCFTT WHERE ACID = (SELECT ACID FROM TBAADM.GAM "
				sv_s = sv_s + " WHERE FORACID = ?SVAR  AND BANK_ID=?SVAR AND ENTITY_CRE_FLG = 'Y' AND DEL_FLG = 'N')"
				sv_s = sv_s + " AND (FREE_CODE_3 ='T' OR FREE_CODE_3 ='M') AND BANK_ID = ?SVAR AND ENTITY_CRE_FLG = 'Y' AND DEL_FLG = 'N'"
				BANCS.INPARAM.BINDVARS = CUST.ALERTS.AcctNum  + "|"+ BANCS.STDIN.contextBankId + "|"+ BANCS.STDIN.contextBankId
				sv_u =  urhk_dbSelectWithBind(sv_s)
				IF(sv_u == 0) THEN
					PRINT(BANCS.OUTPARAM.COUNT)
					IF (CINT(BANCS.OUTPARAM.COUNT) > 0) THEN
						EBSRV.GLBDATA.SmsAlert = "Y"
						EBSRV.GLBDATA.mlYN = "Y" 
						EBSRV.GLBDATA.isLienYN = "N"
					ELSE
						EBSRV.GLBDATA.mlYN = "N" 
					ENDIF
				ENDIF
			ENDIF

			sv_s = "acid|SELECT ACID FROM TBAADM.GAM WHERE BANK_ID=?SVAR AND FORACID=?SVAR AND ENTITY_CRE_FLG = 'Y' AND DEL_FLG = 'N'"
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|"+ CUST.ALERTS.AcctNum
			sv_u =  urhk_dbSelectWithBind(sv_s)
			IF(sv_u == 0) THEN
				CUST.ALERTS.acid = BANCS.OUTPARAM.acid
				PRINT(CUST.ALERTS.acid)
			ENDIF
			
			sv_s = "PHONENO,trandate |select PHONENO, (select TO_CHAR(db_stat_date, 'DD-Mon-RRRR') from tbaadm.gct where bank_id= ?SVAR) as TRAN_DATE   "
			sv_s = sv_s + " from crmuser.phoneemail p ,tbaadm.gam where PHONEOREMAIL='PHONE' and gam.bank_id=p.bank_id AND p.ORGKEY=gam.cif_id "
			sv_s = sv_s + " AND PREFERREDFLAG='Y' AND gam.foracid= ?SVAR AND gam.bank_id= ?SVAR AND p.bank_id= ?SVAR AND rownum<2 "
			PRINT(sv_s)
			BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.ALERTS.AcctNum + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_u =  urhk_dbSelectWithBind(sv_s)
			IF(sv_u == 0) THEN
				EBSRV.GLBDATA.mobNo = BANCS.OUTPARAM.PHONENO
				CUST.ALERTS.trandate1 = BANCS.OUTPARAM.trandate			
			ELSE		
				EBSRV.GLBDATA.mobNo =""
				EBSRV.GLBDATA.SmsAlert ="N"
				goto VAYU	
			ENDIF

			EBSRV.GLBDATA.mobNo = Trim(EBSRV.GLBDATA.mobNo)
			If (EBSRV.GLBDATA.mobNo == "") then
				goto VAYU	
			ENDIF

			sv_d = "idO,idT| select substr(?SVAR,1,4),lpad(substr(?SVAR,-4),8,'X') from dual "
			BANCS.INPARAM.BINDVARS = CUST.ALERTS.AcctNum +"|"+ CUST.ALERTS.AcctNum
			sv_u = urhk_dbSelectWithBind(sv_d)
			if(sv_u==0)then
				EBSRV.GLBDATA.idO = BANCS.OUTPARAM.idO
				EBSRV.GLBDATA.idT = BANCS.OUTPARAM.idT
				EBSRV.GLBDATA.foracid = EBSRV.GLBDATA.idO +""+EBSRV.GLBDATA.idT
				print(EBSRV.GLBDATA.foracid)
			endif

	else
		EBSRV.GLBDATA.foracid = CUST.ALERTS.AcctNum 
		EBSRV.GLBDATA.mlYN = "Y"
		EBSRV.GLBDATA.isLienYN = "Y"
	endif

	print(EBSRV.GLBDATA.mlYN)
	Print(EBSRV.GLBDATA.SmsAlert)
	Print(EBSRV.GLBDATA.mobNo)
	
	if((EBSRV.GLBDATA.foracid !="") and (EBSRV.GLBDATA.mlYN=="Y"))then
	##{
		sv_u = urhk_getAcctDetailsInRepository(CUST.ALERTS.AcctNum)
		if(sv_u==0)then
			EBSRV.GLBDATA.CifId = BANCS.OUTPARAM.cifId
			EBSRV.GLBDATA.ActBal = BANCS.OUTPARAM.EffAvailableAmt
			EBSRV.GLBDATA.ActCrncy = BANCS.OUTPARAM.acctCrncyCode
			EBSRV.GLBDATA.schmCode = BANCS.OUTPARAM.schmCode
			EBSRV.GLBDATA.Lien = BANCS.OUTPARAM.lienAmt
			EBSRV.GLBDATA.Cbal = BANCS.OUTPARAM.clearBalance
		else
			EBSRV.GLBDATA.CifId = ""
			EBSRV.GLBDATA.ActBal = ""
			EBSRV.GLBDATA.ActCrncy =""
			EBSRV.GLBDATA.schmCode = ""
		endif		
		sv_s = "PartyName,PartyLname,PartySal | select  CASE WHEN cust_first_name IS NULL THEN cust_last_name ELSE cust_first_name END as first_name, "
		sv_s = sv_s + " cust_last_name,  DECODE (CUST_SEX,'M', 'MALE','F', 'FEMALE', 'X')  AS  CUST_SEX  "
		sv_s = sv_s + " from tbaadm.cmg where cif_id = ?SVAR and  bank_id= ?SVAR  "
		BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.CifId + "|" + BANCS.STDIN.contextBankId
		print(sv_s)
		print(BANCS.INPARAM.BINDVARS)
		sv_u = urhk_dbSelectWithBind(sv_s)
		if(sv_u == 0)then
				EBSRV.GLBDATA.PartyName    = BANCS.OUTPARAM.PartyName
				EBSRV.GLBDATA.PartyLname     = BANCS.OUTPARAM.PartyLname
				EBSRV.GLBDATA.PartySal     = BANCS.OUTPARAM.PartySal
		else
				EBSRV.GLBDATA.PartyName    = "NA"
				EBSRV.GLBDATA.PartyLname     = "NA"
				EBSRV.GLBDATA.PartySal = "NA"
		endif
		
		if(EBSRV.GLBDATA.PartyName == EBSRV.GLBDATA.PartyLname)then
			EBSRV.GLBDATA.PartyName = EBSRV.GLBDATA.PartyName
			EBSRV.GLBDATA.PartyLname = "."
		endif

		if(EBSRV.GLBDATA.PartySal == "MALE")then
			EBSRV.GLBDATA.PartySal = "CHER MONSIEUR"
		else 
			if(EBSRV.GLBDATA.PartySal == "FEMALE")then
				EBSRV.GLBDATA.PartySal = "CHERE MADAME"
			else 
				EBSRV.GLBDATA.PartySal = "CHER CLIENT"
			endif
		endif
		
		sv_s = " toAddr |select email from tbaadm.cemail where email_b2kid =?SVAR "
		sv_s = sv_s + " and preferredflag='Y' and rownum = 1 "
		print(sv_s)
		BANCS.INPARAM.BINDVARS = EBSRV.GLBDATA.CifId
		sv_u = urhk_dbSelectWithBind(sv_s)
		if(sv_u==0)then
			EBSRV.GLBDATA.toAddr = BANCS.OUTPARAM.toAddr
			#EBSRV.GLBDATA.toAddr = "NA"
			print(EBSRV.GLBDATA.toAddr)
		else
		       EBSRV.GLBDATA.toAddr = "NA"
		endif
		#---------SMS start Edwin
		if (BANCS.STDIN.contextBankId =="43") then	
			if (EBSRV.GLBDATA.SmsAlert =="Y") then

				print(EBSRV.GLBDATA.mobNo)
				CUST.ALERTS.TranAmt = trim(CUST.ALERTS.TranAmt)
				print(CUST.ALERTS.TranAmt)
				EBSRV.GLBDATA.ActBal = trim(EBSRV.GLBDATA.ActBal)
				print(EBSRV.GLBDATA.ActBal)
				EBSRV.GLBDATA.Cbal = trim(EBSRV.GLBDATA.Cbal)
				print(EBSRV.GLBDATA.Cbal)
				EBSRV.GLBDATA.Lien = trim(EBSRV.GLBDATA.Lien)
				print(EBSRV.GLBDATA.Lien)
				print(BANCS.STDIN.sysDate)
				CUST.ALERTS.Date = Mid$(BANCS.STDIN.sysDate,0,10)	
				print(CUST.ALERTS.Date)
				CUST.ALERTS.Time = Mid$(BANCS.STDIN.sysDate,11,19)
				print(CUST.ALERTS.Time)
				sv_u = "drcTime | SELECT TO_CHAR(SYSDATE-2/24, 'HH24:MI') FROM  dual"
				sv_d = urhk_dbSelectWithBind(sv_u)
				
				if(sv_d==0)then
					CUST.ALERTS.Time = BANCS.OUTPARAM.drcTime
				endif				

				if(fieldexists(CUST.ALERTS.transubtype)==1)then			
					IF (( CUST.ALERTS.transubtype =="NR")  OR  (CUST.ALERTS.transubtype =="NP")  ) then				
							lv_f = "sdnName | select CONCAT( upper (substr (name ,0,1)), lower (substr (name ,2,100)))  from custom.cust_tm where bank_id=?SVAR and tran_id=?SVAR and tran_date=to_date(?SVAR,'DD-MM-RR') "
							BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.ALERTS.TranId + "|" + mid$(BANCS.STDIN.BODDate,0,10) 
							print(lv_f)
							print(BANCS.INPARAM.BINDVARS)
							lv_w = urhk_dbSelectWithBind(lv_f)
							if(lv_w ==0)then
								EBSRV.GLBDATA.sdnName = BANCS.OUTPARAM.sdnName
							else
								EBSRV.GLBDATA.sdnName = ""
							endif	
						
						CUST.ALERTS.Libelle = CUST.ALERTS.tranParticular + "."
						IF ( CUST.ALERTS.transubtype =="NR")  THEN
							CUST.ALERTS.partTranType = "credite" 
