	##################################################################################################
	# istisna uei transaction - both debit  and credit
	##################################################################################################
	IF(MTT.InputDetails.ueiApplFlg == "Y") THEN
	#{
		sv_y = CDOUBLE(MTT.InputDetails.ueiAdjAmt)
		IF (sv_y!=0) THEN
		#{
			print(sv_y)
			# First debit to loan/ LIA
			IF(MTT.InputDetails.intRouteFlg == "O") THEN
			#{
				MTT.PartTranDetails.Account=MTT.InputDetails.loanIntAcct
				MTT.PartTranDetails.ACPARTB2kId=MTT.InputDetails.loanAcct
				MTT.PartTranDetails.ACPARTB2kType="ACCNT"
				#}
			ELSE
				#{
				MTT.PartTranDetails.Account=MTT.InputDetails.loanAcct
			#}
			ENDIF
			print(MTT.InputDetails.loanIntAcct)
			print(MTT.InputDetails.loanAcct)
			MTT.PartTranDetails.RefCurrency=MTT.InputDetails.loanAcctCrncy
			MTT.PartTranDetails.RateCode = ""
			IF (sv_y >0)THEN
			#{
				MTT.PartTranDetails.Particulars=MTT.InputDetails.loanAcct + " UEI Amount Adjustment Increase "
				#}
			ELSE
				#{
				MTT.PartTranDetails.Particulars=MTT.InputDetails.loanAcct + " UEI Amount Adjustment Decrease"
			#}
			ENDIF
			
			# Call to common script to modify tran particulars if script is present
			MTT.PartTranDetails.ScriptEventType = "LARET"
			sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
			IF (sv_m == 0) THEN
			#{
				call("getMTTTranPart.scr")
			#}
			ENDIF
			
			MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
			print(MTT.PartTranDetails.ValueDate)
			MTT.PartTranDetails.Remarks="UEI adjustment entry during rescheduling "
			MTT.PartTranDetails.RefAmount=-(sv_y)
			MTT.PartTranDetails.Consolidate="N"
			MTT.PartTranDetails.TranIdentifier="rschdl"
			MTT.PartTranDetails.PTranBusinessType="LOANS"
			MTT.LAAddnlDetails.LoanAcctId = MTT.InputDetails.loanAcct
			MTT.LAAddnlDetails.DemandFlowId = MTT.InputDetails.normalLoanFlowId
			MTT.LAAddnlDetails.OriginOfTran = "RSCHDL"
			MTT.LAAddnlDetails.raiseDemandFlg="N"
			
			sv_z = urhk_MTTS_DefineLoanPartTran("UEI_IST_INT_DR")
			print (sv_z)
			
			# second credit uei placeholder account
			MTT.PartTranDetails.Account=MTT.InputDetails.ueiIntSrcAcct
			MTT.PartTranDetails.ACPARTB2kId=MTT.InputDetails.loanAcct
			MTT.PartTranDetails.RefCurrency=MTT.InputDetails.loanAcctCrncy
			MTT.PartTranDetails.RateCode = ""
			print(MTT.PartTranDetails.Account)
			print(MTT.InputDetails.loanAcct)
			IF (sv_y >0)THEN
			#{
				print("sv_y is +ve")
				MTT.PartTranDetails.Particulars=MTT.InputDetails.loanAcct + " UEI Amount Adjustment Increase "
				#}
			ELSE
				#{
				print("sv_y is -ve")
				MTT.PartTranDetails.Particulars=MTT.InputDetails.loanAcct + " UEI Amount Adjustment Decrease"
			#}
			ENDIF
			
			# Call to common script to modify tran particulars if script is present
			MTT.PartTranDetails.ScriptEventType = "LARET"
			sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
			IF (sv_m == 0) THEN
			#{
				call("getMTTTranPart.scr")
			#}
			ENDIF
			
			MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
			MTT.PartTranDetails.Remarks="UEI adjustment entry during rescheduling "
			MTT.PartTranDetails.RefAmount=sv_y
			MTT.PartTranDetails.Consolidate="N"
			MTT.PartTranDetails.TranIdentifier="rschdl"
			MTT.PartTranDetails.PTranBusinessType="LOANS"
			
			sv_z = urhk_MTTS_DefineLoanPartTran("UEI_IST_INT_CR")
			print (sv_z)
			
		#}
		ENDIF
	#}
	ENDIF
	#new Code Added Ends from Fin1012
	##################################################################################################
	#    All Rescheduling part trans end here. From now on all trans are charge parttrans.
	##################################################################################################
	
	sv_r = urhk_MTTS_PopulateInputDetails("")
	#print(sv_z)
	IF(sv_r >= 1) THEN
	#{
		sv_z = urhk_MTTS_EndDefinition("")
		#print(sv_z)
		exitscript
	#}
	ENDIF
	
	
	#PART TRAN 1
	#Now let us debit the COllection account for total collection amount
	sv_l = CDOUBLE(MTT.InputDetails.totChrgAmtCollFromSrc)
	IF(sv_l == 0) THEN
	#{
		sv_z = urhk_MTTS_EndDefinition("")
		#print(sv_z)
		exitscript
	#}
	ENDIF
	
	
	###############################################################################
	# Debit Source Account for the amount that was collected from it against
	# Reschedule Charges
	###############################################################################
	sv_m=MTT.InputDetails.chargeCreditCrncy
	sv_g=MTT.InputDetails.chrgCollSrcCrncy
	sv_l = CDOUBLE(MTT.InputDetails.totChrgAmtCollFromSrc)
	MTT.PartTranDetails.Account=MTT.InputDetails.chrgCollSrcAcct
	MTT.PartTranDetails.ACPARTB2kId=MTT.InputDetails.loanAcct
	MTT.PartTranDetails.ACPARTB2kType="ACCNT"
	#print(MTT.PartTranDetails.Account)
	MTT.PartTranDetails.RefAmount=-sv_l
	#print(MTT.PartTranDetails.RefAmount)
	MTT.PartTranDetails.RefCurrency=MTT.InputDetails.chrgCollSrcCrncy
	
	
	MTT.PartTranDetails.Particulars=MTT.InputDetails.loanAcct + "- Rescheduling Charges Collection"
	
	# Call to common script to modify tran particulars if script is present
	MTT.PartTranDetails.ScriptEventType = "LARET"
	sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
	IF (sv_m == 0) THEN
	#{
		call("getMTTTranPart.scr")
	#}
	ENDIF
	
	
	IF(MTT.InputDetails.chrgSrcOAPSchmFlg != "Y") THEN
	#{
		MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
	#}
	ENDIF
	
	MTT.PartTranDetails.Remarks="Debit Charge Collection Source Account"
	MTT.PartTranDetails.Consolidate="N"
	MTT.PartTranDetails.TranIdentifier="rschdl"
	MTT.PartTranDetails.PTranBusinessType="LOANS"
	
	IF(MTT.InputDetails.chrgSrcOAPSchmFlg == "Y") THEN
	#{
		
		#print(MTT.InputDetails.chrgSrcOAPRefNum)
		#print(sv_l)
		#print(MTT.InputDetails.chrgSrcOAPTranId)
		#print(MTT.InputDetails.chrgSrcOAPTranDate)
		#print(MTT.InputDetails.chrgSrcOAPTranSrlNum)
		
		
		MTT.PartTranDetails.Refnum=MTT.InputDetails.chrgSrcOAPRefNum
		IF(sv_l < 0 ) THEN
		#{
			sv_l = -(sv_l)
		#}
		ENDIF
		MTT.OAPAddnlDetails.OffsetAmount = sv_l
		MTT.OAPAddnlDetails.OrgTranID = MTT.InputDetails.chrgSrcOAPTranId
		MTT.OAPAddnlDetails.OrgTranDate = MTT.InputDetails.chrgSrcOAPTranDate
		MTT.OAPAddnlDetails.OrgPartTran = MTT.InputDetails.chrgSrcOAPTranSrlNum
	#}
	ENDIF
	sv_z = urhk_MTTS_DefineLoanPartTran("CHARGE COLLECTION")
	#print(sv_z)
	
	
	#	x-----------------------------------------------------------x
	#	|           Charges Parking Acct Credit			 	     	|
	#	x-----------------------------------------------------------x
	
	sv_m=MTT.InputDetails.chargeCreditCrncy
	sv_g=MTT.InputDetails.chrgCollSrcCrncy
	
	IF ((MTT.InputDetails.chrgCollSrcCrncy != MTT.InputDetails.chargeCreditCrncy) AND (MTT.InputDetails.chrgCollSrcCrncy != "" ) AND (sv_l != 0 )) THEN
	#{
		MTT.PartTranDetails.Account = MTT.InputDetails.consolAcctForChrgs
		#print( MTT.InputDetails.consolAcctForChrgs)
		MTT.PartTranDetails.RefAmount = sv_l
		#print(MTT.PartTranDetails.RefAmount)
		MTT.PartTranDetails.RefCurrency = MTT.InputDetails.chrgCollSrcCrncy
		#print(MTT.PartTranDetails.RefCurrency)
		MTT.PartTranDetails.Particulars = "Parking Account Credit for Loan Rescheduling Fee Collection"
		
		# Call to common script to modify tran particulars if script is present
		MTT.PartTranDetails.ScriptEventType = "LARET"
		sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
		IF (sv_m == 0) THEN
		#{
			call("getMTTTranPart.scr")
		#}
		ENDIF
		
		MTT.PartTranDetails.Consolidate = "Y"
		MTT.PartTranDetails.RateCode = MTT.InputDetails.chrgRateCode
		MTT.PartTranDetails.Rate = MTT.InputDetails.chrgRate
		MTT.PartTranDetails.TreaRate = MTT.InputDetails.chrgTreaRate
		MTT.PartTranDetails.TreaRefNum = MTT.InputDetails.chrgTreaRefNum
		
		#print(MTT.PartTranDetails.RateCode)
		#print(MTT.PartTranDetails.Rate)
		#print(MTT.PartTranDetails.TreaRate)
		#print(MTT.PartTranDetails.TreaRefNum)
		
		MTT.PartTranDetails.TranIdentifier="rschdl"
		MTT.PartTranDetails.PTranBusinessType="LOANS"
		
		#print(MTT.PartTranDetails.RefAmount)
		#print(MTT.PartTranDetails.RefCurrency)
		sv_z = urhk_MTTS_DefineLoanPartTran("FEEPARKCR")
		#print(sv_z)
		
		# 			Calling B2K Convert Amt to find out how much to Debit the Parking Acct
		# 			and the subsequent Charge Credits .
		
		BANCS.INPARAM.InputAmount=sv_l
		BANCS.INPARAM.FromCurrency=MTT.InputDetails.chrgCollSrcCrncy
		#print(BANCS.INPARAM.FromCurrency)
		BANCS.INPARAM.ToCurrency=MTT.InputDetails.chargeCreditCrncy
		#print(BANCS.INPARAM.ToCurrency)
		BANCS.INPARAM.RateCode=MTT.InputDetails.chrgRateCode
		BANCS.INPARAM.Rate=MTT.InputDetails.chrgRate
		sv_z=urhk_B2k_ConvertAmount("")
		#print(sv_z)
		sv_x= CDOUBLE(BANCS.OUTPARAM.OutputAmount)
		#print(sv_x)
		
		
		#	x-----------------------------------------------------------x
		#	|           Charges Parking Acct Debit 			 	        |
		#	x-----------------------------------------------------------x
		
		MTT.PartTranDetails.Account=MTT.InputDetails.consolAcctForChrgs
		#print(MTT.PartTranDetails.Account )
		MTT.PartTranDetails.RefAmount=-sv_x
		#print(MTT.PartTranDetails.RefAmount)
		MTT.PartTranDetails.RefCurrency=MTT.InputDetails.chargeCreditCrncy
		#print( MTT.PartTranDetails.RefCurrency)
		MTT.PartTranDetails.RateCode = ""
		MTT.PartTranDetails.Particulars = "Parking Account Debit for Loan Rescheduling Fee Collection"
		
		# Call to common script to modify tran particulars if script is present
		MTT.PartTranDetails.ScriptEventType = "LARET"
		sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
		IF (sv_m == 0) THEN
		#{
			call("getMTTTranPart.scr")
		#}
		ENDIF
		IF (MTT.PartTranDetails.RefCurrency != BANCS.STDIN.homeCrncyCode) THEN
		#{
			sv_s = "intRateCode|SELECT ds_rate_code "
			sv_s = sv_s + " FROM tbaadm.LAM"
			sv_s = sv_s + " WHERE acid =(SELECT acid FROM tbaadm.GAM where foracid = ?SVAR  AND GAM.bank_id = ?SVAR)"
			sv_s = sv_s + " AND LAM.bank_id = ?SVAR"
			BANCS.INPARAM.BINDVARS = MTT.InputDetails.loanAcct+ "|" +BANCS.STDIN.contextBankId+ "|" +BANCS.STDIN.contextBankId
			print(sv_s)
			sv_d = urhk_dbselectWithBind(sv_s)
			print(sv_d)
			MTT.PartTranDetails.RateCode= BANCS.OUTPARAM.intRateCode
		#}
		ENDIF
		MTT.PartTranDetails.Consolidate="N"
		MTT.PartTranDetails.TranIdentifier="rschdl"
		MTT.PartTranDetails.PTranBusinessType="LOANS"
		sv_z = urhk_MTTS_DefineLoanPartTran("FEEPARKDR")
		#print(sv_z)
	#}
	ENDIF
	#}
	
	
	###############################################################################
	# First Charge transaction. Rest of the transactions will be done in a loop
	# The first transaction is seperate to accomadate the parking account also
	# in case charge and loan account currencies are different
	#
	# Inputs :-   MTT.InputDetails.chargeCreditAmt       :- Charge amount
	#             MTT.InputDetails.chargeCreditAccount   :- Charge account at pttm
	#             MTT.InputDetails.chargeCreditCrncy     :- Charge currency
	#             MTT.InputDetails.valueDate             :- Value Date
	#             MTT.InputDetails.sysCalcChrgAmt        :- System calculated charge amount
	#             MTT.InputDetails.loanAcct              :- Used to populate cxl target acid
	#                                                       used in reversal
	###############################################################################
	
	#Now we will put the transaction to charge account
	sv_l=CDOUBLE(MTT.InputDetails.chargeCreditAmt)
	#
	MTT.PartTranDetails.Account=MTT.InputDetails.chargeCreditAccount
	MTT.PartTranDetails.ACPARTB2kId=MTT.InputDetails.loanAcct
	MTT.PartTranDetails.ACPARTB2kType="ACCNT"
	#print(MTT.PartTranDetails.Account)
	MTT.PartTranDetails.RefAmount=sv_l
	#print(MTT.PartTranDetails.RefAmount)
	MTT.PartTranDetails.RefCurrency=MTT.InputDetails.chargeCreditCrncy
	MTT.PartTranDetails.RateCode = ""
	MTT.PartTranDetails.Particulars=MTT.InputDetails.loanAcct+" - Fee Collection during Rescheduling"
	
	# Call to common script to modify tran particulars if script is present
	MTT.PartTranDetails.ScriptEventType = "LARET"
	sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
	IF (sv_m == 0) THEN
	#{
		call("getMTTTranPart.scr")
	#}
	ENDIF
	
	IF (MTT.PartTranDetails.RefCurrency != BANCS.STDIN.homeCrncyCode) THEN
	#{
		sv_s = "intRateCode|SELECT ds_rate_code "
		sv_s = sv_s + " FROM tbaadm.LAM"
		sv_s = sv_s + " WHERE acid =(SELECT acid FROM tbaadm.GAM where foracid = ?SVAR  AND GAM.bank_id = ?SVAR)"
		sv_s = sv_s + " AND LAM.bank_id = ?SVAR"
		BANCS.INPARAM.BINDVARS = MTT.InputDetails.loanAcct+ "|" +BANCS.STDIN.contextBankId+ "|" +BANCS.STDIN.contextBankId
		print(sv_s)
		sv_d = urhk_dbselectWithBind(sv_s)
		print(sv_d)
		MTT.PartTranDetails.RateCode= BANCS.OUTPARAM.intRateCode
	#}
	ENDIF
	
	MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
	MTT.PartTranDetails.Consolidate="N"
	MTT.PartTranDetails.TranIdentifier="rschdl"
	MTT.PartTranDetails.PTranBusinessType="LOANS"
	
	MTT.ChargeDetails.EventType = MTT.InputDetails.eventType
	MTT.ChargeDetails.EventId = MTT.InputDetails.eventId
	MTT.ChargeDetails.CompB2kId = MTT.InputDetails.CompB2kId
	
	sv_x = CDOUBLE(MTT.InputDetails.sysCalcChrgAmt)
	MTT.ChargeDetails.CalculatedAmount = sv_x
	MTT.ChargeDetails.ActualAmount = sv_l
	MTT.ChargeDetails.CollectionCrncy = MTT.InputDetails.chargeCreditCrncy
	MTT.ChargeDetails.ChargeCifId = MTT.InputDetails.chargeCifId
	MTT.ChargeDetails.TargetAcctId = MTT.InputDetails.loanAcct
	
	IF (MTT.ChargeDetails.EventType == "LNKED") THEN
	#{
		sv_j = MTT.InputDetails.loanAcct+" "+LTRIM(RTRIM(MID$(MTT.InputDetails.tranParticulars,0,32)))
		MTT.PartTranDetails.Particulars=sv_j
	#}
	ENDIF
	sv_z = urhk_MTTS_DefineChargePartTran("FEECR")
	#print(sv_z)
	
	
	###########################################################################################
	# Part Tran  .All charge credit transactions are done in a loop , because the number of
	# part trans is not known . All charge collections have to be in single currency
	#
	# Inputs :-   MTT.InputDetails.chargeCreditAmt       :- Charge amount
	#             MTT.InputDetails.chargeCreditAccount   :- Charge account at pttm
	#             MTT.InputDetails.chargeCreditCrncy     :- Charge currency
	#             MTT.InputDetails.valueDate             :- Value Date
	#             MTT.InputDetails.sysCalcChrgAmt        :- System calculated charge amount
	#             MTT.InputDetails.loanAcct              :- Used to populate cxl target acid
	#                                                       used in reversal
	###########################################################################################
	
	sv_r = urhk_MTTS_PopulateInputDetails("")
	#print(sv_z)
	#now we will have to go in a while loop for next records
	WHILE (sv_r < 1)
	#{
		sv_l = CDOUBLE(MTT.InputDetails.chargeCreditAmt)
		MTT.PartTranDetails.Account=MTT.InputDetails.chargeCreditAccount
		MTT.PartTranDetails.ACPARTB2kId=MTT.InputDetails.loanAcct
		MTT.PartTranDetails.ACPARTB2kType="ACCNT"
		#print(MTT.PartTranDetails.Account)
		MTT.PartTranDetails.RefAmount=sv_l
		#print(MTT.PartTranDetails.RefAmount)
		MTT.PartTranDetails.RefCurrency=MTT.InputDetails.chargeCreditCrncy
		MTT.PartTranDetails.RateCode = ""
		MTT.PartTranDetails.Particulars=MTT.InputDetails.loanAcct+" - Fee Collection during Rescheduling"
		
		# Call to common script to modify tran particulars if script is present
		MTT.PartTranDetails.ScriptEventType = "LARET"
		sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
		IF (sv_m == 0) THEN
		#{
			call("getMTTTranPart.scr")
		#}
		ENDIF
		
		IF (MTT.PartTranDetails.RefCurrency != BANCS.STDIN.homeCrncyCode) THEN
		#{
			sv_s = "intRateCode|SELECT ds_rate_code "
			sv_s = sv_s + " FROM tbaadm.LAM"
			sv_s = sv_s + " WHERE acid =(SELECT acid FROM tbaadm.GAM where foracid = ?SVAR  AND GAM.bank_id = ?SVAR)"
			sv_s = sv_s + " AND LAM.bank_id = ?SVAR"
			BANCS.INPARAM.BINDVARS = MTT.InputDetails.loanAcct+ "|" +BANCS.STDIN.contextBankId+ "|" +BANCS.STDIN.contextBankId
			print(sv_s)
			sv_d = urhk_dbselectWithBind(sv_s)
			print(sv_d)
			MTT.PartTranDetails.RateCode= BANCS.OUTPARAM.intRateCode
		#}
		ENDIF
		
		MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
		MTT.PartTranDetails.Consolidate="N"
		MTT.PartTranDetails.TranIdentifier="rschdl"
		MTT.PartTranDetails.PTranBusinessType="LOANS"
		
		MTT.ChargeDetails.EventType = MTT.InputDetails.eventType
		MTT.ChargeDetails.EventId = MTT.InputDetails.eventId
		MTT.ChargeDetails.CompB2kId = MTT.InputDetails.CompB2kId
		sv_x = CDOUBLE(MTT.InputDetails.sysCalcChrgAmt)
		MTT.ChargeDetails.CalculatedAmount = sv_x
		MTT.ChargeDetails.ActualAmount = sv_l
		MTT.ChargeDetails.CollectionCrncy = MTT.InputDetails.chargeCreditCrncy
		MTT.ChargeDetails.ChargeCifId = MTT.InputDetails.chargeCifId
		MTT.ChargeDetails.TargetAcctId = MTT.InputDetails.loanAcct
		IF (MTT.ChargeDetails.EventType == "LNKED") THEN
		#{
			sv_j = MTT.InputDetails.loanAcct+" "+LTRIM(RTRIM(MID$(MTT.InputDetails.tranParticulars,0,32)))
			MTT.PartTranDetails.Particulars=sv_j
		#}
		ENDIF
		
		sv_z = urhk_MTTS_DefineChargePartTran("FEECR")
		#print(sv_z)
		
		sv_r = urhk_MTTS_PopulateInputDetails("")
		#print(sv_z)
	#}
	DO
	sv_z = urhk_MTTS_EndDefinition("")
	#print(sv_z)
	
	
	TRACE OFF
