#------------------------------------------------------------------------------------------------    
#   Name            : LoanReschedulingTran.scr
#   Description     : This script is executed by batch job "BILCG" in EOD/BOD process to collect
#                   : the bill charges 22kes per bill collection
#   Date            : 24-01-2013
#   Author          : Sateesh
#   Input           : NA
#   Output          : NA
#   Called Script   : NA
#   Calling Script  : NA
#   Menu Option     :HBJSTM and HBJE
#   Srl. No         Date            Author          Description.
#   -------         ------          ------          ------------
#   1.0             24-01-2013      Sateesh     Original Version
#-----------------------------------------------------------------------------------------------
<--START
CHECKSUM="6a952f5ac6114fd503207fff63004e9fa35862e3376969e64082e27ae7de8776"
	TRACE ON
	
	sv_z = urhk_MTTS_PopulateInputDetails("")
	#print(sv_z)
	
	###############################################################################
	# Get all the amounts into local variables . Please do not set these variables
	# anywhere else in this script. The variables are : -
	# sv_p = Outstanding Principal Demand
	# sv_i = Pending Interest (Sum Of Previous Unsatisfied Interest Demand &
	#							The Interest Computed at the time of Rescheduling)
	# sv_b = Outstanding Bank Charges Demand
	# sv_o = Outstanding Other Charges Demand
	# sv_l = amount in loan payment acct.
	# sv_n = Normal interest to be reversed from Suspense A/c to P&L A/c
	# sv_e = Penal interest to be reversed from Suspense A/c to P&L A/c
	# sv_f = Normal interest adjustment amount
	# sv_g = Penal interest adjustment amount
	# sv_h = Overdue interest adjustment amount
	###############################################################################
	
	sv_p = CDOUBLE(MTT.InputDetails.princDmdOutStanding)
	#print(sv_p)
	
	sv_v = CDOUBLE(MTT.InputDetails.intDmdOutStanding)
	#print(sv_v)
	sv_b = CDOUBLE(MTT.InputDetails.bankChrgDmdOutStanding)
	#print(sv_b)
	sv_o = CDOUBLE(MTT.InputDetails.otherChrgDmdOutStanding)
	#print(sv_o)
	sv_i = CDOUBLE(MTT.InputDetails.pendInterestAmount)
	#print(sv_i)
	#sv_d = CDOUBLE(MTT.InputDetails.pendPrincipalDemandAmount)
	
	#############################
	
	
	#############################
	
	###############################################################################
	# Define the Transaction
	###############################################################################
	
	MTT.TranDetails.TranDate="0"
	MTT.TranDetails.TranType=MTT.InputDetails.chrgTranType
	#print(MTT.TranDetails.TranType)
	
	IF (MTT.InputDetails.chrgTranType == "C" ) THEN
	#{
		MTT.TranDetails.TranSubType = "CR"
		#}
	ELSE
		#{
		MTT.TranDetails.TranSubType="BI"
	#}
	ENDIF
	#print(MTT.TranDetails.TranSubType)
	#MTT.TranDetails.TranSubType=MTT.InputDetails.TranSubType
	MTT.TranDetails.Remarks="Reschedule Transaction"
	MTT.TranDetails.IgnoreExcp="N"
	MTT.TranDetails.Consolidate="Y"
	MTT.TranDetails.PrintAdviceInd="B"
	MTT.TranDetails.TranIdOnline = "Y"
	sv_z = urhk_MTTS_DefineTransaction("rschdl")
	#print(sv_z)
	
	#
	###############################################################################
	# Part Tran 1.Debit/Credit Loan/Loan Interest A/c for Interest Adjustment Amount
	#   Input :-   MTT.InputDetails.tranInterestAmount :- Interest adj during Rescheduling
	#              MTT.InputDetails.tranIarAmount      :- IAR Amount During Rescheduling
	#              MTT.InputDetails.intDmdOutStanding  :- Pending Interest Demands
	###############################################################################
	sv_u = CDOUBLE(MTT.InputDetails.tranInterestAmount)
	#print(sv_u)
	sv_x = CDOUBLE(MTT.InputDetails.tranIarAmount)
	#print(sv_x)
	sv_v = CDOUBLE(MTT.InputDetails.intDmdOutStanding)
	#print(sv_v)
	
	sv_u = sv_u + sv_x
	
	###############################################################################
	#    Only if refund is there create part trans 1 & 2 , else ignore these
	#    Cases Handled :-
	#
	#       1. Pending Interest demands ( sv_v ) is greater than Interest Adj
	#              Refund the entire adjustment to Loan Interest A/c , this will
	#              satisfy the demands.
	#       2. Pending Interest demands ( sv_u + sv_x ) is lesser than interest adj
	#             Refund upto pending interest demands ( sv_v) to loan interest a/c
	#             rest to loan a/c. Reduce prepayment amount by an amount equal
	#            to this refund so that customer need not pay this amount
	###############################################################################
	IF(sv_u < 0 ) THEN
	#{
		IF((sv_v) > 0 ) THEN
		#{
			
			IF(MTT.InputDetails.intRouteFlg == "O") THEN
			#{
				MTT.PartTranDetails.Account=MTT.InputDetails.loanIntAcct
				MTT.PartTranDetails.ACPARTB2kId=MTT.InputDetails.loanAcct
				MTT.PartTranDetails.ACPARTB2kType="ACCNT"
				#}
			ELSE
				#{
				MTT.PartTranDetails.Account=MTT.InputDetails.loanAcct
			#}
			ENDIF
			#print(MTT.PartTranDetails.Account)
			MTT.PartTranDetails.RefCurrency=MTT.InputDetails.loanAcctCrncy
			MTT.PartTranDetails.RateCode = ""
			MTT.PartTranDetails.Particulars=MTT.InputDetails.loanAcct + " - Interest Refund"
			
			# Call to common script to modify tran particulars if script is present
			MTT.PartTranDetails.ScriptEventType = "LARET"
			sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
			IF (sv_m == 0) THEN
			#{
				call("getMTTTranPart.scr")
			#}
			ENDIF
			
			IF (MTT.PartTranDetails.RefCurrency != BANCS.STDIN.homeCrncyCode) THEN
			#{
				sv_s = "intRateCode|SELECT ds_rate_code "
				sv_s = sv_s + " FROM tbaadm.LAM"
				sv_s = sv_s + " WHERE acid =(SELECT acid FROM tbaadm.GAM where foracid = ?SVAR  AND GAM.bank_id = ?SVAR)"
				sv_s = sv_s + " AND LAM.bank_id = ?SVAR"
				BANCS.INPARAM.BINDVARS = MTT.InputDetails.loanAcct+ "|" +BANCS.STDIN.contextBankId+ "|" +BANCS.STDIN.contextBankId
				print(sv_s)
				sv_d = urhk_dbselectWithBind(sv_s)
				print(sv_d)
				MTT.PartTranDetails.RateCode= BANCS.OUTPARAM.intRateCode
			#}
			ENDIF
			
			MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
			MTT.PartTranDetails.Remarks="Refund Interest - Rescheduling"
			MTT.PartTranDetails.Consolidate="N"
			MTT.PartTranDetails.TranIdentifier="rschdl"
			MTT.PartTranDetails.PTranBusinessType="OFFC1"
			
			MTT.LAAddnlDetails.LoanAcctId = MTT.InputDetails.loanAcct
			
			###############################################################################
			# If Credit due to interest adj comes in excess of pending interest demand,
			# then amount equal to pending interest should be credited to satisfy interest
			# demands and rest should go to satisfy principal demands.
			###############################################################################
			
			IF((sv_v) > ((-1)*(sv_u))) THEN
			#{
				MTT.LAAddnlDetails.TypeOfDemand = "I"
				MTT.LAAddnlDetails.DemandFlowId = MTT.InputDetails.defltCollFlowId
				MTT.PartTranDetails.RefAmount=-(sv_u)
				
				#}
			ELSE
				#{
				MTT.LAAddnlDetails.TypeOfDemand = "I"
				MTT.LAAddnlDetails.DemandFlowId = MTT.InputDetails.defltCollFlowId
				MTT.PartTranDetails.RefAmount=(sv_v)
				#print(MTT.PartTranDetails.RefAmount)
			#}
			ENDIF
			MTT.LAAddnlDetails.OriginOfTran = "RSCHDL"
			
			sv_z = urhk_MTTS_DefineLoanPartTran("INT_COLL")
			#print(sv_z)
		#}
		ENDIF
	#}
	ENDIF
	
	###############################################################################
	# Part Tran 2.Credit Loan Account for excess of credit over and above pending
	# interest demands.
	###############################################################################
	
	sv_u = CDOUBLE(MTT.InputDetails.tranInterestAmount)
	sv_x = CDOUBLE(MTT.InputDetails.tranIarAmount)
	sv_v = CDOUBLE(MTT.InputDetails.intDmdOutStanding)
	sv_u = sv_u + sv_x
	sv_u = (-1)*(sv_u)
	IF((sv_u > sv_v) AND (sv_u !=  0)) THEN
	#{
		MTT.PartTranDetails.Account=MTT.InputDetails.loanAcct
		#print(MTT.PartTranDetails.Account)
		MTT.PartTranDetails.RefAmount=(sv_u-sv_v)
		#print(MTT.PartTranDetails.RefAmount)
		MTT.PartTranDetails.RefCurrency=MTT.InputDetails.loanAcctCrncy
		MTT.PartTranDetails.RateCode = ""
		MTT.PartTranDetails.Particulars=MTT.InputDetails.loanAcct + " - Rescheduling Int Adj(Credit)"
		
		# Call to common script to modify tran particulars if script is present
		MTT.PartTranDetails.ScriptEventType = "LARET"
		sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
		IF (sv_m == 0) THEN
		#{
			call("getMTTTranPart.scr")
		#}
		ENDIF
		
		IF (MTT.PartTranDetails.RefCurrency != BANCS.STDIN.homeCrncyCode) THEN
		#{
			sv_s = "intRateCode|SELECT ds_rate_code "
			sv_s = sv_s + " FROM tbaadm.LAM"
			sv_s = sv_s + " WHERE acid =(SELECT acid FROM tbaadm.GAM where foracid = ?SVAR  AND GAM.bank_id = ?SVAR)"
			sv_s = sv_s + " AND LAM.bank_id = ?SVAR"
			BANCS.INPARAM.BINDVARS = MTT.InputDetails.loanAcct+ "|" +BANCS.STDIN.contextBankId+ "|" +BANCS.STDIN.contextBankId
			print(sv_s)
			sv_d = urhk_dbselectWithBind(sv_s)
			print(sv_d)
			MTT.PartTranDetails.RateCode= BANCS.OUTPARAM.intRateCode
		#}
		ENDIF
		
		MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
		MTT.PartTranDetails.Remarks="Cr Excess Int Adj"
		MTT.PartTranDetails.Consolidate="N"
		MTT.PartTranDetails.TranIdentifier="rschdl"
		MTT.PartTranDetails.PTranBusinessType="LOAN3"
		
		MTT.LAAddnlDetails.LoanAcctId = MTT.InputDetails.loanAcct
		MTT.LAAddnlDetails.TypeOfDemand = "A"
		MTT.LAAddnlDetails.AdvancePaymentFlg ="Y"
		MTT.LAAddnlDetails.DemandFlowId = MTT.InputDetails.defltCollFlowId
		MTT.LAAddnlDetails.OriginOfTran = "RSCHDL"
		
		######################################
		#  Reduce the principal amount by this amount
		#	to be looked into
		sv_p = CDOUBLE(MTT.InputDetails.princDmdOutStanding)
		sv_p = sv_p - (sv_u - sv_v)
		
		sv_z = urhk_MTTS_DefineLoanPartTran("INT_COLL")
		#print(sv_z)
	#}
	ENDIF
	###############################################################################
	
	###################################################################################
	# If the Interest Run at the time of Rescheduling requires Normal Interest Demands
	# to be raised, Debit loanAcct/loanIntAcct for the same depending on
	# Interest Route Flag
	###################################################################################
	#MTT.InputDetails.tranNormalInterestAmount=100
	sv_f = CDOUBLE(MTT.InputDetails.tranNormalInterestAmount)
	sv_x = CDOUBLE(MTT.InputDetails.tranIarAmount)
	#print(sv_f)
	sv_f = sv_f + sv_x
	IF(sv_f > 0) THEN
	#{
		IF(MTT.InputDetails.intRouteFlg == "O") THEN
		#{
			MTT.PartTranDetails.Account=MTT.InputDetails.loanIntAcct
			MTT.PartTranDetails.ACPARTB2kId=MTT.InputDetails.loanAcct
			MTT.PartTranDetails.ACPARTB2kType="ACCNT"
			#}
		ELSE
			#{
			MTT.PartTranDetails.Account=MTT.InputDetails.loanAcct
		#}
		ENDIF
		
		MTT.PartTranDetails.RefAmount=-(sv_f)
		
		MTT.PartTranDetails.RefCurrency=MTT.InputDetails.loanAcctCrncy
		MTT.PartTranDetails.RateCode = ""
		MTT.PartTranDetails.Particulars=MTT.InputDetails.loanAcct + " - Normal Interest Dmd"
		
		# Call to common script to modify tran particulars if script is present
		MTT.PartTranDetails.ScriptEventType = "LARET"
		sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
		IF (sv_m == 0) THEN
		#{
			call("getMTTTranPart.scr")
		#}
		ENDIF
		
		IF (MTT.PartTranDetails.RefCurrency != BANCS.STDIN.homeCrncyCode) THEN
		#{
			sv_s = "intRateCode|SELECT ds_rate_code "
			sv_s = sv_s + " FROM tbaadm.LAM"
			sv_s = sv_s + " WHERE acid =(SELECT acid FROM tbaadm.GAM where foracid = ?SVAR  AND GAM.bank_id = ?SVAR)"
			sv_s = sv_s + " AND LAM.bank_id = ?SVAR"
			BANCS.INPARAM.BINDVARS = MTT.InputDetails.loanAcct+ "|" +BANCS.STDIN.contextBankId+ "|" +BANCS.STDIN.contextBankId
			print(sv_s)
			sv_d = urhk_dbselectWithBind(sv_s)
			print(sv_d)
			MTT.PartTranDetails.RateCode= BANCS.OUTPARAM.intRateCode
		#}
		ENDIF
		
		MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
		MTT.PartTranDetails.Remarks="Dr Acct For Raising Normal Int Dmd - Rescheduling"
		MTT.PartTranDetails.Consolidate="N"
		MTT.PartTranDetails.TranIdentifier="rschdl"
		MTT.PartTranDetails.PTranBusinessType="OFFC3"
		
		MTT.LAAddnlDetails.LoanAcctId = MTT.InputDetails.loanAcct
		MTT.LAAddnlDetails.DemandFlowId = MTT.InputDetails.normalLoanFlowId
		MTT.LAAddnlDetails.OriginOfTran = "RSCHDL"
		MTT.LAAddnlDetails.raiseDemandFlg="Y"
		
		sv_z = urhk_MTTS_DefineLoanPartTran("INT_COLL")
		#print(sv_z)
	#}
	ENDIF
	###################################################################################
	# If the Interest Run at the time of Rescheduling requires Penal Interest Demands
	# to be raised, Debit loanAcct/loanIntAcct for the same depending on
	# Interest Route Flag
	###################################################################################
	sv_g = CDOUBLE(MTT.InputDetails.tranPenalInterestAmount)
	#print(sv_g)
	IF(sv_g != 0) THEN
	#{
		IF(MTT.InputDetails.intRouteFlg == "O") THEN
		#{
			MTT.PartTranDetails.Account=MTT.InputDetails.loanIntAcct
			MTT.PartTranDetails.ACPARTB2kId=MTT.InputDetails.loanAcct
			MTT.PartTranDetails.ACPARTB2kType="ACCNT"
			#}
		ELSE
			#{
			MTT.PartTranDetails.Account=MTT.InputDetails.loanAcct
		#}
		ENDIF
		
		MTT.PartTranDetails.RefAmount=-(sv_g)
		
		MTT.PartTranDetails.RefCurrency=MTT.InputDetails.loanAcctCrncy
		MTT.PartTranDetails.RateCode = ""
		MTT.PartTranDetails.Particulars=MTT.InputDetails.loanAcct + " - Penal Int Dmd"
		
		# Call to common script to modify tran particulars if script is present
		MTT.PartTranDetails.ScriptEventType = "LARET"
		sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
		IF (sv_m == 0) THEN
		#{
			call("getMTTTranPart.scr")
		#}
		ENDIF
		
		IF (MTT.PartTranDetails.RefCurrency != BANCS.STDIN.homeCrncyCode) THEN
		#{
			sv_s = "intRateCode|SELECT ds_rate_code "
			sv_s = sv_s + " FROM tbaadm.LAM"
			sv_s = sv_s + " WHERE acid =(SELECT acid FROM tbaadm.GAM where foracid = ?SVAR  AND GAM.bank_id = ?SVAR)"
			sv_s = sv_s + " AND LAM.bank_id = ?SVAR"
			BANCS.INPARAM.BINDVARS = MTT.InputDetails.loanAcct+ "|" +BANCS.STDIN.contextBankId+ "|" +BANCS.STDIN.contextBankId
			print(sv_s)
			sv_d = urhk_dbselectWithBind(sv_s)
			print(sv_d)
			MTT.PartTranDetails.RateCode= BANCS.OUTPARAM.intRateCode
		#}
		ENDIF
		
		MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
		MTT.PartTranDetails.Remarks="Dr Acct For Raising Penal Int Dmd - Rescheduling"
		MTT.PartTranDetails.Consolidate="N"
		MTT.PartTranDetails.TranIdentifier="rschdl"
		MTT.PartTranDetails.PTranBusinessType="OFFC4"
		
		MTT.LAAddnlDetails.LoanAcctId = MTT.InputDetails.loanAcct
		MTT.LAAddnlDetails.DemandFlowId = MTT.InputDetails.penalLoanFlowId
		MTT.LAAddnlDetails.OriginOfTran = "RSCHDL"
		MTT.LAAddnlDetails.raiseDemandFlg="Y"
		
		sv_z = urhk_MTTS_DefineLoanPartTran("INT_COLL")
		#print(sv_z)
	#}
	ENDIF
	###############################################################################
	# Part Tran. Debit the Loan Account for Penal Accrual
	###############################################################################
	sv_a = CDOUBLE(MTT.InputDetails.accrpenaldmdos)
	IF (sv_a > 0) THEN
	#{
		MTT.PartTranDetails.RefCurrency=MTT.InputDetails.loanAcctCrncy
		MTT.PartTranDetails.Particulars=MTT.InputDetails.loanAcct+" Debit for Penal Accrued interest"
		MTT.PartTranDetails.Consolidate="N"
		MTT.PartTranDetails.TranIdentifier="rschdl"
		MTT.PartTranDetails.Account = MTT.InputDetails.loanAcct
		MTT.PartTranDetails.RefAmount= -sv_a
		MTT.PartTranDetails.PTranBusinessType = "SUSP"
		MTT.LAAddnlDetails.raiseDemandFlg="N"
		MTT.LAAddnlDetails.DemandFlowId = MTT.InputDetails.penalLoanFlowId
		MTT.LAAddnlDetails.OriginOfTran = "RSCHD"
		MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
		sv_z = urhk_MTTS_DefineLoanPartTran("PENAL_ACCR_INT_DEBIT")
		IF (sv_z == 1) THEN
		#{
			exitscript
		#}
		ENDIF
	#}
	ENDIF
	
	###############################################################################
	# Part Tran. Credit the Loan Account for Penal Accrual
	###############################################################################
	
	IF (sv_a > 0) THEN
	#{
		MTT.PartTranDetails.RefCurrency=MTT.InputDetails.loanAcctCrncy
		MTT.PartTranDetails.Particulars=MTT.InputDetails.loanAcct+" Credit for Penal Accrued interest"
		MTT.PartTranDetails.Consolidate="N"
		MTT.PartTranDetails.TranIdentifier="rschdl"
		MTT.PartTranDetails.RateCode = MTT.InputDetails.RateCode
		MTT.PartTranDetails.Account = MTT.InputDetails.penalPandlAcct
		MTT.PartTranDetails.RefAmount= sv_a
		MTT.PartTranDetails.PTranBusinessType = "SUSP"
		MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
		sv_z = urhk_MTTS_DefineLoanPartTran("PENAL_ACCR_INT_DEBIT")
		IF (sv_z == 1) THEN
		#{
			exitscript
		#}
		ENDIF
	#}
	ENDIF
	###########################################################################################
	###################################################################################
	# If the Interest Run at the time of Rescheduling requires Overdue Interest Demands
	# to be raised, Debit loanAcct/loanIntAcct for the same depending on
	# Interest Route Flag
	###################################################################################
	sv_h = CDOUBLE(MTT.InputDetails.tranOvduInterestAmount)
	#print(sv_h)
	IF(sv_h > 0) THEN
	#{
		IF(MTT.InputDetails.intRouteFlg == "O") THEN
		#{
			MTT.PartTranDetails.Account=MTT.InputDetails.loanIntAcct
			MTT.PartTranDetails.ACPARTB2kId=MTT.InputDetails.loanAcct
			MTT.PartTranDetails.ACPARTB2kType="ACCNT"
			#}
		ELSE
			#{
			MTT.PartTranDetails.Account=MTT.InputDetails.loanAcct
		#}
		ENDIF
		
		MTT.PartTranDetails.RefAmount=-(sv_h)
		#print(MTT.PartTranDetails.RefAmount)
		MTT.PartTranDetails.RefCurrency=MTT.InputDetails.loanAcctCrncy
		MTT.PartTranDetails.RateCode = ""
		MTT.PartTranDetails.Particulars=MTT.InputDetails.loanAcct + " - Overdue Int Dmd"
		
		# Call to common script to modify tran particulars if script is present
		MTT.PartTranDetails.ScriptEventType = "LARET"
		sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
		IF (sv_m == 0) THEN
		#{
			call("getMTTTranPart.scr")
		#}
		ENDIF
		
		IF (MTT.PartTranDetails.RefCurrency != BANCS.STDIN.homeCrncyCode) THEN
		#{
			sv_s = "intRateCode|SELECT ds_rate_code "
			sv_s = sv_s + " FROM tbaadm.LAM"
			sv_s = sv_s + " WHERE acid =(SELECT acid FROM tbaadm.GAM where foracid = ?SVAR  AND GAM.bank_id = ?SVAR)"
			sv_s = sv_s + " AND LAM.bank_id = ?SVAR"
			BANCS.INPARAM.BINDVARS = MTT.InputDetails.loanAcct+ "|" +BANCS.STDIN.contextBankId+ "|" +BANCS.STDIN.contextBankId
			print(sv_s)
			sv_d = urhk_dbselectWithBind(sv_s)
			print(sv_d)
			MTT.PartTranDetails.RateCode= BANCS.OUTPARAM.intRateCode
		#}
		ENDIF
		
		MTT.PartTranDetails.ValueDate=MTT.InputDetails.valueDate
		MTT.PartTranDetails.Remarks="Dr Acct For Raising Overdue Int Dmd - Rescheduling"
		MTT.PartTranDetails.Consolidate="N"
		MTT.PartTranDetails.TranIdentifier="rschdl"
		MTT.PartTranDetails.PTranBusinessType="OFFC5"
		
		MTT.LAAddnlDetails.LoanAcctId = MTT.InputDetails.loanAcct
		MTT.LAAddnlDetails.DemandFlowId = MTT.InputDetails.ovduLoanFlowId
		MTT.LAAddnlDetails.OriginOfTran = "RSCHDL"
		MTT.LAAddnlDetails.raiseDemandFlg="Y"
		
		sv_z = urhk_MTTS_DefineLoanPartTran("INT_COLL")
		#print(sv_z)
	#}
	ENDIF
	###############################################################################
	# Part Tran 3. Credit/Debit Receivable for tranInterest Amount
	# Inputs :-   MTT.InputDetails.intBookAcct            :- Receivable A/c
	#             MTT.InputDetails.tranInterestAmount     :- Interest run amount
	#														 during Rescheduling
	###############################################################################
	#MTT.InputDetails.tranNormalInterestAmount=100
	sv_u = CDOUBLE(MTT.InputDetails.tranNormalInterestAmount)
	sv_x = CDOUBLE(MTT.InputDetails.tranOvduInterestAmount)
	sv_u = sv_u + sv_x
	IF(sv_u != 0) THEN
	#{
		IF(MTT.InputDetails.pastDueFlg != "Y") THEN
		#{
			MTT.PartTranDetails.Account=MTT.InputDetails.intBookAcct
			#}
		ELSE
			#{
			MTT.PartTranDetails.Account=MTT.InputDetails.PDIntBookAcct
		#}
		ENDIF
		MTT.PartTranDetails.ACPARTB2kId=MTT.InputDetails.loanAcct
		MTT.PartTranDetails.ACPARTB2kType="ACCNT"
		MTT.PartTranDetails.RefAmount=(sv_u)
		MTT.PartTranDetails.RefCurrency=MTT.InputDetails.loanAcctCrncy
		MTT.PartTranDetails.RateCode = ""
		MTT.PartTranDetails.Particulars=MTT.InputDetails.loanAcct + " - Rescheduling Int Receivable a/c adj"
		
		# Call to common script to modify tran particulars if script is present
		MTT.PartTranDetails.ScriptEventType = "LARET"
		sv_m = urhk_getFileLocation("SCRIPT|getMTTTranPart.scr")
		IF (sv_m == 0) THEN
		#{
