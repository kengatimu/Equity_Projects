<--START
TRACE ON
	sv_a = REPEXISTS("CUST")
	IF(sv_a == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	sv_r = CLASSEXISTS("CUST","DATA")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("CUST", "DATA", 5)
	#}
	ENDIF
	CUST.DATA.clsflg = "Y"
	
	CUST.DATA.odacnt = BANCS.INPUT.odacnt
	
	sv_u = urhk_getAcctDetailsInRepository(CUST.DATA.odacnt)
	CUST.DATA.acctSolId 	= BANCS.OUTPARAM.acctSolId
	CUST.DATA.schmCode 	= BANCS.OUTPARAM.schmCode
	CUST.DATA.acctCrncyCode = BANCS.OUTPARAM.acctCrncyCode
	PRINT(CUST.DATA.acctSolId)
	PRINT(CUST.DATA.schmCode)
	PRINT(CUST.DATA.acctCrncyCode)
	
	sv_s = "acid|SELECT ACID FROM TBAADM.GAM WHERE FORACID=?SVAR AND BANK_ID=?SVAR"
	BANCS.INPARAM.BINDVARS = CUST.DATA.odacnt + "|" + BANCS.STDIN.contextBankId
	
	PRINT(sv_s)
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbselectWithBind(sv_s)

    IF (sv_d != 0 ) THEN
    #{
	    CUST.DATA.clsflg = "N"
            sv_e = "A Database error has occured. Please contact your DBA."
            sv_m = "count"
            sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
            sv_u = urhk_SetOrbOut(sv_e)
            sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
            GOTO ENDOFSCRIPT
    #}
    ENDIF
	CUST.DATA.acid = BANCS.OUTPARAM.acid
	
	sv_s = "prkngBacid|SELECT PARKING_BACID FROM TBAADM.GSP WHERE BANK_ID=?SVAR AND SCHM_CODE=?SVAR"
	BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.DATA.schmCode
	
	PRINT(sv_s)
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbselectWithBind(sv_s)

    IF (sv_d != 0 ) THEN
    #{	
	CUST.DATA.clsflg = "N"
            sv_e = "A Database error has occured. Please contact your DBA."
            sv_m = "count"
            sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
            sv_u = urhk_SetOrbOut(sv_e)
            sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
            GOTO ENDOFSCRIPT
    #}
    ENDIF
	
	CUST.DATA.prkngBacid = BANCS.OUTPARAM.prkngBacid
	
	PRINT(CUST.DATA.prkngBacid)
	IF(TRIM(CUST.DATA.prkngBacid) == "")THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF

	sv_a =  CUST.DATA.prkngBacid + "|" + CUST.DATA.acctCrncyCode+ "|" + CUST.DATA.acctSolId
	sv_u = urhk_B2k_BacidToAcctId(sv_a)
	PRINT(sv_u)
	CUST.DATA.prkngAcnt = BANCS.OUTPARAM.AcctId
	 
	PRINT(CUST.DATA.prkngAcnt)
	
	sv_s = "acid|SELECT ACID FROM TBAADM.GAM WHERE FORACID=?SVAR AND BANK_ID=?SVAR"
	BANCS.INPARAM.BINDVARS = CUST.DATA.prkngAcnt + "|" + BANCS.STDIN.contextBankId
	
	PRINT(sv_s)
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbselectWithBind(sv_s)

    IF (sv_d != 0 ) THEN
    #{
	    CUST.DATA.clsflg = "N"
            sv_e = "A Database error has occured. Please contact your DBA."
            sv_m = "count"
            sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
            sv_u = urhk_SetOrbOut(sv_e)
            sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
            GOTO ENDOFSCRIPT
    #}
    ENDIF
	CUST.DATA.prkngacid = BANCS.OUTPARAM.acid	
	
	sv_u = urhk_getAcctDetailsInRepository(CUST.DATA.prkngAcnt)
	CUST.DATA.prkngAmt 	= BANCS.OUTPARAM.EffAvailableAmt
	
	PRINT(CUST.DATA.prkngAmt)
	
	sv_s = "outstnAmt|SELECT SUM(DECODE(part_tran_type,'D',-1*tran_amt,tran_amt)) FROM TBAADM.ACPART WHERE B2K_ID=?SVAR AND PARTITIONED_ACID=?SVAR AND BANK_ID=?SVAR AND PSTD_FLG ='Y' "
	BANCS.INPARAM.BINDVARS = CUST.DATA.acid + "|" + CUST.DATA.prkngacid + "|" + BANCS.STDIN.contextBankId
	
	PRINT(sv_s)
	PRINT(BANCS.INPARAM.BINDVARS)
		
	sv_d = urhk_dbselectWithBind(sv_s)

    IF (sv_d != 0 ) THEN
    #{
	    CUST.DATA.clsflg = "N"
            sv_e = "A Database error has occured. Please contact your DBA."
            sv_m = "count"
            sv_e = "Error_2|ERROR:^"+ sv_e +".^"+ sv_m +""
            sv_u = urhk_SetOrbOut(sv_e)
            sv_u = urhk_SetOrbOut("SuccessOrFailure|N")
            GOTO ENDOFSCRIPT
    #}
    ENDIF
	CUST.DATA.outstnAmt = BANCS.OUTPARAM.outstnAmt
	IF(TRIM(CUST.DATA.outstnAmt) == "")THEN
	#{
		CUST.DATA.outstnAmt = "0"
	#}
	ENDIF
	
	IF(CUST.DATA.outstnAmt != "0")THEN
	#{
		sv_u = urhk_SRV_SetErr("Amount outstanding in the Parking account towards interest, account Can't be closed")
		CUST.DATA.clsflg = "N"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
ENDOFSCRIPT:
exitscript
TRACE OFF
END-->
