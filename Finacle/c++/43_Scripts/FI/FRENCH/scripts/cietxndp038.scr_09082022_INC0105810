		#{
			sv_u = urhk_ExecSrvNoCommit("SRV_AddGenChrgDtl|retain_all_output = Y")
			print(sv_u)
			#}
		ELSE
			#{
			sv_u = urhk_ExecSrvNoCommit("SRV_AddGenChrgDtl|retain_all_output = Y")
			print(sv_u)
			
