			#	GOTO ENDOFSCRIPT
			##}
			#ENDIF
		#}
		ENDIF
		
		CUST.CIETXN.gchSrlNum = BANCS.OUTPARAM.gchSrlNum
		print(CUST.CIETXN.gchSrlNum)
		
		sv_a = urhk_SetUrhkInp("genChrgCrit.gchSrlNum|" + CUST.CIETXN.gchSrlNum)
		sv_a = urhk_SetUrhkInp("genChrgCrit.tranType.tranType|T" )
		sv_a = urhk_SetUrhkInp("genChrgCrit.tranType.tranSubType|BI")
		sv_a = urhk_SetUrhkInp("genChrgCrit.eventId.eventId|" + CUST.CIETXN.chargeEventId)
		sv_a = urhk_SetUrhkInp("genChrgCrit.contextChrgCrncy.crncyCode|" +CUST.CIETXN.chargeAmtCcy)
		sv_u = urhk_SetUrhkInp("genChrgCrit.chrgDrCrncy.crncyCode|" +CUST.CIETXN.chargeAmtCcy)
		sv_u = urhk_SetUrhkInp("genChrgCrit.drAcct.foracid|" + CUST.CIETXN.drAcctNum)
		
		IF(CUST.CIETXN.srvcallmode == "E")THEN
		#{
			sv_u = urhk_ExecSrvNoCommit("SRV_FetchGenChrgDtlForVerify|same_user_verify = Y|retain_all_output = Y")
			print(sv_u)
			#}
		ELSE
			#{
			sv_u = urhk_ExecSrvNoCommit("SRV_FetchGenChrgDtlForVerify|same_user_verify = Y|retain_all_output = Y")
			print(sv_u)
			
