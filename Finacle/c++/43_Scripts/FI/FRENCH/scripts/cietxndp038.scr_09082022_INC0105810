		sv_a = urhk_SetUrhkInp("genChrgCrit.gchSrlNum|" + CUST.CIETXN.gchSrlNum)
		sv_a = urhk_SetUrhkOut("genChrgCrit.tranId|tranId")
		sv_a = urhk_SetUrhkOut("genChrgCrit.tranDate|tranDate")
		
		IF(CUST.CIETXN.srvcallmode == "E")THEN
		#{
			sv_u = urhk_ExecSrvNoCommit("SRV_VerifyGenChrgDtl|same_user_verify = Y|retain_all_output = Y")
			print(sv_u)
			#}
		ELSE
			#{
			sv_u = urhk_ExecSrvNoCommit("SRV_VerifyGenChrgDtl|same_user_verify = Y|retain_all_output = Y")
