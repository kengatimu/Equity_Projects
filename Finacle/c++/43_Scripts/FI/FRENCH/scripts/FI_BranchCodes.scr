#------------------------------------------------------------------------------------------------
#  Name            : FI_BranchCodes.scr
#  Description     : Fetch Branch Codes based on BankCode and BankId
#  Date            : 01-10-2025
#  Author          : YESHWANTH
#  Input           : NA
#  Output          : NA
#  Called Script   : NA
#  Menu Option     :  (API)
#  Srl. No         Date            Author               Description.
#  -------         ------          ------               ------------
#  1.0           01-10-2025       YESHWANTH		Original Version
#-----------------------------------------------------------------------------------------------
<--START
TRACE ON

	sv_u=REPEXISTS("CUST")
	IF(sv_u==0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF

	sv_u=CLASSEXISTS("CUST", "BRN")
	IF(sv_u==0) THEN
	#{
		CREATECLASS("CUST", "BRN", 5)
	#}
	ENDIF

	sv_t=urhk_b2k_printrepos("BANCS")
	print(sv_t)	


	IF( (FIELDEXISTS(("BANCS").("INPUT").("BANKID"))== 0) ) THEN
	#{
   		CUST.BRN.errMsg="please enter BANKID"
		sv_t = "ERROR | " +CUST.BRN.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDOFSCRIPT
	#}
	ENDIF

	IF( (FIELDEXISTS(("BANCS").("INPUT").("BANKCODE"))== 0) ) THEN
	#{
   		CUST.BRN.errMsg="please enter BANKCODE"
		sv_t = "ERROR | " +CUST.BRN.errMsg
		sv_u = urhk_SetOrbOut(sv_t)
   		GOTO ENDOFSCRIPT
	#}
	ENDIF

	#---------------------------------------------------------------------------------------------------------------
	# Variable Initialization
	#---------------------------------------------------------------------------------------------------------------

	CUST.BRN.BANKID = BANCS.INPUT.BANKID
	print(CUST.BRN.BANKID)

	CUST.BRN.BANKCODE = BANCS.INPUT.BANKCODE
	print(CUST.BRN.BANKCODE)

	sv_s="BankCode,BranchCode,BrFullName,BrShortName,BrCityCode,BrStateCode,BrAdd1,BrAdd2|"
	sv_s=sv_s + "SELECT BANK_CODE,BR_CODE, DECODE( 'INFENG' , '' ,NVL(ALT1_BR_NAME,BR_NAME), BR_NAME), DECODE( 'INFENG' , '' ,NVL(ALT1_BR_SHORT_NAME,BR_SHORT_NAME),BR_SHORT_NAME), "
	sv_s=sv_s + "BR_CITY_CODE, BR_STATE_CODE, BR_ADDR_1, BR_ADDR_2 FROM TBAADM.BCT WHERE BCT.BANK_ID = ?SVAR  AND  1 = 1 AND DEL_FLG != 'Y' AND "
	sv_s=sv_s + "BANK_CODE =  ?SVAR  ORDER BY BR_NAME"
	print(sv_s)

	BANCS.INPARAM.BINDVARS = CUST.BRN.BANKID +"|"+ CUST.BRN.BANKCODE
	print(BANCS.INPARAM.BINDVARS)

	sv_v = urhk_dbcursorOpenWithBind(sv_s)
       	PRINT(sv_v)	

	IF(sv_v == 0) THEN
       	 #{
        	CUST.BRN.CURSOR_NUMBER = BANCS.OUTPARAM.DB_CURSOR_NUMBER
       		print(CUST.BRN.CURSOR_NUMBER)
       		sv_b = urhk_dbCursorFetch(CUST.BRN.CURSOR_NUMBER)
        	print(sv_b)
		IF(sv_b== "1")THEN
		#{
   			CUST.BRN.errMsg="No records were fetched"
			sv_t = "MSG| " +CUST.BRN.errMsg
			sv_u = urhk_SetOrbOut(sv_t)
			GOTO ENDOFSCRIPT
		#}
		ENDIF

		lv_m = 0
		print(lv_m)
		lv_m = FORMAT$(lv_m,"%d")
		print(lv_m)

		WHILE(sv_b == "0")
        	#{
			CUST.BRN.BankCode  = BANCS.OUTPARAM.BankCode
			print(CUST.BRN.BankCode)
			CUST.BRN.BranchCode = BANCS.OUTPARAM.BranchCode
			print(CUST.BRN.BranchCode)
			CUST.BRN.BrFullName = BANCS.OUTPARAM.BrFullName
			print(CUST.BRN.BrFullName)
			CUST.BRN.BrShortName = BANCS.OUTPARAM.BrShortName
			print(CUST.BRN.BrShortName)
			CUST.BRN.BrCityCode = BANCS.OUTPARAM.BrCityCode
			print(CUST.BRN.BrCityCode)
			CUST.BRN.BrStateCode = BANCS.OUTPARAM.BrStateCode
			print(CUST.BRN.BrStateCode)
			CUST.BRN.BrAdd1 = BANCS.OUTPARAM.BrAdd1
			print(CUST.BRN.BrAdd1)
			CUST.BRN.BrAdd2 = BANCS.OUTPARAM.BrAdd2
			print(CUST.BRN.BrAdd2)

			sv_s="BRANCH.<rec_"+lv_m+">.BANKCODE|" + CUST.BRN.BankCode
			sv_u = urhk_SetOrbOut(sv_s)

			sv_s="BRANCH.<rec_"+lv_m+">.BRANCHCODE|" + CUST.BRN.BranchCode
			sv_u = urhk_SetOrbOut(sv_s)

			sv_s="BRANCH.<rec_"+lv_m+">.BRFULLNAME|" + CUST.BRN.BrFullName
			sv_u = urhk_SetOrbOut(sv_s)

			sv_s="BRANCH.<rec_"+lv_m+">.BRSHORTNAME|" + CUST.BRN.BrShortName
			sv_u = urhk_SetOrbOut(sv_s)

			sv_s="BRANCH.<rec_"+lv_m+">.BRCITYCODE|" + CUST.BRN.BrCityCode
			sv_u = urhk_SetOrbOut(sv_s)

			sv_s="BRANCH.<rec_"+lv_m+">.BRSTATECODE|" + CUST.BRN.BrStateCode
			sv_u = urhk_SetOrbOut(sv_s)

			IF(CUST.BRN.BrAdd1 != "") THEN
				sv_s="BRANCH.<rec_"+lv_m+">.BRADD1|" + CUST.BRN.BrAdd1
				sv_u = urhk_SetOrbOut(sv_s)
			ELSE
				sv_s="BRANCH.<rec_"+lv_m+">.BRADD1| "
				sv_u = urhk_SetOrbOut(sv_s)
			ENDIF

			IF(CUST.BRN.BrAdd2 != "") THEN
				sv_s="BRANCH.<rec_"+lv_m+">.BRADD2|" + CUST.BRN.BrAdd2
				sv_u = urhk_SetOrbOut(sv_s)
			ELSE
				sv_s="BRANCH.<rec_"+lv_m+">.BRADD2| "
				sv_u = urhk_SetOrbOut(sv_s)
			ENDIF

			lv_m  = CINT(lv_m) + 1
			lv_m  = FORMAT$(lv_m, "%d")
       			sv_b = urhk_dbCursorFetch(CUST.BRN.CURSOR_NUMBER)
       			print(sv_b)
		#}
		DO
	#}
	ENDIF

ENDOFSCRIPT:
TRACE OFF
END-->

