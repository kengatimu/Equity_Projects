########################################################################################################
#Name               :ChargeAcct.scr
#Date               :13-05-2019
#Author             :Irungu James
#Description        :Outputs the charge accounts
#Called script      :None
#Calling Script     :None
#Input              :
#Output             : 
########################################################################################################
<--start
trace on

####################################################################
#section      :creating new repository if required
#Description  :Checks for the existence of the repository STDWFS and
#               creates a new one by that name if it does not exist
#####################################################################

IF (REPEXISTS("CUST") == 0 ) THEN
#{
    CREATEREP("CUST")
    #}
ENDIF

IF (CLASSEXISTS("CUST","DATA") == 0) THEN
#{
    CREATECLASS("CUST","DATA",5)
#}
ENDIF

############################################
#Assigns the values to the variables
############################################

sv_a = urhk_b2k_PrintRepos("BANCS")
print(sv_a)
sv_y=0



IF( (FIELDEXISTS(("BANCS").("INPUT").("ChrgCode"))== 0) ) THEN
	CUST.DATA.errMsg="Kindly Supply Charge Code"
	sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
	GOTO End
ELSE
	CUST.DATA.ChrgCode=BANCS.INPUT.ChrgCode
	print(CUST.DATA.ChrgCode)
ENDIF

IF( (FIELDEXISTS(("BANCS").("INPUT").("SetId"))== 0) ) THEN
	CUST.DATA.SetId="EBC"
	print(CUST.DATA.SetId)
ELSE
	CUST.DATA.SetId=BANCS.INPUT.SetId
	print(CUST.DATA.SetId)
ENDIF



CUST.DATA.RECORD = "" 
CUST.DATA.COMM=""
CUST.DATA.VAT=""
CUST.DATA.RCC=""
CUST.DATA.RCC1=""

CUST.DATA.number = 1
sv_j = 1

############################################
# Fetching the valus
############################################


IF ((CUST.DATA.SetId !="EBC") and (CUST.DATA.SetId !="BCDC")) THEN
CUST.DATA.errMsg="Enter valid Set Id"
sv_e=urhk_SetOrbOut("StattusCode|Error")
sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
	exitscript

ENDIF


IF ((CUST.DATA.ChrgCode !="IIMT") and (CUST.DATA.ChrgCode !="NMT") and (CUST.DATA.ChrgCode !="CHQ") and (CUST.DATA.ChrgCode !="USR")) THEN

CUST.DATA.errMsg="Enter valid charge code"
sv_e=urhk_SetOrbOut("StattusCode|Error")
sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
	exitscript

ENDIF

IF (CUST.DATA.ChrgCode =="USR") THEN

IF( (FIELDEXISTS(("BANCS").("INPUT").("Userid"))== 0) ) THEN
	CUST.DATA.errMsg="Kindly Supply User id"
	sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
	GOTO End
ELSE
	CUST.DATA.Userid=BANCS.INPUT.Userid
	print(CUST.DATA.Userid)
ENDIF

sv_q = " Userid, Foracid, Crncy_code| "
sv_q = sv_q + " select upr.User_id, gam.foracid, acct_crncy_code from tbaadm.upr , tbaadm.gec, tbaadm.gam  "
sv_q = sv_q + " where gec.EMP_ID = upr.user_emp_id and gec.EMP_CASH_ACCT=gam.bacid and gam.sol_id=gec.sol_id "
sv_q = sv_q + " and gec.DEL_FLG ='N' and gec.CRNCY_CODE =gam.acct_crncy_code and upr.user_id =?SVAR  and gam.bank_id = ?SVAR "
print(sv_q)
BANCS.INPARAM.BINDVARS =  CUST.DATA.Userid  + "|" +  BANCS.STDIN.contextBankId
print(BANCS.INPARAM.BINDVARS)
sv_e = urhk_dbCursorOpenWithBind(sv_q)
IF(sv_e==0) THEN
#{
		sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		sv_q = urhk_dbCursorFetch(sv_m)
		print(sv_q)
			IF(sv_q == 1) THEN
				sv_x = urhk_dbCursorClose(sv_m)
				print(sv_x)
		CUST.DATA.errMsg="No record Found"
		sv_e=urhk_SetOrbOut("StattusCode|Error")
		sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)

				EXITSCRIPT
			ENDIF
		print(sv_q)

	WHILE (sv_q==0)
		CUST.DATA.foracid = BANCS.OUTPARAM.Foracid
		print (CUST.DATA.foracid)
		CUST.DATA.acct_crncy_code = BANCS.OUTPARAM.Crncy_code 
		print (CUST.DATA.acct_crncy_code)
		CUST.DATA.Userid = BANCS.OUTPARAM.Userid 
		print (CUST.DATA.Userid)
	        
sv_a = "Account.<rec_" + CUST.DATA.number + ">.ACCTNUM|" + CUST.DATA.foracid
sv_b = "Account.<rec_" + CUST.DATA.number + ">.Crncy|" + CUST.DATA.acct_crncy_code
sv_c = "Account.<rec_" + CUST.DATA.number + ">.Userid|" + CUST.DATA.Userid

sv_u = urhk_SetOrbOut(sv_a)
sv_u = urhk_SetOrbOut(sv_b)
sv_u = urhk_SetOrbOut(sv_c)

	sv_j =sv_j + 1
	CUST.DATA.number = sv_j

	sv_q = urhk_dbCursorFetch(sv_m)
	print(sv_q)
	DO

	ELSE
		CUST.DATA.errMsg="Data Error"
		sv_e=urhk_SetOrbOut("StattusCode|Error")
		sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
		
	ENDIF


ELSE



IF( (FIELDEXISTS(("BANCS").("INPUT").("Bankid"))== 0) ) THEN
	CUST.DATA.errMsg="Kindly Supply Bank id"
	sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
	GOTO End
ELSE
	CUST.DATA.Bankid=BANCS.INPUT.Bankid
	print(CUST.DATA.Bankid)
ENDIF


IF (CUST.DATA.ChrgCode =="IIMT") THEN
	IF  (CUST.DATA.SetId =="EBC") THEN
		CUST.DATA.COMM="SWIFTCOMM"
		CUST.DATA.VAT="VAT"
		CUST.DATA.RCC="RCCOM"
		CUST.DATA.RCC1="none"
	ELSE
		CUST.DATA.COMM="SWIFTCOMM"
		CUST.DATA.VAT="VAT"
		CUST.DATA.RCC="BCDCRCCOM"
		CUST.DATA.RCC1="BCRCCOM"
	ENDIF
ENDIF

IF (CUST.DATA.ChrgCode =="CHQ") THEN
	IF  (CUST.DATA.SetId =="EBC") THEN
		CUST.DATA.COMM="CHQREJ"
		CUST.DATA.VAT="VAT"
		CUST.DATA.RCC="none"
		CUST.DATA.RCC1="none"
	ELSE
		CUST.DATA.COMM="RTGSCOMM"
		CUST.DATA.VAT="VAT"
		CUST.DATA.RCC="none"
		CUST.DATA.RCC1="none"
	ENDIF

ENDIF

IF (CUST.DATA.ChrgCode =="NMT") THEN
	IF  (CUST.DATA.SetId =="EBC") THEN
		CUST.DATA.COMM="RTGSCOMM"
		CUST.DATA.VAT="VAT"
		CUST.DATA.RCC="none"
		CUST.DATA.RCC1="none"
	ELSE
		CUST.DATA.COMM="RTGSCOMM"
		CUST.DATA.VAT="VAT"
		CUST.DATA.RCC="none"
		CUST.DATA.RCC1="none"
	ENDIF
ENDIF

IF  (CUST.DATA.SetId =="BCDC") THEN

	sv_q = " foracid,acct_crncy_code,sol,Chrg_Code,acct_name| select  foracid, acct_crncy_code, Sol_id, Chrg_Code, ACCT_NAME from "
	sv_q = sv_q + " ( select foracid, acct_crncy_code, Sol_id,   CASE when BACID ='VAT' then 'VAT'   when BACID ='SWIFTCOMM' then 'COMMISSION'    WHEN BACID ='RTGSCOMM' then 'COMMISSION'  WHEN BACID ='CHQREJ'  "
	sv_q = sv_q + "  then 'COMMISSION' ELSE 'NONE' END Chrg_Code,   ACCT_NAME  from  tbaadm.gam    where bacid  in ( ?SVAR, ?SVAR ) and sol_id in  "
	sv_q = sv_q + "  (select sol_id from tbaadm.sst where set_id in (  ?SVAR ) ) and bank_id  =  ?SVAR  union select foracid  ,acct_crncy_code , sst.sol_id,   CASE  when BACID ='BCDCRCCOM' "
	sv_q = sv_q + " then 'RCC' WHEN BACID ='BCRCCOM' then 'RCC_OTH' end Chrg_Code,ACCT_NAME   from tbaadm.gam , tbaadm.sst where gam.bank_id =  ?SVAR and set_id in ( ?SVAR ,'5000') and  bacid in ( ?SVAR, ?SVAR) ) order by  Chrg_Code,Sol_id "
	BANCS.INPARAM.BINDVARS = CUST.DATA.COMM  + "|" + CUST.DATA.VAT + "|"  + CUST.DATA.SetId + "|" + BANCS.STDIN.contextBankId   + "|" +  BANCS.STDIN.contextBankId   + "|" +   CUST.DATA.SetId + "|" +   CUST.DATA.RCC + "|" + CUST.DATA.RCC1 

ELSE
	sv_q = " foracid,acct_crncy_code,sol,Chrg_Code,acct_name| "
	sv_q = sv_q + " select foracid, acct_crncy_code, Sol_id, CASE when BACID ='VAT' then 'VAT' when BACID ='RCCOM' then 'RCC'when BACID ='SWIFTCOMM' then "
	sv_q = sv_q + " 'COMMISSION' WHEN BACID ='RTGSCOMM' then 'COMMISSION' WHEN BACID ='CHQREJ' then 'COMMISSION' ELSE 'NONE' END Chrg_Code, ACCT_NAME from " 
	sv_q = sv_q + " tbaadm.gam where bacid  in (?SVAR,?SVAR,?SVAR,?SVAR) and sol_id in (select sol_id from tbaadm.sst where set_id =?SVAR ) and bank_id  =  ?SVAR ORDER BY Chrg_Code,Sol_id "
	BANCS.INPARAM.BINDVARS = CUST.DATA.COMM  + "|" + CUST.DATA.VAT + "|" + CUST.DATA.RCC + "|" + CUST.DATA.RCC1 + "|" + CUST.DATA.SetId + "|" + BANCS.STDIN.contextBankId
ENDIF



print(sv_q)

print(BANCS.INPARAM.BINDVARS)
sv_e = urhk_dbCursorOpenWithBind(sv_q)

IF(sv_e==0) THEN
#{
		sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
		sv_q = urhk_dbCursorFetch(sv_m)
		print(sv_q)
			IF(sv_q == 1) THEN
				sv_x = urhk_dbCursorClose(sv_m)
				print(sv_x)
				EXITSCRIPT
			ENDIF
		print(sv_q)

	WHILE (sv_q==0)


		CUST.DATA.foracid= BANCS.OUTPARAM.foracid
		print (CUST.DATA.foracid)
		CUST.DATA.acct_crncy_code= BANCS.OUTPARAM.acct_crncy_code 
		print (CUST.DATA.acct_crncy_code)
		CUST.DATA.sol= BANCS.OUTPARAM.sol 
		print (CUST.DATA.sol)	        
		CUST.DATA.Acct_Name= BANCS.OUTPARAM.acct_name 
		print (CUST.DATA.Acct_Name)
		CUST.DATA.Chrg_Code= BANCS.OUTPARAM.Chrg_Code
		print (CUST.DATA.Chrg_Code)

		

sv_a = "Account.<rec_" + CUST.DATA.number + ">.ACCTNUM|" + CUST.DATA.foracid
sv_b = "Account.<rec_" + CUST.DATA.number + ">.acct_crncy_code|" + CUST.DATA.acct_crncy_code
sv_c = "Account.<rec_" + CUST.DATA.number + ">.sol|" + CUST.DATA.sol
sv_d = "Account.<rec_" + CUST.DATA.number + ">.Acct_Name|" + CUST.DATA.Acct_Name
sv_e = "Account.<rec_" + CUST.DATA.number + ">.Chrg_Code|" + CUST.DATA.Chrg_Code

sv_u = urhk_SetOrbOut(sv_a)
sv_u = urhk_SetOrbOut(sv_b)
sv_u = urhk_SetOrbOut(sv_c)
sv_u = urhk_SetOrbOut(sv_d)
sv_u = urhk_SetOrbOut(sv_e)

			
#sv_t = "CustTran.<rec_" + CUST.DATA.number + ">.ACCT_NAME|" + CUST.DATA.ACCT_NAME
	sv_j =sv_j + 1
	CUST.DATA.number = sv_j

	sv_q = urhk_dbCursorFetch(sv_m)
	print(sv_q)
	DO

	ELSE
		CUST.DATA.errMsg="Data Error"
		sv_e=urhk_SetOrbOut("StattusCode|Error")
		sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
	ENDIF


ENDIF

END:
EXITSCRIPT
trace off
END-->

