#------------------------------------------------------------------------------------------------    
#   Name			: laadisbdp006.scr
#   Description		: This is called from new popup window to validate fields values.
#   Date			: 31-03-2013
#   Author			: Samrat
#   Input			: NA
#   Output			: NA
#   Called Script	: Called from many scripts
#   Calling Script	: laadisbdp004.scr, laadisbdp008.scr
#   Menu Option		:
#	Srl. No         Date            Author          	Description.
#	-------         ------          ------          	------------
#   1.0             31-03-2013      Samrat				Original Version
#-----------------------------------------------------------------------------------------------

<--START
CHECKSUM="098025036d92b95e45b887e2bd0cc941be43bdef2db7868f77e787d1570d4f90"
	TRACE ON
	
	#------------------------------------------------------------------------------
	# Creating repository and class
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","LADISB") == 0) THEN
	#{
		CREATECLASS("CUST","LADISB",5)
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","CPARAM") == 0) THEN
	#{
		CREATECLASS("CUST","CPARAM",5)
	#}
	ENDIF
	
	sv_u = urhk_Setorbout("Error|dummy")
	sv_u = urhk_Setorbout("iponame|dummy")
	sv_u = urhk_Setorbout("particulars|dummy")
	sv_u = urhk_Setorbout("ref|dummy")
	
	#---------------------------------------------------------------------------
	# Getting values from frontend form
	#---------------------------------------------------------------------------
	CUST.LADISB.loanAcctId 			= BANCS.INPUT.loanAcctId
	print(CUST.LADISB.loanAcctId)
	CUST.LADISB.disbAmt 			= BANCS.INPUT.disbAmt
	print(CUST.LADISB.disbAmt)
	CUST.LADISB.shareInvAcct 		= BANCS.INPUT.shareInvAcct
	print(CUST.LADISB.shareInvAcct)
	CUST.LADISB.cdsnumber			= BANCS.INPUT.cdscNo
	print(CUST.LADISB.cdsnumber)
	CUST.LADISB.comfirm				= BANCS.INPUT.cnfrm
	print(CUST.LADISB.comfirm)
	CUST.LADISB.category			= BANCS.INPUT.category
	CUST.LADISB.particulars			= " "
	CUST.LADISB.ref					= "dummy"
	CUST.LADISB.errMsg				= ""
	
	#---------------------------------------------------------------------------
	# Calling common script for calculation of loan fee amount
	#---------------------------------------------------------------------------
	print(CUST.LADISB.loanAcctId)
	CALL("laadisbdp004.scr")
	IF (CUST.LADISB.errMsg != "" ) THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#---------------------------------------------------------------------------
	# Calling common script for cparam values
	#---------------------------------------------------------------------------
	CUST.LADISB.stepVal="6"
	CALL("laadisbdp008.scr")
	IF (CUST.LADISB.errMsg != "" ) THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#---------------------------------------------------------------------------
	#The foll step is to Validate Share investment collection account
	#---------------------------------------------------------------------------
	IF (CUST.LADISB.shareInvAcct != "") THEN
	#{
		sv_u = urhk_getAcctDetailsInRepository(CUST.LADISB.shareInvAcct)
		
		IF (sv_u == 0) THEN
		#{
			CUST.LADISB.ipobacid		= BANCS.OUTPARAM.acctPlaceHolder
			CUST.LADISB.iponame			= BANCS.OUTPARAM.acctName
			PRINT(CUST.LADISB.ipobacid)
			PRINT(CUST.LADISB.iponame)
			
			IF ((CUST.LADISB.ipobacid != CUST.CPARAM.ipobacid1) AND (CUST.LADISB.ipobacid != CUST.CPARAM.ipobacid2) AND (CUST.LADISB.ipobacid != CUST.CPARAM.ipobacid3)) THEN
			#{
				CUST.LADISB.errMsg = "Collections Account Entered is not allowed for Shares investment  contact support for assistance"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			#}
		ELSE
			#{
			CUST.LADISB.errMsg = "Invalid Shares Investment collections Account ...contact support for assistance"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	#---------------------------------------------------------------------------
	# The following step is to Validate Cds number
	#---------------------------------------------------------------------------
	IF (FIELDEXISTS(CUST.LADISB.cdsnumber) == 0) THEN
	#{
		PRINT (CUST.LADISB.contrb100)
		PRINT (CUST.LADISB.cdsApp)
		
		CUST.LADISB.cdscamount=CDOUBLE(CUST.LADISB.contrb100)+CDOUBLE(CUST.LADISB.cdsApp)
		PRINT(CUST.LADISB.cdscamount)
		sv_s = "response|SELECT CUSTOM.VALIDATE_IPO_APPLICATION (?SVAR,?SVAR,?SVAR,?SVAR) FROM DUAL "
		PRINT(sv_s)
		BANCS.INPARAM.BINDVARS	=""
		BANCS.INPARAM.BINDVARS	=BANCS.INPARAM.BINDVARS+ CUST.LADISB.cdsnumber		+ "|"
		BANCS.INPARAM.BINDVARS	=BANCS.INPARAM.BINDVARS+ CUST.LADISB.shareInvAcct	+ "|"
		BANCS.INPARAM.BINDVARS	=BANCS.INPARAM.BINDVARS+ CUST.LADISB.cdscamount		+ "|"
		BANCS.INPARAM.BINDVARS	=BANCS.INPARAM.BINDVARS+ BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		
		sv_u=urhk_dbSelectWithBind(sv_s)
		
		PRINT(sv_u)
		IF ( sv_u != 0 ) THEN
		#{
			CUST.LADISB.errMsg = "An error has occured. Please contact Support."
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			print(BANCS.OUTPARAM.response)
			CUST.LADISB.cdsc			= MID$(BANCS.OUTPARAM.response,0,1)
			PRINT(CUST.LADISB.cdsc)
			CUST.LADISB.response		= MID$(BANCS.OUTPARAM.response,2,2)
			PRINT(CUST.LADISB.response)
			CUST.LADISB.iponame			= MID$(BANCS.OUTPARAM.response,5,50)
			PRINT(CUST.LADISB.iponame)
			
			IF (CUST.LADISB.response != "00") THEN
			#{
				CUST.LADISB.errMsg 			=  "FAILED........"+CUST.LADISB.iponame
				GOTO ENDOFSCRIPT
				#}
			ELSE
				#{
				IF ((CUST.LADISB.cdsc == CUST.CPARAM.cdsc1) OR (CUST.LADISB.cdsc == CUST.CPARAM.cdsc2)) THEN
				#{
					IF (CUST.LADISB.cdsc == CUST.CPARAM.cdsc1) THEN
					#{
						CUST.LADISB.ref		= CUST.LADISB.category + CUST.CPARAM.eqbc + CUST.LADISB.cdsnumber
						#}
					ELSE
						#{
						CUST.LADISB.ref		= CUST.LADISB.category + CUST.CPARAM.eqt + CUST.LADISB.cdsnumber
					#}
					ENDIF
				#}
				ENDIF
				
				print(CUST.LADISB.ref)
				CUST.LADISB.particulars = CUST.LADISB.ref +" "+ CUST.LADISB.iponame
				PRINT(CUST.LADISB.particulars)
				CUST.LADISB.name=CUST.LADISB.iponame
				PRINT(CUST.LADISB.name)
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	PRINT(CUST.LADISB.comfirm)
	IF (CUST.LADISB.comfirm == "N") THEN
	#{
		CUST.LADISB.iponame		= "dummy"
		CUST.LADISB.particulars	= "dummy"
		CUST.LADISB.ref			= "dummy"
	#}
	ENDIF
	
	sv_u = urhk_Setorbout("iponame|"+CUST.LADISB.iponame)
	#CUST.LADISB.particulars = LTRIM(CUST.LADISB.particulars)
	print(CUST.LADISB.particulars)
	sv_u = urhk_Setorbout("particulars|"+CUST.LADISB.particulars)
	sv_u = urhk_Setorbout("ref|"+CUST.LADISB.ref)
	
	ENDOFSCRIPT:
		IF (CUST.LADISB.errMsg != "" ) THEN
		#{
			sv_u = urhk_Setorbout("Error|"+CUST.LADISB.errMsg)
		#}
		ENDIF
		
		EXITSCRIPT
END-->
