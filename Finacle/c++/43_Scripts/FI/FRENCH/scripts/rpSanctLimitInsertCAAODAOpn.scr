#======================================================#
#Source Name                    :rpSanctLimitInsertCAAODAOpn.scr
#Menu                           :HOAACOD/HOAACCA
#Date                           :27-03-2023
#Description                    :To Add commission charge applicable date in custom.oda_commmission_tbl.
#Author                         :Ranjith Palani
#Calling Service Script		:SRV_OpenODAcct_post_process_data.scr/SRV_OpenCAAcct_post_process_data.scr
#======================================================#
<--start
trace on
	if(REPEXISTS("CUST") == 0)then
		CREATEREP("CUST")
	endif

	if(CLASSEXISTS("CUST","DRCODC") == 0)then
		CREATECLASS("CUST","DRCODC",5)
	endif

	sv_b = urhk_B2k_PrintRepos("BANCS")
	print(sv_b)

	sv_p = urhk_B2k_PrintRepos("ONS")
	print(sv_p)

	sv_c = ONS.CUSTOM.custDataIn
	print(sv_c)
	if(trim(ONS.CUSTOM.custDataIn) != "")then
		sv_o = urhk_ParseONSCustData(sv_c)
		print(sv_o)
	endif

	CUST.DRCODC.commChrgPrcnt = ""
	sv_a= urhk_SRV_GetVal("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmType")
	if(sv_a == 0)then
		CUST.DRCODC.schmType = BANCS.OUTPARAM.srvValue
	endif

	if(CUST.DRCODC.schmType == "ODA")then
		if(fieldexists(BANCS.INPUT.general_details_FIELD_7) == 1)then
			CUST.DRCODC.commChrgPrcnt = BANCS.INPUT.general_details_FIELD_7
			print(CUST.DRCODC.commChrgPrcnt)
		endif
	endif

	if(CUST.DRCODC.schmType == "CAA")then
		sv_a= urhk_SRV_GetVal("acctCommonInfo.acctClassMISC.freeText1")
		if(sv_a == 0)then
			CUST.DRCODC.commChrgPrcnt = BANCS.OUTPARAM.srvValue
		endif
	endif

	sv_a= urhk_SRV_GetVal("acctCommonInfo.acctGeneralInfo.acctBasic.acid")
	if(sv_a == 0)then
		CUST.DRCODC.acid = BANCS.OUTPARAM.srvValue
	endif

	sv_a= urhk_SRV_GetVal("acctCommonInfo.acctGeneralInfo.acctBasic.foracid")
	if(sv_a == 0)then
		CUST.DRCODC.foracid = BANCS.OUTPARAM.srvValue
	endif

	sv_a= urhk_SRV_GetVal("acctCommonInfo.acctLimits.sanctionLimit")
	if(sv_a == 0)then
		CUST.DRCODC.sanctionLimit = BANCS.OUTPARAM.srvValue
	endif

	sv_a= urhk_SRV_GetVal("acctCommonInfo.acctLimits.sanctDate")
	if(sv_a == 0)then
		CUST.DRCODC.sanctDate = BANCS.OUTPARAM.srvValue
	endif

	sv_a= urhk_SRV_GetVal("acctCommonInfo.acctLimits.applicableDate")
	if(sv_a == 0)then
		CUST.DRCODC.applicableDate = BANCS.OUTPARAM.srvValue
	endif

	sv_a= urhk_SRV_GetVal("acctCommonInfo.acctLimits.expiryDate")
	if(sv_a == 0)then
		CUST.DRCODC.expiryDate = BANCS.OUTPARAM.srvValue
	endif

	sv_a= urhk_SRV_GetVal("acctCommonInfo.acctGeneralInfo.acctBasic.acctOpnDate")
	if(sv_a == 0)then
		CUST.DRCODC.acctOpnDate = BANCS.OUTPARAM.srvValue
	endif

	sv_a= urhk_SRV_GetVal("acctCommonInfo.acctGeneralInfo.acctBasic.acctOpnDate")
	if(sv_a == 0)then
		CUST.DRCODC.acctOpnDate = BANCS.OUTPARAM.srvValue
	endif

	sv_a= urhk_SRV_GetVal("acctCommonInfo.acctGeneralInfo.acctBasic.schmCode.schmCode")
	if(sv_a == 0)then
		CUST.DRCODC.schmCode = BANCS.OUTPARAM.srvValue
	endif

	sv_a= urhk_SRV_GetVal("acctCommonInfo.acctGeneralInfo.acctBasic.solId.solId")
	if(sv_a == 0)then
		CUST.DRCODC.solId = BANCS.OUTPARAM.srvValue
	endif

	sv_a= urhk_SRV_GetVal("acctCommonInfo.acctLimits.acctLimitsEntered")
	if(sv_a == 0)then
		CUST.DRCODC.acLimEntred = BANCS.OUTPARAM.srvValue
	endif

	if(CUST.DRCODC.acLimEntred == 0)then
		exitscript
	endif

	CUST.DRCODC.serialNum = "000000000001"
	CUST.DRCODC.commChargeApplicableDate = CUST.DRCODC.sanctDate

	sv_i = "insert into custom.oda_commission_chrg_tbl"
	sv_i = sv_i + " (com_acid,com_foracid,com_serial_num,com_sanct_limit,com_crncy_code,com_sanct_date,"
	sv_i = sv_i + " com_applicalbe_date,com_expiry_date,com_charge_applicable_date,bank_id,com_charge_percentage,"
	sv_i = sv_i + " acct_opn_date,com_schm_code,com_schm_type,com_sol_id)" 
	sv_i = sv_i + " values(?SVAR,?SVAR,?SVAR,?SVAR,?SVAR,to_date(?SVAR,'dd-mm-yyyy'),to_date(?SVAR,'dd-mm-yyyy'),to_date(?SVAR,'dd-mm-yyyy'),to_date(?SVAR,'dd-mm-yyyy'),?SVAR,?SVAR,"
	sv_i = sv_i + " to_date(?SVAR,'dd-mm-yyyy'),?SVAR,?SVAR,?SVAR)"
	print(sv_i)
	BANCS.INPARAM.BINDVARS = CUST.DRCODC.acid +"|"+ CUST.DRCODC.foracid +"|"+ CUST.DRCODC.serialNum +"|"+ CUST.DRCODC.sanctionLimit +"|"+ mid$(CUST.DRCODC.sanctDate,0,10) 
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ mid$(CUST.DRCODC.applicableDate,0,10) + "|" + mid$(CUST.DRCODC.expiryDate,0,10) + "|" + mid$(CUST.DRCODC.commChargeApplicableDate,0,10)
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ BANCS.STDIN.contextBankId +"|"+ CUST.DRCODC.commChrgPrcnt +"|"+ mid$(CUST.DRCODC.acctOpnDate,0,10) +"|"+ CUST.DRCODC.schmCode
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS +"|"+ CUST.DRCODC.schmType +"|"+ CUST.DRCODC.solId
	print(BANCS.INPARAM.BINDVARS)
	sv_i = urhk_dbSqlWithBind(sv_i)
	if(sv_i == 0)then
		sv_i = urhk_dbSqlWithBind("commit")
		print(sv_i)
	endif

	sv_u = "update tbaadm.lht set remarks=?SVAR where acid=?SVAR and serial_num=?SVAR and rcre_user_id=?SVAR and bank_id=?SVAR"
	BANCS.INPARAM.BINDVARS = CUST.DRCODC.commChrgPrcnt +"|"+ CUST.DRCODC.acid +"|"+ CUST.DRCODC.serialNum +"|"+ BANCS.STDIN.userId +"|"+ BANCS.STDIN.contextBankId 
	sv_u = urhk_dbSqlWithBind(sv_u)
	if(sv_u == 0)then
		sv_u = urhk_dbSqlWithBind("commit")
	endif

trace off
end-->
