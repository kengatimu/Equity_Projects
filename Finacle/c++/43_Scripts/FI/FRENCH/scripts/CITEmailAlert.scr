#------------------------------------------------------------------------------------------------
#  Name            : CITEmailAlert.scr
#  Description     : This script will get data required by <CITEmailAlert.com> for email notification
#  Date            : 17-aug-2023
#  Author          : Mark Nderitu
#  Input           : NA
#  Output          : NA
#  Called Script   : NA
#  Menu Option     : TBJMS
#  Srl. No         Date            Author               Description.
#  -------         ------          ------               ------------
#-----------------------------------------------------------------------------------------------
<--start
trace on


        CUST.ALERTS.isModuleType = "CITEMAIL"
		CUST.ALERTS.toAddr = CUST.ALERTS.parameterValue 
		print(CUST.ALERTS.toAddr)
		
					print(CUST.ALERTS.foracid) 
					print(CUST.ALERTS.sol_id)
					print(CUST.ALERTS.clr_bal_amt) 
					print(CUST.ALERTS.acct_name)

CUST.ALERTS.massage ="Dear Manager, Account " + CUST.ALERTS.foracid +" " + CUST.ALERTS.acct_name + " in sol ID " + CUST.ALERTS.sol_id
			CUST.ALERTS.massage = CUST.ALERTS.massage + " is not nilled off and end of day process cannot complete. Ensure its nilled off immediately"
			PRINT (CUST.ALERTS.massage)
			
        sv_u = urhk_getFileLocation("COM|CITEmailAlert.com")
        if(sv_u ==0)then
                print(BANCS.OUTPARAM.fileLocation)
                CUST.ALERTS.comfil = BANCS.OUTPARAM.fileLocation + "CITEmailAlert.com"
                print(CUST.ALERTS.comfil)
                print(CUST.ALERTS.toAddr)
            if(CUST.ALERTS.isModuleType=="CITEMAIL")then
			CUST.ALERTS.comfil = CUST.ALERTS.comfil + " " +'"'+ CUST.ALERTS.toAddr + '"'+" " +'"'+ CUST.ALERTS.massage+ '"' + " " +'"'+ CUST.ALERTS.toAddr +'"'+ " " 
			endif
        else
                CUST.ALERTS.comfil   = ""
        endif
        if(CUST.ALERTS.comfil != "")then
                print(CUST.ALERTS.comfil)
                sv_u = system(CUST.ALERTS.comfil)
                if(sv_u ==0)then
                        print("smtp success")
                else
                        print("failed smtp")
                endif
        endif
trace off
end-->

