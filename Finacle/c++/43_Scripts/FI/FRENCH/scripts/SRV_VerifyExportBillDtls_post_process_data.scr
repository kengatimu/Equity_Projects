				IF ((CUST.CRT.bill_type == "IBOCU") or (CUST.CRT.bill_type == "IBOID") or (CUST.CRT.bill_type == "IBOCF") or (CUST.CRT.bill_type == "IBOLPO") or (CUST.CRT.bill_type == "IBCOM") ) THEN
