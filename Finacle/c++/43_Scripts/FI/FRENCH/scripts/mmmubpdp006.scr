                                        sv_s = sv_s + " FROM TBAADM.GEC ,tbaadm.upr "
                                        sv_s = sv_s + " WHERE gec.SOL_ID=?SVAR "
                                        sv_s = sv_s + " AND gec.BANK_ID=?SVAR "
                                        sv_s = sv_s + " AND gec.CRNCY_CODE=?SVAR "
                                        sv_s = sv_s + " AND upr.USER_ID=?SVAR  and upr.USER_EMP_ID= gec.EMP_ID and gec.BANK_ID= upr.HOME_BANK_ID group by gec.EMP_ID "
