#********************************************************************************
#    Report Name                        :      daily_dr02.mrt                 *
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
#################################################################################
RECORDLAYOUT  
	type			stringType
	foracid 		stringType
	acct_name 		stringType 
	sol_id 			stringType
	schm_code		stringType
	last_frez_date 		stringType
	bal_on_frez_date 	numberType 
	frez_reason_code  	stringType
	ref_desc  		stringType

#################################################################################
LOCALVARIABLES

	page_number     numberType
	lv_setid	stringType  
	callscript      stringType
	lv_setdesc	stringType
	lv_userId	stringType 
	ipstype		stringtype
	
	
#################################################################################
GROUPANDSORT

sol_id,schm_code,last_frez_date

#################################################################################
PAGEFORMAT

	widowOrphanLines 2
	LinesPerPage 	65 
	LeftMargin 	2 
	rightMargin 	2	
	columnsPerLine 	132
   	pageHeaderLines	12
	pageFooterLines 1 
	ignoreblankrecord

#################################################################################
REPOSITORY  bankRepos.rip

        bankName       StringType
        branchName     StringType

#################################################################################  
REPOSITORY argv4  

ipSetId				stringType
ipFrmDate			stringType
ipToDate			stringType
iptype				stringType

#################################################################################
ONSTARTOFREPORT

	set page_number = 1
	begin
	 if iptype ="F" 
	  set ipstype = "R"
         if iptype = "R"
	   set ipstype = "F"
	 if iptype ="A"
	  set ipstype ="A"
	  
	end
	execute brBankHdg 
	execute pageHdg
		
################################################################################# 
PAGEHEADER 

        execute brBankHdg 
	execute pageHdg 

################################################################################# 
PAGEFOOTER

	execute  Line

################################################################################# 
# IGNORERECORD 
################################################################################# 
IGNORERECORD
  
  if type = ipstype


ONEVERYRECORD 	

begin
   	execute pipe	
	 print last_frez_date    column 2
	 print foracid		 column 14
	 print acct_name         column 31
	 print bal_on_frez_date  column 56 format "#,###,###,###.##"
	 print ref_desc          column 74
	
	
end

################################################################################# 
ONENDOFREPORT

begin

                if ( totalCount foracid = 0 )
        begin
                nextline
                nextline
                nextline
                separatorline
                print "  NO RECORD SELECTED FOR THE GIVEN CRITERIA " column 20
                separatorline
        end
		else

	begin
		execute line
                nextline
                nextline
		nextline
		nextline
		print "       Printed By:  " column 20
               print lv_userId
		print "                          Verified By: " 
                nextline
		print today  column 20  
	end
end

################################################################################# 
PROCEDURE brBankHdg

begin
        print "Page No. "   column 75
        print page_number precision 0
        nextline
        print today column 75 
        nextline
        nextline
	print "            EQUITY BANK LIMITED" column 25
	nextline
        set lv_setid = ipsetId
    	set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
        print lv_setdesc column 40

        set page_number= page_number+1
	nextline
end

################################################################################# 
PROCEDURE pageHdg

begin
        nextline
	begin
	 if iptype = "A"
		print "         Freezed / Released  Accounts  Between  " column 20
	 if iptype= "F"
		print "            Freezed  Accounts  Between  " column 20
	 if iptype = "R"
		print "            Released Accounts  Between  " column 20
	end
	nextline
	print ipFrmDate column 35
	print " & "
	print ipToDate
        nextline
        print "            ==========================================" column 14
        nextline
	nextline
	execute Line
	nextline
	execute pipe
	print "Date"		column 2
	print "Account Number"  column 14
	print "Name"		column 31
	print "Balance"		column 56
	print "Remarks"		column 74
	nextline
	execute line
	nextline
end	
#################################################################################
PROCEDURE Line

begin
    print "-----------------------------------------------------------------------------------------------" column 1
end
#################################################################################
PROCEDURE pipe

begin
	print "|"               column 1
        print "|"               column 13
        print "|"               column 30
        print "|"               column 55
        print "|"               column 73
        print "|"               column 95
	
end
######################################################---END---##############################################################

