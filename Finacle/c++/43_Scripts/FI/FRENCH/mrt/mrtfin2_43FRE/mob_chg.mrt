###############################################################################
RECORDLAYOUT
###############################################################################
type				stringtype
foracid				stringtype
sol_id				stringtype
schm_code			stringtype
###############################################################################
LOCALVARIABLES
###############################################################################
ind				stringtype
crncy				stringtype
sol_lpad			stringtype
for_lpad			stringtype
clr_lpad			stringtype
takataka			stringtype
taka_lp				stringtype
trap_lpad			stringtype
tran_part			stringtype
amt				stringtype
tot				numbertype
###############################################################################
GROUPANDSORT
###############################################################################
schm_code,type
###############################################################################
PAGEFORMAT
###############################################################################
ColumnsPerLine  900
LinesPerPage    10000 
LeftMargin       00
RightMargin      00
Topmargin        00
BottomMargin     00
pageHeaderLines  00
pageFooterLines  00
##############################################################################
ONEVERYRECORD
##############################################################################
if (type = "C") 
begin
	set ind = "D"
	set amt = "50"
	set tran_part = "MOBILE CHARGES"
        set tot = tot + 50
end

if (type = "O")
begin
        set ind = "C"
	set amt = numToStr tot
	set tran_part = "CHARGES FROM"
	set tran_part = StrCat tran_part sol_id
	set tot = 0
end

set for_lpad = rpad foracid 16 " "
print for_lpad size 16 column 1

print crncy column 17

set sol_lpad = rpad sol_id 8 " "
print sol_id size 8 column 20

print ind column 28

set clr_lpad = lpad amt 17 " "
print clr_lpad size 17 column 29

set trap_lpad = rpad tran_part 30 " "
print trap_lpad size 30 column 46

set takataka = lpad takataka 800 " "
print takataka size 800 column 76

##############################################################################
ONSTARTOFREPORT
##############################################################################
set crncy = "KES"
set takataka = " " 
##############################################################################
ONENDOFREPORT
##############################################################################
##############################################################################
PAGEHEADER
##############################################################################
