	daybook_for_crncy_desc	stringType
	consol_for_crncy_flg	stringType
	gpr_defn_num		stringType
	gpr_levl_num		numberType
	gpr_levl_desc		stringType	
	gpr_range_key		stringType
	gpr_det_flg		stringType
	set_id			stringType
	sol_id			stringType
	gl_sub_head_code	stringType
	gl_sub_head_desc	stringType
	tot_dr_bal		numberType
	tot_cr_bal		numberType
	tot_cash_dr_amt		numberType
	tot_clg_dr_amt		numberType
	tot_xfer_dr_amt		numberType
	num_of_cash_dr_part_tran	numberType
	num_of_clg_dr_part_tran		numberType
	num_of_xfer_dr_part_tran	numberType
	tot_cash_cr_amt		numberType
	tot_clg_cr_amt		numberType
	tot_xfer_cr_amt		numberType
