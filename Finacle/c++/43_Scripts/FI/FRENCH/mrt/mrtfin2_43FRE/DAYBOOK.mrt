PROCEDURE PrintRptHeader
################################################################
	print today 
 	print bankName column 37
	print "     "
	nextline

	set check_str = substr gpr_rpt_num 1 2

	if check_str = "BS"
	begin
		print "BALANCE SHEET For " column 40
	end
	else
	begin
		if check_str = "PL"
			print "PROFIT AND LOSS STATEMENT For " column 35
		else
			print "TRIAL BALANCE For " column 40
	end

	print substr date_diff 1 10 
	nextline
	separatorLine
	nextline
	print "SOL ID is                         : "
	if pg0_set_id = "ALL"
	begin
		print "CONSOLIDATED"
	end
	else
	begin
		print pg0_set_id
		print " ("
		print set_desc
		print ") "
	end
	nextline
	print "Date For Which Report is Produced : "
	print substr date_diff 1 10 
	nextline
	print "Currency                          : "
	print consol_for_crncy_code
	if consol_for_crncy_code !=""
	begin
		print " ("
		print consol_for_crncy_name
		print ")"
	end
	nextline
	print "Consolidation in Currency         : "
	print consol_in_crncy_code
	if consol_in_crncy_code !=""
	begin
		print " ("
		print consol_in_crncy_name
		print ")"
	end
