##############################################################
PROCEDURE PrintSummary1
##############################################################
	nextline
	nextline
	set check_str = substr gpr_rpt_num 1 2

	
	set totclosb = totclosb - a_safe_amt_cr + l_safe_amt_dr - fa_safe_amt_cr + fl_safe_amt_dr

	set t1_totclosb = abs totclosb

	if t1_totclosb > 2 or t1_totclosb = 0
	begin
		set t2_totclosb = 0
	end
	else
	begin
		print "ROUNDOFF FACTOR "
		set t2_totclosb = totclosb*(-1)
		set totclosb = totclosb + t2_totclosb
		print t2_totclosb autocomma size 19 column 60
		nextline
	end

	if check_str = "BS"
	begin
		print "TOTAL FOR BALANCE SHEET " column 1
	end
	else
	begin
		if check_str = "PL"
			print "PROFIT / LOSS " column 1
		else
			print "TOTAL FOR TRIAL BALANCE "
	end		
	print "("
	print crncy
	print ")"
	if gpr_consol_flg != "Y"
	begin 
		print  totopenb autocomma size 19 column 33 
#		print totopenb format "$$"
		print totdramt autocomma size 19 column 55 
		print totdrnum format "####" column  75
	end
	print  totclosb autocomma size 19 column 60 
#	print totclosb format "$$"
	if gpr_consol_flg != "Y"
	begin 
		print totcramt autocomma size 19 column 80 
		print totcrnum format "####" column  100
	end
	nextline
	nextline
