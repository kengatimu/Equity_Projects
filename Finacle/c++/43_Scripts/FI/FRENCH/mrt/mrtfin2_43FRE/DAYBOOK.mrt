##########################################################
PAGEFORMAT
##########################################################
LinesPerPage     58
LeftMargin        2
rightMargin       2
Topmargin         2
BottomMargin      2
columnsPerLine  132
pageHeaderLines  5
pageFooterLines  2
##########################################################
ONSTARTOFREPORT
##########################################################
	execute PrintRptHeader
	set safe_amt = 0
	set a_safe_amt_dr = 0
	set a_safe_amt_cr = 0
	set l_safe_amt_dr = 0
	set l_safe_amt_cr = 0
	set fa_safe_amt_dr = 0
	set fa_safe_amt_cr = 0
	set fl_safe_amt_dr = 0
	set fl_safe_amt_cr = 0
	set openb1 = 0.0
	set closb1 = 0.0
	set dramt1 = 0.0
	set cramt1 = 0.0
	set drnum1 = 0
	set crnum1 = 0
	set openb2 = 0.0
	set closb2 = 0.0
	set dramt2 = 0.0
	set cramt2 = 0.0
	set drnum2 = 0
	set crnum2 = 0
	set openb3 = 0.0
	set closb3 = 0.0
	set dramt3 = 0.0
	set cramt3 = 0.0
	set drnum3 = 0
	set crnum3 = 0
	set openb4 = 0.0
	set closb4 = 0.0
	set dramt4 = 0.0
	set cramt4 = 0.0
	set drnum4 = 0
	set crnum4 = 0
	set flg1 = 1
	set flg2 = 1
	set flg3 = 1
	set flg4 = 1
	set flg5 = 1
	set totopenb = 0.0
	set totclosb = 0.0
	set totdramt = 0.0
	set totcramt = 0.0
	set totdrnum = 0
	set totcrnum = 0
##########################################################
ONENDOFREPORT 
##########################################################
	nextline
	nextline
	nextline
	print "Signature  :"
	nextline
	nextline
	separatorline
	print "***  " column 35
	print pageNumber size 3 precision 0
	print "  pages printed. End of report *** " 
 	set page_number = pageNumber
##########################################################
PAGEHEADER 
##########################################################
	nextline
    print today
    print bankName column 37
    print "     "
    nextline

    set check_str = substr gpr_rpt_num 1 2

    if check_str = "BS"
    begin
        print "BALANCE SHEET For " column 40
    end
    else
    begin
        if check_str = "PL"
            print "PROFIT AND LOSS STATEMENT For " column 35
        else
            print "TRIAL BALANCE For " column 40
    end
	print substr date_diff 1 10

	nextline
	if pg0_set_id = "ALL"
    begin
        print "CONSOLIDATED" column 45
    end
    else
    begin
        print pg0_set_id  column 45
        print " ("
        print set_desc
        print ") "
    end
##########################################################
PAGEFOOTER
##########################################################
nextline
#separatorline
print "Page No  : " column 65
print pageNumber size 3 precision 0 

##########################################################
BEFOREBREAKOF sol_id 
##########################################################

if sol_id != ""
begin 
#  nextpage 
end

##########################################################
BEFOREBREAKOF group_by_crncy_code
##########################################################
	if group_by_crncy_code != ""
	begin
		set crncy = group_by_crncy_code
		if (gpr_consol_flg != "Y") 
		begin
			print "Currency Code: "
			print crncy
			print "("
			print daybook_for_crncy_desc
			print ") "
		end
		nextline
		nextline
		set openb1 = 0.0
		set closb1 = 0.0
		set dramt1 = 0.0
		set cramt1 = 0.0
		set drnum1 = 0
		set crnum1 = 0
		set openb2 = 0.0
		set closb2 = 0.0
		set dramt2 = 0.0
		set cramt2 = 0.0
		set drnum2 = 0
		set crnum2 = 0
		set openb3 = 0.0
		set closb3 = 0.0
		set dramt3 = 0.0
		set cramt3 = 0.0
		set drnum3 = 0
		set crnum3 = 0
		set openb4 = 0.0
		set closb4 = 0.0
		set dramt4 = 0.0
		set cramt4 = 0.0
		set drnum4 = 0
		set crnum4 = 0
		set flg1 = 1
		set flg2 = 1
		set flg3 = 1
		set flg4 = 1
		set flg5 = 1
		set totopenb = 0.0
		set totclosb = 0.0
		set totdramt = 0.0
		set totcramt = 0.0
		set totdrnum = 0
		set totcrnum = 0
	end
##########################################################
BEFOREBREAKOF gpr_levl_num
##########################################################
		set curr_levl = gpr_levl_num
		execute PrintOldDetails
		if(gpr_levl_num = 1)
		begin
			set levl1 = gpr_levl_desc
			if(gpr_range_key="EMPTY")
			begin
				print gpr_levl_desc column 1
			end
			else
			begin
				if (gpr_det_flg != "N") 
					print gpr_levl_desc column 1 
			end
		end
		if(gpr_levl_num = 2)
		begin
			set levl2 = gpr_levl_desc
			if(gpr_range_key="EMPTY")
			begin
				print gpr_levl_desc column 4
			end
			else
			begin
				if (gpr_det_flg != "N")
                    print gpr_levl_desc column 4
            end
		end
		if(gpr_levl_num = 3)
		begin
			set levl3 = gpr_levl_desc
			if(gpr_range_key="EMPTY")
			begin
				print gpr_levl_desc column 7
			end
            else
            begin
                if (gpr_det_flg != "N")
                    print gpr_levl_desc column 7
            end
		end
		if(gpr_levl_num = 4)
		begin
			set levl4 = gpr_levl_desc
			if(gpr_range_key="EMPTY")
			begin
				print gpr_levl_desc column 10
			end
			else
            begin
                if (gpr_det_flg != "N")
                    print gpr_levl_desc column 10
            end
		end
		if(gpr_levl_num = 5)
		begin
			set levl5 = gpr_levl_desc
			if(gpr_range_key="EMPTY")
			begin
				print gpr_levl_desc column 13
			end
            else
            begin
                 if (gpr_det_flg != "N")
                    print gpr_levl_desc column 13
            end
		end
##########################################################
AFTERBREAKOF group_by_crncy_code
##########################################################
	if group_by_crncy_code != ""
	begin
		set curr_levl = 1
		execute PrintOldDetails
		execute PrintSummary1
		if gpr_consol_flg != "Y"
		begin 
			execute PrintSummary2
		end
#		nextpage
	end
	
##########################################################
AFTERBREAKOF gpr_levl_num
##########################################################
	if(gpr_range_key != "EMPTY")
	begin
	set prevlvl = gpr_levl_num
	set levls = gpr_levl_num - 1
	execute PrintDistance
#	print "Total For   "
	print gpr_levl_desc
#	nextline
			set amt =  groupSum old_cr_bal - groupSum old_dr_bal
			set amt = roundoff amt N 0.01
			set totopenb = totopenb + amt
			if(gpr_levl_num = 1)
			begin
				set openb1 = openb1 + amt
				set openb2 = openb2 + amt
				set openb3 = openb3 + amt
				set openb4 = openb4 + amt
			end
			if(gpr_levl_num = 2)
			begin
				set openb2 = openb2 + amt
				set openb3 = openb3 + amt
				set openb4 = openb4 + amt
			end
			if(gpr_levl_num = 3)
			begin
				set openb3 = openb3 + amt
				set openb4 = openb4 + amt
			end
			if(gpr_levl_num = 4)
			begin
				set openb4 = openb4 + amt
			end
			if gpr_consol_flg != "Y"
			begin 
				print  amt autocomma size 19 column 33 
#				print amt format "$$"
			end
			set amt =  groupSum tot_cash_dr_amt + groupSum tot_clg_dr_amt + groupSum tot_xfer_dr_amt
#			set amt = roundoff amt N 0.01
			set totdramt = totdramt + amt
			if(gpr_levl_num = 1)
			begin
				set dramt1 = dramt1 + amt	
				set dramt2 = dramt2 + amt	
				set dramt3 = dramt3 + amt	
				set dramt4 = dramt4 + amt	
			end
			if(gpr_levl_num = 2)
			begin
				set dramt2 = dramt2 + amt	
				set dramt3 = dramt3 + amt	
				set dramt4 = dramt4 + amt	
			end
			if(gpr_levl_num = 3)
			begin
				set dramt3 = dramt3 + amt	
				set dramt4 = dramt4 + amt	
			end
			if(gpr_levl_num = 4)
			begin
				set dramt4 = dramt4 + amt	
			end
			if gpr_consol_flg != "Y"
			begin 
				print amt autocomma size 19 column 55 
			end
			set amt =  groupSum num_of_cash_dr_part_tran + groupSum num_of_clg_dr_part_tran + groupSum num_of_xfer_dr_part_tran
			set totdrnum = totdrnum + amt
			if(gpr_levl_num = 1)
			begin
				set drnum1 = drnum1 + amt
				set drnum2 = drnum2 + amt
				set drnum3 = drnum3 + amt
				set drnum4 = drnum4 + amt
			end
			if(gpr_levl_num = 2)
			begin
				set drnum2 = drnum2 + amt
				set drnum3 = drnum3 + amt
				set drnum4 = drnum4 + amt
			end
			if(gpr_levl_num = 3)
			begin
				set drnum3 = drnum3 + amt
				set drnum4 = drnum4 + amt
			end
			if(gpr_levl_num = 4)
			begin
				set drnum4 = drnum4 + amt
			end
			if gpr_consol_flg != "Y"
			begin 
				print amt format "####" column 75
			end
			set amt =  groupSum tot_cash_cr_amt + groupSum tot_clg_cr_amt + groupSum tot_xfer_cr_amt
			set amt = roundoff amt N 0.01
			set totcramt = totcramt + amt
			if(gpr_levl_num = 1)
			begin
				set cramt1 = cramt1 + amt
				set cramt2 = cramt2 + amt
				set cramt3 = cramt3 + amt
				set cramt4 = cramt4 + amt
			end
			if(gpr_levl_num = 2)
			begin
				set cramt2 = cramt2 + amt
				set cramt3 = cramt3 + amt
				set cramt4 = cramt4 + amt
			end
			if(gpr_levl_num = 3)
			begin
				set cramt3 = cramt3 + amt
				set cramt4 = cramt4 + amt
			end
			if(gpr_levl_num = 4)
			begin
				set cramt4 = cramt4 + amt
			end
			if gpr_consol_flg != "Y"
			begin 
				print amt autocomma size 19 column 80 
			end
			set amt =  groupSum num_of_cash_cr_part_tran + groupSum num_of_clg_cr_part_tran + groupSum num_of_xfer_cr_part_tran
			set totcrnum = totcrnum + amt
			if(gpr_levl_num = 1)
			begin
				set crnum1 = crnum1 + amt
				set crnum2 = crnum2 + amt
				set crnum3 = crnum3 + amt
				set crnum4 = crnum4 + amt
			end
			if(gpr_levl_num = 2)
			begin
				set crnum2 = crnum2 + amt
				set crnum3 = crnum3 + amt
				set crnum4 = crnum4 + amt
			end
			if(gpr_levl_num = 3)
			begin
				set crnum3 = crnum3 + amt
				set crnum4 = crnum4 + amt
			end
			if(gpr_levl_num = 4)
			begin
				set crnum4 = crnum4 + amt
			end
			if gpr_consol_flg != "Y"
			begin 
				print amt format "####" column  100
			end
			set amt =  groupSum tot_cr_bal - groupSum tot_dr_bal
			set amt = roundoff amt N 0.01
			set totclosb = totclosb + amt
			if(gpr_levl_num = 1)
			begin
				set closb1 = closb1 + amt
				set closb2 = closb2 + amt
				set closb3 = closb3 + amt
				set closb4 = closb4 + amt
			end
			if(gpr_levl_num = 2)
			begin
				set closb2 = closb2 + amt
				set closb3 = closb3 + amt
				set closb4 = closb4 + amt
			end
			if(gpr_levl_num = 3)
			begin
				set closb3 = closb3 + amt
				set closb4 = closb4 + amt
			end
			if(gpr_levl_num = 4)
			begin
				set closb4 = closb4 + amt
			end
			if gpr_levl_desc = "OVERDRAFTS"	
			begin
				set safe_amt = amt

				set tamt =  groupSum tot_cr_bal
           		set tamt = roundoff tamt N 0.01
				set a_safe_amt_cr = tamt

				set tamt =  groupSum tot_dr_bal
           		set tamt = roundoff tamt N 0.01
				set a_safe_amt_dr = tamt

				set tamt =  tamt*(-1) 
            	set tamt = roundoff tamt N 0.01	
				if main_tag = "ASSETS" or main_tag = "EXPENSES"
				begin
					if tamt > 0
					begin
						set pamt = tamt * (-1)
						print  pamt autocomma size 19 column 60 
					end
					else
					begin
						set pamt = abs tamt
						print  pamt autocomma size 19 column 60 
					end
				end
				else
				begin
					print  tamt autocomma size 19 column 60 
				end
			end
			else
			begin
				if gpr_levl_desc = "CURRENT ACCOUNTS"
				begin
					set tamt =  groupSum tot_dr_bal
            		set tamt = roundoff tamt N 0.01
					set l_safe_amt_dr = tamt

					set tamt =  groupSum tot_cr_bal
            		set tamt = roundoff tamt N 0.01
					set l_safe_amt_cr = tamt

						if main_tag = "ASSETS" or main_tag = "EXPENSES"
						begin
							if tamt > 0
							begin
								set pamt = tamt * (-1)
								print  pamt autocomma size 19 column 60 
							end
							else
							begin
								set pamt = abs tamt
								print  pamt autocomma size 19 column 60 
							end
						end
						else
						begin
							print  tamt autocomma size 19 column 60 
						end
				end
				else
				begin
					if gpr_levl_desc = "OVERDRAFTS - FCY" 
					begin
						set safe_amt = amt

                		set tamt =  groupSum tot_cr_bal
                		set tamt = roundoff tamt N 0.01
                		set fa_safe_amt_cr = tamt

                		set tamt =  groupSum tot_dr_bal
                		set tamt = roundoff tamt N 0.01
                		set fa_safe_amt_dr = tamt

                		set tamt =  tamt*(-1)
                		set tamt = roundoff tamt N 0.01
						if main_tag = "ASSETS" or main_tag = "EXPENSES"
						begin
							if tamt > 0
							begin
								set pamt = tamt * (-1)
								print  pamt autocomma size 19 column 60 
							end
							else
							begin
								set pamt = abs tamt
								print  pamt autocomma size 19 column 60 
							end
						end
						else
						begin
							print  tamt autocomma size 19 column 60 
						end
					end
					else
					begin
						if gpr_levl_desc = "CURRENT ACCOUNTS - FCY"
						begin
							set tamt =  groupSum tot_dr_bal
                    		set tamt = roundoff tamt N 0.01
                    		set fl_safe_amt_dr = tamt

                    		set tamt =  groupSum tot_cr_bal
                    		set tamt = roundoff tamt N 0.01
                    		set fl_safe_amt_cr = tamt

							if main_tag = "ASSETS" or main_tag = "EXPENSES"
							begin
								if tamt > 0
								begin
									set pamt = tamt * (-1)
									print  pamt autocomma size 19 column 60 
								end
								else
								begin
									set pamt = abs tamt
									print  pamt autocomma size 19 column 60 
								end
							end
							else
							begin
								print  tamt autocomma size 19 column 60 
							end
						end
						else
						begin
							print  amt autocomma size 19 column 60 
							if main_tag = "ASSETS" or main_tag = "EXPENSES"
							begin
								if amt > 0
								begin
									set pamt = amt * (-1)
									print  pamt autocomma size 19 column 60 
								end
								else
								begin
									set pamt = abs amt
									print  pamt autocomma size 19 column 60 
								end
							end
							else
							begin
								print  amt autocomma size 19 column 60 
							end
						end
					end 
				end
			end
#			print amt format "$$"		
#			nextline
#			nextline
	end
##########################################################
ONEVERYRECORD
##########################################################
	if (gpr_levl_num = 1 )
		set main_tag = gpr_levl_desc
	
	if(gpr_range_key != "EMPTY")
	begin
	execute prntDetails
	
	end
##########################################################
PROCEDURE prntDetails
###########################################################
if (gpr_det_flg != "N")
  begin
	set levls = gpr_levl_num
	execute PrintDistance
	print gl_sub_head_desc 
	if gpr_consol_flg = "Y"
	begin 
		print "/"
		print daybook_for_crncy_code
	end
	set amt = old_cr_bal - old_dr_bal
	set amt = roundoff amt N 0.01
	if gpr_consol_flg != "Y"
	begin 
		print  amt autocomma size 19 column 33 
#		print amt format "$$"
	end
	set amt = tot_cash_dr_amt + tot_clg_dr_amt + tot_xfer_dr_amt
	set amt = roundoff amt N 0.01
	if gpr_consol_flg != "Y"
	begin 
		print amt autocomma size 19 column 55 
	end
	set amt = num_of_cash_dr_part_tran + num_of_clg_dr_part_tran + num_of_xfer_dr_part_tran
	if gpr_consol_flg != "Y"
	begin 
