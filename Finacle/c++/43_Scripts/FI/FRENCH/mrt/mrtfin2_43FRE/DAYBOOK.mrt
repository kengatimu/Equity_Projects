	print "#Pt" column 40
	print "C R E D I T" column 45
	print "#Pt" column 60
	nextline
	nextline
	separatorline
	print "-------------------------------------------------------------"
	nextline
	nextline
	print "CASH" column 1
	set amt = groupSum tot_cash_dr_amt
			set amt = roundoff amt N 0.01
	print amt autocomma size 19 column 15 
	print groupSum num_of_cash_dr_part_tran format "####" column 40
	set amt = groupSum tot_cash_cr_amt
			set amt = roundoff amt N 0.01
	print amt autocomma size 19 column 45 
