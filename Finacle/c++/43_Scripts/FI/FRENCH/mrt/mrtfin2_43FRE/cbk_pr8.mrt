###############################################################################
ONENDOFREPORT
###############################################################################
begin
	print "1.1.1 Paid-up ordinary share capital" column 1
	print tot_opc_hom column 58 size 20 autocomma precision 2 
	nextline

	print "1.1.2 Non-repayable share premium" column 1
	print tot_spr_hom column 58 size 20 autocomma precision 2 
	nextline

	print "1.1.3 General Reserves" column 1
	nextline
	
	print "1.1.4 Revenue reserves (Retained Earnings)" column 1
	set tot_arr_hom_tho = tot_arr_hom + tot_pby_hom + tot_pbf_hom
	print tot_arr_hom_tho column 58 size 20 autocomma precision 2 
	nextline

	print "1.1.5 Net After tax profits, current year to -date (50% only)" column 1
	set tot = tot_000_hom / 2 
	print tot column 58 size 20 autocomma precision 2 
	nextline

	print "1.1.6 Other Reserves" column 1
	set tot_933_hom = tot_933_hom + tot_50003_hom
	print tot_933_hom column 58 size 20 autocomma precision 2 
	nextline

	print "1.1.7 Sub - Total" column 1
	set total = tot_opc_hom + tot_spr_hom + tot_arr_hom_tho + tot + tot_933_hom
	print total column 58 size 20 autocomma precision 2 
	set tot_cor = total
	set total = 0
	separatorline
	nextline
	print "LESS DEDUCTIONS" column 1
	nextline
	separatorline

	print "1.1.8 Other Intangible assets" column 1
	nextline
	print "1.1.9 Total Deductions" column 1

	print "1.1.10 CORE CAPITAL" column 1
	print tot_cor column 58 size 20 autocomma precision 2 
	nextline
	separatorline
	nextline
	print "1.2 SUPPLEMENTARY CAPITAL (TIER 2)" column 1
	nextline
	separatorline

	print "1.2 Revaluation reserves (25%)" column 1
	set tot_rvr_hom_3 = tot_rvr_hom / 4
	print tot_rvr_hom_3 column 58 size 20 autocomma precision 2 
	nextline
	print "1.2.2 Cumulative irredeemable preference shares" column 1
	nextline
	print "1.2.3 Convertible notes and similar capital investments" column 1
	nextline
	print "1.2.4 Perpetual subordinated debt" column 1
	nextline
	print "1.2.5 Limited life redeemable preference shares" column 1
	nextline
	print "1.2.6 Term subordinated debt" column 1
	nextline
	print "1.2.7 Loan Loss Provisions" column 1
	nextline
	print "1.2.8 Total supplementary capital  (1.2.1 to 1.2.7)" column 1
	print tot_rvr_hom_3 column 58 size 20 autocomma precision 2 
	nextline
	print "1.2.9 Supplementary Capital/Core Capital (%)" column 1
	set tot_rvr_hom_1 = (tot_rvr_hom /  tot_cor) * 100
