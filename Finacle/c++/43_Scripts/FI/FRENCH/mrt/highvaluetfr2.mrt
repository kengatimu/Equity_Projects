# Template Name :		highvaluetfr2.mrt
# Description	:		unverified closed accounts
# Author			Irungu James ,02-06-2020
# 
#########################################################################
RECORDLAYOUT

init_sol_id	 stringType
FORACID 	 stringtype
ACCT_NAME	 stringtype
ACCT_STATUS 	 stringType
TABLE_NAME	 stringtype
MOP_ID	         stringtype

####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
#################################################################
LOCALVARIABLES
###########################################################################
#
###########################################################################
page_number             numberType
record_counter          numberType
date			stringType
lv_setid		stringType  
callscript		stringType
lv_setdesc		stringType
lv_userId		stringType 

#
GROUPANDSORT 

PAGEFORMAT
#
linesperpage 73
columnsperline 73
pageheaderlines 8
topMargin  2
bottomMargin 2
#
REPOSITORY bankRepos.rip
bankName	    stringType
branchName	    stringType

#REPOSITORY  argv4
#ipSetId			stringType
#iptodate			stringType
#ipFrmDate			stringType

#
#
ONSTARTOFREPORT
#
set page_number=1
set record_counter=0
execute header
execute printScheduleHeader
#
PAGEHEADER
	set page_number=page_number+1
	nextline
	execute header
	execute printScheduleHeader
#
#IGNORERECORD
 
#
ONENDOFREPORT
if (record_counter = 0)
begin
	execute printRecordNotExist
end
nextline
nextline
print "********************End Of Report*********************" size 70 center

#BEFOREBREAKOF sol_id
#
#AFTERBREAKOF 

ONEVERYRECORD
begin
	set record_counter=record_counter+1
	execute printScheduleData
	nextline
end
#

##############################################################################
PROCEDURE printScheduleData
##############################################################################
 begin
        execute pipe	
	print init_sol_id  column 4
	print FORACID      column 10
	print ACCT_NAME    column 26
	print ACCT_STATUS  column 43		
	print TABLE_NAME   column 50
	print MOP_ID       column 61

end
#
##############################################################################
PROCEDURE printScheduleHeader
##############################################################################
begin
        separatorline
	execute pipe
	print "SOL_ID"        column  3
	print "ACC_NUM "       column 10	
	print "ACC_NAME"      column 26
	print "STATUS"    	column 43	
	print "SCHM_CODE"         column 50
	print "LAST_TRAN_DAY"   column 60
	Separatorline
end 
	
#############################################################################

PROCEDURE header
#############################################################################
begin 
	set date = substr today 1,10
	print bankName    size 73 center 
	nextline
	print branchName  size 73 center
	nextLine
	print "USE MENU OPTION HACXFRSC TO TRANSFER"  size 73 center
	nextline
	print " HIGH VALUE A/c PENDING SB199/CA299 TRANSFER"  size 73 center
	nextline
end	
##############################################################################
PROCEDURE printRecordNotExist
##############################################################################
begin
nextline
nextline
nextline
print "********** RECORDS DO NOT  EXIST **********" size 73 center
nextline
nextline
nextline
separatorline
nextline
nextline
nextline
end
##############################################################################
PROCEDURE pipe
##############################################################################

begin
	print "|"  column 2
	print "|"  column 9
	print "|"  column 25
	print "|"  column 42
	print "|"  column 49
	print "|"  column 59
	print "|"  column 73

end


