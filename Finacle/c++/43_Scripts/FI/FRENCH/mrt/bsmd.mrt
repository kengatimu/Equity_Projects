###############################################################################
RECORDLAYOUT
###############################################################################
group			    stringType
amt_laa                     numbertype
amt_oda                     numbertype
amt_1_year                  numbertype
amt_2_year                  numbertype
amt_3_year                  numbertype
amt_4_year                  numbertype
###############################################################################
LOCALVARIABLES
###############################################################################
cnt			numbertype
tot1			numberType
tot2			numberType
tot3			numbertype 
tot4			numberType
tot5			numberType
tot6			numbertype
tot7			numbertype
tot8			numbertype
###############################################################################
GROUPANDSORT
###############################################################################
alreadysorted
##############################################################################
#REPOSITORY bankRepos.rip
#******************************************************************************
#bankName        stringType
#branchName      stringtype
#******************************************************************************
#REPOSITORY argv4
#setId           stringtype
#asondate        stringType
#******************************************************************************
###############################################################################
PAGEFORMAT
###############################################################################
ColumnsPerLine  200
LinesPerPage    1000
LeftMargin       00
RightMargin      00
Topmargin        01
BottomMargin     02
pageHeaderLines  04
pageFooterLines  04
##############################################################################
ONSTARTOFREPORT
##############################################################################
set cnt  = 0
set tot1 = 0
set tot2 = 0 
set tot3 = 0 
set tot4 = 0  
set tot5 = 0  
set tot6 = 0      
nextline
print  "TBALE D PART 1: ANALYSIS OF LOANS AND ADVANCES OTHER THAN MORTGAGE LOANS (SHS'000)"     column 02
nextline
separatorline
print  "LOANS AMOUNTS APPROVED"                 column 84
nextline
separatorline
execute putLine
print  "LOANS AND"                              column 01
print  "NUMBER OF"                              column 14
print  "NUMBER OF"                              column 41
print  "MATTURITIES OF TERM LOANS IN YEARS"     column 88
print  "TOTAL"                                  column 173
nextline
execute putLine
print  "ADVANCES"                               column 01
print  "APPLICATIONS(IN THE MONTH)"            column 14
print  "APPROVALS (IN THE MONTH)"               column 41
print  "Overdraft"                              column 67 size 15 center
print  "0-1"                                    column 88 size 15 center
print  "1-2"                                    column 112 size 15 center
print  "2-3"                                    column 130 size 15 center
print  "OVER 3"                                 column 148 size 15 center
print  "(OVERDRAFT + LOANS)"                    column 173 
nextline
separatorline
##############################################################################
ONEVERYRECORD
##############################################################################
set cnt = cnt + 1
set tot1 = tot1 + amt_laa
set tot2 = tot2 + amt_oda
set tot3 = tot3 + amt_1_year
set tot4 = tot4 + amt_2_year
set tot5 = tot5 + amt_3_year
set tot6 = tot6 + amt_4_year 
set tot7 = amt_oda + amt_1_year + amt_2_year + amt_3_year + amt_4_year
set tot8 = tot8 + tot7
execute putLine
print  group					column 02 
print  amt_laa                                  column 41 size 18 
print  amt_oda                                  column 66 size 20 autocomma precision 2
print  amt_1_year                               column 88 size 20 autocomma precision 2
print  amt_2_year                               column 109 size 20 autocomma precision 2
print  amt_3_year                               column 130 size 19 autocomma precision 2
print  amt_4_year                               column 150 size 19 autocomma precision 2
print  tot7					column 170 size 20 autocomma precision 2 
nextline
if (cnt = 5) 
begin
execute tot_al
execute zero
execute header
end
if (cnt = 10)
begin
execute tot_al
end
##############################################################################
PAGEHEADER
##############################################################################

PROCEDURE       putLine

        begin
        print   "|"     column 13
       	print   "|"     column 40
	print   "|"     column 65
        print   "|"     column 87
        print   "|"     column 108
        print   "|"     column 129
        print   "|"     column 149
	print   "|"	column 169
	print   "|"     column 200 
        end

################################################################################
ONENDOFREPORT
#################################################################################
#################################################################################
PROCEDURE header
#################################################################################
begin
separatorline
execute putLine
print  "LOANS AND"                              column 01
print  "BALANCE OUTSTANDING"                    column 14 size 45 rightjustify
print  "PERIOD TO MATURITY OF TERM LOANS"       column 88
print  "TOTAL OUTSTANDING"                      column 173
nextline
execute putLine
print  "ADVANCES"                               column 01
print  "Overdraft"                              column 69
print  "0-1"                                    column 88 size 15 center
print  "1-2"                                    column 112 size 15 center
print  "2-3"                                    column 130 size 15 center
print  "OVER 3"                                 column 148 size 15 center
print  "(OVERDRAFT + LOANS)"                    column 173
nextline
separatorline
end
###############################################################################
PROCEDURE tot_al
#################################################################################
begin
separatorline
execute putLine
print "Total"                                   column 02
print tot1      column 41 size 10 autocomma precision 2
print tot2      column 66 size 20 autocomma precision 2
print tot3      column 88 size 20 autocomma precision 2
print tot4      column 109 size 20 autocomma precision 2
print tot5      column 130 size 19 autocomma precision 2
print tot6      column 150 size 19 autocomma precision 2
print tot8	column 170 size 20 autocomma precision 2
separatorline
nextline
end
###############################################################################
PROCEDURE zero
#################################################################################
begin
set tot1 = 0
set tot2 = 0
set tot3 = 0 
set tot4 = 0 
set tot5 = 0 
set tot6 = 0 
set tot7 = 0
set tot8 = 0
end
#########################################################################
