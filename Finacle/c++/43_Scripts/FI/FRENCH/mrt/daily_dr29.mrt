#*********************************************************************
#       Author          :      robert oduor
#
#**********************************************************************
#  DESC   : Insurance Security Expiry Report 
#
######################################################################
RECORDLAYOUT
####################################################################
####################################################################
secu_id               stringType
secu_desc             stringtype
foracid               stringtype
ACCT_NAME             stringtype
company_name          stringtype 
policy_num            stringtype
risk_cover_end_date   stringtype

LOCALVARIABLES
####################################################################
####################################################################
sub_total	numbertype
grand_total	 numbertype
page_number     numberType
lv_setid        stringType
callscript      stringType
lv_setdesc      stringType
lv_userId       stringType 
GROUPANDSORT
####################################################################
secu_id
REPOSITORY bankRepos.rip
#############################################################################
bankname             stringtype
branchname           stringtype
##############################################################################
REPOSITORY argv4
#############################################################################
ipSetId  stringtype
ipFrmDate stringtype
ipToDate  stringtype

#MASSAGERECORD
#############################################################################
#############################################################################
#IGNORERECORD
#############################################################################
#
PAGEFORMAT
####################################################################

linesperpage     70
pageheaderlines   4
pagefooterlines   4
topmargin         2
bottommargin      2
leftmargin        1
rightmargin       1
columnsperline  180

ONSTARTOFREPORT
####################################################################
execute brBankHdg
execute pageHdg
#
PAGEHEADER
####################################################################
execute pageHdg 
####################################################################
PAGEFOOTER
####################################################################
####################################################################
ONEVERYRECORD
####################################################################
####################################################################
print secu_id  COLUMN 2
print secu_desc  COLUMN 20
print foracid COLUMN  50
print ACCT_NAME COLUMN 70
print company_name COLUMN 100 
print policy_num  COLUMN  130  
print  risk_cover_end_date COLUMN  150 
#
AFTERBREAKOF secu_id
####################################################################
####################################################################
separatorline
 SET sub_total = groupcount secu_id
 print "Sub Total" COLUMN 2 
 print sub_total COLUMN 15
separatorline
###################################################################
#
ONENDOFREPORT
#############################################################################
#
#############################################################################
separatorline
 set grand_total = totalcount secu_id
 print "Grand Total" COLUMN 2
 print grand_total COLUMN 15
separatorline 
nextline
nextline
print "Printed by:......" column 2 
print" "
print lv_userId
nextline
nextline
print today column 2     
nextline
nextline
print "Verified By:" column 2 

#############################################################################
#
#############################################################################
#
PROCEDURE pageHdg
########################################################################
##############################################################################
begin
    print "Security ID" COLUMN 2
    print "Security Details" COLUMN 20
    print "A/C Number" COLUMN 50
    print "A/C NAME" COLUMN   70
    print "Insurance Company" COLUMN 100
    print "Policy No." COLUMN  130
    print "Ins.Exp. Date" COLUMN  150
    separatorline
end

procedure brBankHdg
begin
    
    print "Page No. "   column 100 
    print page_number precision 0
    nextline
    print today column   100
    nextline
    nextline
    print "            EQUITY BANK LIMITED" column 25

    nextline   
    set lv_setid = ipsetId
    set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
    print lv_setdesc column 40
    nextline
    print "        Insurance Security Expiry Report " COLUMN 25
    set page_number= page_number+1
    nextline
end    
####################################################################
# END OF FILE
######################################################################

