#    
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
#    General Report Description:
# ******************************************************************
#
RECORDLAYOUT  
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
#	
####################################################################
$$$include  prr25.mri

LOCALVARIABLES
####################################################################
#   MANDATORY SECTION (2nd Section)
#   Any Local Variable can be defined here
####################################################################
	lc_asOnDate         stringType
	lc_startDate 	    stringType
	lc_endDate	    stringType
        lc_zoneDate         stringType
	lc_instrmntDate	    stringType
	lc_onStartOfReport  stringType
        grtotal             numberType
	total               numberType

GROUPANDSORT
####################################################################
#   MANDATORY SECTION (3rd Section)
#   This section tell how the input file is to be sorted
#   This has to be Third Section in the template file
#   This can be NULL If the input file is alread sorted
#   	Should contain only field names and the order in which they
#       to be sorted. All these fields should have been defined in 
#       RECORDLAYOUT section.
####################################################################
recSolid
recForacid

 REPOSITORY bankRepos.rip readonly
 	bankName		stringType
 	branchName		stringType
 	uniformBrCode   	stringType
 	branchDistrict  	stringType
 	branchState		stringType

REPOSITORY argv4
	reportTo		stringType
	asOnDate		stringType
	bacid			stringType
	brCode			stringType
	rejCodeLow		stringType
	rejCodeHigh		stringType
	rejType			stringType
	startDate		stringType
	endDate			stringType
	inclCustomer	        stringType
	inclEmployee            stringType
	bankCode		stringType
	setId			stringType
	printType		stringType
        zoneDate                stringType
        zoneCode                stringType
        custId                  stringType 	
        page_number             numberType 

IGNORERECORd
####################################################################
#
####################################################################
  	if (inclEmployee = "N") and (recAcctOwnerShip = "E")
  	if (inclCustomer = "Y") and (recSanctionLimit = 0.00)

PAGEFORMAT
####################################################################
#   This section tell about the page Layout
#   Here the valid pageformat keywords are 
#   Linesperpage, Leftmargin, Rightmargin, Topmargin, Columnsperpage
####################################################################
	widowOrphanLines 	3
	linesPerPage       30
	leftMargin 			2 
	rightMargin		    2
	topMargin			2
	bottomMargin		2
	columnsPerLine 	  145
    pageHeaderLines	   10
    pageFooterLines	    1
    
ONSTARTOFREPORT
####################################################################
#   This section will be executed only once during the processing of 
#		report. i.e. in the begining of the report
#   Here the valid statements are actions.
####################################################################
	set lc_asOnDate = substr asOnDate 1,10
	set lc_startDate = substr startDate 1,10
 	set lc_endDate = substr endDate 1,10
        set lc_zoneDate = substr zoneDate 1,10   
	execute rptNameHeader
	execute pageHdr
	set pageNumber = 1

PAGEHEADER 
####################################################################
#   This section is called for and the actions which are
#        specified here are done as a part of header. The number
#        of lines printed in the header cannot exceed the value
#        pageHeaderLines specified in PageFormat Section
#   Here the valid statements are actions.
####################################################################
	execute rptNameHeader
	execute pageHdr

PAGEFOOTER
####################################################################
#   This section is called for and the actions which are
#        specified here are done as a part of footer. The number
#        of lines prnted in the header cannot exceed the value
#        pageFooterLines specified in PageFormat Section
#   Here the valid statements are actions.
####################################################################
separatorline
#
BEFOREBREAKOF recSolId
###################################################################
#BEFOREBREAKOF recSolId 
####################################################################
print " SOL ID :  " column 1
print recSolId
nextLine
nextLine
#
#
#
AFTERBREAKOF  recSolId   
###################################################################
#
#afterbreakof recsoild
####################################################################
set grtotal = groupsum  recInstrmntAmt
separatorline
print " Total :" column 58
print grtotal autocomma   size 21   column 68
separatorline



ONEVERYRECORD 
####################################################################
#   Here the valid statements are actions.
####################################################################
set lc_instrmntDate = substr recInstrmntDate 1,10
execute printOneRecord
nextLine

ONENDOFREPORT
####################################################################
#   This section will be executed only once during the processing of 
#		report. i.e. in the end of the report
#   Here the valid statements are actions.
####################################################################
nextline
if totalCount recSolid = 0
begin
	print "********************   No Records Printed   ****************"
	nextline
	nextline
	nextline
end
separatorLine
set total = totalsum recInstrmntAmt
print "Grand Total:" column 58
print total autocomma   size 21   column 68
separatorline
print "                                                                Officer                Manager/Senior Manager"
nextline
set PAGE_NUMBER = pageNumber

######################################################################
#  Procedure Block
######################################################################

PROCEDURE rptNameHeader
###################################
#   Called in onStartOfReport
###################################
	print bankName     column 40
	nextline
	print branchName column 36
	nextLine
	print " REPORT OF RETURNED INSTRUMENTS "  column 34
	nextline
	nextline
	print "Return Transcations From : " column 5
	print lc_startDate
	print " to "
	print lc_endDate
	nextline
	nextline
	
PROCEDURE pageHdr
	separatorline
        print "Tran Id"       size 12  column 1	
	print "A/c # "    size 12  column 12
	print "Name" 	      size 20  column 31
	print "Inst #"   size 14  column 43
	print "Inst date"   size 11  column 59
	print "Inst Amnt" size 20  column  75
	print "Return Reason"  size 25 column 92
	print "Operator Id"  size 20 column 115
	nextline
	print "Bank" size 25  column 11
	print "Branch"	size 25  column 30
	print "Payee Name"       size 25 column 58
	print "Supervisor Id" column  115
	nextline
	separatorline

####################################################################
PROCEDURE printOneRecord
####################################################################
print   recForacid			size 16 column 10
print   recAcctName			size 20 column 27
print	recInstrmntNum  	 	size 06 column 41
print   "/"
print	recInstrmntAlpha   		size 06
print   lc_instrmntDate                 size 10  column 58
print   recInstrmntAmt autocomma   size 21   column 68
print   recRejCodeDesc1                 size 25  column 92
#print "  "
#print   recRejTypeDesc                  size 25 
nextline
print   recBankName                     size 25 column 10
print   recBrName                       size 25 column 27
print   recInstrmntName                 size 40  column 58
nextLine


