################################################################
RECORDLAYOUT
################################################################
solid		stringType
crncy		stringType
glsubhead	stringType
trandate	stringType
gst_bal		stringType
tran_bal	stringType
diff_bal	stringType
################################################################
LOCALVARIABLES
################################################################
count		numberType
################################################################
GROUPANDSORT
################################################################
################################################################
PAGEFORMAT
################################################################
ColumnsPerLine  132 
LinesPerPage     63
LeftMargin       00
RightMargin      00
Topmargin        01
BottomMargin     02
pageHeaderLines  07
pageFooterLines  04
################################################################
ONEVERYRECORD
################################################################
execute putPipes
set count = count + 1
print count column 6
print solid column 13 
print crncy column 20
print glsubhead column 32 
print trandate column 42 
print gst_bal column 56 
print tran_bal column 76 
print diff_bal column 96
################################################################
ONSTARTOFREPORT
################################################################
execute pageHeader
execute HeadLines
set count = 0
################################################################
ONENDOFREPORT
################################################################
nextline
nextline
print "Signature :" column 40
################################################################
PAGEHEADER
################################################################
execute pageHeader
execute HeadLines
################################################################
PROCEDURE pageHeader
################################################################
nextline
print "STATE BANK OF INDIA" column 1 size 120 center 
nextline 
print "SRI LANKA" column 1 size 120 center 
nextline
print "GL Difference List" column 1 size 120 center
nextline
print today column 4
print "Page: " column 90
print pageNumber column 96
nextline
nextline
################################################################
procedure HeadLines
################################################################
begin
execute putLines  
execute putPipes
print "S.No."           	column 05
print "Sol ID"  		column 12 
print "Crncy Code"      	column 20
print "GL Code"		      	column 32 
print "Tran Date"        	column 42 
print "GST Balance"         	column 56 
print "Tran Balance"        	column 76 
print "Difference"  		column 96 
execute putLines
end
################################################################
procedure putPipes
################################################################
begin
print "|" column 4
print "|" column 11 
print "|" column 19 
print "|" column 31
print "|" column 41 
print "|" column 55 
print "|" column 75
print "|" column 95 
print "|" column 115
end
################################################################
procedure putLines
################################################################
begin
nextline
print "---------------------------------------------------------------------------------------------------" column 04
nextline
end
