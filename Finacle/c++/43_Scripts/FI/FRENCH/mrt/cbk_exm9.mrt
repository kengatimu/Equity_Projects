#***************************************************************************************
RECORDLAYOUT
#***************************************************************************************
foracid 		stringType
acct_name		stringType
limit			numberType
date                    stringType
acct_bal		numberType 
int_amt			numberType
secu_code		stringType
secu_val		numberType
prov_amt		numberType
#---------------------------------------------------------------------------------------
#***************************************************************************************
LOCALVARIABLES
#***************************************************************************************
callscript     		stringType
lv_setid        	stringType
lv_setdesc     		stringType
prov_req		numbertype
add_prov		numberType
tot_out			numberType
#---------------------------------------------------------------------------------------
#***************************************************************************************
GROUPANDSORT
#***************************************************************************************
#**************************************************************************************
REPOSITORY bankRepos.rip
#*************************************************************************************
#bankName        stringType
#branchName      stringtype
#***************************************************************************************
REPOSITORY argv4
setId 		stringtype
asondate	stringType
#***************************************************************************************
ONSTARTOFREPORT
#***************************************************************************************
execute header
execute pageHdg 
set prov_req = 0
set tot_out = 0
#***************************************************************************************
PAGEFORMAT
#***************************************************************************************
linesperPage   55 
columnsperline 237
topMargin        0
bottomMargin     0
leftMargin       0
pageheaderlines  4 
pagefooterlines  4
#---------------------------------------------------------------------------------------

#***************************************************************************************
PAGEHEADER
#***************************************************************************************
nextline
#***************************************************************************************
PAGEFOOTER
#**************************************************************************************
#**************************************************************************************
#***************************************************************************************
ONEVERYRECORD
#***************************************************************************************
begin
execute pipe
print foracid column 3
print acct_name column 25 size 25
print date column 53 size 10
print limit column 64 size 17 autocomma precision 2
print acct_bal column 84 size 20 autocomma precision 2
print int_amt column 106  size 15 
print secu_code column 127
print secu_val column 139 size 18 
print prov_req column 170 size 17
print prov_amt column 190 size 18
print add_prov column 209
end
set prov_req = acct_bal - secu_val
set add_prov = prov_req - prov_amt
#set tot_out = tot_out + acc_bal
#**************************************************************************************
PROCEDURE pageHdg
#***************************************************************************************
begin
execute Line 
nextline
execute pipe
print "ACCOUNT" column 5 size 16 
print "NAME" column 24 size 25 center
print "DATE OF" column 52 size 10
print "ORIGINAL AMOUNT" column 64 size 17 center
print "BALANCE OUTSTA" column 86 size 17 center
print "INTEREST" column 108 size 17 center
print "TYPE OF" column 128 size 10
print "REALISABLE" column 140 size 15
print "VALUER AND" column 158 size 10
print "AMOUNT OF" column 170 size 18 center
print "AMOUNT OF" column 190 size 18 
print "ADDITIONAL" column 209 size 17 center
print "REMARKS" column 227 size 10 center
nextline
execute pipe
print "NUMBER" column 5 
print "ADVANCE" column 52 size 10
print "LIMIT" column 64 size 17 center 
print "NDING" column 86 size  17 center 
print "IN" column 108 size 17 center
print "SECURITY" column 128
print "VALUE OF" column 140 size 15
print "DATE" column  158 size 10
print "PROVISION" column 170 size 18  center
print "PROVISION" column 190 size 10 
print "PROVISION" column 209 size 17 center 
nextline
execute pipe
print "SUSPENSE" column 108 size 17 center
print "SECURITY" column 140 size 15 
print "REQUIRED" column 170 size 18 center 
print "HELD" column 190 size 10 
print "REQUIRED" column 209 size  17 center  
nextline
execute pipe 
print "(5 LESS 6" column 170 size 18 center
print "(10 LESS 11)" column 209 size 17 center 
nextline
execute pipe
print "LESS 8)" column 170 size 17 center 
nextline
execute line
nextline 
execute pipe
print "(1)" column 13 
print "(2)" column 36
print "(3)" column 57 
print "(4)" column 74 
print "(5)" column 92
print "(6)" column 114
print "(7)" column 131 
print "(8)" column 145
print "(9)" column 161
print "(10)" column 177
print "(11)" column 197
print "(12)" column 215
print "(13)" column 230 
nextline
execute line
end 
#**************************************************************************************
PROCEDURE Line

begin
    print "---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------" column 1 

end
#***************************************************************************************
PROCEDURE Line1

begin
print "----------------------------------------------------------------------------------------------------------------------------------------------------------------------------" column 1
end

#***************************************************************************************

PROCEDURE pipe

begin
        print "|"               column 1
        print "|"               column 23 
        print "|"               column 51 
        print "|"               column 63 
        print "|"               column 82 
        print "|"               column 104
	print "|"  		column 126
	print "|" 		column 138
	print "|" 		column 157
	print "|" 		column 169
	print "|" 		column 189
	print "|"               column 208
	print "|"               column 226 
	print "|"               column 237
end
#**************************************************************************************
#***************************************************************************************
PROCEDURE header
#***************************************************************************************
begin
nextline
nextline
print "INSTITUTION:  EQUITY BANK LIMITED " column 5 
print "DATE:" column 200 
print today column 205 size 10
nextline
nextline
print "BRANCH    :"  column 5 
set lv_setid = setId
set callscript = runscript "header.scr" "lv_setid" "lv_setdesc"
print lv_setdesc size 20
nextline
nextline
print "PART A: BAD AND DOUBTFUL DEBTS" column 5 size 150 center 
nextline 
print "______________________________" column 5 size 150 center
nextline
nextline
nextline
end
#*********************************************************************************
PROCEDURE pipe1
#********************************************************************************
begin
print "|" column  1
print "|" column 85
print "|" column 107
print "|" column 127
print "|" column 147
print "|" column 172
end
#**************************************************************************************
ONENDOFREPORT
#***************************************************************************************
begin
execute line
nextline
execute pipe 
print "Total :" column 5 
print tot_out column 84 size 20 autocomma precision 2 
nextline 
execute line
nextline
nextline
print "PART B: BAD AND DOUBTFUL DEBTS MOVEMENT SCHEDULE" column 5 size 150 center 
nextline
print "_________________________________________________" column 5 size 150 center 
nextline
nextline
execute Line1
nextline
execute pipe1
print "SPECIFIC" column 88 size 19 center
print "INTEREST IN" column 108 size 18 center
print "GENERAL" column 128 size 20 center
print "TOTAL" column 148 size 20 center
nextline
execute pipe1
print "PROVISIONS" column 88 size 19 center
print "SUSPENSE" column 108 size 18 center
print "PROVISIONS" column 128 size 18 center
nextline
execute Line1
nextline
execute pipe1
print "Balance as at the last (Previous) Inspection date" column 2
nextline
execute Line1
nextline
execute pipe1
print "Less:- Amount written off between the previous inspection and current inspe" column 2
nextline
execute Line1
nextline
execute pipe1
print "Less:- Recoveries made between the previous inspection and current inspection dates" column 2
nextline
execute Line1
nextline
execute pipe1
print "Add:- Previous made between the previous inspection and current inspection date" column 2
nextline
execute Line1
nextline
execute pipe1
print "Balances as at the current inspection date" column 2
nextline
execute Line1 
nextline
nextline
nextline
nextline
nextline
print " AUTHORISED SIGNATORY:_______________________________________" column 20
nextline
end
