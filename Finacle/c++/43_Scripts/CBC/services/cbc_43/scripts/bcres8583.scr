<--start
trace on
 
call("../scripts","bcres8583_43.scr")

GOTO ENDOFSCRIPT

IF ((CDCI.Request8583.Field123=="EAZ") OR (CDCI.Request8583.Field123=="OMK") OR (CDCI.Request8583.Field123=="AIR")) THEN
	IF (FIELDEXISTS(CDCI.Request8583.Field49)) THEN

		if (CDCI.Request8583.Field49=="SSP") then
			CDCI.Request8583.Field102BankId="11"
			print(CDCI.Request8583.Field102BankId)
		endif
		if (CDCI.Request8583.Field49=="RWF") then
			CDCI.Request8583.Field102BankId="50"
			print(CDCI.Request8583.Field102BankId)
		endif
		if (CDCI.Request8583.Field49=="KES") then
			CDCI.Request8583.Field102BankId="54"
			print(CDCI.Request8583.Field102BankId)
		endif
		if (CDCI.Request8583.Field49=="TZS") then
			CDCI.Request8583.Field102BankId="55"
			print(CDCI.Request8583.Field102BankId)
		endif

		if (CDCI.Request8583.Field49=="UGX") then
			CDCI.Request8583.Field102BankId="56"
			print(CDCI.Request8583.Field102BankId)
		endif
		
		#Changes done by Finacle Implementation Team - 10.2.18  -- Starts here
		
		if (CDCI.Request8583.Field49=="CDF") then
			CDCI.Request8583.Field102BankId="43"
			print(CDCI.Request8583.Field102BankId)
		endif
		
		#Changes done by Finacle Implementation Team - 10.2.18  -- Ends here

		#Calling the bank specific validation
		CDCI.Request8583.Field102BankId= trim(CDCI.Request8583.Field102BankId)
	ELSE
		CDCI.Request8583.Field102BankId="99"
		CDCI.Request8583.Action = "F"
		CDCI.Response8583.Field127 = "Bank Id is null/Invalid Bank Id"
		GOTO ENDOFSCRIPT
	ENDIF
ELSE

	IF (FIELDEXISTS(CDCI.Request8583.Field32)) THEN

		if (CDCI.Request8583.Field32=="005049") then
			CDCI.Request8583.Field102BankId="11"
			print(CDCI.Request8583.Field102BankId)
		endif
		if (CDCI.Request8583.Field32=="000192") then
			CDCI.Request8583.Field102BankId="50"
			print(CDCI.Request8583.Field102BankId)
		endif
		if (CDCI.Request8583.Field32=="000068") then
			CDCI.Request8583.Field102BankId="54"
			print(CDCI.Request8583.Field102BankId)
		endif
		if (CDCI.Request8583.Field32=="000059") then
			CDCI.Request8583.Field102BankId="55"
			print(CDCI.Request8583.Field102BankId)
		endif
		
		#Changes done by Finacle Implementation Team - 10.2.18 -- Starts here
		
		if (CDCI.Request8583.Field32=="000000") then
			CDCI.Request8583.Field102BankId="43"
			print(CDCI.Request8583.Field102BankId)
		endif
		
		#Changes done by Finacle Implementation Team - 10.2.18 -- Ends here

		#Calling the bank specific validation
		CDCI.Request8583.Field102BankId= trim(CDCI.Request8583.Field102BankId)
	ELSE
		CDCI.Request8583.Field102BankId="99"
		CDCI.Request8583.Action = "F"
		CDCI.Response8583.Field127 = "Bank Id is null/Invalid Bank Id"
		GOTO ENDOFSCRIPT
	ENDIF
ENDIF
	#print(CDCI.Response8583.Field50)
IF (FIELDEXISTS(CDCI.Request8583.Field102BankId)) THEN

	sv_a= trim(CDCI.Request8583.Field102BankId)
	print(sv_a)
	IF ((sv_a ==  "11") OR (sv_a ==  "50") OR (sv_a ==  "54") OR (sv_a ==  "55") OR (sv_a ==  "56") OR (sv_a == "43")) THEN
	#{
		IF(sv_a ==  "11") THEN
		#{ EQUITY BANK SUDAN LTD
			call("../scripts","bcres8583_SS.scr")
		#}
		ELSE
		#
			IF(sv_a ==  "50") THEN
			#{ Equity Bank Rwanda limited
				call("../scripts","bcres8583_RW.scr")
			#}
			ELSE
			#{
				IF(sv_a ==  "54") THEN
				#{ Equity Bank limited
					call("../scripts","bcres8583_KE.scr")
				#}
				ELSE
				#{
					IF(sv_a ==  "55") THEN
					#{ Equity Bank Tanzania Limited
						call("../scripts","bcres8583_TZ.scr")
					#}
					ELSE
					#{
						IF(sv_a ==  "56") THEN
						#{ EQUITY BANK UGANDA LTD
							call("../scripts","bcres8583_UG.scr")
						#}
						ELSE
						#{
							#Changes done by Finacle Implementation Team - 10.2.18  -- Starts here
							
							IF(sv_a ==  "43") THEN
							#{ Equity Bank Congo DRC
								call("../scripts","bcres8583_43.scr")
							#}
							ENDIF
							
							#Changes done by Finacle Implementation Team - 10.2.18  -- Ends here
							
						#}
						ENDIF
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
	ELSE
	#{
		#Invalid Bank ID
		CDCI.Response8583.Action = "F"
		CDCI.Response8583.Field127 = "Invalid Bank Id"
		GOTO ENDOFSCRIPT
	#}
	ENDIF
ENDIF

#print(CDCI.Response8583.Field50)
CDCI.Response8583.Field50="404"
ENDOFSCRIPT:

trace off
end-->
