							print(sv_r)
							IF (sv_r == "0") THEN
								BANCS.OUTPUT.TranFeeContraAcct1= BANCS.OUTPARAM.contra
								print(BANCS.OUTPUT.TranFeeContraAcct1)
							ENDIF
						endif
					endif
					#---------------------------------------------------------------End

				ENDIF
				BANCS.OUTPUT.successOrFailure = "S"
				GOTO ENDOFSCRIPT
			#}
			ELSE
			#{
				BANCS.OUTPUT.RespCode = "99"
				BANCS.OUTPUT.successOrFailure = "F"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
