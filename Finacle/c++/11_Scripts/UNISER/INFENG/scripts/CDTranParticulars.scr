					sv_u = "count|"
					sv_u = sv_u + "SELECT COUNT(1)FROM dual WHERE EXISTS(SELECT 1 FROM CUSTOM.C_CIC  "
					#MigrationTool : UserHookModificationTool : Querying from Dual, Bindvars modification and Bank_ID addition not done.
					sv_u = sv_u + " where BANK_ID = ?SVAR AND ACCTNUM = ?SVAR) "
