		#---Narrations for VISA Acquring
		IF (CUST.ATM.dccid =="SWT") THEN
		#{
			CUST.ATM.CustCardId = MID$(BANCS.INPUT.CustCardId,0,6)
			#Print(CUST.ATM.CustCardId)
			IF ((CUST.ATM.CustCardId != "669932") AND (CUST.ATM.CustCardId != "454742") AND (CUST.ATM.CustCardId != "475678") AND (CUST.ATM.CustCardId != "473866") AND (CUST.ATM.CustCardId != "418021") AND (CUST.ATM.CustCardId != "484865") AND (BANCS.INPUT.ReservedField2 !="INTERC") AND (BANCS.INPUT.ReservedField2 !="INTERRCV"))  THEN
			#{
				sv_e = mid$(BANCS.STDIN.BODDate,0,10)
				#Print(sv_e)
				sv_s = "sysdate|select to_char((to_date(?SVAR,'DD-MM-YYYY')),'DD-MM-YYYY') from dual"
				BANCS.INPARAM.BINDVARS =   sv_e
				sv_d = urhk_dbSelectWithBind(sv_s)
				#Print(sv_d)
				IF (sv_d =="0") THEN
				#{
					CUST.ATM.sysdate = BANCS.OUTPARAM.sysdate
					CUST.ATM.narr1=""
					CUST.ATM.narr2=""
					CUST.ATM.narr3 ="VISA SMS ACQUIRING "+ "/" + LTRIM(BANCS.INPUT.ReservedField3,'0') + "/" + BANCS.INPUT.SerialNum + "/" + CUST.ATM.sysdate
					print(CUST.ATM.narr3)
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
		
		#---narrations for way4 POS
		
		IF (CUST.ATM.dccid =="WPD") THEN
		#{
			IF (BANCS.INPUT.DeviceId!="") THEN
			#{
				sv_a= MID$(BANCS.INPUT.DeviceId,0,2)
				PRINT(sv_a)
				IF (sv_a=="SS") THEN
				#{
					sv_s = "count,freeText "
					sv_s = sv_s + " | "
					sv_s = sv_s + " SELECT COUNT(1),AGT.free_text "
					sv_s = sv_s + " FROM TBAADM.AGT,TBAADM.GAM "
					sv_s = sv_s + " WHERE AGT.oper_credit_acid = GAM.acid "
					sv_s = sv_s + " AND GAM.acct_cls_flg != 'Y'"
					sv_s = sv_s + " AND agent_code = ?SVAR "
					sv_s = sv_s + " AND AGT.del_flg !='Y' "
					sv_s = sv_s + " GROUP BY AGT.free_text "
					BANCS.INPARAM.BINDVARS = BANCS.INPUT.DeviceId
					PRINT(sv_s)
					sv_d = urhk_dbSelectWithBind(sv_s)
					PRINT(sv_d)
					IF  (sv_d == "0") THEN
					#{
						CUST.ATM.count=BANCS.OUTPARAM.count
						CUST.ATM.freeText=BANCS.OUTPARAM.freeText
						IF (CUST.ATM.count == 1) THEN
						#{
							IF (CUST.ATM.freeText=="CASHLESS" ) THEN
							#{
								CUST.ATM.Agent="Y"
								CUST.ATM.cashless="Y"
							#}
							ELSE
							#{
								CUST.ATM.Agent="Y"
								CUST.ATM.cashless="N"
							#}
							ENDIF
						#}
						ELSE
						#{
							CUST.ATM.Agent="N"
							CUST.ATM.cashless="N"
						#}
						ENDIF
					#}
					ELSE
					#{
						CUST.ATM.Agent="N"
						CUST.ATM.cashless="N"
					#}
					ENDIF
					CUST.ATM.AcceptorName=MID$(BANCS.INPUT.CardAcceptorName,0,15)
					CUST.ATM.narr1=CUST.ATM.AcceptorName
					
					IF ((CUST.ATM.command =="PRCR") OR (CUST.ATM.command =="CWDR")) THEN
					#{
						CUST.ATM.narr2=" MERCHANT TRANSACTION"
						IF (BANCS.INPUT.ReservedField2 == "WAY4CASHBACK") THEN
						#{
							CUST.ATM.narr2=" CASHBACK AND FEES"
						#}
						ENDIF
						IF (BANCS.INPUT.ReservedField2 == "WAY4POSCASH") THEN
						#{
							CUST.ATM.narr2=" CASH ADVANCE AND FEES"
						#}
						ENDIF
						IF (BANCS.INPUT.ReservedField2 == "WAY4RETAIL")  THEN
						#{
							CUST.ATM.narr2=" PURCHASE"
							IF (BANCS.INPUT.DeviceId!="") THEN
							#{
								sv_a= MID$(BANCS.INPUT.DeviceId,0,2)
								PRINT(sv_a)
								IF (sv_a=="TM") THEN
								#{
									CUST.ATM.narr2=" PAYMENT"
								#}
								ENDIF
								IF (sv_a=="CG") THEN
								#{
									CUST.ATM.narr2=" PAYMENT"
								#}
								ENDIF
							#}
							ENDIF
						#}
						ENDIF
						IF (BANCS.INPUT.ReservedField2 == "WAY4RETAILUSD") THEN
						#{
							CUST.ATM.narr2=" USDRWPURCHASE"
						#}
						ENDIF
						IF (BANCS.INPUT.ReservedField2 == "WAY4RETAILUSDUG") THEN
						#{
							CUST.ATM.narr2=" USDUGPURCHASE"
						#}
						ENDIF
						IF (BANCS.INPUT.ReservedField2 == "INTERC") THEN
						#{
							IF ((CUST.ATM.command =="PRCR") OR (CUST.ATM.command =="CWDR")) THEN
							#{
								IF (BANCS.INPUT.PartTranType=="C") THEN
								#{
									BANCS.OUTPUT.RefNum=BANCS.INPUT.DeviceId
								#}
								ELSE
								#{
									BANCS.OUTPUT.RefNum=CUST.ATM.serial
								#}
								ENDIF
							#}
							ENDIF
							IF ((CUST.ATM.command =="PRRR") OR (CUST.ATM.command =="CWRR")) THEN
							#{
								IF (BANCS.INPUT.PartTranType=="D") THEN
								#{
									BANCS.OUTPUT.RefNum=BANCS.INPUT.DeviceId
								#}
								ELSE
								#{
									BANCS.OUTPUT.RefNum=CUST.ATM.serial
								#}
								ENDIF
							#}
							ENDIF
							IF (CUST.ATM.command =="CWDR") THEN
							#{
								CUST.ATM.narr2=" POS INT WDRAWAL"
								
							#}
							ENDIF
							IF (CUST.ATM.command =="CWRR") THEN
							#{
								CUST.ATM.narr2=" POS INT REVERSAL"
								
							#}
							ENDIF
						#}
						ENDIF
						
						IF ((CUST.ATM.Agent=="Y") AND (CUST.ATM.cashless=="N")) THEN
						#{
							CUST.ATM.narr2=" CASH ADVANCE"
						#}
						ENDIF
						IF ((CUST.ATM.Agent=="Y")AND (CUST.ATM.cashless=="Y")) THEN
						#{
							PRINT ("cashless pos")
							IF (BANCS.INPUT.PartTranType=="C") THEN
							#{
								sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.Foracid)
								CUST.ATM.narr1 = MID$(BANCS.OUTPARAM.acctName,0,34)
								PRINT(CUST.ATM.narr1)
								CUST.ATM.narr2=" /PURCHASE"
							#}
							ELSE
							#{
								CUST.ATM.narr2=" /PURCHASE"
								
							#}
							ENDIF
						#}
						ENDIF
						
					#}
					ENDIF
					IF ((CUST.ATM.command =="PRRR") OR (CUST.ATM.command =="CWRR")) THEN
					#{
						CUST.ATM.narr2=" REVERSAL"
						IF (BANCS.INPUT.ReservedField2 == "WAY4CASHBACK") THEN
						#{
							CUST.ATM.narr2=" CASHBACK REVERSAL"
						#}
						ENDIF
						IF (BANCS.INPUT.ReservedField2 == "WAY4POSCASH") THEN
						#{
							CUST.ATM.narr2=" CASH ADVANCE AND FEES REVERSAL"
						#}
						ENDIF
						IF (BANCS.INPUT.ReservedField2 == "WAY4RETAIL")  THEN
						#{
							CUST.ATM.narr2=" PURCHASE REVERSAL"
						#}
						ENDIF
						IF (BANCS.INPUT.ReservedField2 == "WAY4RETAILUSD") THEN
						#{
							CUST.ATM.narr2=" USDRWPURCHASE REVERSAL"
						#}
						ENDIF
						IF (BANCS.INPUT.ReservedField2 == "WAY4RETAILUSDUG") THEN
						#{
							CUST.ATM.narr2=" USDUGPURCHASE REVERSAL"
						#}
						ENDIF
						IF (CUST.ATM.Agent=="Y") THEN
						#{
							CUST.ATM.narr2=" CASH ADVANCE REVERSAL"
						#}
						ENDIF
						IF ((CUST.ATM.Agent=="Y")AND (CUST.ATM.cashless=="N")) THEN
						#{
							CUST.ATM.narr2=" CASH ADVANCE REVERSAL"
						#}
						ENDIF
						IF ((CUST.ATM.Agent=="Y")AND (CUST.ATM.cashless=="Y")) THEN
						#{
							PRINT ("cashless pos")
							IF (BANCS.INPUT.PartTranType=="D") THEN
							#{
								sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.Foracid)
								CUST.ATM.narr1 = MID$(BANCS.OUTPARAM.acctName,0,34)
								PRINT(CUST.ATM.narr1)
								CUST.ATM.narr2=" /PURCHASE REV "
							#}
							ELSE
							#{
								CUST.ATM.narr2=" /PURCHASE REV "
							#}
							ENDIF
						#}
						ENDIF
					#}
					ENDIF
					IF (CUST.ATM.command =="CDAR") THEN
					#{
						CUST.ATM.narr2=" CASH DEPOSIT"
					#}
					ENDIF
					IF (CUST.ATM.command =="CDRR") THEN
					#{
						CUST.ATM.narr2="CASH DEPOSIT REV"
					#}
					ENDIF
					IF ((BANCS.INPUT.ReservedField2 !="") AND (BANCS.INPUT.CrForacid !="") AND (BANCS.INPUT.ReservedField2 !="INTERC") AND (CUST.ATM.command !="CDAR") AND (CUST.ATM.command !="CDRR") ) THEN
					#{
						sv_y=BANCS.INPUT.ReservedField2
						sv_c=mid$(sv_y,0,5)
						PRINT(sv_c)
						IF ((sv_c !="BILL:") AND (sv_c !="COLL:") AND (sv_c !="ACCT:") AND (sv_c !="ACCT|") AND (sv_c !="BILL|") AND (sv_c !="COLL|")) THEN
						#{
							IF (BANCS.INPUT.PartTranType=="C") THEN
							#{
								IF (BANCS.INPUT.CrForacid=="0550293271157") THEN
								#{
									BANCS.INPUT.ReservedField2=LTRIM(BANCS.INPUT.ReservedField2,'0')
								#}
								ENDIF
								sv_s = "refNum,name "
								sv_s = sv_s + " | "
								sv_s = sv_s + " SELECT refnum,name "
								sv_s = sv_s + " FROM CUSTOM.C_CIC "
								sv_s = sv_s + " WHERE acctnum = ?SVAR  "
								sv_s = sv_s + " AND refnum = ?SVAR "
								sv_s = sv_s + " AND del_flg = 'N' "
								sv_s = sv_s + " AND bank_id = ?SVAR "
								BANCS.INPARAM.BINDVARS = BANCS.INPUT.CrForacid + "|" + BANCS.INPUT.ReservedField2 + "|" + BANCS.STDIN.contextBankId
								PRINT(sv_s)
								sv_d = urhk_dbSelectWithBind(sv_s)
								PRINT(sv_d)
								IF ( sv_d != 0 ) THEN
								#{
									BANCS.OUTPUT.RespCode = "99"
									BANCS.OUTPUT.successOrFailure="F"
									GOTO ENDOFSCRIPT
								#}
								ELSE
								#{
									BANCS.OUTPUT.TranRemarks=BANCS.OUTPARAM.name
									BANCS.OUTPUT.RefNum=BANCS.OUTPARAM.refNum
									CUST.ATM.narr2="BILL PAYMENT"
								#}
								ENDIF
							#}
							ELSE
							#{
								CUST.ATM.serial= LTRIM(CUST.ATM.serial,'0')
								BANCS.OUTPUT.RefNum=CUST.ATM.serial
								CUST.ATM.narr1=""
								CUST.ATM.narr2="BILL PAYMENT: "
								sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.CrForacid)
								CUST.ATM.narr3 = MID$(BANCS.OUTPARAM.acctName,0,34)
								PRINT(CUST.ATM.narr3)
								BANCS.OUTPUT.TranRemarks="POS"
							#}
							ENDIF
						#}
						ENDIF
					#}
					ENDIF
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
		IF (CUST.ATM.dccid =="TPG")  THEN
		#{
			CUST.ATM.paybillrmks=MID$(BANCS.INPUT.CardAcceptorName,0,31)
			PRINT(CUST.ATM.paybillrmks)
			BANCS.OUTPUT.TranRemarks = CUST.ATM.paybillrmks
			PRINT(BANCS.OUTPUT.TranRemarks)
			BANCS.OUTPUT.RefNum=CUST.ATM.serial
			PRINT(BANCS.OUTPUT.RefNum)
			IF (BANCS.INPUT.PartTranType=="C") THEN
			#{
				CUST.ATM.narr2=BANCS.INPUT.CardAcceptorName
				PRINT(CUST.ATM.narr2)
				
				sv_k = BANCS.INPUT.CardAcceptorName
				PRINT(sv_k)
				sv_s = "refNumMpa "
				sv_s = sv_s + " | "
				sv_s = sv_s + " SELECT SUBSTR('"+ sv_k +"',LENGTH('"+ sv_k +"') - INSTR(REVERSE('"+ sv_k +"'),' ')+2,80) "
				sv_s = sv_s + " FROM DUAL "
				PRINT(sv_s)
				sv_d = urhk_dbSelectWithBind(sv_s)
				PRINT(sv_d)
				IF (sv_d ==0) THEN
				#{
					PRINT(BANCS.OUTPARAM.refNumMpa)
					BANCS.OUTPUT.RefNum = BANCS.OUTPARAM.refNumMpa
					PRINT(BANCS.OUTPUT.RefNum)
				#}
				ENDIF
				IF (BANCS.INPUT.CrForacid=="0810294880883") THEN
				#{
					sv_k = BANCS.INPUT.CardAcceptorName
					PRINT(sv_k)
					sv_s = "refNumMpa "
					sv_s = sv_s + " | "
					sv_s = sv_s + " select substr('"+ sv_k +"', 14, length('"+ sv_k +"')-22) AS output "
					sv_s = sv_s + " FROM DUAL "
					PRINT(sv_s)
					sv_d = urhk_dbSelectWithBind(sv_s)
					PRINT(sv_d)
					IF (sv_d ==0) THEN
					#{
						PRINT(BANCS.OUTPARAM.refNumMpa)
						BANCS.OUTPUT.RefNum = BANCS.OUTPARAM.refNumMpa
						PRINT(BANCS.OUTPUT.RefNum)
					#}
					ENDIF
				#}
				ENDIF
			#}
			ELSE
			#{
				sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.CrForacid)
				CUST.ATM.narr2 = "/"+ BANCS.INPUT.CrForacid +"/"+ MID$(BANCS.OUTPARAM.acctName,0,34)
				PRINT(CUST.ATM.narr2)
				IF (FIELDEXISTS(BANCS.INPUT.ReservedField2) == 1) THEN
				#{
					IF (BANCS.INPUT.ReservedField2 =="REMITTANCE") THEN
					#{
						CUST.ATM.narr2=MID$(BANCS.INPUT.CardAcceptorName,0,31)
						PRINT(CUST.ATM.narr2)
					#}
					ELSE
					#{
						CUST.ATM.narr3=""
					#}
					ENDIF
				#}
				ELSE
				#{
					CUST.ATM.narr3=""
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
		IF (CUST.ATM.dccid =="POL")  THEN
			IF (FIELDEXISTS(BANCS.INPUT.ReservedField1) == 1) THEN
				CUST.ATM.narr1=MID$(BANCS.INPUT.ReservedField1,0,49)
				print(CUST.ATM.narr1)
			ENDIF
			IF (FIELDEXISTS(BANCS.INPUT.ReservedField3) == 1) THEN
				BANCS.OUTPUT.TranParticulars2=LTRIM(BANCS.INPUT.ReservedField3,'0') 
				print(BANCS.OUTPUT.TranParticulars2)
			ENDIF
			IF (FIELDEXISTS(BANCS.INPUT.DevOwnerId) == 1) THEN
				BANCS.OUTPUT.TranRemarks=BANCS.INPUT.DevOwnerId
				print(BANCS.OUTPUT.TranRemarks)
			ENDIF
			IF (FIELDEXISTS(BANCS.INPUT.CardAcceptorName) == 1) THEN
				BANCS.OUTPUT.RefNum=MID$(BANCS.INPUT.CardAcceptorName,0,31)
				print(BANCS.OUTPUT.RefNum)
			ENDIF
			CUST.ATM.narr2=""
			CUST.ATM.narr3=""
		ENDIF
		
		BANCS.OUTPUT.TranRemarks=mid$(BANCS.OUTPUT.TranRemarks,0,30)
		BANCS.OUTPUT.RefNum=mid$(BANCS.OUTPUT.RefNum,0,20)
		sv_a = CUST.ATM.narr1 + CUST.ATM.narr2 + CUST.ATM.narr3
		#Print(sv_a)
		sv_b=mid$(sv_a,0,50)
		BANCS.OUTPUT.TranParticulars = sv_b
		#Print(BANCS.OUTPUT.TranRemarks)
		#Print(BANCS.OUTPUT.RefNum)
		#Print(BANCS.OUTPUT.TranParticulars)

		#---------------------------Edwin for IMT narrations
		if(CUST.ATM.dccid =="TPG")then
			if((FIELDEXISTS(BANCS.INPUT.ReservedField1) == 1) and (FIELDEXISTS(BANCS.INPUT.ReservedField2) == 1))then
				if(BANCS.INPUT.ReservedField2=="IMT")then
					BANCS.OUTPUT.TranParticulars = mid$(BANCS.INPUT.ReservedField1,0,50)
					print(BANCS.OUTPUT.TranParticulars)
				endif
			endif
		endif
		#---------------------------End
		
		IF ((CUST.ATM.dccid=="BS1") OR (CUST.ATM.dccid=="MC1") OR (CUST.ATM.dccid=="AME") OR (CUST.ATM.dccid=="C24") OR (CUST.ATM.dccid=="SWT") OR (CUST.ATM.dccid=="WPD")) THEN
		#{
			sv_r=mid$(CUST.ATM.command,2,4)
			PRINT(sv_r)
			IF (sv_r!="RR") THEN
			#{
				IF (FIELDEXISTS(BANCS.OUTPUT.TranRemarks) == 1) THEN
				#{
					PRINT(BANCS.OUTPUT.TranRemarks)
					sv_k =mid$(BANCS.OUTPUT.TranRemarks,0,6)
					PRINT(sv_k)
					sv_e =mid$(BANCS.OUTPUT.TranRemarks,12,16)
					PRINT(sv_e)
					sv_f ="XXXXXX"
					PRINT(sv_f)
					sv_h = sv_k + sv_f + sv_e
					PRINT(sv_h)
					BANCS.OUTPUT.TranRemarks = sv_h
					PRINT(BANCS.OUTPUT.TranRemarks)
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
		IF (BANCS.INPUT.DccId == "EAZ")  THEN
			IF (BANCS.INPUT.ReservedField2 =="P2PIntra")  THEN
				BANCS.OUTPUT.TranParticulars2 = BANCS.INPUT.ReservedField2 + "/" + LTRIM(BANCS.INPUT.ReservedField3,'0')
				print(BANCS.OUTPUT.TranParticulars2)
			ENDIF
			IF ((BANCS.INPUT.ReservedField2 =="P2PIntra") OR (BANCS.INPUT.ReservedField2 =="Evalue"))   THEN
				IF (FIELDEXISTS(BANCS.INPUT.ReservedField1) == 1) THEN
					print(BANCS.INPUT.ReservedField1)
					IF (FIELDEXISTS(BANCS.OUTPUT.TranParticulars2) == 1) THEN
						print(BANCS.OUTPUT.TranParticulars2)
					ELSE
						BANCS.OUTPUT.TranParticulars2=""
					ENDIF
					BANCS.OUTPUT.TranParticulars2 = mid$(BANCS.INPUT.ReservedField1,0,3) + "/" + BANCS.OUTPUT.TranParticulars2
					print(BANCS.OUTPUT.TranParticulars2)
				ENDIF
			ENDIF
			IF (BANCS.INPUT.ReservedField2 =="UNBLOCK")  THEN
				IF ((BANCS.INPUT.PartTranType=="C") OR (BANCS.INPUT.PartTranType=="D")) THEN
					BANCS.OUTPUT.TranParticulars2 = BANCS.INPUT.CardAcceptorName +"/" + BANCS.INPUT.ReservedField2 +"/" + BANCS.OUTPUT.RefNum
					print(BANCS.OUTPUT.TranParticulars2)
				ENDIF
			ENDIF
		ENDIF

		
		#####################################################################################################################
		#---------------- MODIFIED BY OSUKA S :SEPARATE DR AND CR NARRATIONS FOR SINGLE EAZZYBIZ TRANSACTIONS --------------#
		#####################################################################################################################
IF( BANCS.INPUT.DccId == "POL" ) THEN
	IF(BANCS.INPUT.ReservedField2 !="") THEN
		IF ( (BANCS.INPUT.ReservedField2 =="EAZYBIZ") OR (BANCS.INPUT.ReservedField2 =="EAZYBIZEFT") ) THEN
			IF(FIELDEXISTS(BANCS.INPUT.PartTranType)) THEN
				# Assign ReservedField1 value to CUST.ATM.narration
				CUST.ATM.narration = BANCS.INPUT.ReservedField1
				PRINT(CUST.ATM.narration)
				
				# Get the length of CUST.ATM.narration and assign to sv_s
				sv_s = STRLEN(CUST.ATM.narration)
				PRINT(sv_s)
				
				# Initialize variables to store individual parts
				CUST.ATM.narrCode = ""
				CUST.ATM.narrDr = ""
				CUST.ATM.narrCr = ""
				CUST.ATM.narrDrFee = ""
				CUST.ATM.narrCrFee = ""
				
				# Initialize position(sv_h) and count(sv_g) variables
				sv_h = 0
				sv_g = 0
				
				# Loop through the string to find '|' and separate parts
				WHILE (sv_h < sv_s)
					# Find the position of the next '|' starting from sv_h
					sv_u = GETPOSITION(MID$(CUST.ATM.narration, sv_h, sv_s - sv_h), '|')
					
					IF (sv_u == 0) THEN
						# No more '|' found, assign the remaining part to the appropriate variable
						IF (sv_g == 0) THEN
							CUST.ATM.narrCode = MID$(CUST.ATM.narration, sv_h, sv_s - sv_h)
						ELSE
							IF (sv_g == 1) THEN
								CUST.ATM.narrDr = MID$(CUST.ATM.narration, sv_h, sv_s - sv_h)
							ELSE
								IF (sv_g == 2) THEN
									CUST.ATM.narrCr = MID$(CUST.ATM.narration, sv_h, sv_s - sv_h)
								ELSE
									IF (sv_g == 3) THEN
										CUST.ATM.narrDrFee = MID$(CUST.ATM.narration, sv_h, sv_s - sv_h)
									ELSE
										IF (sv_g == 4) THEN
											CUST.ATM.narrCrFee = MID$(CUST.ATM.narration, sv_h, sv_s - sv_h)
										ENDIF
									ENDIF
								ENDIF
							ENDIF
						ENDIF
						# Exit the loop by setting sv_h to sv_s
						sv_h = sv_s
					ELSE
						# '|' found, assign the part up to '|' to the appropriate variable
						IF (sv_g == 0) THEN
							CUST.ATM.narrCode = MID$(CUST.ATM.narration, sv_h, sv_u - 1)
						ELSE
							IF (sv_g == 1) THEN
								CUST.ATM.narrDr = MID$(CUST.ATM.narration, sv_h, sv_u - 1)
							ELSE
								IF (sv_g == 2) THEN
									CUST.ATM.narrCr = MID$(CUST.ATM.narration, sv_h, sv_u - 1)
								ELSE
									IF (sv_g == 3) THEN
										CUST.ATM.narrDrFee = MID$(CUST.ATM.narration, sv_h, sv_u - 1)
									ELSE
										IF (sv_g == 4) THEN
											CUST.ATM.narrCrFee = MID$(CUST.ATM.narration, sv_h, sv_u - 1)
										ENDIF
									ENDIF
								ENDIF
							ENDIF
						ENDIF
						# Update sv_h to the position after the found '|'
						sv_h = sv_h + sv_u
					ENDIF
					
					# Increment the part count
					sv_g = sv_g + 1
				DO
				
				# Print the separated parts
				PRINT(CUST.ATM.narrCode)
				PRINT(CUST.ATM.narrDr)
				PRINT(CUST.ATM.narrCr)
				PRINT(CUST.ATM.narrDrFee)
				PRINT(CUST.ATM.narrCrFee)

				IF((CUST.ATM.narrCode == "ONLINE") OR (CUST.ATM.narrCode == "BULK")) THEN
					# Narration for Debit part
					IF(BANCS.INPUT.PartTranType == "D") THEN
						# Check if there are charges

						IF(TRIM(CUST.ATM.narrDr) =="")THEN
							CUST.ATM.narrDr = CUST.ATM.narration
						ENDIF 

						IF(FIELDEXISTS(BANCS.INPUT.PartTranIdentifier)) THEN
							IF((TRIM(BANCS.INPUT.PartTranIdentifier) != "") AND (BANCS.INPUT.PartTranIdentifier == "FEECUST1")) THEN
								IF(TRIM(CUST.ATM.narrDrFee) != "") THEN
									BANCS.OUTPUT.TranParticulars = mid$(CUST.ATM.narrDrFee,0,50)
									PRINT(BANCS.OUTPUT.TranParticulars)
								ELSE
									BANCS.OUTPUT.TranParticulars = "FEE:" + mid$(CUST.ATM.narrDr,0,46)
									PRINT(BANCS.OUTPUT.TranParticulars)
								ENDIF
							ELSE
								BANCS.OUTPUT.TranParticulars = mid$(CUST.ATM.narrDr,0,50)
								PRINT(BANCS.OUTPUT.TranParticulars)
							ENDIF
						ELSE
							BANCS.OUTPUT.TranParticulars = mid$(CUST.ATM.narrDr,0,50)
							PRINT(BANCS.OUTPUT.TranParticulars)
						ENDIF
					ENDIF

					# Narration for Credit part
					IF(BANCS.INPUT.PartTranType == "C") THEN
						# Check if there are charges

						IF(TRIM(CUST.ATM.narrCr) =="")THEN
							IF(TRIM(CUST.ATM.narrDr) !="")THEN
								CUST.ATM.narrCr = CUST.ATM.narrDr
							ELSE
								CUST.ATM.narrCr = CUST.ATM.narration
							ENDIF
						ENDIF

						IF(FIELDEXISTS(BANCS.INPUT.PartTranIdentifier)) THEN
							IF((TRIM(BANCS.INPUT.PartTranIdentifier) != "") AND (BANCS.INPUT.PartTranIdentifier == "FEECONTRA1")) THEN
								IF(TRIM(CUST.ATM.narrCrFee) != "") THEN
									BANCS.OUTPUT.TranParticulars = mid$(CUST.ATM.narrCrFee,0,50)
									PRINT(BANCS.OUTPUT.TranParticulars)
								ELSE
									BANCS.OUTPUT.TranParticulars = "FEE:" + mid$(CUST.ATM.narrCr,0,46)
									PRINT(BANCS.OUTPUT.TranParticulars)
								ENDIF
							ELSE
								BANCS.OUTPUT.TranParticulars = mid$(CUST.ATM.narrCr,0,50)
								PRINT(BANCS.OUTPUT.TranParticulars)
							ENDIF
						ELSE
							BANCS.OUTPUT.TranParticulars = mid$(CUST.ATM.narrCr,0,50)
							PRINT(BANCS.OUTPUT.TranParticulars)
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF 
	ENDIF
ENDIF
		#####################################################################################################################
		#--------------- MODIFIED BY OSUKA S :Setting Field43(BANCS.INPUT.CardAcceptorName) as TranParticulars -------------#
		IF(BANCS.INPUT.DccId == "PWE") THEN
			IF((FIELDEXISTS(BANCS.INPUT.CardAcceptorName) == 1) AND (BANCS.INPUT.CardAcceptorName != "")) THEN
				BANCS.OUTPUT.TranParticulars = mid$(BANCS.INPUT.CardAcceptorName,0,50)
				PRINT(BANCS.OUTPUT.TranParticulars)
			ENDIF 
		ENDIF
		#####################################################################################################################
		TRACE OFF
		EXITSCRIPT
END-->
