						BANCS.INPARAM.BINDVARS =   BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.CrForacid + "|" + BANCS.INPUT.CardAcceptorName
						sv_w=urhk_dbSelectWithBind(sv_u)
