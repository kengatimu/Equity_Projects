					#{
						sv_u = "REFNUM,NAME|"
						sv_u = sv_u + "select REFNUM,NAME from CUSTOM.C_CIC "
						sv_u = sv_u + " where BANK_ID = ?SVAR AND ACCTNUM = ?SVAR "
						sv_u = sv_u + " AND REFNUM = ?SVAR "
