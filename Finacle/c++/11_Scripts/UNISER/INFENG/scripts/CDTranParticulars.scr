					#}
					ENDIF
				#}
				ENDIF
				IF (BANCS.INPUT.ReservedField1 =="SPT") THEN
				#{
					CUST.ATM.narr2 = "eBank REMMITTANCE"
				#}
				ENDIF
				
				## Setting Tran Particulars for AUTOTOD from BWY ##
				IF (MID$(BANCS.INPUT.ReservedField2,0,15)=="AUTOTODAVAILREQ") THEN
				#{
					CUST.ATM.narr2 = "eBank Avail TOD Charges"
				#}
				ENDIF
				
			#}
			ENDIF
			BANCS.OUTPUT.RefNum = BANCS.INPUT.SerialNum
			CUST.ATM.narr3=""
			
		#}
		ENDIF
		
		
