			#{
				CUST.ATM.narr2="PUR"
			#}
			ENDIF
			IF (CUST.ATM.command =="PRRR") THEN
			#{
				CUST.ATM.narr2="REV"
			#}
			ENDIF
			
		#}
		ENDIF
		
