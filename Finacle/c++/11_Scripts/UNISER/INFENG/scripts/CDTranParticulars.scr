					sv_u = sv_u + " AND REFNUM = ?SVAR "
					sv_u = sv_u + " AND DEL_FLG = 'N' "
					#Print(sv_u)
					BANCS.INPARAM.BINDVARS =   BANCS.STDIN.contextBankId + "|" + BANCS.INPUT.CrForacid + "|" + BANCS.INPUT.ReservedField2
					sv_w=urhk_dbSelectWithBind(sv_u)
