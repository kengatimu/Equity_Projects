		MTT.PartTranDetails.RefAmount=sv_o
		MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
		MTT.PartTranDetails.RateCode = "" 
		if(MTT.PartTranDetails.RefAmount >= 0) then
            MTT.PartTranDetails.Particulars=MTT.InputDetails.loanAcct + " - Credit to Interest Collect Account "
        else
            MTT.PartTranDetails.Particulars=MTT.InputDetails.loanAcct + " - Debit to Interest Collect Account "
        endif
		MTT.PartTranDetails.Consolidate="Y"
		MTT.PartTranDetails.TranIdentifier="chargeOff"
		MTT.PartTranDetails.PTranBusinessType="LOANS"
