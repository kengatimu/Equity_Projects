			MTT.PartTranDetails.Account=MTT.InputDetails.penalPandLAcid
			MTT.PartTranDetails.RefAmount=-(sv_e)
			MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
			MTT.PartTranDetails.RateCode =MTT.InputDetails.rateCode 
			MTT.PartTranDetails.Particulars=MTT.InputDetails.loanAcct + " - Debit to Penal P&L Account "
			MTT.PartTranDetails.Consolidate="Y"
			MTT.PartTranDetails.TranIdentifier="chargeOff"
			MTT.PartTranDetails.PTranBusinessType="LOANS"
			MTT.PartTranDetails.ACPARTB2kId=MTT.InputDetails.loanAcct
            MTT.PartTranDetails.sysPartTranCode ="PTRN01156"
		 	MTT.PartTranDetails.EntryUserId="SYSTEM"
		 	MTT.PartTranDetails.EntryTime=BANCS.STDIN.BODDate
			sv_z = urhk_MTTS_DefinePartTran("penalInt")
		endif
	endif 

###############################################################################
# Credit Loan Acccount
###############################################################################
sv_p=sv_p+sv_g
	if (sv_p != 0) then
		if(MTT.InputDetails.intRouteFlg=="L") then
			MTT.PartTranDetails.Account=MTT.InputDetails.loanAcct
			MTT.PartTranDetails.Particulars=MTT.InputDetails.loanAcct + "- Charge Off from loan"
			MTT.LAAddnlDetails.LoanAcctId = MTT.InputDetails.loanAcct      
		endif
		if(MTT.InputDetails.intRouteFlg=="O") then
			MTT.PartTranDetails.Account=MTT.InputDetails.loanIntAcct
			MTT.PartTranDetails.Particulars= MTT.InputDetails.loanAcct + " - Charge off from Suspense "
			MTT.LAAddnlDetails.LoanAcctId = MTT.InputDetails.loanAcct
			MTT.PartTranDetails.ACPARTB2kId=MTT.InputDetails.loanAcct
			MTT.PartTranDetails.ACPARTB2kType="ACCNT"
		endif

		        MTT.PartTranDetails.Consolidate="N"
		        MTT.PartTranDetails.RateCode = ""

           if(sv_w != "E") then
			   MTT.PartTranDetails.RefAmount=sv_p
			else
			            MTT.PartTranDetails.RefAmount=(sv_p+sv_u)
			endif   
		MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
		MTT.PartTranDetails.TranIdentifier="chargeOff"
###############################################################################
# Imp:- Do Not Change the PTranBusinessType. This is used for ACPART entries.
###############################################################################
		MTT.PartTranDetails.PTranBusinessType="LAINT"
		MTT.LAAddnlDetails.TypeOfDemand = "A"
		MTT.LAAddnlDetails.OriginOfTran = "CHOFF"
		MTT.LAAddnlDetails.DemandFlowId = MTT.InputDetails.defltCollFlowId
