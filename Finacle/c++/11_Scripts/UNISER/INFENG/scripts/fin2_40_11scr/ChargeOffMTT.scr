		MTT.PartTranDetails.PTranBusinessType="LOANS"
		MTT.PartTranDetails.EntryUserId="SYSTEM"
		MTT.PartTranDetails.EntryTime=BANCS.STDIN.BODDate
        MTT.PartTranDetails.sysPartTranCode ="PTRN01160"
		sv_z = urhk_MTTS_DefinePartTran("prinLossLine")

###############################################################################
# Credit Charge Off Loss Line
###############################################################################
		MTT.PartTranDetails.Account=MTT.InputDetails.chargeOffLine
