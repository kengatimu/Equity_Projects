		MTT.PartTranDetails.EntryUserId="SYSTEM"
		MTT.PartTranDetails.EntryTime=BANCS.STDIN.BODDate
        MTT.PartTranDetails.sysPartTranCode ="PTRN02523"

        sv_z = urhk_MTTS_DefinePartTran("provisionCrAcct")
    endif

##############################################################################
# Debit to Unearned Income
###############################################################################

if(sv_u != 0) then
   if(sv_w == "E") then
      if (sv_i == "M" OR sv_i == "T") then
		 if ((sv_j == "F") OR (sv_j == "P")) then
            MTT.PartTranDetails.Account=MTT.InputDetails.ueiAcct
            MTT.PartTranDetails.RefAmount=-sv_u
            MTT.PartTranDetails.RefCurrency=MTT.InputDetails.tranCrncy
