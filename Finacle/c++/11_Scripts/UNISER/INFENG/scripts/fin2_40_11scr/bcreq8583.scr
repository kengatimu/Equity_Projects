		#      sv_a = "1200" + CDCI.Request8583.Field11
		#      print(sv_a)
		#      sv_a = sv_a + CDCI.Request8583.Field12 + "06" + RTRIM(LTRIM(CDCI.Request8583.Field32))


		sv_a = sv_a + "06" + RTRIM(LTRIM(CDCI.Request8583.Field32))
		CDCI.Request8583.Field56 = sv_a 
		#Print(CDCI.Request8583.Field56)
	ENDIF

	IF (FIELDEXISTS(CDCI.Request8583.Field102) == 1) THEN
		IF (CDCI.Request8583.Field102=="1111111111111") THEN
			CDCI.Request8583.Field102="0003000102201"
		ENDIF
	     sv_a = "068        " + MID$(CDCI.Request8583.Field102,0,3) + "     "
	     CDCI.Request8583.Field102 = sv_a + LTRIM(RTRIM(CDCI.Request8583.Field102))
	     #Print(CDCI.Request8583.Field102)
	ENDIF

	IF (FIELDEXISTS(CDCI.Request8583.Field103) == 1) THEN
