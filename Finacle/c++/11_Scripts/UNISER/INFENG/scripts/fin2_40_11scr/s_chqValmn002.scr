<--START
CHECKSUM="641e5d7e331e75379313563a58c9fefa8d7a0d650a609ac0b61fbcd4549cdc6f"
	TRACE ON
	#------------------------------------------------------------------------------
	#Creating repository and class
	#------------------------------------------------------------------------------
	IF(REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF(CLASSEXISTS("CUST","DATA") == 0) THEN
	#{
		CREATECLASS("CUST","DATA",5)
	#}
	ENDIF
	
	CUST.DATA.schmCode = ""
	
	#------------------------------------------------
	#----cparam
	#------------------------------------------------
	BANCS.INPUT.moduleName = "CLEARING"
	BANCS.INPUT.parameterId = "CHQVAL_ACCT"
	
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		print(BANCS.OUTPUT.parameterVal)
		CUST.DATA.chqValAcctId=BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		sv_u = urhk_SRV_SetErr("Error: Parameter value for "+BANCS.INPUT.parameterId+" is not set in C_CPARAM_VALUE_TABLE")
		print("Parameter value not set in C_CPARAM_VALUE_TABLE")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "CHQVAL_BNKCD"
	
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		print(BANCS.OUTPUT.parameterVal)
		CUST.DATA.chqValBankCd=BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		sv_u = urhk_SRV_SetErr("Error: Parameter value for "+BANCS.INPUT.parameterId+" is not set in C_CPARAM_VALUE_TABLE")
		print("Parameter value not set in C_CPARAM_VALUE_TABLE")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "CHQVAL_ZONECD1"
	
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		print(BANCS.OUTPUT.parameterVal)
		CUST.DATA.chqValZoneCd1=BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		sv_u = urhk_SRV_SetErr("Error: Parameter value for "+BANCS.INPUT.parameterId+" is not set in C_CPARAM_VALUE_TABLE")
		print("Parameter value not set in C_CPARAM_VALUE_TABLE")
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#--------------------------------------------------------------
	# Input from zone header
	#--------------------------------------------------------------
	sv_u = urhk_SRV_GetVal("zoneHeader.zoneCrncyCode.crncyCode")
	CUST.DATA.zoneCcy = BANCS.OUTPARAM.srvValue
	print(CUST.DATA.zoneCcy)
	
	sv_u = urhk_SRV_GetVal("zoneHeader.zoneCode")
	CUST.DATA.zoneCode = BANCS.OUTPARAM.srvValue
	print(CUST.DATA.zoneCode)
	
	#--------------------------------------------------------------
	# Input from instrument details
	#--------------------------------------------------------------
	sv_u = urhk_SRV_NumOfRecs("instrLL")
	CUST.DATA.noOfRecords = CINT(BANCS.OUTPARAM.srvValue)
	
	sv_l = 0
	WHILE(sv_l < CUST.DATA.noOfRecords)
	#{
		sv_v = Format$(sv_l,"%d")
		sv_r = "<rec_"+sv_v+">"
		
		sv_u = urhk_SRV_GetVal("instrLL." +sv_r+ ".instrmntId")
		CUST.DATA.instrNum = BANCS.OUTPARAM.srvValue
		PRINT(CUST.DATA.instrNum)
		
		sv_u = urhk_SRV_GetVal("instrLL." +sv_r+ ".bankBranchCode.brCode")
		CUST.DATA.brCode = BANCS.OUTPARAM.srvValue
		PRINT(CUST.DATA.brCode)
		
		sv_u = urhk_SRV_GetVal("instrLL." +sv_r+ ".bankBranchCode.bankCode")
		CUST.DATA.bankCode = BANCS.OUTPARAM.srvValue
		PRINT(CUST.DATA.bankCode)
		
		sv_u = urhk_SRV_GetVal("instrLL." +sv_r+ ".instrmntDate")
		CUST.DATA.instDate = BANCS.OUTPARAM.srvValue
		PRINT(CUST.DATA.instDate)
		
		IF ((CUST.DATA.bankCode == CUST.DATA.chqValBankCd) AND (CUST.DATA.instDate == "")) THEN
		#{
			sv_u = urhk_SRV_SetErr("instrLL." +sv_r+ ".instrmntDate|Error:Instrument Date is Mandatory")
			print("Instrument Date is Mandatory")
			print(sv_u)
			BANCS.OUTPUT.successOrFailure="F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		IF ((CUST.DATA.zoneCode == CUST.DATA.chqValZoneCd1) AND (CUST.DATA.bankCode!= CUST.DATA.chqValBankCd)) THEN
		#{
			sv_u = urhk_TBAF_DispMesg(" Only Cheques Drawn ON Equity AND Paid In Equity allowed...")
			BANCS.OUTPUT.successOrFailure="F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		#-----------------------------------------
		#Instrument no check
		#------------------------------------------
		sv_u = urhk_SRV_GetVal("instrLL." +sv_r+ ".instrmntId")
		CUST.DATA.instNo = BANCS.OUTPARAM.srvValue
		PRINT(CUST.DATA.instNo)
		
		IF (CUST.DATA.instNo!="") THEN
		#{
			CUST.DATA.instNo=trim(CUST.DATA.instNo)
			sv_a=STRLEN(CUST.DATA.instNo)
			IF (sv_a>6) THEN
			#{
				print("Instrument Number can not be greater than 6 in length")
				sv_u = urhk_SRV_SetErr("instrLL." +sv_r+ ".instrmntId|Instrument Number can not be greater than 6 in length")
				print(sv_u)
				BANCS.OUTPUT.successOrFailure="F"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
		#}
		ENDIF
		
		#-----------------------------------------------
		#Inst Amt check
		#-----------------------------------------------
		sv_u = urhk_SRV_GetVal("instrLL."+sv_r+".instrmntAmt")
		CUST.DATA.instAmt = BANCS.OUTPARAM.srvValue
		PRINT(CUST.DATA.instAmt)
		sv_a=STRLEN(CUST.DATA.instAmt)
		print(sv_a)
		sv_c=4
		sv_b=sv_a-sv_c
		print(sv_b)
		sv_a=LEFT$(CUST.DATA.instAmt,sv_b)
		print(sv_a)
		CUST.DATA.instAmt=sv_a
		sv_s= "amt|SELECT SUBSTR(?SVAR ,1,LENGTH(?SVAR)-1) FROM dual"
		BANCS.INPARAM.BINDVARS = CUST.DATA.instAmt + "|" + CUST.DATA.instAmt
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF (sv_d==0) THEN
		#{
			CUST.DATA.amt= BANCS.OUTPARAM.amt
			print(CUST.DATA.amt)
		#}
		ENDIF
		
		sv_g = CUST.DATA.amt
		sv_g = cdouble(sv_g)
		print(sv_g)
		
		#CUST.DATA.instAmt=sv_g
		sv_s= "oddcent|SELECT SUBSTR( ?SVAR,-1,1) FROM dual"
		BANCS.INPARAM.BINDVARS = CUST.DATA.instAmt
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF (sv_d==0) THEN
		#{
			CUST.DATA.oddcent= BANCS.OUTPARAM.oddcent
			print(CUST.DATA.oddcent)
		#}
		ENDIF
		
		sv_u = urhk_SRV_GetVal("instrLL."+sv_r+".payingAcctId")
		CUST.DATA.acctNo = BANCS.OUTPARAM.srvValue
		PRINT(CUST.DATA.acctNo)
		
		
		
		sv_h = CUST.DATA.oddcent
		print(CUST.DATA.oddcent)
		
		IF ((sv_h != CINT("0")) AND (sv_h !=CINT("5"))) THEN
		#{
			sv_h=CINT(sv_h)
			IF (sv_h <5) THEN
			#{
				sv_h = 0
				#}
			ELSE
				#{
				sv_h = 5
			#}
			ENDIF
			CUST.DATA.last = sv_h
			sv_h = cdouble(CUST.DATA.last)
			sv_h = (sv_h /100)
			CUST.DATA.last = sv_h
			sv_i = sv_g + sv_h
			CUST.DATA.amount1 = sv_i
			sv_j = STRLEN(CUST.DATA.amount1)
			CUST.DATA.amount1 = MID$(CUST.DATA.amount1,0,(sv_j -4))
			print(CUST.DATA.amount1)
			CUST.DATA.instAmt=CUST.DATA.amount1
			IF((BANCS.STDIN.contextBankId == "54") OR (BANCS.STDIN.contextBankId == "56")) THEN
			#{
				IF(CUST.DATA.zoneCcy == BANCS.STDIN.homeCrncyCode) THEN
				#{
					sv_u = urhk_SRV_SetErr("instrLL."+sv_r+".instrmntAmt|The Instr Amount is incorrect, odd cents")
					sv_u = urhk_SRV_SetVal("instrLL."+sv_r+".instrmntAmt|"+CUST.DATA.instAmt)
					BANCS.OUTPUT.successOrFailure="F"
					GOTO ENDOFSCRIPT
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF
		#----------------------------------------------
		#Payee acct Id check
		#-----------------------------------------------
		sv_u = urhk_SRV_GetVal("instrLL."+sv_r+".payingAcctId")
		CUST.DATA.payAcctId = BANCS.OUTPARAM.srvValue
		PRINT(CUST.DATA.payAcctId)
		
		IF (CUST.DATA.payAcctId == "") THEN
		#{
			print("Enter The Account ID")
			sv_u = urhk_SRV_SetErr("instrLL."+sv_r+".payingAcctId|Enter Paying A/c ID")
			BANCS.OUTPUT.successOrFailure="F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		IF ((CUST.DATA.payAcctId == CUST.DATA.chqValAcctId) OR (CUST.DATA.payAcctId == "")) THEN
		#{
			print("Invalid Paying A/c ID")
			sv_u = urhk_SRV_SetErr("instrLL."+sv_r+".payingAcctId|Invalid Paying A/c ID")
			BANCS.OUTPUT.successOrFailure="F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#----------------------------------------
		#Tran code check
		#----------------------------------------
		sv_u = urhk_SRV_GetVal("instrLL." +sv_r+ ".tranCode.clgTranCode")
		CUST.DATA.tranCode = BANCS.OUTPARAM.srvValue
		PRINT(CUST.DATA.tranCode)
		IF  (CUST.DATA.tranCode == "") THEN
		#{
			print("Tran code is mandatory")
			sv_u = urhk_SRV_SetErr("instrLL." +sv_r+ ".tranCode.clgTranCode|Tran code is mandatory")
			BANCS.OUTPUT.successOrFailure="F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#---------------------------------------------
		#Br Code Validation
		#-------------------------------------------------
		sv_s = "branchexist|SELECT count(*) "
		sv_s = sv_s + " FROM TBAADM.BCT "
		sv_s = sv_s + " WHERE TRIM(BANK_CODE)=?SVAR "
		sv_s = sv_s + " AND TRIM(BR_CODE)= ?SVAR  "
		sv_s = sv_s + " AND bank_id = ?SVAR "
		print(sv_s)
		BANCS.INPARAM.BINDVARS = CUST.DATA.bankCode + "|" + CUST.DATA.brCode +"|"+ BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF (sv_d==0) THEN
		#{
			CUST.DATA.branchexist= BANCS.OUTPARAM.branchexist
			print(CUST.DATA.branchexist)
		#}
		ENDIF
		
		IF (CUST.DATA.branchexist !=1) THEN
		#{
			print("The Bank AND Branch combination does not exist")
			sv_u = urhk_SRV_SetErr("instrLL."+sv_r+".bankBranchCode.bankCode|The Bank AND Branch combination does not exist")
			BANCS.OUTPUT.successOrFailure="F"
			GOTO ENDOFSCRIPT
		#}
		ENDIF
		
		#-----------------------------------------------
		IF (TRIM(CUST.DATA.bankCode) == CUST.DATA.chqValBankCd) THEN
		#{
			CUST.DATA.sol = CUST.DATA.brCode
			
			sv_s = "Count|SELECT count(*) "
			sv_s = sv_s + " FROM TBAADM.GAM "
			sv_s = sv_s + " WHERE foracid =?SVAR"
			sv_s = sv_s + " AND acct_cls_flg != 'Y' "
			sv_s = sv_s + " AND del_flg !='Y' "
			sv_s = sv_s + " AND entity_cre_FLG ='Y' "
			sv_s = sv_s + " AND bank_id = ?SVAR "
			print(sv_s)
			BANCS.INPARAM.BINDVARS = CUST.DATA.payAcctId + "|" +BANCS.STDIN.contextBankId
			PRINT(BANCS.INPARAM.BINDVARS)
			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			IF (sv_d==0) THEN
			#{
				CUST.DATA.countPayId= BANCS.OUTPARAM.Count
				print(CUST.DATA.countPayId)
			#}
			ENDIF
			
			IF (CUST.DATA.countPayId == "0") THEN
			#{
				sv_s = "foracid|SELECT foracid FROM CUSTOM.OLD_ACCT_MAP "
				sv_s = sv_s + " WHERE old_num = ?SVAR"
				sv_s = sv_s + " AND sol_id = ?SVAR "
				sv_s = sv_s + " AND bank_id = ?SVAR "
				print(sv_s)
				BANCS.INPARAM.BINDVARS = CUST.DATA.payAcctId +"|"+CUST.DATA.sol+"|"+ BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_q = urhk_dbSelectWithBind(sv_s)
				print(sv_q)
				
				IF (sv_q == 0) THEN
				#{
					CUST.DATA.foracid= BANCS.OUTPARAM.foracid
					print(CUST.DATA.foracid)
					sv_u = urhk_SRV_SetVal("instrLL."+sv_r+".payingAcctId|"+CUST.DATA.foracid)
					GOTO Finish
					#}
				ELSE
					#{
					print("Drawer Acc does not exist..Cant proceed")
					sv_u = urhk_SRV_SetErr("instrLL."+sv_r+".payingAcctId|Drawer Acc does not exist..Cant proceed")
					BANCS.OUTPUT.successOrFailure="F"
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				#}
			ELSE
				#{
				sv_u = urhk_SRV_SetVal("instrLL."+sv_r+".payingAcctId|"+ CUST.DATA.payAcctId)
				GOTO Finish
			#}
			ENDIF
		#}
		ENDIF
		
		sv_l = sv_l + 1
		PRINT (sv_l)
	#}
	DO
	
	ENDOFSCRIPT :
		EXIT
		TRACE OFF
END-->
