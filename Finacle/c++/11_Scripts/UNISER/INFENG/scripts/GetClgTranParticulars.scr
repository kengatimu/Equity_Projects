#-------------------------------------------------------------------------------------
#    Name               : GetClgTranParticulars.scr
#    Description        : This script will give the tranremarks and value date.
#    Date               : 11-02-2013
#    Author             : Chandrasekhar
#    Input              : NA
#    Output             : NA
#    Called Script      : NA
#    Calling Script     : NA
#    Menu Option        :
#    Srl. No        Date            Author          Description.
#    -------        ----            ------          ----------------
#    1.0            11-02-2013      Chandrasekhar   Original Version
#-------------------------------------------------------------------------------------
<--START
CHECKSUM="5a86c285c90d2b0f3278840ce5642e35355204e0316a778946e6aa16533244ee"
	#TRACE ON
	
	sv_r = REPEXISTS("OCTR")
	
	IF (sv_r == 0) THEN
	#{
		CREATEREP("OCTR")
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("OCTR", "GLBVAR")
	
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("OCTR", "GLBVAR", 5)
	#}
	ENDIF
	
	#sv_r=urhk_B2k_PrintRepos("BANCS")
	sv_a = BANCS.INPUT.OCPParticulars
	BANCS.INPUT.instNum = TRIM(BANCS.INPUT.instNum)
	print(BANCS.INPUT.instNum)
	sv_d = BANCS.INPUT.instNum
	sv_e = BANCS.INPUT.clgZoneCode
	sv_f = BANCS.INPUT.clgZoneDate
	sv_g = BANCS.INPUT.OCPRemarks
	OCTR.GLBVAR.errMsg = ""
	
	BANCS.INPUT.moduleName="CLEARING"
	BANCS.INPUT.parameterId="ZONE_CUSTOZONE"
	call("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "") THEN
	#{
		OCTR.GLBVAR.zone1 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		OCTR.GLBVAR.errMsg = BANCS.INPUT.parameterId+" setup is not done in CPARAM"
		GOTO FINISH
	#}
	ENDIF
	
	BANCS.INPUT.moduleName="CLEARING"
	BANCS.INPUT.parameterId="ZONE_PROMPTZONE"
	call("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "") THEN
	#{
		OCTR.GLBVAR.zone2 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		OCTR.GLBVAR.errMsg = BANCS.INPUT.parameterId+" setup is not done in CPARAM"
		GOTO FINISH
	#}
	ENDIF
	
	BANCS.INPUT.moduleName="CLEARING"
	BANCS.INPUT.parameterId="SRT4"
	call("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "") THEN
	#{
		OCTR.GLBVAR.str4 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		OCTR.GLBVAR.errMsg = BANCS.INPUT.parameterId+" setup is not done in CPARAM"
		GOTO FINISH
	#}
	ENDIF
	
	IF ((BANCS.INPUT.clgZoneCode == OCTR.GLBVAR.zone1) OR (BANCS.INPUT.clgZoneCode == OCTR.GLBVAR.zone2)) THEN
	#{
		BANCS.OUTPUT.tranParticulars = BANCS.INPUT.OCPParticulars
		#}
	ELSE
		#{
		BANCS.OUTPUT.tranParticulars = OCTR.GLBVAR.str4 + BANCS.INPUT.instNum
	#}
	ENDIF
	
	#-----------------------------------------------------------------------
	# Tran Remarks column updated with the Payee name
	#-----------------------------------------------------------------------
	
	BANCS.INPARAM.BINDVARS = BANCS.INPUT.clgZoneCode + "|" + BANCS.INPUT.clgZoneDate
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.mySolId
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.INPUT.OCISet
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.INPUT.OCIInstNo
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.INPUT.instNum
	BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + "|" + BANCS.STDIN.contextBankId
	
	sv_q = "FreeText3,FreeText2|SELECT FREETEXT3, FREETEXT2 FROM TBAADM.OCI "
	sv_q = sv_q + " WHERE CLG_ZONE_CODE= ?SVAR AND CLG_ZONE_DATE=TO_DATE(?SVAR,'DD-MM-YYYY HH24:MI:SS') "
	sv_q = sv_q + " AND SOL_ID = ?SVAR AND SET_NUM = LPAD(?SVAR ,6) "
	sv_q = sv_q + " AND INSTRMNT_SRL_NUM = LPAD(?SVAR,4) "
	sv_q = sv_q + " AND INSTRMNT_ID = LPAD(?SVAR,16) "
	sv_q = sv_q + " AND BANK_ID = ?SVAR"
	
	sv_d = urhk_dbSelectWithBind(sv_q)
	print(sv_d)
	
	IF(sv_d == 0) THEN
	#{
		
		BANCS.OUTPUT.tranRemarks = BANCS.OUTPARAM.FreeText3
		BANCS.INPUT.OCPRemarks = BANCS.OUTPUT.tranRemarks
		OCTR.GLBVAR.FreeText2 = BANCS.OUTPARAM.FreeText2
		
	#}
	ENDIF
	
	
	BANCS.OUTPUT.tranRemarks = BANCS.INPUT.OCPRemarks
	#BANCS.OUTPUT.tranRemarks = ""
	BANCS.OUTPUT.valueDate = BANCS.INPUT.clgZoneDate
	
	OCTR.GLBVAR.billerFlg = "N"
	sv_q = "cnt|SELECT COUNT(1) FROM CUSTOM.C_UBP "
	sv_q = sv_q + " WHERE FREETEXT7 = ?SVAR AND BILLER_BNK_ID = ?SVAR "
	BANCS.INPARAM.BINDVARS = OCTR.GLBVAR.FreeText2 + "|" + BANCS.STDIN.contextBankId
	sv_d = urhk_dbSelectWithBind(sv_q)
	print(sv_d)
	IF(sv_d == 0) THEN
	#{
		# Biller transaction
		print(BANCS.OUTPARAM.cnt)
		IF(CINT(BANCS.OUTPARAM.cnt) != 0)THEN
		#{
			OCTR.GLBVAR.billerFlg = "Y"
		#}
		ENDIF
	#}
	ENDIF
	
	
	
	IF(FIELDEXISTS(BANCS.INPUT.OCPFreeText1))THEN
	#{
		IF((TRIM(BANCS.INPUT.OCPFreeText1) != "") AND (OCTR.GLBVAR.billerFlg == "Y"))THEN
		#{
			BANCS.OUTPUT.tranParticulars = BANCS.OUTPUT.tranParticulars + " " + BANCS.OUTPUT.tranRemarks
			BANCS.OUTPUT.tranRemarks = BANCS.INPUT.OCPFreeText1
			#}
		ELSE
			#{
			BANCS.OUTPUT.tranParticulars = BANCS.OUTPUT.tranParticulars + " " + BANCS.OUTPUT.tranRemarks
			BANCS.OUTPUT.tranRemarks = ""
		#}
		ENDIF
	#}
	ENDIF
	print(BANCS.OUTPUT.tranParticulars)
	BANCS.OUTPUT.tranParticulars = LEFT$(BANCS.OUTPUT.tranParticulars,50)
	print(BANCS.OUTPUT.tranParticulars)
	print(BANCS.OUTPUT.tranRemarks)
	
	
	
	FINISH:
		IF (OCTR.GLBVAR.errMsg != "") THEN
		#{
			print("test")
			sv_i = "echo " +OCTR.GLBVAR.errMsg + ">> tranParticulrError.log"
			print(sv_i)
		#}
		ENDIF
		EXITSCRIPT
		TRACE OFF
END-->
