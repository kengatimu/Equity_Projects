<--START
CHECKSUM="e590fb0519c2ede5a2c631968d5b6099516e956a47d1f4ac9124c4b49190d6a7"
	#trace on
	
	#sv_r=urhk_B2k_PrintRepos("BANCS")
	#print (sv_r)
	
	##################################################################
	# Script for slabwise insuarance fee collection
	##################################################################
	
	#--------------------------------------------------------------------------
	#  Creation of CUST repository and INSU class
	#--------------------------------------------------------------------------
	
	sv_r = REPEXISTS("INSU")
	IF (sv_r == 0) THEN
	#{
		CREATEREP("INSU")
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("INSU", "LOAN")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("INSU", "LOAN", 5)
	#}
	ENDIF
	
	INSU.LOAN.FreeCode1=""
	INSU.LOAN.FreeCode2=""
	INSU.LOAN.company=""
	INSU.LOAN.Pattrns=""
	INSU.LOAN.TTLFEE=""
	INSU.LOAN.errMsg=""
	
	#------------------------------------------------
	#----cparam
	#------------------------------------------------
	BANCS.INPUT.moduleName = "CHARGES"
	BANCS.INPUT.parameterId = "AST164_SCHMLST1"
	
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		print(BANCS.OUTPUT.parameterVal)
		INSU.LOAN.schmCodeLst1=BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		sv_u = "RESULT_MSG|Parameter value for "+BANCS.INPUT.parameterId+" is not set in C_CPARAM_VALUE_TABLE"
		INSU.LOAN.errMsg=sv_u
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "AST164_GLPCNT1"
	
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		print(BANCS.OUTPUT.parameterVal)
		INSU.LOAN.pGlpcnt1=BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		sv_u = "RESULT_MSG|Parameter value for "+BANCS.INPUT.parameterId+" is not set in C_CPARAM_VALUE_TABLE"
		INSU.LOAN.errMsg=sv_u
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "AST164_GLPCNT2"
	
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		print(BANCS.OUTPUT.parameterVal)
		INSU.LOAN.pGlpcnt2=BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		sv_u = "RESULT_MSG|Parameter value for "+BANCS.INPUT.parameterId+" is not set in C_CPARAM_VALUE_TABLE"
		INSU.LOAN.errMsg=sv_u
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "AST164_PTDPCNT1"
	
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		print(BANCS.OUTPUT.parameterVal)
		INSU.LOAN.pPTDpcnt1=BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		sv_u = "RESULT_MSG|Parameter value for "+BANCS.INPUT.parameterId+" is not set in C_CPARAM_VALUE_TABLE"
		INSU.LOAN.errMsg=sv_u
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "AST164_PTDPCNT2"
	
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		print(BANCS.OUTPUT.parameterVal)
		INSU.LOAN.pPTDpcnt2=BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		sv_u = "RESULT_MSG|Parameter value for "+BANCS.INPUT.parameterId+" is not set in C_CPARAM_VALUE_TABLE"
		INSU.LOAN.errMsg=sv_u
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "AST164_AMT"
	
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		print(BANCS.OUTPUT.parameterVal)
		INSU.LOAN.pAmt=BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		sv_u = "RESULT_MSG|Parameter value for "+BANCS.INPUT.parameterId+" is not set in C_CPARAM_VALUE_TABLE"
		INSU.LOAN.errMsg=sv_u
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "AST164_PTDADD"
	
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		print(BANCS.OUTPUT.parameterVal)
		INSU.LOAN.pPtdadd=BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		sv_u = "RESULT_MSG|Parameter value for "+BANCS.INPUT.parameterId+" is not set in C_CPARAM_VALUE_TABLE"
		INSU.LOAN.errMsg=sv_u
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "AST164_DISCNT"
	
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		print(BANCS.OUTPUT.parameterVal)
		INSU.LOAN.pDisCnt=BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		sv_u = "RESULT_MSG|Parameter value for "+BANCS.INPUT.parameterId+" is not set in C_CPARAM_VALUE_TABLE"
		INSU.LOAN.errMsg=sv_u
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "AST164_PERIOD"
	
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		print(BANCS.OUTPUT.parameterVal)
		INSU.LOAN.pPeriod=BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		sv_u = "RESULT_MSG|Parameter value for "+BANCS.INPUT.parameterId+" is not set in C_CPARAM_VALUE_TABLE"
		INSU.LOAN.errMsg=sv_u
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "AST164_SCHMLST2"
	
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		print(BANCS.OUTPUT.parameterVal)
		INSU.LOAN.schmCodeLst2=BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		sv_u = "RESULT_MSG|Parameter value for "+BANCS.INPUT.parameterId+" is not set in C_CPARAM_VALUE_TABLE"
		INSU.LOAN.errMsg=sv_u
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#-------------------------------------------------------------------------
	# Selecting the Free TEXT 1  in table GAC
	#--------------------------------------------------------------------------
	print(BANCS.INPUT.Foracid)
	INSU.LOAN.Foracid=BANCS.INPUT.Foracid
	
	sv_s = "Freetext1,Freetext2|"
	sv_s = sv_s + " SELECT free_text_1,free_text_2"
	sv_s = sv_s + " FROM TBAADM.GAC "
	sv_s = sv_s + " WHERE acid in ("
	sv_s = sv_s + "          SELECT acid "
	sv_s = sv_s + "          FROM TBAADM.GAM "
	sv_s = sv_s + "          WHERE foracid = ?SVAR "
	sv_s = sv_s + "          AND del_flg = 'N' "
	sv_s = sv_s + "          AND GAM.del_flg = 'N' "
	sv_s = sv_s + "          AND GAM.bank_id = ?SVAR ) "
	sv_s = sv_s + " AND bank_id = ?SVAR "
	print(sv_s)
	BANCS.INPARAM.BINDVARS = INSU.LOAN.Foracid + "|" + BANCS.STDIN.contextBankId +"|"+ BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_d =urhk_dbSelectWithBind(sv_s)
	IF (sv_d == 0) THEN
	#{
		print ("YAA")
		INSU.LOAN.FreeCode1 = BANCS.OUTPARAM.Freetext1
		INSU.LOAN.FreeCode2 = BANCS.OUTPARAM.Freetext2
		print(INSU.LOAN.FreeCode1)
		print(INSU.LOAN.FreeCode2)
		IF (INSU.LOAN.FreeCode1 > 0 ) THEN
		#{
			print("YAA")
			INSU.LOAN.Pattrns = INSU.LOAN.FreeCode1
		#}
		ENDIF
		
		IF (INSU.LOAN.FreeCode2 !="" ) THEN
		#{
			print("YAA")
			INSU.LOAN.company = INSU.LOAN.FreeCode2
		#}
		ENDIF
	#}
	ENDIF
	
	#-------------------------------------------------------------------------
	# Selecting the period in table lam
	# if the period is 0 then exiting
	#--------------------------------------------------------------------------
	
	sv_s = "period,SchmCode|"
	sv_s = sv_s + " SELECT rep_perd_mths,schm_code"
	sv_s = sv_s + " FROM TBAADM.LAM, TBAADM.GAM "
	sv_s = sv_s + " WHERE LAM.acid = GAM.acid "
	sv_s = sv_s + " AND LAM.bank_id = GAM.bank_id "
	sv_s = sv_s + " AND GAM.foracid = ?SVAR "
	sv_s = sv_s + " AND GAM.bank_id = ?SVAR "
	sv_s = sv_s + " AND LAM.del_flg = 'N' "
	sv_s = sv_s + " AND LAM.entity_cre_flg = 'Y' "
	sv_s = sv_s + " AND GAM.del_flg = 'N' "
	sv_s = sv_s + " AND GAM.entity_cre_flg = 'Y' "
	print(sv_s)
	BANCS.INPARAM.BINDVARS = INSU.LOAN.Foracid + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	
	IF (sv_d == 0) THEN
	#{
		INSU.LOAN.period = BANCS.OUTPARAM.period
		INSU.LOAN.schmcode = BANCS.OUTPARAM.SchmCode
		#}
	ELSE
		#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	sv_m = GETPOSITION(INSU.LOAN.schmCodeLst1,"|"+INSU.LOAN.schmcode+"|")
	print(sv_m)
	IF (sv_m>0) THEN
	#{
		#INSU.LOAN.GLpcnt ="0.0022"
		#INSU.LOAN.PTDpcnt="0.0008"
		INSU.LOAN.GLpcnt =INSU.LOAN.pGlpcnt1
		INSU.LOAN.PTDpcnt=INSU.LOAN.pPTDpcnt1
		#}
	ELSE
		#{
		#INSU.LOAN.GLpcnt ="0.00475"
		#INSU.LOAN.PTDpcnt="0.0015"
		INSU.LOAN.GLpcnt =INSU.LOAN.pGlpcnt2
		INSU.LOAN.PTDpcnt=INSU.LOAN.pPTDpcnt2
	#}
	ENDIF
	
	
	
	INSU.LOAN.amnt=BANCS.INPUT.inputAmount
	print(INSU.LOAN.amnt)
	
	IF (BANCS.INPUT.inputCrncy != BANCS.STDIN.homeCrncyCode) THEN
	#{
		BANCS.INPARAM.InputAmount = INSU.LOAN.amnt
		BANCS.INPARAM.FromCurrency =BANCS.INPUT.inputCrncy
		BANCS.INPARAM.ToCurrency = BANCS.STDIN.homeCrncyCode
		BANCS.INPARAM.RateCode = BANCS.INPUT.rateCode
		BANCS.INPARAM.Rate = 0.00
		BANCS.INPARAM.CustId = ""
		
		sv_u = urhk_B2k_ConvertAmount("")
		print(sv_u)
		
		IF(sv_u == 0)THEN
		#{
			INSU.LOAN.amnt = CDOUBLE(BANCS.OUTPARAM.OutputAmount)
			PRINT(INSU.LOAN.amnt)
			#}
		ELSE
			#{
			
			print("Unable to derive charge amount in Ref Ccy;")
			INSU.LOAN.TTLFEE=0
			GOTO ENDOFSCRIPT
		#}
		ENDIF
	#}
	ENDIF
	
	
	IF (CDOUBLE(INSU.LOAN.amnt) > CDOUBLE(INSU.LOAN.pAmt)) THEN
	#{
		INSU.LOAN.amnt = INSU.LOAN.pAmt
	#}
	ENDIF
	
	INSU.LOAN.GLFEE1=CDOUBLE(INSU.LOAN.amnt) *CDOUBLE(INSU.LOAN.GLpcnt)*CDOUBLE(INSU.LOAN.period)
	INSU.LOAN.GLFEE2=CDOUBLE(INSU.LOAN.GLFEE1) / CDOUBLE("12")
	print(INSU.LOAN.GLFEE2)
	
	INSU.LOAN.PTDFEE1=CDOUBLE(INSU.LOAN.amnt) *CDOUBLE(INSU.LOAN.PTDpcnt)*CDOUBLE(INSU.LOAN.period)
	INSU.LOAN.PTDFEE2=CDOUBLE(INSU.LOAN.PTDFEE1) / CDOUBLE("12")
	print(INSU.LOAN.PTDFEE2)
	
	INSU.LOAN.PTDADD=INSU.LOAN.pPtdadd
	INSU.LOAN.PTDADD1= CDOUBLE(INSU.LOAN.PTDFEE2) * CDOUBLE(INSU.LOAN.PTDADD)
	print(INSU.LOAN.PTDADD1)
	INSU.LOAN.PTDFEE3 = CDOUBLE(INSU.LOAN.PTDADD1) + CDOUBLE(INSU.LOAN.PTDFEE2)
	print(INSU.LOAN.PTDFEE3)
	
	INSU.LOAN.TTLFEE=CDOUBLE(INSU.LOAN.GLFEE2) + CDOUBLE(INSU.LOAN.PTDFEE3)
	print(INSU.LOAN.TTLFEE)
	
	IF (FIELDEXISTS(INSU.LOAN.Pattrns)) THEN
	#{
		print("YAA")
		IF (INSU.LOAN.Pattrns > 1) THEN
		#{
			print("YAA")
			INSU.LOAN.discount=INSU.LOAN.pDisCnt
			INSU.LOAN.TTLFEE= CDOUBLE(INSU.LOAN.TTLFEE)*CDOUBLE(INSU.LOAN.Pattrns)*CDOUBLE(INSU.LOAN.discount)
			print(INSU.LOAN.TTLFEE)
		#}
		ENDIF
	#}
	ENDIF
	
	
	
	IF (INSU.LOAN.company=="Y") THEN
	#{
		INSU.LOAN.TTLFEE = 0
	#}
	ENDIF
	
	IF (CINT(INSU.LOAN.period) > CINT(INSU.LOAN.pPeriod) ) THEN
	#{
		INSU.LOAN.TTLFEE = 0
	#}
	ENDIF
	
	sv_m = GETPOSITION(INSU.LOAN.schmCodeLst2,"|"+INSU.LOAN.schmcode+"|")
	print(sv_m)
	IF (sv_m>0) THEN
	#{
		INSU.LOAN.TTLFEE = 0
	#}
	ENDIF
	
	#-------------------------------------------
	#Modification Done here
	#Customer is not a Company
	#--------------------------------------------
	sv_s = "cntAcctHld| "
	sv_s = sv_s + " SELECT count(*) "
	sv_s = sv_s + " FROM TBAADM.AAS"
	sv_s = sv_s + " WHERE acid in ("
	sv_s = sv_s + 		" SELECT acid "
	sv_s = sv_s +           " FROM TBAADM.GAM "
	sv_s = sv_s +           " WHERE foracid = ?SVAR "
	sv_s = sv_s +           " AND GAM.entity_cre_flg = 'Y' "
	sv_s = sv_s +           " AND GAM.del_flg = 'N' "
	sv_s = sv_s +           " AND GAM.bank_id = ?SVAR ) "
	sv_s = sv_s + " AND acct_poa_as_rec_type in ('M','J')"
	sv_s = sv_s + " AND bank_id = ?SVAR "
	print(sv_s)
	BANCS.INPARAM.BINDVARS = INSU.LOAN.Foracid +"|"+ BANCS.STDIN.contextBankId +"|"+ BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF (sv_d==0) THEN
	#{
		INSU.LOAN.cntAcctHld = BANCS.OUTPARAM.cntAcctHld
		print(INSU.LOAN.cntAcctHld)
	#}
	ENDIF
	
	#--------------------------------------------
	#charge ammoun * no of account holders
	#-------------------------------------------
	INSU.LOAN.TTLFEE=CDOUBLE(INSU.LOAN.TTLFEE) * CINT(INSU.LOAN.cntAcctHld)
	
	print(INSU.LOAN.TTLFEE)
	BANCS.OUTPUT.collAmount = INSU.LOAN.TTLFEE
	BANCS.OUTPUT.AmountWithNoDiscount	= CDOUBLE(INSU.LOAN.TTLFEE)
	print(BANCS.INPUT.inputCrncy)
	BANCS.OUTPUT.collCrncy = BANCS.STDIN.homeCrncyCode
	
	ENDOFSCRIPT :
		IF ( INSU.LOAN.errMsg != "" ) THEN
		#{
			sv_u = system("echo '"+INSU.LOAN.errMsg+"' >>insurance.log")
		#}
		ENDIF
		
		#TRACE OFF
		EXITSCRIPT
END-->
