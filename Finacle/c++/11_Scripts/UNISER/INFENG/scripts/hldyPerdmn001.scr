	#*******************************************************************************************
	# Check whether CUST Repository exists else create it
	#******************************************************************************************
	
	sv_r = REPEXISTS("CUST")
	
	IF(sv_r == 0) THEN
	#{
		CREATEREP ("CUST")
	#}
	ENDIF
	
	#******************************************************************************************
	# Check whether CPARAM Class exists else create it
	#******************************************************************************************
	
	sv_r = CLASSEXISTS("CUST","HLDY")
	
	IF(sv_r == 0) THEN
	#{
		CREATECLASS ("CUST","HLDY",5)
	#}
	ENDIF
	
	#sv_u = urhk_B2k_PrintRepos("BANCS")
	#----------------------------------------------------------
	#Assigning the input value to the custom repository variables
	#-----------------------------------------------------------
	CUST.HLDY.instlmntStartDate=BANCS.INPUT.instlmntStrtDate
	CUST.HLDY.boDate=MID$(BANCS.STDIN.BODDate,0,10)
	PRINT(BANCS.INPUT.schmCode)
	CUST.HLDY.schmCode=TOUPPER(BANCS.INPUT.schmCode)
	PRINT(CUST.HLDY.schmCode)
	#----------------------------------------------------------
	#fetching the expiry date defined through HLAGSPM
	#-----------------------------------------------------------
	BANCS.INPARAM.BINDVARS=CUST.HLDY.schmCode + "|" + BANCS.STDIN.contextBankId +"|"+"N"
	sv_s = "expiryDate| SELECT END_DATE FROM TBAADM.GSP "
	sv_s = sv_s + "  WHERE SCHM_CODE=?SVAR   "
	sv_s = sv_s + "   AND BANK_ID=?SVAR  "
	sv_s = sv_s + "   AND DEL_FLG=?SVAR "
	PRINT(sv_s)
	sv_d= urhk_dbSelectWithBind(sv_s)
	PRINT(sv_d)
	IF(sv_d ==0) THEN
	#{
		BANCS.INPARAM.BINDVARS =BANCS.OUTPARAM.expiryDate
		sv_s = "date|SELECT to_char(to_date( '?SVAR' ,'dd-mm-yy'),'dd-mm-yyyy')"
		sv_s = sv_s + "FROM dual "
		PRINT(sv_s)
		sv_d= urhk_dbSelectWithBind(sv_s)
		PRINT(sv_d)
		IF(sv_d ==0) THEN
		#{
			
			CUST.HLDY.expiryDate=BANCS.OUTPARAM.date
		#}
		ENDIF
		#}
		
	#}
	ENDIF
	#-----------------------------------------------------------------------------------------------
	#Comparing and handling condition when the installment start date is greater than the expiry date
	#------------------------------------------------------------------------------------------------
	BANCS.INPARAM.date1=CUST.HLDY.instlmntStartDate
	BANCS.INPARAM.date2=CUST.HLDY.expiryDate
	PRINT(BANCS.INPARAM.date2)
	PRINT(BANCS.INPARAM.date1)
	sv_u = urhk_B2k_dateDiff("")
	PRINT(sv_u)
	sv_v = BANCS.OUTPARAM.dateDiff
	PRINT(sv_v)
	
	IF (sv_v > 0) THEN
	#{
		CUST.HLDY.hldyPerdMths = "1"
		sv_u = urhk_SetOrbOut("hldyPerdMths|"+ CUST.HLDY.hldyPerdMths)
		
		
	#}
	ENDIF
	
	
	
	#-----------------------------------------------------------------------------------------
	#Getting the Number of months for holiday period Using the Userhook urhk_B2k_getMonthDayDiff
	#---------------------------------------------------------------------------------------------
	
	sv_a = (CUST.HLDY.boDate + "|" +  CUST.HLDY.instlmntStartDate + "|" + "NO")
	
	sv_u = urhk_B2k_getMonthDayDiff(sv_a)
	
	IF ( sv_u == 1) THEN
	#{
		PRINT(BANCS.OUTPARAM.errorMesg)
		#}
	ELSE
		#{
		PRINT(  BANCS.OUTPARAM.NumOfMonths )
		
		CUST.HLDY.hldyPerdMths=BANCS.OUTPARAM.NumOfMonths
		#-----------------------------------------------------------------
		#Passing the value to the front end
		#----------------------------------------------------------------------
		sv_u = urhk_SetOrbOut("hldyPerdMths|"+ CUST.HLDY.hldyPerdMths)
	#}
	ENDIF
	
	
	ENDOFSCRIPT:
