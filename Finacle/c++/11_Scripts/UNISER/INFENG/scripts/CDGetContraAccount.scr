                                                CUST.ATM.WuAcctMatch = cint (CUST.ATM.WuAcctMatch) + 1
                                                Print(CUST.ATM.WuAcctMatch)
                                        ENDIF
                                ENDIF
                                CUST.ATM.Loop= cint (CUST.ATM.Loop) - 1
                                Print (CUST.ATM.Loop)
                        DO
                        Print(CUST.ATM.WuAcctMatch)
                        IF (cint (CUST.ATM.WuAcctMatch) > 1 ) then
                                BANCS.OUTPUT.contraAccount=BANCS.INPUT.CrForacid
