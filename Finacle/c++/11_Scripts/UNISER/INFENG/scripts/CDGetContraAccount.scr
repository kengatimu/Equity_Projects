                        Print (CUST.ATM.WuNarration)
			lv_z = "formattedNarr|select REGEXP_REPLACE(?SVAR, '\s{2,}', ' ') FROM dual "
			print(lv_z)
			BANCS.INPARAM.BINDVARS = CUST.ATM.WuNarration
			print(BANCS.INPARAM.BINDVARS)
			lv_y = urhk_dbSelectWithBind(lv_z)
			if(lv_y ==0) then
				CUST.ATM.WuNarration= BANCS.OUTPARAM.formattedNarr
				print(CUST.ATM.WuNarration)
			endif
                        lv_a=CUST.ATM.WuNarration
                        Print (CUST.ATM.WuCracctName)
                        CUST.ATM.Loop = "10"
                        CUST.ATM.WuAcctMatch= "0"
                        lv_b = strlen(lv_a)
			while(CUST.ATM.Loop != 0)
                                print (lv_a)
                                lv_c = getposition(lv_a," ")
                                lv_d = mid$(lv_a,0,lv_c-1)
                                print (lv_d)
                                IF (lv_d !="")  Then
                                        lv_a = mid$(lv_a,lv_c,lv_b)
                                        lv_b = strlen(lv_a)
                                        CUST.ATM.MatchYN = GETPOSITION(CUST.ATM.WuCracctName,lv_d )
                                        print (CUST.ATM.MatchYN)
