# The MTT script is used for generating Eazzy24/7 ministatement charges 
#######################################################################
<--start

#===========================================================================================*
# Name                         	:   .scr
# Date                         	:   13-nov-2008
# Description                   :   The MTT script is used for generating Eazzy24/7 ministatement charges 
# Author                       	:   Revathi Duraisamy
# Called Scripts                :    <none>
# Calling Script                :    <none>
# Reference                    	:
# Modification History  :
#  <Serial No.>  <Date>         <AuthorName>          	<Description>
#--------------------------------------------------------------------------
# 	1			13-11-2008		ERIC KAROBIA 			Original version
# 	1       	12-02-2013    	Chethan.S  				Modified according to 10x standards.
#============================================================================================*


TRACE ON

#-----------------------------------------------------------------
# Initialise is used to Check whether Class ATM exists.
# If not then creates that class.
# 5 stands for String Type data.
#-----------------------------------------------------------------
Initialise:
#{
	sv_r = REPEXISTS("CUST")
	IF (sv_r == 0) THEN
		CREATEREP("CUST")
	ENDIF

	sv_r = CLASSEXISTS("CUST", "ATM")
	IF (sv_r == 0) THEN
		CREATECLASS("CUST", "ATM", 5)
	ENDIF
#{
#------------------------------------------------------------------
#  Getting account to debit
# 
#------------------------------------------------------------------
print(BANCS.OUTPUT.CrForacid)
print(BANCS.OUTPUT.Foracid)
CUST.ATM.crAccount=BANCS.OUTPUT.CrForacid
CUST.ATM.drAccount=BANCS.OUTPUT.Foracid
CUST.ATM.DccId=BANCS.OUTPUT.DccId
CUST.ATM.narr1="MINISTATEMENT-CHARGE"

#GOTO ENDOFSCRIPT

#IF ((BANCS.INPUT.DeviceId != "EBR00201") AND (BANCS.INPUT.DeviceId != "EBR00202")) THEN
#	CUST.ATM.Amount = "0"
#	GOTO ENDOFSCRIPT
#ELSE
#	print("OKAY CHARGES")
#ENDIF

#IF ((BANCS.INPUT.DeviceId != "EBR00201") AND (BANCS.INPUT.DeviceId != "EBR00202")) THEN
#	CUST.ATM.Amount = "0"
#	GOTO ENDOFSCRIPT
#ELSE
#	print("OKAY CHARGES")
#ENDIF


IF ((BANCS.STDIN.contextBankId =="XXXXXX") OR (BANCS.STDIN.contextBankId =="11")) THEN
	IF (CUST.ATM.DccId=="WPD") THEN
		IF (BANCS.OUTPUT.CrForacid == "")  THEN
			BANCS.INPUT.moduleName  = "ATM"
			BANCS.INPUT.parameterId = "BACID_8"
			CALL ("atmgetcparamvalue.scr")
			IF(BANCS.OUTPUT.parameterVal != "")THEN
			#{
				CUST.ATM.bacid8 = BANCS.OUTPUT.parameterVal
				print(CUST.ATM.bacid8)
			#}
			ELSE
			#{
				CUST.ATM.errMsg = "bacid setup not done CPARAM"
				GOTO ENDOFSCRIPT
			#}
			ENDIF
			
			sv_u = urhk_getAcctDetailsInRepository(CUST.ATM.drAccount)
			print(sv_u)
			IF (sv_u != 0) THEN
				BANCS.OUTPUT.RespCode = "99"
				BANCS.OUTPUT.successOrFailure = "F"
				GOTO ENDOFSCRIPT
			ELSE
				CUST.ATM.solid = BANCS.OUTPARAM.acctSolId
				print(CUST.ATM.solid)
				CUST.ATM.schmcodesh = BANCS.OUTPARAM.schmCode
				print(CUST.ATM.schmcodesh)
				CUST.ATM.schmType = BANCS.OUTPARAM.schmType
				print(CUST.ATM.schmType)
				CUST.ATM.acctCrncyCodecr = BANCS.OUTPARAM.acctCrncyCode
				print(CUST.ATM.acctCrncyCodecr)
				CUST.ATM.clearBalance = BANCS.OUTPARAM.clearBalance
				print(CUST.ATM.clearBalance)
				CUST.ATM.EffAvailableAmttr = BANCS.OUTPARAM.EffAvailableAmt
				print(CUST.ATM.EffAvailableAmttr)
				CUST.ATM.lienAmt = BANCS.OUTPARAM.lienAmt
				print(CUST.ATM.lienAmt)
			
				###

			ENDIF
			CUST.ATM.bacid8="AGENTBALCOMM"
			print(CUST.ATM.bacid8)
			
			sv_r = urhk_B2k_PrintRepos("BANCS")
			print(sv_r)
			print(BANCS.STDIN.contextBankId)
			print(BANCS.STDIN.homeCrncyCode)
			sv_s = "contra "
			sv_s = sv_s + " | "
			sv_s = sv_s + " SELECT foracid "
			sv_s = sv_s + " FROM GAM "
			sv_s = sv_s + " WHERE sol_id = ?SVAR "
			sv_s = sv_s + " AND bacid = ?SVAR "
			sv_s = sv_s + " AND del_flg ='N' "
			sv_s = sv_s + " AND GAM.bank_id = ?SVAR "
			sv_s = sv_s + " AND ACCT_CRNCY_CODE = ?SVAR "
			BANCS.INPARAM.BINDVARS = CUST.ATM.solid + "|" + CUST.ATM.bacid8 + "|" + BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.homeCrncyCode
			print(sv_s)
			sv_d =urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			IF (sv_d == "0") THEN
				BANCS.OUTPUT.CrForacid = BANCS.OUTPARAM.contra
				print(BANCS.OUTPUT.CrForacid)
				CUST.ATM.crAccount = BANCS.OUTPUT.CrForacid
				print(CUST.ATM.crAccount)
				IF (BANCS.INPUT.StlmntFee!="") THEN
					sv_a=BANCS.INPUT.StlmntFee
					print(sv_a)
					sv_a = MID$(sv_a,12,16)
					print(sv_a)
					BANCS.INPUT.TranAmt =sv_a
					print(BANCS.INPUT.TranAmt)
					IF (CINT(BANCS.INPUT.TranAmt) > 0) THEN
					 	if (CINT(CUST.ATM.EffAvailableAmttr) < 5) then 
							print(" NOT PERMITED ")
							CUST.ATM.RespCode99 = "99"
							CUST.ATM.successOrFailuresf = "F"
							exitscript
						endif
					ENDIF
				ENDIF
			ELSE
				BANCS.OUTPUT.RespCode = "99"
				BANCS.OUTPUT.successOrFailure = "F"
				GOTO ENDOFSCRIPT
			ENDIF
		ENDIF
	ENDIF
ENDIF


IF (BANCS.OUTPUT.CrForacid == "") THEN
	CUST.ATM.Amount = "0"   		
	GOTO ENDOFSCRIPT
ELSE

print(BANCS.INPUT.Command)

IF (BANCS.INPUT.Command == "") THEN
	CUST.ATM.Amount = "0"   		
	GOTO ENDOFSCRIPT
ELSE

	CUST.ATM.cmd=BANCS.INPUT.Command 
	
ENDIF

BANCS.INPUT.moduleName = "ATM"
BANCS.INPUT.parameterId = "EVENT_ID"
CALL ("atmgetcparamvalue.scr")
print(BANCS.OUTPUT.parameterVal)

IF(BANCS.OUTPUT.parameterVal != "")THEN
#{
        CUST.ATM.eventId= BANCS.OUTPUT.parameterVal
#}
ELSE
#{
        CUST.ATM.errMsg = "eventid setup not done in CPARAM"
        GOTO ENDOFSCRIPT
#}
ENDIF

BANCS.INPUT.parameterId = "EVENT_TYPE_1"
CALL ("atmgetcparamvalue.scr")
print(BANCS.OUTPUT.parameterVal)

IF(BANCS.OUTPUT.parameterVal != "")THEN
#{
        CUST.ATM.eventType = BANCS.OUTPUT.parameterVal
#}
ELSE
#{
        CUST.ATM.errMsg = "eventid setup not done in CPARAM"
        GOTO ENDOFSCRIPT
#}
ENDIF


#--------------------------------------------------------------------------
# getting the amount to split
#--------------------------------------------------------------------------
BANCS.INPUT.TranAmt=cdouble(BANCS.INPUT.TranAmt)/cdouble("100")
print(BANCS.INPUT.TranAmt)
PRINT(BANCS.INPUT.SerialNum)

IF (BANCS.INPUT.TranAmt == "0") THEN
	CUST.ATM.Amount = "0"   		
	GOTO ENDOFSCRIPT
ELSE
	CUST.ATM.Amount=BANCS.INPUT.TranAmt
	#--------------------------------------------------------------------------
	# Create the narration
	#--------------------------------------------------------------------------
	sv_e = MID$(BANCS.STDIN.BODDate,0,10)
	print(sv_e)
	sv_s = "sysdate "
	sv_s = sv_s + " | "
	sv_s = sv_s + " SELECT TO_CHAR((TO_DATE(?SVAR,'DD-MM-YYYY')),'DD-MM-YYYY') "
	sv_s = sv_s + " FROM DUAL"
	BANCS.INPARAM.BINDVARS = sv_e
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF (sv_d =="0") THEN
		CUST.ATM.sysdate = BANCS.OUTPARAM.sysdate
		IF (CUST.ATM.DccId=="SMS") THEN 
			CUST.ATM.narr1 ="M-KESHO MINISTATEMENT CHARGE" + "/" + BANCS.INPUT.SerialNum + "/" + CUST.ATM.sysdate
		ENDIF
		IF (CUST.ATM.DccId=="EAZ") THEN 
			CUST.ATM.narr1 ="EAZZY-MINISTATEMENT-CHARGE" + "/" + BANCS.INPUT.SerialNum + "/" + CUST.ATM.sysdate
		ENDIF
		IF (CUST.ATM.DccId=="OMK") THEN 
			CUST.ATM.narr1 ="ORANGEM-MINISTATEMENT-CHARGE" + "/" + BANCS.INPUT.SerialNum + "/" + CUST.ATM.sysdate
		ENDIF

		IF (CUST.ATM.DccId=="WYM") THEN 
			IF (BANCS.INPUT.Command == "MSIR") THEN
				CUST.ATM.narr1 ="WAYMB-MINISTATEMENT-CHARGE" + "/" + BANCS.INPUT.SerialNum + "/" + CUST.ATM.sysdate
			ENDIF
			IF (BANCS.INPUT.Command == "BLIR") THEN
				CUST.ATM.narr1 ="WAYMB-BAL_INQ-CHARGE" + "/" + BANCS.INPUT.SerialNum + "/" + CUST.ATM.sysdate
			ENDIF
		ENDIF
		IF (CUST.ATM.DccId=="WPD") THEN 
			CUST.ATM.serialm= LTRIM(BANCS.INPUT.ReservedField3,'0') 
			print(CUST.ATM.serialm)
			IF (BANCS.INPUT.Command == "MSIR") THEN
				CUST.ATM.narr1 ="ATM-MINISTATEMENT-CHARGE" + "/" + CUST.ATM.serialm + "/" + CUST.ATM.sysdate
			ENDIF
			IF (BANCS.INPUT.Command == "BLIR") THEN
				CUST.ATM.narr1 ="ATM-BAL_INQ-CHARGE" + "/" + CUST.ATM.serialm + "/" + CUST.ATM.sysdate
			ENDIF
		ENDIF
	ELSE
	 GOTO ENDOFSCRIPT
	ENDIF
	#--------------------------------------------------------------------------
	# Initialise the MTT repository
	#--------------------------------------------------------------------------

		sv_r = REPEXISTS("MTT")
		IF (sv_r == 0) THEN
			CREATEREP("MTT")
		ENDIF

		sv_r = CLASSEXISTS("MTT","TranDetails")
		IF (sv_r == 0) THEN
			CREATECLASS("MTT","TranDetails",5)
		ENDIF

		sv_r = CLASSEXISTS("MTT","PartTranDetails")
		IF (sv_r == 0) THEN
			CREATECLASS("MTT","PartTranDetails",5)
		ENDIF

		sv_r = REPEXISTS("BANCS")
		IF (sv_r == 0) THEN
			CREATEREP("BANCS")
		ENDIF

		sv_r = CLASSEXISTS("BANCS","INPARAM")
		IF (sv_r == 0) THEN
			CREATECLASS("BANCS","INPARAM",5)
		ENDIF

		MTT.TranDetails.TranDate="0"
		MTT.TranDetails.TranType="T"
		MTT.TranDetails.TranSubType="CI"

		BANCS.INPARAM.PostTranFlg = "Y"
		BANCS.INPARAM.InsertTranWithValidnFlg = "N"
		BANCS.INPARAM.CommitFlg="N"
		BANCS.INPARAM.RestrictModifyInd="FIRST_GROUP"
		BANCS.INPARAM.ErrorCheckForLuw="Y"
		BANCS.INPARAM.CheckExceptions="N"

		sv_u = urhk_MTTS_Initialize("")
		print(sv_u)


		sv_v = "PurchaseComm"
		print(sv_v)

		sv_u = urhk_MTTS_DefineTransaction("PurchaseComm")

		sv_u = urhk_MTTS_PopulateInputDetails("")
		
		sv_b = BANCS.INPUT.TranAmt

		#--------------------------------------------------
		# Income To EQUITY PURCHASES COMM A/C
		#--------------------------------------------------
	
			CUST.ATM.crAccountpool="2000300011578"
			print(CUST.ATM.crAccountpool)
			IF (FIELDEXISTS(BANCS.INPUT.TranCrncy)) THEN
				IF (BANCS.INPUT.TranCrncy=="USD") THEN
					CUST.ATM.crAccountpool="2000300011675"
					PRINT(CUST.ATM.crAccountpool)
				ENDIF
			ENDIF
			MTT.PartTranDetails.Account = CUST.ATM.crAccountpool
			MTT.PartTranDetails.RefCurrency = BANCS.OUTPUT.TranCrncy
			MTT.PartTranDetails.ValueDateDiff = "0"
			MTT.PartTranDetails.Particulars = CUST.ATM.narr1
			MTT.PartTranDetails.Particulars2 = BANCS.INPUT.DeviceId
			MTT.PartTranDetails.RefAmount = sv_b
			print(MTT.PartTranDetails.RefAmount)
			MTT.PartTranDetails.Remarks = CUST.ATM.serialm
			MTT.PartTranDetails.RefNum = LTRIM(BANCS.INPUT.ReservedField3,'0')
			MTT.PartTranDetails.IgnoreExcp = "I"
			MTT.PartTranDetails.Consolidate = "N"
			MTT.PartTranDetails.TranIdentifier = sv_v
			MTT.ChargeDetails.EventType = CUST.ATM.eventType
			MTT.ChargeDetails.EventId = CUST.ATM.eventId
			sv_e = "PurchaseIncome"
			sv_u = urhk_MTTS_DefineChargePartTran(sv_e)
			print(sv_u)

		#------------------------------------------------------------------
		# Debit Partran To MERCHANT PURCHASES COMM A/C
		#------------------------------------------------------------------

			MTT.PartTranDetails.Account = CUST.ATM.drAccount
			MTT.PartTranDetails.RefCurrency = BANCS.OUTPUT.TranCrncy
			MTT.PartTranDetails.ValueDateDiff = "0"
			MTT.PartTranDetails.Particulars = CUST.ATM.narr1
			MTT.PartTranDetails.Particulars2 = BANCS.INPUT.DeviceId
			MTT.PartTranDetails.RefAmount = -1 * CDOUBLE(sv_b) 
			MTT.PartTranDetails.Remarks = CUST.ATM.serialm 
			MTT.PartTranDetails.RefNum = LTRIM(BANCS.INPUT.ReservedField3,'0')
			MTT.PartTranDetails.IgnoreExcp = "I"
			MTT.PartTranDetails.Consolidate = "N"
			MTT.PartTranDetails.TranIdentifier = sv_v
			sv_h = "D" + CUST.ATM.drAccount
			sv_u = urhk_MTTS_definePartTran(sv_h)
			sv_u = urhk_MTTS_EndDefinition("")
			print(sv_u)

			########
			########

			CUST.ATM.splitAmount = CDOUBLE(sv_b) * CDOUBLE("0.5")
			print(CUST.ATM.splitAmount)
			
			#--------------------------------------------------
			# Income To EQUITY PURCHASES COMM A/C
			#--------------------------------------------------

				MTT.PartTranDetails.Account = CUST.ATM.crAccount
				MTT.PartTranDetails.RefCurrency = BANCS.OUTPUT.TranCrncy
				MTT.PartTranDetails.ValueDateDiff = "0"
				MTT.PartTranDetails.Particulars = CUST.ATM.narr1
				MTT.PartTranDetails.Particulars2 = BANCS.INPUT.DeviceId
				MTT.PartTranDetails.RefAmount = CUST.ATM.splitAmount
				print(MTT.PartTranDetails.RefAmount)
				MTT.PartTranDetails.Remarks = CUST.ATM.serialm
				MTT.PartTranDetails.RefNum = LTRIM(BANCS.INPUT.ReservedField3,'0')
				MTT.PartTranDetails.IgnoreExcp = "I"
				MTT.PartTranDetails.Consolidate = "N"
				MTT.PartTranDetails.TranIdentifier = sv_v
				MTT.ChargeDetails.EventType = CUST.ATM.eventType
				MTT.ChargeDetails.EventId = CUST.ATM.eventId
				sv_e = "PurchaseIncome"
				sv_u = urhk_MTTS_DefineChargePartTran(sv_e)
				print(sv_u)

			#------------------------------------------------------------------
			# Debit Partran To MERCHANT PURCHASES COMM A/C 
			#------------------------------------------------------------------

				MTT.PartTranDetails.Account = CUST.ATM.crAccountpool
				MTT.PartTranDetails.RefCurrency = BANCS.OUTPUT.TranCrncy
				MTT.PartTranDetails.ValueDateDiff = "0"
				MTT.PartTranDetails.Particulars = CUST.ATM.narr1
				MTT.PartTranDetails.Particulars2 = BANCS.INPUT.DeviceId
				MTT.PartTranDetails.RefAmount = -1 * CDOUBLE(CUST.ATM.splitAmount)
				MTT.PartTranDetails.Remarks = CUST.ATM.serialm 
				MTT.PartTranDetails.RefNum = LTRIM(BANCS.INPUT.ReservedField3,'0')
				MTT.PartTranDetails.IgnoreExcp = "I"
				MTT.PartTranDetails.Consolidate = "N"
				MTT.PartTranDetails.TranIdentifier = sv_v
				sv_h = "D" + CUST.ATM.drAccount
				sv_u = urhk_MTTS_definePartTran(sv_h)
				sv_u = urhk_MTTS_EndDefinition("")
				print(sv_u)


			########
			########



			sv_u = urhk_MTTS_Close("")
		        print(sv_u)

			print(BANCS.OUTPARAM.MTTTranId)
ENDIF
ENDOFSCRIPT:

exitscript
TRACE OFF
END-->
