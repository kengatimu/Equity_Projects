# Template Name :		daily_dr35.mrt
# Description	:		Customer Arrears Report
# Author			E.G.KAROBIA, 09/09/05
# 
#########################################################################
RECORDLAYOUT
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
####################################################################
$$$include daily_dr35.mri
LOCALVARIABLES
###########################################################################
#
###########################################################################
page_number             numberType
record_counter          numberType
date			stringType
lv_setid	stringType  
callscript      stringType
lv_setdesc	stringType
lv_userId	stringType 
tot_acct_name_cntr      numberType
tot_advnd_amt           numberType
tot_instl_amt           numberType
tot_pric_amt            numberType
tot_int_amt             numberType
tot_arrears             numberType
tot_upto30		numberType
tot_upto60		numberType
tot_upto90		numberType
tot_upto120		numberType
tot_upto150		numberType
tot_upto210		numberType
tot_upto270		numberType
tot_upto360		numberType
tot_over360		numberType
tot_upto180   		numberType
tot_penal_int		numberType
grnd_acct_name_cntr     numberType
grnd_advnd_amt           numberType
grnd_instl_amt           numberType
grnd_pric_amt            numberType
grnd_int_amt             numberType
grnd_arrears             numberType
grnd_upto30		numberType
grnd_upto60		numberType
grnd_upto90		numberType
grnd_upto120		numberType
grnd_upto150		numberType
grnd_upto180            numberType
grnd_upto210		numberType
grnd_upto270		numberType
grnd_upto360		numberType
grnd_over360		numberType
grnd_penal_int		numberType
#
GROUPANDSORT
schm_code ascending

PAGEFORMAT
#
linesperpage 60
columnsperline 184 
pageheaderlines 12
topMargin  2
bottomMargin 2
#
REPOSITORY bankRepos.rip
bankName	    stringType
branchName	    stringType

REPOSITORY  argv4
ipSetId				stringType
ipFrmDate			stringType
#
#
ONSTARTOFREPORT
#
set page_number=1
set record_counter=0
execute header
execute printScheduleHeader
#
PAGEHEADER
	set page_number=page_number+1
	nextline
	execute header
	execute printScheduleHeader
#
IGNORERECORD
if total_arreas = 0 
#
ONENDOFREPORT
if (record_counter != 0)
begin
	execute printGrandTotals
end
else
begin
	execute printRecordNotExist
end
nextline
nextline
set lv_setid = ipsetId
set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
print "       Printed By:  " column 20
Print lv_userId
print "   " 
print today  
nextline
print "       Authorised Signatory (BRANCH)" column 20	
print "       Authorised Signatory"  column 77
nextline
nextline
nextline
print "       Signature" column 77
nextline
nextline
print "********************End Of Report*********************" column 70

BEFOREBREAKOF schm_code
    print "Product : " 
    print " "
    print schm_code     
    nextline
    nextline
#
AFTERBREAKOF schm_code
if (record_counter != 0)
begin
 execute printSubTotals
end
nextline
ONEVERYRECORD
begin
	set record_counter=record_counter+1
	set tot_acct_name_cntr=groupcount acct_name
	set tot_advnd_amt=groupsum adv_amt
	set tot_instl_amt=groupsum installment_amt          
	set tot_pric_amt=groupsum principal           
	set tot_int_amt=groupsum interest            
	set tot_arrears=groupsum total_arreas           
	set tot_upto30=groupsum upto30		
	set tot_upto60=groupsum upto60		
	set tot_upto90=groupsum upto90		
	set tot_upto120=groupsum upto120			
	set tot_upto150=groupsum upto150		
	set tot_upto210=groupsum upto210		
	set tot_upto270=groupsum upto270
	set tot_upto360=groupsum upto360		
	set tot_over360=groupsum over360		
	set tot_upto180=groupsum upto180
	set tot_penal_int=groupsum penal_int
	execute printScheduleData
	nextline
end
#

##############################################################################
PROCEDURE printScheduleData
##############################################################################
begin
        print acc_number     column 2 
	execute pipe
	print acct_name          column 19  
	execute pipe
	print principal  column 47 format "#,###,###,###.##"
	execute pipe
	print adv_amt  column 64 format "#,###,###,###.##"
	execute pipe
	print total_arreas   column 81 format "#,###,###,###.##"
	execute pipe
	print upto30  column 98  format "#,###,###,###.##"  
	execute pipe
	print upto90  column 115 format "#,###,###,###.##"
	execute pipe
	print upto150 column 132 format "#,###,###,###.##"
	execute pipe
	print upto210 column 149 format "#,###,###,###.##"
	execute pipe
	print upto360 column 166 format "#,###,###,###.##"
	execute pipe
	nextline
	execute pipe
	print overdue_days   column 4 
	execute pipe
	print disburse_date  column  23 
	execute pipe
	print installment_amt  column 47 format "#,###,###,###.##"
	execute pipe
	print interest   column 64 format "#,###,###,###.##"
	execute pipe
	print penal_int column 81 format "#,###,###,###.##"
	execute pipe
	print upto60   column 98 format "#,###,###,###.##"
	execute pipe
	print upto120  column 115 format "#,###,###,###.##"
	execute pipe
	print upto180  column 132 format "#,###,###,###.##"
	execute pipe
	print upto270  column 149 format "#,###,###,###.##"
	execute pipe
	print over360  column 166 format "#,###,###,###.##"
	execute pipe
	nextline
end
#
##############################################################################
PROCEDURE printScheduleHeader
##############################################################################
begin
	separatorline
	print "A/c # "     column 5
	execute pipe
	print "  A/c Name "   column 18
	execute pipe
	print "  Princpal"    column 50 
	execute pipe
	print "  Amt advanced" column 67 
	execute pipe
	Print "  Tot.Arrears "  column 85
	execute pipe
	print "  1-30"    column 105 
	execute pipe
	print "  61-90"   column 120
	execute pipe
	print "  121-150" column 138
	execute pipe
	print "  181-210" column 157
	execute pipe
	print "  271-360"  column 174
	execute pipe
	nextline
	execute pipe
	print "Days in Arr."  column 3 
	execute pipe
	print "Dis.Date"   column 21 
	execute pipe
	print "Instl.Amnt " column 50
	execute pipe
	print "Interest"  column 70 
	execute pipe
	print "Penal Int." column 86 
	execute pipe
	print "31-60"   column 109 
	execute pipe
	print "91-120"  column 121
	execute pipe
	print "151-180" column 136
	execute pipe
	print "211-270" column 155
	execute pipe
	print "Over 360" column 172
	execute pipe
	separatorline
	
end 

PROCEDURE printGrandTotals
##############################################################################
begin
separatorline
	execute pipe
        print "Grand Total" column 3
	execute pipe
	set grnd_acct_name_cntr=totalcount acct_name
        set grnd_advnd_amt=totalsum adv_amt
        set grnd_instl_amt=totalsum installment_amt
        set grnd_pric_amt=totalsum principal
        set grnd_int_amt=totalsum interest
        set grnd_arrears=totalsum total_arreas
        set grnd_upto30=totalsum upto30
        set grnd_upto60=totalsum upto60
        set grnd_upto90=totalsum upto90
        set grnd_upto120=totalsum upto120
        set grnd_upto150=totalsum upto150
        set grnd_upto180=totalsum upto180
        set grnd_upto210=totalsum upto210
        set grnd_upto270=totalsum upto270
        set grnd_upto360=totalsum upto360
        set grnd_over360=totalsum over360
	set grnd_penal_int=totalsum penal_int
	execute pipe
	print grnd_acct_name_cntr column 19
	execute pipe
        print grnd_pric_amt  column  49 format "#,###,###,###.##"
	execute pipe
	print grnd_advnd_amt column 66 format "#,###,###,###.##"
	execute pipe
	print grnd_arrears  column 83 format "#,###,###,###.##"
	execute pipe
	print grnd_upto30  column 100 format "#,###,###,###.##"
	execute pipe
	print grnd_upto90  column 117 format "#,###,###,###.##"
        execute pipe
	print grnd_upto150  column 134 format "#,###,###,###.##"
	execute pipe
	print grnd_upto210  column 151 format "#,###,###,###.##"
	execute pipe
	print grnd_upto360  column 168 format "#,###,###,###.##"
	execute pipe
	nextline
	execute pipe
        print grnd_instl_amt  column 49 format "#,###,###,###.##"
	execute pipe
	print grnd_int_amt column 66 format "#,###,###,###.##"	
	execute pipe
	print grnd_penal_int column 83 format "#,###,###,###.##"
	execute pipe
        print grnd_upto60   column 100 format "#,###,###,###.##"
	execute pipe
        print grnd_upto120  column 117 format "#,###,###,###.##"
        execute pipe
        print grnd_upto180  column 134 format "#,###,###,###.##"
	execute pipe
        print grnd_upto270  column 151 format "#,###,###,###.##"
	execute pipe
        print grnd_over360  column 168 format "#,###,###,###.##"
	execute pipe
separatorline
end
PROCEDURE printSubTotals
##############################################################################
begin
	separatorline
	execute pipe
	print "Subtotal" column 3 
	execute pipe
	print tot_acct_name_cntr column  22 
	execute pipe
	print tot_pric_amt   column  49 format "#,###,###,###.##"
	execute pipe
	print tot_advnd_amt  column 66 format "#,###,###,###.##"
	execute pipe
        print tot_arrears  column 83 format "#,###,###,###.##"
	execute pipe
        print tot_upto30   column 100 format "#,###,###,###.##"
	execute pipe
        print tot_upto90   column 117 format "#,###,###,###.##"
	execute pipe
        print tot_upto150  column 134 format "#,###,###,###.##"
	execute pipe
        print tot_upto210  column 151 format "#,###,###,###.##"
	execute pipe
        print tot_upto360   column 168 format "#,###,###,###.##"
	execute pipe
        nextline
	execute pipe
        print tot_instl_amt column 49 format "#,###,###,###.##"
	execute pipe
	print tot_int_amt column 66 format "#,###,###,###.##"	
	execute pipe
	print tot_penal_int column 83 format "#,###,###,###.##"
	execute pipe
        print tot_upto60  column 100  format "#,###,###,###.##"
	execute pipe
        print tot_upto120  column 117 format "#,###,###,###.##"
	execute pipe
        print tot_upto180  column 134 format "#,###,###,###.##"
	execute pipe
        print tot_upto270  column 151 format "#,###,###,###.##"
	execute pipe
        print tot_over360  column 168 format "#,###,###,###.##"
	execute pipe
	separatorline
	nextline
end
#############################################################################

PROCEDURE header
#############################################################################
begin 
	set date = substr today 1,10
	print bankName     column 70
	nextline
	print branchName column 66
	nextLine
	print "CUSTOMER ARREARS REPORT - DETAILED "  column 60
	nextline
	nextline
	print "AS AT :" column 70
	print " "
	print date
	nextline
	nextline

end
##############################################################################
PROCEDURE pipe

begin

	print "|"               column 1
	print "|"               column 17
	print "|"               column 48
	print "|"               column 65
	print "|"               column 82 
	print "|"               column 99 
	print "|"               column 116
	print "|"               column 133
	print "|"               column 150
	print "|"               column 167
	print "|"               column 184

end
##############################################################################
PROCEDURE printRecordNotExist
##############################################################################
begin
nextline
nextline
nextline
print "********** RECORDS DO NOT  EXIST **********" size 80 center column 70
nextline
nextline
nextline
separatorline
nextline
nextline
nextline
end

