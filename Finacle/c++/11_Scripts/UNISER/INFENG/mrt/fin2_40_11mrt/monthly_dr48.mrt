# Template Name :		daily_dr48.mrt
# Description	:		Advances Classification Report
# Author			E.G.KAROBIA, 27/09/05
# 
#########################################################################
RECORDLAYOUT
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
#################################################################
$$$include monthly_dr48.mri
LOCALVARIABLES
###########################################################################
#
###########################################################################
page_number             numberType
record_counter          numberType
date			stringType
lv_setid		stringType  
callscript		stringType
lv_setdesc		stringType
lv_userId		stringType 
total			numberType
tot_acct_num_cnt	numberType
tot_total_arreas	numberType
tot_ost_bal		numberType	
tot_arrearspct          numberType
tot_principal	        numberType
tot_interest	        numberType
tot_penal_interest	numberType
tot_total		numberType

grnd_acct_num_cnt       numberType
grnd_total_arreas       numberType
grnd_ost_bal            numberType
grnd_arrearspct         numberType
grnd_principal          numberType
grnd_interest		numberType
grnd_penal_interest     numberType
grnd_total		numberType


#
GROUPANDSORT
schm_code ascending

PAGEFORMAT
#
linesperpage 60
columnsperline 215
pageheaderlines 8
topMargin  2
bottomMargin 2
#
REPOSITORY bankRepos.rip
bankName	    stringType
branchName	    stringType

REPOSITORY  argv4
ipSetId				stringType
ipFrmDate			stringType
#
#
ONSTARTOFREPORT
#
set page_number=1
set record_counter=0
set total = 0
execute header
execute printScheduleHeader
#
PAGEHEADER
	set page_number=page_number+1
	nextline
	execute header
	execute printScheduleHeader
#
#IGNORERECORD
 
#
ONENDOFREPORT
if (record_counter != 0)
begin
	execute printGrandTotals
end
else
begin
	execute printRecordNotExist
end
nextline
nextline
set lv_setid = ipsetId
set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
print "       Printed By:  " column 20
Print lv_userId
print "   " 
print today  
nextline
print "       Authorised Signatory (BRANCH)" column 20	
print "       Authorised Signatory"  column 77
nextline
nextline
nextline
print "       Signature" column 77
nextline
nextline
print "********************End Of Report*********************" column 70

BEFOREBREAKOF schm_code
    print "Product : " 
    print " "
    print schm_code     
    nextline
    nextline
#
AFTERBREAKOF schm_code
if (record_counter != 0)
begin
 execute printSubTotals
end
nextline
ONEVERYRECORD
begin
	set record_counter=record_counter+1
	execute printScheduleData
	nextline
end
#

##############################################################################
PROCEDURE printScheduleData
##############################################################################
begin
	execute pipe
        print acct_num     column 2
	set acct_name=substr acct_name 1,30
	print acct_name   column 21
	print total_arreas    column 58 format "#,###,###,###.##"
	print ovd_days   column 77
	print ost_bal	    column 83  format "#,###,###,###.##"
	print arrearspct    column 102  format "#,###,###,###.##"
	print principal   column 124  format "#,###,###,###.##"
	print interest  column 143 format "#,###,###,###.##"
	print penal_interest   column 162 format "#,###,###,###.##"
	set total = principal + interest +  penal_interest
	print total column 180  format "#,###,###,###.##"
	print classification column 201
	nextline
end
#
##############################################################################
PROCEDURE printScheduleHeader
##############################################################################
begin
        separatorline
	execute pipe
	print "A/c #    "   column 5
	print "A/c Name "   column 31
	print "Total Arrears"    column 60 
	print "Days"  column 77
	print "O/S Bal    "    column 87
	print "Arrears %"   column 105
	print "Principal"   column 126
	print "Normal Int"  column 146
	print "Penal Int"    column 163
	print "Total"     column 184
	print " Classification" column 198
	separatorline
end 

PROCEDURE printGrandTotals
##############################################################################
begin
        set grnd_acct_num_cnt = totalcount acct_num
        set grnd_total_arreas = totalsum total_arreas 
        set grnd_ost_bal = totalsum ost_bal
        set grnd_principal = totalsum principal
        set grnd_interest = totalsum interest
        set grnd_penal_interest = totalsum penal_interest
	set grnd_total = grnd_principal + grnd_interest +grnd_penal_interest 
	separatorline
        print "Grand Total" column 1
	print grnd_acct_num_cnt column 18
	print grnd_total_arreas   column 58 format "#,###,###,###.##"
	print grnd_ost_bal   column 83 format "#,###,###,###.##"
	print grnd_principal  column 124 format "#,###,###,###.##"
	print grnd_interest column 143 format "#,###,###,###.##"
	print grnd_penal_interest  column 162 format "#,###,###,###.##"
	print grnd_total column 180 format "#,###,###,###.##"
	separatorline
end
PROCEDURE printSubTotals
##############################################################################
begin
	set tot_acct_num_cnt = groupcount acct_num
	set tot_total_arreas = groupsum total_arreas
	set tot_ost_bal = groupsum ost_bal
	set tot_arrearspct = groupsum arrearspct
	set tot_principal = groupsum principal
	set tot_interest = groupsum interest
	set tot_penal_interest = groupsum penal_interest
	set tot_total = tot_principal + tot_interest + tot_penal_interest
 	separatorline
	print "Subtotal" column 1
	print tot_acct_num_cnt column 18
        print tot_total_arreas   column 58 format "#,###,###,###.##"
        print tot_ost_bal   column 83 format "#,###,###,###.##"
        print tot_principal  column 124 format "#,###,###,###.##"
        print tot_interest column 143 format "#,###,###,###.##"
        print tot_penal_interest  column 162 format "#,###,###,###.##"
        print tot_total column 180 format "#,###,###,###.##"

	nextline
        
	separatorline
	nextline
end
#############################################################################

PROCEDURE header
#############################################################################
begin 
	set date = substr today 1,10
	print bankName     column 70
	nextline
	print branchName column 70
	nextLine
	print "ADVANCES CLASSIFICATION-DETAILED "  column 64
	nextline
	nextline
	print "AS AT :" column 64
	print "   "
	print date
	nextline
	nextline

end	
##############################################################################
PROCEDURE printRecordNotExist
##############################################################################
begin
nextline
nextline
nextline
print "********** RECORDS DO NOT  EXIST **********" size 80 center column 70
nextline
nextline
nextline
separatorline
nextline
nextline
nextline
end
##############################################################################
PROCEDURE pipe
##############################################################################
begin
print "|"    column 1
print "|"    column 20
print "|"    column 52
print "|"    column 75
print "|"    column 82
print "|"    column 100
print "|"    column 119
print "|"    column 141
print "|"    column 160
print "|"    column 179
print "|"    column 197
print "|"    column 215
end


