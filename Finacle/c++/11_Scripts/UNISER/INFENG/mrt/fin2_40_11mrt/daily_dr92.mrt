# ******************************************************************
#    Report Name		: BRANCH PERFOMANCE REPORT
#    Author     		: Erick G. Karobia 
#
# ******************************************************************
#
RECORDLAYOUT  
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
#	
####################################################################
BRANCH_ID stringtype
CURRENTDEPOSITS numbertype
SAVINGSDEPOSITS numbertype
TERMDEPOSITS numbertype
SAVINGSOVD numbertype
TERMOVD numbertype
CURRENTACCOUNTS numbertype
SAVINGSACCOUNTS numbertype
TERMACCOUNTS numbertype
NOSAVINGSOVDACCOUNTS numbertype
NOTERMOVDACCOUNTS numbertype
LOANS numbertype
CURRNTOVD numbertype
LOANACCOUNTS numbertype
OVDACCOUNTS numbertype

####################################################################
LOCALVARIABLES
####################################################################
#   MANDATORY SECTION (2nd Section)
#   Any Local Variable can be defined here
####################################################################
page_number         numberType
lv_setid	    stringType  
callscript          stringType
lv_setdesc	    stringType
lv_userId	    stringType 
col_1		    numberType	
col_2		    numberType	
col_3		    numberType	
col_4		    numberType	
col_5		    numberType	
col_6		    numberType	
col_7		    numberType	
col_8		    numberType	
col_9		    numberType	
col_10		    numberType	
col_11		    numberType	
col_12		    numberType	
col_13		    numberType	
col_14		    numberType	
col_15		    numberType
cnter		    numberType	
####################################################################
GROUPANDSORT BRANCH_ID
####################################################################
#   MANDATORY SECTION (3rd Section)
#   This section tell how the input file is to be sorted
#   This has to be Third Section in the template file
#   This can be NULL If the input file is alread sorted
#   Should contain only field names and the order in which they
#   to be sorted. All these fields should have been defined in 
#   RECORDLAYOUT section.
####################################################################
REPOSITORY bankRepos.rip readonly
 bankName		stringType
 branchName		stringType
###################################################################
REPOSITORY argv4
ipSetId				stringType
ipdate				stringtype
####################################################################
IGNORERECORd
####################################################################
#
####################################################################

PAGEFORMAT
####################################################################
#   This section tell about the page Layout
#   Here the valid pageformat keywords are 
#   Linesperpage, Leftmargin, Rightmargin, Topmargin, Columnsperpage
####################################################################
widowOrphanLines   3
linesPerPage       70
leftMargin 	   2 
rightMargin	   2
topMargin	   6
bottomMargin	   2
columnsPerLine 	   160
pageHeaderLines	   8 
pageFooterLines	   2 
    
ONSTARTOFREPORT
####################################################################
#   This section will be executed only once during the processing of 
#		report. i.e. in the begining of the report
#   Here the valid statements are actions.
####################################################################
execute brBankHdg
execute pageHdr
set pagenumber=1

PAGEHEADER 
####################################################################
#   This section is called for and the actions which are
#   specified here are done as a part of header. The number
#   of lines printed in the header cannot exceed the value
#   pageHeaderLines specified in PageFormat Section
#   Here the valid statements are actions.
####################################################################
execute pageHdr

PAGEFOOTER
####################################################################
#   This section is called for and the actions which are
#   specified here are done as a part of footer. The number
#   of lines prnted in the header cannot exceed the value
#   pageFooterLines specified in PageFormat Section
#   Here the valid statements are actions.
####################################################################
#
###################################################################
#BEFOREBREAKOF  
####################################################################
#
#
#
###################################################################
#
#afterbreakof 
####################################################################

ONEVERYRECORD 
####################################################################
#   Here the valid statements are actions.
####################################################################
execute printOneRecord

ONENDOFREPORT
####################################################################
#   This section will be executed only once during the processing of 
#		report. i.e. in the end of the report
#   Here the valid statements are actions.
####################################################################
nextline
set cnter=totalcount branch_id
set col_1 = totalcount BRANCH_ID 		    	 
set col_2 = totalsum CURRENTDEPOSITS		    	
set col_3 = totalsum SAVINGSDEPOSITS		    	
set col_4 = totalsum TERMDEPOSITS		    	
set col_5 = totalsum SAVINGSOVD		    	
set col_6 = totalsum TERMOVD		    	
set col_7 = totalsum CURRENTACCOUNTS		    	
set col_8 = totalsum SAVINGSACCOUNTS		    	
set col_9 = totalsum TERMACCOUNTS		    	
set col_10 = totalsum NOSAVINGSOVDACCOUNTS		    	
set col_11 = totalsum NOTERMOVDACCOUNTS		    	
set col_12 = totalsum LOANS		    	
set col_13 = totalsum CURRNTOVD		    	
set col_14 = totalsum LOANACCOUNTS		    	
set col_15 = totalsum OVDACCOUNTS	    
if cnter = 0
begin
 print "********************   No Records Printed   ****************" size  115 center
 nextline
 nextline
 nextline
end
separatorline
print	"Totals"	column 1
print	col_8		column 15  
print	col_10		column 35
print	col_7		column 55
print	col_15		column 75
print	col_9		column 95
print	col_11		column 115
print	col_14		column 135
nextline
print col_3		size 20 autocomma precision 2  column 10
print col_5		size 20 autocomma precision 2  column 30
print col_2		size 20 autocomma precision 2  column 50
print col_13		size 20 autocomma precision 2  column 70
print col_4		size 20 autocomma precision 2  column 90
print col_6		size 20 autocomma precision 2  column 110
print col_12		size 20 autocomma precision 2  column 130
separatorline
print "Printed By:" column 1
print lv_userId column 20
nextline
nextline
print "Verified By:"
nextline
######################################################################
#  Procedure Block
######################################################################

PROCEDURE pageHdr
separatorline
print  " #A/CS  "   column 1
nextline
print " SOL ID "   column 1
print "SAVINGS DEP. "      column 13
print "SAVINGS DEP(OD) " column 35
print "CURRENT DEP. "   column 55
print "CURRENT DEP(OD). "  column 75
print "TERM DEP."    column 95
print "TERM DEP(OD)."    column 115
print "LOAN PORT."    column 135
separatorline

####################################################################
PROCEDURE printOneRecord
####################################################################
									
print SAVINGSACCOUNTS		  column 15 
print NOSAVINGSOVDACCOUNTS	  column 35
print CURRENTACCOUNTS		  column 55
print OVDACCOUNTS		  column 75
print TERMACCOUNTS		  column 95
print NOTERMOVDACCOUNTS		  column 115
print LOANACCOUNTS		  column 135
nextline
print branch_id			column 1
print SAVINGSDEPOSITS		size 20 autocomma precision 2  column 10
print SAVINGSOVD		size 20 autocomma precision 2  column 30
print CURRENTDEPOSITS		size 20 autocomma precision 2  column 50
print CURRNTOVD			size 20 autocomma precision 2  column 70
print TERMDEPOSITS		size 20 autocomma precision 2  column 90
print TERMOVD			size 20 autocomma precision 2  column 110
print LOANS			size 20 autocomma precision 2  column 130


####################################################################
PROCEDURE brBankHdg

begin
        print "Page No. "   column 80
        print page_number precision 0
        nextline
        print today column 80
        nextline
        nextline
	print "EQUITY BANK LIMITED" size  115 center
	nextline
        set lv_setid = ipsetId
    	set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
        print lv_setdesc size 115 center
	nextline
	print "BRANCH PERFOMANCE REPORT"  size 115 center
	nextline
	print "FOR DATE:   " column 46
	print ipDate size 10
        nextline
        set page_number= page_number+1
        nextline
end
####################################################################
# End of File
######################################################################


