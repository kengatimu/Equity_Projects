#  DESC   :  This is the Mahareport for NORMAL LOANS
#               
#
######################################################################
RECORDLAYOUT
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
####################################################################
foracid		stringtype
acct_name	stringtype
dis_amt         numberType
dis_shdl_date	stringtype
EI_AMT		numberType
clr_bal_amt	numberType
schm_code  	stringtype
LOCALVARIABLES
####################################################################
# Local variables are defined here
####################################################################
totalamt           	numberType
totalintamt		numberType
totalout		numberType
GROUPANDSORT
#############################################################################
schm_code

REPOSITORY bankRepos.rip
############################################################################
bankName        stringType
branchName      stringtype

#REPOSITORY  argv4
#############################################################################
#
#   REPOSITORY (Optional Section) - Fixed-Type Repository.
#   This section tells about the Repository Information. A  Repository  is  a
#   File with Some Named Fields and Values  for those Fields. A  Repository's
#   Field Values can be used in the Template File, also a Repository's Fields
#   can be Set from the Template File. For either kind of use, the Repository
#   must be defined with its Fields description and Type. Here also the field
#   Types can be "stringType" or "numberType" Only.If a Repository is defined
#   in  ReadOnly Mode, its fields cannot be Modified or cannot be set.
#
#############################################################################
#SetId           stringType
#asondate        stringType
#***************************************************************************************
#MASSAGERECORD
############################################################################
#
#   MASSAGERECORD (Optional Section).
#   The valid statement here is  action statements, This section is  executed
#   just before IGNORERECORD Section. It does some massaging to fields and/or
#   record at record level. Some Flag can be set here also which can be  used
#   later. This Block is executed every time a new record is read.
#
#############################################################################
#
#
#IGNORERECORD
#############################################################################
#
#   IGNORERECORD (Optional Section).
#   The valid statement here is  only  conditional statements, the outcome of
#   which is a boolean value (TRUE or FALSE),If the value is TRUE (applicable
#   for input records), the record is Ignored.
#
#############################################################################

#if total_arreas > 0
#
#
PAGEFORMAT
####################################################################
#   This section tell about the page Layout
#   Here the valid pageformat keywords are
#   Linesperpage, Leftmargin, Rightmargin, Topmargin, Columnsperpage
####################################################################
widowOrphanLines 3
LinesPerPage 64
Topmargin       2
BottomMargin 2
columnsPerLine 110
pageHeaderLines 8
pageFooterLines 2
#
ONSTARTOFREPORT
####################################################################
print bankName column 45 size 45 
nextline
print branchName column 45 size 45 center
nextline
print " NORMAL CLASSIFICATION REGISTER AS AT " size 105 center
nextline
print today size 105 center
separatorline
print "|"                       column 1
print "ACCOUNT NO"              column 2 size 16
print "|"                       column 19
print "ACCOUNT NAME"            column 20 size 20
print "|"                       column 41
print "AMOUNT ADVANCED"         column 42 size 15
print "|"                       column 58
print "DATE ADVANCED"           column 59 size 12
print "|"                       column 72
print "INSTALMENT AMOUNT"       column 73 size 15
print "|"                       column 89
print "OUTSTANDING BALANCE"     column 90 size 15
print "|"                       column 106
nextline
separatorline
nextline
#
#
#PAGEHEADER
####################################################################
#pageheader on each page
####################################################################

PAGEFOOTER
####################################################################
#pagefooter on each page
####################################################################
print "Page:" column 2
print pagenumber column 10 
nextline
#
BEFOREBREAKOF schm_code 
####################################################################
nextline
print "SCHEME CODE" column 2
print schm_code column 30
nextline
separatorline
print "|"                       column 1
print "ACCOUNT NO"              column 2 size 16
print "|"                       column 19
print "ACCOUNT NAME"            column 20 size 20
print "|"                       column 41
print "AMOUNT ADVANCED"         column 42 size 15
print "|"                       column 58
print "DATE ADVANCED"           column 59 size 12
print "|"                       column 72
print "INSTALMENT AMOUNT"       column 73 size 15
print "|"                       column 89
print "OUTSTANDING BALANCE"     column 90 size 15
print "|"                       column 106
nextline
separatorline
#
#
AFTERBREAKOF schm_code
####################################################################
# After break of schm_code
####################################################################
set totalamt=groupsum dis_amt
set totalintamt=groupsum EI_AMT
set totalout=groupsum clr_bal_amt
separatorline
nextline
print "TOTAL" column 20
print totalamt column 42 format "###,###,###.##"
print totalintamt column 73 format"###,###,###.##"
print totalout column 90 format "###,###,###.##"
print "|"                       column 41
print "|"                       column 58
print "|"                       column 72
print "|"                       column 1
print "|"                       column 89
print "|"                       column 106
nextline
separatorline
nextline
#
ONEVERYRECORD
####################################################################
#on every record
####################################################################
execute pipe
print foracid	                column 2 size 16
print acct_name                 column 20 size 20
print dis_amt                   column 42 format "###,###,###.##"
print dis_shdl_date             column 59 size 12
print EI_AMT	          	column 73 format "###,###,###.##"
print clr_bal_amt               column 90 format "###,###,###.##"

nextline

#
#############################################################################
#
#   PROCEDURE BLOCK.
#   Procedure  itself is a Independent  Block  and  defined at the end of the
#   File  with the keyword PROCEDURE and <procedure-name>. Calling of a proc-
#   cedure is a action statement and can be called from any Section   in  the
#   File where action is a valid statement. Calling syntax of a  procedure is
#   execute <procedure-name>. Use of Procedures Improves  readibility of  the
#   Template File, Makes  it  Structured  and  avoids burring the same set of
#   codes at several places.
#
#############################################################################
#
#
#procedure pghdr
########################################################################
# PROCEDURE pghdr
##############################################################################
begin
end
####################################################################
PROCEDURE pipe

begin

print "|"                       column 1
print "|"                       column 19
print "|"                       column 41
print "|"                       column 58
print "|"                       column 72
print "|"                       column 89
print "|"                       column 106   
												
end
######################################################################
#***************************************************************************************
#PROCEDURE header
#***************************************************************************************
#begin
#nextline
#print " EQUITY BANK LIMITED " size 40 center
#nextline
#print branchName size 40 center
#nextline
#print "NORMAL LOANS SCHEDULES AS AT" size 40 center
#nextline
#print today size 15 center
#nextline
#end
#---------------------------------------------------------------------------------------
#**************************************************************************************

#**************************************************************************************
ONENDOFREPORT
#############################################################################
#
#   ONENDOFREPORT (Optional Section).
#   This Section  will be  executed  Only  Once  during the Processing of the
#   the Report (i.e in the  end  of the Report). Here  the  valid  statements
#   are actions only. Actions Statements Key-words are (or they begin with):-
#   NextPage, NextLine, SeparatorLine, Print, Accept, Display, Set, Begin,End
#   If, Else, execute, DontFlushAfterSection.
#
#############################################################################

set totalamt=totalsum dis_amt
set totalintamt=totalsum EI_AMT
set totalout=totalsum clr_bal_amt
separatorline
nextline
print "TOTAL" column 20
print totalamt column 42 format "###,###,###.##"
print totalintamt column 73 format"###,###,###.##"
print totalout column 90 format "###,###,###.##"
print "|"                       column 41
print "|"                       column 58
print "|"                       column 72
print "|"                       column 1
print "|"                       column 89
print "|"                       column 106
nextline
separatorline
nextline
nextline
print "PRINTED BY" column 20
print "__________________________________" column 40
nextline
nextline
print "AUTHORISED BY" column 20
print "___________________________________" column 40
#######################################################################
# End of File
######################################################################

