<--START
CHECKSUM="f4c7da8df907f694e462b7562e1134a935886b00c27bc647e83401362ce4140c"
	TRACE ON
	#------------------------------
	#REPOSITORY CREATION
	#------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	#-----------------------------------------
	#CREATION OF CLASS
	#-----------------------------------------
	IF (CLASSEXISTS("CUST", "DATA") == 0) THEN
	#{
		CREATECLASS("CUST","DATA",5)
	#}
	ENDIF
	
	sv_a = "FAILURE"
	
	#----------------------------------------
	#CHECK THE EXISTENCE OF THE FIELD BANK_ID
	#----------------------------------------
	IF(FIELDEXISTS(BANCS.INPUT.BANK_ID)) THEN
	#{
		print(BANCS.INPUT.BANK_ID)
		sv_p = ""
		sv_q = ""
		sv_r = ""
		#-----------------------------------------------------------
		#FATCH THE CNTRY CODE AND CNTRY NAME FROM CNT TABLE
		#-----------------------------------------------------------
		sv_b = "CNTRY_CODE,CNTRY_NAME | select CRNCY_CODE,CRNCY_NAME"
		sv_b = sv_b + " from tbaadm.cnc where "
		sv_b = sv_b + " BANK_ID= ?SVAR"
		print(sv_b)
		BANCS.INPARAM.BINDVARS = BANCS.INPUT.BANK_ID
		sv_e = urhk_dbCursorOpenWithBind(sv_b)
		
		IF( sv_e == 0 ) THEN
		#{
			sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
			print(sv_m)
			sv_n = urhk_dbCursorFetch(sv_m)
			IF (BANCS.OUTPARAM.DB_ERRCODE == "1403") THEN
			#{
				print("Inside dberror")
				sv_r = "INVALID BANK ID"
				sv_s = "ERROR|" + sv_r
				sv_w = urhk_SetOrbOut(sv_s)
				exitscript
			#}
			ENDIF
			sv_z = 0
			CUST.DATA.number = "0"
			WHILE(sv_n == 0)
			#{
				CUST.DATA.CNTRY_CODE = BANCS.OUTPARAM.CNTRY_CODE
				CUST.DATA.CNTRY_NAME = BANCS.OUTPARAM.CNTRY_NAME
				
				IF (CUST.DATA.CNTRY_CODE != "") THEN
				#{
					sv_p = "CURRLISTStruct.<rec_" + CUST.DATA.number + ">.CRNCY_CODE" + "|"
					sv_p = sv_p + CUST.DATA.CNTRY_CODE
					print(sv_p)
					sv_u = urhk_SetOrbOut(sv_p)
					IF (sv_u == 1)THEN
					#{
						sv_r = "SYSTEM MAL FUNCTION"
						sv_r = "ERROR|" + sv_r
						sv_w = urhk_SetOrbOut(sv_r)
						exitscript
					#}
					ENDIF
				#}
				ENDIF
				
				IF (CUST.DATA.CNTRY_NAME != "" ) THEN
				#{
					sv_r = "CURRLISTStruct.<rec_" + CUST.DATA.number + ">.CRNCY_NAME" + "|"
					sv_r = sv_r + CUST.DATA.CNTRY_NAME
					print(sv_r)
					
					sv_w = urhk_SetOrbOut(sv_r)
					IF (sv_w == 1)THEN
					#{
						sv_r = "SYSTEM MAL FUNCTION"
						sv_r = "ERROR|" + sv_r
						sv_w = urhk_SetOrbOut(sv_r)
						exitscript
					#}
					ENDIF
				#}
				ENDIF
				
				sv_n = urhk_dbCursorFetch(sv_m)
				sv_z = sv_z + 1
				CUST.DATA.number = sv_z
				print(CUST.DATA.number)
			#}
			DO
			sv_n = urhk_dbCursorClose(sv_m)
			IF (sv_n == 1)THEN
			#{
				sv_r = "SYSTEM MAL FUNCTION"
				sv_r = "ERROR|" + sv_r
				sv_w = urhk_SetOrbOut(sv_r)
				exitscript
			#}
			ENDIF
			print(sv_n)
			
			sv_r="SUCCESS"
			sv_f = "STATUS|" + sv_r
			sv_w = urhk_SetOrbOut(sv_f)
			exitscript
			#}
		ELSE
			#{
			sv_r = "SYSTEM MAL FUNCTION"
			sv_r = "ERROR|" + sv_r
			sv_w = urhk_SetOrbOut(sv_r)
			exitscript
		#}
		ENDIF
		PROCESS:
			sv_f = "STATUS|" + sv_r
			print(sv_f)
			sv_w = urhk_SetOrbOut(sv_f)
			IF (sv_w == 1)THEN
			#{
				sv_r = "SYSTEM MAL FUNCTION"
				sv_r = "ERROR|" + sv_r
				sv_w = urhk_SetOrbOut(sv_r)
				exitscript
			#}
			ENDIF
			#}
		ELSE
			#{
			sv_r = "BANK ID not exists"
			sv_f = "ERROR|" + sv_r
			sv_w = urhk_SetOrbOut(sv_f)
			IF (sv_w == 1)THEN
			#{
				sv_r = "SYSTEM MAL FUNCTION"
				sv_r = "ERROR|" + sv_r
				sv_w = urhk_SetOrbOut(sv_r)
				exitscript
