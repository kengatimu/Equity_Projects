				ENDIF
				##----------getting mean rate----------------------
				sv_s = " fxdcrncycode,ratecode,rate|SELECT fxd_crncy_code,ratecode,var_crncy_units "
				sv_s = sv_s + "FROM TBAADM.RTL "
				sv_s = sv_s + "WHERE fxd_crncy_code = ?SVAR "
				sv_s = sv_s + "AND var_crncy_code = ?SVAR "
				sv_s = sv_s + "AND ratecode = ?SVAR "
				sv_s = sv_s + "AND fxd_crncy_code != ?SVAR "
				sv_s = sv_s + "AND bank_id = ?SVAR"
				PRINT(sv_s)
				BANCS.INPARAM.BINDVARS = CASH.WITH.CrncyCode + "|" + BANCS.STDIN.homeCrncyCode + "|" + CASH.WITH.refCode + "|" + BANCS.STDIN.homeCrncyCode + "|" + BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_d = urhk_dbSelectWithBind(sv_s)
				PRINT(sv_d)
				IF (sv_d == 0) THEN
				#{
					CASH.WITH.fxdcrncycode = BANCS.OUTPARAM.fxdcrncycode
					PRINT(CASH.WITH.fxdcrncycode)

					CASH.WITH.ratecode = BANCS.OUTPARAM.ratecode
					PRINT(CASH.WITH.ratecode)

					sv_e = BANCS.OUTPARAM.rate
					PRINT(sv_e)
				#}
				ELSE
				#{
					sv_e = "1"
				#}
				ENDIF
    
				sv_p = CASH.WITH.tran_amt
				BANCS.INPARAM.InputAmount = sv_p
				BANCS.INPARAM.CurrencyCode = CASH.WITH.CrncyCode
				IF (CASH.WITH.CustTypeCode == CASH.WITH.custCode) THEN
				#{
				IF(CASH.WITH.schmCode == CASH.WITH.schmcode4) THEN
				#{
				print(CASH.WITH.schmCode)
				CASH.WITH.amtTabCode1="CWSUP"
				print(CASH.WITH.amtTabCode2)
				print("cate charge")
				print(CASH.WITH.tran_amt)
				print(CASH.WITH.custCode)
			
				ENDIF
			
					BANCS.INPARAM.AmountTableCode = CASH.WITH.amtTabCode1
				#}
				ELSE
				#{
				IF (CASH.WITH.schmCode == CASH.WITH.schmcode4) THEN
				#{
				print(CASH.WITH.schmCode)
				CASH.WITH.amtTabCode2="CWSUP"
				print(CASH.WITH.amtTabCode2)
				print("cate charge")
				print(CASH.WITH.tran_amt)
				print(CASH.WITH.custCode)
			
				ENDIF
					BANCS.INPARAM.AmountTableCode = CASH.WITH.amtTabCode2
				#}
				ENDIF
				PRINT(BANCS.INPARAM.AmountTableCode)
				sv_u = urhk_B2k_GetASTMAmount ("")
				IF (sv_u == 1) THEN
				#{
					CASH.WITH.errMsg = "Invalid AmountTableCode"
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				sv_q = BANCS.OUTPARAM.OutputAmount
				PRINT(sv_q)
				
				#sv_q contains the charge amount 
				IF (CASH.WITH.CrncyCode == "USD") THEN
				#{
				sv_m = CDOUBLE(sv_q)
				#}
				ELSE
				#{
				sv_m = (cdouble(sv_q) * cdouble(sv_e))
				#}
				ENDIF
				CASH.WITH.negat ="-1"
				CASH.WITH.Tot_Amt = ((sv_m) * cdouble(CASH.WITH.negat))
				CASH.WITH.with_amt = (sv_m)
				print(sv_m)
				print(CASH.WITH.Tot_Amt)
				print(CASH.WITH.CrncyCode)
					
			#}
			ELSE
			#{
				CASH.WITH.Tot_Amt = "0"
				PRINT(CASH.WITH.Tot_Amt)	
			#}
			ENDIF
		#}
		ENDIF
	#ELSE
	#	CASH.WITH.With_Flg = "N"
	#	PRINT(CASH.WITH.With_Flg)
	#	CASH.WITH.Int_Flg = "N"
	#}
	ENDIF

	
	IF (CASH.WITH.Min_Flg == "Y") THEN
	#{
		IF ((CASH.WITH.ac_sol == CUST.CPARAM.acSol8) AND (CASH.WITH.schmCode == CUST.CPARAM.schmCode8))THEN
		
						
			CASH.WITH.Min_Amt = CUST.CPARAM.amt5
		ELSE
		#{
			CASH.WITH.Min_Amt = (-1) * cdouble(CUST.CPARAM.amt1)
		#}
		ENDIF
				
		
		
		IF ((CASH.WITH.ac_sol == CUST.CPARAM.acSol8) AND (CASH.WITH.schmCode == CUST.CPARAM.schmCode7))THEN
			
			    CASH.WITH.Min_Amt = CUST.CPARAM.amt5
				
		#}
		ENDIF
			
			
		IF ((CASH.WITH.ac_sol == CUST.CPARAM.acSol8) AND (CASH.WITH.schmCode == CUST.CPARAM.schmCode9))THEN
			
				CASH.WITH.Min_Amt = CUST.CPARAM.amt9
				
		 #}
		ENDIF
		IF (CASH.WITH.schmCode == CUST.CPARAM.schmCode2) THEN
		#{
			CASH.WITH.Min_Amt = cdouble(CUST.CPARAM.amt5)
		
		#}
		ENDIF
	
		IF (CASH.WITH.ac_sol == CUST.CPARAM.acSol1) THEN
		#{
			CASH.WITH.Min_Amt = cdouble(CUST.CPARAM.amt2)
		#}
		ENDIF
	
		IF (CASH.WITH.ac_sol == CUST.CPARAM.acSol3) THEN
		#{
			CASH.WITH.Min_Amt = -1 * cdouble(CUST.CPARAM.amt3)
		#}
		ENDIF

		IF (CASH.WITH.ac_sol == CUST.CPARAM.acSol5) THEN
		#{
			CASH.WITH.Min_Amt = -1 * cdouble(CUST.CPARAM.amt3)
		#}
		ENDIF
		
		
	
		IF (CASH.WITH.ac_sol == CUST.CPARAM.acSol4) THEN
		#{
			CASH.WITH.Min_Amt = -1 * cdouble(CUST.CPARAM.amt3)
		#}
		ENDIF
	
		print(CASH.WITH.Min_Amt)
	#}
	ENDIF
	
	IF (CASH.WITH.Shd_Flg == "Y") THEN
	#{
		#print(CASH.WITH.Shd_Amt)	
		CASH.WITH.Shd_Amt = (cdouble(CASH.WITH.Shd_Amt) * cdouble(CUST.CPARAM.amt8))  / cdouble(CUST.CPARAM.amt1)
		print(CASH.WITH.Shd_Amt)

		IF (cdouble(CASH.WITH.Shd_Amt) < cdouble(CUST.CPARAM.amt6)) THEN
		#{
			CASH.WITH.Shd_Amt = cdouble(CUST.CPARAM.amt6)
			print(CASH.WITH.Shd_Amt)
		#}
		ENDIF
		#print(CASH.WITH.Shd_Amt)

		CASH.WITH.Shd_Amt = cint(CASH.WITH.Shd_Amt)	
	#}
	ENDIF
	

	

	#--------------------------------------------------------------------------
	# Transaction
	#--------------------------------------------------------------------------
	
	IF ((CASH.WITH.Int_Flg == "Y") OR (CASH.WITH.Min_Flg == "Y") OR (CASH.WITH.Stmp_Flg == "Y") OR (CASH.WITH.Shd_Flg == "Y") OR (CASH.WITH.With_Flg == "Y") ) THEN
	#{

		IF (CASH.WITH.CrncyCode == "USD") THEN
		#{
		CUST.GCHRG.tranType = "T"
		CUST.GCHRG.tranSubType = "CI"
		CUST.GCHRG.drAcctId = CASH.WITH.Ac_Number
		CUST.GCHRG.acctCrncyCode = CASH.WITH.CrncyCode
         	
		sv_h = urhk_getAcctDetailsInRepository(CASH.WITH.Ac_Number)
		PRINT(sv_h)
		IF (sv_h==0) THEN
		#{				
			CASH.WITH.EffAvailableAmt = cdouble(BANCS.OUTPARAM.EffAvailableAmt)
			PRINT(CASH.WITH.EffAvailableAmt)
			print(CASH.WITH.with_amt)
			print(CASH.WITH.with_amt)
			IF (cdouble(CASH.WITH.EffAvailableAmt) < cdouble(CASH.WITH.with_amt)) THEN
			#{
				CASH.WITH.errMsg = "Failed: Insufficient Balance to collect charges"
				print(CASH.WITH.errMsg)
				GOTO ERROR
			#}
			ENDIF
		#}
		ENDIF
		IF (CASH.WITH.With_Flg == "Y") THEN
		#{
			#CASH.WITH.with_amt = CINT(CASH.WITH.with_amt)
			#PRINT(CASH.WITH.with_amt)
			PRINT(COLL.GLBDATA.withevent)
			CUST.GCHRG.eventId = "TMWITH2"
			CUST.GCHRG.chrgAmt = CASH.WITH.with_amt + "|" + CASH.WITH.CrncyCode
			#CUST.GCHRG.eventId = COLL.GLBDATA.withevent
			CALL("gchrgcommon.scr")
			IF (CUST.GCHRG.successOrFailure == "S") THEN
			#{
				PRINT("Charge collected")
			#}
			ELSE
			#{
				PRINT("Failure")
			#}
			ENDIF
		#}
		ENDIF
	ELSE
	#{
		CUST.GCHRG.tranType = "T"
		CUST.GCHRG.tranSubType = "BI"
		CUST.GCHRG.drAcctId = CASH.WITH.Ac_Number
		CUST.GCHRG.acctCrncyCode = BANCS.STDIN.homeCrncyCode
         	
		IF (CASH.WITH.With_Flg == "Y") THEN
		#{
			sv_h = urhk_getAcctDetailsInRepository(CASH.WITH.Ac_Number)
			PRINT(sv_h)
			IF (sv_h==0) THEN
			#{				
				CASH.WITH.EffAvailableAmt = cdouble(BANCS.OUTPARAM.EffAvailableAmt)
				PRINT(CASH.WITH.EffAvailableAmt)
				print(CASH.WITH.with_amt)
				IF (cdouble(CASH.WITH.EffAvailableAmt) < cdouble(CASH.WITH.with_amt)) THEN
				#{
					CASH.WITH.errMsg = "Failed: Insufficient Balance to collect charges"
					print(CASH.WITH.errMsg)
					GOTO ERROR
				#}
				ENDIF
			#}
			ENDIF
			#PRINT(COLL.GLBDATA.withevent)
			#CUST.GCHRG.eventId = "TMWITH1"
			CUST.GCHRG.chrgAmt = CASH.WITH.with_amt + "|" + BANCS.STDIN.homeCrncyCode
			CUST.GCHRG.eventId = COLL.GLBDATA.withevent
			CALL("gchrgcommon.scr")
			IF (CUST.GCHRG.successOrFailure == "S") THEN
			#{
				PRINT("Charge collected")
			#}
			ELSE
			#{
				PRINT("Failure")
			#}
			ENDIF
		#}
		ENDIF

	#}
	ENDIF

	
		#--------------------------------------------------
	    # Income To intersol cashwith chrg Account(Script based)
	    #--------------------------------------------------
	
		IF (CASH.WITH.Int_Flg == "Y") THEN  
		#{
			IF (FIELDEXISTS(CASH.WITH.with_amt) == 1) THEN
			#{
			sv_h = urhk_getAcctDetailsInRepository(CASH.WITH.Ac_Number)
			PRINT(sv_h)
			IF (sv_h==0) THEN
			#{				
				CASH.WITH.EffAvailableAmt = cdouble(BANCS.OUTPARAM.EffAvailableAmt)
				PRINT(CASH.WITH.EffAvailableAmt)
				print(CASH.WITH.with_amt)
				IF (cdouble(CASH.WITH.EffAvailableAmt) < cdouble(CASH.WITH.with_amt)) THEN
				#{
					CASH.WITH.errMsg = "Failed: Insufficient Balance to collect charges"
					GOTO ERROR
				#}
				ENDIF
			#}
			ENDIF
				CUST.GCHRG.tranType = "T"
				CUST.GCHRG.tranSubType = "BI"
				CUST.GCHRG.drAcctId = CASH.WITH.Ac_Number

				IF (CASH.WITH.CrncyCode == "USD") THEN
				#{
				CUST.GCHRG.acctCrncyCode = CASH.WITH.CrncyCode
				CUST.GCHRG.chrgAmt = CASH.WITH.with_amt + "|" + CASH.WITH.CrncyCode
				#PRINT(COLL.GLBDATA.intevent)
				CUST.GCHRG.eventId = "TMINT3"
				#}
				ELSE
				#{
				CUST.GCHRG.acctCrncyCode = BANCS.STDIN.homeCrncyCode
				CUST.GCHRG.chrgAmt = CASH.WITH.with_amt + "|" + BANCS.STDIN.homeCrncyCode
				PRINT(COLL.GLBDATA.intevent)
				#CUST.GCHRG.eventId = "TMINT1"
				CUST.GCHRG.eventId = COLL.GLBDATA.intevent
				#}
				ENDIF

				CALL("gchrgcommon.scr")
				IF (CUST.GCHRG.successOrFailure == "S") THEN
				#{
					PRINT("Charge collected")
				#}
				ELSE
				#{
					PRINT("Failure")
				#}
				ENDIF			
			#}
			ENDIF	
		IF (BANCS.STDIN.mySolId == CASH.WITH.solId5) THEN
		#{
			IF ((CASH.WITH.type == "C") AND (CASH.WITH.ac_sol != BANCS.STDIN.mySolId)) THEN
			#{	
				CUST.GCHRG.acctCrncyCode = BANCS.STDIN.homeCrncyCode
				CASH.WITH.Tot_Amt = -1 * cdouble(CASH.WITH.amt13)
				PRINT(CASH.WITH.Tot_Amt)
				CASH.WITH.with_amt = cdouble(CASH.WITH.amt13)
				PRINT(CASH.WITH.with_amt)
				CASH.WITH.with_desc = CUST.CPARAM.withDesc2
			#}
			ENDIF
			CUST.GCHRG.tranType = "T"
			CUST.GCHRG.tranSubType = "CI"
			CUST.GCHRG.drAcctId = CASH.WITH.Ac_Number
			CUST.GCHRG.acctCrncyCode = BANCS.STDIN.homeCrncyCode
			CUST.GCHRG.chrgAmt = CASH.WITH.with_amt + "|" + BANCS.STDIN.homeCrncyCode
			PRINT(COLL.GLBDATA.specevent)
			#CUST.GCHRG.eventId = "TMINT2"
			CUST.GCHRG.eventId = COLL.GLBDATA.specevent
			#CUST.GCHRG.eventId = COLL.GLBDATA.intevent
			

			CALL("gchrgcommon.scr")
			IF (CUST.GCHRG.successOrFailure == "S") THEN
			#{
				PRINT("Charge collected")
			#}
			ELSE
			#{
				PRINT("Failure")
			#}
			ENDIF
				
			#}
			ENDIF
		#} 
		ENDIF
	
		#--------------------------------------------------
		# Income To cashwith stamp chrg Account
		#--------------------------------------------------
	
		#IF (CASH.WITH.Stmp_Flg == "Y") THEN
		#{
			#PRINT(COLL.GLBDATA.stmpevent)
			#CUST.GCHRG.eventId = "TMSTMP1"
			#CUST.GCHRG.eventId = COLL.GLBDATA.stmpevent
			#CALL("gchrgcommon.scr")
			#IF (CUST.GCHRG.successOrFailure == "S") THEN
			#{
			#	PRINT("Charge collected")
			#}
			#ELSE
			#{
			#	PRINT("Failure")
			#}
			#ENDIF		
		#}
		#ENDIF
	
		#--------------------------------------------------
		# Income To shadow balance chrg Account(Script based)
		#--------------------------------------------------
	
	    IF (CASH.WITH.Shd_Flg == "Y") THEN
		#{
			CUST.GCHRG.chrgAmt = CASH.WITH.Shd_Amt + "|" + BANCS.STDIN.homeCrncyCode
			PRINT(COLL.GLBDATA.shdwevent)
			#CUST.GCHRG.eventId = "TMSHDW1"
			CUST.GCHRG.eventId = COLL.GLBDATA.shdwevent
			CALL("gchrgcommon.scr")
			IF (CUST.GCHRG.successOrFailure == "S") THEN
			#{
				PRINT("Charge collected")
			#}
			ELSE
			#{
				PRINT("Failure")
			#}
			ENDIF		
		#}
	    ENDIF
	
		#--------------------------------------------------
	    # Income To MinBal chrg Account(Script based)
	    #--------------------------------------------------
	
		IF (CASH.WITH.Min_Flg == "Y") THEN
		#{
			CUST.GCHRG.chrgAmt = CASH.WITH.Min_Amt + "|" + BANCS.STDIN.homeCrncyCode
			PRINT(COLL.GLBDATA.minevent)
			#CUST.GCHRG.eventId = "TMMIN1"
			CUST.GCHRG.eventId = COLL.GLBDATA.minevent
			CALL("gchrgcommon.scr")
			IF (CUST.GCHRG.successOrFailure == "S") THEN
			#{
				PRINT("Charge collected")
			#}
			ELSE
			#{
				PRINT("Failure")
			#}
			ENDIF	
		#}
		ENDIF
	#}
	ENDIF
#}
ENDIF

ERROR:
IF (CASH.WITH.errMsg != "") THEN
#{
	sv_u = urhk_SRV_SetErr(CASH.WITH.errMsg)
	PRINT(sv_u)
#}
ENDIF
ENDOFSCRIPT:

EXITSCRIPT
#TRACE OFF
