IF (FIELDEXISTS(CASH.WITH.type) AND FIELDEXISTS(CASH.WITH.stype)) THEN
#{
	PRINT(CASH.WITH.type)
	PRINT(CASH.WITH.stype)
	IF ((CASH.WITH.type == "T") AND (CASH.WITH.stype == "CI")) THEN
	#{
		PRINT(CASH.WITH.Min_Flg)
		PRINT(CASH.WITH.Shd_Flg)
		IF ((CASH.WITH.Min_Flg == "Y") OR (CASH.WITH.Shd_Flg == "Y")) THEN
		#{
			call("onlinetranmindp001.scr")
			GOTO ENOFSCRIPT
		#}
		ENDIF
	#}
	ELSE
	#{
		CASH.WITH.Shd_Flg = "N"
	#}
	ENDIF
#}	
ENDIF
IF ((BANCS.STDIN.contextBankId == "11") AND (COLL.GLBDATA.sub_type == "I"))THEN
	print(CASH.WITH.type)
	print(COLL.GLBDATA.sub_type)
	PRINT(CASH.WITH.stype)
	CASH.WITH.ac_sol = COLL.GLBDATA.ac_sol
	print(CASH.WITH.ac_sol)
	CASH.WITH.CrncyCode = COLL.GLBDATA.CrncyCode
	print(CASH.WITH.CrncyCode)
	print(BANCS.STDIN.mySolId)
	
	
	IF ((CASH.WITH.type == "T") AND (COLL.GLBDATA.sub_type == "I")AND (COLL.GLBDATA.partTrantype == "D")) THEN
	#{
		IF (CASH.WITH.CrncyCode == BANCS.STDIN.homeCrncyCode)THEN
		#{
		CASH.WITH.Tot_Amt = -1 * cdouble(CUST.CPARAM.tminwchrg)
		PRINT(CASH.WITH.Tot_Amt)
		CASH.WITH.trf_amt = cdouble(CUST.CPARAM.tminwchrg)
		PRINT(CASH.WITH.trf_amt)
		#CASH.WITH.tminwevent = COLL.GLBDATA.tminwevent 
		#}
		ENDIF

		IF (CASH.WITH.CrncyCode == "USD")THEN
		#{
				sv_a = "inwRate|"
				sv_a = sv_a + "select VAR_CRNCY_UNITS from tbaadm.rtl where bank_id = ?SVAR " 
				sv_a = sv_a + "and ratecode = 'TTB' "
				sv_a = sv_a + "and FXD_CRNCY_CODE = 'USD'  and VAR_CRNCY_CODE = ?SVAR "
				print(sv_a)
				BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.homeCrncyCode 
				print(BANCS.INPARAM.BINDVARS)
				sv_b = urhk_dbSelectWithBind(sv_a)
				print(sv_b)

				IF (sv_d != 0) THEN 
				#{
					CASH.WITH.errMsg = "DB ERROR in getting the conversion Rate!"
					GOTO ENDOFSCRIPT
				#}
				ELSE
				#{
					CASH.WITH.inwRate = BANCS.OUTPARAM.inwRate
					print(CASH.WITH.inwRate)
				#}
				ENDIF
				
				BANCS.INPARAM.ToCurrency   = BANCS.STDIN.homeCrncyCode
				BANCS.INPARAM.InputAmount  = CDOUBLE(CUST.CPARAM.tmusdchrg)
				BANCS.INPARAM.FromCurrency =  CASH.WITH.CrncyCode
				BANCS.INPARAM.RateCode     = "TTB"
				BANCS.INPARAM.Rate         = CDOUBLE(CASH.WITH.inwRate)
				sv_u = urhk_B2k_ConvertAmount("") 
				IF (sv_u == 1) THEN
				#{
					CASH.WITH.errMsg = "Checking for inward charge for USD failed"
					GOTO ENDOFSCRIPT
				#}
				ELSE
				#{
				   CASH.WITH.trf_amt = BANCS.OUTPARAM.OutputAmount 
				   PRINT(CASH.WITH.trf_amt)
				#}
				ENDIF
		#}
		ENDIF
		
		CASH.WITH.tminwevent = COLL.GLBDATA.tminwevent
	ELSE
	#{
	GOTO ENDOFSCRIPT
	#}
	ENDIF

		CUST.GCHRG.tranType = "T"
		CUST.GCHRG.tranSubType = "CI"
		#CUST.GCHRG.drAcctId = CASH.WITH.Ac_Number
		CUST.GCHRG.acctCrncyCode = BANCS.STDIN.homeCrncyCode
		CUST.GCHRG.chrgAmt = CASH.WITH.trf_amt + "|" + BANCS.STDIN.homeCrncyCode
		PRINT(CASH.WITH.tminwevent)
		CUST.GCHRG.eventId = CASH.WITH.tminwevent
		CUST.GCHRG.drAcctId = COLL.GLBDATA.account1
		print(CUST.GCHRG.drAcctId)
		CALL("gchrgcommon.scr")
		IF (CUST.GCHRG.successOrFailure == "S") THEN
		#{
			PRINT("Charge collected")
		#}
		ELSE
		#{
			PRINT("Failure")
		#}
		ENDIF
	GOTO ENDOFSCRIPT
#} 
ENDIF

IF ((BANCS.STDIN.contextBankId == "11") AND (COLL.GLBDATA.sub_type == "NR"))THEN
	print(CASH.WITH.type)
	print(COLL.GLBDATA.sub_type)
	PRINT(CASH.WITH.stype)
	CASH.WITH.ac_sol = COLL.GLBDATA.ac_sol
	print(CASH.WITH.ac_sol)
	CASH.WITH.CrncyCode = COLL.GLBDATA.CrncyCode
	print(CASH.WITH.CrncyCode)
	print(BANCS.STDIN.mySolId)
	print(CASH.WITH.solId5)
	
	IF (BANCS.STDIN.mySolId == CASH.WITH.solId5) THEN
	#{	
		IF ((CASH.WITH.type == "C") AND (COLL.GLBDATA.sub_type == "NR") AND (CASH.WITH.ac_sol != BANCS.STDIN.mySolId)) THEN
