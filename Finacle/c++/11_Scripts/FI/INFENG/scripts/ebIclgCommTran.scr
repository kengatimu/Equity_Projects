<--start
trace on
#+++++++++++++
#Rep/Class
#+++++++++++++
        if(repexists("EQSRV")==0)then
                createrep("EQSRV")
        endif
        if(classexists("EQSRV","GLBDATA")==0)then
                createclass("EQSRV","GLBDATA",5)
        endif
        sv_u = urhk_B2K_PrintRepos("BANCS")
        print(sv_u)
        EQSRV.GLBDATA.errMsg    = ""
	EQSRV.GLBDATA.crAcct = ""
	EQSRV.GLBDATA.DrAcct = ""
	EQSRV.GLBDATA.foracid = ""
#++++++++++++
#transaction
#++++++++++++
        sv_a = urhk_MTTS_Close("")
        if(repexists("MTT")==0)then
                createrep("MTT")
        endif
        if(classexists("MTT","TranDetails")==0)then
                createclass("MTT","TranDetails",5)
        endif
        if(classexists("MTT","PartTranDetails")==0)then
                createclass("MTT","PartTranDetails",5)
        endif
        if(classexists("MTT","InputDetails")==0)then
                createclass("MTT","InputDetails",5)
        endif
        sv_a = urhk_MTTS_PopulateInputDetails("")
        print(sv_a)
        if(sv_a==0)then
                MTT.InputDetails.ZoneCode  = MTT.InputDetails.Argument1
                MTT.InputDetails.TranId  = MTT.InputDetails.Argument2
                MTT.InputDetails.TranAmt  = MTT.InputDetails.Argument3
                MTT.InputDetails.DrAcctId  = MTT.InputDetails.Argument4
                MTT.InputDetails.acctOwnership  = MTT.InputDetails.Argument5
                MTT.InputDetails.PartSrlNum  = MTT.InputDetails.Argument6
        else
		MTT.InputDetails.ZoneCode  = "" 
		MTT.InputDetails.TranId  = "" 
		MTT.InputDetails.TranAmt  = "" 
		MTT.InputDetails.DrAcctId  = "" 
		MTT.InputDetails.acctOwnership = ""
		MTT.InputDetails.PartSrlNum = ""
        endif
        sv_j = " sleep 10 "
        print(sv_j)
        sv_g = system(sv_j)
        print(sv_g)
	if(MTT.InputDetails.ZoneCode!="")then
	sv_l = strlen(MTT.InputDetails.ZoneCode)
	sv_f = mid$(MTT.InputDetails.ZoneCode,0,sv_l)
	sv_p = getposition(sv_f,"/")
	print(mid$(sv_f,0,(sv_p-1)))
	MTT.InputDetails.ZoneCode = mid$(sv_f,0,(sv_p-1))
	else
	MTT.InputDetails.ZoneCode = "NA"
	endif	
        sv_d = "dtdCnt,tranId,pstdFlg,tranDate,DrAcct,DrAmt,DrCrncy,DrSolId,InstNum | "
        sv_d = sv_d + " select count(*),tran_id,pstd_flg,tran_date,acid,tran_amt,tran_crncy_code,dth_init_sol_id,instrmnt_num "
        sv_d = sv_d + " from tbaadm.dtd where bank_id=?SVAR and tran_id = lpad(?SVAR,9,' ') "
        sv_d = sv_d + " and tran_date =to_date(?SVAR,'DD-MM-RR') and rownum<=1 "
        sv_d = sv_d + " and exists ( select 1 from tbaadm.gam where acid=dtd.acid "
	sv_d = sv_d + " and bank_id=?SVAR and foracid=?SVAR) "
        sv_d = sv_d + " group by tran_id,pstd_flg,tran_date,acid,tran_amt,tran_crncy_code,dth_init_sol_id,instrmnt_num "
        BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + MTT.InputDetails.TranId + "|" + mid$(BANCS.STDIN.BODDate,0,10) + "|" + BANCS.STDIN.contextBankId + "|" + MTT.InputDetails.DrAcctId
        print(BANCS.INPARAM.BINDVARS)
        print(sv_d)
        sv_u = urhk_dbSelectWithBind(sv_d)
        if(sv_u==0)then
                EQSRV.GLBDATA.dtdCnt = BANCS.OUTPARAM.dtdCnt
                EQSRV.GLBDATA.tranId = BANCS.OUTPARAM.tranId
                EQSRV.GLBDATA.pstdFlg = BANCS.OUTPARAM.pstdFlg
                EQSRV.GLBDATA.tranDate = BANCS.OUTPARAM.tranDate
                EQSRV.GLBDATA.DrAcct = BANCS.OUTPARAM.DrAcct
                EQSRV.GLBDATA.DrAmt = BANCS.OUTPARAM.DrAmt
                EQSRV.GLBDATA.DrCrncy = BANCS.OUTPARAM.DrCrncy
                EQSRV.GLBDATA.DrSolId = BANCS.OUTPARAM.DrSolId
                EQSRV.GLBDATA.InstNum = BANCS.OUTPARAM.InstNum
        else
                EQSRV.GLBDATA.dtdCnt = 0
                EQSRV.GLBDATA.tranId = ""
                EQSRV.GLBDATA.pstdFlg = ""
                EQSRV.GLBDATA.tranDate = ""
                EQSRV.GLBDATA.DrAcct = ""
                EQSRV.GLBDATA.DrAmt = ""
                EQSRV.GLBDATA.DrCrncy = ""
                EQSRV.GLBDATA.DrSolId = ""
                EQSRV.GLBDATA.InstNum = "" 
        endif
	#####sv_b = "EQBINZ|09-06-2020 00:00:00|2000"
	if((MTT.InputDetails.ZoneCode!="") and (EQSRV.GLBDATA.DrSolId!=""))then
	sv_b = MTT.InputDetails.ZoneCode + "|" + BANCS.STDIN.BODDate + "|" + EQSRV.GLBDATA.DrSolId 
	sv_r = urhk_GetZoneHeaderDetails(sv_b)
	if(sv_r==0)then
		print("Invalid Zone for Commision")
		###exitscript
	endif
	endif
        if(cint(EQSRV.GLBDATA.dtdCnt) <=0)then
                print("No ICLG Transactions")
                exitscript
        endif
	print(EQSRV.GLBDATA.pstdFlg)
        if((EQSRV.GLBDATA.pstdFlg =="N") or (EQSRV.GLBDATA.pstdFlg== "") or (EQSRV.GLBDATA.pstdFlg==" "))then
                print("Source Tran are Not Posted")
                ##exitscript
        endif
	print(EQSRV.GLBDATA.DrAcct)
        sv_a= urhk_B2k_AcidToForacid(EQSRV.GLBDATA.DrAcct)
        if(sv_a==0)then
                EQSRV.GLBDATA.foracid = BANCS.OUTPARAM.Foracid
        else
                EQSRV.GLBDATA.foracid = ""
        endif
	print(EQSRV.GLBDATA.foracid)
        sv_u = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.foracid)
        print(sv_u)
        if(sv_u==0)then
                print(BANCS.OUTPARAM.ClearBalance)
                ##BANCS.INPUT.AgntAvailableAmt = BANCS.OUTPARAM.ClearBalance
		BANCS.INPUT.AgntAvailableAmt = BANCS.OUTPARAM.EffAvailableAmt
		BANCS.INPUT.AgntSchmCode = BANCS.OUTPARAM.schmCode
		BANCS.INPUT.acctOwnerShip = BANCS.OUTPARAM.acctOwnerShip
                sv_u = urhk_B2k_ForacidToAcid(EQSRV.GLBDATA.foracid)
                if(sv_u==0)then
                        EQSRV.GLBDATA.Dracid = BANCS.OUTPARAM.Acid
                else
                        goto VAYU
                endif
	else
		BANCS.INPUT.AgntSchmCode = ""
        endif
	if(BANCS.INPUT.acctOwnerShip!="C")then
		print("no charge")
		exitscript
	endif
	####print(EQSRV.GLBDATA.DrAmt)
	####print(BANCS.INPUT.AgntAvailableAmt)
        ####if(cdouble(EQSRV.GLBDATA.DrAmt) > cdouble(BANCS.INPUT.AgntAvailableAmt))then
        ####        print("Lien")
	####	EQSRV.GLBDATA.isMtt = "N"
	####else
	####	EQSRV.GLBDATA.isMtt = "Y"
	####endif
	if(EQSRV.GLBDATA.DrCrncy=="SSP")then
  #Gichiri 18/04/2023/CHG0032037
		EQSRV.GLBDATA.TranDrAmt = "1770"
		EQSRV.GLBDATA.crBacid = "IWCLG"
		##EQSRV.GLBDATA.crBacid = "650040105"
		sv_i = EQSRV.GLBDATA.crBacid + "|" + EQSRV.GLBDATA.DrCrncy + "|" + EQSRV.GLBDATA.DrSolId 
		sv_u = urhk_B2k_BacidToAcctId(sv_i)
		if(sv_u==0)then
			EQSRV.GLBDATA.crAcct = BANCS.OUTPARAM.AcctId
		endif
	endif
	if(EQSRV.GLBDATA.DrCrncy=="USD")then
 #Gichiri 18/04/2023/CHG0032037
		EQSRV.GLBDATA.TranDrAmt = "5.90"
		###EQSRV.GLBDATA.crBacid = "650041623"
		EQSRV.GLBDATA.crBacid = "IWCLG"
		sv_i = EQSRV.GLBDATA.crBacid + "|" + EQSRV.GLBDATA.DrCrncy + "|" + EQSRV.GLBDATA.DrSolId 
		sv_u = urhk_B2k_BacidToAcctId(sv_i)
		if(sv_u==0)then
			EQSRV.GLBDATA.crAcct = BANCS.OUTPARAM.AcctId
		endif
	endif
        print(EQSRV.GLBDATA.crAcct)
        sv_u = urhk_getAcctDetailsInRepository(EQSRV.GLBDATA.foracid)
        print(sv_u)
        if(sv_u==0)then
                print(BANCS.OUTPARAM.ClearBalance)
		print(BANCS.OUTPARAM.EffAvailableAmt)
                ##BANCS.INPUT.AgntAvailableAmt = BANCS.OUTPARAM.ClearBalance
		BANCS.INPUT.AgntAvailableAmt = BANCS.OUTPARAM.EffAvailableAmt
		sv_u = urhk_B2k_ForacidToAcid(EQSRV.GLBDATA.foracid)
	        if(sv_u==0)then
			EQSRV.GLBDATA.Dracid = BANCS.OUTPARAM.Acid
		else
			goto VAYU
	        endif
	endif
	print(EQSRV.GLBDATA.TranDrAmt)
	print(BANCS.INPUT.AgntAvailableAmt)
	if(cdouble(EQSRV.GLBDATA.TranDrAmt) > cdouble(BANCS.INPUT.AgntAvailableAmt))then
	#{
		EQSRV.GLBDATA.isMtt = "N"
		print("Lien")
		EQSRV.GLBDATA.tranRemarks = "Inward Clearing Lien"
		EQSRV.GLBDATA.durationMnths = "1"
                EQSRV.GLBDATA.durationDays = "0"
                EQSRV.GLBDATA.newDate = (BANCS.STDIN.BODDate + "|" + EQSRV.GLBDATA.durationMnths + "|" + EQSRV.GLBDATA.durationDays)
                print(EQSRV.GLBDATA.newDate)
                sv_u = urhk_B2k_Add_MonthsDays_To_date(EQSRV.GLBDATA.newDate)
                print(sv_u)
                if(sv_u != 0)then
                        EQSRV.GLBDATA.LimExpiryDate = LEFT$(BANCS.STDIN.BODDate,10)
                        print(EQSRV.GLBDATA.LimExpiryDate)
                else
                        EQSRV.GLBDATA.LimExpiryDate = BANCS.OUTPARAM.MODIFIED_DATE
                        print(EQSRV.GLBDATA.LimExpiryDate)
                endif
		sv_s = "amount1,acid,b2kid|select trim (lien_amt),acid,b2k_id from tbaadm.alt "
		sv_s = sv_s + " where b2k_id in (select trim(max(b2k_id))  from tbaadm.alt "
		sv_s = sv_s + " where acid =?SVAR "
		sv_s = sv_s + " and bank_id =?SVAR) "
		sv_s = sv_s + " and acid =?SVAR "
		sv_s = sv_s + " and bank_id =?SVAR "
		BANCS.INPARAM.BINDVARS = EQSRV.GLBDATA.Dracid + "|" + BANCS.STDIN.contextBankId + "|" + EQSRV.GLBDATA.Dracid + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		print(sv_s)
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		if(sv_d == 0)then
		#{
			EQSRV.GLBDATA.amount1 = BANCS.OUTPARAM.amount1
			EQSRV.GLBDATA.acid = BANCS.OUTPARAM.acid
			EQSRV.GLBDATA.b2kid = BANCS.OUTPARAM.b2kid
			EQSRV.GLBDATA.TranAmt = cdouble(EQSRV.GLBDATA.TranDrAmt) + cdouble(EQSRV.GLBDATA.amount1)

			BANCS.INPARAM.b2kId = EQSRV.GLBDATA.b2kid
			BANCS.INPARAM.acctNum = EQSRV.GLBDATA.foracid 
			BANCS.INPARAM.blockMode = "M"
			BANCS.INPARAM.lienAmt =  cdouble(EQSRV.GLBDATA.TranAmt)* -1
			BANCS.INPARAM.expiryDate = EQSRV.GLBDATA.LimExpiryDate
			BANCS.INPARAM.remarks = EQSRV.GLBDATA.tranRemarks
			BANCS.INPARAM.reasonCode = "LICLG"
			BANCS.INPARAM.lienValueDate = LEFT$(BANCS.STDIN.BODDate,10)
			BANCS.INPARAM.bodDate = LEFT$(BANCS.STDIN.BODDate,10)
			sv_u = urhk_updateLien("")
			if( sv_u != 0 )then
				sv_u = urhk_b2k_printrepos("BANCS")
				print(sv_u)
			else
				print("lien")
				exitscript
			endif
			BANCS.INPARAM.b2kId = EQSRV.GLBDATA.b2kid
			BANCS.INPARAM.acctNum = EQSRV.GLBDATA.foracid 
			BANCS.INPARAM.blockMode = "M"
			BANCS.INPARAM.lienAmt =  cdouble(EQSRV.GLBDATA.TranAmt)* 1
			BANCS.INPARAM.expiryDate = EQSRV.GLBDATA.LimExpiryDate
			BANCS.INPARAM.remarks = EQSRV.GLBDATA.tranRemarks
			BANCS.INPARAM.reasonCode = "LICLG"
			BANCS.INPARAM.lienValueDate = LEFT$(BANCS.STDIN.BODDate,10)
			BANCS.INPARAM.bodDate = LEFT$(BANCS.STDIN.BODDate,10)
			sv_u = urhk_updateLien("")
			if( sv_u != 0 )then
				sv_u = urhk_b2k_printrepos("BANCS")
				print(sv_u)
				exitscript
			else
				print("lien")
				exitscript
			endif
		ELSE
			EQSRV.GLBDATA.amount1 ="0.00"
			sv_u = urhk_SetUrhkInp("acctLienMaintCrit.acctNum.foracid|" + EQSRV.GLBDATA.foracid )
			sv_u = urhk_SetUrhkInp("acctLienMaintCrit.moduleType.type|ULIEN")
			sv_u = urhk_SetUrhkInp("acctLienMaintCrit.acctNum.crncyCode|" + EQSRV.GLBDATA.DrCrncy )
			sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.key.serial_num|0")
			print(EQSRV.GLBDATA.TranDrAmt)
			sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.newLienAmt|" + EQSRV.GLBDATA.TranDrAmt + "|" + EQSRV.GLBDATA.DrCrncy)
			sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.oldLienAmt|" + EQSRV.GLBDATA.amount1 + "|" + EQSRV.GLBDATA.DrCrncy)
			sv_u = urhk_SetUrhkInp("acctLienMaintCrit.lienExpiryDate|" + EQSRV.GLBDATA.LimExpiryDate )
			sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.lienReasonCode.refCode|LICLG")
			sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.lienRemarks|" + EQSRV.GLBDATA.tranRemarks )
			sv_u = urhk_SetUrhkInp("lienMaintLL.<rec_0>.expiryDate|" + EQSRV.GLBDATA.LimExpiryDate )
			sv_u = urhk_ExecSrv("SRV_AddLienOnAcctAndVerify|retain_all_output = Y|same_user_verify = Y")
			print(sv_u)
			if(sv_u=="0")then
				print("lien")
				exitscript
			else
				print("lien fail")
				EQSRV.GLBDATA.srvAcctId = EQSRV.GLBDATA.foracid 
				callscriptifexist("ebsrvHandler.scr")
				goto VAYU
			endif
		#}
		endif
	else
		EQSRV.GLBDATA.isMtt = "Y"
	#}
	endif
	if(EQSRV.GLBDATA.isMtt=="Y")then
	#{
		BANCS.INPARAM.PostTranFlg       = "Y"
		BANCS.INPARAM.CommitFlg         = "Y"
		BANCS.INPARAM.InsertTranWithValidnFlg = "Y"
		BANCS.INPARAM.ValidationFlag    = "Y"
		BANCS.INPARAM.RestrictModifyInd = "FIRST_GROUP"
		BANCS.INPARAM.ErrorCheckForLuw  ="Y"

		sv_a = urhk_MTTS_Initialize("")
		MTT.TranDetails.TranDate        = "0"
		MTT.TranDetails.TranType        = "T"
		MTT.TranDetails.TranSubType     = "BI"
		MTT.TranDetails.Remarks         = "ICLG Commision" 
		MTT.TranDetails.IgnoreExcp      = "Y"
		MTT.TranDetails.PrintAdviceInd  = "B"
		MTT.TranDetails.TranIdOnline    = "N"
		sv_u = urhk_MTTS_defineTransaction("FloatFund")
		if(sv_u != 0) then
			if(fieldexists(MTT.Error.Description))then
				print(MTT.Error.Description)
			endif
			goto ENDSCR
		endif
		sv_u = urhk_MTTS_populateInputDetails("")
		if(sv_u != 0) then
			if(fieldexists(MTT.Error.Description))then
				print(MTT.Error.Description)
			endif
			goto ENDSCR
		endif
	#}
	endif
	if(EQSRV.GLBDATA.isMtt=="Y")then
	#{
#Debit
        print(EQSRV.GLBDATA.foracid)
        MTT.PartTranDetails.Account     = EQSRV.GLBDATA.foracid
        MTT.PartTranDetails.RefCurrency = EQSRV.GLBDATA.DrCrncy 
        MTT.PartTranDetails.ValueDateDiff = "0"
        MTT.PartTranDetails.Particulars = "INWARD CLEARING CHARGES"
        MTT.PartTranDetails.RefAmount   = -1 * cdouble(EQSRV.GLBDATA.TranDrAmt)
        MTT.PartTranDetails.Remarks     = "Inst Num:" + EQSRV.GLBDATA.InstNum 
        MTT.PartTranDetails.RefNum      = EQSRV.GLBDATA.tranId
        MTT.PartTranDetails.Consolidate = "N"
        MTT.PartTranDetails.TranIdentifier = "FloatFund"
        ##MTT.PartTranDetails.ReportCode = sv_z
        sv_u = urhk_MTTS_definePartTran("SettleDr")
        print(sv_u)
        if(sv_u!=0)then
                if(fieldexists(MTT.Error.Description))then
                        print(MTT.Error.Description)
                        EQSRV.GLBDATA.errMsg    = MTT.Error.Description
                        goto ENDSCR
                endif
        endif
#Credit
        print(EQSRV.GLBDATA.crAcct)
        MTT.PartTranDetails.Account     = EQSRV.GLBDATA.crAcct
        MTT.PartTranDetails.RefCurrency = EQSRV.GLBDATA.DrCrncy 
        MTT.PartTranDetails.ValueDateDiff = "0"
        MTT.PartTranDetails.Particulars = "INWARD CLEARING CHARGES" 
        MTT.PartTranDetails.RefAmount   = 1 * cdouble(EQSRV.GLBDATA.TranDrAmt)
        MTT.PartTranDetails.Remarks     = "Inst Num:" + EQSRV.GLBDATA.InstNum 
        MTT.PartTranDetails.RefNum      = EQSRV.GLBDATA.tranId
        MTT.PartTranDetails.Consolidate = "N"
        MTT.PartTranDetails.TranIdentifier = "FloatFund"
        ##MTT.PartTranDetails.ReportCode = sv_z
        sv_u = urhk_MTTS_definePartTran("SettleDr")
        print(sv_u)
        if(sv_u!=0)then
                if(fieldexists(MTT.Error.Description))then
                        print(MTT.Error.Description)
                        EQSRV.GLBDATA.errMsg    = MTT.Error.Description
                        goto ENDSCR
                endif
        endif
#Res
        sv_u = urhk_MTTS_endDefinition("")
        if(sv_u!=0)then
                if(fieldexists(MTT.Error.Description))then
                        print(MTT.Error.Description)
                        EQSRV.GLBDATA.errMsg    = MTT.Error.Description
                        goto ENDSCR
                endif
        else
                print(BANCS.OUTPARAM.MTTTranId)
		EQSRV.GLBDATA.FloatTranId = BANCS.OUTPARAM.MTTTranId
        endif
        sv_u = urhk_MTTS_Close("")
        print(sv_u)
ENDSCR:
        print(EQSRV.GLBDATA.errMsg)
        sv_a = urhk_MTTS_Close("")
	#}
	endif
        ##if(classexists("EQSRV","GLBDATA")==1)then
        ##      deleteclass("EQSRV","GLBDATA")
        ##endif
        ##if(repexists("EQSRV")==1)then
