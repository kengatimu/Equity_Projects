#-----------------------------------------------------------------------------
# Source Name           : popMT940And950StmtDetails.scr
# Date                  : 06-Feb-2013
# Author                : GOKULKRISHNA
# Description           : This script is used to get the tranidentificationcode
#						: and acctrefnum for particular trantype and transubtype
# Sources called        : getcparamvalue.scr
# Sources called from   : NA
# Modification History  :
# <Serial No.>      <Date>          <Author Name>       <Description>
# 0.00a             06-Feb-2012     Gokulkrishna        Original version
#-----------------------------------------------------------------------------
<--START
CHECKSUM="9d025411ed79e58e5275182c026527b115b88a8daac9c6b108ef62fdd7c55519"
	TRACE ON
	sv_a = urhk_b2k_printRepos("BANCS")
	IF (REPEXISTS("CUST")==0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","DATA")==0) THEN
	#{
		CREATECLASS("CUST","DATA",5)
	#}
	ENDIF
	
	BANCS.INPUT.moduleName = "TRANSTMTDEATIL"
	BANCS.INPUT.parameterId = "TRANIDCODE1"
	CALL("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.DATA.tranIdCode1 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.DATA.tranIdCode1 = "CHK"
	#}
	ENDIF
	
	BANCS.INPUT.parameterId = "TRANIDCODE2"
	CALL("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.DATA.tranIdCode2 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.DATA.tranIdCode2 = "TRF"
	#}
	ENDIF
	BANCS.INPUT.parameterId = "TRANIDCODE3"
	CALL("getcparamvalue.scr")
	PRINT(BANCS.OUTPUT.parameterVal)
	IF (BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.DATA.tranIdCode3 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.DATA.tranIdCode3 = "CMI"
	#}
	ENDIF
	
	
	CUST.DATA.temp = ""
	
	BANCS.OUTPUT.fundsCode = CUST.DATA.temp
	BANCS.OUTPUT.tranType = CUST.DATA.temp
	
	PRINT(BANCS.INPUT.ctd_tran_type)
	CUST.DATA.ctdtrantype = BANCS.INPUT.ctd_tran_type
	PRINT(CUST.DATA.ctdtrantype)
	PRINT(BANCS.INPUT.ctd_tran_sub_type)
	CUST.DATA.ctdtransubtype = BANCS.INPUT.ctd_tran_sub_type
	PRINT(CUST.DATA.ctdtransubtype)
	
	#-------------------------------------------------------------------------------------------
	# To get tranIdentificationCode
	#-------------------------------------------------------------------------------------------
	IF ((CUST.DATA.ctdtrantype == "L") AND ((CUST.DATA.ctdtransubtype == "O") OR (CUST.DATA.ctdtransubtype == "I"))) THEN
	#{
		BANCS.OUTPUT.tranIdentificationCode = CUST.DATA.tranIdCode1
		PRINT(BANCS.OUTPUT.tranIdentificationCode)
		#}
	ELSE
		#{
		IF ((CUST.DATA.ctdtrantype == "T") AND ((CUST.DATA.ctdtransubtype == "BI") OR (CUST.DATA.ctdtransubtype == "CI") or (CUST.DATA.ctdtransubtype == "I") or (CUST.DATA.ctdtransubtype == "EO"))) THEN
		#{
			BANCS.OUTPUT.tranIdentificationCode = CUST.DATA.tranIdCode2
			PRINT(BANCS.OUTPUT.tranIdentificationCode)
			#}
		ELSE
			#{
			BANCS.OUTPUT.tranIdentificationCode = CUST.DATA.temp
			PRINT(BANCS.OUTPUT.tranIdentificationCode)
		#}
		ENDIF
	#}
	ENDIF
	
	IF (CUST.DATA.ctdtrantype == "C") THEN
	#{
		BANCS.OUTPUT.tranIdentificationCode=CUST.DATA.tranIdCode3
		PRINT(BANCS.OUTPUT.tranIdentificationCode)
	#}
	ENDIF
	#-------------------------------------------------------------------------------------------
	# To get acctOwnerRef
	#-------------------------------------------------------------------------------------------
	PRINT(CUST.DATA.ctdtrantype)
	PRINT(CUST.DATA.ctdtransubtype)
	
	CUST.DATA.temp = ""
	PRINT(BANCS.INPUT.ctd_instrmnt_num)
	IF ((CUST.DATA.ctdtrantype == "L") AND ((CUST.DATA.ctdtransubtype == "O") OR (CUST.DATA.ctdtransubtype == "I"))) THEN
	#{
		BANCS.OUTPUT.acctOwnerRef = TRIM(BANCS.INPUT.ctd_instrmnt_num)
		PRINT(BANCS.OUTPUT.acctOwnerRef)
		#}
	ELSE
		#{
		BANCS.OUTPUT.acctOwnerRef = CUST.DATA.temp
	#}
	ENDIF
	IF(BANCS.OUTPUT.acctOwnerRef == "") THEN
	#{
		BANCS.OUTPUT.acctOwnerRef=LEFT$(BANCS.INPUT.ctd_tran_particular,15)
		PRINT(BANCS.OUTPUT.acctOwnerRef)
	#}
	ENDIF
	IF(BANCS.OUTPUT.acctOwnerRef == "") THEN
	#{
		BANCS.OUTPUT.acctOwnerRef=" "
	#}
	ENDIF
	
	
	
	BANCS.OUTPUT.acctServicingInstRef = CUST.DATA.temp
	BANCS.OUTPUT.supplementaryDetails = CUST.DATA.temp
	PRINT(BANCS.INPUT.ctd_tran_particular)
	BANCS.OUTPUT.infoToAccntOwner1 = ""
	BANCS.OUTPUT.infoToAccntOwner1 = BANCS.INPUT.ctd_tran_particular + BANCS.INPUT.ctd_instrmnt_num
	PRINT(BANCS.OUTPUT.infoToAccntOwner1)
	BANCS.OUTPUT.infoToAccntOwner2 = CUST.DATA.temp
	BANCS.OUTPUT.infoToAccntOwner3 = CUST.DATA.temp
	BANCS.OUTPUT.infoToAccntOwner4 = CUST.DATA.temp
	BANCS.OUTPUT.infoToAccntOwner5 = CUST.DATA.temp
	BANCS.OUTPUT.infoToAccntOwner6 = CUST.DATA.temp
	IF (CLASSEXISTS( "CUST","DATA" ) == 1) THEN
	#{
		DELETECLASS( "CUST","DATA" )
	#}
	ENDIF
	
	IF (REPEXISTS("CUST") == 1) THEN
	#{
		DELETEREP("CUST")
	#}
	ENDIF
	sv_a = urhk_b2k_printRepos("BANCS")
	#TRACE OFF
	EXITSCRIPT
END-->
