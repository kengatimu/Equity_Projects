       	#CUST.DATA.LntAmnt = CDOUBLE(CUST.DATA.oldLienAmt1)
        CUST.DATA.LntAmnt = CUST.VAT.vatsum
       	print(CUST.DATA.LntAmnt)
        CUST.DATA.foracid = CUST.VAT.foracid
        print(CUST.DATA.foracid)
        







       	#----------------------------------------------------------------------------------------------------
		#--- 1. SRV_FetchAcctDtlForTran - FETCH DEBIT A/C DETAILS
		#---------------------------------------------------------------------------------------------------- 

		sv_k = urhk_SetUrhkInp("acct.foracid|" +CUST.DATA.foracid)
		print(CUST.DATA.foracid)

		sv_k = urhk_SetUrhkOut("acct.crncyCode|drCrncyCode")
		sv_k = urhk_SetUrhkOut("acct.solId|solId")

		sv_k = urhk_ExecSrv("SRV_FetchAcctDtlForTran|retain_all_output = Y")
		print(sv_k)

		if (sv_k == 0)then
		#{
			print("Step 1 success")



			CUST.DATA.drCrncyCode = BANCS.OUTPARAM.drCrncyCode
			print(CUST.DATA.drCrncyCode)


			CUST.DATA.drAcctNum = CUST.DATA.foracid
			PRINT(CUST.DATA.drAcctNum)
      
      CUST.DATA.solId=BANCS.OUTPARAM.solId
      print(CUST.DATA.solId)
      
      
			CUST.DATA.PARTICULARS ="SALE TAX Sweep"
			print(CUST.DATA.PARTICULARS)
      
      
         #Change context sol depending on the account number
      	IF(CUST.DATA.solId != BANCS.STDIN.contextBankId)THEN
	      #{
      		sv_u = urhk_SetUrhkInp("sol.solId|"+CUST.DATA.solId)
      		print(sv_u)
      		sv_u = urhk_ExecSrv("SRV_ModifyContextSol")
      		print(sv_u)
        #}
	    ENDIF
         print(BANCS.STDIN.contextBankId)
      
      #---------------------------------
      #-------SALE TAX ACCOUNT-------------
      #-----------------------------
      IF(CUST.DATA.drCrncyCode =="SSP")THEN
      #{
      
      CUST.DATA.crAcctNum = "2000340011779"
      #}
      ENDIF
      
      IF(CUST.DATA.drCrncyCode =="USD")THEN
      #{
      
      CUST.DATA.crAcctNum = "2000340011780"
      #}
      ENDIF

      print(CUST.DATA.crAcctNum)
			#----------------------------------------------------------------------------------------------------
			#--- 3. SRV_AddAndPostXferTran
			#---------------------------------------------------------------------------------------------------- 

			# DEBIT 1 SALARY PAYMENT CHARGE
			#------------------------------------------
			#
			sv_i = urhk_SetUrhkInp("tranHdr.tranIdentifier.tranDate|" + BANCS.STDIN.BODDate)
			sv_i = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranType|T")
			sv_i = urhk_SetUrhkInp("tranHdr.tranTypeSubType.tranSubType|BI")
			sv_i = urhk_SetUrhkInp("tranHdr.initSol.solId|" + BANCS.STDIN.contextBankId)
			sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.key.serial_num|1")
			sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.partTranType.code|D")
			sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.acctId.foracid|" + CUST.DATA.drAcctNum)
			sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.valueDate|" + BANCS.STDIN.BODDate)
			sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.glDate|" + BANCS.STDIN.BODDate)
			sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.tranAmt|" + CUST.DATA.LntAmnt + "|" + CUST.DATA.drCrncyCode)
			sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.rate|1")
			sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.tranCrncyCode.crncyCode|" + CUST.DATA.drCrncyCode)
			sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.refCrncyCode.crncyCode|" + CUST.DATA.drCrncyCode)
			sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.refAmt|" + CUST.DATA.LntAmnt+"|"+CUST.DATA.drCrncyCode)
			sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.treaRate|0.0000")
			sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.delFlg|N")
			sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.entryUserId.userId|"+BANCS.STDIN.userId)
			sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_0>.tranParticulars|" + CUST.DATA.PARTICULARS)



			# CREDIT 1 - P & L A/C
			#------------------------------------------
			#
			sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.key.serial_num|2")
			sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.partTranType.code|C")
			sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.acctId.foracid|" + CUST.DATA.crAcctNum)
			sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.valueDate|" + BANCS.STDIN.BODDate)
			sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.glDate|" + BANCS.STDIN.BODDate)
			sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.tranAmt|" + CUST.DATA.LntAmnt + "|" + CUST.DATA.drCrncyCode)
			sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.rate|1")
			sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.tranCrncyCode.crncyCode|" + CUST.DATA.drCrncyCode)
			sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refCrncyCode.crncyCode|" + CUST.DATA.drCrncyCode)
			sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.refAmt|" + CUST.DATA.LntAmnt + "|" + CUST.DATA.drCrncyCode)
			sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.treaRate|0.0000")
			sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.delFlg|N")
			sv_i = urhk_SetUrhkInp("tranDtl.partTranDetailLL.<rec_1>.tranParticulars|"+CUST.DATA.PARTICULARS+"-"+CUST.DATA.drAcctNum)

			
			
			sv_o = urhk_SetUrhkOut("tranHdr.tranIdentifier.tranId|tranId")
			sv_o = urhk_SetUrhkOut("tranHdr.tranIdentifier.tranDate|tranDate")
									
			#sv_q = urhk_ExecSrv("SRV_AddAndPostXferTran|retain_all_output = Y")
      sv_q = urhk_ExecSrv("SRV_AddAndPostXferTran|retain_all_output = Y|call_mode = N|same_user_verify = Y|ignore_xcpn_flg= I|override_xcpn_flg= Y")
			print(sv_q)


			if (sv_q == 0)then
			#{
				
				print("SRV_AddAndPostXferTran success")
				print(BANCS.OUTPARAM.tranId)
        CUST.DATA.TranID = BANCS.OUTPARAM.tranId

				GOTO ENDSCRIPT
						
			#}
			else
			#{
				 CALL("trapSRVerror.scr")
         GOTO ERRORCHECK
				 GOTO ENDSCRIPT
			#}
			endif

			GOTO ENDSCRIPT
		#}
		endif



	ERRORCHECK:
		#----------------------------------------------------------------------------------------------------
		# SRV Error check
		#----------------------------------------------------------------------------------------------------
		
			IF (sv_q != 0) THEN
			#{
				IF(FIELDEXISTS(BANCS.OUTPARAM.Error_num) == 1) THEN
				#{
					print(BANCS.OUTPARAM.Error_num)
					sv_v = BANCS.OUTPARAM.Error_num
				#}									
				ELSE
				#{
					sv_v = 0
				#}
				ENDIF
				
				IF(sv_v > 0)THEN
				#{
					sv_u = system("echo 'Error'")
					sv_i = 1
					
					WHILE (sv_i <= sv_v)
					#{	
						
						sv_f = FORMAT$(sv_i,"%d")
						sv_e = ("BANCS").("OUTPARAM").("ErrorMesg_"+sv_f)
						sv_e = sv_e + " " + ("BANCS").("OUTPARAM").("Tag_"+sv_f)
						sv_e = sv_e + " Error Code:" + ("BANCS").("OUTPARAM").("ErrorCode_"+sv_f)
						print(sv_e)

						#sv_t = "executeFinacleScript_CustomData.ERROR | " + sv_e
						#sv_u = urhk_SetOrbOut(sv_t)	
						#print(sv_u)

						sv_i = sv_i + 1
						sv_u = system("echo '"+sv_e+"' >>XXXXXXXXXXXXXloanMgr.log")
						print(sv_u)
						
						#Error response
						sv_t = "ERROR | " +sv_e
						sv_u = urhk_SetOrbOut(sv_t)
						EXITSCRIPT
					#}
					DO
				#}
				ENDIF
			#}
			ENDIF	
			
		

		


	
EXITSCRIPT
ENDSCRIPT:
