#-----------------------------------------------------------------------------------------------
<--START
CHECKSUM="a25fdadc250678ee96cf255274c3242c88fc4e8a00610a1ab4238ce7d76fe579"
	TRACE ON
	
	#------------------------------------------------------------------------------
	# Creating repository and class
	#------------------------------------------------------------------------------
	IF (REPEXISTS("CUST") == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","LADISB") == 0) THEN
	#{
		CREATECLASS("CUST","LADISB",5)
	#}
	ENDIF
	
	IF (CLASSEXISTS("CUST","CPARAM") == 0) THEN
	#{
		CREATECLASS("CUST","CPARAM",5)
	#}
	ENDIF
	
	#-------------------------------------------------------------------------------
	#Initializing Required variables
	#-------------------------------------------------------------------------------
	CUST.LADISB.errMsg 			= ""
	CUST.LADISB.laceAmt			= ""
	CUST.LADISB.tranid			= ""
	CUST.LADISB.tranMsg 			= ""
	CUST.LADISB.MTTErrDesc	= ""
	
	#------------------------------------------------------------------------------
	# Getting acctId code from front end
	#------------------------------------------------------------------------------
	sv_a = urhk_SRV_GetVal("acctDisburseTranLA.laAcct.foracid")
	CUST.LADISB.loanAcctId  = BANCS.OUTPARAM.srvValue
	print(CUST.LADISB.loanAcctId)
	
	sv_b = urhk_SRV_GetVal("acctDisburseTranLA.disburseAmt")
	CUST.LADISB.disbAmt             = BANCS.OUTPARAM.srvValue
	sv_a=getPosition(CUST.LADISB.disbAmt,"|")
	sv_b=strlen(CUST.LADISB.disbAmt)
	CUST.LADISB.disbAmt               =LEFT$(CUST.LADISB.disbAmt,sv_a-1)
	print(CUST.LADISB.disbAmt)
	
	sv_b = urhk_SRV_GetVal("acctDisburseTranLA.partTranLL.<rec_0>.tranRmks")
	CUST.LADISB.tranPart	= BANCS.OUTPARAM.srvValue
	print(CUST.LADISB.tranPart)
	
	sv_b = urhk_SRV_GetVal("acctDisburseTranLA.partTranLL.<rec_0>.oapRefNum")
	CUST.LADISB.cdsNumber	= BANCS.OUTPARAM.srvValue
	print(CUST.LADISB.cdsNumber)
	CUST.LADISB.cdsNumber = CUST.LADISB.tranPart
	
	sv_a=urhk_SRV_GetVal("acctDisburseTranLA.transferAcctNum.foracid")
	CUST.LADISB.crAcctId= BANCS.OUTPARAM.srvValue
	print (CUST.LADISB.crAcctId)
	#------------------------------------------------------------------------------
	# Exitscript if function code is Reversal
	#------------------------------------------------------------------------------
	sv_b = urhk_SRV_GetVal("acctDisburseTranLA.reversalTranId")
	CUST.LADISB.reversalTran = BANCS.OUTPARAM.srvValue
	print(CUST.LADISB.reversalTran)
	IF (CUST.LADISB.reversalTran != "") THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#------------------------------------------------------------------------------
	# Calling common script for common values
	#------------------------------------------------------------------------------
	print(CUST.LADISB.loanAcctId)
	CALL("laadisbdp004.scr")
	IF (CUST.LADISB.errMsg != "") THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	CUST.LADISB.stepVal="7"
	CALL("laadisbdp008.scr")
	IF (CUST.LADISB.errMsg != "") THEN
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF (CUST.LADISB.crAcctId != "") THEN
	#{
		sv_f = urhk_getAcctDetailsInRepository (CUST.LADISB.crAcctId)
		print(sv_f)
		IF (sv_f != 0) THEN
		#{
			CUST.LADISB.errMsg = "Credit Account Number is Invalid "
			GOTO ENDOFSCRIPT
			#}
		ELSE
			#{
			CUST.LADISB.crBacid = BANCS.OUTPARAM.acctPlaceHolder
			print(CUST.LADISB.crBacid)
		#}
		ENDIF
		#}
	ELSE
		#{
		CUST.LADISB.errMsg = " Please Enter the Credit A/c Id.. "
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	IF (CUST.LADISB.crBacid == CUST.CPARAM.bacid) THEN
	#{
		print("Safaricom IPO")
		CUST.LADISB.tranMsg = "Safaricom IPO"
		sv_a=getPosition(CUST.CPARAM.schmLst,"!" + CUST.LADISB.laSchmCode + "!")
		print(sv_a)
		IF (sv_a > 0) THEN
		#{
			print (CUST.LADISB.disbAmt)
			IF (CUST.LADISB.disbAmt!= "")  THEN
			#{
				IF ( CUST.LADISB.operAcctFlg != "Y" ) THEN
				#{
					CUST.LADISB.errMsg = "No Operative account Linked to Loan account"
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				
				CALL("laadisbdp006.scr")
				IF (CUST.LADISB.errMsg != "") THEN
				#{
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				print(CUST.LADISB.insuAmt)
				
				IF (CUST.LADISB.laSchmCode == CUST.CPARAM.schmCode) THEN
				#{
					CUST.LADISB.laceAmt 		= CUST.CPARAM.amt
					CUST.LADISB.lienAmt 		= CUST.CPARAM.amt
					CUST.LADISB.cdsAppliction 	= CUST.CPARAM.cdsApp
					#}
				ELSE
					#{
					CUST.LADISB.laceAmt = (CDOUBLE(CUST.LADISB.disbAmt)*CDOUBLE(CUST.CPARAM.mul))/100
					CUST.LADISB.lienAmt 		= CUST.CPARAM.lienAmt
					CUST.LADISB.cdsAppliction 	= CUST.CPARAM.cdsApp
				#}
				ENDIF
				
				CUST.LADISB.fees = CDOUBLE(CUST.LADISB.laceAmt)+CDOUBLE(CUST.LADISB.lienAmt)+CDOUBLE(CUST.LADISB.cdsAppliction)+CDOUBLE(CUST.LADISB.insuAmt)
				print(CUST.LADISB.fees)
				IF (CDOUBLE(CUST.LADISB.fees) > CDOUBLE(CUST.LADISB.operAcctEffBal)) THEN
				#{
					CUST.LADISB.errMsg = "Insufficent Funds in Operative account..Total Fees:  " + CUST.LADISB.fees
					GOTO ENDOFSCRIPT
				#}
				ENDIF
				
				#------------------------------------------------------------------
				#  Hardcoding the bacid
				#------------------------------------------------------------------
				IF (CINT(CUST.LADISB.laceAmt)!=0) THEN
				#{
					sv_b = CUST.CPARAM.laceSafsh
					sv_i = sv_b + "|" + BANCS.STDIN.homeCrncyCode + "|" + BANCS.STDIN.mySolId
					sv_u = urhk_B2k_BacidToAcctId(sv_i)
					IF (sv_u == 1 ) THEN
					#{
						CUST.LADISB.errMsg = "IPO Lace Collection A/C not set up "
						GOTO ENDOFSCRIPT
					#}
					ENDIF
					CUST.LADISB.CrLaceAcnt = BANCS.OUTPARAM.AcctId
					print(CUST.LADISB.CrLaceAcnt)
				#}
				ENDIF
				
				IF (CINT(CUST.LADISB.lienAmt)!=0) THEN
				#{
					CUST.LADISB.crLienAcnt = CUST.CPARAM.crLienAcct
					print(CUST.LADISB.crLienAcnt)
				#}
				ENDIF
				
				IF (CINT(CUST.LADISB.cdsAppliction)!=0) THEN
				#{
					sv_b = CUST.CPARAM.saffe
					sv_i = sv_b + "|" + BANCS.STDIN.homeCrncyCode + "|" + BANCS.STDIN.mySolId
					sv_u = urhk_B2k_BacidToAcctId(sv_i)
					IF (sv_u == 1 ) THEN
					#{
						CUST.LADISB.errMsg = "IPO CDS Application Fee Collection A/C not set up "
						GOTO ENDOFSCRIPT
					#}
					ENDIF
					CUST.LADISB.crApplicntAcnt = BANCS.OUTPARAM.AcctId
					print(CUST.LADISB.crApplicntAcnt)
				#}
				ENDIF
				
				IF (CINT(CUST.LADISB.insuAmt)!=0) THEN
				#{
					sv_b = CUST.CPARAM.safin
					sv_i = sv_b + "|" + BANCS.STDIN.homeCrncyCode + "|" + BANCS.STDIN.mySolId
					sv_u = urhk_B2k_BacidToAcctId(sv_i)
					IF (sv_u == 1 ) THEN
					#{
						CUST.LADISB.errMsg = "Insuarance A/C not set up "
						GOTO ENDOFSCRIPT
					#}
					ENDIF
					CUST.LADISB.crInsuaranceAcnt = BANCS.OUTPARAM.AcctId
					print(CUST.LADISB.crInsuaranceAcnt)
				#}
				ENDIF
				
				#--------------------------------------------------------------------------
				# Initialise the MTT repository
				#--------------------------------------------------------------------------
				
				sv_r = REPEXISTS("MTT")
				IF (sv_r == 0) THEN
				#{
					CREATEREP("MTT")
				#}
				ENDIF
				
				sv_r = CLASSEXISTS("MTT","TranDetails")
				IF (sv_r == 0) THEN
				#{
					CREATECLASS("MTT","TranDetails",5)
				#}
				ENDIF
				
				sv_r = REPEXISTS("BANCS")
				IF (sv_r == 0) THEN
				#{
					CREATEREP("BANCS")
				#}
				ENDIF
				
				sv_r = CLASSEXISTS("BANCS","INPARAM")
				IF (sv_r == 0) THEN
				#{
					CREATECLASS("BANCS","INPARAM",5)
				#}
				ENDIF
				
				BANCS.INPARAM.PostTranFlg 				= "Y"
				BANCS.INPARAM.InsertTranWithValidnFlg 	= "N"
				BANCS.INPARAM.CommitFlg					= "Y"
				BANCS.INPARAM.RestrictModifyInd			= "FOURTH_GROUP"
				
				BANCS.INPARAM.ErrorCheckForLuw	= "Y"
				BANCS.INPARAM.CheckExceptions	= "N"
				MTT.TranDetails.TranDate		= "0"
				MTT.TranDetails.TranType 		= "T"
				MTT.TranDetails.TranSubType 	= "CI"
				MTT.TranDetails.IgnoreExcp 		= "I"
				MTT.TranDetails.Consolidate 	= "N"
				MTT.TranDetails.Remarks 		= CUST.CPARAM.remarks
				
				sv_r = urhk_MTTS_Initialize("")
				print(sv_r)
				
				sv_v = "Safipo"
				print(sv_v)
				
				sv_u = urhk_MTTS_DefineTransaction("Safipo")
				
				sv_u = urhk_MTTS_PopulateInputDetails("")
				
				CUST.LADISB.totalamt=CDOUBLE(CUST.LADISB.laceAmt)+CDOUBLE(CUST.LADISB.lienAmt)+CDOUBLE(CUST.LADISB.cdsAppliction)+CDOUBLE(CUST.LADISB.insuAmt)
				print(CUST.LADISB.totalamt)
				
				IF (CDOUBLE(CUST.LADISB.laceAmt) != 0) THEN
				#{
					MTT.PartTranDetails.Account 		= CUST.LADISB.CrLaceAcnt
					MTT.PartTranDetails.RefCurrency 	= BANCS.STDIN.homeCrncyCode
					MTT.PartTranDetails.RateCode 		= CUST.CPARAM.rateCode
					MTT.PartTranDetails.Rate 			= "0"
					MTT.PartTranDetails.ValueDateDiff 	= "0"
					MTT.PartTranDetails.Particulars 	= CUST.CPARAM.part1
					MTT.PartTranDetails.RefAmount 		= CUST.LADISB.laceAmt
					print(MTT.PartTranDetails.RefAmount)
					MTT.PartTranDetails.Remarks 		= ""
					MTT.PartTranDetails.RefNum 			= CUST.LADISB.cdsNumber
					MTT.PartTranDetails.IgnoreExcp 		= "I"
					MTT.PartTranDetails.Consolidate 	= "N"
					MTT.PartTranDetails.TranIdentifier 	= sv_v
					sv_e = "Safeipo"
					sv_r = urhk_MTTS_definePartTran(sv_e)
					print(sv_r)
					IF(FIELDEXISTS(MTT.Error.Description)) THEN
					#{
						print(MTT.Error.Description)
						CUST.LADISB.MTTErrDesc = MTT.Error.Description
					#}
					ENDIF
				#}
				ENDIF
				
				
				IF (CDOUBLE(CUST.LADISB.lienAmt) != 0) THEN
				#{
					MTT.PartTranDetails.Account 		= CUST.LADISB.crLienAcnt
					MTT.PartTranDetails.RefCurrency 	= BANCS.STDIN.homeCrncyCode
					MTT.PartTranDetails.RateCode 		= CUST.CPARAM.rateCode
					MTT.PartTranDetails.Rate 			= "0"
					MTT.PartTranDetails.ValueDateDiff 	= "0"
					MTT.PartTranDetails.Particulars 	= CUST.CPARAM.part2
					MTT.PartTranDetails.RefAmount 		= CDOUBLE(CUST.LADISB.lienAmt)
					print(MTT.PartTranDetails.RefAmount)
					MTT.PartTranDetails.Remarks 		= ""
					MTT.PartTranDetails.RefNum 			= CUST.LADISB.cdsNumber
					MTT.PartTranDetails.IgnoreExcp 		= "I"
					MTT.PartTranDetails.Consolidate 	= "N"
					MTT.PartTranDetails.TranIdentifier 	= sv_v
					sv_e = "Safeipo"
					sv_r = urhk_MTTS_definePartTran(sv_e)
					print(sv_r)
					IF(FIELDEXISTS(MTT.Error.Description)) THEN
					#{
						print(MTT.Error.Description)
						CUST.LADISB.MTTErrDesc = MTT.Error.Description
					#}
					ENDIF
				#}
				ENDIF
				
				IF (CDOUBLE(CUST.LADISB.cdsAppliction) != 0 ) THEN
				#{
					MTT.PartTranDetails.Account 		= CUST.LADISB.crApplicntAcnt
					MTT.PartTranDetails.RefCurrency 	= BANCS.STDIN.homeCrncyCode
					MTT.PartTranDetails.RateCode 		= CUST.CPARAM.rateCode
					MTT.PartTranDetails.Rate 			= "0"
					MTT.PartTranDetails.ValueDateDiff 	= "0"
					MTT.PartTranDetails.Particulars 	= CUST.CPARAM.part3
					MTT.PartTranDetails.RefAmount 		= CDOUBLE(CUST.LADISB.cdsAppliction)
					print(MTT.PartTranDetails.RefAmount)
					MTT.PartTranDetails.Remarks 		= ""
					MTT.PartTranDetails.RefNum 			= CUST.LADISB.cdsNumber
					MTT.PartTranDetails.IgnoreExcp 		= "I"
					MTT.PartTranDetails.Consolidate 	= "N"
					MTT.PartTranDetails.TranIdentifier 	= sv_v
					sv_e = "Safeipo"
					sv_r = urhk_MTTS_definePartTran(sv_e)
					print(sv_r)
					IF(FIELDEXISTS(MTT.Error.Description)) THEN
					#{
						print(MTT.Error.Description)
						CUST.LADISB.MTTErrDesc = MTT.Error.Description
					#}
					ENDIF
				#}
				ENDIF
				
				IF (CDOUBLE(CUST.LADISB.insuAmt) != 0 ) THEN
				#{
					MTT.PartTranDetails.Account 		= CUST.LADISB.crInsuaranceAcnt
					MTT.PartTranDetails.RefCurrency 	= BANCS.STDIN.homeCrncyCode
					MTT.PartTranDetails.RateCode 		= CUST.CPARAM.rateCode
					MTT.PartTranDetails.Rate 			= "0"
					MTT.PartTranDetails.ValueDateDiff 	= "0"
					MTT.PartTranDetails.Particulars 	= CUST.CPARAM.part4
					MTT.PartTranDetails.RefAmount 		= CDOUBLE(CUST.LADISB.insuAmt)
					print(MTT.PartTranDetails.RefAmount)
					MTT.PartTranDetails.Remarks 		= ""
					MTT.PartTranDetails.RefNum 			= CUST.LADISB.cdsNumber
					MTT.PartTranDetails.IgnoreExcp 		= "I"
					MTT.PartTranDetails.Consolidate 	= "N"
					MTT.PartTranDetails.TranIdentifier 	= sv_v
					sv_e = "Safeipo"
					sv_r = urhk_MTTS_definePartTran(sv_e)
					print(sv_r)
					IF(FIELDEXISTS(MTT.Error.Description)) THEN
					#{
						print(MTT.Error.Description)
						CUST.LADISB.MTTErrDesc = MTT.Error.Description
					#}
					ENDIF
				#}
				ENDIF
				
				#------------------------------------------------------------------
				# Customer Debit Partran
				#------------------------------------------------------------------
				MTT.PartTranDetails.Account 		= CUST.LADISB.operAcctId
				MTT.PartTranDetails.RefCurrency 	= BANCS.STDIN.homeCrncyCode
				MTT.PartTranDetails.RateCode 		= CUST.CPARAM.rateCode
				MTT.PartTranDetails.Rate 			= "0"
				MTT.PartTranDetails.ValueDateDiff 	= "0"
				MTT.PartTranDetails.Particulars 	= CUST.CPARAM.part5
				sv_a = CDOUBLE(CUST.LADISB.totalamt)
				sv_a= -(sv_a)
				MTT.PartTranDetails.RefAmount 		= sv_a
				print(MTT.PartTranDetails.RefAmount)
				MTT.PartTranDetails.Remarks 		= ""
				MTT.PartTranDetails.RefNum 			= CUST.LADISB.cdsNumber
				MTT.PartTranDetails.IgnoreExcp 		= "I"
				MTT.PartTranDetails.Consolidate 	= "N"
				MTT.PartTranDetails.TranIdentifier 	= sv_v
				sv_h = "D" + CUST.LADISB.operAcctId
				sv_r = urhk_MTTS_definePartTran(sv_h)
				print(sv_r)
				IF(FIELDEXISTS(MTT.Error.Description)) THEN
				#{
					print(MTT.Error.Description)
					CUST.LADISB.MTTErrDesc = MTT.Error.Description
				#}
				ENDIF
				sv_u = urhk_MTTS_EndDefinition("")
				print(sv_u)
				IF(FIELDEXISTS(BANCS.OUTPARAM.MTTTranId)) THEN
				#{
					CUST.LADISB.tranid = BANCS.OUTPARAM.MTTTranId
					print(BANCS.OUTPARAM.MTTTranId)
				#}
				ENDIF
				sv_r = urhk_MTTS_Close("")
				print(sv_r)
				IF(FIELDEXISTS(BANCS.OUTPARAM.MTTTranId)) THEN
				#{
					CUST.LADISB.tranid = BANCS.OUTPARAM.MTTTranId
					print(BANCS.OUTPARAM.MTTTranId)
				#}
				ENDIF
				print(CUST.LADISB.tranid)
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	#-----------------------------------------------------------------------------------------------
	# Report file creation
	#-----------------------------------------------------------------------------------------------
	IF (CUST.LADISB.crBacid == CUST.CPARAM.bacid) THEN
	#{
		sv_a=getPosition(CUST.CPARAM.schmLst,"!" + CUST.LADISB.laSchmCode + "!")
		print(sv_a)
		IF (sv_a > 0) THEN
		#{
			sv_p = urhk_B2k_PID("")
			CUST.LADISB.pid = TRIM(BANCS.OUTPARAM.PID)
			print(CUST.LADISB.pid)
			CUST.LADISB.fileName = "LADISB"+ CUST.LADISB.pid +".log"
			print(CUST.LADISB.fileName)
			IF (CUST.LADISB.tranid != "") THEN
			#{
				sv_s= " SUCCESSFULL: " + CUST.LADISB.tranMsg + " transcation & charges collected successfully Transaction ID:"
				sv_s = sv_s +  CUST.LADISB.tranid
				ONS.CUSTOM.custDataOut = ONS.CUSTOM.custDataIn + "~ladisbres|"+CUST.LADISB.tranid+"|"+CUST.LADISB.tranMsg
				
				sv_c = "echo '" + CUST.LADISB.tranid + "' > LADTmpTran.txt"
				print(sv_c)
				sv_a = system(sv_c)
				print(sv_a)
				#}
			ELSE
				#{
				sv_s = "FAILED: " + CUST.LADISB.tranMsg + " transaction & charges were not posted...Proceed with manual intervention from Account"
				sv_s = sv_s + " " + CUST.LADISB.MTTErrDesc
				ONS.CUSTOM.custDataOut = ONS.CUSTOM.custDataIn + "~ladisbres|Charges not Collected|"+CUST.LADISB.tranMsg
				#ONS.CUSTOM.custDataOut = "~ladisbres|"+CUST.LADISB.tranid+"|"+CUST.LADISB.tranMsg
			#}
			ENDIF
			sv_s = "echo '" + sv_s + "' >"+CUST.LADISB.fileName
			print(sv_s)
			sv_a = system(sv_s)
			
			#--------------------------------------------------------------------------------------------------------------
			# For HPR Entry
			#--------------------------------------------------------------------------------------------------------------
			sv_s = "babx4040 ${B2K_SESSION_ID} "+CUST.LADISB.fileName+' '+'"'+"HLADISB Charges Report "+'"'+" MANAGER 1 N"
			print(sv_s)
			sv_a = system(sv_s)
		#}
		ENDIF
	#}
	ENDIF
	
	ENDOFSCRIPT:
		IF (CUST.LADISB.errMsg != "") THEN
		#{
			sv_a = urhk_SRV_SetErr(CUST.LADISB.errMsg)
			print(CUST.LADISB.errMsg)
		#}
		ENDIF
		
		IF(CUST.LADISB.MTTErrDesc != "" ) THEN
		#{
			#sv_a = urhk_SRV_SetErr(CUST.LADISB.MTTErrDesc)
			print(CUST.LADISB.MTTErrDesc)
		#}
		ENDIF
		
		EXITSCRIPT
END-->
