#DESC:             ACCOUNT TURNOVER REPORT
###################################################################
recordlayout
###################################################################
#__________________________________________________________________
####################################################################
sol_id  		stringtype
ACCT_NUM		numbertype
ACCT_NAME		stringtype	
jan_tot_dr_bal		numbertype
jan_tot_cr_bal		numbertype
feb_tot_dr_bal		numbertype
feb_tot_cr_bal		numbertype
mar_tot_dr_bal		numbertype
mar_tot_cr_bal		numbertype
apr_tot_dr_bal		numbertype
apr_tot_cr_bal		numbertype
may_tot_dr_bal		numbertype
may_tot_cr_bal		numbertype
jun_tot_dr_bal		numbertype
jun_tot_cr_bal		numbertype
jul_tot_dr_bal		numbertype
jul_tot_cr_bal		numbertype
aug_tot_dr_bal		numbertype
aug_tot_cr_bal		numbertype	
sep_tot_dr_bal		numbertype
sep_tot_cr_bal		numbertype
oct_tot_dr_bal		numbertype
oct_tot_cr_bal		numbertype
nov_tot_dr_bal		numbertype
nov_tot_cr_bal		numbertype	
dec_tot_dr_bal		numbertype	
dec_tot_cr_bal		numbertype

localvariables
######################################################
#localvariables are defined here
#####################################################################
jan_tot_dr		numbertype
jan_tot_cr		numbertype
feb_tot_dr		numbertype
feb_tot_cr		numbertype
mar_tot_dr		numbertype
mar_tot_cr		numbertype
apr_tot_dr		numbertype
apr_tot_cr		numbertype
may_tot_dr		numbertype
may_tot_cr		numbertype
jun_tot_dr		numbertype
jun_tot_cr		numbertype
jul_tot_dr		numbertype
jul_tot_cr		numbertype
aug_tot_dr		numbertype
aug_tot_cr		numbertype	
sep_tot_dr		numbertype
sep_tot_cr		numbertype
oct_tot_dr		numbertype
oct_tot_cr		numbertype
nov_tot_dr		numbertype
nov_tot_cr		numbertype	
dec_tot_dr		numbertype	
dec_tot_cr		numbertype
page_number      numberType
lv_setid       	 stringtype  
callscript       stringType
lv_setdesc	 stringType
lv_userId	 stringType 

groupandsort
#####################################################################
#   RECORDLAYOUT section.
####################################################################
sol_id  	ascending
ACCT_NUM	ascending

repository bankRepos.rip  
######################################################
bankname	stringtype
branchName      stringtype

REPOSITORY  argv4
#############################################################################
ipSetId				stringType
ipFrmDate			stringType
ipToDate			stringType
#
#############################################################################
#
#MASSAGERECORD
#############################################################################
#
#############################################################################
#
#IGNORERECORD
#############################################################################
#
#############################################################################

pageformat
####################################################################
####################################################################
linesperPage      65
columnsperline   280 
topMargin         0
bottomMargin      0
leftMargin        0
pageheaderlines  13
pagefooterlines   4

######################################################

onstartofreport
#####################################################

execute brBankHdg 
execute pageHdg

pageheader
###############################################################
execute brBankHdg 
execute pageHdg

###############################################################
PAGEFOOTER
###############################################################
separatorline
oneveryrecord
###############################################################

print ACCT_NUM column 3			
print ACCT_NAME	column 17
print jan_tot_dr_bal		column 40     format " ###,###,###.## "
print feb_tot_dr_bal		column 60     format " ###,###,###.## "
print mar_tot_dr_bal		column 80     format " ###,###,###.## "
print apr_tot_dr_bal		column 100    format " ###,###,###.## "
print may_tot_dr_bal		column 120    format " ###,###,###.## "
print jun_tot_dr_bal		column 140    format " ###,###,###.## "
print jul_tot_dr_bal		column 160    format " ###,###,###.## "
print aug_tot_dr_bal		column 180    format " ###,###,###.## " 
print sep_tot_dr_bal		column 200    format " ###,###,###.## "
print oct_tot_dr_bal		column 220    format " ###,###,###.## "
print nov_tot_dr_bal		column 240    format " ###,###,###.## "
print dec_tot_dr_bal		column 260    format " ###,###,###.## "
nextline
print jan_tot_cr_bal            column 40     format " ###,###,###.## "
print feb_tot_cr_bal            column 60     format " ###,###,###.## "
print mar_tot_cr_bal            column 80     format " ###,###,###.## "
print apr_tot_cr_bal            column 100    format " ###,###,###.## "
print may_tot_cr_bal            column 120    format " ###,###,###.## "
print jun_tot_cr_bal            column 140    format " ###,###,###.## "
print Jul_tot_cr_bal            column 160    format " ###,###,###.## "
print aug_tot_cr_bal            column 180    format " ###,###,###.## "
print sep_tot_cr_bal            column 200    format " ###,###,###.## "
print oct_tot_cr_bal            column 220    format " ###,###,###.## "
print nov_tot_cr_bal            column 240    format " ###,###,###.## "
print dec_tot_cr_bal            column 260    format " ###,###,###.## "

 
####################################################################
#beforebreakof 
####################################################################
BEFOREBREAKOF sol_id

print "Turnover for SOL" column 3
print sol_id column 18
nextline
nextline

###################################################################
#afterbreakof
##################################################################
afterbreakof sol_id
print "SOL totals:" column 3
set jan_tot_dr = groupsum jan_tot_dr_bal			
set jan_tot_cr = groupsum jan_tot_cr_bal		
set feb_tot_dr = groupsum feb_tot_dr_bal			
set feb_tot_cr = groupsum feb_tot_cr_bal			
set mar_tot_dr = groupsum mar_tot_dr_bal			
set mar_tot_cr = groupsum mar_tot_cr_bal			
set apr_tot_dr = groupsum apr_tot_dr_bal			
set apr_tot_cr = groupsum apr_tot_cr_bal			
set may_tot_dr = groupsum may_tot_dr_bal			
set may_tot_cr = groupsum may_tot_cr_bal			
set jun_tot_dr = groupsum jun_tot_dr_bal			
set jun_tot_cr = groupsum jun_tot_cr_bal			
set jul_tot_dr = groupsum jul_tot_dr_bal			
set jul_tot_cr = groupsum jul_tot_cr_bal			
set aug_tot_dr = groupsum aug_tot_dr_bal			
set aug_tot_cr = groupsum aug_tot_cr_bal			
set sep_tot_dr = groupsum sep_tot_dr_bal			
set sep_tot_cr = groupsum sep_tot_cr_bal			
set oct_tot_dr = groupsum oct_tot_dr_bal			
set oct_tot_cr = groupsum oct_tot_cr_bal			
set nov_tot_dr = groupsum nov_tot_dr_bal			
set nov_tot_cr = groupsum nov_tot_cr_bal			
set dec_tot_dr = groupsum dec_tot_dr_bal			
set dec_tot_cr = groupsum dec_tot_cr_bal			
print jan_tot_dr		column 40    format " ###,###,###.## " 
print feb_tot_dr		column 60    format " ###,###,###.## "
print mar_tot_dr		column 80    format " ###,###,###.## "
print apr_tot_dr		column 100   format " ###,###,###.## "
print may_tot_dr		column 120   format " ###,###,###.## "
print jun_tot_dr		column 140   format " ###,###,###.## "
print jul_tot_dr		column 160   format " ###,###,###.## "
print aug_tot_dr		column 180   format " ###,###,###.## "
print sep_tot_dr		column 200   format " ###,###,###.## "
print oct_tot_dr		column 220   format " ###,###,###.## "
print nov_tot_dr		column 240   format " ###,###,###.## "
print dec_tot_dr		column 260   format " ###,###,###.## "
separatorline
nextline
print jan_tot_cr               column 40    format " ###,###,###.## "
print feb_tot_cr               column 60    format " ###,###,###.## "
print mar_tot_cr               column 80    format " ###,###,###.## "
print apr_tot_cr               column 100   format " ###,###,###.## " 
print may_tot_cr               column 120   format " ###,###,###.## "
print jun_tot_cr               column 140   format " ###,###,###.## "
print jul_tot_cr               column 160   format " ###,###,###.## "
print aug_tot_cr               column 180   format " ###,###,###.## "
print sep_tot_cr               column 200   format " ###,###,###.## "  
print oct_tot_cr               column 220   format " ###,###,###.## "
print nov_tot_cr               column 240   format " ###,###,###.## "
print dec_tot_cr               column 260   format " ###,###,###.## "
nextline
separatorline
#################################################################
#
###############################################################
onendofreport
#############################################################################
#
#############################################################################

begin
    nextline
    nextline
    print "printed by:"  size  280 center 
    print  lv_userId
    nextline
    nextline
    nextline
    print "verified by:" size 280 center 
    nextline
    nextline
    nextline
    print "***************END OF REPORT******************" size 280 center 
end
############################################################################
#
#############################################################################
Procedure  pageHdg
##############################################################################
begin
nextline
	print "ACCOUNT TURNOVER REPORT  "  size  280 center 
	nextline
	nextline
	print " From   " column 125
	print ipFrmDate 
	print "  &  "
	print ipToDate
	nextline
	nextline
	end
begin
        separatorline
	print "ACCT_NUM" column 3
	print "ACCT_NAME" column 17
	print "Jan Debit " column 40
	print "Feb Debit" column 60
	print "Mar Debit" column 80
	print "Apr Debit" column 100
	print "May Debit" column 120
	print "Jun Debit" column 140
	print "Jul Debit" column 160
	print "Aug Debit" column 180
	print "Sep Debit" column 200
	print "Oct Debit" column 220
	print "Nov Debit" column 240
	print "Dec Debit" column 260
	nextline
        print "    Credit" column    40
	print "    Credit" column    60
	print "    Credit" column    80
	print "    Credit" column   100
	print "    Credit" column   120
	print "    Credit" column   140
	print "    Credit" column   160
	print "    Credit" column   180
	print "    Credit" column   200 
	print "    Credit" column   220
	print "    Credit" column   240
	print "    Credit" column   260
        separatorline
	nextline


end

PROCEDURE brBankHdg
#################################################################################

begin
print "Page No. "   column  170 
print page_number precision 0
nextline
print today column   170 
nextline
nextline
print "EQUITY BANK LIMITED"  size  280 center 
nextline
set lv_setid = ipsetId
set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
print lv_setdesc size 280 center 
nextline

end

