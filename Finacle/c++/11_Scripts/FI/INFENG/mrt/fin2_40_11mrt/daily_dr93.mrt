# ******************************************************************
#    Report Name		: OCT OUTWARD REPORT
#    Author     		: Erick G. Karobia 
#
# ******************************************************************
#
RECORDLAYOUT  
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
#	
####################################################################
tran_date	stringType
tran_id		stringType
tran_code	stringType	
dest_bank_code  stringtype
dest_branch_code stringType
dest_cust_acct   stringType
dest_cust_name   stringType
sol_id		stringType
tran_amt	numbertype

####################################################################
LOCALVARIABLES
####################################################################
#   MANDATORY SECTION (2nd Section)
#   Any Local Variable can be defined here
####################################################################
page_number         numberType
lv_setid	    stringType  
callscript          stringType
lv_setdesc	    stringType
lv_userId	    stringType 
stran_id	    numberType	
ttran_id	    numberType	
stran_amt	    numberType
ttran_amt           numberType

####################################################################
GROUPANDSORT
sol_id
####################################################################
#   MANDATORY SECTION (3rd Section)
#   This section tell how the input file is to be sorted
#   This has to be Third Section in the template file
#   This can be NULL If the input file is alread sorted
#   	Should contain only field names and the order in which they
#       to be sorted. All these fields should have been defined in 
#       RECORDLAYOUT section.
####################################################################
REPOSITORY bankRepos.rip readonly
 bankName		stringType
 branchName		stringType
###################################################################
REPOSITORY argv4
ipSetId				stringType
ipfrmdate			stringtype
iptodate			stringtype
####################################################################
IGNORERECORd
####################################################################
#
####################################################################

PAGEFORMAT
####################################################################
#   This section tell about the page Layout
#   Here the valid pageformat keywords are 
#   Linesperpage, Leftmargin, Rightmargin, Topmargin, Columnsperpage
####################################################################
widowOrphanLines   3
linesPerPage       70
leftMargin 	   2 
rightMargin	   2
topMargin	   6
bottomMargin	   2
columnsPerLine 	   150
pageHeaderLines	   8 
pageFooterLines	   2 
    
ONSTARTOFREPORT
####################################################################
#   This section will be executed only once during the processing of 
#		report. i.e. in the begining of the report
#   Here the valid statements are actions.
####################################################################
execute brBankHdg
execute pageHdr
set pagenumber=1

PAGEHEADER 
####################################################################
#   This section is called for and the actions which are
#        specified here are done as a part of header. The number
#        of lines printed in the header cannot exceed the value
#        pageHeaderLines specified in PageFormat Section
#   Here the valid statements are actions.
####################################################################
execute pageHdr
separatorline

PAGEFOOTER
####################################################################
#   This section is called for and the actions which are
#        specified here are done as a part of footer. The number
#        of lines prnted in the header cannot exceed the value
#        pageFooterLines specified in PageFormat Section
#   Here the valid statements are actions.
####################################################################
#
BEFOREBREAKOF sol_id
###################################################################
#BEFOREBREAKOF  
####################################################################
print "Transcations for Branch " column 1
print sol_id 
nexTline
#
#
#
AFTERBREAKOF sol_id
###################################################################
#
#afterbreakof 
####################################################################
nextline
set stran_id = groupcount tran_id
set stran_amt = groupsum tran_amt
separatorline 
nextline
print "Sub Total" column 1
print stran_id     column 30
print stran_amt size 20 autocomma precision 2  column 115
nextline
separatorline
nextline

ONEVERYRECORD 
####################################################################
#   Here the valid statements are actions.
####################################################################
execute printOneRecord

ONENDOFREPORT
####################################################################
#   This section will be executed only once during the processing of 
#		report. i.e. in the end of the report
#   Here the valid statements are actions.
####################################################################
nextline
set ttran_id=totalcount tran_id
set ttran_amt = totalsum tran_amt
if ttran_id = 0
begin
	print "********************   No Records Printed   ****************" size  130 center
	nextline
	nextline
	nextline
end
separatorline
print "Grand Total" column 1
print ttran_id     column 30
print ttran_amt size 20 autocomma precision 2  column 115
separatorline
set lv_setid = ipsetId
set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
print "Printed By:" column 1
print lv_userId column 20
nextline
nextline
print "Verified By:"
nextline
separatorline
######################################################################
#  Procedure Block
######################################################################

PROCEDURE pageHdr
separatorline
print "TRAN_DATE"  column 1
print "TRAN_ID"    column 18
print "DEST_BANK"    Column 28
print "DEST_BRANCH"      column 40
print "CUST_ACCT"    column 55
print "CUST_NAME"    column 80 
print "SOL_ID"     column 105
print "TRAN_AMT " column 120

separatorline

####################################################################
PROCEDURE printOneRecord
####################################################################
print TRAN_DATE       column 1
print TRAN_ID      column 15
print DEST_BANK_CODE   Column 30 
print DEST_BRANCH_CODE  column 40 
print DEST_CUST_ACCT    column 54 
set DEST_CUST_NAME=substr DEST_CUST_NAME,1,30
print DEST_CUST_NAME column  78
print SOL_ID      column 105
print TRAN_AMT    size 20 autocomma precision 2  column 115 

####################################################################
PROCEDURE brBankHdg

begin
        print "Page No. "   column 80
        print page_number precision 0
        nextline
        print today column 80
        nextline
        nextline
	print "EQUITY BANK LIMITED" size  130 center
	nextline
        set lv_setid = ipsetId
    	set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
        print lv_setdesc size 130 center
	nextline
	print "OCT ESC REPORT"  size 130 center
	nextline
	print "FROM DATE:   " column 40
	print ipfrmDate size 10
	print "   To Date:  " 
	print iptodate  
        nextline
        set page_number= page_number+1
        nextline
end
####################################################################
# End of File
######################################################################


