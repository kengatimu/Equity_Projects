# Template Name :		daily_dr43.mrt
# Description	:		Interest/Provision Report
# Author			E.G.KAROBIA, 16/09/05
# 
#########################################################################
RECORDLAYOUT
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
####################################################################
$$$include daily_dr43.mri
LOCALVARIABLES
###########################################################################
#
###########################################################################
page_number		        numberType
record_counter			numberType
date				stringType
lv_setid			stringType  
callscript			stringType
lv_setdesc			stringType
lv_userId			stringType 

tot_acct_name_cnt 		numberType
tot_clr_bal_amt			numberType
tot_total_arreas		numberType
tot_p_int_sus			numberType
tot_prov_int			numberType
tot_secu_value			numberType

grnd_acct_name_cnt 		numberType
grnd_clr_bal_amt		numberType
grnd_total_arreas		numberType
grnd_p_int_sus			numberType
grnd_prov_int			numberType
grnd_secu_value			numberType

#
GROUPANDSORT
schm_code ascending

PAGEFORMAT
#
linesperpage 60
columnsperline 174
pageheaderlines 8
topMargin  2
bottomMargin 2
#
REPOSITORY bankRepos.rip
bankName	    stringType
branchName	    stringType

REPOSITORY  argv4
ipSetId				stringType
ipFrmDate			stringType
#
#
ONSTARTOFREPORT
#
set page_number=1
set record_counter=0
execute header
execute printScheduleHeader
#
PAGEHEADER
	set page_number=page_number+1
	nextline
	execute header
	execute printScheduleHeader
#
IGNORERECORD
if total_arreas = 0 
#
ONENDOFREPORT
if (record_counter != 0)
begin
	execute printGrandTotals
end
else
begin
	execute printRecordNotExist
end
nextline
nextline
set lv_setid = ipsetId
set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
print "       Printed By:  " column 20
Print lv_userId
print "   " 
print today  
nextline
print "       Authorised Signatory (BRANCH)" column 20	
print "       Authorised Signatory"  column 77
nextline
nextline
nextline
print "       Signature" column 77
nextline
nextline
print "********************End Of Report*********************" column 70

BEFOREBREAKOF schm_code
    print "Product : " 
    print " "
    print schm_code     
    nextline
    nextline
#
AFTERBREAKOF schm_code
if (record_counter != 0)
begin
 execute printSubTotals
end
nextline
ONEVERYRECORD
begin
	set record_counter=record_counter+1
	execute printScheduleData
	nextline
end
#

##############################################################################
PROCEDURE printScheduleData
##############################################################################
begin
	print acct_num		  column 3
	execute pipe
	print acct_name		  column 21 
	execute pipe
	print clr_bal_amt	  column 48	format "#,###,###,###.##"
	execute pipe
	Print total_arreas	  column 66	format "#,###,###,###.##"
	execute pipe
	print p_int_sus		  column 83	format "#,###,###,###.##"
	execute pipe
	print prov_int		  column 101	format "#,###,###,###.##"
	execute pipe
	print security_type	  column 119
	execute pipe
	print secu_value	  column 137	format "#,###,###,###.##"
	execute pipe
	print Classfication	  column 160
	execute pipe
	nextline
end
#
##############################################################################
PROCEDURE printScheduleHeader
##############################################################################
begin
	separatorline
	print "A/c # "        column 7
	execute pipe
	print "A/c Name "     column 22 
	execute pipe
	print "O/s Amnt"       column 55 
	execute pipe
	Print "Tot.Arrears "   column 70 
	execute pipe
	print "Suspended Intrst"    column 85
	execute pipe
	print "Specific Prov."   column 106
	execute pipe
	print "Security Type"  column 123
	execute pipe
	print "Security Value " column 140
	execute pipe
	print "Classification"  column 157
	execute pipe
	separatorline
	
end 

PROCEDURE printGrandTotals
##############################################################################
begin
	separatorline
        print "Grand Total" column 3
	execute pipe
	set grnd_acct_name_cnt = totalcount acct_name
        set grnd_clr_bal_amt = totalsum clr_bal_amt
        set grnd_total_arreas = totalsum total_arreas
        set grnd_p_int_sus = totalsum p_int_sus
        set grnd_prov_int = totalsum prov_int
        set grnd_secu_value = totalsum secu_value
        execute pipe
	print grnd_acct_name_cnt    column  25
	execute pipe
	print grnd_clr_bal_amt 	    column 49	format "#,###,###,###.##"
	execute pipe
	Print grnd_total_arreas	    column 67	format "#,###,###,###.##"
	execute pipe
	print grnd_p_int_sus	    column 85	format "#,###,###,###.##"
	execute pipe
	print grnd_prov_int	    column 103	format "#,###,###,###.##"
	execute pipe
	print grnd_secu_value       column 139	format "#,###,###,###.##"
	execute pipe
	separatorline
end
PROCEDURE printSubTotals
##############################################################################
begin
	separatorline
	print "Subtotal" column 3 
        execute pipe
	set tot_acct_name_cnt = groupcount acct_name
        set tot_clr_bal_amt = groupsum clr_bal_amt
        set tot_total_arreas = groupsum total_arreas
        set tot_p_int_sus = groupsum p_int_sus
        set tot_prov_int = groupsum prov_int
        set tot_secu_value = groupsum secu_value

	print tot_acct_name_cnt   column  25
	execute pipe
	print tot_clr_bal_amt 	   column 49	format "#,###,###,###.##"
	execute pipe
	Print tot_total_arreas	  column 67	format "#,###,###,###.##"
	execute pipe
	print tot_p_int_sus	  column 85	format "#,###,###,###.##"
	execute pipe
	print tot_prov_int	column 103	format "#,###,###,###.##"
	execute pipe
	print tot_secu_value	column 139	format "#,###,###,###.##"
	execute pipe
	separatorline
	nextline
end
#############################################################################

PROCEDURE header
#############################################################################
begin 
	set date = substr today 1,10
	print bankName     column 70
	nextline
	print branchName column 66
	nextLine
	print "INTEREST SUSPENCE / PROVISION "  column 64
	nextline
	nextline
	print "AS AT :" column 64
	print "   "
	print date
	nextline
	nextline

end
##############################################################################
PROCEDURE pipe

begin

        print "|"               column 1
        print "|"               column 19 
        print "|"               column 48 
        print "|"               column 66
        print "|"               column 84
        print "|"               column 102
        print "|"               column 120
        print "|"               column 138
        print "|"               column 156
	print "|"               column 174 
end
##############################################################################
PROCEDURE printRecordNotExist
##############################################################################
begin
nextline
nextline
nextline
print "********** RECORDS DO NOT  EXIST **********" size 80 center column 70
nextline
nextline
nextline
separatorline
nextline
nextline
nextline
end
