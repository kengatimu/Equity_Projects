# ******************************************************************
#    Report Name		: INSTALMENT FALLING DUE REPORT
#    Author     		: Erick G. Karobia 
#
# ******************************************************************
#
RECORDLAYOUT  
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
#	
####################################################################
BRANCH_ID	 stringType
SCHM_CODE	 stringType
ACCT_NUM	 stringType
OPERATIVEACCT_NUM stringType
NEXTDEMANDDATE	 stringType
INSTALLMENT	 numbertypE
OST_BAL		 numbertype
DISBURSMENTDATE	 stringType
ACCT_NAME	 stringType

####################################################################
LOCALVARIABLES
####################################################################
#   MANDATORY SECTION (2nd Section)
#   Any Local Variable can be defined here
####################################################################
page_number         numberType
lv_setid	    stringType  
callscript          stringType
lv_setdesc	    stringType
lv_userId	    stringType 
sACCT_NUM	    numberType	
tACCT_NUM	    numberType	
sINSTALLMENT	    numberType
tINSTALLMENT        numberType
sOST_BAL	    numberType
tOST_BAL	    numberType


####################################################################
GROUPANDSORT
BRANCH_ID
####################################################################
#   MANDATORY SECTION (3rd Section)
#   This section tell how the input file is to be sorted
#   This has to be Third Section in the template file
#   This can be NULL If the input file is alread sorted
#   	Should contain only field names and the order in which they
#       to be sorted. All these fields should have been defined in 
#       RECORDLAYOUT section.
####################################################################
REPOSITORY bankRepos.rip readonly
 bankName		stringType
 branchName		stringType
###################################################################
REPOSITORY argv4
ipSetId				stringType
ipfrmdate			stringtype
iptodate			stringtype
####################################################################
IGNORERECORd
####################################################################
#
####################################################################

PAGEFORMAT
####################################################################
#   This section tell about the page Layout
#   Here the valid pageformat keywords are 
#   Linesperpage, Leftmargin, Rightmargin, Topmargin, Columnsperpage
####################################################################
widowOrphanLines   3
linesPerPage       70
leftMargin 	   2 
rightMargin	   2
topMargin	   6
bottomMargin	   2
columnsPerLine 	   150
pageHeaderLines	   8 
pageFooterLines	   2 
    
ONSTARTOFREPORT
####################################################################
#   This section will be executed only once during the processing of 
#		report. i.e. in the begining of the report
#   Here the valid statements are actions.
####################################################################
execute brBankHdg
execute pageHdr
set pagenumber=1

PAGEHEADER 
####################################################################
#   This section is called for and the actions which are
#        specified here are done as a part of header. The number
#        of lines printed in the header cannot exceed the value
#        pageHeaderLines specified in PageFormat Section
#   Here the valid statements are actions.
####################################################################
execute pageHdr

PAGEFOOTER
####################################################################
#   This section is called for and the actions which are
#        specified here are done as a part of footer. The number
#        of lines prnted in the header cannot exceed the value
#        pageFooterLines specified in PageFormat Section
#   Here the valid statements are actions.
####################################################################
#
BEFOREBREAKOF BRANCH_ID
###################################################################
#BEFOREBREAKOF  
####################################################################
print "Transcations for Branch " column 1
print BRANCH_ID
nexTline
#
#
#
AFTERBREAKOF BRANCH_ID
###################################################################
#
#afterbreakof 
####################################################################
nextline
set sACCT_NUM = groupcount ACCT_NUM
set sINSTALLMENT = groupsum INSTALLMENT
set sOST_BAL = groupsum OST_BAL
separatorline 
nextline
print "Sub Total" column 1
print sACCT_NUM   column 23
print sOST_BAL   size 20 autocomma precision 2 column 75 
print sINSTALLMENT size 20 autocomma precision 2   column 108
nextline
separatorline
nextline

ONEVERYRECORD 
####################################################################
#   Here the valid statements are actions.
####################################################################
execute printOneRecord

ONENDOFREPORT
####################################################################
#   This section will be executed only once during the processing of 
#		report. i.e. in the end of the report
#   Here the valid statements are actions.
####################################################################
nextline
set tACCT_NUM = totalcount ACCT_NUM
set tINSTALLMENT = totalsum INSTALLMENT
set tOST_BAL = totalsum OST_BAL
if tACCT_NUM = 0
begin
	print "********************   No Records Printed   ****************" size  115 center
	nextline
	nextline
	nextline
end
separatorline
print "Grand Total" column 1
print tACCT_NUM       column 23
print tOST_BAL size 20 autocomma precision 2    column 75 
print tINSTALLMENT size 20 autocomma precision 2  column 108
separatorline
print "Printed By:" column 1
print lv_userId column 20
nextline
nextline
print "Verified By:"
nextline

######################################################################
#  Procedure Block
######################################################################

PROCEDURE pageHdr
separatorline
print "SOL ID "       column 1
print "A/C NUMBER"    column 10
print "A/C NAME "     Column 25
print "SCHME CODE"    column 53
print "DIS_DATE"  column 65
print "O/S BAL"  column 82
print "NEXT DMD DATE" column 95
print "DMD AMOUNT"    column 114
print "OPERATIVE A/C" column 134
separatorline

####################################################################
PROCEDURE printOneRecord
####################################################################


print BRANCH_ID      column 1
print ACCT_NUM       column 8
print substr ACCT_NAME,1,30  Column 23
print SCHM_CODE     column 55
print DISBURSMENTDATE  column 65
print OST_BAL size 20 autocomma precision 2 column 75 
print NEXTDEMANDDATE column 97
print INSTALLMENT size 20 autocomma precision 2  column 108
print OPERATIVEACCT_NUM column 134

####################################################################
PROCEDURE brBankHdg

begin
        print "Page No. "   column 80
        print page_number precision 0
        nextline
        print today column 80
        nextline
        nextline
	print "EQUITY BANK LIMITED" size  115 center
	nextline
        set lv_setid = ipsetId
    	set callscript = runscript "header.scr" "lv_setid" "lv_setdesc|lv_userId"
        print lv_setdesc size 115 center
	nextline
	print "INSTALMENT DUE REPORT"  size 115 center
	nextline
	print "FROM DATE:   " column 40
	print ipfrmDate size 10
	print "  To Date:  " 
	print iptodate  
        nextline
        set page_number= page_number+1
        nextline
end
####################################################################
# End of File
######################################################################


