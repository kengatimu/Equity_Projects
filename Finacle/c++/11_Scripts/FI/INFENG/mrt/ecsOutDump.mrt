	        begin
	
set callscript = runscript "convforacid.scr" "RECORD_NO|numeric|user_reference_num|cust_acct|ECS_TRAN_REF_NO|dest_acc_type|dest_account_hldr_name|dest_acc_no|sponsor_bk_micr|user_reference_num|free_text_1|free_text_2|free_text_3|free_text_4|free_text_5|header_or_detail_flg|amount|b2k_type|trx_code" "lv_foracid|TXNCODE|refrencecode1|acct_name"
		
		print lpad lv_foracid 15 "0"              size 15             column  24
                        set lv_dest_micr_code = substr dest_micr_code 5,5
