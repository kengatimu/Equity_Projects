			print	"000000"			size 6	column	141
			print	"0000020"				size 7  column  147
			print   "00000"				size 5  column	154
			
			end
		if(numeric =42.000000)
			begin

				set callscript = runscript "convforacid.scr" "RECORD_NO|numeric|user_reference_num|cust_acct|ECS_TRAN_REF_NO|dest_acc_type|dest_account_hldr_name|dest_acc_no|sponsor_bk_micr|user_reference_num|free_text_1|free_text_2|free_text_3|free_text_4|free_text_5|header_or_detail_flg|amount|b2k_type|trx_code" "lv_foracid|refrencecode1|TXNCODE|acct_name" 
			
			print lpad lv_foracid 15 "0"              size 15             column  24
