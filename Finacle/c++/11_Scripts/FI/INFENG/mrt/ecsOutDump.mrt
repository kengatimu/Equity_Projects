                        set strTempDetail = lpad dest_acc_no 15 "0"
                        print strTempDetail               size 15             column  44
                        print "68"                      size 2             column 59
                        print sol_id                     size 3             column  61	
			print " PAYEE PAYMENT "			size 15 column  64
			print acct_name     			size 35 column  79
			print free_text_1			size 11 column  114
#			set free_text_3  =  stringToDate free_text_3
			print free_text_3   	  column  125
