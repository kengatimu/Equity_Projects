##############################################################################
#      Report Name      :  Office Account Ledger Report
#      Related form     :  bafe3033.bas
#      
#      Original Version : Rajul Johri
#      Date             : 13/06/96 
#
############################################################################

##############################################################################
RECORDLAYOUT
##############################################################################

$$$include acledger.mri

##############################################################################
LOCALVARIABLES
##############################################################################

    locbalance       numbertype
    locclsbalance    numbertype
    locfxbalance     numbertype
    loctotdramt      numbertype
    loctotcramt      numbertype
    loctotfxcramt    numbertype
    loctotfxdramt    numbertype
    locpgdramt       numbertype
    locpgcramt       numbertype
    locpgfxdramt     numbertype
    locpgfxcramt     numbertype
    locpgflg         numbertype
	loctranamt       numbertype
	locfxtranamt     numbertype
	lochdrflg	     numbertype


#############################################################################
GROUPANDSORT
#############################################################################
	 acctCrncyCode, acctnum, orderbydate, pstddate

#############################################################################
REPOSITORY bankRepos.rip readonly
#############################################################################
	bankName        stringtype
	branchName	    stringtype


############################################################################
REPOSITORY argv4
############################################################################

    report_to		      stringtype
	set_id			      stringtype
	set_id_desc			  stringtype
	gl_sub_head_code      stringtype
	acct_num_beg          stringtype
    acct_num_end          stringtype
	crncy_code			  stringtype
	crncy_code_desc       stringtype
    date_beg        	  stringtype
    date_end         	  stringtype
	page_number           numbertype
	acct_label			  stringtype
	cls_opn_flg		      stringtype


############################################################################
MASSAGERECORD
############################################################################

############################################################################
IGNORERECORD
############################################################################

############################################################################
PAGEFORMAT
############################################################################

	widowOrphanLines 2
	LinesPerPage 66
    LeftMargin 1
    RightMargin 1
    TopMargin 2
    BottomMargin 2
    columnsPerLine 240
    pageHeaderLines  12
	pageFooterLines  4 
   

############################################################################
ONSTARTOFREPORT
############################################################################
	execute printCriteria
    set pageNumber = 1
    set locpgflg   = 0


############################################################################
BEFOREBREAKOF  acctnum
############################################################################

    set lochdrflg = 0     
	nextpage
    set locbalance = opbalance
	set locfxbalance = locfxbalance
	set locpgflg = 1
    set loctotcramt = 0
    set loctotdramt = 0
    set loctotfxcramt = 0
    set loctotfxdramt = 0

############################################################################
AFTERBREAKOF acctnum
############################################################################

	if groupCount acctnum = 1
	begin
		nextLine
		nextLine
		nextLine
		print "No transactions for this period" column 20
		nextLine
		nextLine
		nextLine
	end
	set locpgflg = 0
	nextline
	execute printpgfooter
	nextline
	nextline
	print "Closing Balance    :"        column 28
	print abs locclsbalance autocomma size 20  column 55 
	print locclsbalance format "$$"	
	nextline
	nextline
	print "Total Credit       :" 				column 28
	if (crncycode != "")
	begin
		print acctCrncyCode                     			column 50           
       	print loctotcramt autocomma size 20  column 55 
	   	print crncycode 						 			column 85
	   	print loctotfxcramt autocomma size 20  column 90 
    end
	else
	begin
    	print loctotcramt autocomma size 20  column 55 
	end
    nextline
    print "Total Debit        :  " 							column 28
	set loctotdramt = -loctotdramt
	if (crncycode != "")
	begin
		print acctCrncyCode 								column 50
    	print loctotdramt autocomma size 20  column 55 
	   	print crncycode 									column 85
	   	set loctotfxdramt = -loctotfxdramt
	   	print loctotfxdramt autocomma size 20  column 90 
    end
	else
	begin
    	print loctotdramt autocomma size 20  column 55 
	end
    nextline
	nextline
	print "Signature          :  "                			column 28
	set locbalance = 0

############################################################################
ONEVERYRECORD
############################################################################
	if (headdetflg != "H")
	begin	
		print substr gldate,1,6 								column 1
		print substr gldate,7,4
		print tranid 											column 12
#     print ref_num		column 22
		print particulars 	column 22
   		if (tranamt < 0)
		begin
      		set loctranamt = -tranamt
    		print loctranamt autocomma size 20  column 63 
    		set loctotdramt = loctotdramt + tranamt
    		set locpgdramt  = locpgdramt + tranamt
    		set locbalance  = locbalance + tranamt
 		end
   		else
   		begin
    		print tranamt autocomma size 20  column 84 
    		set loctotcramt = loctotcramt + tranamt
    		set locpgcramt  = locpgcramt + tranamt
    		set locbalance   = locbalance + tranamt
		end

		print abs locbalance column 109 autocomma size 20  
		print locbalance format "$$"	
		nextline
   		if (crncycode != "") 
		begin
			if (fxtranamt < 0)
			begin
       			set locfxtranamt = -fxtranamt
    			print locfxtranamt autocomma size 12  column 63 
				print crncycode column 105
    			set loctotfxdramt = loctotfxdramt + fxtranamt
    			set locpgfxdramt  = locpgfxdramt + fxtranamt
    			set locfxbalance  = locfxbalance + fxtranamt
  			end
   			else
    		begin
	   			print fxtranamt autocomma size 12  column 84 
				print crncycode column 105
	   			set loctotfxcramt = loctotfxcramt + fxtranamt
	   			set locpgfxcramt  = locpgfxcramt +  fxtranamt
	   			set locfxbalance   = locfxbalance + fxtranamt
	  		end
			print abs locfxbalance column 109 autocomma size 20  
			print locfxbalance format "$$"    
			print remarks column 137
			nextline
		end 		
	end
	set locclsbalance = locbalance
	
#############################################################################
PAGEHEADER
#############################################################################

    print "Page " column 123
    print pageNumber format "##"
	execute bankBrline 
	set lochdrflg = 1
    execute printpghdr


#############################################################################
PAGEFOOTER
#############################################################################

    if (locpgflg != 0)   
    begin
		execute printpgfooter
    end
    set locpgcramt = 0
    set locpgdramt = 0
    set locpgfxcramt = 0
    set locpgfxdramt = 0 


############################################################################
ONENDOFREPORT
############################################################################

    nextline
    nextline
    print "Signature"  column 115    
    nextline
	print "*************" column 40
    print pageNumber format "###"
    print "  pages printed. End of Report*************"  
    set page_number = pageNumber

#############################################################################
PROCEDURE bankBrline
#############################################################################
	print today column 1
    print bankName column 43
	print " "
    print branchName
    nextline  
    nextline
	print "REP14"
    print "Account Ledger Report from " column 36
    print substr date_beg,1,10
    print " to "
    print substr date_end,1,10 
    nextline
    nextline
	print "Service OutLet   : "
	print solId
	print "   "
	print solDesc
	nextline
    print "Account No       :"
	print acctNum   column 20 size 16
	print acctCrncyCode column 38 size 3
    print acctName  column 42
    nextline
    print "Gl Sub Head Code :"
    print glsubheadcode column 20
    print gl_sub_head_code_desc column 42
	nextline
	if (lochdrflg = 0)
	begin
   		print "Opening Balance  : "
		if (crncycode != "")
		begin
			print acctCrncyCode
  			print abs opbalance autocomma size 15  column 35 
  			print opbalance format "$$"
			print crncycode  column 60
			print abs fxopbalance autocomma size 15  column 70 
			print fxopbalance format "$$"	
		end
		else
		begin	
  			print abs opbalance autocomma size 15  
  			print opbalance format "$$"	
		end
	end	
	else
	begin
		print "B/F Balance      :"             
		print abs locclsbalance autocomma size 20  column 25
		print locclsbalance format "$$"
	end
	nextline

#############################################################################
PROCEDURE printpghdr
#############################################################################

	separatorline
	print "Tran" column 2
	print "Tran" column 12
#    print "Ref Num" column 21  
	print "Particulars" column 42
	print "Transaction" column 65
	print "Transaction" column 86
    print "Crncy" column 103
	print "Balance" column 115
    print "Remarks" column 135 
	nextline
	print "Date" column 2
	print "Id" column 12
	print "Debit Amount" column 65 
	print "Credit Amount" column 86
    print "Code" column 103
	separatorline
    nextline

#############################################################################
PROCEDURE printCriteria
#############################################################################

    print today
	print bankName column 35
	print ", "
	print branchName
    print "Page " column 123
    print pageNumber format "##"
	nextline
	nextline
	print "REP14"
	print "Account Ledger Print"  column 40
	nextline
	nextline
	print "Report To          : "
	print report_to
	nextline
	print "Service OutLet Set : "
	print set_id
	print "    "
    print set_id_desc 
	nextline
	print "Gl Sub Head Code   : "
	print gl_sub_head_code 
	print "    "
	print gl_sub_head_code_desc
    nextline
	print "Acct Range         : "
	print acct_num_beg
	print "  to  "
	print acct_num_end
	nextline
	print "Open/Closed A/c (O/C) : "
	print cls_opn_flg
	nextline
	print "Currency Code      : "
	print crncy_code  
	print "     "
	print crncy_code_desc
	nextline
	print "Period             : "
	print substr date_beg,1,10
	print " to "
	print substr date_end,1,10
	nextline
	print "Account Label Code : "
	print acct_label  
	nextline

	
 
##############################################################################
PROCEDURE printpgfooter
##############################################################################

   	separatorline
	if (crncycode != "")
	begin
		print "Page Total Credit  :  " column 28
		print acctCrncyCode  column 50
   		print locpgcramt autocomma size 20  column 55 
		print crncycode  column 85
		print locpgfxcramt autocomma size 20  column 90 
   		nextline
   		print "Page Total Debit   :  " column 28
		print acctCrncyCode   column 50
		set locpgdramt = -locpgdramt
		set locpgfxdramt = -locpgfxdramt
   		print locpgdramt autocomma size 20  column 55 
		print crncycode  column 85
		print locpgfxdramt autocomma size 20  column 90 
	end
	else
	begin
		print "Page Total Credit  :  " column 28
   		print locpgcramt autocomma size 20  column 55 
   		nextline
   		print "Page Total Debit   :  " column 28
		set locpgdramt = -locpgdramt
   		print locpgdramt autocomma size 20  column 55 
	end
