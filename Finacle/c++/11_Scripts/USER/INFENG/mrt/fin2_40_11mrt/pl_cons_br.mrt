#***************************************************************************************
RECORDLAYOUT
#***************************************************************************************
sol_id 		stringType
gl60		numberType
gl62		numberType
gl65		numberType
gl67		numberType
gl80		numberType
gl81		numberType
gl82		numberType
gl83		numberType
#---------------------------------------------------------------------------------------
#***************************************************************************************
LOCALVARIABLES
#***************************************************************************************
totinc		numberType
totexp		numberType
netinc		numberType
#***************************************************************************************
GROUPANDSORT
#***************************************************************************************
#**************************************************************************************
#REPOSITORY bankRepos.rip
#*************************************************************************************
#bankName        stringType
#branchName      stringtype
#***************************************************************************************
REPOSITORY argv4
#setId          stringtype
asondate       stringType
#***************************************************************************************
ONSTARTOFREPORT
#***************************************************************************************
execute header
execute pageHdg
#***************************************************************************************
PAGEFORMAT
#***************************************************************************************
linesperPage   55
columnsperline 255 
topMargin      0
bottomMargin     0
leftMargin       0
pageheaderlines 13
pagefooterlines 4
#---------------------------------------------------------------------------------------
#***************************************************************************************
PAGEHEADER
#***************************************************************************************
execute header
execute pageHdg
#***************************************************************************************
PAGEFOOTER
#**************************************************************************************
#**************************************************************************************
#***************************************************************************************
ONEVERYRECORD
#***************************************************************************************
begin
execute pipe
set totinc = gl60 + gl62 + gl65 + gl67
set totexp = gl80 + gl81 + gl82 + gl83
set netinc = totinc - totexp
print sol_id column 3
print gl60   column 15 size 19 rightjustify 
print gl62   column 36 size 19 rightjustify 
print gl65   column 58 size 19 rightjustify 
print gl67   column 80 size 19 rightjustify 
print totinc  column 102 size 19 rightjustify
print gl80   column 124 size 19 rightjustify 
print gl81   column 146 size 19 rightjustify 
print gl82   column 166 size 19 rightjustify 
print gl83   column 188 size 19 rightjustify 
print totexp column 211 size 19 rightjustify
print netinc column 232 size 21 rightjustify
end
#***************************************************************************************
PROCEDURE header
#***************************************************************************************
begin
nextline
nextline
print "EQUITY BANK LIMITED" column 25
nextline
print "CONSOLIDATED BRANCHWISE" column 25
nextline
print "PROFIT & LOSS STATEMENT" column 25
nextline
print "AS AT:" column 25
print asondate  column 33
end
#---------------------------------------------------------------------------------------
PROCEDURE pageHdg
#***************************************************************************************
begin
nextline
nextline
separatorline
execute pipe
print "FOREX" column 36 size 20 center
print "COMMISSIONS" column 58 size 20 center
print "OTHER" column 80 size 20 center
print "TOTAL" column 102 size 20 center
print "INTEREST" column 124  size 20 center
print "MANAGEMENT" column 146 size 18 center
print "TOTAL" column 212 size 18 center 
print "NET" column 232 size 20 center
nextline
execute pipe
print "(gl TOTALS)" column 2
print "INTEREST INCOME" column 15
print "INCOMES" column 36 size 20 center
print "INCOMES" column 58 size 20 center
print "INCOMES" column 80 size 20 center
print "INCOMES" column 102 size 20 center
print "EXPENSE" column 124 size 18 center
print "EXPENSE" column 146 size 18 center
print "DEPRECIATION"  column 166 size 20 center
print "PROVISIONS" column 188 size 20 center
print "EXPENSES" column 212  size 19 center  	 
print "INCOME" column 232 size 20 center 
nextline
execute pipe
print "BRANCH" column 2 size 10 center 
print "GL 60" column 15 size 20 center 
print "GL 62" column 36 size 20 center 
print "GL 65" column 58 size 20 center 
print "GL 67" column 80 size 20 center 
print "GL 80" column 124 size 20 center 
print "GL 81" column 146 size 18 center 
print "GL 82" column 166 size 20 center 
print "GL 83" column 188 size 20 center 
separatorline
end
#****************************************************************************************
PROCEDURE pipe

begin
	print "|" column 1
	print "|" column 14 
	print "|" column 35
	print "|" column 57
	print "|" column 79
	print "|" column 101
	print "|" column 123
	print "|" column 145
	print "|" column 165
	print "|" column 187
	print "|" column 210
	print "|" column 231
	print "|" column 254
end
#**************************************************************************************
ONENDOFREPORT
