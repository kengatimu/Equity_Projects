#  This is the Mahareport for Balance Sheet Consolidated 
###############################################################################
RECORDLAYOUT
###############################################################################
acct_name				    stringtype
hom_cny                                      numbertype
gl_sub_head_code	                     numbertype 
gl_code                                      numbertype
################################################################################
LOCALVARIABLES
###############################################################################
callscript    			               stringType
lv_setid       				       stringType  
lv_setdesc    				       stringType
total						numbertype
flag 						numbertype
flag1                                            numbertype
flag2                                            numbertype
flag3                                            numbertype
flag4                                            numbertype
flag5                                            numbertype
flag6                                            numbertype
flag7                                            numbertype
flag8                                            numbertype
flag9                                            numbertype
flag10                                            numbertype
flag11                                           numbertype
flag12                                            numbertype
flag13                                            numbertype
flag14                                            numbertype
flag15                                            numbertype
flag16                                            numbertype
flag17                                            numbertype
flag18                                            numbertype
flag19                                            numbertype
flag20                                            numbertype
flag21                                            numbertype
flag22                                            numbertype
flag23						  numbertype
flag24                                            numbertype
flag25						  numbertype 
################################################################################
GROUPANDSORT
###############################################################################
gl_code,gl_sub_head_code
#**************************************************************************************
REPOSITORY bankRepos.rip
#*************************************************************************************
bankName        stringType
branchName      stringtype
#***************************************************************************************
REPOSITORY argv4
setId           stringtype
asondate        stringType
############################################################################
#IGNORERECORD
###########################################################################
###############################################################################
PAGEFORMAT
##############################################################################
ColumnsPerLine   84 
LinesPerPage     55 
LeftMargin       00
RightMargin      00
Topmargin        01
BottomMargin     02
pageHeaderLines  01
pageFooterLines  02
###############################################################################
ONSTARTOFREPORT
###############################################################################
Begin
nextline
nextline
print "EQUITY BANK LIMITED"  column 1 size 80 center
nextline
print  "Branch: "   column 1 size 80 center
set lv_setid = setId
set callscript = runscript "header.scr" "lv_setid" "lv_setdesc"
print lv_setdesc   column 1 size 80 center  
nextline
nextline
print   "Balance Sheet Summary"  column 1 size 80 center  
nextline
nextline
print asondate column 1 size 80 center   
nextline
nextline
separatorline 
print "Particulars"  column 09
print "Balance (SSP)" column 70 
separatorline
print "ASSETS"		column 09
separatorline
set total   = 0      
set flag = 0        
set flag1 = 0 
set flag2 = 0 
set flag3 = 0 
set flag4 = 0 
set flag5 = 0 
set flag6 = 0 
set flag7 = 0 
set flag8 = 0 
set flag9 = 0 
set flag10 = 0 
set flag11 = 0 
set flag12 = 0 
set flag13 = 0 
set flag14 = 0      
set flag15 = 0 
set flag16 = 0 
set flag17 = 0 
set flag18 = 0 
set flag19 = 0 
set flag20 = 0 
set flag21 = 0 
set flag22 = 0 
set flag23 = 0
set flag24 = 0
set flag25 = 0
end
#############################################################################
AFTERBREAKOF gl_sub_head_code 
#############################################################################
execute afterBreakof
#############################################################################
ONEVERYRECORD
#############################################################################
set total = total + hom_cny
if (flag23 = 0)
begin
        if(gl_code = 80)
        begin
                separatorline
                print "TOTAL INCOME" column 03
                print total column 63 size 20 autocomma precision 2
                separatorline
                nextline
                separatorline
                print "COSTS" column 03
                separatorline

		set flag23 = 1
        end
end

###############################################################################
ONENDOFREPORT
###############################################################################
begin
nextline
separatorline
print   "Profit & Loss"   column 03
print total  column 63 size 20 autocomma precision 2
separatorline
end
##############################################################################
PROCEDURE afterBreakof
###############################################################################
begin
print acct_name column 03
print groupSum hom_cny column 63 size 20 autocomma precision 2
end
