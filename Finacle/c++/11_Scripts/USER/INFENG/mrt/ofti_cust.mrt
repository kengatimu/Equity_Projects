RECORDLAYOUT  
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
####################################################################
foracid 	stringType
crncy_code	stringType
type		stringType
sub_type	stringType
ac_name		stringType
tran_date	stringType
inst_num	stringType
usr_name	stringType
tran_amt	numberType
tranparticulars stringType
branch		stringType
ratecode	stringType
rate		numberType
remarks         stringType
amount		numberType
fx_crncy	stringType
LOCALVARIABLES
####################################################################
#   MANDATORY SECTION (2nd Section)
#   Any Local Variable can be defined here
####################################################################
sumTotal	numberType
amtInWords  stringType
amtlen			numberType
amtlen1			numberType
amtlen2			numberType
amtStr			stringType
amtStr2			stringType
amtStr3			stringType
endofrecord		numberType
date			stringType

GROUPANDSORT
####################################################################
#   MANDATORY SECTION (3rd Section)
#   This section tell how the input file is to be sorted
#   This has to be Third Section in the template file
#   This can be NULL If the input file is alread sorted
#   	Should contain only field names and the order in which they
#       to be sorted. All these fields should have been defined in 
#       RECORDLAYOUT section.
####################################################################
foracid

REPOSITORY bankRepos.rip
############################################################################
bankName        stringType
branchName      stringtype
#REPOSITORY  argv4
#############################################################################
#
#   REPOSITORY (Optional Section) - Fixed-Type Repository.
#   This section tells about the Repository Information. A  Repository  is  a
#   File with Some Named Fields and Values  for those Fields. A  Repository's
#   Field Values can be used in the Template File, also a Repository's Fields
#   can be Set from the Template File. For either kind of use, the Repository
#   must be defined with its Fields description and Type. Here also the field
#   Types can be "stringType" or "numberType" Only.If a Repository is defined
#   in  ReadOnly Mode, its fields cannot be Modified or cannot be set.
#
#############################################################################
#solid                           stringType
#Fromdate                        stringtype
#todate                          stringType

IGNORERECORD
	
PAGEFORMAT
####################################################################
#   This section tell about the page Layout
#   Here the valid pageformat keywords are 
#   Linesperpage, Leftmargin, Rightmargin, Topmargin, Columnsperpage
####################################################################
LinesPerPage 45
LeftMargin 1 
rightMargin 1	
Topmargin	1
BottomMargin 1
columnsPerLine 55
pageHeaderLines	0
pageFooterLines 1

ONSTARTOFREPORT
set date = today


PAGEHEADER 
####################################################################
#   This section is called for and the actions which are
#        specified here are done as a part of header. The number
#        of lines printed in the header cannot exceed the value
#        pageHeaderLines specified in PageFormat Section
#   Here the valid statements are actions.
####################################################################

#execute page_hdr

PAGEFOOTER
####################################################################
#   This section is called for and the actions which are
#        specified here are done as a part of footer. The number
#        of lines prnted in the header cannot exceed the value
#        pageFooterLines specified in PageFormat Section
#   Here the valid statements are actions.
####################################################################

execute page_footer

ONEVERYRECORD 
####################################################################
#   Here the valid statements are actions.
####################################################################
execute page_hdr
execute tran_details
	
	
ONENDOFREPORT	
####################################################################
#   ONENDOFREPORT (Optional Section).
#   This Section  will be  executed  Only  Once  during the Processing of the
#   the Report (i.e in the  end  of the Report). Here  the  valid  statements
#   are actions only. Actions Statements Key-words are (or they begin with):-
#   NextPage, NextLine, SeparatorLine, Print, Accept, Display, Set, Begin,End
#   If, Else, execute, DontFlushAfterSection.
####################################################################
if sub_type = "NP"  OR sub_type = "CP" OR sub_type = "CI"
	begin
     	 nextline 
	 nextline
	 print "To the debit of my or our account"
	 nextline
	 nextline
         print "CUSTOMER SIGNATURE :________________" column 1
	 nextline
	 nextline
	 print "AUTHORISED BY :____________________" column 1
	 nextline
	 nextline
	 print "THANK YOU FOR YOUR CONTINUED SUPPORT" column 1
	 nextline
	 nextline
	 print "YOU WERE SERVED BY :" column 1
	 print " "
	 print usr_name
	 nextline
#	 nextline
#	 print "Sdg 1.5/- Stamp Duty Paid" column 1
#	 nextline
#        print "for withdrawal above 40/-"
	 end

######################################################################
#  PROCEDURE BLOCK
######################################################################

PROCEDURE page_hdr
if (pagenumber = 1) 
begin
	if(postEmailInd = "EMAIL")
	begin
    	print "REPORT!MAILID#"
		nextline
	end
end
print "EQUITY BANK LTD" size 40 center 
nextline
print "SOUTHERN SUDAN" size 40 center 
nextline
print branch size 40 center
nextline
IF Sub_Type ="CI"
begin
 print "FUNDS TRANSFER" size 40 center
end
Else
begin
if Sub_Type = "NR" or  Sub_Type = "CR"

	print "CASH DEPOSIT" size 40 center
else
	print "CASH WITHDRAWAL" size 40 center
end
nextline

##############################################################################
PROCEDURE tran_details
	print "SECURITY NO:" column 1
	print " " 
	nextline
	nextline
	print "DATE       :" column 1
	print today size 10
	nextline
	nextline
	print "TIME       :" column 1
	set date=splitstring date 12, 8
	print date
	nextline
	nextline
	print "ACCOUNT NO :" column 1
	print foracid 
	nextline
	nextline
	print "NAME: " column 1
	print ac_name 
	nextline
	nextline
	if sub_type = "NP"
         begin
	 print "CHEQUE NO: " column 1
	 print " "
	 print inst_num
	  nextline
	  nextline
	 end
	 print "REMARKS: " column 1 
	print tranparticulars size 24 
	nextline
	nextline
	if sub_type = "NR"
         begin
	 print "Deposited the sum of " column 1
	  nextline
	  nextline
	 end
	 if sub_type = "CI"
         begin
	 print "Transfered the sum of " column 1
	  nextline
	  nextline
	 end
	else
	 begin
	 print "Received the sum of " column 1
	  nextline
	  nextline
	end
	print "AMOUNT:" column 1
	print tran_amt autocomma size 20 
	print " "
	print crncy_code 
	print "AMOUNT:" column 1
	print tran_amt autocomma size 20 
	print " "
	print crncy_code	
	print "AMOUNT:" column 1
	print tran_amt autocomma size 20 
	print " "
	print crncy_code
	nextLine
	nextline
	set amtInWords = numTOWords tran_amt
	set amtlen = strlen amtInWords
	set amtStr = splitstring amtInWords 1 55
	set amtlen1 = strlen amtStr
	execute print_amount_in_words
	set amtlen1 = amtlen1 + 1
	set amtStr = splitstring amtInWords amtlen1 55
	set amtlen2 = strlen amtStr
	set amtlen1 = amtlen1 + amtlen2
	if (amtlen2 != 0)
	begin
		execute print_amount_in_words
	end
	set amtStr = splitstring amtInWords amtlen1 55
	set amtlen2 = strlen amtStr
	set amtlen1 = amtlen1 + amtlen2
	if (amtlen2 != 0)
	begin
		execute print_amount_in_words
	end
##############################################################################
PROCEDURE page_footer

if ( endofrecord = 1)
begin
    print "!"
    print "#"
	set endofrecord = 0
end
##############################################################################

##############################################################################
# PROCEDURE print_amount_in_words 
##############################################################################
PROCEDURE print_amount_in_words
begin
	print amtStr column 1
   if (amtlen1 >= amtlen)
	begin
		print "Only."
	end
	nextLine
end
