# ******************************************************************
#    Advice name              :      out_rej_adv.mrt
#
#    Modification Log   :
#    Sr.no.  Date        Author      Description
#    ------  --------    ------      ----------------
#    1.0     20/6/96     Ashish      Original Version
#
# ****************************************************************** 

RECORDLAYOUT
####################################################################
#   MANDATORY SECTION (1st Section)
#   This section tell the record layout of the input ASCII file
#   This has to be First Section in the template file
####################################################################    
$$$include out_rej.mri

LOCALVARIABLES
####################################################################
#   MANDATORY SECTION (2nd Section)
#   Any Local Variable can be defined here
####################################################################
		date stringType
		iprej1 numbertype
		iprej2 numbertype
		iprej3 numbertype
		iprej4 numbertype
		iprej5 numbertype
GROUPANDSORT    
####################################################################
#   MANDATORY SECTION (3rd Section)
#   This section tell how the input file is to be sorted
####################################################################
		recZoneDate	
		recZoneCode

PAGEFORMAT
####################################################################
#   This section tell about the page Layout
####################################################################
		widowOrphanLines 2
  		LinesPerPage 50
  		Topmargin   0
  		BottomMargin 2
  		columnsPerLine 80 
  		pageHeaderLines 10
  		pageFooterLines 4
  
REPOSITORY bankRepos.rip
  		bankName        			stringType
  		branchName      			stringType

REPOSITORY argv4
  	PAGE_NUMBER    	numberType
	reportTo		stringType
	asOnDate		stringType
	bacid			stringType
	brCode			stringType
	rejCodeLow		stringType
	rejCodeHigh		stringType
	rejType			stringType
	startDate		stringType
	endDate			stringType
	inclCustomer	stringType
	inclEmployee    stringType
	bankCode		stringType
	setId			stringType
	printType		stringType
    zoneDate        stringType
    zoneCode        stringType
    custId          stringType

IGNORERECORD
	if(recRejTypeDesc = "COUNTER ")
  	if (inclEmployee = "N") and (recAcctOwnerShip = "E")
  	if (inclCustomer = "Y") and (recSanctionLimit = 0.00)

ONSTARTOFREPORT
####################################################################
#   This section will be executed only once during the processing of
#       report. i.e. in the begining of the report
#   Here the valid statements are actions.
#################################################################### 

PAGEHEADER
####################################################################
#   This section is called for and the actions which are
#        specified here are done as a part of header. The number
#        of lines printed in the header cannot exceed the value
#        pageHeaderLines specified in PageFormat Section
#   Here the valid statements are actions.
####################################################################
		execute pageHdr

PAGEFOOTER
####################################################################
#   This section is called for and the actions which are
#        specified here are done as a part of footer. The number
#        of lines prnted in the header cannot exceed the value
#        pageFooterLines specified in PageFormat Section
#   Here the valid statements are actions.
####################################################################
	

ONEVERYRECORD
####################################################################
#   Here the valid statements are actions.
#################################################################### 
execute rej_detail
nextpage

ONENDOFREPORT
# Set the values back for repository variable
# ===========================================
set PAGE_NUMBER = pageNumber

######################################################################
#  PROCEDURE BLOCK
###################################################################### 
PROCEDURE rej_detail 
  	begin
	print substr today 1 10 column 5
	nextline
	print "To " column 5
	nextline
	print recCustTitle column 5
	print ". "
	print cust_name
	nextline
	if address_type = "C"
	begin
		print recComuAddr1 column 5
		nextline
		print recComuAddr2 column 5
    end
	else if address_type = "E"
	begin
		print cust_emp_addr1 column 5
		nextline
		print cust_emp_addr2 column 5
	end
	else
	begin 
		print cust_perm_addr1 column 5
		nextline
		print cust_perm_addr2 column 5
    end
	nextline
	nextline
	print "Dear Sir / Madam " column 5
	nextline
	nextline
	print "REF: A/c #  " column 5
	print foracid 
	print " - "
	set acct_name = ltrim acct_name " "
	print acct_name  
	nextline
	print "__________________________________________________" column 5
	nextline
	nextline
	print "Please note that cheque/instrument   " column 5
	set recInstrmntNum = ltrim recInstrmntNum " "
	print  recInstrmntNum
	print " dated "
	set recInstrmntDate = substr recInstrmntDate 1 10
	print  recInstrmntDate 
	nextline
	print "submitted by you is rejected because of" column 5
        nextline
	
	begin 
	set iprej1 = strlen clg_rej_desc_1
	if iprej1 > 0
	 print "Rejection Description 1 : " column 5
	 print clg_rej_desc_1	column 32
	 nextline
	
	end
	begin
	set iprej2 = strlen clg_rej_desc_2 
	if iprej2 > 0
	print "Rejection Description 2 : " column 5
	print clg_rej_desc_2	column 32
	nextline
	
	end
	begin
	set iprej3 = strlen clg_rej_desc_3
	if iprej3 > 0
	 print "Rejection Description 3 : " column 5
         print clg_rej_desc_3	column 32
	 nextline
	end
	begin
	set iprej4 = strlen clg_rej_desc_4
	if iprej4 > 0
	 print "Rejection Description 4 : " column 5
	 print clg_rej_desc_4	column 32	
	 nextline
	 
	end
	begin
	 set iprej5 = strlen clg_rej_desc_5
	 if iprej5 > 0
	 print "Rejection Description 5 : " column 5
	 print clg_rej_desc_5	column 32
	 nextline
	 
	end
	print "Rejection Type:          " column 5
	print recRejTypeDesc   
	print "Date  " column 38
	print substr  recZoneDate 1 10 
	nextline
	nextline
	nextline
        print "       Authorised Signatory (BRANCH)" 
	nextline
	separatorline
	end


PROCEDURE pageHdr
begin
	print "EQUITY BANK LIMITED" size 80  center
	print "Page: "    column 60
        print pageNumber column 65 size 4 precision 00
	nextline
	print branchName size 80  center
	print today column 60 
	nextline
	print "REJECTED INSTRUMENT ADVICE" size 80  center
	nextline
	nextline
	separatorline
	end
  
