######################################################################################################################
# Source Name						: insurance.scr
# Menu							: HPAYOFF
# Date							: 09-05-2013
# Description						: This script is set in HPTTM for LINSR Event Type  which is set in HLAGSPM menu.
# Input Values						: None
# Output Values						: .
# Called Scripts					:
# Calling Script					:
# Author     						: Shishira
# Bank							: Equity Bank
# Modification History				:
#	< Version No.> 		<Date>		<Author Name> 		<Description>
#	 0.1			09-05-2013 	Shishira			Original Version
#	 0.2			13-06-2013 	Shishira			Added Bank Id in sub Query and changed error msg
#	 0.3			23-07-2013 	Bharath				Modified for TOL 362347
########################################################################################################################
<--START
CHECKSUM="e590fb0519c2ede5a2c631968d5b6099516e956a47d1f4ac9124c4b49190d6a7"
	trace on
	
	#sv_r=urhk_B2k_PrintRepos("BANCS")
	#print (sv_r)
	
	##################################################################
	# Script for slabwise insuarance fee collection
	##################################################################
	
	#--------------------------------------------------------------------------
	#  Creation of CUST repository and INSU class
	#--------------------------------------------------------------------------
	
	sv_r = REPEXISTS("INSU")
	IF (sv_r == 0) THEN
	#{
		CREATEREP("INSU")
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("INSU", "LOAN")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("INSU", "LOAN", 5)
	#}
	ENDIF
	
	INSU.LOAN.FreeCode1=""
	INSU.LOAN.FreeCode2=""
	INSU.LOAN.company=""
	INSU.LOAN.Pattrns=""
	INSU.LOAN.TTLFEE=""
	INSU.LOAN.errMsg=""
	
	#------------------------------------------------
	#----cparam
	#------------------------------------------------
	BANCS.INPUT.moduleName = "CHARGES"
	BANCS.INPUT.parameterId = "CRED_LIFE_PCNT"
	
	CALL ("getcparamvalue.scr")
	IF (BANCS.OUTPUT.parameterVal != "")THEN
	#{
		print(BANCS.OUTPUT.parameterVal)
		INSU.LOAN.pcnt=BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		sv_u = "RESULT_MSG|Parameter value for "+BANCS.INPUT.parameterId+" is not set in C_CPARAM_VALUE_TABLE"
		INSU.LOAN.errMsg=sv_u
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	#-------------------------------------------------------------------------
	# Selecting the Free TEXT 1  in table GAC
	#--------------------------------------------------------------------------
	print(BANCS.INPUT.Foracid)
	INSU.LOAN.Foracid=BANCS.INPUT.Foracid
	#-------------------------------------------------------------------------
	# Selecting the period in table lam
	# if the period is 0 then exiting
	#--------------------------------------------------------------------------
	
	sv_s = "period,SchmCode|"
	sv_s = sv_s + " SELECT rep_perd_mths,schm_code"
	sv_s = sv_s + " FROM TBAADM.LAM, TBAADM.GAM "
	sv_s = sv_s + " WHERE LAM.acid = GAM.acid "
	sv_s = sv_s + " AND LAM.bank_id = GAM.bank_id "
	sv_s = sv_s + " AND GAM.foracid = ?SVAR "
	sv_s = sv_s + " AND GAM.bank_id = ?SVAR "
	sv_s = sv_s + " AND LAM.del_flg = 'N' "
	sv_s = sv_s + " AND LAM.entity_cre_flg = 'Y' "
	sv_s = sv_s + " AND GAM.del_flg = 'N' "
	sv_s = sv_s + " AND GAM.entity_cre_flg = 'Y' "
	print(sv_s)
	BANCS.INPARAM.BINDVARS = INSU.LOAN.Foracid + "|" + BANCS.STDIN.contextBankId
	print(BANCS.INPARAM.BINDVARS)
	sv_d = urhk_dbSelectWithBind(sv_s)
	
	IF (sv_d == 0) THEN
	#{
		INSU.LOAN.period = BANCS.OUTPARAM.period
		INSU.LOAN.schmcode = BANCS.OUTPARAM.SchmCode
	#}
	ELSE
	#{
		GOTO ENDOFSCRIPT
	#}
	ENDIF
	
	INSU.LOAN.amnt=BANCS.INPUT.inputAmount
	print(INSU.LOAN.amnt)
	
	INSU.LOAN.TTLFEE = CDOUBLE(INSU.LOAN.amnt)*CDOUBLE(INSU.LOAN.pcnt)
	PRINT(INSU.LOAN.TTLFEE)

	IF(CDOUBLE(INSU.LOAN.period) >= 12)THEN
	#{
		BANCS.OUTPUT.collAmount = INSU.LOAN.TTLFEE
	#}
	ELSE
	#{
		INSU.LOAN.TTLFEE1 = CDOUBLE(INSU.LOAN.TTLFEE)/12
		PRINT(INSU.LOAN.TTLFEE1)		

		INSU.LOAN.TTLFEE = CDOUBLE(INSU.LOAN.TTLFEE1)*CDOUBLE(INSU.LOAN.period)
		PRINT(INSU.LOAN.TTLFEE)	
	#}
	ENDIF
	
	IF(BANCS.INPUT.inputCrncy == "USD")THEN
	#{
		IF(CDOUBLE(INSU.LOAN.TTLFEE) < 25)THEN
		#{
			INSU.LOAN.TTLFEE = "25"
		#}
		ENDIF
	#}
	ELSE
	#{
		IF(BANCS.INPUT.inputCrncy == "SSP")THEN
		#{
			IF(CDOUBLE(INSU.LOAN.TTLFEE) < 20000)THEN
			#{
				INSU.LOAN.TTLFEE = "20000"
			#}
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
	
	#round off the amount
	sv_a = CDOUBLE(INSU.LOAN.TTLFEE)
	sv_b = 0.01
	sv_c = "H"
	
	BANCS.INPARAM.InputAmount = sv_a
	BANCS.INPARAM.RoundOffAmt = sv_b
	BANCS.INPARAM.RoundOffFlag = sv_c
	
	sv_r=urhk_B2k_RoundOff("")
	
	IF (sv_r == 0) THEN
	#{
		sv_q = BANCS.OUTPARAM.OutputAmount
	#}
	
	ELSE
	#{
		INSU.LOAN.errMsg = "Error in rounding off amount"
		GOTO ENDOFSCRIPT
	#}	
	
	ENDIF
	

	BANCS.OUTPUT.collAmount = sv_q #INSU.LOAN.TTLFEE
	BANCS.OUTPUT.AmountWithNoDiscount       = sv_q #INSU.LOAN.TTLFEE
	BANCS.OUTPUT.collCrncy = BANCS.INPUT.inputCrncy 

	ENDOFSCRIPT :
	IF ( INSU.LOAN.errMsg != "" ) THEN
	#{
		sv_u = system("echo '"+INSU.LOAN.errMsg+"' >>insurance.log")
	#}
	ENDIF
	
	TRACE OFF
	EXITSCRIPT
END-->
