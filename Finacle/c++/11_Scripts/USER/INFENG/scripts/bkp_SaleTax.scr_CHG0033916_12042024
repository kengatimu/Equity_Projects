<--START
TRACE ON

#------------------------------------------------------------------------------
#Creating repository and class
#------------------------------------------------------------------------------
sv_u = urhk_b2k_printrepos("BANCS")
print(sv_u)

IF (REPEXISTS("CUST") == 0) THEN
#{
	CREATEREP("CUST")
#}
ENDIF

IF (CLASSEXISTS("CUST","VAT") == 0) THEN
#{
	CREATECLASS("CUST","VAT",5)
#}
ENDIF

IF (CLASSEXISTS("CUST","GCHRG") == 0) THEN
#{
	CREATECLASS("CUST","GCHRG",5)
#}
ENDIF

CUST.VAT.errMsg = ""

	sv_s = "foracid,vatsum|"
  	sv_s = sv_s + " select distinct * from (select foracid,trunc(sum(tran_amt) * (18/118),2) as saletaxsum from tbaadm.dtd,tbaadm.gam where dtd.bank_id='11' "
  	sv_s = sv_s + " and gam.acid=dtd.acid and dtd.bank_id='11' and dtd.tran_date =  (select to_char(db_stat_date ,'DD-MON-RRRR')  from tbaadm.gct where  Bank_id='11' ) "
  	sv_s = sv_s + " and part_tran_type='C' and substr(foracid,5,13) in  ('650011564','650051563','650010037','650050120','650011573','650051576','650010038','650050152','650051583','650051671','650051566','650051453','650010036','650010039','650010158','650010848','650011424','650011700','650011772','650030097','650031557','650040098','650040099','650040101','650040102','650040103','650040105','650050106','650050111','650050113','650050116','650050157','650050163','650050781','650051692','650051701','650060122','650060125','650060132','650071399','650011603','650011605','650011606','650011669','650011771','650031569','650031574','650040751','650041621','650041622','650041623','650041624','650051611','650051679','650051682','650051702','650061565') "
  	sv_s = sv_s + " and dtd.del_flg='N' and pstd_flg='Y' group by foracid)"
	PRINT(sv_s)

	

	sv_e = urhk_dbCursorOpenWithBind(sv_s)
	PRINT(sv_e)

IF(sv_e == 0) THEN
#{
	sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	sv_q = urhk_dbCursorFetch(sv_m)
	print(sv_q)
	IF(sv_q == 1) THEN
	#{
		sv_x = urhk_dbCursorClose(sv_m)
		print(sv_x)
		CUST.VAT.errMsg ="No Data."
		sv_e=urhk_SetOrbOut("StattusCode|Error")
		sv_e=urhk_SetOrbOut("Error|"+CUST.VAT.errMsg )
		EXITSCRIPT
	#}
	ENDIF
	print(sv_q)

	WHILE (sv_q==0)
	
		CUST.VAT.foracid=BANCS.OUTPARAM.foracid
		print(CUST.VAT.foracid)
		CUST.VAT.vatsum=BANCS.OUTPARAM.vatsum
		print(CUST.VAT.vatsum)

    CALL("SRV_saletax.scr")

				IF(fieldexists(CUST.DATA.tranid)) THEN
				#{
				
					print(CUST.DATA.tranid)
				#}
				ENDIF
	

	NEXTREC:
	
	sv_q = urhk_dbCursorFetch(sv_m)
	print(sv_q)
	
	
	#}
	DO
#}
ELSE
#{

	print("Data fetch error")
#}
ENDIF



EXITSCRIPT

trace off
