BANCS.INPUT.parameterId = "BELMINCHRG"
CALL("getcparamvalue.scr")
PRINT(BANCS.OUTPUT.parameterVal)
IF(BANCS.OUTPUT.parameterVal != "")THEN
#{
    CUST.LEDGR.minbalevent = BANCS.OUTPUT.parameterVal
    PRINT(CUST.LEDGR.minbalevent)
#}
ELSE
#{
    CUST.LEDGR.errMsg = "Minimum Balance Charge event setup not done in CPARAM"
    GOTO ENDOFSCRIPT
#}
ENDIF


BANCS.INPUT.parameterId = "AMT14"
