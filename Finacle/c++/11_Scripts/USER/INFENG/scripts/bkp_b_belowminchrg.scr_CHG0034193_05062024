CALL("getcparamvalue.scr")
PRINT(BANCS.OUTPUT.parameterVal)
IF(BANCS.OUTPUT.parameterVal != "")THEN
#{
    CUST.LEDGR.amtbelowusd3 = BANCS.OUTPUT.parameterVal
    PRINT(CUST.LEDGR.amtbelowusd3)
#}
ELSE
#{
    CUST.LEDGR.errMsg = "USD Minimum Bal Amount CA288 event setup not done in CPARAM"
    GOTO ENDOFSCRIPT
#}
ENDIF

sv_b = "FromDate|select to_char(sysdate,'MON-yyyy') from dual "
print (sv_b)
sv_d = urhk_dbselectWithBind(sv_b)
print(sv_d)

IF (sv_d == 0) THEN
#{
CUST.LEDGR.fromdate = "01" + "-" + BANCS.OUTPARAM.FromDate 
print(CUST.LEDGR.fromdate)

print(CUST.LEDGR.fromdate)

#}
ENDIF

BANCS.INPARAM.BINDVARS =  BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.mySolId
PRINT(BANCS.INPARAM.BINDVARS)

sv_f = "acid,acct,currCode,schmCode| "
sv_f = sv_f + "select acid,foracid,acct_crncy_code,schm_code FROM tbaadm.gam where bank_id = ?SVAR and sol_id = ?SVAR and schm_code in('SB188','CA287','CA288')"
sv_f = sv_f + " and sol_id='2011' and bank_id='11' "
IF(BANCS.STDIN.contextBankId=="11")THEN
#{
	sv_f = sv_f + " and sol_id='2011' "
#}
ENDIF

print(sv_f)

sv_g = urhk_dbCursorOpenWithBind(sv_f)

IF(sv_g==0) THEN
	    sv_m = BANCS.OUTPARAM.DB_CURSOR_NUMBER
	    sv_f = urhk_dbCursorFetch(sv_m)
	    print(sv_f)

	   IF(sv_f == 1) THEN
		 sv_x = urhk_dbCursorClose(sv_m)
		 print(sv_x)
		 GOTO ENDOFSCRIPT
	   ENDIF
	  print(sv_f)
WHILE (sv_f==0)


	CUST.LEDGR.acid = BANCS.OUTPARAM.acid
	print(CUST.LEDGR.acid)

	CUST.LEDGR.acct = BANCS.OUTPARAM.acct
	print(CUST.LEDGR.acct)

	CUST.LEDGR.currCode = BANCS.OUTPARAM.currCode
	print(CUST.LEDGR.currCode)

	CUST.LEDGR.schmCode = BANCS.OUTPARAM.schmCode
	print(CUST.LEDGR.schmCode)
	PRINT(BANCS.STDIN.homeCrncyCode)

	IF (CUST.LEDGR.schmCode == "SB188") THEN
	#{
		CUST.LEDGR.balbelowmin = CUST.LEDGR.amtbelowssp1
		print(CUST.LEDGR.balbelowmin)
		CUST.LEDGR.drAcctCurr = BANCS.STDIN.homeCrncyCode
		print(CUST.LEDGR.drAcctCurr)
		CUST.LEDGR.tmminchrg = CUST.LEDGR.minchrgssp
		print(CUST.LEDGR.tmminchrg)
		
		IF (CUST.LEDGR.currCode == "USD") THEN
		#{
			CUST.LEDGR.balbelowmin = CUST.LEDGR.amtbelowusd1
			print(CUST.LEDGR.balbelowmin)
			CUST.LEDGR.drAcctCurr = CUST.LEDGR.currCode
			print(CUST.LEDGR.drAcctCurr)
			CUST.LEDGR.minbalevent = "MINBALCHRG1"
			print(CUST.LEDGR.minbalevent)
			CUST.LEDGR.tmminchrg = CUST.LEDGR.minchrgusd
			print(CUST.LEDGR.tmminchrg)
		#}
		ENDIF
	#}
	ENDIF
	IF (CUST.LEDGR.schmCode == "CA287") THEN
	#{
		CUST.LEDGR.balbelowmin = CUST.LEDGR.amtbelowssp2
		print(CUST.LEDGR.balbelowmin)
		CUST.LEDGR.drAcctCurr = BANCS.STDIN.homeCrncyCode
		print(CUST.LEDGR.drAcctCurr)
		CUST.LEDGR.tmminchrg = CUST.LEDGR.minchrgssp1
		print(CUST.LEDGR.tmminchrg)
		
		IF (CUST.LEDGR.currCode == "USD") THEN
		#{
			CUST.LEDGR.balbelowmin = CUST.LEDGR.amtbelowusd2
			print(CUST.LEDGR.balbelowmin)
			CUST.LEDGR.drAcctCurr = CUST.LEDGR.currCode
			print(CUST.LEDGR.drAcctCurr)
			CUST.LEDGR.minbalevent = "MINBALCHRG1"
			print(CUST.LEDGR.minbalevent)
			CUST.LEDGR.tmminchrg = CUST.LEDGR.minchrgusd
			print(CUST.LEDGR.tmminchrg)
		#}
		ENDIF
	#}
	ENDIF
	IF (CUST.LEDGR.schmCode == "CA288") THEN
	#{
		CUST.LEDGR.balbelowmin = CUST.LEDGR.amtbelowssp3
		print(CUST.LEDGR.balbelowmin)
		CUST.LEDGR.drAcctCurr = BANCS.STDIN.homeCrncyCode
		print(CUST.LEDGR.drAcctCurr)
		CUST.LEDGR.tmminchrg = CUST.LEDGR.minchrgssp1
		print(CUST.LEDGR.tmminchrg)
		
		IF (CUST.LEDGR.currCode == "USD") THEN
		#{
			CUST.LEDGR.balbelowmin = CUST.LEDGR.amtbelowusd3
			print(CUST.LEDGR.balbelowmin)
			CUST.LEDGR.drAcctCurr = CUST.LEDGR.currCode
			print(CUST.LEDGR.drAcctCurr)
			CUST.LEDGR.minbalevent = "MINBALCHRG1"
			print(CUST.LEDGR.minbalevent)
			CUST.LEDGR.tmminchrg = CUST.LEDGR.minchrgusd
			print(CUST.LEDGR.tmminchrg)
		#}
		ENDIF
	#}
	ENDIF

		sv_a = urhk_getAcctDetailsInRepository(CUST.LEDGR.acct)
		IF(sv_a==0)THEN
		#{
		CUST.LEDGR.EffAvailableAmt =CDOUBLE(BANCS.OUTPARAM.EffAvailableAmt)
		#}
		ENDIF
		
		
		BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.LEDGR.acid + "|" + CUST.LEDGR.fromdate + "|" + CUST.LEDGR.balbelowmin
		PRINT(BANCS.INPARAM.BINDVARS)

		sv_e = "countBal|select  count(*) from tbaadm.eab where bank_id = ?SVAR "
		sv_e = sv_e + "and acid = ?SVAR "
		sv_e = sv_e + "and (eod_date between ?SVAR and to_date(sysdate, 'dd-mm-yy')) "
		sv_e = sv_e + "and TRAN_DATE_BAL < ?SVAR "
		print(sv_e)

		sv_f = urhk_dbselectWithBind(sv_e)
		print(sv_f)

		IF ((sv_f == 0) AND (CDOUBLE(CUST.LEDGR.EffAvailableAmt) >= cdouble(CUST.LEDGR.tmminchrg))) THEN
		#{
			CUST.LEDGR.countBal = cint(BANCS.OUTPARAM.countBal)
			print(CUST.LEDGR.countBal)
			IF (CUST.LEDGR.countBal > 0) THEN
			#{
				CUST.LEDGR.amt = cdouble(CUST.LEDGR.tmminchrg)
				PRINT(CUST.LEDGR.amt)
			
				CUST.GCHRG.tranType = "T"
				CUST.GCHRG.tranSubType = "BI"
				CUST.GCHRG.drAcctId = CUST.LEDGR.acct
				CUST.GCHRG.acctCrncyCode = CUST.LEDGR.drAcctCurr
				CUST.GCHRG.chrgAmt = CUST.LEDGR.amt + "|" + CUST.LEDGR.drAcctCurr
				PRINT(CUST.LEDGR.minbalevent)
				CUST.GCHRG.eventId = CUST.LEDGR.minbalevent

				CALL("gchrgcommon.scr")
				IF (CUST.GCHRG.successOrFailure == "S") THEN
				#{
					PRINT("Charge collected")
				#}
				ELSE
				#{
					PRINT("Failure")
				#}
				ENDIF
			#}
			ENDIF
		#}
		ENDIF

	sv_f = urhk_dbCursorFetch(sv_m)
	print(sv_f)
DO
 print("ALL CHARGES COLLECTED")
#}
ENDIF

ENDOFSCRIPT:
IF(CUST.LEDGR.errMsg != "") THEN
#{
    sv_u = system("echo '"+CUST.LEDGR.errMsg+"' >>amtbelow.log")
#}
