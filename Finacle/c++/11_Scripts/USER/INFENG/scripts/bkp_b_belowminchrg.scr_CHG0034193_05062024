PRINT(BANCS.OUTPUT.parameterVal)
IF(BANCS.OUTPUT.parameterVal != "")THEN
#{
    CUST.LEDGR.amtbelowusd2 = BANCS.OUTPUT.parameterVal
    PRINT(CUST.LEDGR.amtbelowusd2)
#}
ELSE
