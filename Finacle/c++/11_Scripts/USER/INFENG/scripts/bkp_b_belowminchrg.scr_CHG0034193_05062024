PRINT(BANCS.OUTPUT.parameterVal)
IF(BANCS.OUTPUT.parameterVal != "")THEN
#{
    CUST.LEDGR.minchrgssp = BANCS.OUTPUT.parameterVal
    PRINT(CUST.LEDGR.minchrgssp)
#}
ELSE
#{
    CUST.LEDGR.errMsg = "SSP Minimum Bal Charge amount(SB188) setup not done in CPARAM"
    GOTO ENDOFSCRIPT
#}
ENDIF

