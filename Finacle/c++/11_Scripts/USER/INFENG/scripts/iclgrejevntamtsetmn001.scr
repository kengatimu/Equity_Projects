########################################################################################################################
<--START
CHECKSUM="b1742e64f468646f560bee50b1257d9a2bb612151e833d92be3cc6a31f42076a"
	#TRACE ON
	
	#sv_r = urhk_B2k_PrintRepos("BANCS")
	##########################################################################
	#  Creation of CUST repository and ICI class
	##########################################################################
	
	sv_r = REPEXISTS("CUST")
	IF (sv_r == 0) THEN
	#{
		CREATEREP("CUST")
	#}
	ENDIF
	
	sv_r = CLASSEXISTS("CUST", "ICI")
	IF (sv_r == 0) THEN
	#{
		CREATECLASS("CUST", "ICI", 5)
	#}
	ENDIF
	
	CUST.ICI.rejCode   = ""
	CUST.ICI.Reject    = ""
	CUST.ICI.errMsg	   = ""
	CUST.ICI.evtAmt    = CDOUBLE("0")
	CUST.ICI.calAmt1   = CDOUBLE("0")
	CUST.ICI.calAmt2   = CDOUBLE("0")
	CUST.ICI.homeCrncy = BANCS.STDIN.homeCrncyCode
	
	BANCS.INPUT.moduleName="CLEARING"
	BANCS.INPUT.parameterId="REJCODE_63"
	call("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.ICI.rejCode = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.ICI.errMsg = "rejection Code setup is not done in CPARAM"
		GOTO FINISH
	#}
	ENDIF
	
	BANCS.INPUT.moduleName="CLEARING"
	BANCS.INPUT.parameterId="EVEAMT_1000"
	call("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.ICI.calAmt1 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.ICI.errMsg = "Event Amount setup is not done in CPARAM"
		GOTO FINISH
	#}
	ENDIF
	
	BANCS.INPUT.moduleName="CLEARING"
	BANCS.INPUT.parameterId="EVEAMT_2000"
	call("getcparamvalue.scr")
	IF(BANCS.OUTPUT.parameterVal != "") THEN
	#{
		CUST.ICI.calAmt2 = BANCS.OUTPUT.parameterVal
		#}
	ELSE
		#{
		CUST.ICI.errMsg = "Event Amount setup is not done in CPARAM"
		GOTO FINISH
	#}
	ENDIF
	
	CUST.ICI.Reject = BANCS.INPUT.RejectReason1
	print(CUST.ICI.Reject)
	
	IF (CUST.ICI.Reject == CUST.ICI.rejCode) THEN
	#{
		CUST.ICI.evtAmt = CUST.ICI.calAmt2
		print(CUST.ICI.evtAmt)
		GOTO FINISH
		#}
	ELSE
		#{
		CUST.ICI.evtAmt = CUST.ICI.calAmt1
		print(CUST.ICI.evtAmt)
		GOTO FINISH
	#}
	ENDIF
	
FINISH:			
			BANCS.INPARAM.InputAmount       = CUST.ICI.evtAmt
               BANCS.INPARAM.FromCurrency      = BANCS.INPUT.chrgCalcCrncy
               BANCS.INPARAM.ToCurrency        = BANCS.STDIN.homeCrncyCode
               BANCS.INPARAM.RateCode          = "TTS"
               BANCS.INPARAM.Rate                      = 0.00
               sv_u = urhk_B2k_ConvertAmount("")
               PRINT(sv_u)
        
               IF(sv_u == 0)THEN
               #{
                       CUST.ICI.evtAmt = CDOUBLE(BANCS.OUTPARAM.OutputAmount)
                       PRINT(CUST.ICI.evtAmt)
                       #}
               ELSE
                       #{
                       CUST.ICI.successOrFailure = "F"
                       CUST.ICI.scriptError = "Error in converting amount"
                        EXITSCRIPT
               #}
               ENDIF
	
	
		print(CUST.ICI.evtAmt)
		BANCS.OUTPUT.collAmount = CDOUBLE(CUST.ICI.evtAmt)
		BANCS.OUTPUT.AmountWithNoDiscount = CDOUBLE(CUST.ICI.evtAmt)
		BANCS.OUTPUT.collCrncy = CUST.ICI.homeCrncy
		
		#TRACE OFF
		EXITSCRIPT
END-->
