<?xml version="1.0" encoding="UTF-8"?>
<scxml datamodel="lua" initial="InitialState" name="RegisterPaymentOrder" version="1.0" xmlns="http://www.w3.org/2005/07/scxml">
	<datamodel/>
	<state id="InitialState">
		<onentry>
			<log expr="'start register Payment Order process'" label="Action"/>
		</onentry>
		<transition event="error" target="ErrorState"/>
		<transition target="Store Payment order"/>
	</state>
	<state id="ErrorState"/>
	<state id="Store Payment order">
		<invoke idlocation="_sessionId" src="/api/payments/storepaymentorder" type="basicHttp"/>
		<transition event="error" target="ErrorState"/>
		<transition target="CheckLienStatusState"/>
	</state>
	<state id="CheckLienStatusState">
		<invoke idlocation="_sessionId" src="/api/accounts/holdfund" type="basicHttp">
			<param location="orderingAccount" name="accountNumber"/>
		</invoke>
		<transition event="error" target="ErrorState"/>
		<transition event="done">
			<if cond="flag == &quot;Y&quot;">
				<raise event="flagY"/>
				<elseif cond="flag == &quot;N&quot;">
					<raise event="flagN"/>
				</elseif>
				<else>
					<raise event="error"/>
				</else>
			</if>
		</transition>
		<transition event="flagY" target="ModifyLien"/>
		<transition event="flagN" target="AddLien"/>
	</state>
	<state id="ModifyLien">
		<invoke idlocation="_sessionId" src="/api/accounts/modifyblockedamount" type="basicHttp">
			<param location="orderingAccount" name="accountNumber"/>
			<param expr="amount" name="blockAmount"/>
			<param location="accountCurrency" name="accountCurrency"/>
			<param location="paymentOrderId" name="paymentOrderId"/>
		</invoke>
		<transition event="error" target="ErrorState"/>
		<transition target="CheckFeeLienStatusState"/>
	</state>
	<state id="AddLien">
		<invoke idlocation="_sessionId" src="/api/accounts/addblockedamount" type="basicHttp">
			<param location="orderingAccount" name="accountNumber"/>
			<param location="accountCurrency" name="accountCurrency"/>
			<param expr="amount" name="blockAmount"/>
			<param location="paymentOrderId" name="paymentOrderId"/>
		</invoke>
		<transition event="error" target="ErrorState"/>
		<transition target="CheckFeeLienStatusState"/>
	</state>
	<state id="StateCheckAmount">
		<onentry>
			<if cond="amountInLimitCurrency &gt; 10000">
				<raise event="AboveLimit"/>
				<else>
					<raise event="BellowLimit"/>
				</else>
			</if>
		</onentry>
		<transition event="BellowLimit" target="StateNewGenFundsTransfer"/>
		<transition event="AboveLimit" target="StateUpdateStatusWaitingCheckerApproval"/>
	</state>
	<state id="StateNewGenFundsTransfer">
		<invoke idlocation="_sessionId" src="/api/newgen/createcustomerfundtransferitem" type="basicHttp"/>
		<transition event="error" target="StateUpdateStatusProblemRegisteringInNewGen"/>
		<transition event="done" target="StateUpdateStatusRegisteredInNewGen"/>
	</state>
	<state id="StateUpdateStatusWaitingCheckerApproval">
		<invoke idlocation="_sessionId" src="/api/payments/updatepaymentorderstatus" type="basicHttp">
			<param location="paymentOrderId" name="paymentOrderId"/>
			<param expr="17" name="paymentSetStatusId"/>
		</invoke>
		<transition event="done" target="End"/>
		<transition event="error" target="ErrorState"/>
	</state>
	<final id="End"/>
	<state id="StateUpdateStatusProblemRegisteringInNewGen">
		<invoke idlocation="_sessionId" src="/api/payments/updatepaymentorderstatus" type="basicHttp">
			<param location="paymentOrderId" name="paymentOrderId"/>
			<param expr="20" name="paymentSetStatusId"/>
		</invoke>
		<transition event="done.invoke.StateUpdateStatusProblemRegisteringInNewGen" target="End"/>
	</state>
	<state id="StateUpdateStatusRegisteredInNewGen">
		<invoke idlocation="_sessionId" src="/api/payments/updatepaymentorderstatus" type="basicHttp">
			<param location="paymentOrderId" name="paymentOrderId"/>
			<param expr="21" name="paymentSetStatusId"/>
		</invoke>
		<transition event="done" target="End"/>
	</state>
	<state id="StateNewGenUploadDocuments">
		<invoke idlocation="_sessionId" src="/api/newgen/uploadswiftdocument" type="basicHttp">
			<param location="documents" name="documents"/>
			<param location="paymentOrderId" name="paymentOrderId"/>
			<param location="externalClientId" name="externalClientId"/>
			<param location="orderingAccount" name="orderingAccount"/>
			<param location="externalUserId" name="externalUserId"/>
			<param location="externalBranchId" name="externalBranchId"/>
		</invoke>
		<transition target="StateCheckAmount"/>
	</state>
	<state id="CheckFeeLienStatusState">
		<invoke idlocation="_sessionId" src="/api/accounts/holdfund" type="basicHttp">
			<param location="chargeAccount" name="accountNumber"/>
		</invoke>
		<transition event="done">
			<if cond="flag == &quot;Y&quot;">
				<raise event="flagY"/>
				<elseif cond="flag == &quot;N&quot;">
					<raise event="flagN"/>
				</elseif>
				<else>
					<raise event="error"/>
				</else>
			</if>
		</transition>
		<transition event="flagN" target="AddFeeLien"/>
		<transition event="flagY" target="ModifyFeeLien"/>
	</state>
	<state id="AddFeeLien">
		<invoke idlocation="_sessionId" src="/api/accounts/addblockedamount" type="basicHttp">
			<param location="chargeAccount" name="accountNumber"/>
			<param location="chargeAccountCurrency" name="accountCurrency"/>
			<param expr="chargeAmount" name="blockAmount"/>
			<param location="paymentOrderId" name="paymentOrderId"/>
		</invoke>
		<transition target="StateNewGenUploadDocuments"/>
		<transition event="error" target="ErrorState"/>
	</state>
	<state id="ModifyFeeLien">
		<invoke idlocation="_sessionId" src="/api/accounts/modifyblockedamount" type="basicHttp">
			<param location="chargeAccount" name="accountNumber"/>
			<param expr="chargeAmount" name="blockAmount"/>
			<param location="chargeAccountCurrency" name="accountCurrency"/>
			<param location="paymentOrderId" name="paymentOrderId"/>
		</invoke>
		<transition target="StateNewGenUploadDocuments"/>
		<transition event="error" target="ErrorState"/>
	</state>
</scxml><!--VFBGMAdUVHJlZUV4AARMZWZ0AhEDVG9wAhEFV2lkdGgDRgMGSGVpZ2h0AzYBCURlc2lnbmluZw
