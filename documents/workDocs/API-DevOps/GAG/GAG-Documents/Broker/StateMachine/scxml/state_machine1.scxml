<?xml version="1.0" encoding="UTF-8"?>
<scxml datamodel="lua" initial="StateOne" name="JovanTest1" version="1.0" xmlns="http://www.w3.org/2005/07/scxml" xmlns:pces="http://www.pces.mk/scxml">
	<datamodel>
		<data expr="0" id="local1"/>
		<data expr="local1+1" id="local2"/>
		<data expr="local2+3" id="local3"/>
	</datamodel>
	<state id="StateOne">
		<onentry>
			<log expr="'Jovan test alone'" label="Jovan"/>
			<foreach array="_ioprocessors" item="processor">
				<log expr="processor.Type" label="basicHttp"/>
				<log expr="'Jovan test for'" label="Jovan"/>
			</foreach>
			<pces:action name="DemoTest1" method="DemoTest1" class="PCES.Actions.Test.Library.DemoTest" assembly="PCES.Actions.Test.Library"/>
		</onentry>
		<invoke idlocation="_sessionId" src="https://localhost:44385/test" type="basicHttp">
			<param expr="local1 + local2" name="param1"/>
			<param location="local3" name="param2"/>
		</invoke>
		<transition event="TEST JOVAN" target="StateTwo"/>
		<transition cond="local2==1">
			<log expr="'Jovan test event less'" label="Jovan"/>
			<assign expr="local2-1" location="local2"/>
		</transition>
	</state>
	<state id="StateTwo">
		<onexit>
			<assign expr="1" location="local1"/>
		</onexit>
		<transition cond="local1==0" event="NETEST" target="StateOne"/>
		<transition cond="local1 == 1" event="NETEST" target="End"/>
	</state>
	<final id="End"/>
</scxml><!--VFBGMAdUVHJlZUV4AARMZWZ0AhEDVG9wAhEFV2lkdGgDnwQGSGVpZ2h0Aw0CCURlc2lnbmluZw
