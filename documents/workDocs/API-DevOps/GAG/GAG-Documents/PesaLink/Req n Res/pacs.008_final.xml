<?xml version='1.0' encoding='UTF-8'?>
<Document xmlns="urn:iso:std:iso:20022:tech:xsd:pacs.008.001.09">
	<FIToFICstmrCdtTrf>
	
		<GrpHdr>
		
			<!-- <MsgId> - Unique ID to identify this transaction -->
			<MsgId>045c099d6a9a40db9a05a688d47a1352</MsgId>
			
			<!-- <CreDtTm> - Current datetime -->
			<CreDtTm>2021-04-09T15:20:43.000Z</CreDtTm>
			
			<!-- <NbOfTxs> - Number of transactions in this request -->
			<NbOfTxs>1</NbOfTxs>
			
			<!-- <TtlIntrBkSttlmAmt> - Used in Bulk Transfers Only - Total amount of all transactions in this request -->
			<!-- Dont include this tag <TtlIntrBkSttlmAmt> in case of single credit transfer -->
			<TtlIntrBkSttlmAmt Ccy="KES">1750.0</TtlIntrBkSttlmAmt>
			
			<SttlmInf>
				<SttlmMtd>CLRG</SttlmMtd>
				<ClrSys>
					<Prtry>IPS</Prtry>
				</ClrSys>
			</SttlmInf>
			
			<PmtTpInf>
			
				<!-- Type of transaction i.e. P2PT, P2BT, P2GT, B2PT, G2PT, G2BT -->
				<SvcLvl>
					<Prtry>P2PT</Prtry>
				</SvcLvl>
				
				<LclInstrm>
					<Cd>INST</Cd>
				</LclInstrm>
				
				<!-- Initiating channel i.e. ATM, POS, IBNK, AGNT, BB, MB, USSD -->
				<CtgyPurp>
					<Prtry>IBNK</Prtry>
				</CtgyPurp>
				
			</PmtTpInf>
			
			<!-- <InstgAgt> - Party that is instructing the next party to execute the request. This is the Sender PIC -->
			<InstgAgt>
				<FinInstnId>
					<Othr>
						<Id>0012</Id>
					</Othr>
				</FinInstnId>
			</InstgAgt>
			
			<!-- <InstdAgt> - Party that is instructed to execute the request. -->
			<!-- From Sender To IPS, this will be IPS PIC. From IPS to Recipient, this will be Recipient PIC -->
			<InstdAgt>
				<FinInstnId>
					<Othr>
						<Id>9999</Id>
					</Othr>
				</FinInstnId>
			</InstdAgt>
			
		</GrpHdr>
		
		<CdtTrfTxInf>
		
			<PmtId>
				<!-- <EndToEndId> - First 8 digits 00200030 - 0020(Your PIC) - 0030 (Beneficiary PIC) then yyyymmddhhmmss then 8 random characters-->
				<EndToEndId>0020003020210409152043fb4d47ce</EndToEndId>
			</PmtId>
			
			<!-- <IntrBkSttlmAmt> - Amount to be transferred -->
			<IntrBkSttlmAmt Ccy="KES">33.80</IntrBkSttlmAmt>
			
			<!-- <AccptncDtTm> - Datetime when payment order was accepted for porcessing by originator -->
			<AccptncDtTm>2021-04-09T15:20:43.000Z</AccptncDtTm>
			
			<ChrgBr>SLEV</ChrgBr>
			
			<!-- <MndtRltdInf> is only included when pacs.008 is generated as a result of pain.013 request i.e. Request To Pay With Mandate -->
			<MndtRltdInf>
				<MndtId>656768980989790</MndtId>
			</MndtRltdInf>
			
			<!-- <InitgPty> is a party that initiated pain.001 i.e. Payment Initiation -->
			<!-- When pacs.008 is formed from pain.001 <InitgPty> is MANDATORY and must match <InitgPty> from pain.001 -->
			<InitgPty>
				<Id>
					<OrgId>
						<Othr>
							<Id>0007</Id>
						</Othr>
					</OrgId>
				</Id>
			</InitgPty>
			
			<!-- <UltmtDbtr> tag is Optional - Used to indicate the actual sender of funds -->
			<!-- Used in cases where debtor (<Dbtr>) is transferring funds on behalf of another party i.e. <UltmtDbtr> -->
			<!-- This tag is not processed by IPS. It is meant to be used by participants for record purposes -->
			<UltmtDbtr>
				
				<Nm>Ultimate Debtor Name</Nm>
				
				<CtctDtls>
					<PhneNb>+254-111222333</PhneNb>
				</CtctDtls>
				
			</UltmtDbtr>
			
			<!-- <Dbtr> tag is Mandatory - Specifies debtor details at originator bank -->
			<Dbtr>
			
				<!-- <Nm> tag is Mandatory -->
				<Nm>Debtor name</Nm>
				
				<!-- <Id> - optional tag and subtags -->
				<Id>
					<PrvtId>
						<DtAndPlcOfBirth>
							<BirthDt>1985-01-30</BirthDt>
							<CityOfBirth>Nairobi</CityOfBirth>
							<CtryOfBirth>KE</CtryOfBirth>
						</DtAndPlcOfBirth>
					</PrvtId>
				</Id>
				
				<!-- <CtctDtls> tag is Mandatory -->
				<CtctDtls>
					<PhneNb>+254-111222333</PhneNb>
				</CtctDtls>
				
			</Dbtr>
			
			<!-- <DbtrAcct> tag is Mandatory - Specifies account to be debited at originator bank -->
			<DbtrAcct>
				<Id>
					<Othr>
						<Id>DR00123456789012345678901234567890</Id>
					</Othr>
				</Id>
				<Nm>Debtor account name</Nm>
			</DbtrAcct>
			
			<!-- DbtrAgt - Originator/ Debtor Bank PIC -->
			<DbtrAgt>
				<FinInstnId>
					<Othr>
						<Id>0001</Id>
					</Othr>
				</FinInstnId>
			</DbtrAgt>
			
			<!-- <CdtrAgt> - Beneficiary/ Creditor Bank PIC -->
			<CdtrAgt>
				<FinInstnId>
					<Othr>
						<Id>0063</Id>
					</Othr>
				</FinInstnId>
			</CdtrAgt>
			
			<!-- if transaction is send to phone, populate <Cdtr> with creditor name and phone number, otherwise send tag as empty <Cdtr/> -->
			<Cdtr>
				<Nm>Creditor name</Nm>
				<CtctDtls>
					<PhneNb>+254-111222333</PhneNb>
				</CtctDtls>
			</Cdtr>

			<!-- if transaction is send to phone, remove this <CdtrAcct> tag -->
			<!-- if transaction is "send to wallet" or "send to account", include <CdtrAcct> tag. -->
			<!-- Tag contains mandatory <Id> - acct no and optional <Nm> - act name subtags -->
			<CdtrAcct>
			
				<!-- Mandatory <Id> tag -->
				<Id>
				
					<Othr>
					
						<!-- Beneficiary/ creditor account -->
						
						<!-- EITHER -->
						<!-- A. if transaction is send to account, use account number in <Id> tag-->
						<Id>XX00BENESYNHTTP00001</Id>
						
						<!-- OR -->
						<!-- B. if transaction is send to wallet e.g. Telkom or Airtel, use phone number in <Id> tag and include <SchmeNm> tag as below -->
						<Id>+254-111222333</Id>
						<SchmeNm>
							<Prtry>PHNE</Prtry>
						</SchmeNm>
						
					</Othr>
					
				</Id>
				
				<!-- optional - name returned from account validation step -->
				<Nm>Creditor account name</Nm>
				
			</CdtrAcct>
			
			<!-- <UltmtCdtr> tag is Optional - Used to indicate the actual recipient of funds -->
			<!-- Used in cases where creditor (<Cdtr>) is receiving funds on behalf of another party i.e. <UltmtCdtr> -->
			<!-- This tag is not processed by IPS. It is meant to be used by participants for record purposes -->
			<UltmtCdtr>
			
				<Nm>Ultimate Creditor Name</Nm>
				
				<CtctDtls>
					<PhneNb>+254-715568254</PhneNb>
				</CtctDtls>
				
			</UltmtCdtr>
			
			<!-- <Purp><Prtry> tag specifies Purpose of transaction i.e. 100 - Inter Bank Transfer, 200 - Salary -->
			<!-- We shall advise on the codes to be used -->
			<Purp>
				<Prtry>100</Prtry>
			</Purp>
			
			<RmtInf>
				<!-- Ustrd - Purpose of payment as enterd by end user -->
				<Ustrd>Additional info on payment purpose</Ustrd>
				
				<!-- Strd/TaxRmt/RefNb - Transaction reference number e.g. E-Citizen payment -->
				<Strd>
				
					<TaxRmt>
						<RefNb>bb3c913ff4cb4f1685609ce6a9d946b3</RefNb>
					</TaxRmt>

				</Strd>
				
			</RmtInf>
			
		</CdtTrfTxInf>
		
	</FIToFICstmrCdtTrf>
	
</Document>