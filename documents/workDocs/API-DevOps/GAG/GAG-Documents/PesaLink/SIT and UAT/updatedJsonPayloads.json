2. Account Verification
    url: https://10.11.6.111:8443/services/pesalinkbusinessms/api/v1/verification-request

    a. General Request - namecheck and account verification

        Request
        {
        "requestId": "EQUITY000000000105",
        "channelId": "STK",
        "sourceSystemId": "EQUITEL_STK",
        "callbackURL": "http://localhost:8085/v1/callback/channel",
        "sourceTranType": "1",
        "sourceAccount": "1001008010940",
        "sourceCountryCode": "54",
        "sourceCurrency": "KES",
        "senderName": "KATEI OLE NASHUU",
        "senderInstitutionCode": "0068",
        "senderPhone": "+254-720000000",
        "receiverAccount": "0170197176640",
        "receiverInstitutionCode": "0012",
        "receiverCurrency": "KES",
        "amount": "500",
        "feeAmount": "0",
        "paymentReason": "Payments",
        "narration": "Pesalink Transfer",
        "signature": ""
    }

        Where
        I. sourceTranType Values:
            1 = sendToAccount
            2 = sendToPhone
            3 = sendToWallet

        II. CHANNEL_ID     :   SOURCE_SYSTEM_ID
            1. STK         :   EQUITEL_STK        
            2. APP         :   EQUITY_APP
            3. WEB         :   EQUITY_WEB
            4. USSD        :   EQUITY_USSD
            5. EAZAPP      :   EAZZY_APP
            6. EAZNET      :   EAZZY_NET
            7. EAZBIZ      :   EAZZY_BIZ
            8. EVA         :   CHATBOT_EVA        
            9. OTC         :   BRANCH

       III. NOTE: If sendToPhone or sendToWallet, supply receiverAccount field with the mobile number

        Response Success
        {
         "requestId":"EQUITY000000000105",
          "endToEndId":"123456789",
          "channelId":"STK",
          "sourceSystemId":"EQUITEL_STK",
          "receiverAccount":"0170197176640", 
          "receiverInstitutionCode":"0012", 
          "receiverName":"name",
          "status":"success",
          "statusCode":"00",
          "statusDesc":"Request Processed Successfully"
        }

        Response Failure
        {
          "requestId": "EQUITY000000000105",
          "channelId": "STK",
          "sourceSystemId": "EQUITEL_STK",
          "receiverAccount": "1145756190",
          "receiverInstitutionCode": "0001",
          "status": "Failed",
          "statusCode": "01",
          "statusDesc": "Request Failed. Internal Exception Occurred: Unexpected EOF in prolog\n at [row,col {unknown-source}]: [1,0]"
        }




3. Credit transfer
    I. Generate Signature
    url: https://10.11.6.111:8443/services/pesalinkbusinessms/api/v1/credit/transfer/generate-signature

        {
          "requestId":"EQUITY100011300103",
          "channelId":"STK",
          "sourceSystemId":"EQUITEL_STK",
          "signature":"generate signature"
        }

    II. Credtit Transfer Requst
    url: https://10.11.6.111:8443/services/pesalinkbusinessms/api/v1/credit-transfer

        Request
            {
              "requestId":"EQUITY100011300103",
              "channelId":"STK",
              "sourceSystemId":"EQUITEL_STK",
              "signature":""
            }
            where 
            requestId = account verification requestId

        Response Success
        {
          "requestId": "EQUITY000000000105",
          "status": "Success",
          "statusCode": "00",
          "statusDesc": "Request accepted successfully"
        }

        Response Failure
        {
          "requestId": "EQUITY000000000105",
          "status": "Success",
          "statusCode": "01",
          "statusDesc": "Request Failed"
        }


