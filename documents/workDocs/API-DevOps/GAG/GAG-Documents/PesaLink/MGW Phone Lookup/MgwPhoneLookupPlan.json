1. Business Service Request
{
    "requestId": "request001",
    "channelId": "OMNI",
    "receiverPhone": "254722370923"
}

2. validate inputs

3. Prepare ipsls mgw lookup request dto

{
    "requestId": "request001",
    "channelId": "OMNI",
    "receiverPhone": "254722370923",
    "login": "EQUITY BANK",
    "password": "123456"
}

4. Prepare ipsl mgw lookup request json
{
   "Header": "null",
   "Body": {
      "getCustomerBankList": {
         "req": {
            "login": "EQUITY BANK",
            "msisdn": "25472100200",
            "password": "123456"
         }
      }
   }
}

4. Convert the json to xml
<soapenv:Envelope
    xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/"
    xmlns:ws="http://ws.lookupdb.mgw.cwt.ru/">
    <soapenv:Header/>
    <soapenv:Body>
        <ws:getCustomerBankList>
            <req>
                <login>EQUITY BANK</login>
                <msisdn>25472100200</msisdn>
                <password>123456</password>
            </req>
        </ws:getCustomerBankList>
    </soapenv:Body>
</soapenv:Envelope>

5. Send the xml request to ipsl

6. Receive the xml response

<soap:Envelope
    xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
    <soap:Body>
        <ns2:getCustomerBankListResponse
            xmlns:ns2="http://ws.lookupdb.mgw.cwt.ru/">
            <return>
                <destName>John smith</destName>
                <bankList>
                    <bank>
                        <bankname>IMBANK</bankname>
                        <def>true</def>
                        <lookupBankName>John smith </lookupBankName>
                        <sortCode>40457000</sortCode>
                    </bank>
                    <bank>
                        <bankname>Absa Bank Kenya</bankname>
                        <def>false</def>
                        <lookupBankName>Smith Miller John</lookupBankName>
                        <sortCode>40403000</sortCode>
                    </bank>
                </bankList>
            </return>
        </ns2:getCustomerBankListResponse>
    </soap:Body>
</soap:Envelope>

