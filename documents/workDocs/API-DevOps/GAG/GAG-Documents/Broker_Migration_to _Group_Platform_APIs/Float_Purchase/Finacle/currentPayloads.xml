1. Namecheck

<soapenv:Envelope
    xmlns:soapenv='http://schemas.xmlsoap.org/soap/envelope/'
    xmlns:ws='http://ws.equitybank/'>
    <soapenv:Header/>
    <soapenv:Body>
        <ws:authRequest>
            <dealer>
                <amount>20000.00</amount>
                <branchName>H/Q MAIN</branchName>
                <dealerAccountNumber>4012200414004</dealerAccountNumber>
                <dealerCode>0725927754</dealerCode>
                <dealerName></dealerName>
                <payMethod>?</payMethod>
                <payRef>?</payRef>
                <respCode></respCode>
            </dealer>
        </ws:authRequest>
    </soapenv:Body>
</soapenv:Envelope>

