##################################################
#---Getting the body
##################################################

#----Narrations for ATMS
IF (CUST.ATM.dccid =="SWT") THEN
	IF (CUST.ATM.command == "CWDR") THEN
		CUST.ATM.narr2 = "CASH"
		CUST.ATM.CustCardId = MID$(BANCS.INPUT.CustCardId,0,6)
		print(CUST.ATM.CustCardId)
		IF (CUST.ATM.CustCardId=="375156") THEN
			CUST.ATM.narr2 = "Cash Withdraw"
		ENDIF
	ENDIF

	IF (CUST.ATM.command == "CDAR") THEN
		CUST.ATM.narr2 = "DEPOSIT"
	ENDIF

	IF ((CUST.ATM.command == "TRTR") AND (BANCS.INPUT.ReservedField2=="CashIn")) THEN
		CUST.ATM.narr2 = "DEPOSIT"
	ENDIF

	IF (CUST.ATM.command == "CWRR") THEN
		CUST.ATM.narr2 = "REV"
	ENDIF
	IF (CUST.ATM.command == "CDRR") THEN
		CUST.ATM.narr2=" DEPOSIT REV"
	ENDIF
	IF ((CUST.ATM.command == "TRRR") AND (BANCS.INPUT.ReservedField2=="CashIn")) THEN
		CUST.ATM.narr2=" DEPOSIT REV"
	ENDIF

	IF ((CUST.ATM.command=="CRTR") OR (CUST.ATM.command=="DBTR")) THEN
		IF (BANCS.INPUT.PartTranType=="D") THEN
			sv_b ="FUNDS TO "
			sv_b = sv_b +  BANCS.INPUT.CrForacid
		ELSE
			sv_b ="FUNDS BY "
			sv_b = sv_b +  BANCS.INPUT.Foracid
		ENDIF
		CUST.ATM.narr2=sv_b
	ENDIF
	IF ((CUST.ATM.command=="DBRR") OR (CUST.ATM.command=="CRRR")) THEN
		IF (BANCS.INPUT.PartTranType=="D") THEN
			sv_b ="FUNDS REV TO "
			sv_b = sv_b +  BANCS.INPUT.Foracid
		ELSE
			sv_b ="FUNDS REV BY "
			sv_b = sv_b +  BANCS.INPUT.CrForacid
		ENDIF
		CUST.ATM.narr2=sv_b
	ENDIF
	
	IF (BANCS.INPUT.ReservedField2=="TOPUP") THEN
		CUST.ATM.narr1=""
		IF (CUST.ATM.command =="PRCR") THEN
			CUST.ATM.narr2="ATM-AIRTIME PURCHASE"	
		ENDIF

		IF (CUST.ATM.command =="PRRR") THEN
			CUST.ATM.narr2="ATM-AIRTIME REVERSAL"	
		ENDIF

	ENDIF

        ## for AUTOTOD ##
        IF (MID$(BANCS.INPUT.ReservedField2,0,15)=="AUTOTODAVAILREQ") THEN
                CUST.ATM.narr1=""
                IF (CUST.ATM.command == "DBTR") THEN
                        CUST.ATM.narr2="ATM/Avail TOD Charges"
                ENDIF
        ENDIF

	#---inculusion for eCash
	IF (FIELDEXISTS(BANCS.INPUT.ReservedField2) == 1) THEN
		print (BANCS.INPUT.ReservedField2)
		CUST.ATM.eCash=MID$(BANCS.INPUT.ReservedField2,0,8)
		CUST.ATM.eCashphone=MID$(BANCS.INPUT.ReservedField2,8,20)
		print(CUST.ATM.eCash)
		print(CUST.ATM.eCashphone)
		IF (CUST.ATM.eCash =="WAY4CBCG") THEN 
			BANCS.OUTPUT.RefNum=CUST.ATM.eCashphone
			CUST.ATM.narr2=CUST.ATM.narr1
			CUST.ATM.narr1="eCash "
		ENDIF
		IF (CUST.ATM.eCash =="WAY4CBCW") THEN
			BANCS.OUTPUT.RefNum=CUST.ATM.eCashphone
			CUST.ATM.narr2=CUST.ATM.narr1
			CUST.ATM.narr1="eCash "
		ENDIF
	ENDIF
	#---End inculusion for eCash

	#---inculusion for Mpesa
	IF (FIELDEXISTS(BANCS.INPUT.CrForacid) == 1) THEN
	
		IF (MID$(BANCS.INPUT.ReservedField2,0,8)=="VODAFONE") THEN
			CUST.ATM.mphone=MID$(BANCS.INPUT.ReservedField2,8,20)
			BANCS.OUTPUT.RefNum=CUST.ATM.mphone
			CUST.ATM.narr2=CUST.ATM.narr1
			CUST.ATM.narr1="MPesa "
			print(CUST.ATM.narr2)
		ENDIF
		
	ENDIF
	#---End inculusion for Mpesa

	If ((BANCS.INPUT.ReservedField2 !="") and (MID$(BANCS.INPUT.ReservedField2,0,8)!="VODAFONE") and (BANCS.INPUT.CrForacid !="") AND (BANCS.INPUT.ReservedField2 !="INTERC")AND (BANCS.INPUT.ReservedField2 !="INTERRCV") AND (BANCS.INPUT.ReservedField2 !="TOPUP") AND (CUST.ATM.eCash !="WAY4CBCG") AND (CUST.ATM.eCash !="WAY4CBCW") AND (BANCS.INPUT.ReservedField2!="CashIn")) THEN
		IF (BANCS.INPUT.PartTranType=="C") then	
			IF (BANCS.INPUT.CrForacid=="0550293271157") THEN
				BANCS.INPUT.ReservedField2=LTRIM(BANCS.INPUT.ReservedField2,'0')
			ENDIF
			sv_s = "count "
			sv_s = sv_s + " |"
			sv_s = sv_s + " SELECT COUNT(1) "
			sv_s = sv_s + " FROM DUAL "
			sv_s = sv_s + " WHERE EXISTS ( "
			sv_s = sv_s + " 		SELECT 1 "
			sv_s = sv_s + " 		FROM CUSTOM.C_CIC  "
			sv_s = sv_s + " 		WHERE acctnum = ?SVAR "
			sv_s = sv_s + " 	     ) "
			BANCS.INPARAM.BINDVARS =  BANCS.INPUT.CrForacid
			print(sv_s)
			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			IF (sv_d == 0) THEN  
				CUST.ATM.count = BANCS.OUTPARAM.count
			ELSE
				CUST.ATM.count ="0"
			ENDIF

			IF (CUST.ATM.count!=0) THEN 
				sv_s = "refNum,name |"
				sv_s = sv_s + " SELECT refnum,name "
				sv_s = sv_s + " FROM CUSTOM.C_CIC "
				sv_s = sv_s + " WHERE acctnum = ?SVAR "
				sv_s = sv_s + " AND refnum = ?SVAR "
				sv_s = sv_s + " AND del_flg = 'N' "
				sv_s = sv_s + " AND bank_id = '99' "
				BANCS.INPARAM.BINDVARS = BANCS.INPUT.CrForacid +"|" + BANCS.INPUT.ReservedField2
				print(sv_s)
				sv_d = urhk_dbSelectWithBind(sv_s)
				print(sv_d)
				IF ( sv_d != 0 ) then
					BANCS.OUTPUT.RespCode = "99"
					BANCS.OUTPUT.successOrFailure="F"
					GOTO ENDOFSCRIPT
				ELSE
					
					BANCS.OUTPUT.TranRemarks=BANCS.OUTPARAM.name
					BANCS.OUTPUT.RefNum=BANCS.OUTPARAM.refNum
					CUST.ATM.narr2="BILL PAYMENT"

				ENDIF
			ELSE
				sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.Foracid)
				BANCS.OUTPUT.TranRemarks = MID$(BANCS.OUTPARAM.acctName,0,34)
				CUST.ATM.narr2="BILL PAYMENT " + BANCS.OUTPUT.TranRemarks
				BANCS.OUTPUT.RefNum=BANCS.INPUT.ReservedField2

			ENDIF
		ELSE
			CUST.ATM.serial= LTRIM(CUST.ATM.serial,'0')
			BANCS.OUTPUT.RefNum=CUST.ATM.serial
			CUST.ATM.narr1=""
			CUST.ATM.narr2="BILL PAYMENT: "
			sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.CrForacid)
			CUST.ATM.narr3 = MID$(BANCS.OUTPARAM.acctName,0,34)
			print(CUST.ATM.narr3)
			BANCS.OUTPUT.TranRemarks="ATM"
		ENDIF
		IF (BANCS.INPUT.ReservedField2 !="") THEN
			print(BANCS.INPUT.ReservedField2)
			IF (BANCS.INPUT.ReservedField2 =="VMT") THEN
				CUST.ATM.narr2="VMT TRANSFER "
				IF ((CUST.ATM.command=="PRRR") OR (CUST.ATM.command=="DBRR") OR (CUST.ATM.command=="TRRR") OR (CUST.ATM.command=="CDRR") ) THEN
					CUST.ATM.narr2="REV VMT TRANSFER "
				ENDIF
			ENDIF
			IF (BANCS.INPUT.ReservedField2 =="WSTU") THEN
				CUST.ATM.narr2="WESTERN_UNION "
				IF ((CUST.ATM.command=="PRRR") OR (CUST.ATM.command=="DBRR") OR (CUST.ATM.command=="TRRR") OR (CUST.ATM.command=="CDRR") ) THEN
					CUST.ATM.narr2="REV WESTERN_UNION "
				ENDIF
			ENDIF
		ENDIF
	ENDIF

ENDIF

#---Narrations For E Banking

IF (CUST.ATM.dccid =="BWY") THEN
	CUST.ATM.narr1=""
	## narration issues
	sv_i=TRIM(LEFT$(BANCS.INPUT.ReservedField1,50))
	IF ((BANCS.INPUT.Command=="TRTR") or (BANCS.INPUT.Command=="TRRR") )THEN
		IF (strlen(sv_i)>0)THEN
			CUST.ATM.narr2 = sv_i
		ENDIF
		IF (strlen(sv_i) == 0) THEN
			IF (BANCS.INPUT.PartTranType=="D") THEN
				IF((BANCS.INPUT.PartTranIdentifier == "FEECUST1") OR (BANCS.INPUT.PartTranIdentifier == "FEECUST2") OR (BANCS.INPUT.PartTranIdentifier == "FEECUST3")) THEN
	                                sv_b ="eBank Transfer Charge"
	                        ELSE
	                                sv_b ="eBank Transfer To "
					sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.CrForacid)
					CUST.ATM.nameebank=BANCS.OUTPARAM.acctName
					sv_b = sv_b +  CUST.ATM.nameebank
					sv_b = MID$(sv_b,0,50)
	                        ENDIF
#				sv_b ="eBank Transfer To "
			ELSE
				IF((BANCS.INPUT.PartTranIdentifier == "FEECONTRA1") OR (BANCS.INPUT.PartTranIdentifier == "FEECONTRA2") OR (BANCS.INPUT.PartTranIdentifier == "FEECONTRA3")) THEN
					sv_b ="Charge Credit by "
				ELSE
					sv_b ="eBank Transfer by "
	                        ENDIF
#				sv_b ="eBank Transfer by "
				sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.Foracid)
				CUST.ATM.nameebankf=BANCS.OUTPARAM.acctName
				sv_b = sv_b +  CUST.ATM.nameebankf
				sv_b = MID$(sv_b,0,50)
			ENDIF
			IF (BANCS.INPUT.Command=="TRTR") then
				CUST.ATM.narr2 = sv_b
				IF (FIELDEXISTS(BANCS.INPUT.ReservedField2)) THEN
					IF((BANCS.INPUT.PartTranIdentifier != "FEECONTRA1") AND (BANCS.INPUT.PartTranIdentifier != "FEECONTRA2") AND (BANCS.INPUT.PartTranIdentifier != "FEECONTRA3") AND (BANCS.INPUT.PartTranIdentifier != "FEECUST1") AND (BANCS.INPUT.PartTranIdentifier != "FEECUST2") AND (BANCS.INPUT.PartTranIdentifier != "FEECUST3")) THEN
						IF (strlen(BANCS.INPUT.ReservedField2)>0)THEN
							CUST.ATM.narr2 = MID$(BANCS.INPUT.ReservedField2,0,50)
						ENDIF
					ENDIF
				ENDIF
				IF (FIELDEXISTS(BANCS.INPUT.ReservedField3)) THEN
					IF (strlen(BANCS.INPUT.ReservedField3)>0)THEN
						BANCS.OUTPUT.TranParticulars2 = MID$(BANCS.INPUT.ReservedField3,0,50)
					ENDIF
				ENDIF
			ENDIF
			IF (BANCS.INPUT.Command=="TRRR") THEN
				sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.CrForacid)
				CUST.ATM.nameebankrr = BANCS.OUTPARAM.acctName
				CUST.ATM.narr2 = "eBank Reversal for Transfer to " + CUST.ATM.nameebankrr
				CUST.ATM.narr2 = MID$(CUST.ATM.narr2,0,50)
			ENDIF
		ENDIF
		IF (BANCS.INPUT.ReservedField1 =="SPT") THEN
			CUST.ATM.narr2 = "eBank REMMITTANCE"
		ENDIF

                ## Setting Tran Particulars for AUTOTOD from BWY ##
                IF (MID$(BANCS.INPUT.ReservedField2,0,15)=="AUTOTODAVAILREQ") THEN
                        CUST.ATM.narr2 = "eBank Avail TOD Charges"
                ENDIF

	ENDIF
	BANCS.OUTPUT.RefNum = BANCS.INPUT.SerialNum
	CUST.ATM.narr3=""
	IF (FIELDEXISTS(BANCS.INPUT.ConsumerNum)) THEN
		BANCS.OUTPUT.RefNum = BANCS.INPUT.ConsumerNum
		print(BANCS.OUTPUT.RefNum)
	ENDIF
	IF ((BANCS.INPUT.ConsumerNum !="") and (BANCS.INPUT.CrForacid !="")) THEN
		IF (BANCS.INPUT.PartTranType=="C") then       
			IF (BANCS.INPUT.CrForacid=="0550293271157") THEN
				BANCS.INPUT.ConsumerNum =LTRIM(BANCS.INPUT.ConsumerNum,'0')
			ENDIF

			sv_s = "count "
			sv_s = sv_s + " |"
			sv_s = sv_s + " SELECT COUNT(1) "
			sv_s = sv_s + " FROM DUAL "
			sv_s = sv_s + " WHERE EXISTS ( "
			sv_s = sv_s + " 		SELECT 1 "
			sv_s = sv_s + " 		FROM CUSTOM.C_CIC  "
			sv_s = sv_s + " 		WHERE acctnum = ?SVAR "
			sv_s = sv_s + " 	     ) "
			BANCS.INPARAM.BINDVARS = BANCS.INPUT.CrForacid
			print(sv_s)
			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			IF (sv_d == 0) THEN  
				CUST.ATM.count = BANCS.OUTPARAM.count
			ELSE
				CUST.ATM.count ="0"
			ENDIF
			IF (CUST.ATM.count!=0) THEN 
				sv_s = "refNum,name "
				sv_s = sv_s + " | "
				sv_s = sv_s + " SELECT refnum,name "
				sv_s = sv_s + " FROM CUSTOM.C_CIC "
				sv_s = sv_s + " WHERE acctnum = ?SVAR  "
				sv_s = sv_s + " AND refnum = ?SVAR "
				sv_s = sv_s + " AND del_flg = 'N' "
				sv_s = sv_s + " AND bank_id = '99' "
				BANCS.INPARAM.BINDVARS = BANCS.INPUT.CrForacid + "|" + BANCS.INPUT.ConsumerNum 
				print(sv_s)
				sv_d = urhk_dbSelectWithBind(sv_s)
				print(sv_d)
				IF ( sv_d != 0 ) then
					BANCS.OUTPUT.RespCode = "99"
					BANCS.OUTPUT.successOrFailure="F"
					GOTO ENDOFSCRIPT
				ELSE
					BANCS.OUTPUT.TranRemarks=MID$(BANCS.OUTPARAM.name,0,30)
					BANCS.OUTPUT.RefNum=BANCS.OUTPARAM.refNum
					CUST.ATM.narr2="BILL PAYMENT " + BANCS.OUTPUT.TranRemarks
				ENDIF
			ELSE
				sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.Foracid)
				BANCS.OUTPUT.TranRemarks = MID$(BANCS.OUTPARAM.acctName,0,34)
				CUST.ATM.narr2="BILL PAYMENT: "
				BANCS.OUTPUT.RefNum=BANCS.INPUT.ConsumerNum 

			ENDIF
		ELSE   
			CUST.ATM.narr1=""
			CUST.ATM.narr2="BILL PAYMENT: "
			sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.CrForacid)
			CUST.ATM.narr3 = MID$(BANCS.OUTPARAM.acctName,0,34)
			print(CUST.ATM.narr3)

		ENDIF
	ENDIF
	IF (BANCS.INPUT.ReservedField2 =="TXP") THEN
		IF (BANCS.INPUT.ReservedField1!="") THEN
			print(BANCS.INPUT.ReservedField1) 

			sv_r = REPEXISTS("COLL")
			IF (sv_r == 0) THEN
				CREATEREP("COLL")
			ENDIF

			sv_r = CLASSEXISTS("COLL", "GLBDATA")
			IF (sv_r == 0) THEN
				CREATECLASS("COLL", "GLBDATA", 5)
			ENDIF

			sv_s = BANCS.INPUT.ReservedField1
			print(sv_s)
			sv_u = "waterrefnum,EslipDetails1|select substr(?SVAR,1,instr(?SVAR,'?') - 1) ,substr(?SVAR,instr(?SVAR,'?') + 1) from dual "
			print(sv_u)
			BANCS.INPARAM.BINDVARS = sv_s + "|" + sv_s + "|" + sv_s + "|" + sv_s
			sv_w=urhk_dbSelectWithBind(sv_u)
			print(sv_w)
			COLL.GLBDATA.waterrefnum = trim(BANCS.OUTPARAM.waterrefnum)
			print(COLL.GLBDATA.waterrefnum)
			COLL.GLBDATA.EslipDetails1 = BANCS.OUTPARAM.EslipDetails1
			print(COLL.GLBDATA.EslipDetails1)
			
			BANCS.OUTPUT.RefNum = COLL.GLBDATA.waterrefnum
			print(BANCS.OUTPUT.RefNum)
		ENDIF
	ENDIF
ENDIF

 #---Narrations For VISA
IF (CUST.ATM.dccid =="BS1") THEN

	IF (CUST.ATM.command =="CWDR") THEN
		CUST.ATM.narr2="ATM"	
	ENDIF
	IF (CUST.ATM.command =="CWRR") THEN
		CUST.ATM.narr2="REV"	
	ENDIF
	IF (CUST.ATM.command =="PRCR") THEN
		CUST.ATM.narr2="PUR"	
