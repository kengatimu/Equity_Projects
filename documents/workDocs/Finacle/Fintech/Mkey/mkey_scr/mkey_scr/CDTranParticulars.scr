                        #{
                        BANCS.INPUT.ReservedField1 =  MID$(BANCS.INPUT.ReservedField1,0,getposition(BANCS.INPUT.ReservedField1,"-")-1)
                        BANCS.OUTPUT.ReservedField1 = BANCS.INPUT.ReservedField1
                        print(BANCS.OUTPUT.ReservedField1)
                        #}
                        ENDIF

                ENDIF
        ENDIF
	IF (FIELDEXISTS(BANCS.INPUT.ConsumerNum)) THEN
		BANCS.OUTPUT.RefNum = BANCS.INPUT.ConsumerNum
		print(BANCS.OUTPUT.RefNum)
	ENDIF
#}
ENDIF

#Beginning of changes done for splitting of debit and credit part trans-07 Nov 2013
IF(BANCS.INPUT.PartTranIdentifier == "CUST") THEN
#{
