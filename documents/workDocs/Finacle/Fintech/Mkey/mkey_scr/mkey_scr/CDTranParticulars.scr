#--Validation for Safaricom dealership
IF (FIELDEXISTS(BANCS.INPUT.CrForacid) == 1) THEN
	IF (BANCS.INPUT.CrForacid=="0810297617335") THEN 
		IF ((CUST.ATM.dccid == "SWT")OR (CUST.ATM.dccid == "WPD")) THEN 
			CUST.ATM.dealercode=BANCS.INPUT.ReservedField2
		ENDIF
		IF (CUST.ATM.dccid == "BWY") THEN 
			CUST.ATM.dealercode=CUST.ATM.dealercode
			print(CUST.ATM.dealercode)
		ENDIF
		IF ((CUST.ATM.dccid =="EAZ") OR (CUST.ATM.dccid =="SMS") OR (CUST.ATM.dccid =="WYM") OR (CUST.ATM.dccid =="OMK")  OR (CUST.ATM.dccid =="AIR")) THEN
			CUST.ATM.dealercode=BANCS.INPUT.CardAcceptorName
		ENDIF
		IF (FIELDEXISTS(CUST.ATM.dealercode) == 1) THEN
			print(CUST.ATM.dealercode)
			sv_s = "count|"
			sv_s = sv_s + " SELECT COUNT(1) "
			sv_s = sv_s + " FROM DUAL  "
			sv_s = sv_s + " WHERE EXISTS ( "
			sv_s = sv_s + " 		SELECT 1 "
			sv_s = sv_s + " 		FROM CUSTOM.C_CIC  "
			sv_s = sv_s + " 		WHERE acctnum = ?SVAR ) "
			BANCS.INPARAM.BINDVARS = BANCS.INPUT.CrForacid
			print(sv_s)
			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			IF (sv_d == 0) THEN  
				CUST.ATM.count = BANCS.OUTPARAM.count
			ELSE
				CUST.ATM.count ="0"
			ENDIF

			IF (CUST.ATM.count!=0) THEN 
				sv_s = "refNum,name|"
				sv_s = sv_s + " SELECT refnum,name "
				sv_s = sv_s + " FROM CUSTOM.C_CIC "
				sv_s = sv_s + " WHERE acctnum = ?SVAR "
				sv_s = sv_s + " AND refnum = ?SVAR "
				sv_s = sv_s + " AND del_flg = 'N' "
				sv_s = sv_s + " AND bank_id ='99' "
				BANCS.INPARAM.BINDVARS = BANCS.INPUT.CrForacid + "|" + CUST.ATM.dealercode
				print(sv_s)
				sv_d = urhk_dbSelectWithBind(sv_s)
				print(sv_d)
				IF ( sv_d != 0 ) then
					BANCS.OUTPUT.RespCode = "99"
					BANCS.OUTPUT.successOrFailure="F"
					GOTO ENDOFSCRIPT
				ELSE
					BANCS.OUTPUT.TranRemarks=MID$(BANCS.OUTPARAM.name,0,30)
					BANCS.OUTPUT.RefNum=BANCS.OUTPARAM.refNum
					CUST.ATM.narr2 = "SAF.DEALER /" + BANCS.OUTPARAM.refNum + "/" + BANCS.OUTPUT.TranRemarks
				ENDIF
			ELSE
				BANCS.OUTPUT.RespCode = "99"
				BANCS.OUTPUT.successOrFailure="F"
				GOTO ENDOFSCRIPT
				
			ENDIF
		ELSE
			BANCS.OUTPUT.RespCode = "99"
			BANCS.OUTPUT.successOrFailure="F"
			GOTO ENDOFSCRIPT
		ENDIF
	ENDIF
ENDIF

