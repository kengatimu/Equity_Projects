				BANCS.OUTPUT.RespCode = "99"
				BANCS.OUTPUT.successOrFailure="F"
				GOTO ENDOFSCRIPT
			ELSE
				BANCS.OUTPUT.TranRemarks=BANCS.OUTPARAM.memCode+"/"+BANCS.OUTPARAM.memType+"-"+BANCS.OUTPARAM.prefix
			ENDIF
			
			CUST.ATM.narr3=BANCS.INPUT.CardAcceptorName
			
		ENDIF	
		
