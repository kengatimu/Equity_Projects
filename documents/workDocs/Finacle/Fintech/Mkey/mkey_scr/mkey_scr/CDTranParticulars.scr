ENDIF

IF(((BANCS.INPUT.Command == "TRTR") OR (BANCS.INPUT.Command == "TRRR"))AND (BANCS.INPUT.DccId == "BWY")) THEN
#{
        IF (FIELDEXISTS(BANCS.INPUT.ReservedField1)) THEN
		CUST.ATM.dealercode = BANCS.INPUT.ReservedField1
