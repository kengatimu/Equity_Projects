		CUST.ATM.narr3="/"+CUST.ATM.serial
		print(CUST.ATM.narr1)
		print(CUST.ATM.narr1)
		print(CUST.ATM.narr3)
		
	ENDIF

	
ENDIF
#---Inculusion for IPO
IF ((BANCS.INPUT.DccId == "SWT") OR (BANCS.INPUT.DccId == "WYM") OR(BANCS.INPUT.DccId == "EAZ") OR (BANCS.INPUT.DccId == "OMK") OR (BANCS.INPUT.DccId == "WPD")) THEN
	IF ((BANCS.INPUT.CrForacid!="")AND (BANCS.INPUT.CrForacid!="VODAFONE" ))THEN
		print(BANCS.INPUT.CrForacid)
		sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.CrForacid)
		sv_h = BANCS.OUTPARAM.acctPlaceHolder
		IF ((sv_h=="SAFCC") OR (sv_h=="BTKCC")  OR (sv_h=="KPLCCC"))THEN
			print ("IPO")
			IF (CUST.ATM.dccid == "BWY")THEN
				#--Ebanking
				CUST.ATM.ipocdsnumber=BANCS.INPUT.ConsumerNum
			ENDIF
			IF ((CUST.ATM.dccid == "SWT") OR (CUST.ATM.dccid == "WPD") OR (CUST.ATM.dccid == "HPD"))THEN
				#--WAY4
				CUST.ATM.ipocdsnumber=BANCS.INPUT.ReservedField2
			ENDIF
		
			IF ((CUST.ATM.dccid == "EAZ") OR (CUST.ATM.dccid == "OMK") OR (CUST.ATM.dccid == "WYM"))THEN
				#--Eazzy247 and Orange Money
				CUST.ATM.ipocdsnumber=BANCS.INPUT.CardAcceptorName
			ENDIF
			CUST.ATM.ipoaccount=BANCS.INPUT.CrForacid
			CUST.ATM.ipoamount=CDOUBLE(BANCS.INPUT.TranAmt)/CDOUBLE("100")
			CUST.ATM.appfees=MID$(BANCS.INPUT.Fee,16,2)
			CUST.ATM.ipoamount=CDOUBLE(CUST.ATM.ipoamount) + CDOUBLE(CUST.ATM.appfees)
			print(CUST.ATM.appfees)
			print(CUST.ATM.ipocdsnumber)
			print(CUST.ATM.ipoaccount)
			print(CUST.ATM.ipoamount)
			sv_u = "response "
			sv_s = sv_s + " | "
			sv_s = sv_s + " SELECT IPO.VALIDATE_IPO_APPLICATION (?SVAR,?SVAR,?SVAR) "
			sv_s = sv_s + " FROM DUAL "
			BANCS.INPARAM.BINDVARS = CUST.ATM.ipocdsnumber + "|" + CUST.ATM.ipoaccount + "|" + CUST.ATM.ipoamount
			print(sv_s)
			sv_d = urhk_dbSelectWithBind(sv_s)
			IF (sv_d == 0 ) THEN
				CUST.ATM.cdsc = MID$(BANCS.OUTPARAM.response,0,1)
				print(CUST.ATM.cdsc)
				CUST.ATM.response = MID$(BANCS.OUTPARAM.response,2,2)
				print(CUST.ATM.response)
				CUST.ATM.iponame= MID$(BANCS.OUTPARAM.response,5,50)
				print(CUST.ATM.iponame)
				IF (CUST.ATM.response != "00") THEN 
					BANCS.OUTPUT.RespCode = "99"
					BANCS.OUTPUT.successOrFailure = "F"
					GOTO ENDOFSCRIPT
				ELSE
					IF (BANCS.INPUT.PartTranType=="C")  THEN
						CUST.ATM.narr2="IPO PAYMENT"
						BANCS.OUTPUT.TranRemarks=CUST.ATM.iponame
						IF ((CUST.ATM.cdsc =="C") OR (CUST.ATM.cdsc =="T")) THEN 
							IF (CUST.ATM.cdsc =="C") THEN 
								BANCS.OUTPUT.RefNum="R/EQBC/C-"+CUST.ATM.ipocdsnumber
								
							ELSE
								BANCS.OUTPUT.RefNum="R/EQT/"+CUST.ATM.ipocdsnumber
							ENDIF
							
						ELSE
							BANCS.OUTPUT.RefNum=CUST.ATM.ipocdsnumber
						ENDIF
						
						print(BANCS.OUTPUT.RefNum)
					ELSE
						CUST.ATM.serial= LTRIM(CUST.ATM.serial,'0')
						BANCS.OUTPUT.RefNum=CUST.ATM.serial
						CUST.ATM.narr1=""
						CUST.ATM.narr2="IPO PAYMENT: "
						sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.CrForacid)
						CUST.ATM.narr3 = MID$(BANCS.OUTPARAM.acctName,0,34)
						print(CUST.ATM.narr3)
						#BANCS.OUTPUT.TranRemarks="POS"
					ENDIF
				ENDIF
			ENDIF
			
		ENDIF
	ENDIF
ENDIF
