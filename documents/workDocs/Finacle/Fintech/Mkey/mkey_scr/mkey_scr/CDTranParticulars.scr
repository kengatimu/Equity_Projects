    CUST.ATM.errMsg = "Credit Foracid setup not done in CPARAM"
    GOTO ENDOFSCRIPT
#}
ENDIF
BANCS.INPUT.moduleName  = "ATM"
BANCS.INPUT.parameterId = "CRFORACID_5"

CALL ("atmgetcparamvalue.scr")

IF(BANCS.OUTPUT.parameterVal != "")THEN
#{
    CUST.ATM.crForAcid5 = BANCS.OUTPUT.parameterVal
#}
ELSE
#{
    CUST.ATM.errMsg = "Credit Foracid setup not done in CPARAM"
    GOTO ENDOFSCRIPT
