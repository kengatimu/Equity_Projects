		CUST.ATM.INSU=MID$(BANCS.INPUT.ReservedField1,0,4)
		print(CUST.ATM.INSU)
	ENDIF
	IF ((CUST.ATM.INSU != "IBLI") AND (CUST.ATM.INSU != "CLAI") )THEN 
		sv_s = " name "
		sv_s = sv_s + " | "
		sv_s = sv_s + " SELECT merchant_desc "
		sv_s = sv_s + " FROM CUSTOM.C_MERCHANTS "
		sv_s = sv_s + " WHERE merchant_id = ?SVAR "
		sv_s = sv_s + " AND del_flg ='N' "
		BANCS.INPARAM.BINDVARS = BANCS.INPUT.CrForacid
		print(sv_s)
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF  (sv_d == "0") then
			BANCS.OUTPUT.Name= BANCS.OUTPARAM.name
			print(BANCS.OUTPUT.Name)
			IF (BANCS.INPUT.PartTranType=="C")  THEN
				CUST.ATM.narr2="WITHDRAWAL"
				BANCS.OUTPUT.RefNum=BANCS.INPUT.ReservedField1
			ELSE
				CUST.ATM.narr2=BANCS.OUTPUT.Name
				BANCS.OUTPUT.RefNum=BANCS.INPUT.ReservedField1
			ENDIF

		ELSE
			BANCS.OUTPUT.RespCode = "99"
			BANCS.OUTPUT.successOrFailure = "F"
			GOTO ENDOFSCRIPT
		ENDIF
	ENDIF
	IF ((CUST.ATM.INSU=="IBLI") OR (CUST.ATM.INSU=="CLAI"))THEN 
		IF (CUST.ATM.INSU=="IBLI") THEN
			CUST.ATM.narr1="IBLI/"
		ELSE
			CUST.ATM.narr1="CLAIM/"
		ENDIF
		BANCS.OUTPUT.RefNum=BANCS.INPUT.ReservedField2
		BANCS.OUTPUT.TranRemarks=MID$(BANCS.INPUT.ReservedField1,5,50)
