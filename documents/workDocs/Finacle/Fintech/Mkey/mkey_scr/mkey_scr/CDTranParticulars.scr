IF(BANCS.OUTPUT.parameterVal != "")THEN
#{
    CUST.ATM.crForAcid3 = BANCS.OUTPUT.parameterVal
#}
ELSE
#{
    CUST.ATM.errMsg = "Credit Foracid setup not done in CPARAM"
    GOTO ENDOFSCRIPT
#}
ENDIF
#{

CUST.ATM.narr1="ABC/"
CUST.ATM.narr2="TRANSACTIONS"
CUST.ATM.command = BANCS.INPUT.Command
CUST.ATM.dccid = BANCS.INPUT.DccId
CUST.ATM.Particulars = BANCS.OUTPUT.TranParticulars
CUST.ATM.acceptorName = BANCS.INPUT.CardAcceptorName
CUST.ATM.DeviceId = BANCS.INPUT.DeviceId
CUST.ATM.serial= BANCS.INPUT.SerialNum
IF (CUST.ATM.dccid !="SMS") THEN
	CUST.ATM.serial= LTRIM(CUST.ATM.serial,'0') 
ELSE
	CUST.ATM.serial=MID$(CUST.ATM.serial,6,6)
ENDIF
IF (CUST.ATM.dccid =="EFR") THEN
	IF (BANCS.INPUT.ReservedField2!="") THEN
		IF (BANCS.INPUT.ReservedField2=="efrstopCheque") THEN
			CUST.ATM.narr1="Efront/"
			CUST.ATM.narr2="STOP Cheque"
		ELSE
			IF (BANCS.INPUT.ReservedField2=="efrdeposit") THEN
				CUST.ATM.narr1="Efront/"
				CUST.ATM.narr2="CASH DEPOSIT"
			ELSE
				CUST.ATM.narr1="Efront/"
				CUST.ATM.narr2="CASH WITHDRAWAL"
			ENDIF
		ENDIF
	ELSE
		CUST.ATM.narr1="Efront/"
		CUST.ATM.narr2="CASH WITHDRAWAL"
	ENDIF
ENDIF
IF ( (CUST.ATM.dccid =="MPA") OR (CUST.ATM.dccid =="KEN") OR (CUST.ATM.dccid =="INT") OR (CUST.ATM.dccid =="TPG") OR (CUST.ATM.dccid =="OMK")OR (CUST.ATM.dccid =="SMS")OR (CUST.ATM.dccid =="EAZ") OR (CUST.ATM.dccid =="SWT") OR (CUST.ATM.dccid =="WPD") OR (CUST.ATM.dccid =="BS1") OR (CUST.ATM.dccid =="WYM") OR (CUST.ATM.dccid =="AME") OR (CUST.ATM.dccid =="MC1")) THEN
	IF (CUST.ATM.dccid =="WPD") THEN
		IF (BANCS.INPUT.ReservedField2 != "") THEN 
			CUST.ATM.reversed2 = BANCS.INPUT.ReservedField2
			print(CUST.ATM.reversed2)
			sv_k = MID$(BANCS.INPUT.ReservedField2,0,5)
			print(sv_k)
			sv_w = MID$(BANCS.INPUT.ReservedField2,5,14)
			print(sv_w)
			IF ((sv_k=="ACCT:") OR (sv_k=="BILL:") OR (sv_k =="COLL:")) THEN			
				BANCS.INPUT.ReservedField3 = sv_w
				print(BANCS.INPUT.ReservedField3)		
				CUST.ATM.serial= LTRIM(BANCS.INPUT.ReservedField3,'0') 
				print(CUST.ATM.serial)
				IF ((sv_k=="ACCT:") OR (sv_k =="COLL:")) THEN
					sv_v=MID$(CUST.ATM.reversed2,19,20)
					print(sv_v)
					BANCS.OUTPUT.RefNum = trim(sv_v)
					#print(BANCS.OUTPUT.RefNum)
					IF (sv_k=="ACCT:") THEN 
						CUST.ATM.narr2="T-BY:"
						CUST.ATM.narr2=CUST.ATM.narr2 + BANCS.OUTPUT.RefNum
						sv_g = MID$(CUST.ATM.narr2,0,22)
						#print(sv_g)
						CUST.ATM.narr2=sv_g
						#print(CUST.ATM.narr2)
						IF (BANCS.INPUT.CrForacid=="0820272032149") THEN
							IF (BANCS.OUTPUT.RefNum=="") THEN
								BANCS.OUTPUT.RespCode = "99"
								BANCS.OUTPUT.successOrFailure="F"
								GOTO ENDOFSCRIPT
							ENDIF
						ENDIF
					ENDIF
					IF (sv_k=="COLL:") THEN 
						CUST.ATM.narr2="C-BY:"
						CUST.ATM.narr2=CUST.ATM.narr2 + BANCS.OUTPUT.RefNum
						sv_g = MID$(CUST.ATM.narr2,0,22)
						#print(sv_g)
						CUST.ATM.narr2=sv_g
						#print(CUST.ATM.narr2)
						IF ((BANCS.INPUT.CrForacid=="0180293054495") OR (BANCS.INPUT.CrForacid=="0820272032149")) THEN
							IF (BANCS.OUTPUT.RefNum=="") THEN
								BANCS.OUTPUT.RespCode = "99"
								BANCS.OUTPUT.successOrFailure="F"
								GOTO ENDOFSCRIPT
							ENDIF
						ENDIF
					ENDIF
				ENDIF
				IF (sv_k =="BILL:") THEN
					sv_v=MID$(CUST.ATM.reversed2,19,20)
					print(sv_v)
					BANCS.OUTPUT.RefNum = trim(sv_v)
					print(BANCS.OUTPUT.RefNum)
					sv_z = BANCS.INPUT.ReservedField1
					print(sv_z)
					sv_s = "acctnum "
					sv_s = sv_s + " | "
					sv_s = sv_s + " SELECT acctnum "
					sv_s = sv_s + " FROM CUSTOM.C_CIC_BILLS "
					sv_s = sv_s + " WHERE refnum = ?SVAR "
					sv_s = sv_s + " AND del_flg ='N' "
					sv_s = sv_s + " AND bank_id = '99' "
					BANCS.INPARAM.BINDVARS = sv_z
					sv_d =urhk_dbSelectWithBind(sv_s)
					print(sv_d)
					IF (sv_d == "0") THEN
						CUST.ATM.crForacid1 = BANCS.OUTPARAM.acctnum
						print(CUST.ATM.crForacid1)
					ELSE
						BANCS.OUTPUT.RespCode = "99"
						BANCS.OUTPUT.successOrFailure = "F"
						GOTO ENDOFSCRIPT
					ENDIF
					sv_s = "count|"
					sv_s = sv_s + "SELECT COUNT(1) "
					sv_s = sv_s + " FROM DUAL "
					sv_s = sv_s + " WHERE EXISTS( "
					sv_s = sv_s + " 		SELECT 1 "
					sv_s = sv_s + " 		FROM CUSTOM.C_CIC  "
					sv_s = sv_s + " 		WHERE acctnum = ?SVAR "
					sv_s = sv_s + " 	    ) "
					BANCS.INPARAM.BINDVARS = CUST.ATM.crForacid1
					print(sv_s)
					sv_d=urhk_dbSelectWithBind(sv_s)
					print(sv_d)
					IF (sv_d == 0) THEN  
						CUST.ATM.count = BANCS.OUTPARAM.count
					ELSE
						CUST.ATM.count ="0"
					ENDIF
					IF (CUST.ATM.count!=0) THEN 
					    IF ((CUST.ATM.crForacid1!=CUST.ATM.crForAcid4) AND (CUST.ATM.crForacid1!=CUST.ATM.crForAcid2) AND (CUST.ATM.crForacid1!=CUST.ATM.crForAcid3) AND (CUST.ATM.crForacid1!=CUST.ATM.crForAcid5)) THEN
						sv_s = "refNum,name "
						sv_s = sv_s + " |"
						sv_s = sv_s + " select refnum,name "
						sv_s = sv_s + " FROM CUSTOM.C_CIC "
						sv_s = sv_s + " WHERE acctnum = ?SVAR  "
						sv_s = sv_s + " AND refNum = ?SVAR "
						sv_s = sv_s + " AND del_flg = 'N' "
						sv_s = sv_s + " AND bank_id = '99' "
						BANCS.INPARAM.BINDVARS = CUST.ATM.crForacid1 + "|" + BANCS.OUTPUT.RefNum 
						print(sv_s)
						sv_d = urhk_dbSelectWithBind(sv_s)
						print(sv_d)
						IF ( sv_d != 0 ) then
							BANCS.OUTPUT.RespCode = "99"
							BANCS.OUTPUT.successOrFailure="F"
							GOTO ENDOFSCRIPT
						ELSE
							BANCS.OUTPUT.TranRemarks=BANCS.OUTPARAM.name
							BANCS.OUTPUT.RefNum=BANCS.OUTPARAM.refNum
							CUST.ATM.narr2="BPAY:"
							print(CUST.ATM.narr2)
							print(BANCS.OUTPARAM.refNum)
							CUST.ATM.narr2 = CUST.ATM.narr2 + " " + BANCS.OUTPARAM.refNum
							sv_g = MID$(CUST.ATM.narr2,0,22)
							print(sv_g)
							CUST.ATM.narr2=sv_g
							print(CUST.ATM.narr2)
						ENDIF
					    ENDIF
					ENDIF
				ENDIF
			ELSE 
				CUST.ATM.serial= LTRIM(BANCS.INPUT.ReservedField3,'0') 
				print(CUST.ATM.serial)
			ENDIF
		ELSE 
			CUST.ATM.serial= LTRIM(BANCS.INPUT.ReservedField3,'0') 
			print(CUST.ATM.serial)
		ENDIF
		BANCS.OUTPUT.TranParticulars2=BANCS.INPUT.DeviceId
		print(BANCS.OUTPUT.TranParticulars2)
	ELSE
		CUST.ATM.serial= LTRIM(BANCS.INPUT.ReservedField3,'0') 
		print(CUST.ATM.serial)
	ENDIF
ENDIF

sv_b  = "/"
sv_a = sv_b + CUST.ATM.serial
sv_a = sv_a + sv_b
CUST.ATM.time = MID$(CUST.ATM.Particulars,18,19) 
print(CUST.ATM.time)
sv_a = sv_a + CUST.ATM.time
CUST.ATM.narr3 = sv_a
print(CUST.ATM.narr3)

##################################################
#---Getting the channel header
##################################################

IF (CUST.ATM.dccid =="SWT") THEN
	#CUST.ATM.narr1="ATM-"
	sv_d = "/"
	sv_a=MID$(BANCS.INPUT.CardAcceptorName,0,16) + sv_d
	print(sv_a)
	#sv_b ="ATM-"
	sv_c =  sv_a
	print(sv_c)
	CUST.ATM.narr1= sv_c
ENDIF
IF (CUST.ATM.dccid =="FAB") THEN
	CUST.ATM.narr1="FAB-"
ENDIF
IF (CUST.ATM.dccid =="BWY") THEN
	CUST.ATM.narr1="EBANK-"
ENDIF
IF (CUST.ATM.dccid == "NKI")THEN
	CUST.ATM.narr1="MCHNT-"
ENDIF
IF (CUST.ATM.dccid == "KEN") THEN
	CUST.ATM.narr1="KEN-"
ENDIF
IF (CUST.ATM.dccid == "INT") THEN
	CUST.ATM.narr1="INT-"
ENDIF
IF ( (CUST.ATM.dccid == "WPD") OR (CUST.ATM.dccid == "HPD"))THEN
	CUST.ATM.narr1="POS-"
ENDIF
IF (CUST.ATM.dccid == "BS1")THEN
	sv_d = "/"
	sv_a=MID$(BANCS.INPUT.CardAcceptorName,0,18) + sv_d
	print(sv_a)
	sv_b ="VISA-"
	sv_h= MID$(CUST.ATM.DeviceId,0,3) 
         print(sv_h) 
         print(CUST.ATM.command) 
         IF (BANCS.INPUT.ReservedField1=="VMTIN") THEN 
                 IF (CUST.ATM.command=="DBTR")  THEN 
                         sv_b ="VMTOCT-" 
                        print(sv_b) 
                 ENDIF 
                 IF (CUST.ATM.command=="DBRR")  THEN 
                         sv_b ="REV_VMTOCT-" 
                         print(sv_b) 
                 ENDIF 
         ENDIF 
         print(sv_b) 
         sv_c = sv_b + sv_a 
         print(sv_c) 
         CUST.ATM.narr1= sv_c 
 ENDIF 
 IF (CUST.ATM.dccid == "MC1")THEN 
         sv_d = "/" 
         sv_a=mid$(BANCS.INPUT.CardAcceptorName,0,18) + sv_d 
         print(sv_a) 
	 sv_b ="MasterCard-" 
	sv_h= MID$(CUST.ATM.DeviceId,0,3)
	print(sv_h)
	print(CUST.ATM.command)
	IF (BANCS.INPUT.ReservedField1=="VMTIN") THEN
		IF (CUST.ATM.command=="DBTR")  THEN
			sv_b ="VMTOCT-"
			print(sv_b)
		ENDIF
		IF (CUST.ATM.command=="DBRR")  THEN
			sv_b ="REV_VMTOCT-"
			print(sv_b)
		ENDIF
	ENDIF
	print(sv_b)
	sv_c = sv_b + sv_a
	print(sv_c)
	CUST.ATM.narr1= sv_c
ENDIF
IF (CUST.ATM.dccid == "AME")THEN 
         sv_d = "/" 
         sv_a=mid$(BANCS.INPUT.CardAcceptorName,0,18) + sv_d 
         print(sv_a) 
	 sv_b ="AMEX-" 
	sv_h= MID$(CUST.ATM.DeviceId,0,3)
	print(sv_h)
	print(CUST.ATM.command)
	IF (BANCS.INPUT.ReservedField1=="VMTIN") THEN
		IF (CUST.ATM.command=="DBTR")  THEN
			sv_b ="VMTOCT-"
			print(sv_b)
		ENDIF
		IF (CUST.ATM.command=="DBRR")  THEN
			sv_b ="REV_VMTOCT-"
			print(sv_b)
		ENDIF
	ENDIF
	print(sv_b)
	sv_c = sv_b + sv_a
	print(sv_c)
	CUST.ATM.narr1= sv_c
ENDIF
IF (CUST.ATM.dccid == "C24")THEN
	CUST.ATM.narr1="HSNP-"
ENDIF
IF (CUST.ATM.dccid =="EAZ")THEN
	#CUST.ATM.narr1="EAZZY-"
	CUST.ATM.narr1=""
	IF ((CUST.ATM.command=="CWRR") OR (CUST.ATM.command=="DBRR") OR (CUST.ATM.command=="TRRR") OR (CUST.ATM.command=="CDRR") ) THEN
		CUST.ATM.narr1="REV EAZZY-"
	ENDIF
	IF (BANCS.INPUT.ReservedField2 !="") THEN
		IF ((BANCS.INPUT.ReservedField2 =="P2PIntraMer") OR (BANCS.INPUT.ReservedField2 =="P2PIntraMerWCB") OR (BANCS.INPUT.ReservedField2 =="P2PIntraMerCB") OR (BANCS.INPUT.ReservedField2 =="P2PIntraMerPayBill")) THEN
			IF (BANCS.INPUT.ReservedField2 =="P2PIntraMer") THEN
				IF((BANCS.INPUT.PartTranIdentifier == "FEECONTRA1") OR (BANCS.INPUT.PartTranIdentifier == "FEECONTRA2") OR (BANCS.INPUT.PartTranIdentifier == "FEECONTRA3") OR (BANCS.INPUT.PartTranIdentifier == "FEECUST1") OR (BANCS.INPUT.PartTranIdentifier == "FEECUST2") OR (BANCS.INPUT.PartTranIdentifier == "FEECUST3")) THEN
					CUST.ATM.narr1="EAZZYPAY CHARGE"
				ELSE
					CUST.ATM.narr1="EAZZYPAY"
				ENDIF
				CUST.ATM.narr2=""
				IF ((CUST.ATM.command=="CWRR") OR (CUST.ATM.command=="DBRR") OR (CUST.ATM.command=="TRRR") OR (CUST.ATM.command=="CDRR") ) THEN
					IF ((BANCS.INPUT.PartTranIdentifier == "FEECONTRA1") OR (BANCS.INPUT.PartTranIdentifier == "FEECONTRA2") OR (BANCS.INPUT.PartTranIdentifier == "FEECONTRA3") OR (BANCS.INPUT.PartTranIdentifier == "FEECUST1") OR (BANCS.INPUT.PartTranIdentifier == "FEECUST2") OR (BANCS.INPUT.PartTranIdentifier == "FEECUST3")) THEN
						CUST.ATM.narr1="REV EAZZYPAY CHARGE"
					ELSE
						CUST.ATM.narr1="REV EAZZYPAY"
					ENDIF
					CUST.ATM.narr2=""
				ENDIF
			ENDIF
			IF (BANCS.INPUT.ReservedField2 =="P2PIntraMerWCB") THEN
				IF((BANCS.INPUT.PartTranIdentifier == "FEECONTRA1") OR (BANCS.INPUT.PartTranIdentifier == "FEECONTRA2") OR (BANCS.INPUT.PartTranIdentifier == "FEECONTRA3") OR (BANCS.INPUT.PartTranIdentifier == "FEECUST1") OR (BANCS.INPUT.PartTranIdentifier == "FEECUST2") OR (BANCS.INPUT.PartTranIdentifier == "FEECUST3")) THEN
					CUST.ATM.narr1="EAZZYPAY_MER CHARGE"
				ELSE
					CUST.ATM.narr1="EAZZYPAY_MER"
				ENDIF
				CUST.ATM.narr2=""
				IF ((CUST.ATM.command=="CWRR") OR (CUST.ATM.command=="DBRR") OR (CUST.ATM.command=="TRRR") OR (CUST.ATM.command=="CDRR") ) THEN
					IF((BANCS.INPUT.PartTranIdentifier == "FEECONTRA1") OR (BANCS.INPUT.PartTranIdentifier == "FEECONTRA2") OR (BANCS.INPUT.PartTranIdentifier == "FEECONTRA3") OR (BANCS.INPUT.PartTranIdentifier == "FEECUST1") OR (BANCS.INPUT.PartTranIdentifier == "FEECUST2") OR (BANCS.INPUT.PartTranIdentifier == "FEECUST3")) THEN
						CUST.ATM.narr1="REV EAZZYPAY_MER CHARGE"
					ELSE
						CUST.ATM.narr1="REV EAZZYPAY_MER"
					ENDIF
					CUST.ATM.narr2=""
				ENDIF
			ENDIF
			IF (BANCS.INPUT.ReservedField2 =="P2PIntraMerCB") THEN
				IF((BANCS.INPUT.PartTranIdentifier == "FEECONTRA1") OR (BANCS.INPUT.PartTranIdentifier == "FEECONTRA2") OR (BANCS.INPUT.PartTranIdentifier == "FEECONTRA3") OR (BANCS.INPUT.PartTranIdentifier == "FEECUST1") OR (BANCS.INPUT.PartTranIdentifier == "FEECUST2") OR (BANCS.INPUT.PartTranIdentifier == "FEECUST3")) THEN
					CUST.ATM.narr1="EAZZYPAY_MERCB CHARGE"
				ELSE
					CUST.ATM.narr1="EAZZYPAY_MERCB"
				ENDIF
				CUST.ATM.narr2=""
				IF ((CUST.ATM.command=="CWRR") OR (CUST.ATM.command=="DBRR") OR (CUST.ATM.command=="TRRR") OR (CUST.ATM.command=="CDRR") ) THEN
					IF((BANCS.INPUT.PartTranIdentifier == "FEECONTRA1") OR (BANCS.INPUT.PartTranIdentifier == "FEECONTRA2") OR (BANCS.INPUT.PartTranIdentifier == "FEECONTRA3") OR (BANCS.INPUT.PartTranIdentifier == "FEECUST1") OR (BANCS.INPUT.PartTranIdentifier == "FEECUST2") OR (BANCS.INPUT.PartTranIdentifier == "FEECUST3")) THEN
						CUST.ATM.narr1="REV EAZZYPAY_MERCB CHARGE"
					ELSE
						CUST.ATM.narr1="REV EAZZYPAY_MERCB"
					ENDIF
					CUST.ATM.narr2=""
				ENDIF
			ENDIF
			IF (BANCS.INPUT.ReservedField2 =="P2PIntraMerPayBill") THEN
				IF((BANCS.INPUT.PartTranIdentifier == "FEECONTRA1") OR (BANCS.INPUT.PartTranIdentifier == "FEECONTRA2") OR (BANCS.INPUT.PartTranIdentifier == "FEECONTRA3") OR (BANCS.INPUT.PartTranIdentifier == "FEECUST1") OR (BANCS.INPUT.PartTranIdentifier == "FEECUST2") OR (BANCS.INPUT.PartTranIdentifier == "FEECUST3")) THEN
					CUST.ATM.narr1="EAZZYPAY_MERBPAY CHARGE"
				ELSE
					CUST.ATM.narr1="EAZZYPAY_MERBPAY"
				ENDIF
				CUST.ATM.narr2=""
				IF ((CUST.ATM.command=="CWRR") OR (CUST.ATM.command=="DBRR") OR (CUST.ATM.command=="TRRR") OR (CUST.ATM.command=="CDRR") ) THEN
					IF((BANCS.INPUT.PartTranIdentifier == "FEECONTRA1") OR (BANCS.INPUT.PartTranIdentifier == "FEECONTRA2") OR (BANCS.INPUT.PartTranIdentifier == "FEECONTRA3") OR (BANCS.INPUT.PartTranIdentifier == "FEECUST1") OR (BANCS.INPUT.PartTranIdentifier == "FEECUST2") OR (BANCS.INPUT.PartTranIdentifier == "FEECUST3")) THEN
						CUST.ATM.narr1="REV EAZZYPAY_MERBPAY CHARGE"
					ELSE
						CUST.ATM.narr1="REV EAZZYPAY_MERBPAY"
					ENDIF
					CUST.ATM.narr2=""
				ENDIF
			ENDIF
			IF (BANCS.INPUT.ReservedField1!="") THEN
				CUST.ATM.narr107="07"
				BANCS.OUTPUT.TranParticulars2 = CUST.ATM.narr107 + BANCS.INPUT.ReservedField1
			ENDIF
		ENDIF
	ENDIF
ENDIF
