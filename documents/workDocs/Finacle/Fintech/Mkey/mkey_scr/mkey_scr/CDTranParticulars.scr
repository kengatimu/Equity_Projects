			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			IF ( sv_d != 0 ) then
				BANCS.OUTPUT.RespCode = "99"
				BANCS.OUTPUT.successOrFailure="F"
				GOTO ENDOFSCRIPT
			ELSE
				BANCS.OUTPUT.RefNum=BANCS.OUTPARAM.memCode+"/"+BANCS.OUTPARAM.memType+"-"+BANCS.OUTPARAM.prefix
			ENDIF
			
			CUST.ATM.narr3=BANCS.INPUT.CardAcceptorName

		ELSE	
			BANCS.OUTPUT.RefNum=CUST.ATM.serial
			#---Get Cdsc number
			sv_s = "memCode,memType,prefix "
			sv_s = sv_s + " | "
			sv_s = sv_s + " SELECT cdup_memcode,cdup_memtype,cdup_prefix "
			sv_s = sv_s + " FROM CUSTOM.CDSC_DMP "
			sv_s = sv_s + " WHERE cdup_prefix = '" + BANCS.INPUT.DeviceId + "' "
			sv_s = sv_s + " AND bank_id = '99' "
			BANCS.INPARAM.BINDVARS = BANCS.INPUT.DeviceId
			print(sv_s)
			sv_d = urhk_dbSelectWithBind(sv_s)
