	IF (CUST.ATM.dccid =="EAZ") THEN
		IF (BANCS.INPUT.ReservedField2 =="P2PIntraMer") THEN
			IF((BANCS.INPUT.PartTranIdentifier == "FEECONTRA1") OR (BANCS.INPUT.PartTranIdentifier == "FEECONTRA2") OR (BANCS.INPUT.PartTranIdentifier == "FEECONTRA3") OR (BANCS.INPUT.PartTranIdentifier == "FEECUST1") OR (BANCS.INPUT.PartTranIdentifier == "FEECUST2") OR (BANCS.INPUT.PartTranIdentifier == "FEECUST3")) THEN
				print("HHH")
			ELSE
				IF ((CUST.ATM.command=="CWRR") OR (CUST.ATM.command=="DBRR") OR (CUST.ATM.command=="TRRR") OR (CUST.ATM.command=="CDRR")) THEN
					CUST.ATM.narr1="REV EAZZYPAY/"
				ELSE
					CUST.ATM.narr1="EAZZYPAY/"
				ENDIF
				IF (BANCS.INPUT.PartTranType=="D") THEN 
					sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.CrForacid)
					CUST.ATM.narr2mername = MID$(BANCS.OUTPARAM.acctName,0,15)
					print(CUST.ATM.narr2mername)
					IF (BANCS.INPUT.ReservedField1!="") THEN
						CUST.ATM.narr107="07"
						CUST.ATM.narr107mer = CUST.ATM.narr107 + BANCS.INPUT.ReservedField1
					ENDIF
					CUST.ATM.narr2 = CUST.ATM.narr107mer+ "/" + CUST.ATM.narr2mername + CUST.ATM.narr2
					print(CUST.ATM.narr2)
				ELSE
					sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.Foracid)
					CUST.ATM.narr2custname = MID$(BANCS.OUTPARAM.acctName,0,15)
					print(CUST.ATM.narr2custname)
					IF (BANCS.INPUT.ReservedField1!="") THEN
						CUST.ATM.narr107="07"
						CUST.ATM.narr107mer = CUST.ATM.narr107 + BANCS.INPUT.ReservedField1
					ENDIF
					CUST.ATM.narr2 = BANCS.OUTPUT.TranRemarks + "/" + CUST.ATM.narr107mer + CUST.ATM.narr2
					print(CUST.ATM.narr2)
				ENDIF
			ENDIF
		ENDIF
		IF (BANCS.INPUT.ReservedField2 =="P2PIntraMerPayBill") THEN
			IF((BANCS.INPUT.PartTranIdentifier == "FEECONTRA1") OR (BANCS.INPUT.PartTranIdentifier == "FEECONTRA2") OR (BANCS.INPUT.PartTranIdentifier == "FEECONTRA3") OR (BANCS.INPUT.PartTranIdentifier == "FEECUST1") OR (BANCS.INPUT.PartTranIdentifier == "FEECUST2") OR (BANCS.INPUT.PartTranIdentifier == "FEECUST3")) THEN
				print("HHH")
			ELSE
				IF ((CUST.ATM.command=="CWRR") OR (CUST.ATM.command=="DBRR") OR (CUST.ATM.command=="TRRR") OR (CUST.ATM.command=="CDRR")) THEN
					CUST.ATM.narr1="REV EAZZYPAY_BPAY/"
				ELSE
					CUST.ATM.narr1="EAZZYPAY_BPAY/"
				ENDIF
				IF (BANCS.INPUT.PartTranType=="D") THEN 
					sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.CrForacid)
					CUST.ATM.narr2mername = MID$(BANCS.OUTPARAM.acctName,0,15)
					print(CUST.ATM.narr2mername)
					IF (BANCS.INPUT.ReservedField1!="") THEN
						CUST.ATM.narr107="07"
						CUST.ATM.narr107mer = CUST.ATM.narr107 + BANCS.INPUT.ReservedField1
					ENDIF
					CUST.ATM.narr2 = CUST.ATM.narr107mer + CUST.ATM.narr2
					print(CUST.ATM.narr2)
				ELSE
					sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.Foracid)
					CUST.ATM.narr2custname = MID$(BANCS.OUTPARAM.acctName,0,15)
					print(CUST.ATM.narr2custname)
					IF (BANCS.INPUT.ReservedField1!="") THEN
						CUST.ATM.narr107="07"
						CUST.ATM.narr107mer = CUST.ATM.narr107 + BANCS.INPUT.ReservedField1
						CUST.ATM.narr2 = CUST.ATM.narr107mer + CUST.ATM.narr2
						print(CUST.ATM.narr2)
					ENDIF
					CUST.ATM.narr2 = BANCS.OUTPUT.TranRemarks + "/" + CUST.ATM.narr2
					print(CUST.ATM.narr2)
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF

#---narrations for way4 POS

IF ((CUST.ATM.dccid =="WPD") OR (CUST.ATM.dccid =="KEN") OR (CUST.ATM.dccid =="INT")) THEN
	sv_s = "count,freeText "
	sv_s = sv_s + " | "
	sv_s = sv_s + " SELECT COUNT(1),AGT.free_text "
	sv_s = sv_s + " FROM TBAADM.AGT,TBAADM.GAM "
	sv_s = sv_s + " WHERE AGT.oper_credit_acid = GAM.acid "
	sv_s = sv_s + " AND GAM.acct_cls_flg != 'Y'"
	sv_s = sv_s + " AND agent_code = ?SVAR "
	sv_s = sv_s + " AND AGT.del_flg !='Y' "
	sv_s = sv_s + " GROUP BY AGT.free_text " 
	BANCS.INPARAM.BINDVARS = BANCS.INPUT.DeviceId 
	print(sv_s)
	sv_d = urhk_dbSelectWithBind(sv_s)
	print(sv_d)
	IF  (sv_d == "0") then
		CUST.ATM.count=BANCS.OUTPARAM.count
		CUST.ATM.freeText=BANCS.OUTPARAM.freeText
		IF (CUST.ATM.count == 1) THEN
			IF (CUST.ATM.freeText=="CASHLESS" ) THEN 
				CUST.ATM.Agent="Y"
				CUST.ATM.cashless="Y"
			ELSE
				CUST.ATM.Agent="Y"
				CUST.ATM.cashless="N"
			ENDIF
		ELSE
			CUST.ATM.Agent="N"
			CUST.ATM.cashless="N"
		ENDIF
	ELSE
			CUST.ATM.Agent="N"
			CUST.ATM.cashless="N"
	ENDIF
	CUST.ATM.AcceptorName=MID$(BANCS.INPUT.CardAcceptorName,0,15)
	CUST.ATM.narr1=CUST.ATM.AcceptorName
		
	IF ((CUST.ATM.command =="PRCR") OR (CUST.ATM.command =="CWDR")) THEN
		CUST.ATM.narr2=" MERCHANT TRANSACTION"
		IF (CUST.ATM.dccid =="KEN") THEN
			CUST.ATM.narr2=" KENSWITCH TRANS"
		ENDIF
		IF (CUST.ATM.dccid =="INT") THEN
			CUST.ATM.narr2=" INTSWITCH TRANS"
		ENDIF
		IF (BANCS.INPUT.ReservedField2 == "WAY4CASHBACK") THEN
			CUST.ATM.narr2=" CASHBACK AND FEES"
		ENDIF
		IF (BANCS.INPUT.ReservedField2 == "WAY4POSCASH") THEN
			CUST.ATM.narr2=" CASH ADVANCE AND FEES"
		ENDIF
		IF (BANCS.INPUT.ReservedField2 == "WAY4RETAIL")  THEN
			CUST.ATM.narr2=" PURCHASE"
			IF (BANCS.INPUT.DeviceId!="") THEN
				sv_a= MID$(BANCS.INPUT.DeviceId,0,2) 
				print(sv_a) 
				IF (sv_a=="TM") THEN
					CUST.ATM.narr2=" PAYMENT"
				ENDIF
				IF (sv_a=="CG") THEN
					CUST.ATM.narr2=" PAYMENT"
				ENDIF
			ENDIF
		ENDIF
		IF (BANCS.INPUT.ReservedField2 == "WAY4RETAILUSD") THEN
			CUST.ATM.narr2=" USDRWPURCHASE"
		ENDIF
		IF (BANCS.INPUT.ReservedField2 == "WAY4RETAILUSDUG") THEN
			CUST.ATM.narr2=" USDUGPURCHASE"
		ENDIF
		IF (BANCS.INPUT.ReservedField2 == "INTERC") THEN
			IF ((CUST.ATM.command =="PRCR") OR (CUST.ATM.command =="CWDR")) THEN
				IF (BANCS.INPUT.PartTranType=="C") THEN 
				  BANCS.OUTPUT.RefNum=BANCS.INPUT.DeviceId
				ELSE
					 BANCS.OUTPUT.RefNum=CUST.ATM.serial
				ENDIF
			ENDIF
			IF ((CUST.ATM.command =="PRRR") OR (CUST.ATM.command =="CWRR")) THEN
				IF (BANCS.INPUT.PartTranType=="D") THEN 
				  BANCS.OUTPUT.RefNum=BANCS.INPUT.DeviceId
				 ELSE
					 BANCS.OUTPUT.RefNum=CUST.ATM.serial
				ENDIF
			ENDIF
			IF (CUST.ATM.command =="CWDR") THEN
				CUST.ATM.narr2=" POS INT WDRAWAL"
				
			ENDIF
			IF (CUST.ATM.command =="CWRR") THEN
				CUST.ATM.narr2=" POS INT REVERSAL"
				
			ENDIF
		ENDIF

		IF ((CUST.ATM.Agent=="Y") AND (CUST.ATM.cashless=="N")) THEN 
			CUST.ATM.narr2=" CASH ADVANCE"
		ENDIF
		IF ((CUST.ATM.Agent=="Y")AND (CUST.ATM.cashless=="Y")) THEN
			print ("cashless pos")
			IF (BANCS.INPUT.PartTranType=="C") then	
				sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.Foracid)
				CUST.ATM.narr1 = MID$(BANCS.OUTPARAM.acctName,0,34)
				print(CUST.ATM.narr1)
				CUST.ATM.narr2=" /PURCHASE"
			ELSE
				CUST.ATM.narr2=" /PURCHASE"
				
			ENDIF
		ENDIF
		IF (CUST.ATM.dccid =="KEN") THEN
			CUST.ATM.narr2=" KENSWITCH TRANS"
		ENDIF
		IF (CUST.ATM.dccid =="INT") THEN
			CUST.ATM.narr2=" INTSWITCH TRANS"
		ENDIF
	ENDIF
	IF ((CUST.ATM.command =="PRRR") OR (CUST.ATM.command =="CWRR")) THEN
		CUST.ATM.narr2=" REVERSAL"
		IF (BANCS.INPUT.ReservedField2 == "WAY4CASHBACK") THEN
			CUST.ATM.narr2=" CASHBACK REVERSAL"
		ENDIF
		IF (BANCS.INPUT.ReservedField2 == "WAY4POSCASH") THEN
			CUST.ATM.narr2=" CASH ADVANCE AND FEES REVERSAL"
		ENDIF
		IF (BANCS.INPUT.ReservedField2 == "WAY4RETAIL")  THEN
			CUST.ATM.narr2=" PURCHASE REVERSAL"
		ENDIF
		IF (BANCS.INPUT.ReservedField2 == "WAY4RETAILUSD") THEN
			CUST.ATM.narr2=" USDRWPURCHASE REVERSAL"
		ENDIF
		IF (BANCS.INPUT.ReservedField2 == "WAY4RETAILUSDUG") THEN
			CUST.ATM.narr2=" USDUGPURCHASE REVERSAL"
		ENDIF
		IF (CUST.ATM.Agent=="Y") THEN 
			CUST.ATM.narr2=" CASH ADVANCE REVERSAL"
		ENDIF
		IF ((CUST.ATM.Agent=="Y")AND (CUST.ATM.cashless=="N")) THEN 
			CUST.ATM.narr2=" CASH ADVANCE REVERSAL"
		ENDIF
		IF ((CUST.ATM.Agent=="Y")AND (CUST.ATM.cashless=="Y")) THEN
			print ("cashless pos")
			IF (BANCS.INPUT.PartTranType=="D") then	
				sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.Foracid)
				CUST.ATM.narr1 = MID$(BANCS.OUTPARAM.acctName,0,34)
				print(CUST.ATM.narr1)
				CUST.ATM.narr2=" /PURCHASE REV "
			ELSE
				CUST.ATM.narr2=" /PURCHASE REV "
				
			ENDIF
		ENDIF
		IF (CUST.ATM.dccid =="KEN") THEN
			CUST.ATM.narr2=" KENSWITCH TRANS REV"
		ENDIF
		IF (CUST.ATM.dccid =="INT") THEN
			CUST.ATM.narr2=" INTSWITCH TRANS REV"
		ENDIF
	ENDIF

	IF (CUST.ATM.command =="CDAR") THEN
		CUST.ATM.narr2=" CASH DEPOSIT"
	ENDIF
	IF (CUST.ATM.command =="CDRR") THEN
		CUST.ATM.narr2="CASH DEPOSIT REV"
	ENDIF

	IF ((BANCS.INPUT.ReservedField2 !="") and (BANCS.INPUT.CrForacid !="") AND (BANCS.INPUT.ReservedField2 !="INTERC") AND (CUST.ATM.command !="CDAR") AND (CUST.ATM.command !="CDRR") ) THEN
		sv_y=BANCS.INPUT.ReservedField2
		print (sv_y)
		sv_c=mid$(sv_y,0,5)
		print(sv_c)
		IF ((sv_c !="BILL:") AND (sv_c !="COLL:") AND (sv_c !="ACCT:") AND (sv_c !="ACCT|") AND (sv_c !="BILL|") AND (sv_c !="COLL|")) THEN
			IF (BANCS.INPUT.PartTranType=="C") then	
				IF (BANCS.INPUT.CrForacid=="0550293271157") THEN
					BANCS.INPUT.ReservedField2=LTRIM(BANCS.INPUT.ReservedField2,'0')
				ENDIF
				sv_s = "refNum,name "
				sv_s = sv_s + " | "
				sv_s = sv_s + " SELECT refnum,name "
				sv_s = sv_s + " FROM CUSTOM.C_CIC "
				sv_s = sv_s + " WHERE acctnum = ?SVAR  "
				sv_s = sv_s + " AND refnum = ?SVAR "
				sv_s = sv_s + " AND del_flg = 'N' "
				sv_s = sv_s + " AND bank_id = '99' "
				BANCS.INPARAM.BINDVARS = BANCS.INPUT.CrForacid + "|" + BANCS.INPUT.ReservedField2
				print(sv_s)
				sv_d = urhk_dbSelectWithBind(sv_s)
				print(sv_d)
				IF ( sv_d != 0 ) then
					BANCS.OUTPUT.RespCode = "99"
					BANCS.OUTPUT.successOrFailure="F"
					GOTO ENDOFSCRIPT
				ELSE
					
					BANCS.OUTPUT.TranRemarks=BANCS.OUTPARAM.name
					BANCS.OUTPUT.RefNum=BANCS.OUTPARAM.refNum
					CUST.ATM.narr2="BILL PAYMENT"
				ENDIF
			ELSE
				CUST.ATM.serial= LTRIM(CUST.ATM.serial,'0')
				BANCS.OUTPUT.RefNum=CUST.ATM.serial
				CUST.ATM.narr1=""
				CUST.ATM.narr2="BILL PAYMENT: "
				sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.CrForacid)
				CUST.ATM.narr3 = MID$(BANCS.OUTPARAM.acctName,0,34)
				print(CUST.ATM.narr3)
				BANCS.OUTPUT.TranRemarks="POS"
			ENDIF
		ENDIF
	ENDIF
	
ENDIF

IF (BANCS.INPUT.CrForacid!="") THEN
	IF  (BANCS.INPUT.DccId == "WPD")   THEN
		IF (BANCS.INPUT.ReservedField2 != "") THEN 
			CUST.ATM.reversed2 = BANCS.INPUT.ReservedField2
			print(CUST.ATM.reversed2)
			sv_k = MID$(BANCS.INPUT.ReservedField2,0,5)
			print(sv_k)
			sv_w = MID$(BANCS.INPUT.ReservedField2,5,14)
			print(sv_w)
			if (sv_k =="BILL:") THEN
				sv_v=mid$(CUST.ATM.reversed2,19,20)
				print(sv_v)
				BANCS.OUTPUT.RefNum = trim(sv_v)
				print(BANCS.OUTPUT.RefNum)
				sv_z = BANCS.INPUT.ReservedField1
				print(sv_z)
				sv_x = "acctnum|select ACCTNUM from custom.c_cic_bills where REFNUM=?SVAR"
				sv_x = sv_x + " and DEL_FLG ='N' "
				BANCS.INPARAM.BINDVARS =sv_z
				sv_r =urhk_dbSelectWithBind(sv_x)
				print(sv_r)
				IF (sv_r == "0") THEN
					CUST.ATM.crForacid1 = BANCS.OUTPARAM.acctnum
					print(CUST.ATM.crForacid1)
				ELSE
					BANCS.OUTPUT.RespCode = "99"
					BANCS.OUTPUT.successOrFailure = "F"
					exitscript
				ENDIF
				CUST.ATM.exemptflg=""
				sv_s = "COUNT|SELECT COUNT(1) FROM CUSTOM.ACCT_EXEMPTION_TABLE "
				sv_s = sv_s + " WHERE FORACID = ?SVAR"
				sv_s = sv_s + " AND bank_id = ?SVAR and EXEMPT_CODE='REMOT' "
				PRINT(sv_s)
				BANCS.INPARAM.BINDVARS = CUST.ATM.crForacid1 + "|" + BANCS.STDIN.contextBankId
				PRINT(BANCS.INPARAM.BINDVARS)
				sv_u =  urhk_dbSelectWithBind(sv_s)
				IF(sv_u == 0) THEN
				#{
					PRINT(BANCS.OUTPARAM.COUNT)
					IF (CINT(BANCS.OUTPARAM.COUNT) > 0) THEN
						CUST.ATM.exemptflg = "Y"
					ELSE
						CUST.ATM.exemptflg = "N"
					ENDIF
				#}
				ELSE
					CUST.ATM.exemptflg = "N"
				ENDIF
				IF (CUST.ATM.exemptflg == "Y") THEN
					sv_u = "billercode,accountnumber,accountname |"
					sv_u = sv_u + " select FREE_TEXT5,FREE_TEXT1,BILLER_NAME from tbaadm.brgt where FREE_TEXT1=?SVAR "
					print(sv_u)
					BANCS.INPARAM.BINDVARS =CUST.ATM.crForacid1
					sv_w=urhk_dbSelectWithBind(sv_u)
					print(sv_w)
					IF (sv_w !=0) THEN 
						BANCS.OUTPUT.RespCode = "99"
						BANCS.OUTPUT.successOrFailure="F"
						exitscript
					ELSE
						CUST.ATM.billercode = BANCS.OUTPARAM.billercode
						print(CUST.ATM.billercode)
						CUST.ATM.accountnumber = BANCS.OUTPARAM.accountnumber
						print(CUST.ATM.accountnumber)
						CUST.ATM.accountname = BANCS.OUTPARAM.accountname
						print(CUST.ATM.accountname)
						print(BANCS.INPUT.CardAcceptorName)
						print(BANCS.INPUT.TranAmt)
						sv_g = MID$(BANCS.INPUT.TranAmt,0,14)
						print(sv_g)
						CUST.ATM.amountsvg = cdouble(sv_g)
						print(CUST.ATM.amountsvg)

						sv_q = " Eslipdetails| select custom.tpb_pkg.callupgbvwsfunction(?SVAR,?SVAR,?SVAR) from dual"
						print(sv_q)
						BANCS.INPARAM.BINDVARS=CUST.ATM.billercode+ "|"+ BANCS.OUTPUT.RefNum +"|"+ CUST.ATM.amountsvg
						print(BANCS.INPARAM.BINDVARS)
						sv_w=urhk_dbSelectWithBind(sv_q)
						print(sv_w)
						IF ( sv_w != 0 ) then
							BANCS.OUTPUT.RespCode = "99"
							BANCS.OUTPUT.successOrFailure="F"
						ELSE
							CUST.ATM.Eslipdetails = BANCS.OUTPARAM.Eslipdetails
							print(CUST.ATM.Eslipdetails)
							IF (CUST.ATM.Eslipdetails=="") THEN
								BANCS.OUTPUT.RespCode = "99"
								BANCS.OUTPUT.successOrFailure="F"
							ELSE
								sv_s = CUST.ATM.Eslipdetails
								print(sv_s)
								sv_u = "statusbill,EslipDetails1|select substr(?SVAR,1,instr(?SVAR,'?') - 1) ,substr(?SVAR,instr(?SVAR,'?') + 1) from dual "
								print(sv_u)
								BANCS.INPARAM.BINDVARS=sv_s +"|"+sv_s +"|"+sv_s +"|"+sv_s 
								sv_w=urhk_dbSelectWithBind(sv_u)
								print(sv_w)
								CUST.ATM.statusbill = BANCS.OUTPARAM.statusbill
								print(CUST.ATM.statusbill)
								CUST.ATM.EslipDetails1 = BANCS.OUTPARAM.EslipDetails1
								print(CUST.ATM.EslipDetails1)

								sv_s = CUST.ATM.EslipDetails1
								print(sv_s)
								sv_u = "statusbil2,EslipDetails2|select substr(?SVAR,1,instr(?SVAR,'?') - 1) ,substr(?SVAR,instr(?SVAR,'?') + 1) from dual "
								print(sv_u)
								BANCS.INPARAM.BINDVARS=sv_s +"|"+sv_s +"|"+sv_s +"|"+sv_s 
								sv_w=urhk_dbSelectWithBind(sv_u)
								print(sv_w)
								CUST.ATM.statusbil2 = BANCS.OUTPARAM.statusbil2
								print(CUST.ATM.statusbil2)
								CUST.ATM.EslipDetails2 = BANCS.OUTPARAM.EslipDetails2
								print(CUST.ATM.EslipDetails2)

								sv_s = CUST.ATM.EslipDetails2
								print(sv_s)
								sv_u = "statusbil3,EslipDetails3|select substr(?SVAR,1,instr(?SVAR,'?') - 1) ,substr(?SVAR,instr(?SVAR,'?') + 1) from dual "
								print(sv_u)
								BANCS.INPARAM.BINDVARS=sv_s +"|"+sv_s +"|"+sv_s +"|"+sv_s 
								sv_w=urhk_dbSelectWithBind(sv_u)
								print(sv_w)
								CUST.ATM.statusbil3 = BANCS.OUTPARAM.statusbil3
								print(CUST.ATM.statusbil3)
								CUST.ATM.EslipDetails3 = BANCS.OUTPARAM.EslipDetails3
								print(CUST.ATM.EslipDetails3)

								sv_s = CUST.ATM.EslipDetails3
								print(sv_s)
								sv_u = "statusbil4,EslipDetails4|select substr(?SVAR,1,instr(?SVAR,'?') - 1) ,substr(?SVAR,instr(?SVAR,'?') + 1) from dual "
								print(sv_u)
								BANCS.INPARAM.BINDVARS=sv_s +"|"+sv_s +"|"+sv_s +"|"+sv_s 
								sv_w=urhk_dbSelectWithBind(sv_u)
								print(sv_w)
								CUST.ATM.statusbil4 = BANCS.OUTPARAM.statusbil4
								print(CUST.ATM.statusbil4)
								CUST.ATM.EslipDetails4 = BANCS.OUTPARAM.EslipDetails4
								print(CUST.ATM.EslipDetails4)

								sv_s = CUST.ATM.EslipDetails4
								print(sv_s)
								sv_u = "statusbil5,EslipDetails5|select substr(?SVAR,1,instr(?SVAR,'?') - 1) ,substr(?SVAR,instr(?SVAR,'?') + 1) from dual "
								print(sv_u)
								BANCS.INPARAM.BINDVARS=sv_s +"|"+sv_s +"|"+sv_s +"|"+sv_s 
								sv_w=urhk_dbSelectWithBind(sv_u)
								print(sv_w)
								CUST.ATM.statusbil5 = BANCS.OUTPARAM.statusbil5
								print(CUST.ATM.statusbil5)
								CUST.ATM.EslipDetails5 = BANCS.OUTPARAM.EslipDetails5
								print(CUST.ATM.EslipDetails5)

								print(CUST.ATM.statusbil5)
								BANCS.OUTPUT.TranParticulars2=CUST.ATM.statusbil5
								print(BANCS.OUTPUT.TranParticulars2)

								IF (CUST.ATM.accountnumber =="0550293271157") THEN
									CUST.ATM.narr0 ="Dep-for"
									print(CUST.ATM.narr0)
									CUST.ATM.narr1 = CUST.ATM.narr0 + CUST.ATM.statusbil4 +"/"
									print(CUST.ATM.narr1)
								ENDIF
								IF (CUST.ATM.statusbill=="false") THEN
									BANCS.OUTPUT.RespCode = "99"
									BANCS.OUTPUT.successOrFailure="F"
								ELSE
									BANCS.OUTPUT.successOrFailure="S"
								ENDIF
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			endif
		ENDIF	
	ENDIF
ENDIF
#---Narrations for VISA Acquring
IF (CUST.ATM.dccid =="SWT") THEN
	CUST.ATM.CustCardId = MID$(BANCS.INPUT.CustCardId,0,6)
	print(CUST.ATM.CustCardId)
	IF ((CUST.ATM.CustCardId != "627851") AND (CUST.ATM.CustCardId !="424145") AND (CUST.ATM.CustCardId !="511624") AND (CUST.ATM.CustCardId !="375156") AND (CUST.ATM.CustCardId !="531494") AND (CUST.ATM.CustCardId !="379996") AND (CUST.ATM.CustCardId !="519601") AND (CUST.ATM.CustCardId !="447815") AND (CUST.ATM.CustCardId !="604975") AND (CUST.ATM.CustCardId !="669932") AND (CUST.ATM.CustCardId !="420345") AND (CUST.ATM.CustCardId !="420346") AND (CUST.ATM.CustCardId !="457669")) THEN
		sv_e = MID$(BANCS.STDIN.BODDate,0,10)
		print(sv_e)
		sv_s = "sysdate "
		sv_s = sv_s + " | "
		sv_s = sv_s + " SELECT TO_CHAR((TO_DATE('" + sv_e + "','DD-MM-YYYY')),'DD-MM-YYYY') "
		sv_s = sv_s + " FROM DUAL"
		sv_d = urhk_dbSelectWithBind(sv_s)
		print(sv_d)
		IF (sv_d =="0") THEN
			CUST.ATM.sysdate = BANCS.OUTPARAM.sysdate
			CUST.ATM.narr1=""
			CUST.ATM.narr2=""
			CUST.ATM.narr3 ="VISA SMS ACQUIRING "+ "/" + CUST.ATM.serial + "/" + CUST.ATM.sysdate
			IF (BANCS.INPUT.ReservedField3!="") THEN 
				sv_g = MID$(BANCS.INPUT.ReservedField3,0,1)
				print(sv_g)
				IF (sv_g=="k") THEN
					sv_h =MID$(BANCS.INPUT.ReservedField3,2,13)
					print(sv_h)
					CUST.ATM.narr3 ="KEN SWITCH ACQUIRING "+ "/" + sv_h + "/" + CUST.ATM.sysdate
				ENDIF
			ENDIF
