	IF ((BANCS.INPUT.ReservedField2 == "MyBill") OR (BANCS.INPUT.ReservedField2 == "Otherbill") OR (BANCS.INPUT.ReservedField2=="AgentBill")) THEN
		IF (BANCS.INPUT.PartTranType=="C") then	
			IF (BANCS.INPUT.CrForacid=="0550293271157") THEN
				BANCS.INPUT.CardAcceptorName=LTRIM(BANCS.INPUT.CardAcceptorName,'0')
			ENDIF
			sv_s = "count "
			sv_s = sv_s + " |"
			sv_s = sv_s + " SELECT COUNT(1) "
			sv_s = sv_s + " FROM DUAL "
			sv_s = sv_s + " WHERE EXISTS ( "
			sv_s = sv_s + " 		SELECT 1 "
			sv_s = sv_s + " 		FROM CUSTOM.C_CIC  "
			sv_s = sv_s + " 		WHERE acctnum = ?SVAR "
			sv_s = sv_s + " 	     ) "
			BANCS.INPARAM.BINDVARS = BANCS.INPUT.CrForacid
			print(sv_s)
			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			IF (sv_d == 0) THEN  
				CUST.ATM.count = BANCS.OUTPARAM.count
			ELSE
				CUST.ATM.count ="0"
			ENDIF

			IF ((CUST.ATM.count!=0) AND (BANCS.INPUT.CrForacid!="0810299692083") AND (BANCS.INPUT.CrForacid!="0810299114629") AND (BANCS.INPUT.CrForacid!="0810297000152") AND (BANCS.INPUT.CrForacid!="0810263450692"))  THEN 
				sv_s = "refNum,name|"
				sv_s = sv_s + " SELECT refnum,name "
				sv_s = sv_s + " FROM CUSTOM.C_CIC "
				sv_s = sv_s + " WHERE acctnum = ?SVAR "
				sv_s = sv_s + " AND refNum = ?SVAR "
				sv_s = sv_s + " AND DEL_FLG = 'N' "
				sv_s = sv_s + " AND bank_id = '99' "
				BANCS.INPARAM.BINDVARS = BANCS.INPUT.CrForacid + "|" + BANCS.INPUT.CardAcceptorName
				print(sv_s)
				sv_d = urhk_dbSelectWithBind(sv_s)
				print(sv_d)
				IF ( sv_d != 0 ) then
					BANCS.OUTPUT.RespCode = "99"
					BANCS.OUTPUT.successOrFailure="F"
					GOTO ENDOFSCRIPT
				ELSE
					BANCS.OUTPUT.TranRemarks=MID$(BANCS.OUTPARAM.name,0,30)
					BANCS.OUTPUT.RefNum=BANCS.OUTPARAM.refNum
					CUST.ATM.narr2=BANCS.OUTPUT.RefNum + " " + BANCS.OUTPUT.TranRemarks
					print(CUST.ATM.narr2)
					IF (FIELDEXISTS(BANCS.INPUT.ReservedField3)) THEN
						CUST.ATM.serial2= LTRIM(BANCS.INPUT.ReservedField3,'0') 
						print(CUST.ATM.serial2)
						BANCS.OUTPUT.TranParticulars2=CUST.ATM.serial2
						print(BANCS.OUTPUT.TranParticulars2)
					ENDIF
				ENDIF
			ELSE
				sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.Foracid)
				BANCS.OUTPUT.TranRemarks = MID$(BANCS.OUTPARAM.acctName,0,34)
				CUST.ATM.narr2="BILL PAYMENT"
				BANCS.OUTPUT.RefNum=BANCS.INPUT.CardAcceptorName
				IF (FIELDEXISTS(BANCS.INPUT.ReservedField3)) THEN
					CUST.ATM.serial2= LTRIM(BANCS.INPUT.ReservedField3,'0') 
					print(CUST.ATM.serial2)
					BANCS.OUTPUT.TranParticulars2=CUST.ATM.serial2
					print(BANCS.OUTPUT.TranParticulars2)
				ENDIF
			ENDIF
			
		ELSE
			CUST.ATM.narr1=""
			CUST.ATM.narr2="BILL PAYMENT: "
			sv_u = urhk_getAcctDetailsInRepository(BANCS.INPUT.CrForacid)
			CUST.ATM.narr3 = MID$(BANCS.OUTPARAM.acctName,0,34)
