	IF ((BANCS.INPUT.DccId=="WYM") OR (BANCS.INPUT.DccId=="OMK") OR (BANCS.INPUT.DccId=="EAZ") OR (BANCS.INPUT.DccId=="AIR")) THEN
		IF (BANCS.INPUT.ReservedField2 !="") THEN 
			IF ((BANCS.INPUT.ReservedField2 == "MyBill") OR (BANCS.INPUT.ReservedField2 == "Otherbill") OR (BANCS.INPUT.ReservedField2=="AgentBill")) THEN
				BANCS.OUTPUT.RefNum = BANCS.INPUT.CardAcceptorName
				print(BANCS.OUTPUT.RefNum)
			ENDIF
		ENDIF
	ENDIF
	
	sv_k = "brgtCount| SELECT count(1) "
	sv_k = sv_k + " from tbaadm.brgt "
	sv_k = sv_k + " where BRGT.FREE_TEXT1 = ?SVAR "
	sv_k = sv_k + " AND BRGT.BANK_ID = ?SVAR "
	sv_k = sv_k + " AND BRGT.ENTITY_CRE_FLG = 'Y' "
	sv_k = sv_k + " AND BRGT.DEL_FLG = 'N' and rownum<2 "	
	BANCS.INPARAM.BINDVARS = BANCS.INPUT.CrForacid  + "|" + BANCS.STDIN.contextBankId
	PRINT(BANCS.INPARAM.BINDVARS)
	PRINT(sv_k)
	sv_h = urhk_dbselectWithBind(sv_k)
	PRINT(sv_h)
	IF (sv_h  == 0) THEN
	#{		
		CUST.ATM.billerCnt = BANCS.OUTPARAM.brgtCount
		PRINT(CUST.ATM.billerCnt)
	#}
	ELSE
	#{
		CUST.ATM.billerCnt = "0"
	#}
	ENDIF
	IF (FIELDEXISTS(BANCS.INPUT.CrForacid) == 1) THEN
		IF (BANCS.INPUT.DccId=="EAZ") THEN
			IF ((BANCS.INPUT.CrForacid =="0810263450692") OR (BANCS.INPUT.CrForacid =="0810297000152")) THEN
				CUST.ATM.billerCnt = "0"
				print(CUST.ATM.billerCnt)
			ENDIF
		ENDIF
	ENDIF
	IF (CINT(CUST.ATM.billerCnt)>0 ) THEN
	#{
		sv_k = "brgtflag| SELECT trim(FREE_TEXT4) "
		sv_k = sv_k + " from tbaadm.brgt "
		sv_k = sv_k + " where BRGT.FREE_TEXT1 = ?SVAR "
		sv_k = sv_k + " AND BRGT.BANK_ID = ?SVAR "
		sv_k = sv_k + " AND BRGT.ENTITY_CRE_FLG = 'Y' "
		sv_k = sv_k + " AND BRGT.DEL_FLG = 'N' and rownum<2 "	
		BANCS.INPARAM.BINDVARS = BANCS.INPUT.CrForacid  + "|" + BANCS.STDIN.contextBankId
		PRINT(BANCS.INPARAM.BINDVARS)
		PRINT(sv_k)
		sv_h = urhk_dbselectWithBind(sv_k)
		PRINT(sv_h)
		IF (sv_h  == 0) THEN
		#{		
			CUST.ATM.brgtflag = BANCS.OUTPARAM.brgtflag
			PRINT(CUST.ATM.brgtflag)
		#}
		ELSE
		#{
			CUST.ATM.brgtflag = "N"
		#}
		ENDIF

		IF (CUST.ATM.brgtflag=="L") THEN
		#{
			IF (BANCS.INPUT.DccId=="SWT") THEN
				IF (FIELDEXISTS(BANCS.INPUT.ReservedField2)) THEN
					BANCS.OUTPUT.RefNum = BANCS.INPUT.ReservedField2
					print(BANCS.OUTPUT.RefNum)
				ENDIF
			ENDIF
			sv_s = "refNum,name "
			sv_s = sv_s + " |"
			sv_s = sv_s + " select refnum,name "
			sv_s = sv_s + " FROM CUSTOM.C_CIC "
			sv_s = sv_s + " WHERE acctnum = ?SVAR  "
			sv_s = sv_s + " AND refNum = ?SVAR "
			sv_s = sv_s + " AND del_flg = 'N' "
			sv_s = sv_s + " AND bank_id = '99' "
			BANCS.INPARAM.BINDVARS = BANCS.INPUT.CrForacid + "|" + BANCS.OUTPUT.RefNum 
			print(sv_s)
			sv_d = urhk_dbSelectWithBind(sv_s)
			print(sv_d)
			IF ( sv_d != 0 ) then
				BANCS.OUTPUT.RespCode = "99"
				BANCS.OUTPUT.successOrFailure="F"
				GOTO ENDOFSCRIPT
			ELSE
				BANCS.OUTPUT.RefNum=BANCS.OUTPARAM.refNum
				print(BANCS.OUTPUT.RefNum)
			ENDIF
		#}
		ELSE
		#{
			IF (CUST.ATM.brgtflag!="N") THEN
				IF (BANCS.OUTPUT.RefNum=="") THEN
					BANCS.OUTPUT.RespCode = "99"
					BANCS.OUTPUT.successOrFailure="F"
					GOTO ENDOFSCRIPT
				ENDIF
			ENDIF
		#}
		ENDIF
	#}
	ENDIF
ENDIF

IF  (BANCS.INPUT.DccId == "SWT")  THEN
	sv_a= MID$(BANCS.INPUT.CustCardId,0,6)
	print(sv_a)
	IF ((sv_a != "627851") AND (sv_a !="447815") AND (sv_a !="519601") AND (sv_a !="420345") AND (sv_a !="420346") OR (BANCS.INPUT.CrForacid=="VODAFONE")OR (BANCS.INPUT.ReservedField2=="CreditCard") OR (BANCS.INPUT.ReservedField2=="CashIn")) THEN
		IF (BANCS.INPUT.PartTranType=="D") THEN 
			#-inserting records to check for dublication

			sv_g = mid$(BANCS.STDIN.sysDate,0,10) 
			sv_h = mid$(BANCS.STDIN.BODDate,0,10)

			sv_s = "getsysdate|select to_char((to_date(?SVAR,'DD-MM-YYYY')),'DD-MON-YYYY') from dual"
			BANCS.INPARAM.BINDVARS =  sv_g
			sv_d = urhk_dbSelectWithBind(sv_s)
			##print(sv_d)
			IF (sv_d =="0") THEN
				CUST.ATM.getsysdate = BANCS.OUTPARAM.getsysdate
				print(CUST.ATM.getsysdate)
			ENDIF

			sv_s = "getboddate|select to_char((to_date(?SVAR,'DD-MM-YYYY')),'DD-MON-YYYY') from dual"
			BANCS.INPARAM.BINDVARS =  sv_h
			sv_d = urhk_dbSelectWithBind(sv_s)
			##print(sv_d)
			IF (sv_d =="0") THEN
				CUST.ATM.getboddate = BANCS.OUTPARAM.getboddate
				print(CUST.ATM.getboddate)
			ENDIF

			sv_s = "INSERT INTO "
			sv_s = sv_s + " CUSTOM.C_SAF_DUP "
			sv_s = sv_s + " ( "
			sv_s = sv_s + " custcardid,"
			sv_s = sv_s + " sysdatetime,"
			sv_s = sv_s + " dccid, "
			sv_s = sv_s + " foracid, "
			sv_s = sv_s + " tranamt, "
			sv_s = sv_s + " trancrncy, "
			sv_s = sv_s + " deviceid, "
			sv_s = sv_s + " reservedfield2, "
			sv_s = sv_s + " parttrantype, "
			sv_s = sv_s + " sys_date, "
			sv_s = sv_s + " boddate, "
			sv_s = sv_s + " bank_id "
			sv_s = sv_s + " ) "
			sv_s = sv_s + " VALUES "
			sv_s = sv_s + "	( "
			sv_s = sv_s + "	?SVAR, "
			sv_s = sv_s + " ?SVAR, "
			sv_s = sv_s + "	?SVAR, "
			sv_s = sv_s + "	?SVAR, "
			sv_s = sv_s + "	?SVAR, "
			sv_s = sv_s + "	?SVAR, "
			sv_s = sv_s + "	?SVAR, "
			sv_s = sv_s + " ?SVAR, "
			sv_s = sv_s + "	?SVAR, "
			sv_s = sv_s + "	?SVAR, "
			sv_s = sv_s + "	?SVAR, "
			sv_s = sv_s + "	'99' "
			sv_s = sv_s + "	 )"
			BANCS.INPARAM.BINDVARS = BANCS.INPUT.CustCardId + "|" + BANCS.INPUT.SysDateTime +"|" + BANCS.INPUT.DccId + "|" + BANCS.INPUT.Foracid + "|" 
			BANCS.INPARAM.BINDVARS = BANCS.INPARAM.BINDVARS + BANCS.INPUT.TranAmt + "|" + BANCS.INPUT.TranCrncy + "|" + BANCS.INPUT.DeviceId + "|" + BANCS.INPUT.ReservedField3 + "|" + BANCS.INPUT.PartTranType + "|" + CUST.ATM.getsysdate + "|" + CUST.ATM.getboddate
			print(sv_s)
			sv_d = urhk_dbSqlWithBind(sv_s)
			IF (sv_d == 0) THEN
			 #sv_d = urhk_dbSqlWithBind("COMMIT")
			ENDIF
		ENDIF
	ENDIF

ENDIF
IF (FIELDEXISTS(BANCS.OUTPUT.TranRemarks) == 1) THEN
	BANCS.OUTPUT.TranRemarks=MID$(BANCS.OUTPUT.TranRemarks,0,30)
	print(BANCS.OUTPUT.TranRemarks)
ENDIF
IF (FIELDEXISTS(BANCS.OUTPUT.RefNum) == 1) THEN
	BANCS.OUTPUT.RefNum=MID$(BANCS.OUTPUT.RefNum,0,20)
	print(BANCS.OUTPUT.RefNum)
ENDIF
IF (FIELDEXISTS(BANCS.OUTPUT.TranParticulars) == 1) THEN
	BANCS.OUTPUT.TranParticulars = MID$(BANCS.OUTPUT.TranParticulars,0,50)
	print(BANCS.OUTPUT.TranParticulars)
ENDIF
IF (FIELDEXISTS(BANCS.OUTPUT.TranParticulars2) == 1) THEN
	BANCS.OUTPUT.TranParticulars2 = MID$(BANCS.OUTPUT.TranParticulars2,0,50)
	print(BANCS.OUTPUT.TranParticulars2)
ENDIF
#trace off
ENDOFSCRIPT:
exitscript
end-->
