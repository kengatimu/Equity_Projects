########################################################################################################
<--start
trace on

####################################################################
#section      :creating new repository if required
#Description  :Checks for the existence of the repository STDWFS and
#               creates a new one by that name if it does not exist
#####################################################################

IF (REPEXISTS("CUST") == 0 ) THEN
#{
    CREATEREP("CUST")
    #}
ENDIF

############################################################################
#section      :creating new class if required
#Desscription :checks for the existence of the class GLBDATA in the
#repository
#               create a new one if it does not exist
##############################################################################


IF (CLASSEXISTS("CUST","DATA") == 0) THEN
#{
    CREATECLASS("CUST","DATA",5)
#}
ENDIF

############################################
#Assigns the values to the variables
############################################

sv_a = urhk_b2k_PrintRepos("BANCS")
print(sv_a)
sv_y=0

IF( (FIELDEXISTS(("BANCS").("INPUT").("Bankid"))== 0) ) THEN
	CUST.DATA.errMsg="Kindly Supply Bank id"
	sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
	GOTO End
ELSE
	CUST.DATA.Bankid=BANCS.INPUT.Bankid
	print(CUST.DATA.Bankid)
ENDIF

IF( (FIELDEXISTS(("BANCS").("INPUT").("TranID"))== 0) ) THEN
	CUST.DATA.errMsg="Kindly Transaction ID"
	sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
	GOTO End
ELSE
	CUST.DATA.TranID=BANCS.INPUT.TranID
	print(CUST.DATA.TranID)
ENDIF

IF( (FIELDEXISTS(("BANCS").("INPUT").("TranDate"))== 0) ) THEN
	CUST.DATA.errMsg="Kindly Supply Transaction Date"
	sv_e=urhk_SetOrbOut("Error|"+CUST.DATA.errMsg)
	sv_e=urhk_SetOrbOut("StattusCode|Error")
	GOTO End
ELSE
	CUST.DATA.TranDate=BANCS.INPUT.TranDate
	print(CUST.DATA.TranDate)
ENDIF

############################################
# Fetching the value from table
############################################

#### Debit side ###
sv_q = "acctNameD,acctNoD| "
sv_q = sv_q + " select acct_name acctNameD,foracid acctNoD from tbaadm.gam where bank_id= ?SVAR   "
sv_q = sv_q + " and acid in (select acid from tbaadm.ctd_dtd_acli_view where bank_id= ?SVAR and trim(tran_id) = ?SVAR and tran_date= ?SVAR and PART_TRAN_TYPE='D' ) "

print(sv_q)
BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + CUST.DATA.TranID + "|" + CUST.DATA.TranDate
print(BANCS.INPARAM.BINDVARS)

sv_p= urhk_dbSelectWithBind(sv_q)
print(sv_p)

	IF (sv_p==0) then
		CUST.DATA.acctNameD = BANCS.OUTPARAM.acctNameD
		print (CUST.DATA.acctNameD)
		CUST.DATA.acctNoD = BANCS.OUTPARAM.acctNoD
		print (CUST.DATA.acctNoD)
		
		IF (CUST.DATA.acctNameD != "") THEN
			sv_z = urhk_SetOrbOut("ACCT_NAME| "+CUST.DATA.acctNameD)
			print (CUST.DATA.acctNameD)
			print(sv_z)
		ENDIF
		IF (CUST.DATA.acctNoD != "") THEN
				sv_z = urhk_SetOrbOut("ACCT_NUMBER| "+CUST.DATA.acctNoD
				print (CUST.DATA.acctNoD)
				print(sv_z)
		ENDIF
	
	ELSE
		CUST.DATA.errMsg="Data Fetch Error"
		sv_e=urhk_SetOrbOut("StattusCode|Error")
		sv_e=urhk_SetOrbOut("Error |"+CUST.DATA.errMsg)
	ENDIF	
	

#### Credit side ###
sv_q = "acctNameC,acctNoC| "
sv_q = sv_q + " select acct_name acctNameC,foracid acctNoC from tbaadm.gam where bank_id= ?SVAR   "
sv_q = sv_q + " and acid in (select acid from tbaadm.ctd_dtd_acli_view where bank_id= ?SVAR and trim(tran_id) = ?SVAR and tran_date= ?SVAR and PART_TRAN_TYPE='C' ) "

print(sv_q)
BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + BANCS.STDIN.contextBankId + "|" + CUST.DATA.TranID + "|" + CUST.DATA.TranDate
print(BANCS.INPARAM.BINDVARS)

sv_p= urhk_dbSelectWithBind(sv_q)
print(sv_p)

	IF (sv_p==0) then
		CUST.DATA.acctNameC = BANCS.OUTPARAM.acctNameC
		print (CUST.DATA.acctNameC)
		CUST.DATA.acctNoC = BANCS.OUTPARAM.acctNoC
		print (CUST.DATA.acctNoC)
		
			IF (CUST.DATA.acctNameC != "") THEN
				sv_z = urhk_SetOrbOut("ACCT_NAME| "+CUST.DATA.acctNameC)
				print (CUST.DATA.acctNameC)
				print(sv_z)
			ENDIF
			IF (CUST.DATA.acctNoC != "") THEN
					sv_z = urhk_SetOrbOut("ACCT_NUMBER| "+CUST.DATA.acctNoC)
					print (CUST.DATA.acctNoC)
					print(sv_z)
			ENDIF
		
	ELSE
		CUST.DATA.errMsg="Data Fetch Error"
		sv_e=urhk_SetOrbOut("StattusCode|Error")
		sv_e=urhk_SetOrbOut("Error |"+CUST.DATA.errMsg)
	ENDIF
		
###################

### DEBIT SIDE ###
sv_q = "Tdated,Tidd,Tamntd,Tlegd,Ttyped,Tpartd,Trmksd,Trefd| "
sv_q = sv_q + "select tran_date Tdated,tran_id Tidd,tran_amt Tamntd,PART_TRAN_TYPE Tlegd,tran_type Ttyped,TRAN_PARTICULAR Tpartd,TRAN_RMKS Trmksd,ref_num Trefd   "
sv_q = sv_q + "from TBAADM.CTD_DTD_ACLI_VIEW where bank_id= ?SVAR and trim(tran_id) = ?SVAR and tran_date= ?SVAR  and PART_TRAN_TYPE='D'   "

print(sv_q)
BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.DATA.TranID + "|" + CUST.DATA.TranDate
print(BANCS.INPARAM.BINDVARS)

	sv_p= urhk_dbSelectWithBind(sv_q)
	print(sv_p)

	IF (sv_p==0) then
		CUST.DATA.Tdated = BANCS.OUTPARAM.Tdated
		print (CUST.DATA.Tdated)
		CUST.DATA.Tidd = BANCS.OUTPARAM.Tidd
		print (CUST.DATA.Tidd)
		CUST.DATA.Tamntd = BANCS.OUTPARAM.Tamntd
		print (CUST.DATA.Tamntd)
		CUST.DATA.Tlegd = BANCS.OUTPARAM.Tlegd
		print (CUST.DATA.Tlegd)
		CUST.DATA.Ttyped = BANCS.OUTPARAM.Ttyped
		print (CUST.DATA.Ttyped)
		CUST.DATA.Tpartd = BANCS.OUTPARAM.Tpartd
		print (CUST.DATA.Tpartd)
		CUST.DATA.Trmksd = BANCS.OUTPARAM.Trmksd
		print (CUST.DATA.Trmksd)
		CUST.DATA.Trefd = BANCS.OUTPARAM.Trefd
		print (CUST.DATA.Trefd)
		                 
		IF (CUST.DATA.Tdated != "") THEN
			sv_z = urhk_SetOrbOut("TRANSACTION_DATE |"+CUST.DATA.Tdated)
			print(sv_z)			
		ENDIF
		IF (CUST.DATA.Tidd != "") THEN
			sv_z = urhk_SetOrbOut("TRANSACTION_ID |"+CUST.DATA.Tidd)
			print(sv_z)			
		ENDIF
		IF (CUST.DATA.Tamntd != "") THEN
			sv_z = urhk_SetOrbOut("TRANSACTION_AMOUNT |"+CUST.DATA.Tamntd)
			print(sv_z)			
		ENDIF
		
		IF ((CUST.DATA.Tlegd != "")AND (CUST.DATA.Tlegd=="C")) THEN
			CUST.DATA.Tlegd="CREDIT"
		IF ((CUST.DATA.Tlegd != "")AND (CUST.DATA.Tlegd=="D")) THEN
			CUST.DATA.Tlegd="DEBIT"
		ELSE
			CUST.DATA.Tlegd=CUST.DATA.Tlegd
		ENDIF
			sv_z = urhk_SetOrbOut("TRANSACTION_LEG |"+CUST.DATA.Tlegd)
			print(sv_z)			
		ENDIF
		IF (CUST.DATA.Ttyped != "") THEN
			IF (CUST.DATA.Ttyped=="T") THEN
				CUST.DATA.Ttyped="TRANSFER"
			IF (CUST.DATA.Ttyped=="C") THEN
				CUST.DATA.Ttyped="CREDIT"
			IF (CUST.DATA.Ttyped=="L") THEN
				CUST.DATA.Ttyped="CLEARING"
			ELSE
				CUST.DATA.Ttyped=CUST.DATA.Ttyped
			ENDIF				
			sv_z = urhk_SetOrbOut("TRANSACTION_TYPE| "+CUST.DATA.Ttyped)
			print(sv_z)			
		ENDIF
		IF (CUST.DATA.Tpartd != "") THEN
			sv_z = urhk_SetOrbOut("TRANSACTION_PARTICULARS |"+CUST.DATA.Tpartd)
			ELSE
				CUST.DATA.msg="TRANSACTION_PARTICULARS_NOT_AVAILABLE"
				print (CUST.DATA.msg)
				sv_z = urhk_SetOrbOut("TRANSACTION_PARTICULARS| " +CUST.DATA.msg)
			print(sv_z)			
		ENDIF
		IF (CUST.DATA.Trmksd != "") THEN
			sv_z = urhk_SetOrbOut("TRANSACTION_REMARKS |"+CUST.DATA.Trmksd)
			ELSE
				CUST.DATA.msg="TRANSACTION_REMARKS_NOT_AVAILABLE"
				print (CUST.DATA.msg)
				sv_z = urhk_SetOrbOut("TRANSACTION_REMARKS| " +CUST.DATA.msg)
			print(sv_z)			
		ENDIF
		IF (CUST.DATA.Trefd != "") THEN
			sv_z = urhk_SetOrbOut("TRANSACTION_REF_NUMBER |"+CUST.DATA.Trefd)
			ELSE
				CUST.DATA.msg="TRANSACTION_REF_NUMBER_NOT_AVAILABLE"
				print (CUST.DATA.msg)
				sv_z = urhk_SetOrbOut("TRANSACTION_REF_NUMBER| " +CUST.DATA.msg)
			print(sv_z)			
		ENDIF
				
	ELSE
		CUST.DATA.errMsg="Data Fetch Error"
		sv_e=urhk_SetOrbOut("StattusCode|Error")
		sv_e=urhk_SetOrbOut("Error |"+CUST.DATA.errMsg)
	ENDIF
	
### CREDIT SIDE ###
sv_q = "Tdatec,Tidc,Tamntc,Tlegc,Ttypec,Tpartc,Trmksc,Trefc| "
sv_q = sv_q + "select tran_date Tdatec,tran_id Tidc,tran_amt Tamntc,PART_TRAN_TYPE Tlegc,tran_type Ttypec,TRAN_PARTICULAR Tpartc,TRAN_RMKS Trmksc,ref_num Trefc   "
sv_q = sv_q + "from TBAADM.CTD_DTD_ACLI_VIEW where bank_id= ?SVAR and trim(tran_id) = ?SVAR and tran_date= ?SVAR  and PART_TRAN_TYPE='C'   "

print(sv_q)
BANCS.INPARAM.BINDVARS = BANCS.STDIN.contextBankId + "|" + CUST.DATA.TranID + "|" + CUST.DATA.TranDate
print(BANCS.INPARAM.BINDVARS)

	sv_p= urhk_dbSelectWithBind(sv_q)
	print(sv_p)

	IF (sv_p==0) then
		CUST.DATA.Tdatec = BANCS.OUTPARAM.Tdatec
		print (CUST.DATA.Tdatec)
		CUST.DATA.Tidc = BANCS.OUTPARAM.Tidc
		print (CUST.DATA.Tidc)
		CUST.DATA.Tamntc = BANCS.OUTPARAM.Tamntc
		print (CUST.DATA.Tamntc)
		CUST.DATA.Tlegc = BANCS.OUTPARAM.Tlegc
		print (CUST.DATA.Tlegc)
		CUST.DATA.Ttypec = BANCS.OUTPARAM.Ttypec
		print (CUST.DATA.Ttypec)
		CUST.DATA.Tpartc = BANCS.OUTPARAM.Tpartc
		print (CUST.DATA.Tpartc)
		CUST.DATA.Trmksc = BANCS.OUTPARAM.Trmksc
		print (CUST.DATA.Trmksc)
		CUST.DATA.Trefc = BANCS.OUTPARAM.Trefc
		print (CUST.DATA.Trefc)
		                 
		IF (CUST.DATA.Tdatec != "") THEN
			sv_z = urhk_SetOrbOut("TRANSACTION_DATE |"+CUST.DATA.Tdatec)
			print(sv_z)			
		ENDIF
		IF (CUST.DATA.Tidc != "") THEN
			sv_z = urhk_SetOrbOut("TRANSACTION_ID |"+CUST.DATA.Tidc)
			print(sv_z)			
		ENDIF
		IF (CUST.DATA.Tamntc != "") THEN
			sv_z = urhk_SetOrbOut("TRANSACTION_AMOUNT |"+CUST.DATA.Tamntc)
			print(sv_z)			
		ENDIF
		
		IF ((CUST.DATA.Tlegc != "")AND (CUST.DATA.Tlegc=="C")) THEN
			CUST.DATA.Tlegc="CREDIT"
		IF ((CUST.DATA.Tlegc != "")AND (CUST.DATA.Tlegc=="D")) THEN
			CUST.DATA.Tlegc="DEBIT"
		ELSE
			CUST.DATA.Tlegc=CUST.DATA.Tlegc
		ENDIF
			sv_z = urhk_SetOrbOut("TRANSACTION_LEG |"+CUST.DATA.Tlegc)
			print(sv_z)			
		ENDIF
		IF (CUST.DATA.Ttypec != "") THEN
			IF (CUST.DATA.Ttypec=="T") THEN
				CUST.DATA.Ttypec="TRANSFER"
			IF (CUST.DATA.Ttypec=="C") THEN
				CUST.DATA.Ttypec="CREDIT"
			IF (CUST.DATA.Ttypec=="L") THEN
				CUST.DATA.Ttypec="CLEARING"
			ELSE
				CUST.DATA.Ttypec=CUST.DATA.Ttypec
			ENDIF				
			sv_z = urhk_SetOrbOut("TRANSACTION_TYPE| "+CUST.DATA.Ttypec)
			print(sv_z)			
		ENDIF
		IF (CUST.DATA.Tpartc != "") THEN
			sv_z = urhk_SetOrbOut("TRANSACTION_PARTICULARS| "+CUST.DATA.Tpartc)
			ELSE
				CUST.DATA.msg="TRANSACTION_PARTICULARS_NOT_AVAILABLE"
				print (CUST.DATA.msg)
				sv_z = urhk_SetOrbOut("TRANSACTION_PARTICULARS| " +CUST.DATA.msg)
			print(sv_z)			
		ENDIF
		IF (CUST.DATA.Trmksc != "") THEN
			sv_z = urhk_SetOrbOut("TRANSACTION_REMARKS| "+CUST.DATA.Trmksc)
			ELSE
				CUST.DATA.msg="TRANSACTION_REMARKS_NOT_AVAILABLE"
				print (CUST.DATA.msg)
				sv_z = urhk_SetOrbOut("TRANSACTION_REMARKS| " +CUST.DATA.msg)
			print(sv_z)			
		ENDIF
		IF (CUST.DATA.Trefc != "") THEN
			sv_z = urhk_SetOrbOut("TRANSACTION_REF_NUMBER| "+CUST.DATA.Trefc)
			ELSE
				CUST.DATA.msg="TRANSACTION_REF_NUMBER_NOT_AVAILABLE"
				print (CUST.DATA.msg)
				sv_z = urhk_SetOrbOut("TRANSACTION_REF_NUMBER| " +CUST.DATA.msg)
			print(sv_z)			
		ENDIF
				
	ELSE
		CUST.DATA.errMsg="Data Fetch Error"
		sv_e=urhk_SetOrbOut("StattusCode|Error")
		sv_e=urhk_SetOrbOut("Error |"+CUST.DATA.errMsg)
	ENDIF	

END:
EXITSCRIPT
trace off
END-->
