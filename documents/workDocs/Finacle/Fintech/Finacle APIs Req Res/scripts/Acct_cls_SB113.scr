IF( (FIELDEXISTS(("BANCS").("INPUT").("bank_id"))== 0) ) THEN
   CUSTS.GLBDATA.errMsg="Provide Bank id"
   sv_e=urhk_SetOrbOut("Error|"+CUSTS.GLBDATA.errMsg)  
