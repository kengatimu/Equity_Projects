<adapter-config name="FinacleDBAdapter " adapter="db" wsdlLocation="FIN_DB_Adapter.wsdl"
                xmlns="http://platform.integration.oracle/blocks/adapter/fw/metadata">
  <connection-factory UIConnectionName="Finacle" location="eis/DB/Finacle"/>
  <endpoint-interaction portType="FinacleDBAdapterPort" operation="queryEmployee">
    <interaction-spec className="oracle.tip.adapter.db.DBPureSQLInteractionSpec">
      <property name="SqlString"
                value="select EMP.EMP_NAME EmpName,EMP.EMP_ID EmpId,EMP.EMP_EMAIL_ID EmailId from tbaadm.get EMP ,tbaadm.upr ROLE WHERE EMP.EMP_ID = ROLE.USER_EMP_ID AND ROLE.USER_WORK_CLASS = 200 AND ROLE.ROLE_ID LIKE 'BRM'"/>
      <property name="GetActiveUnitOfWork" value="false"/>
    </interaction-spec>
  </endpoint-interaction>
  <endpoint-interaction portType="FinacleDBAdapterPort" operation="queryBranchMaster">
    <interaction-spec className="oracle.tip.adapter.db.DBPureSQLInteractionSpec">
      <property name="SqlString"
                value="SELECT INSTITUTE_NAME_1 BANK_NAME,UNQ_BANK_IDENTIFIER SWIFT_CODE,ADDRESS_1 ADDRESS,LOCATION_NAME_1 CITY
FROM TBAADM.NDT
where trunc(rcre_time) >= #rcreTime or trunc(lchg_time) >= #lchgTime
 order by RCRE_TIME desc"/>
      <property name="GetActiveUnitOfWork" value="false"/>
    </interaction-spec>
  </endpoint-interaction>
  <endpoint-interaction portType="FinacleDBAdapterPort" operation="queryCustomerMaster">
    <interaction-spec className="oracle.tip.adapter.db.DBPureSQLInteractionSpec">
      <property name="SqlString" value="select a.BANK_ID,a.ORGKEY cifno,a.NAME CustName,a.ORGKEY
  PrimaryID,'FINN'  HostSystem,'' ContactPerson,a.MANAGER RMName, ''
RMMailID,a.ADDRESS_LINE1 Address1,a.ADDRESS_LINE2 Address2,a.ADDRESS_LINE3
Address3,'' Address4, (SELECT REF_DESC FROM tbaadm.RCT WHERE
REF_REC_TYPE='01'AND REF_CODE=a.city and rct.bank_id='54')
CityTown,a.COUNTRY  CountryCode,a.ZIP ZipCode,'' FaxNo,
a.PREFERREDPHONE PhoneNo,a.PREFERREDPHONE CellNo,a.PREFERREDEMAIL
EmailID,a.PRIMARY_SOL_ID BranchCode,''  PostingBranchCode,
'C' CustCategory,''  CustTaxCode,'' CustTaxID,decode
(a.SUSPENDED,'N','A','C') Status,ISEBANKINGENABLED from  crmuser.accounts a
where trunc(a.BODATEMODIFIED) = #startDate and ISEBANKINGENABLED = 'Y'"/>
      <property name="GetActiveUnitOfWork" value="false"/>
    </interaction-spec>
  </endpoint-interaction>
  <endpoint-interaction portType="FinacleDBAdapterPort" operation="queryAccountMaster">
    <interaction-spec className="oracle.tip.adapter.db.DBPureSQLInteractionSpec">
      <property name="SqlString"
                value="select 
                a.BANK_ID BankId,
                foracid AcountNo,
                acct_crncy_code AccountCcy,
                sol_id Branch,
                ACCT_NAME AccountName,
                to_char(acct_opn_date,'YYYYMMDD') OpenDate,
                cif_id CustomerId,
schm_type AccountType,schm_code ProductCd,decode(cif_id,null,'Bank','Customer') AccCategory,
decode(acct_cls_flg,'Y','C','O') ClosureFlag,to_char(acct_cls_date,'YYYYMMDD') ClosureDate,decode((select ACCT_STATUS  from tbaadm.SMT WHERE acid=a.acid),'A','N',null,'N','Y') InactiveStatus 
from tbaadm.gam a,crmuser.accounts b where a.CIF_ID = b.orgkey 
and a.del_flg='N' and a.bank_id='54' and a.CUST_ID is not null 
and b.ISEBANKINGENABLED = 'Y' and trunc(a.LCHG_TIME)= #changeDate"/>
      <property name="GetActiveUnitOfWork" value="false"/>
    </interaction-spec>
  </endpoint-interaction>
  <endpoint-interaction portType="FinacleDBAdapterPort" operation="queryDepositAccountMaster">
    <interaction-spec className="oracle.tip.adapter.db.DBPureSQLInteractionSpec">
<property name="SqlString" value="select g.bank_id BankId,g.cif_id CustomerId,g.foracid DepositAccountNumber,
t.TRAN_ID BilyetNumber,tam_crncy_code Currency,t.deposit_status Status,
t.cumulative_principal CurrentPrincipalAmount,t.deposit_amount DepositAmount,
to_char(t.maturity_date,'YYYYMMDD') MaturityDate,e.interest_rate CurrentInterestRate,
e.nrml_booked_amount_cr InterestToDate,e.interest_rate InterestRate,
t.deposit_period_mths TenorValue, to_char(t.open_effective_date,'YYYYMMDD') PostingDate,
decode(auto_renewal_flg, 'N' ,'No AutoRenewal','R','AutoRenewal') as MaturityInstructions, g.acct_cls_flg
from TBAADM.gam g, TBAADM.tam t,tbaadm.eit e, crmuser.accounts b 
where 
g.cif_id=b.orgkey and 
g.acid = t.acid
and e.entity_id = t.acid
and g.schm_type = 'TDA'
and cif_id in(select orgkey from crmuser.accounts where ISEBANKINGENABLED ='Y')
and trunc(t.LCHG_TIME) = #start_date"/>
      <property name="GetActiveUnitOfWork" value="false"/>
    </interaction-spec>
  </endpoint-interaction>
  <endpoint-interaction portType="FinacleDBAdapterPort" operation="queryExchangeRate">
    <interaction-spec className="oracle.tip.adapter.db.DBPureSQLInteractionSpec">
      <property name="SqlString" value="SELECT distinct BANK_ID,VAR_CRNCY_CODE BaseCcy,FXD_CRNCY_CODE CounterCcy,
      TO_CHAR (RTLIST_DATE, 'YYYYMMDD') StartDate,1 Quotient,'D' ConversionMethod,sum(decode(RATECODE,'CNB',CUST_VAR_CRNCY_UNITS)) BidRate,sum(decode(RATECODE,'CNS',CUST_VAR_CRNCY_UNITS)) OfferRate,
sum(decode(RATECODE,'MEAN',CUST_VAR_CRNCY_UNITS)) MidRate,
      RATECODE,VAR_CRNCY_UNITS,FXD_CRNCY_UNITS,max(trunc(RTLIST_NUM)) RTLIST_NUM,
      TO_CHAR (RTLIST_DATE, 'YYYYMMDD') LAST_DATE 
      from tbaadm.rtl 
      WHERE ratecode IN ('TTS', 'TTB', 'MEAN') AND bank_id = #bank_id group by BANK_ID,
         VAR_CRNCY_CODE ,
         FXD_CRNCY_CODE ,
         TO_CHAR (RTLIST_DATE, 'YYYYMMDD') ,
         RATECODE,
VAR_CRNCY_UNITS,
FXD_CRNCY_UNITS"/>
      <property name="GetActiveUnitOfWork" value="false"/>
    </interaction-spec>
  </endpoint-interaction>
  <endpoint-interaction portType="FinacleDBAdapterPort" operation="queryChequeUpdateStatus">
    <interaction-spec className="oracle.tip.adapter.db.DBPureSQLInteractionSpec">
      <property name="SqlString" value="select foracid Acct,INST_TYPE, trim(inst_num) Inst_num,STATUS_IND Status, tran_date,TRAN_ID
from tbaadm.ici ici,tbaadm.dtd dtd,TBAADM.GAM gam
where ici.acid = dtd.acid
and  dtd.acid=gam.acid 
and ici.bank_id = dtd.bank_id
and ici.value_date = dtd.value_date
and dtd.bank_id = gam.bank_id
and inst_amt = tran_amt
and gam.acct_cls_flg !='Y'
and gam.bank_id in ('54','56','50','55','11')"/>
      <property name="GetActiveUnitOfWork" value="false"/>
    </interaction-spec>
  </endpoint-interaction>

  <endpoint-interaction portType="FinacleDBAdapterPort" operation="queryLoanAccountMaster">
    <interaction-spec className="oracle.tip.adapter.db.DBPureSQLInteractionSpec">
      <property name="SqlString" value="select g.bank_id UnitId,g.schm_type AccType,g.schm_code AccSubType,g.sanct_lim TotalLoanAmount,round(NRML_ACCRUED_AMOUNT_DR,2) InterestAccrued,
l.lam_crncy_code SettlementCurrency,g.foracid LoanAccountNumber,l.lam_crncy_code LoanCurrency,g.acct_Name  LoanAccountName,decode(l.loan_type,'N','Normal','T','Transfer-In') LoanType,b.foracid FundingAccount,x.lr_freq_type PaymentFrequency,l.dis_amt Original_Amount,g.clr_bal_amt OutStanding_Amount,
0 PastDueAmount, x.flow_amt LastPaymentAmount,'' LastPaymentReceivedDate,x.num_of_flows TotalNumberofInstallments,
0 InstallmentsPaid,to_char(dis_shdl_date,'YYYYMMDD') LoanStartDate,to_char(l.ei_perd_end_date,'YYYYMMDD')LoanMaturityDate,abs(e.interest_rate) InterestRate,to_char(x.next_dmd_date,'YYYYMMDD')NextPaymentDate,'' NextPaymentAmount,'0'PayoffAmount,
'0' PrincipelClosingBalance,b.foracid DisbursementAccount,b.foracid InterestRepaymentAccount,decode(g.acct_cls_flg,'Y','Closed','N','Open','Open')Loanstatus,l.rep_perd_mths Tenure,to_char(l.ei_perd_end_date,'YYYYMMDD') LoanClosureDate,
g.sanct_lim ApprovedLimit,'0' PenaltyInterestRate,'0' PenaltiesDue,a.SUB_CLASSIFICATION_SYSTEM DelinquencyStatus,to_char(x.next_dmd_date,'YYYYMMDD') NextPrincipalDueDate,to_char(x.next_dmd_date,'YYYYMMDD')  NextInterestDueDate,0 NoofDelayed_Payments,
dis_amt DisbursedAmount
from tbaadm.gam g,tbaadm.gam b,tbaadm.lam l, tbaadm.eit e,tbaadm.acd a,(select  FLOW_ID,sol_id,acid,lr_freq_type,flow_amt,num_of_flows,next_dmd_date,LCHG_TIME from tbaadm.lrs r where
r.SHDL_NUM = (select max(SHDL_NUM) from TBAADM.lrs b where acid = r.acid) and FLOW_ID ='EIDEM') x
where l.acid = g.acid
and g.acid=x.acid
and e.entity_id = g.acid
and l.op_acid = b.acid
and g.acid=a.B2K_ID
and a.B2K_TYPE ='ACCNT'
and g.cif_id in(select orgkey from crmuser.accounts where ISEBANKINGENABLED ='Y')
and trunc(l.LCHG_TIME) = to_date(#G_startDate, 'dd-mm-yyyy')
and g.schm_type='LAA'
group by
g.bank_id,g.acid,g.schm_type,g.schm_code,dis_amt,NRML_ACCRUED_AMOUNT_DR,lam_crncy_code,
g.foracid,g.acct_Name,g.clr_bal_amt,g.acct_cls_flg,l.loan_type,b.foracid,x.lr_freq_type,x.flow_amt,x.num_of_flows,dis_shdl_date,
l.ei_perd_end_date,e.interest_rate,x.next_dmd_date,l.rep_perd_mths,ei_perd_end_date,l.lam_crncy_code,g.sanct_lim,a.SUB_CLASSIFICATION_SYSTEM"/>
      <property name="GetActiveUnitOfWork" value="false"/>
    </interaction-spec>
  </endpoint-interaction>

  <endpoint-interaction portType="FinacleDBAdapterPort" operation="queryRTGSOutwardRefStatus">
    <interaction-spec className="oracle.tip.adapter.db.DBPureSQLInteractionSpec">
      <property name="SqlString" value="select htd.bank_id BankId,htd.tran_id TranRefNo,pord.pymt_ref_num UTRNo,decode(pstd_flg,'Y','S','F') Status from tbaadm.pord,tbaadm.htd
where htd.ref_num = pord.pymt_ref_num
and htd.tran_date = #startDate
and htd. tran_type = 'T'
and htd.tran_sub_type = 'CI'
and part_tran_type = 'D'
and htd.acid in(select acid from tbaadm.gam
where gam.cif_id in(select orgkey from crmuser.accounts where ISEBANKINGENABLED ='Y'))
and substr(tran_particular,1,7) != 'Charges'
and substr(tran_particular,1,19) != 'remmittance charges'"/>
      <property name="GetActiveUnitOfWork" value="false"/>
    </interaction-spec>
  </endpoint-interaction>
  <endpoint-interaction portType="FinacleDBAdapterPort" operation="createNEFTInward">
    <interaction-spec className="oracle.tip.adapter.db.DBPureSQLInteractionSpec">
      <property name="SqlString" value="select otc.bank_id UnitId,gam.foracid DrAcct,
city||state||country Address,
htd.TRAN_AMT TranAmt,otc.DEST_BANK_CODE BankCode,otc.DEST_CUST_ACCT
BenAcctId,otc.DEST_CUST_NAME BenCustName,ECS_TRAN_REF_NO UniqueTransactionRefNo
from tbaadm.htd,tbaadm.otc,tbaadm.gam,crmuser.accounts
where htd.TRAN_DATE=otc.TRAN_DATE
and otc.cust_acct = gam.acid
and accounts.orgkey = gam.cif_id
and htd.TRAN_ID=otc.TRAN_ID
and htd.part_tran_type='D'
and htd.tran_date between #startDate AND #endDate"/>
      <property name="GetActiveUnitOfWork" value="false"/>
    </interaction-spec>
  </endpoint-interaction>
  <endpoint-interaction portType="FinacleDBAdapterPort" operation="createRTGSInward">
    <interaction-spec className="oracle.tip.adapter.db.DBPureSQLInteractionSpec">
      <property name="SqlString" value="select 
      gam.bank_id UnitId,
      foracid DrAcct,
      tran_amt TranAmt,
      recvr_bank_code BankCode,
      benef_party_acct BenCustAcctId,
benef_party_name BenCustName,
BENEF_PARTY_ADDR1 BenCustAddr1,
BENEF_PARTY_ADDR2 BenCustAddr2,
Address OrdInstAddr1,
sender_to_recvr_info SendRecvInfo1,
ref_num UniqueTransactionRefNo
from tbaadm.pord,tbaadm.htd,tbaadm.gam,
(select bank_id,orgkey,preferredphone,preferredemail,address_line1||' '||
(select ref_desc from tbaadm.rct where ref_code = a.state and ref_rec_type='02' )||' '||
(select ref_desc from tbaadm.rct where ref_code = a.country and ref_rec_type='03')||' '||
zip Address from crmuser.accounts a) a  
where
htd.ref_num = pord.pymt_ref_num
and htd.tran_date between #startDate AND #endDate
and htd.acid = gam.acid
and a.orgkey = gam.cif_id
and htd. tran_type = 'T'
and htd.tran_sub_type = 'CI'
and schm_type != 'LAA'
and substr(tran_particular,1,7)  != 'Charges'
and substr(tran_particular,1,19) != 'remmittance charges'"/>
      <property name="GetActiveUnitOfWork" value="false"/>
    </interaction-spec>
  </endpoint-interaction>
  <endpoint-interaction portType="FinacleDBAdapterPort" operation="queryNEFTOutwardRefStatus">
    <interaction-spec className="oracle.tip.adapter.db.DBPureSQLInteractionSpec">
      <property name="SqlString" value="select h.bank_id BankId, 
h.tran_id TranRefNo,
o.ecs_tran_ref_no UTRNo,
decode(pstd_flg,'Y','S','F') Status
from tbaadm.otc o,tbaadm.htd h where
o.tran_id = h.tran_id
and o.tran_date = h.tran_date
and h.part_tran_type = 'D'

and h.acid in(select acid from tbaadm.gam
where gam.cif_id in(select orgkey from crmuser.accounts where ISEBANKINGENABLED ='Y'))
and h.tran_date = #startDate"/>
      <property name="GetActiveUnitOfWork" value="false"/>
    </interaction-spec>
  </endpoint-interaction>
  <endpoint-interaction portType="FinacleDBAdapterPort" operation="queryDDUpdateStatus">
    <interaction-spec className="oracle.tip.adapter.db.DBPureSQLInteractionSpec">
      <property name="SqlString" value="select 
ddc.bank_id BankId,
ddc.tran_id TransactionRefNo,
ddc.dd_num CoreTxnRefNo,
gam.foracid AccountNo,
ddc.instrmnt_num InstNo,
dst.dd_status Status
from tbaadm.ddc,tbaadm.gam,tbaadm.dst where
ddc.pur_acid = gam.acid
and dst.dd_num = ddc.dd_num
and ddc.tran_date between #startDate and #endDate"/>
      <property name="GetActiveUnitOfWork" value="false"/>
    </interaction-spec>
  </endpoint-interaction>
  <endpoint-interaction portType="FinacleDBAdapterPort" operation="queryChequeDetails">
    <interaction-spec className="oracle.tip.adapter.db.DBPureSQLInteractionSpec">
      <property name="SqlString" value="select to_char(i.ENTRY_DATE,'YYYYMMDD') EntryDate,
I.SOL_ID SolId,
d.PART_TRAN_AMT_IN_INST_CRNCY AmountTCY,
c.TRAN_ID TranId,
I.INST_NUM InstNum,
concat(p.bank_code,p.br_code) RoutingNo,
I.PART_TRAN_TYPE PartTranType,
g.FORACID ForAcctId,
g.CUST_ID CustId,
p.PAYING_ACCT_ID PayingAcctId,
p.FREETEXT3 FreeText3,
i.INST_AMT InstAmt,
d.SET_REL_REG_STAT SetRelRegStat,
to_char(i.VALUE_DATE,'YYYYMMDD') ValueDate,
to_char(i.ENTRY_DATE,'YYYYMMDD') DepositSlipDate,
c.TRAN_ID DepositSlipNo
from tbaadm.Ici i,tbaadm.gam g, tbaadm.bkc b,tbaadm.oci p,tbaadm.icp c,tbaadm.ocp d
where p.INSTRMNT_ID=i.INST_NUM
and i.OUT_REJ_ZONE_CODE=p.clg_zone_code
and I.DRAWEE_BANK_CODe=b.bank_code
and d.acid = g.acid
and d.PART_TRAN_TYPE = 'C' and d.del_flg!='Y' and d.SET_REL_REG_STAT='R'
and I.acid=g.acid
and i.PART_TRAN_TYPE = 'D'
and i.ZONE_DATE = #startDate
and i.sol_id='000'
and OUT_REJ_SET_NUM is not null
AND i.STATUS_IND='P'"/>
      <property name="GetActiveUnitOfWork" value="false"/>
    </interaction-spec>
  </endpoint-interaction>
  <endpoint-interaction portType="FinacleDBAdapterPort" operation="queryLiquidationChequeStatus">
    <interaction-spec className="oracle.tip.adapter.db.DBPureSQLInteractionSpec">
      <property name="SqlString" value="SELECT p.PAYING_ACCT_ID PayingAcctId,
I.INST_NUM InstNum,
i.INST_AMT InstAmt,
b.BANK_SHORT_NAME BankShortName,
g.FORACID ForAcctId,
g.ACCT_NAME AcctName,
I.SOL_ID SolId,
to_char(i.VALUE_DATE,'YYYYMMDD') ValueDate,
to_char(i.ENTRY_DATE,'YYYYMMDD') EntryDate,
I.STATUS_IND StatusInd,
I.REJ_CODE_1 RejCode1,
c.TRAN_ID TranId
FROM tbaadm.Ici i,
tbaadm.gam g,
tbaadm.bkc b,
tbaadm.oci p,
tbaadm.icp c
WHERE p.INSTRMNT_ID =i.INST_NUM
AND i.OUT_REJ_ZONE_CODE=p.clg_zone_code
AND I.DRAWEE_BANK_CODe =b.bank_code
AND I.acid =g.acid
AND i.PART_TRAN_TYPE = 'D'
AND i.ZONE_DATE = #startDate
AND OUT_REJ_SET_NUM IS NOT NULL
AND i.STATUS_IND ='P'"/>
      <property name="GetActiveUnitOfWork" value="false"/>
    </interaction-spec>
  </endpoint-interaction>
  <endpoint-interaction portType="FinacleDBAdapterPort" operation="accountInqByCustId">
    <interaction-spec className="oracle.tip.adapter.db.DBPureSQLInteractionSpec">
      <property name="SqlString" value="select * from
(select BANK_ID BankId,
foracid AccountNo,
acct_crncy_code AccountCcy,
sol_id Branch,
ACCT_NAME AccountName,
to_char(acct_opn_date,'YYYYMMDD') OpenDate,
cif_id CIFNo,
schm_type AccountType,
schm_code ProductCd,decode(cif_id,null,'Bank','Customer') AccCategory,
decode(acct_cls_flg,'Y','C','O') ClosureFlag,
to_char(acct_cls_date,'YYYYMMDD') ClosureDate,
decode((select ACCT_STATUS  from tbaadm.SMT WHERE acid=a.acid),'A','N',null,'N','Y') InactiveStatus 
from tbaadm.gam a
where del_flg='N'
and a.cif_id = #customerIDTBA
and CUST_ID is not null) a,
(select 
a.BANK_ID BankId_1,
a.orgkey CifNo,
a.name CustName,
a.orgkey PrimaryID,
MANAGER RMName, 
a.ADDRESS_LINE1 Address1,
decode(a.ADDRESS_LINE2 ,null,(SELECT REF_DESC FROM tbaadm.RCT WHERE REF_REC_TYPE='01'AND REF_CODE=a.city and rct.bank_id = '54')) Address2,
a.ADDRESS_LINE3 Address3,
(SELECT REF_DESC FROM tbaadm.RCT WHERE REF_REC_TYPE='01'AND REF_CODE=a.city and rct.bank_id = '54') CityTown,
a.COUNTRY  CountryCode,
a.ZIP ZipCode,
a.PREFERREDPHONE PhoneNo,
a.PREFERREDPHONE CellNo,
a.PREFERREDEMAIL EmailID,
a.PRIMARY_SOL_ID BranchCode,
decode(gender,'F','I','M','I','C') CustCategory,
a.CUST_TYPE CustCategoryType,
decode(a.SUSPENDED,'N','A','C') Status 
from crmuser.accounts a
where
a.orgkey = #customerIDCRM) b
where
a.cifno = b.cifno
"/>
      <property name="GetActiveUnitOfWork" value="false"/>
    </interaction-spec>
  </endpoint-interaction>
  <endpoint-interaction portType="FinacleDBAdapterPort" operation="queryAverageBalance">
    <interaction-spec className="oracle.tip.adapter.db.DBPureSQLInteractionSpec">
      <property name="SqlString" value="select 
gam.cif_id CifId,  
to_char(EOD_DATE,'MMYYYY') Period, 
round(avg(VALUE_DATE_BAL)) AverageBalance
from tbaadm.gam, tbaadm.eab
where cif_id = #cifId
and gam.bank_id = eab.bank_id
and gam.acid = eab.acid
and schm_type in('SBA', 'CAA')
and   to_char(EOD_DATE,'MMYYYY') = #eodDate
group by gam.cif_id,  to_char(EOD_DATE,'MMYYYY')"/>
      <property name="GetActiveUnitOfWork" value="false"/>
    </interaction-spec>
  </endpoint-interaction>
  <endpoint-interaction portType="FinacleDBAdapterPort" operation="queryClientEmail">
    <interaction-spec className="oracle.tip.adapter.db.DBPureSQLInteractionSpec">
      <property name="SqlString"
                value="select
                a.name CustomerName,g.foracid AccountNumber,a.email Email from tbaadm.pord o,tbaadm.dtd d,tbaadm.gam g,crmuser.accounts a where o.PYMT_REF_NUM = #payRefNum and  d.part_tran_srl_num = '   2' and o.PYMT_REF_NUM = d.ref_num and g.acid = d.acid and a.orgkey = g.cif_id and o.bank_id in ('54','55','56','11','50') and d.bank_id in ('54','55','56','11','50') and g.bank_id in ('54','55','56','11','50') and a.bank_id in ('54','55','56','11','50')"/>
      <property name="GetActiveUnitOfWork" value="false"/>
    </interaction-spec>
  </endpoint-interaction>
  <endpoint-interaction portType="FinacleDBAdapterPort" operation="updateInstrumentIssuanceDetails">
    <interaction-spec className="oracle.tip.adapter.db.DBPureSQLInteractionSpec">
      <property name="SqlString" value="INSERT INTO CUSTOM.INSTRUMENT_STATUS_UPDATE (UNITID, INSTTYPE, TRANSACTIONREFNO, CORETXNREFNO, SERIALNO, ACCOUNTNO, INSTNO, STATUS, BUSINESSDATE, ISSUANCE_DATE, AMOUNT)
      VALUES (#UnitId, #InstType, #TransactionRefNo, #CoreTxnRefNo, #SerialNo, #AccountNo, #InstNo, #Status, TO_DATE(#BusinessDate, 'yyyymmdd'), TO_DATE(#IssuanceDate, 'yyyymmdd'), #Amount)" />
      <property name="GetActiveUnitOfWork" value="false"/>
    </interaction-spec>
  </endpoint-interaction>
</adapter-config>